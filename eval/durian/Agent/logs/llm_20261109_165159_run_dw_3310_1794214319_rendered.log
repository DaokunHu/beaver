      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA subject per school\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, and the minimum number of enrolled students over each subject code group, as well as the school code, school name, department code, school name from department, department phone number, and the highest running sum of total units for any subject within that school in the 2019FA term (where the subject has more than 1 total unit). Order the results by subject code. Do not return any rounded answers.\", \"id\": \"dw_4308\", \"name\": \"2017JA Subjects Enrollment per Subject Code with 2019FA School Running Unit Sums\", \"sql\": \"WITH inner_cte1 AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column, t1.SCHOOL_CODE, t1.SCHOOL_NAME, t1.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), cte1 AS ( SELECT inner_cte1.SUBJECT_TITLE, inner_cte1.NUM_ENROLLED_STUDENTS, inner_cte1.OFFER_DEPT_NAME, inner_cte1.DEPARTMENT_FULL_NAME, inner_cte1.SUBJECT_CODE, inner_cte1.SUBJECT_CODE_DESC, inner_cte1.window_column, inner_cte1.SCHOOL_CODE, inner_cte1.SCHOOL_NAME, inner_cte1.DEPARTMENT_CODE, sd.SCHOOL_NAME AS SCHOOL_NAME_DEPT, ad.DEPARTMENT_PHONE_NUMBER FROM inner_cte1 LEFT JOIN SIS_DEPARTMENT sd ON inner_cte1.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), inner_cte2 AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.SCHOOL_CODE, t1.SCHOOL_NAME, SUM(t1.TOTAL_UNITS) OVER (PARTITION BY t1.SCHOOL_CODE ORDER BY t1.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_CODE = '2019FA' AND t1.TOTAL_UNITS > 1 ), cte2 AS ( SELECT SCHOOL_CODE, SCHOOL_NAME, MAX(window_column) AS highest_running_sum_total_units FROM inner_cte2 GROUP BY SCHOOL_CODE, SCHOOL_NAME ) SELECT cte1.SUBJECT_TITLE, cte1.NUM_ENROLLED_STUDENTS, cte1.OFFER_DEPT_NAME, cte1.DEPARTMENT_FULL_NAME, cte1.SUBJECT_CODE, cte1.SUBJECT_CODE_DESC, cte1.window_column, cte1.SCHOOL_CODE, cte1.SCHOOL_NAME, cte1.DEPARTMENT_CODE, cte1.SCHOOL_NAME_DEPT, cte1.DEPARTMENT_PHONE_NUMBER, cte2.highest_running_sum_total_units FROM cte1 JOIN cte2 ON cte1.SCHOOL_CODE = cte2.SCHOOL_CODE ORDER BY cte1.SUBJECT_CODE;\"}, {\"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering catalog subject matched with 2017JA TIP offering\", \"desc\": \"For subjects offered by departments in the School of Engineering that are also offered in the term '2017JA', show the subject title, total units, department full name, the row number within a window of 2 preceding and 1 following rows ordered by subject title, number of enrolled students, offering department name, department full name for the term, subject code, subject code description, and the minimum number of enrolled students over each subject code group, ordered by subject title and subject code. Do not return any rounded answers.\", \"id\": \"dw_3236\", \"name\": \"Engineering Catalog Subjects Row Numbers Matched with 2017JA TIP Enrollment Windows\", \"sql\": \"WITH EngSubjects AS ( SELECT t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t0.DEPARTMENT_FULL_NAME, ROW_NUMBER() OVER (ORDER BY t1.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DEPARTMENT_CODE FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_NAME = 'Engineering' ), TermSubjects AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ) SELECT es.SUBJECT_TITLE, es.TOTAL_UNITS, es.DEPARTMENT_FULL_NAME, es.window_column AS eng_window_row_number, ts.NUM_ENROLLED_STUDENTS, ts.OFFER_DEPT_NAME, ts.DEPARTMENT_FULL_NAME AS term_dept_full_name, ts.SUBJECT_CODE, ts.SUBJECT_CODE_DESC, ts.window_column AS min_enrolled_by_code FROM EngSubjects es JOIN TermSubjects ts ON es.SUBJECT_TITLE = ts.SUBJECT_TITLE AND es.DEPARTMENT_CODE = ts.OFFER_DEPT_CODE ORDER BY es.SUBJECT_TITLE, ts.SUBJECT_CODE\"}, {\"category\": \"Subject Offering Analysis\", \"default_granularity\": \"one row per subject in academic year 2012 with section 0 and cluster type S\", \"desc\": \"For subjects offered in the academic year 2012 that also have a section ID of 0 and a cluster type of 'S', show the subject key, subject title, offer department name, academic year, term description, the total number of subjects offered by each department in that year, the row number within each offer department name group ordered by subject key, the department name from SUBJECT_SUMMARY, the term start date from ACADEMIC_TERMS, and the row number within a window of 2 preceding and 1 following rows ordered by the subject title from SUBJECT_OFFERED. List the results in order by offer department name and subject key. Do not return any rounded answers.\", \"id\": \"dw_4130\", \"name\": \"2012 Section-0 Cluster-S Subjects with Department Counts and Windowed Row Numbers\", \"sql\": \"WITH Subquery1 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_KEY, t1.SUBJECT_TITLE, t1.OFFER_DEPT_NAME, t0.ACADEMIC_YEAR, t0.TERM_DESCRIPTION, ROW_NUMBER() OVER (PARTITION BY t1.OFFER_DEPT_NAME ORDER BY t1.SUBJECT_KEY) AS window_column, t1.TERM_CODE FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2012 ) SELECT i.SUBJECT_KEY, i.SUBJECT_TITLE, i.OFFER_DEPT_NAME, i.ACADEMIC_YEAR, i.TERM_DESCRIPTION, d.dept_subject_count, i.window_column, i.TERM_CODE FROM inner_cte i JOIN ( SELECT OFFER_DEPT_NAME, COUNT(*) AS dept_subject_count FROM SUBJECT_OFFERED so JOIN ACADEMIC_TERMS_ALL at ON so.TERM_CODE = at.TERM_CODE WHERE at.ACADEMIC_YEAR = 2012 GROUP BY OFFER_DEPT_NAME ) d ON i.OFFER_DEPT_NAME = d.OFFER_DEPT_NAME ), Subquery2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t2.TERM_DESCRIPTION, ROW_NUMBER() OVER (ORDER BY t0.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t0.TERM_CODE FROM SUBJECT_OFFERED t0 JOIN SUBJECT_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.SECTION_ID = 0 AND t0.CLUSTER_TYPE = 'S' ) SELECT inner_cte.SUBJECT_TITLE, inner_cte.DEPARTMENT_NAME, inner_cte.TERM_DESCRIPTION, t3.TERM_START_DATE, inner_cte.window_column, inner_cte.TERM_CODE FROM inner_cte JOIN ACADEMIC_TERMS t3 ON inner_cte.TERM_CODE = t3.TERM_CODE ) SELECT s1.SUBJECT_KEY, s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME, s1.ACADEMIC_YEAR, s1.TERM_DESCRIPTION, s1.dept_subject_count, s1.window_column AS dept_window_number, s2.DEPARTMENT_NAME, s2.TERM_START_DATE, s2.window_column AS cluster_window_number FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.SUBJECT_TITLE = s2.SUBJECT_TITLE AND s1.TERM_CODE = s2.TERM_CODE ORDER BY s1.OFFER_DEPT_NAME, s1.SUBJECT_KEY;\"}], \"not_found\": []}"
