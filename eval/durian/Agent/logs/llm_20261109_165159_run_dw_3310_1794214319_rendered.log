    {
      "role": "tool",
      "tool_call_id": "call_21c754aa2e5b4733ad9dd533",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department per subject code with fall-only offering enrollment average\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and the average number of enrolled students for each subject in the department, considering only subjects that are offered in the fall term and are not offered in the summer term. Do not return any rounded answers.\", \"id\": \"dw_2398\", \"name\": \"Department Course Counts with Fall-Only Non-Summer Subject Average TIP Enrollment\", \"sql\": \"WITH inner_cte AS ( SELECT sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL, COUNT(DISTINCT scd.COURSE) AS Total_Courses FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER GROUP BY sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL ) SELECT icte.DEPARTMENT_NAME, icte.SUBJECT_CODE, icte.SUBJECT_CODE_DESC, icte.GRADUATE_LEVEL, icte.Total_Courses, AVG(tso.NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM inner_cte icte JOIN TIP_SUBJECT_OFFERED tso ON icte.SUBJECT_CODE = tso.COURSE_NUMBER JOIN SIS_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE AND sd.DEPARTMENT_NAME = icte.DEPARTMENT_NAME JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON tso.SUBJECT_ID = ccso.SUBJECT_ID WHERE ccso.IS_OFFERED_FALL_TERM = 'Y' AND ccso.IS_OFFERED_SUMMER_TERM = 'N' GROUP BY icte.DEPARTMENT_NAME, icte.SUBJECT_CODE, icte.SUBJECT_CODE_DESC, icte.GRADUATE_LEVEL, icte.Total_Courses ORDER BY icte.DEPARTMENT_NAME, icte.SUBJECT_CODE;\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per library subject\", \"desc\": \"For subjects with at least 5 enrolled students that are offered by the library in the term with code '2014FA', show the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, row number within each material status group ordered by subject ID, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, ordered by offering department name, material status key, and subject ID. Do not return any rounded answers.\", \"id\": \"dw_3393\", \"name\": \"2014FA Library Subjects with 5+ Enrolled Students by Material Status and Department Min Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.TERM_CODE, t1.TIP_MATERIAL_STATUS_KEY, t1.ISBN, ROW_NUMBER() OVER (PARTITION BY t1.TIP_MATERIAL_STATUS_KEY ORDER BY t0.SUBJECT_ID) AS window_column FROM LIBRARY_SUBJECT_OFFERED t0 JOIN TIP_DETAIL t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.NUM_ENROLLED_STUDENTS >= 5 ), Subq2 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t1.TERM_END_DATE, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_per_dept FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2014FA' ) SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.TERM_CODE, s1.TIP_MATERIAL_STATUS_KEY, s1.ISBN, s1.window_column, s2.OFFER_DEPT_NAME, s2.TERM_DESCRIPTION, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.min_enrolled_per_dept FROM Subq1 s1 JOIN Subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID ORDER BY s2.OFFER_DEPT_NAME, s1.TIP_MATERIAL_STATUS_KEY, s1.SUBJECT_ID\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per library subject plus department rollup rows\", \"desc\": \"For each subject offered by the library in the term with code '2014FA', show the subject ID, subject title, total number of enrolled students, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, as well as the maximum windowed average record count from tip detail records with material status key 'RQ' (using a window of 2 preceding and 2 following rows grouped by financial aid year). Additionally, for each offering department, include a grand total row showing the total number of enrolled students across all its subjects (with nulls for subject ID and subject title), and the corresponding maximum windowed average record count if available. Order the results by offering department name and subject ID. Do not return any rounded answers.\", \"id\": \"dw_3911\", \"name\": \"2014FA Library Subjects Enrollment Rollup by Department with Required Textbook Windowed Record Counts\", \"sql\": \"WITH Subq1 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t0.TERM_DESCRIPTION, t0.TERM_START_DATE, t1.TIP_MATERIAL_KEY, AVG(t1.RECORD_COUNT) OVER ( PARTITION BY t0.FINANCIAL_AID_YEAR ORDER BY t1.SUBJECT_ID ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN TIP_DETAIL t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TIP_MATERIAL_STATUS_KEY = 'RQ' ) SELECT SUBJECT_ID, MAX(window_column) AS max_windowed_avg_record_count FROM inner_cte GROUP BY SUBJECT_ID ), Subq2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t1.TERM_END_DATE, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_per_dept FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2014FA' ) SELECT CASE WHEN GROUPING(SUBJECT_ID) = 1 THEN NULL ELSE SUBJECT_ID END AS SUBJECT_ID, CASE WHEN GROUPING(SUBJECT_TITLE) = 1 THEN NULL ELSE SUBJECT_TITLE END AS SUBJECT_TITLE, SUM(NUM_ENROLLED_STUDENTS) AS total_enrolled_students, OFFER_DEPT_NAME, MAX(TERM_DESCRIPTION) AS TERM_DESCRIPTION, MAX(TERM_START_DATE) AS TERM_START_DATE, MAX(TERM_END_DATE) AS TERM_END_DATE, MIN(min_enrolled_per_dept) AS min_enrolled_per_dept FROM inner_cte GROUP BY OFFER_DEPT_NAME, SUBJECT_ID, SUBJECT_TITLE WITH ROLLUP HAVING OFFER_DEPT_NAME IS NOT NULL ORDER BY OFFER_DEPT_NAME, SUBJECT_ID ) SELECT s2.SUBJECT_ID, s2.SUBJECT_TITLE, s2.total_enrolled_students, s2.OFFER_DEPT_NAME, s2.TERM_DESCRIPTION, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.min_enrolled_per_dept, s1.max_windowed_avg_record_count FROM Subq2 s2 LEFT JOIN Subq1 s1 ON s2.SUBJECT_ID = s1.SUBJECT_ID ORDER BY s2.OFFER_DEPT_NAME, s2.SUBJECT_ID\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department per subject code\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\", \"id\": \"dw_4756\", \"name\": \"Department Course Counts with 2022 12-Unit Subjects Having Textbooks\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ) SELECT sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL, Total_Courses.Total_Courses, COALESCE(SubjectsWithTextbooks.Subjects_With_Textbooks, 0) AS Subjects_With_Textbooks_2022_12units FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER JOIN ( SELECT sd.DEPARTMENT_NAME, COUNT(DISTINCT COURSE_NUMBER) AS Total_Courses FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER GROUP BY sd.DEPARTMENT_NAME ) AS Total_Courses ON sd.DEPARTMENT_NAME = Total_Courses.DEPARTMENT_NAME LEFT JOIN ( SELECT s1.DEPARTMENT_NAME, COUNT(DISTINCT s1.SUBJECT_CODE || '-' || s1.SUBJECT_NUMBER) AS Subjects_With_Textbooks FROM inner_cte s1 JOIN TIP_DETAIL t2 ON s1.TERM_CODE = t2.TERM_CODE AND s1.SUBJECT_ID = t2.SUBJECT_ID WHERE t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') GROUP BY s1.DEPARTMENT_NAME ) AS SubjectsWithTextbooks ON sd.DEPARTMENT_NAME = SubjectsWithTextbooks.DEPARTMENT_NAME ;\"}], \"not_found\": []}"
