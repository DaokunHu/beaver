      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per IAP activity per department per academic year\", \"desc\": \"For each combination of activity and department/academic year enrollment statistics, list the activity title, enrollment type, maximum enrollment, category name, category description, and the dense rank of each row partitioned by the category name and ordered by the category name, along with the department name, academic year, number of unique subjects offered (subject count), minimum number of total units for those subjects, and the average number of enrolled students per subject (for departments and academic years where the number of enrolled students in a subject is greater than 5). Do not return any rounded answers.\", \"id\": \"dw_4405\", \"name\": \"IAP Activity Category Ranks Cross-Joined with Department Year Enrollment Statistics\", \"sql\": \"WITH activity_category_rank AS ( WITH inner_cte AS ( SELECT d.ACTIVITY_TITLE, d.ENROLLMENT_TYPE, d.MAX_ENROLLMENT, c.IAP_CATEGORY_NAME FROM IAP_SUBJECT_DETAIL d JOIN IAP_SUBJECT_CATEGORY c ON d.IAP_SUBJECT_CATEGORY_KEY = c.IAP_SUBJECT_CATEGORY_KEY ) SELECT i.ACTIVITY_TITLE, i.ENROLLMENT_TYPE, i.MAX_ENROLLMENT, i.IAP_CATEGORY_NAME, c.IAP_CATEGORY_DESC, DENSE_RANK() OVER (PARTITION BY i.IAP_CATEGORY_NAME ORDER BY i.IAP_CATEGORY_NAME) AS window_column FROM inner_cte i JOIN IAP_SUBJECT_CATEGORY c ON i.IAP_CATEGORY_NAME = c.IAP_CATEGORY_NAME ), dept_year_enrollment_stats AS ( WITH inner_cte AS ( SELECT c.DEPARTMENT_NAME, t.ACADEMIC_YEAR, COUNT(DISTINCT c.SUBJECT_ID) AS subject_count, MIN(c.TOTAL_UNITS) AS min_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS_ALL t ON c.TERM_CODE = t.TERM_CODE JOIN TIP_SUBJECT_OFFERED s ON t.TERM_CODE = s.TERM_CODE AND c.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 5 GROUP BY c.DEPARTMENT_NAME, t.ACADEMIC_YEAR ) SELECT i.DEPARTMENT_NAME, i.ACADEMIC_YEAR, i.subject_count, i.min_total_units, AVG(s.NUM_ENROLLED_STUDENTS) AS avg_enrolled_students FROM inner_cte i JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON i.DEPARTMENT_NAME = c.DEPARTMENT_NAME AND i.ACADEMIC_YEAR = c.ACADEMIC_YEAR JOIN ACADEMIC_TERMS_ALL t ON c.TERM_CODE = t.TERM_CODE AND t.ACADEMIC_YEAR = i.ACADEMIC_YEAR JOIN TIP_SUBJECT_OFFERED s ON t.TERM_CODE = s.TERM_CODE AND c.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 5 GROUP BY i.DEPARTMENT_NAME, i.ACADEMIC_YEAR, i.subject_count, i.min_total_units ) SELECT acr.ACTIVITY_TITLE, acr.ENROLLMENT_TYPE, acr.MAX_ENROLLMENT, acr.IAP_CATEGORY_NAME, acr.IAP_CATEGORY_DESC, acr.window_column, dys.DEPARTMENT_NAME, dys.ACADEMIC_YEAR, dys.subject_count, dys.min_total_units, dys.avg_enrolled_students FROM activity_category_rank acr CROSS JOIN dept_year_enrollment_stats dys;\"}, {\"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per department-year-activity-sponsor combination\", \"desc\": \"For each department, academic year, activity title, and sponsor name where the subject enrollment number is greater than 10 and the maximum enrollment for the activity is greater than 10, provide the department name, academic year, number of unique subjects, minimum total units offered, activity title, sponsor name, number of unique activities, minimum fee, and the sponsor type. Do not return any rounded answers.\", \"id\": \"dw_4515\", \"name\": \"Department Year Subject Statistics Matched with IAP Activity Sponsor Statistics\", \"sql\": \"WITH inner_cte AS ( WITH DeptSubjectStats AS ( SELECT c.DEPARTMENT_NAME, t.ACADEMIC_YEAR, COUNT(DISTINCT c.SUBJECT_ID) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS t ON c.TERM_CODE = t.TERM_CODE JOIN SUBJECT_SUMMARY s ON t.TERM_CODE = s.TERM_CODE AND c.SUBJECT_ID = s.SUBJECT_ID WHERE s.SUBJECT_ENROLLMENT_NUMBER > 10 GROUP BY c.DEPARTMENT_NAME, t.ACADEMIC_YEAR ), ActivitySponsorStats AS ( SELECT d.ACTIVITY_TITLE, s.SPONSOR_NAME, COUNT(DISTINCT d.IAP_SUBJECT_SESSION_KEY) AS activity_count, MIN(d.FEE) AS min_fee FROM IAP_SUBJECT_DETAIL d JOIN IAP_SUBJECT_SPONSOR s ON d.IAP_SUBJECT_SPONSOR_KEY = s.IAP_SUBJECT_SPONSOR_KEY WHERE d.MAX_ENROLLMENT > 10 GROUP BY d.ACTIVITY_TITLE, s.SPONSOR_NAME ), TermJoin AS ( SELECT t.ACADEMIC_YEAR, d.TERM_CODE, d.ACTIVITY_TITLE, s.SPONSOR_NAME FROM IAP_SUBJECT_DETAIL d JOIN ACADEMIC_TERMS t ON d.TERM_CODE = t.TERM_CODE JOIN IAP_SUBJECT_SPONSOR s ON d.IAP_SUBJECT_SPONSOR_KEY = s.IAP_SUBJECT_SPONSOR_KEY GROUP BY t.ACADEMIC_YEAR, d.TERM_CODE, d.ACTIVITY_TITLE, s.SPONSOR_NAME ) SELECT dss.DEPARTMENT_NAME, dss.ACADEMIC_YEAR, dss.subject_count, dss.min_total_units, ass.ACTIVITY_TITLE, ass.SPONSOR_NAME, ass.activity_count, ass.min_fee FROM DeptSubjectStats dss JOIN TermJoin tj ON dss.ACADEMIC_YEAR = tj.ACADEMIC_YEAR JOIN ActivitySponsorStats ass ON tj.ACTIVITY_TITLE = ass.ACTIVITY_TITLE AND tj.SPONSOR_NAME = ass.SPONSOR_NAME ORDER BY dss.DEPARTMENT_NAME, dss.ACADEMIC_YEAR, ass.ACTIVITY_TITLE, ass.SPONSOR_NAME ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.ACADEMIC_YEAR, inner_cte.subject_count, inner_cte.min_total_units, inner_cte.ACTIVITY_TITLE, inner_cte.SPONSOR_NAME, inner_cte.activity_count, inner_cte.min_fee, s.SPONSOR_TYPE FROM inner_cte JOIN IAP_SUBJECT_SPONSOR s ON inner_cte.SPONSOR_NAME = s.SPONSOR_NAME ORDER BY inner_cte.DEPARTMENT_NAME, inner_cte.ACADEMIC_YEAR, inner_cte.ACTIVITY_TITLE, inner_cte.SPONSOR_NAME;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level where the course is degree granting and the total units are greater than 6, provide the number of unique courses, the minimum total units offered, and the number of courses where the design units are at least 3. Do not return any rounded answers.\", \"id\": \"dw_3163\", \"name\": \"Degree-Granting Course Level Counts with Min Total Units and Design-Unit Course Counts\", \"sql\": \"WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT scd.COURSE) AS course_count, MIN(ccc.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units, COUNT(DISTINCT CASE WHEN ccc.DESIGN_UNITS >= 3 THEN scd.COURSE END) AS courses_with_design_units_3_or_more FROM inner_cte ic JOIN SIS_COURSE_DESCRIPTION scd ON ic.DEPARTMENT_NAME = scd.DEPARTMENT_NAME AND ic.COURSE_LEVEL = scd.COURSE_LEVEL JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units;\"}, {\"category\": \"Subject Offering and CIP Program Classification Comprehensive Analysis\", \"default_granularity\": \"one row per 2012SU subject offering detail plus rollup rows per department and per school\", \"desc\": \"For each offer department code in the 2012SU term with total units greater than 0, list the subject title, course number, department name, the dense rank over the offer department code, the course, course description, school name, program code, program title, category code, category title, four digit code, four digit title, and the minimum warehouse load date from the CIP table over each category code group for courses in department 6, and include a grand total of subjects per offer department code and a grand total for all courses in each school in the format (nulls for subject-specific fields, department name, total subjects, course-specific fields, school name, and total courses). Do not return any rounded answers.\", \"id\": \"dw_3901\", \"name\": \"2012SU Subject Offerings Dense Rank Matched with Department-6 CIP Course Classification and School Rollups\", \"sql\": \"WITH inner_cte1 AS ( SELECT t2.SUBJECT_TITLE, t0.COURSE_NUMBER, t2.DEPARTMENT_NAME, DENSE_RANK() OVER (PARTITION BY t1.OFFER_DEPT_CODE ORDER BY t1.OFFER_DEPT_CODE) AS window_column FROM SUBJECT_OFFERED_SUMMARY t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2012SU' AND t2.TOTAL_UNITS > 0 ), dept_counts1 AS ( SELECT DEPARTMENT_NAME, COUNT(*) AS total_subjects FROM SUBJECT_SUMMARY WHERE TERM_CODE = '2012SU' AND TOTAL_UNITS > 0 GROUP BY DEPARTMENT_NAME ), inner_cte2 AS ( SELECT s.COURSE, s.COURSE_DESCRIPTION, s.DEPARTMENT_NAME, s.SCHOOL_NAME, c.PROGRAM_CODE, c.PROGRAM_TITLE, c.CATEGORY_CODE, c.CATEGORY_TITLE, c.FOUR_DIGIT_CODE, c.FOUR_DIGIT_TITLE, MIN(c.WAREHOUSE_LOAD_DATE) OVER (PARTITION BY c.CATEGORY_CODE ORDER BY c.CATEGORY_CODE) AS min_warehouse_load_date FROM SIS_COURSE_DESCRIPTION s JOIN CIP c ON c.PROGRAM_CODE = s.CIP_PROGRAM_CODE WHERE s.DEPARTMENT = 6 ), SchoolTotals2 AS ( SELECT NULL AS COURSE, NULL AS COURSE_DESCRIPTION, NULL AS DEPARTMENT_NAME, SCHOOL_NAME, NULL AS PROGRAM_CODE, NULL AS PROGRAM_TITLE, NULL AS CATEGORY_CODE, NULL AS CATEGORY_TITLE, NULL AS FOUR_DIGIT_CODE, NULL AS FOUR_DIGIT_TITLE, NULL AS min_warehouse_load_date, COUNT(*) AS total_courses FROM inner_cte2 GROUP BY SCHOOL_NAME ) SELECT ic1.SUBJECT_TITLE, ic1.COURSE_NUMBER, ic1.DEPARTMENT_NAME, ic1.window_column, NULL AS total_subjects, ic2.COURSE, ic2.COURSE_DESCRIPTION, ic2.SCHOOL_NAME, ic2.PROGRAM_CODE, ic2.PROGRAM_TITLE, ic2.CATEGORY_CODE, ic2.CATEGORY_TITLE, ic2.FOUR_DIGIT_CODE, ic2.FOUR_DIGIT_TITLE, ic2.min_warehouse_load_date, NULL AS total_courses FROM inner_cte1 ic1 LEFT JOIN SIS_COURSE_DESCRIPTION scd ON ic1.COURSE_NUMBER = scd.COURSE LEFT JOIN inner_cte2 ic2 ON scd.COURSE = ic2.COURSE UNION ALL SELECT NULL, NULL, dc1.DEPARTMENT_NAME, NULL, dc1.total_subjects, s2.COURSE, s2.COURSE_DESCRIPTION, s2.SCHOOL_NAME, s2.PROGRAM_CODE, s2.PROGRAM_TITLE, s2.CATEGORY_CODE, s2.CATEGORY_TITLE, s2.FOUR_DIGIT_CODE, s2.FOUR_DIGIT_TITLE, s2.min_warehouse_load_date, s2.total_courses FROM dept_counts1 dc1 LEFT JOIN SIS_COURSE_DESCRIPTION scd2 ON dc1.DEPARTMENT_NAME = scd2.DEPARTMENT_NAME LEFT JOIN SchoolTotals2 s2 ON scd2.SCHOOL_NAME = s2.SCHOOL_NAME ORDER BY DEPARTMENT_NAME, SCHOOL_NAME, CATEGORY_CODE, SUBJECT_TITLE, COURSE\"}], \"not_found\": []}"
