            "name": "mysql_query",
            "arguments": "{\"sql\": \"SELECT COUNT(*) AS n FROM SUBJECT_OFFERED_SUMMARY t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.COURSE_NUMBER = t1.COURSE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.COURSE = t2.SUBJECT_CODE WHERE t2.TERM_CODE = '2022FA' AND t0.TOTAL_UNITS = 12\"}"
          }
        }
      ]
