      "role": "tool",
      "tool_call_id": "call_8676fec2771f4613b12e4809",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject offered summary record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject; joins to SIS_SUBJECT_CODE.COURSE_NUMBER and SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'; used for school-level filtering\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"columns\": {\"SIS_COURSE_DESCRIPTION_KEY\": {\"desc\": \"Surrogate key of the course description record\"}, \"COURSE\": {\"desc\": \"Course/subject code, e.g. '18'; joins to SIS_SUBJECT_CODE.SUBJECT_CODE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"COURSE_DESCRIPTION\": {\"desc\": \"Short course description text; its character length is used in description-length statistics\"}, \"COURSE_DESCRIPTION_LONG\": {\"desc\": \"Long-form course description text\"}, \"DEPARTMENT\": {\"desc\": \"Department code offering the course; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name offering the course\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME\": {\"desc\": \"School name offering the course, e.g. 'Engineering'\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"FROM_TERM\": {\"desc\": \"First term the course description is effective from\"}, \"FROM_TERM_DESCRIPTION\": {\"desc\": \"Description of the from-term\"}, \"THRU_TERM\": {\"desc\": \"Last term the course description is effective through\"}, \"THRU_TERM_DESCRIPTION\": {\"desc\": \"Description of the thru-term\"}, \"COURSE_OPTION\": {\"desc\": \"Course option designation\"}, \"COURSE_LEVEL\": {\"desc\": \"Course level code, e.g. 'U' = undergraduate, 'G' = graduate\"}, \"CIP_PROGRAM_CODE\": {\"desc\": \"Six-digit CIP (Classification of Instructional Programs) program code of the course; joins to CIP.PROGRAM_CODE (current classification, one row per code) and CIP_WITH_VERSION.PROGRAM_CODE (all revision versions)\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the course counts toward a degree\"}, \"DEFAULT_ULTIMATE_DEGREE\": {\"desc\": \"Default ultimate degree awarded for the course\"}, \"GRADAUTE_LEVEL\": {\"desc\": \"Legacy misspelled graduate level column (kept for compatibility)\"}, \"GRADUATE_LEVEL\": {\"desc\": \"Graduate level designation of the course\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per course description\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}, {\"id\": \"SUBJECT_OFFERED\", \"name\": \"SUBJECT_OFFERED\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_KEY\": {\"desc\": \"Surrogate key of the subject offered record\"}, \"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_OFFERED_SUMMARY.SUBJECT_OFFERED_SUMMARY_KEY\"}, \"MASTER_SUBJECT_KEY\": {\"desc\": \"Surrogate key of the master subject record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED_SUMMARY.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the section\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SECTION_ID\": {\"desc\": \"Section identifier, e.g. 0 for the primary section\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Harvard Cross-Enrollment Prog'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time of the section\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place of the section\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code, e.g. 'S'\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description (Undergraduate/Graduate/High Graduate)\"}, \"FORM_TYPE\": {\"desc\": \"Subject form type code\"}, \"FORM_TYPE_DESC\": {\"desc\": \"Subject form type description\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"SECTION_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the section\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster the subject belongs to\"}, \"EVALUATE_THIS_SUBJECT\": {\"desc\": \"Flag whether the subject is included in evaluation\"}, \"IS_OSE_SUBJECT\": {\"desc\": \"'Y'/'N' flag for Office of Subject Evaluation subject\"}, \"IS_CREATED_BY_DATA_WAREHOUSE\": {\"desc\": \"'Y'/'N' flag whether the record was synthesized by the data warehouse\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the section\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}, \"IS_REPEATABLE_SUBJECT\": {\"desc\": \"'Y'/'N' flag whether the subject may be repeated for credit\"}}, \"default_granularity\": \"one row per subject section per term\"}], \"not_found\": []}"
