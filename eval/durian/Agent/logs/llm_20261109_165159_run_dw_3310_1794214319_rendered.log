      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per 2017FA subject matched with 2022SU subject\", \"desc\": \"For subject offerings in the term '2017FA' with a total number of units greater than 10, display the subject title, department name, school name, and their dense rank considering the current and 2 preceding rows ordered by the department code from the subject code table, along with any matching subject IDs from subjects offered in the term with code '2022SU', their department names, and their dense rank considering the current and 2 preceding rows ordered by the total number of units. Show the subject title, department name, school name, subq1 dense rank, subject ID, subq2 department name, and subq2 dense rank, in that order. Do not return any rounded answers.\", \"id\": \"dw_3861\", \"name\": \"2017FA High-Unit Subjects Dense Rank Matched with 2022SU Unit Dense Ranks\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t2.SUBJECT_TITLE, t1.DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t0.DEPARTMENT_CODE ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column, t2.COURSE_NUMBER FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.SUBJECT_CODE = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.TERM_CODE = '2017FA' AND t2.TOTAL_UNITS > 10 ) SELECT inner_cte.SUBJECT_TITLE, inner_cte.DEPARTMENT_NAME, t0.SCHOOL_NAME, inner_cte.window_column, inner_cte.COURSE_NUMBER FROM inner_cte JOIN SIS_SUBJECT_CODE t0 ON inner_cte.COURSE_NUMBER = t0.COURSE_NUMBER ), subq2 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t1.DEPARTMENT_NAME, t1.TOTAL_UNITS, dense_rank() OVER (ORDER BY t1.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) SELECT inner_cte.SUBJECT_ID, inner_cte.DEPARTMENT_NAME, inner_cte.window_column FROM inner_cte ORDER BY inner_cte.window_column, inner_cte.SUBJECT_ID ) SELECT subq1.SUBJECT_TITLE, subq1.DEPARTMENT_NAME, subq1.SCHOOL_NAME, subq1.window_column AS subq1_dense_rank, subq2.SUBJECT_ID, subq2.DEPARTMENT_NAME AS subq2_DEPARTMENT_NAME, subq2.window_column AS subq2_dense_rank FROM subq1 LEFT JOIN COURSE_CATALOG_SUBJECT_OFFERED cso ON subq1.COURSE_NUMBER = cso.SUBJECT_CODE LEFT JOIN subq2 ON cso.SUBJECT_ID = subq2.SUBJECT_ID ORDER BY subq1.window_column DESC, subq1.SUBJECT_TITLE, subq2.window_column, subq2.SUBJECT_ID;\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per 2012 subject matched with subject code\", \"desc\": \"For subjects offered in the academic year 2012, show the subject key, subject title, offer department name, academic year, term description, the row number within each offer department name group ordered by subject key, the subject code, subject code description, department name, and the dense rank of each row partitioned by the school code and ordered by school code, for subjects where the school code is not null and the subject title is not null. Do not return any rounded answers.\", \"id\": \"dw_3215\", \"name\": \"2012 Subjects Department Row Numbers with Subject Code School Dense Ranks\", \"sql\": \"WITH Subquery1 AS ( SELECT t1.SUBJECT_KEY, t1.SUBJECT_TITLE, t1.OFFER_DEPT_NAME, t0.ACADEMIC_YEAR, t0.TERM_DESCRIPTION, ROW_NUMBER() OVER (PARTITION BY t1.OFFER_DEPT_NAME ORDER BY t1.SUBJECT_KEY) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2012 ), Subquery2 AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SUBJECT_TITLE, DENSE_RANK() OVER (PARTITION BY t0.SCHOOL_CODE ORDER BY t0.SCHOOL_CODE) AS window_column, t1.SUBJECT_ID FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL ) SELECT s1.SUBJECT_KEY, s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME, s1.ACADEMIC_YEAR, s1.TERM_DESCRIPTION, s1.window_column AS dept_row_number, s2.SUBJECT_CODE, s2.SUBJECT_CODE_DESC, s2.DEPARTMENT_NAME, s2.window_column AS school_dense_rank FROM Subquery1 s1 JOIN SUBJECT_OFFERED so ON s1.SUBJECT_KEY = so.SUBJECT_KEY JOIN Subquery2 s2 ON so.SUBJECT_TITLE = s2.SUBJECT_TITLE ORDER BY s1.OFFER_DEPT_NAME, s1.SUBJECT_KEY, s2.SUBJECT_CODE\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject code row or per 2012SU cluster-S subject row\", \"desc\": \"Show, for each subject, the subject code, subject code description, department name, subject title, and the dense rank of each row partitioned by the school code and ordered by school code for subjects where the school code is not null and the subject title is not null; and for subjects offered in the 2012SU term with a cluster type of 'S', show the subject title from SUBJECT_OFFERED, the offer department name, the total units from SUBJECT_SUMMARY, and assign row numbers within a window of 2 preceding and 1 following rows ordered by the subject title. Indicate the source of each row as either 'Subq1' or 'Subq2'. List all results together, showing the columns: subject code, subject code description, department name, subject title, dense rank by school, offer department name, total units, row number window, and source, in that order, ordered by subject title. Do not return any rounded answers.\", \"id\": \"dw_3590\", \"name\": \"Union of Subject Code School Dense Ranks and 2012SU Cluster-S Subject Unit Row Numbers\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SUBJECT_TITLE, DENSE_RANK() OVER (PARTITION BY t0.SCHOOL_CODE ORDER BY t0.SCHOOL_CODE) AS window_column, t1.SUBJECT_ID FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL ), Subq2 AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TOTAL_UNITS, ROW_NUMBER() OVER (ORDER BY t0.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t0.SUBJECT_ID FROM SUBJECT_OFFERED t0 JOIN SUBJECT_SUMMARY t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.TERM_CODE = '2012SU' AND t1.CLUSTER_TYPE = 'S' ), CombinedSubjects AS ( SELECT s1.SUBJECT_CODE, s1.SUBJECT_CODE_DESC, s1.DEPARTMENT_NAME, s1.SUBJECT_TITLE, s1.window_column AS dense_rank_by_school, NULL AS OFFER_DEPT_NAME, NULL AS TOTAL_UNITS, NULL AS row_number_window, 'Subq1' AS Source FROM Subq1 s1 UNION ALL SELECT NULL AS SUBJECT_CODE, NULL AS SUBJECT_CODE_DESC, NULL AS DEPARTMENT_NAME, s2.SUBJECT_TITLE, NULL AS dense_rank_by_school, s2.OFFER_DEPT_NAME, s2.TOTAL_UNITS, s2.window_column AS row_number_window, 'Subq2' AS Source FROM Subq2 s2 ) SELECT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SUBJECT_TITLE, dense_rank_by_school, OFFER_DEPT_NAME, TOTAL_UNITS, row_number_window, Source FROM CombinedSubjects ORDER BY SUBJECT_TITLE;\"}], \"not_found\": []}"
