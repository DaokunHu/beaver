    {
      "role": "tool",
      "tool_call_id": "call_f4893214b24d4664b2bf4455",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering course matched with Fall 2024-2025 subject offering\", \"desc\": \"For courses in the School of Engineering that are degree granting, and for each subject offered in the term with the description \\\"Fall Term 2024-2025\\\" by the same department, show the course description, department name, the dense rank of each course considering the current and 2 preceding rows ordered by the department's budget code, the subject offered key, subject title, offering department name, the term description, and the rank of each subject within its offering department ordered by subject offered key. Do not return any rounded answers.\", \"id\": \"dw_3660\", \"name\": \"Engineering Degree-Granting Courses with Fall 2024-2025 Subject Offerings Ranked per Department\", \"sql\": \"WITH Subquery1 AS ( SELECT t0.COURSE_DESCRIPTION, t1.DEPARTMENT_NAME, t1.DEPARTMENT_CODE, dense_rank() OVER (ORDER BY t1.DEPT_BUDGET_CODE ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE WHERE t1.SCHOOL_NAME = 'Engineering' AND t1.IS_DEGREE_GRANTING = 'Y' ), Subquery2 AS ( SELECT t0.TIP_SUBJECT_OFFERED_KEY, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.OFFER_DEPT_CODE, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.TIP_SUBJECT_OFFERED_KEY) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_DESCRIPTION = 'Fall Term 2024-2025' ) SELECT s1.COURSE_DESCRIPTION, s1.DEPARTMENT_NAME, s1.window_column AS course_dense_rank, s2.TIP_SUBJECT_OFFERED_KEY, s2.SUBJECT_TITLE, s2.OFFER_DEPT_NAME, s2.TERM_DESCRIPTION, s2.window_column AS subject_rank_within_dept FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.DEPARTMENT_CODE = s2.OFFER_DEPT_CODE\"}, {\"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per 2019FA TIP subject matched with an Engineering 12-unit course of the same offer department\", \"desc\": \"For subjects offered in the term '2019FA' with more than 0 enrolled students, and for courses in the 'Engineering' school with a total of 12 units, show the subject title, offer department name, department full name, number of enrolled students, the average number of enrolled students in a window of 2 preceding and 2 following rows grouped by the school code, the course number, course description, course subject title, total units, course offering department name, and the row number of the course within each offering department ordered by course number, for cases where the subject and course are from the same offering department. Order the results by subject title and course number. Do not return any rounded answers.\", \"id\": \"dw_3794\", \"name\": \"2019FA TIP Subject Enrollment Windows Matched with Engineering 12-Unit Course Row Numbers\", \"sql\": \"WITH SubjectStats AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t0.NUM_ENROLLED_STUDENTS, AVG(t0.NUM_ENROLLED_STUDENTS) OVER ( PARTITION BY t1.SCHOOL_CODE ORDER BY t0.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2019FA' AND t0.NUM_ENROLLED_STUDENTS > 0 ), EngineeringCourses AS ( SELECT t0.COURSE AS course_number, t0.COURSE_DESCRIPTION, t1.SUBJECT_TITLE AS course_subject_title, t1.TOTAL_UNITS, t1.OFFER_DEPT_NAME, ROW_NUMBER() OVER (PARTITION BY t1.OFFER_DEPT_NAME ORDER BY t0.COURSE) AS window_column, t1.OFFER_DEPT_CODE FROM SIS_COURSE_DESCRIPTION t0 JOIN SUBJECT_OFFERED_SUMMARY t1 ON t0.COURSE = t1.COURSE_NUMBER WHERE t0.SCHOOL_NAME = 'Engineering' AND t1.TOTAL_UNITS = 12 ) SELECT s.SUBJECT_TITLE, s.OFFER_DEPT_NAME, s.DEPARTMENT_FULL_NAME, s.NUM_ENROLLED_STUDENTS, s.window_column AS avg_enrolled_window, e.course_number, e.COURSE_DESCRIPTION, e.course_subject_title, e.TOTAL_UNITS, e.OFFER_DEPT_NAME AS course_offer_dept_name, e.window_column AS course_row_number FROM SubjectStats s JOIN EngineeringCourses e ON s.OFFER_DEPT_CODE = e.OFFER_DEPT_CODE ORDER BY s.SUBJECT_TITLE, e.course_number\"}, {\"category\": \"Course Catalog and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per degree-granting subject code description status per school (with rollup totals) matched with 2016SP Engineering-school subject offerings\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name, school name, the number of subject codes per school name, and whether the subject code description is present ('Has Description') or missing ('No Description'). For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes). Additionally, for subjects offered in the term '2016SP' with a school code of 'E', show the subject title, course description, the offering department name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Present all columns in the following order: subject code, subject code description, department name, school name, description status, total subject codes, subject title, course description, offering department name, and window column. Do not return any rounded answers.\", \"id\": \"dw_4490\", \"name\": \"Degree-Granting Subject Code Description Status Rollup by School with 2016SP Engineering Subject Row Numbers\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' ), SubjectCodeVisibility AS ( SELECT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, CASE WHEN SUBJECT_CODE_DESC IS NOT NULL AND SUBJECT_CODE_DESC <> 'nan' THEN 'Has Description' ELSE 'No Description' END AS description_status FROM inner_cte1 ), RollupResults AS ( SELECT SCHOOL_NAME, description_status, COUNT(*) AS total_subject_codes FROM SubjectCodeVisibility GROUP BY SCHOOL_NAME, description_status WITH ROLLUP HAVING COUNT(*) > 0 ), SubjectCodeSummary AS ( SELECT scv.SUBJECT_CODE, scv.SUBJECT_CODE_DESC, scv.DEPARTMENT_NAME, rr.SCHOOL_NAME, rr.description_status, rr.total_subject_codes FROM RollupResults rr LEFT JOIN ( SELECT DISTINCT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, description_status FROM SubjectCodeVisibility ) scv ON rr.SCHOOL_NAME = scv.SCHOOL_NAME AND rr.description_status = scv.description_status ), inner_cte2 AS ( SELECT t2.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.COURSE_DESCRIPTION, ROW_NUMBER() OVER (ORDER BY t2.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t2.OFFER_DEPT_NAME FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.COURSE_NUMBER = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.TERM_CODE = '2016SP' AND t0.SCHOOL_CODE = 'E' ), SubjectOfferSummary AS ( SELECT inner_cte2.SUBJECT_TITLE, inner_cte2.DEPARTMENT_NAME, inner_cte2.COURSE_DESCRIPTION, inner_cte2.OFFER_DEPT_NAME, inner_cte2.window_column FROM inner_cte2 JOIN SUBJECT_OFFERED_SUMMARY t2 ON inner_cte2.SUBJECT_TITLE = t2.SUBJECT_TITLE WHERE t2.TERM_CODE = '2016SP' ) SELECT scs.SUBJECT_CODE, scs.SUBJECT_CODE_DESC, scs.DEPARTMENT_NAME, scs.SCHOOL_NAME, scs.description_status, scs.total_subject_codes, sos.SUBJECT_TITLE, sos.COURSE_DESCRIPTION, sos.OFFER_DEPT_NAME, sos.window_column FROM SubjectCodeSummary scs LEFT JOIN SIS_DEPARTMENT sd ON scs.DEPARTMENT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SUBJECT_OFFERED_SUMMARY so ON sd.DEPARTMENT_CODE = so.OFFER_DEPT_CODE LEFT JOIN SubjectOfferSummary sos ON so.SUBJECT_TITLE = sos.SUBJECT_TITLE ORDER BY scs.SCHOOL_NAME, scs.description_status, sos.SUBJECT_TITLE;\"}], \"not_found\": []}"
