    {
      "role": "tool",
      "tool_call_id": "call_4b8e61a5efea440e9a1c4e17",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 97, \"items_by_type\": {\"table\": [{\"id\": \"SUBJECT_OFFERED\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\"}, {\"id\": \"STUDENT_DEPARTMENT\", \"desc\": \"Student-facing department lookup table with department code, name, full name, and school attribution (code and name). Similar in content to SIS_DEPARTMENT but oriented to student information systems reporting; joins to offering tables via DEPARTMENT_CODE.\"}, {\"id\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\"}, {\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\"}, {\"id\": \"STUDENT_DEGREE_PROGRAM\", \"desc\": \"19 columns in total\"}, {\"id\": \"LIBRARY_SUBJECT_OFFERED\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\"}, {\"id\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\"}, {\"id\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\"}, {\"id\": \"SUBJECT_ENROLLABLE\", \"desc\": \"11 columns in total\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\"}, {\"id\": \"MIT_STUDENT_DIRECTORY\", \"desc\": \"Student directory table: one row per student with name components, full name, office location and phone, email address, department code and department name, and student year. The DEPARTMENT column stores the academic department code and joins to SIS_DEPARTMENT.DEPARTMENT_CODE, enabling per-department student counts.\"}, {\"id\": \"SIS_SUBJECT_CODE\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\"}, {\"id\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\"}, {\"id\": \"CIS_COURSE_CATALOG\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\"}, {\"id\": \"DRUPAL_COURSE_CATALOG\", \"desc\": \"Drupal-sourced course catalog table: an alternative catalog feed with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags, section flags, meeting time/place), plus subject-offering reference columns (SO_SUBJECT_ID, SO_TERM_CODE, SO_TERM_DESCRIPTION, SO_CLUSTER_TYPE) linking catalog records to registrar subject offerings.\"}, {\"id\": \"SUBJECT_ATTRIBUTE\", \"desc\": \"Subject attribute lookup table decoding attribute codes attached to subjects: academic attributes (type 'A') such as calculus/science prerequisites and HASS-D/HASS category codes, and non-academic program flags (type 'N') such as ROTC, ESG, Concourse, co-op, and listener rules. Provides short, full, and reporting descriptions per code. Overlaps with CIS_HASS_ATTRIBUTE on HASS-family codes (HD1-HD5, HDL, HE, HA, HH, HS) but differs in scope: SUBJECT_ATTRIBUTE covers all subject attribute types with one description variant per code, while CIS_HASS_ATTRIBUTE covers only HASS attribute codes with separate registration-form and bulletin descriptions plus attribute-group (H/G) classification. Catalog subject records' GIR_ATTRIBUTE codes all resolve against SUBJECT_ATTRIBUTE_CODE.\"}, {\"id\": \"MASTER_DEPT_HIERARCHY\", \"desc\": \"Master department hierarchy table: one row per department/lab/center (DLC) under the 'Standard Hierarchy' hierarchy type, recording the DLC key/code/name and its five-level hierarchy path from the institute root (level 1 'All Departments') through executive areas down to the DLC's placement, with each level's code and name (null for levels deeper than the DLC's position). Joins to HR_ORG_UNIT and FCLT_ORGANIZATION via DLC_KEY; used to report or filter the master-hierarchy placement (school/area path) of a DLC, and as a DLC scope filter when only DLCs present in the standard hierarchy should be included.\"}, {\"id\": \"IR_INSTITUTION\", \"desc\": \"13 columns in total\"}, {\"id\": \"TIP_DETAIL\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\"}, {\"id\": \"FCLT_ORGANIZATION\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\"}, {\"id\": \"SUBJECT_IAP_SCHEDULE\", \"desc\": \"10 columns in total\"}, {\"id\": \"SPACE_SUPERVISOR_USAGE\", \"desc\": \"Space supervisor usage fact table: one row per supervisor (MIT_ID) recording how much space they supervise and for how many departments: department count, department DLC key list (comma-separated when multiple), number of supervisees, supervised square footage, research volume, and derived ratio measures (sqft per supervisee, sqft per research volume, research volume per sqft). Joins to SPACE_UNIT and other DLC-carrying tables via DEPT_NAMES = DLC_KEY (only single-department rows match); used for supervisor space-usage and research-volume statistics per department/DLC.\"}, {\"id\": \"SUBJECT_SELECTOR\", \"desc\": \"16 columns in total\"}, {\"id\": \"FCLT_ROOMS\", \"desc\": \"Facilities room inventory table: one row per physical room with building/floor keys, room identifiers, use classifications (major/minor use), organization assignment, area in square meters, access level, and geographic coordinates. Joins to FCLT_BUILDING via FCLT_BUILDING_KEY; referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE via FCLT_ROOM_KEY.\"}, {\"id\": \"LIBRARY_COURSE_INSTRUCTOR\", \"desc\": \"Library course instructor table recording instructors of courses with library reserve materials, including course name, instructor name, department (in 'COURSE_NUMBER - Department Name' format), assignment date range, and library organizational unit/branch. Referenced by LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_COURSE_INSTRUCTOR_KEY; instructor names resolve to person records via INSTRUCTOR_NAME = SE_PERSON.FULL_NAME.\"}, {\"id\": \"SUBJECT_GROUPING\", \"desc\": \"7 columns in total\"}, {\"id\": \"SIS_ADMIN_DEPARTMENT\", \"desc\": \"SIS administrative department table with administrative department code/name, phone area code and phone number, and clearing cost collector. Joins to SIS_DEPARTMENT via SIS_ADMIN_DEPARTMENT_CODE = DEPARTMENT_CODE for department contact information.\"}, {\"id\": \"IAP_SUBJECT_DETAIL\", \"desc\": \"Independent Activities Period (IAP) subject detail table: one row per IAP activity offered in a January term, with activity title/description, enrollment type, maximum enrollment, fee, prerequisites, preregistration deadline, cancellation and multiple-session flags, and foreign keys to category, sponsor, session, and person tables.\"}, {\"id\": \"IAP_SUBJECT_CATEGORY\", \"desc\": \"IAP subject category lookup table with category name and description. Referenced by IAP_SUBJECT_DETAIL via IAP_SUBJECT_CATEGORY_KEY.\"}, {\"id\": \"HR_FACULTY_ROSTER\", \"desc\": \"HR faculty roster table: one row per faculty member keyed by MIT_ID with name components, terminal degree, appointment type, job/position titles across HR, administrative, and directory organization units, endowed chair, and emeritus status. Used for faculty appointment and credential analysis; joins to EMPLOYEE_DIRECTORY on MIT_ID for contact details.\"}], \"metric\": [{\"id\": \"dw_3078\", \"desc\": \"For each subject title and department name where the total units are greater than 3, give the number of offered sections, the minimum number of enrolled students, and the average lab units for those subjects. Do not return any rounded answers.\"}, {\"id\": \"dw_4812\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_4683\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\"}, {\"id\": \"dw_4527\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only subjects with a non-null subject code description), and, for each subject in 2021 offered by these departments in the School of Engineering, list the subject id, subject title, and the number of enrolled students, but only include subjects where the number of enrolled students exceeds the average enrollment for that department in 2021. Do not return any rounded answers.\"}, {\"id\": \"dw_4184\", \"desc\": \"For each department, show the offer department name, the number of distinct subjects offered by the department in the academic year 2012, and for each subject that was offered in the term \\\"2012SU\\\", display the subject key, subject title, academic year, term description, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, and the deviation of each subject's enrollment number from the average enrollment number for its subject key group, ordered by offer department name and subject key. Do not return any rounded answers.\"}, {\"id\": \"dw_3237\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of active graduate students with an office location assigned in that department. Do not return any rounded answers.\"}, {\"id\": \"dw_4650\", \"desc\": \"For each degree-granting department that offered at least one subject in the School of Engineering in 2021 and has more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the total number of tip materials, the average number of enrolled students per subject (rounded to two decimal places), and the ratio of total enrolled students to total tip materials (rounded to two decimal places), listing the results in descending order of the average number of enrolled students per subject.\"}, {\"id\": \"dw_3727\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, or for each department that offered more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of tip materials. List the department code, department name, department full name, number of subjects offered, total number of enrolled students, and total number of tip materials in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_3632\", \"desc\": \"For subjects offered in the term \\\"2012SU\\\", show the subject title, subject key, offer department name, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, subject ID, academic year, term description, and the minimum number of enrolled students in a window of 3 preceding and 1 following row, ordered by offer department name and academic year. Do not return any rounded answers.\"}, {\"id\": \"dw_4387\", \"desc\": \"For each department in the School of Engineering with total student enrollment in its courses greater than the average total enrollment across all Engineering departments (and with total enrollment greater than 50), display the department name, the total number of students enrolled in its courses, and the highest average total units for subjects it has ever offered in a regular academic term, listing the results in descending order of total enrollment. Do not return any rounded answers.\"}, {\"id\": \"dw_4405\", \"desc\": \"For each combination of activity and department/academic year enrollment statistics, list the activity title, enrollment type, maximum enrollment, category name, category description, and the dense rank of each row partitioned by the category name and ordered by the category name, along with the department name, academic year, number of unique subjects offered (subject count), minimum number of total units for those subjects, and the average number of enrolled students per subject (for departments and academic years where the number of enrolled students in a subject is greater than 5). Do not return any rounded answers.\"}, {\"id\": \"dw_4640\", \"desc\": \"For each subject offered in the term '2017JA', what is the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code, the coefficient of variation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in the subjects offered by that department (considering only subjects with at least one enrolled student), and the department's school code? Do not return any rounded answers.\"}, {\"id\": \"dw_3911\", \"desc\": \"For each subject offered by the library in the term with code '2014FA', show the subject ID, subject title, total number of enrolled students, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, as well as the maximum windowed average record count from tip detail records with material status key 'RQ' (using a window of 2 preceding and 2 following rows grouped by financial aid year). Additionally, for each offering department, include a grand total row showing the total number of enrolled students across all its subjects (with nulls for subject ID and subject title), and the corresponding maximum windowed average record count if available. Order the results by offering department name and subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_4911\", \"desc\": \"From the top 10 subjects offered by departments in the School of Engineering with the highest maximum enrolled students (considering the current and next 2 rows ordered by subject key), display each subject's title, total units, department full name, row number within a window of 2 preceding and 1 following rows ordered by subject title, subject ID, offer department name, offer school name, term description, academic year, and the department that offered the subject. Do not return any rounded answers.\"}, {\"id\": \"dw_1689\", \"desc\": \"For each school, what is the school name and the highest average number of enrolled students per department (among its degree-granting departments, excluding Chemistry, and only considering subjects with at least one enrolled student), and for each subject offered by the Chemistry department in the 2019FA term that has course materials, what is the subject title, the dense rank of the subject considering the current and 2 preceding rows ordered by the number of enrolled students descending, the full name of the offering department, and the school name of the Chemistry department? List the school name and highest average enrolled students per department first, followed by the Chemistry subject title, dense rank, department full name, and Chemistry school name. Do not return any rounded answers.\"}, {\"id\": \"dw_1165\", \"desc\": \"For each subject where the responsible faculty MIT ID in the library subject offered table is 928034000 or the number of enrolled students in the tip subject offered table is greater than 5, and where the offer department name in the tip subject offered table is either 'Chemistry' or 'Biology', show the subject title from the library subject offered table, the offer department name from the tip subject offered table, the term code from both tables, the number of enrolled students from both tables, and the minimum number of enrolled students in the tip subject offered table over each master subject ID group. Additionally, for the department offering the subject, show the department name, the range of enrolled students, and the variance of enrolled students in the subjects offered by that department, considering only departments that grant degrees, courses that are at the graduate level, and excluding the Biology department. Present the results ordered by subject title and department name. Do not return any rounded answers.\"}, {\"id\": \"dw_4515\", \"desc\": \"For each department, academic year, activity title, and sponsor name where the subject enrollment number is greater than 10 and the maximum enrollment for the activity is greater than 10, provide the department name, academic year, number of unique subjects, minimum total units offered, activity title, sponsor name, number of unique activities, minimum fee, and the sponsor type. Do not return any rounded answers.\"}, {\"id\": \"dw_2958\", \"desc\": \"For each academic year, among subjects that are not repeatable, what is the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by each department? List the academic year, department name, average enrollment, variance, and standard deviation (using STDDEV only and never STDDEV_POP), ordered by variance descending. Do not return any rounded answers.\"}, {\"id\": \"dw_3868\", \"desc\": \"For each department in the School of Engineering where the total number of students enrolled in courses offered by that department is greater than the average total enrollment across all Engineering departments (and the total enrollment is greater than 50), show the department name and total enrollment, and for each such department, show the library reserve material details with material status key equal to 'U', including the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students, as well as the responsible faculty name and the offer department name, for materials offered by that department. The columns should be: department name, total enrollment, library course instructor key, library reserve catalog key, term code, subject ID, tip material key, tip material status key, tip ISBN, subject title, windowed minimum tip material status key, responsible faculty name, and offer department name. Do not return any rounded answers.\"}, {\"id\": \"dw_3236\", \"desc\": \"For subjects offered by departments in the School of Engineering that are also offered in the term '2017JA', show the subject title, total units, department full name, the row number within a window of 2 preceding and 1 following rows ordered by subject title, number of enrolled students, offering department name, department full name for the term, subject code, subject code description, and the minimum number of enrolled students over each subject code group, ordered by subject title and subject code. Do not return any rounded answers.\"}, {\"id\": \"dw_3398\", \"desc\": \"For each subject offered in the same term as a TIP detail record with material status 'RQ', show the subject key, subject title, offer department name, TIP material key, and the rank of each record within each offer department name group ordered by subject key, along with the subject title, subject ID, offer department name, offer school name, term description, academic year, and the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject key, where the subject, term, and offer department name match in both cases. List the columns in the following order: subject key, subject title, offer department name, TIP material key, rank, subject title (from the second subquery), subject ID, offer department name (from the second subquery), offer school name, term description, academic year, and the maximum number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_1350\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\"}, {\"id\": \"dw_1474\", \"desc\": \"For the top 10 degree-granting departments (excluding 'Political Science' and Course 17) that have offered at least one subject in the 'Engineering' school, list the department name, school name, subject code description, the total number of subjects they offered, and the average number of enrolled students per subject, and for each such department, show the full names, email addresses, student years, department full names, course descriptions, course levels, the minimum course level in a window of 3 preceding and 1 following row ordered by the student's last name, and the corresponding subject code and subject code description for each course taken by students named 'Kevin' in 'Electrical Eng & Computer Sci' (Course 6). Do not return any rounded answers.\"}, {\"id\": \"dw_4308\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, and the minimum number of enrolled students over each subject code group, as well as the school code, school name, department code, school name from department, department phone number, and the highest running sum of total units for any subject within that school in the 2019FA term (where the subject has more than 1 total unit). Order the results by subject code. Do not return any rounded answers.\"}, {\"id\": \"dw_2580\", \"desc\": \"For each department and academic year, provide the department name, academic year, the number of subjects offered that are not repeatable for credit and are offered in the fall term, and classify the department as 'HIGH_ACTIVITY' if it offers at least 10% more such subjects than the average across all departments for that year, 'LOW_ACTIVITY' if it offers at least 10% fewer, or 'AVERAGE' otherwise. Do not return any rounded answers.\"}, {\"id\": \"dw_3163\", \"desc\": \"For each department name and course level where the course is degree granting and the total units are greater than 6, provide the number of unique courses, the minimum total units offered, and the number of courses where the design units are at least 3. Do not return any rounded answers.\"}, {\"id\": \"dw_2151\", \"desc\": \"For each department that grants degrees (excluding the Biology department), provide the department name, the average and variance of the total units for subjects offered by that department in the 2022 academic year, and, if the department is Political Science, also include for each HGN code the maximum number of lecture units among all subjects in the course catalog and the subject title from the subject offered table for subjects offered in the year 2012 with more than 2 lecture units, as well as the number of enrolled students for those subjects. List the results ordered by the variance of total units in descending order, and for Political Science, by the maximum lecture units in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_3668\", \"desc\": \"For subjects offered by departments in the School of Engineering, show the subject title, total units, department full name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Additionally, for each matching course material detail, provide the material status key, term code, subject ID, ISBN, material key, the course number description, the offering department name, and the maximum number of enrolled students for each row considering the current row and the next 2 rows ordered by material key. The results should include the subject title, total units, department full name, window row number, material status key, term code, subject ID, ISBN, material key, course number description, offering department name, and the maximum number of enrolled students, in that order, for subjects and course materials where the subject title and department code match between the two datasets. Do not return any rounded answers.\"}, {\"id\": \"dw_3493\", \"desc\": \"For subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook, show the subject code, subject number, department name, subject title, term description, total units, the average subject enrollment number in a window of 2 preceding and 2 following rows grouped by department code and ordered by total units, the textbook material key, the textbook material status key, and the row number of the course within each department ordered by subject code. List the results in order by department name, subject code, and subject number. Do not return any rounded answers.\"}, {\"id\": \"dw_4305\", \"desc\": \"For the top 10 subjects offered in the term with the description \\\"Fall Term 2024-2025\\\" that have the highest number of enrolled students, display each subject's offered key, subject title, offering department name, the term description, the number of enrolled students, and the rank of each subject within its offering department (ordered by subject offered key), but only include subjects where the offering department is among those that, in the term with code '2022SU', had an average total units for their subjects greater than the average total units for all subjects offered in that term. List the subject offered key, subject title, offering department name, term description, number of enrolled students, and the rank within the department, in that order, and order the results by department name and number of enrolled students descending. Do not return any rounded answers.\"}], \"concept\": [{\"id\": \"concept_subject_offering_facts\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\"}, {\"id\": \"concept_department_dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\"}, {\"id\": \"concept_course_catalog_sources\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\"}, {\"id\": \"concept_course_material_programs\", \"desc\": \"Tables covering course material provisioning: the Textbook Information Program (TIP) tracking textbook adoption status per subject offering, and library reserve processing tracking catalog items placed on reserve for subjects. They jointly answer questions about which subjects have course materials/textbooks, material status (TIP statuses such as 'RQ' Required, 'EO' Electronic options; library statuses such as 'U' Unknown, 'Y' Required Course Material), ISBNs, record counts, and reserve catalog item attributes. The two programs are linked by SUBJECT_ID + TERM_CODE.\"}, {\"id\": \"concept_person_directory\", \"desc\": \"Tables describing people of the institute keyed by MIT_ID: the primary employee directory (contact details, titles, HR department), the Drupal-sourced employee feed (employee group/type, appointment flags, HR org unit), the person master table (payroll rank, position title, active flag), the HR faculty roster (appointment type, terminal degree, emeritus status), the OPA current-person snapshot (HR job/appointment attributes, faculty flag, sabbatical), and the student directory (students with department attribution and student year). They jointly answer questions about who a person is, their contact details, job/appointment attributes, and whether they are employee, faculty, or student; responsible faculty in subject offering tables resolve to these tables via RESPONSIBLE_FACULTY_MIT_ID = MIT_ID.\"}, {\"id\": \"concept_dept_hr_org_hierarchy\", \"desc\": \"Tables describing the institute's department/lab/center (DLC) and HR organization hierarchies: the HR organization unit dimension in two feed variants (HR_ORG_UNIT, HR_ORG_UNIT_NEW), the master department standard hierarchy path (MASTER_DEPT_HIERARCHY), its DLC-to-administrative-object link table (MASTER_DEPT_HIERARCHY_LINKS), and the direct-parent department lookup (MASTER_DEPT_DCODE_PARENT). They jointly answer questions about which HR department/area a DLC or organization belongs to, the hierarchy path or parent of a department, and HR department names/codes/levels, and are joined to FCLT_ORGANIZATION via DLC_KEY for facilities/space attribution. They differ in hierarchy representation (full path vs direct parent vs HR unit attributes), unit coverage, and companion columns.\"}, {\"id\": \"concept_iap_activities\", \"desc\": \"Tables describing Independent Activities Period (IAP) activities offered in January terms: activity details (title, enrollment type, max enrollment, fee, cancellation flags), sessions (location, date, times), sponsors (name, type), categories, and persons. They jointly answer questions about IAP activity counts, enrollment capacity, fees, session scheduling, and sponsorship.\"}, {\"id\": \"concept_academic_term_dimension\", \"desc\": \"Tables describing academic terms and their calendar/status attributes. They jointly answer questions about when terms run, which academic/financial-aid/degree year a term belongs to, and whether a term is current, previous, future, or regular. Coverage differs: the full historical term list, the status-tracked term subset, and the three-row relative term parameter reference.\"}, {\"id\": \"concept_building_inventory\", \"desc\": \"Tables recording the physical building inventory and its attributes (number/name, type, ownership, site, campus sector, access level, gross/assignable/non-assignable areas, number of rooms, key dates): the current FCLT_* family snapshot, its fiscal-period history (in two date-format variants), the FAC_* family snapshot, and the lightweight space-domain building lookup. They jointly answer questions about building characteristics, areas, and room counts, but differ in time coverage, table family, attribute richness, and area units.\"}, {\"id\": \"concept_facility_organization_dimension\", \"desc\": \"Organization dimension tables describing the institute's hierarchical organization tree used for facilities/space attribution: FCLT_ORGANIZATION (keyed by FCLT_ORGANIZATION_KEY, with DLC_KEY/DLC_NAME) and FAC_ORGANIZATION (keyed by ORGANIZATION_KEY, with D_CODE). They answer the same questions about organization names, hierarchy levels, parent/major organizations, assignable flags, and HR cross-references, but belong to different table families and coverage.\"}, {\"id\": \"concept_cip_program_classification\", \"desc\": \"Lookup tables of the Classification of Instructional Programs (CIP) used to classify courses/instructional programs into two-digit categories, four-digit series, and six-digit program codes, with revision version years (1990/2000/2010/2020). CIP holds the current single-version classification (one row per program code, with a change NOTE), while CIP_WITH_VERSION preserves every revision of each program code across versions. Both join to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE to attribute courses to CIP programs and categories.\"}, {\"id\": \"concept_time_dimension\", \"desc\": \"Time dimension tables of the warehouse at three granularities: TIME_DAY (one row per calendar date, with fiscal/calendar year and period, academic year, financial aid year, day of week, and the academic term code/description of the day), TIME_MONTH (one row per fiscal period in YYYYMM format, covering fiscal years 1996-2035, with fiscal quarter, calendar month, academic term, and financial aid year mappings), and TIME_QUARTER (one row per fiscal quarter, covering fiscal years 2000-2035, with quarter dates, payroll certification deadlines, and quarter status flags). They jointly answer questions about when fiscal periods/quarters/days run, which fiscal/calendar/academic year a date or month belongs to, and how day-level records roll up to months and quarters. They link to each other via FISCAL_PERIOD (day-month), FY_QUARTER_CODE (month-quarter), and FISCAL_YEAR (month-quarter association within the same fiscal year, fanning out months across all quarters of the year), and to the academic term tables via TIME_DAY.ACADEMIC_TERM_CODE or TIME_MONTH.ACADEMIC_TERM = TERM_CODE.\"}, {\"id\": \"concept_room_space_inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\"}, {\"id\": \"concept_room_major_use_classification\", \"desc\": \"Lookup tables classifying rooms by major use (classrooms, offices, laboratories, residential, circulation, etc.) with a short code, description, and assignable-space flag. They cover the current classification in the FCLT and FAC table families and the fiscal-period historical classification in the FCLT family, jointly answering questions about what a room is primarily used for and whether that use counts as assignable space.\"}, {\"id\": \"concept_floor_inventory\", \"desc\": \"Tables recording the floor level of buildings: the current FCLT_* family floor inventory with floor areas, the FAC_* family floor snapshot with the same structure, the fiscal-period historical floor table, and the lightweight space-domain floor lookup. They jointly answer questions about floor numbers and per-floor assignable/non-assignable areas, but differ in time coverage, table family, and attribute richness.\"}, {\"id\": \"concept_moira_mailing_lists\", \"desc\": \"Tables of the Moira mailing-list/group domain: the list master (one row per list with name, description, active flag, and type flags such as mailing list, group, NFS group, public, hidden), the membership detail (one row per list member with member login, full name, MIT ID, and last update date), and the owner lookup (one row per owner entity with owner name and owner type LIST/USER/KERBEROS). They jointly answer questions about which lists exist and their properties, who belongs to a list, and who owns a list; MOIRA_LIST is the parent of MOIRA_LIST_DETAIL via MOIRA_LIST_KEY, and MOIRA_LIST_OWNER is referenced by MOIRA_LIST_DETAIL via MOIRA_LIST_OWNER_KEY.\"}, {\"id\": \"concept_space_unit_dimension\", \"desc\": \"Space unit lookup tables identifying the organizational units that receive space allocation: SPACE_UNIT (with FCLT_ORGANIZATION_KEY organization attribution) and SPACE_UNIT2 (identity/name only). They answer the same space-unit identity questions but differ in organization linkage and coverage.\"}, {\"id\": \"concept_building_address\", \"desc\": \"Tables recording the postal/street addresses of buildings: the current FCLT_* family address table (multiple purpose-typed address rows per building), its fiscal-period historical counterpart, the FAC_* family address snapshot, and the single-text address fields of the space-domain BUILDINGS lookup. They jointly answer questions about where a building is located (street number/name, city, state, postal code), but differ in time coverage, address decomposition, and table family.\"}], \"column_concept\": [{\"id\": \"column_concept_enrollment_measures\", \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\"}, {\"id\": \"column_concept_department_name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\"}, {\"id\": \"column_concept_master_subject_id\", \"desc\": \"Master subject identifier columns (MASTER_SUBJECT_ID and its sortable variant MASTER_SUBJECT_ID_SORT) replicated across the registrar offering tables, the subject summary, the textbook program, the library reserve program, and the CIS course catalog. For clustered subjects (e.g. joint or cross-listed offerings), the master subject identifier points to the leading subject of the cluster, so joining on it matches offerings that share the same master subject even when their own SUBJECT_ID differs. SUBJECT_ID/SUBJECT_ID_SORT identify the subject itself, while MASTER_SUBJECT_ID/MASTER_SUBJECT_ID_SORT identify the cluster's master; the _SORT columns are the sortable forms of the same values used for cross-table joins.\"}, {\"id\": \"column_concept_subject_id\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\"}, {\"id\": \"column_concept_total_units\", \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\"}, {\"id\": \"column_concept_dlc_key\", \"desc\": \"Department/Lab/Center key columns (values like 'D_AEROASTRO', 'D_IDSS', 'D_BIOLOGY') identifying a DLC across the facilities, HR, space, and academic-department domains. They are the universal cross-domain join key linking facilities organizations and space units to HR organization units, the master department hierarchy, and academic departments. Naming and completeness vary: DLC_KEY in most tables, D_CODE in MASTER_DEPT_DCODE_PARENT, DLC_CODE in the master hierarchy tables; some columns carry composite values ('D_DSL:HQ') or nulls.\"}, {\"id\": \"column_concept_num_of_rooms\", \"desc\": \"NUM_OF_ROOMS columns recording how many rooms a building contains, replicated across the current and historical building tables of both families. The building-table columns hold the current room count (one value per building); the history-table columns hold the room count at each fiscal period, used for room-count statistics (average, range, variance, minimum) across a building's history records.\"}, {\"id\": \"column_concept_office_location\", \"desc\": \"OFFICE_LOCATION columns recording where a person's office/desk is, replicated across the person-directory tables (SE_PERSON, MIT_STUDENT_DIRECTORY, EMPLOYEE_DIRECTORY, DRUPAL_EMPLOYEE_DIRECTORY). All hold a building or building-room text identifier in the same value domain as FCLT_ROOMS.BUILDING_ROOM, but they describe different populations (employee/person master vs student vs primary employee directory vs Drupal employee feed) and differ sharply in non-null coverage and in how many values are building-room ('BLDG-ROOM') versus building-only ('BLDG'). Choosing the right column determines whose office is reported and whether room-level joins to FCLT_ROOMS succeed.\"}, {\"id\": \"column_concept_term_code\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\"}, {\"id\": \"column_concept_hass_attribute\", \"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code and description columns. The code columns appear in the three course catalog feeds and in the CIS_HASS_ATTRIBUTE lookup; description columns exist in three variants: the catalog-embedded HASS_ATTRIBUTE_DESC, the lookup's DESCRIPTION_ON_FORM (registration-form wording), and DESCRIPTION_IN_BULLETIN (short bulletin wording). Selecting the right description variant depends on the wording requested by the question.\"}, {\"id\": \"column_concept_building_type_site\", \"desc\": \"Building classification columns replicated across the current and historical building tables of both table families: BUILDING_TYPE ('ACADEMIC', 'SERVICE', 'RESIDENT') and SITE ('MIT', 'BATES', 'LINC', 'BOS', etc.). They carry the same value domain but differ in time semantics: the building-table columns are the current classification, while the history-table columns are the classification recorded at each fiscal period, so filtering by one versus the other can select different building sets.\"}, {\"id\": \"column_concept_material_status_key\", \"desc\": \"Material status key columns of the textbook program (TIP) and library reserve program. Both are coded status references decoded by their own lookup tables (key value equals code value), with independent value domains: TIP statuses ('RQ' Required, 'EO' Electronic options, 'RC' Recommended, 'PC' Val-u option, 'BR' Bookstore recommends, 'CL' Go to class first, 'NM' Course has no materials, 'U' Unknown, plus NULL-description keys) vs library reserve statuses ('U' Unknown, 'R' null description, 'N' Non-Required Course Material, 'O' Reserve only, 'X' No Required Textbook, 'Y' Required Course Material).\"}, {\"id\": \"column_concept_year_columns\", \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\"}, {\"id\": \"column_concept_access_level\", \"desc\": \"Access level columns recorded at three granularity levels of the facilities domain plus the space-planning room feed: building-level ACCESS_LEVEL_CODE/ACCESS_LEVEL_NAME (current and per-fiscal-period history), floor-level ACCESS_LEVEL, and room-level ACCESS_LEVEL (FCLT_ROOMS, FAC_ROOMS, ZPM_ROOMS_LOAD). They share a numeric value domain (observed 0-3) but describe the access restriction of different physical objects or come from different feeds, so filters and joins must target the granularity and table family the question refers to.\"}, {\"id\": \"column_concept_space_unit_key\", \"desc\": \"Space unit key columns identifying the organizational space-assignment unit across the space dimension and fact tables. SPACE_UNIT_KEY is the join key linking SPACE_DETAIL room rows to space unit identity (name/code) and, through SPACE_UNIT, to the owning facilities organization.\"}, {\"id\": \"column_concept_assignable_area\", \"desc\": \"Assignable-area measure columns at different granularity levels and time semantics: building-level current and per-fiscal-period assignable area, floor-level assignable area, and the space-domain assignable square footage. All FCLT_*/FAC_* columns are in square meters; BUILDINGS.BLDG_ASSIGNABLE_SQUARE_FOOTAGE is in square feet. Choosing the right column determines whether the measure is a building total, a floor total, a historical value, or a space-assignment figure.\"}, {\"id\": \"column_concept_building_room\", \"desc\": \"Combined building-room identifier columns (e.g. '1-080') appearing in both the space assignment fact table and the facilities room inventory. They identify the same physical room concept but come from different business processes with different coverage and companion measures.\"}, {\"id\": \"column_concept_facility_organization_key\", \"desc\": \"Facility organization key columns attributing space units and rooms to organizations in the hierarchical organization tree. Two naming conventions exist across table families (FCLT_ORGANIZATION_KEY in FCLT_*/SPACE_* tables vs ORGANIZATION_KEY in FAC_* tables) with the same value domain.\"}, {\"id\": \"column_concept_fiscal_period\", \"desc\": \"Fiscal period code columns in YYYYMM format (e.g. '199602' = FY1996 period 2, '201505') appearing in two distinct roles: as the primary key of the month-grain time dimension (TIME_MONTH.FISCAL_PERIOD, also mirrored in TIME_DAY.FISCAL_PERIOD for day-to-month linkage), and as the snapshot-period stamp of the facilities historical tables (FCLT_BUILDING_HIST, FCLT_BUILDING_HIST_1, FCLT_BUILDING_ADDRESS_HIST, FCLT_FLOOR_HIST, FCLT_ROOMS_HIST, FCLT_MAJOR_USE_HIST). Both roles share the same YYYYMM value domain, but the time dimension uses it for calendar grouping while the history tables use it to mark when a facilities snapshot was taken.\"}]}}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_3b458db12264426aaa1b253a",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject per source subquery\", \"desc\": \"List all subject titles that are either (a) offered in the term '2022FA' with a total of 12 units, showing the subject title, department name from the course description, and the dense rank of each subject considering the current and 2 preceding rows ordered by the subject code from the course catalog, or (b) for each subject offered, show the subject title, subject ID, offer department name, offer school name, term description, academic year, and the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject key. The results should include all these columns in the following order: subject title, department name, window column, offer department name, offer school name, term description, academic year, and maximum number of enrolled students, with NULLs for columns not relevant to each case. Do not return any rounded answers.\", \"id\": \"dw_3277\", \"name\": \"Union of 2022FA 12-Unit Subjects Dense Rank and Master Section 3-Row Max Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_TITLE, t1.DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t2.SUBJECT_CODE ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column, t2.SUBJECT_ID FROM SUBJECT_OFFERED_SUMMARY t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.COURSE_NUMBER = t1.COURSE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.COURSE = t2.SUBJECT_CODE WHERE t2.TERM_CODE = '2022FA' AND t0.TOTAL_UNITS = 12 ), Subq2 AS ( SELECT t1.SUBJECT_TITLE, t1.SUBJECT_ID, t1.OFFER_DEPT_NAME, t1.OFFER_SCHOOL_NAME, t0.TERM_DESCRIPTION, t0.ACADEMIC_YEAR, MAX(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.SUBJECT_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_enrolled_students FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.IS_MASTER_SECTION = 'Y' AND t0.TERM_STATUS_INDICATOR = 'P' ), CombinedSubjects AS ( SELECT s1.SUBJECT_TITLE, s1.DEPARTMENT_NAME, s1.window_column, NULL AS OFFER_DEPT_NAME, NULL AS OFFER_SCHOOL_NAME, NULL AS TERM_DESCRIPTION, NULL AS ACADEMIC_YEAR, NULL AS max_enrolled_students FROM Subq1 s1 UNION ALL SELECT s2.SUBJECT_TITLE, NULL AS DEPARTMENT_NAME, NULL AS window_column, s2.OFFER_DEPT_NAME, s2.OFFER_SCHOOL_NAME, s2.TERM_DESCRIPTION, s2.ACADEMIC_YEAR, s2.max_enrolled_students FROM Subq2 s2 ) SELECT SUBJECT_TITLE, DEPARTMENT_NAME, window_column, OFFER_DEPT_NAME, OFFER_SCHOOL_NAME, TERM_DESCRIPTION, ACADEMIC_YEAR, max_enrolled_students FROM CombinedSubjects ORDER BY SUBJECT_TITLE;\"}, {\"id\": \"dw_3273\", \"name\": \"Engineering 12-Unit Courses Row Numbers with Subject Dense Ranks by Total Units\", \"desc\": \"For courses in the School of Engineering with a total of 12 units, display the course number, course description, subject title, total units, offering department name, the row number of the course within its offering department ordered by course number, and the dense rank of the subject (considering the current and 2 preceding rows ordered by total units) if available. Do not return any rounded answers.\", \"sql\": \"WITH course_windowed AS ( SELECT t0.COURSE AS course_number, t0.COURSE_DESCRIPTION, t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t1.OFFER_DEPT_NAME, ROW_NUMBER() OVER (PARTITION BY t1.OFFER_DEPT_NAME ORDER BY t0.COURSE) AS window_column FROM SIS_COURSE_DESCRIPTION t0 JOIN SUBJECT_OFFERED_SUMMARY t1 ON t0.COURSE = t1.COURSE_NUMBER WHERE t0.SCHOOL_NAME = 'Engineering' AND t1.TOTAL_UNITS = 12 ), subject_dense_ranked AS ( SELECT t2.SUBJECT_TITLE, dense_rank() OVER (ORDER BY t2.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column, t2.OFFER_DEPT_CODE FROM SIS_SUBJECT_CODE t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t1.SCHOOL_NAME = 'Engineering' ) SELECT cw.course_number, cw.COURSE_DESCRIPTION, cw.SUBJECT_TITLE, cw.TOTAL_UNITS, cw.OFFER_DEPT_NAME, cw.window_column AS course_row_number, sdr.window_column AS subject_dense_rank FROM course_windowed cw LEFT JOIN subject_dense_ranked sdr ON cw.SUBJECT_TITLE = sdr.SUBJECT_TITLE ORDER BY cw.OFFER_DEPT_NAME, cw.course_number;\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering 12-unit course matched with dense-ranked Engineering subject offerings\"}, {\"id\": \"dw_3078\", \"name\": \"3+ Unit Subject Section Counts, Min Enrollment, and Average Lab Units by Title and Department\", \"desc\": \"For each subject title and department name where the total units are greater than 3, give the number of offered sections, the minimum number of enrolled students, and the average lab units for those subjects. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT sos.SUBJECT_TITLE, ss.DEPARTMENT_NAME, COUNT(so.SUBJECT_KEY) AS section_count, MIN(so.NUM_ENROLLED_STUDENTS) AS min_enrolled FROM SUBJECT_OFFERED_SUMMARY sos JOIN SUBJECT_OFFERED so ON sos.SUBJECT_ID = so.SUBJECT_ID JOIN SUBJECT_SUMMARY ss ON so.SUBJECT_ID = ss.SUBJECT_ID WHERE sos.TOTAL_UNITS > 3 GROUP BY sos.SUBJECT_TITLE, ss.DEPARTMENT_NAME ) SELECT inner_cte.SUBJECT_TITLE, inner_cte.DEPARTMENT_NAME, inner_cte.section_count, inner_cte.min_enrolled, AVG(ss.LAB_UNITS) AS avg_lab_units FROM inner_cte JOIN SUBJECT_SUMMARY ss ON inner_cte.SUBJECT_TITLE = ss.SUBJECT_TITLE AND inner_cte.DEPARTMENT_NAME = ss.DEPARTMENT_NAME GROUP BY inner_cte.SUBJECT_TITLE, inner_cte.DEPARTMENT_NAME, inner_cte.section_count, inner_cte.min_enrolled;\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject title per department name\"}], \"not_found\": []}"
    },
