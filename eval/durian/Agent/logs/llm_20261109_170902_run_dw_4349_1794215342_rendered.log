      "content": "{\"ok\": true, \"table_id\": \"LIBRARY_SUBJECT_OFFERED\", \"table_name\": \"LIBRARY_SUBJECT_OFFERED\", \"count\": 28, \"items\": [{\"metric_id\": \"dw_2628\", \"name\": \"Subject Group Max Enrollment and Average Total Units in Term 2019SP\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For each subject group in the term \\\"2019SP\\\", show the subject group ID and the highest number of enrolled students among all subjects in that group, along with the average total units for the group. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3248\", \"name\": \"2024 12-Unit Subjects Matched with Math Library Regular-Term Offerings and 3-Row Max Units\", \"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units that are also offered in the library by the Mathematics department during regular terms, show the subject code, subject number, subject title, department name, term description, the rank of each subject within its department ordered by subject code, the number of enrolled students, offering department name, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3357\", \"name\": \"Reserve Materials Status U Matched with Required Textbooks by Material Key and Year\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each library reserve material detail with material status key 'U', show the reserve catalog key, subject offered key, term code, academic year, term description, tip material key, tip material status key, and the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, along with the corresponding textbook material in the TIP_DETAI