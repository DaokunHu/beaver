    },
    {
      "role": "tool",
      "tool_call_id": "call_8e693076ddbe45a38a3134c1",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"concept_course_catalog_sources\", \"name\": \"Course Catalog Sources\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\", \"tables\": [\"COURSE_CATALOG_SUBJECT_OFFERED\", \"CIS_COURSE_CATALOG\", \"DRUPAL_COURSE_CATALOG\"], \"comparisons\": [{\"dimension\": \"Source system\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Warehouse course catalog fact table\", \"CIS_COURSE_CATALOG\": \"CIS (course information system) catalog feed\", \"DRUPAL_COURSE_CATALOG\": \"Drupal publishing-system catalog feed\"}, {\"dimension\": \"Distinctive columns\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"TERM_CODE plus EFFECTIVE_TERM_CODE, MEET_PLACE room key, RESPONSIBLE_FACULTY columns\", \"CIS_COURSE_CATALOG\": \"Same catalog attribute set keyed by ACADEMIC_YEAR/TERM_CODE; no MEET_PLACE/MEET_TIME\", \"DRUPAL_COURSE_CATALOG\": \"Adds SO_SUBJECT_ID, SO_TERM_CODE, SO_TERM_DESCRIPTION, SO_CLUSTER_TYPE linking to registrar subject offerings\"}, {\"dimension\": \"Typical join paths\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"TERM_CODE/EFFECTIVE_TERM_CODE to term tables; SUBJECT_CODE to SIS_SUBJECT_CODE/SIS_COURSE_DESCRIPTION; DEPARTMENT_CODE to SIS_DEPARTMENT; MEET_PLACE to FCLT_ROOMS\", \"CIS_COURSE_CATALOG\": \"DEPARTMENT_CODE to SIS_SUBJECT_CODE for subject-code/department resolution\", \"DRUPAL_COURSE_CATALOG\": \"SO_* columns to subject offering tables; catalog attributes used directly\"}, {\"dimension\": \"Usage in queries\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Default choice for unit statistics, HGN level, grade rules, offering flags\", \"CIS_COURSE_CATALOG\": \"Used when subject titles must be resolved through SIS_SUBJECT_CODE department groupings\", \"DRUPAL_COURSE_CATALOG\": \"Used when catalog data must be tied back to registrar offering records via SO_* keys\"}], \"decision_guide\": {\"Questions about units, grade type/rule, HGN level, HASS/GIR attributes, or IS_OFFERED_* flags of subjects\": \"Use COURSE_CATALOG_SUBJECT_OFFERED as the default catalog source; it also carries MEET_PLACE for location analysis.\", \"Questions that resolve subjects through SIS subject codes by department (e.g. counting subjects per department from the CIS feed)\": \"Use CIS_COURSE_CATALOG joined to SIS_SUBJECT_CODE on DEPARTMENT_CODE.\", \"Questions that need catalog attributes tied to registrar subject offering records (cluster type, offering term description)\": \"Use DRUPAL_COURSE_CATALOG via its SO_SUBJECT_ID / SO_TERM_CODE columns.\"}}, {\"id\": \"concept_department_dimension\", \"name\": \"Department and School Dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\", \"tables\": [\"SIS_DEPARTMENT\", \"STUDENT_DEPARTMENT\", \"SIS_ADMIN_DEPARTMENT\"], \"comparisons\": [{\"dimension\": \"Attribute coverage\", \"SIS_DEPARTMENT\": \"Richest: DEPARTMENT_FULL_NAME, SCHOOL_CODE/SCHOOL_NAME, DEPT_BUDGET_CODE, IS_DEGREE_GRANTING, commencement-book names, DLC key\", \"STUDENT_DEPARTMENT\": \"Minimal: code, name, full name, school code/name only\", \"SIS_ADMIN_DEPARTMENT\": \"Administrative contact: department phone area code/number, clearing cost collector\"}, {\"dimension\": \"Degree-granting and school filtering\", \"SIS_DEPARTMENT\": \"Supports IS_DEGREE_GRANTING and SCHOOL_NAME filters directly\", \"STUDENT_DEPARTMENT\": \"Only school code/name attribution, no degree-granting flag\", \"SIS_ADMIN_DEPARTMENT\": \"No school or degree-granting attributes\"}, {\"dimension\": \"Typical join path\", \"SIS_DEPARTMENT\": \"DEPARTMENT_CODE = offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE; also joins SIS_COURSE_DESCRIPTION.DEPARTMENT and SIS_ADMIN_DEPARTMENT.SIS_ADMIN_DEPARTMENT_CODE\", \"STUDENT_DEPARTMENT\": \"DEPARTMENT_CODE = TIP_SUBJECT_OFFERED.OFFER_DEPT_CODE and other offering department codes\", \"SIS_ADMIN_DEPARTMENT\": \"SIS_ADMIN_DEPARTMENT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE\"}, {\"dimension\": \"Budget/finance attributes\", \"SIS_DEPARTMENT\": \"DEPT_BUDGET_CODE available for budget-based ranking\", \"STUDENT_DEPARTMENT\": \"None\", \"SIS_ADMIN_DEPARTMENT\": \"CLEARING_COST_COLLECTOR\"}], \"decision_guide\": {\"Questions filtering departments by school (e.g. 'School of Engineering') or degree-granting status\": \"Use SIS_DEPARTMENT; it carries SCHOOL_NAME and IS_DEGREE_GRANTING.\", \"Questions needing only department full name and school name for offering departments (e.g. TIP subject offerings)\": \"STUDENT_DEPARTMENT suffices and is the lighter lookup; SIS_DEPARTMENT also works.\", \"Questions needing department phone numbers or administrative contact details\": \"Join SIS_ADMIN_DEPARTMENT via SIS_DEPARTMENT.DEPARTMENT_CODE = SIS_ADMIN_DEPARTMENT_CODE.\", \"Questions ranking or grouping departments by budget code\": \"Use SIS_DEPARTMENT.DEPT_BUDGET_CODE.\"}}, {\"id\": \"concept_subject_offering_facts\", \"name\": \"Subject Offering Fact Tables\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\", \"tables\": [\"COURSE_CATALOG_SUBJECT_OFFERED\", \"SUBJECT_OFFERED\", \"SUBJECT_OFFERED_SUMMARY\", \"SUBJECT_SUMMARY\", \"TIP_SUBJECT_OFFERED\", \"LIBRARY_SUBJECT_OFFERED\"], \"comparisons\": [{\"dimension\": \"Granularity\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Subject offering per term/academic year (catalog record, includes section flags)\", \"SUBJECT_OFFERED\": \"Subject section per term (finest grain, SECTION_ID)\", \"SUBJECT_OFFERED_SUMMARY\": \"Subject per term (rollup of sections)\", \"SUBJECT_SUMMARY\": \"Subject or cluster per term\", \"TIP_SUBJECT_OFFERED\": \"Subject per term within textbook program scope\", \"LIBRARY_SUBJECT_OFFERED\": \"Subject per term within library reserve scope\"}, {\"dimension\": \"Enrollment measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"None (catalog attributes only)\", \"SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, SECTION_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_OFFERED_SUMMARY\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_SUMMARY\": \"SUBJECT_ENROLLMENT_NUMBER plus first-week/fifth-week and credit/listener enrollment splits\", \"TIP_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\", \"LIBRARY_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\"}, {\"dimension\": \"Unit measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS, DESIGN_UNITS, TOTAL_UNITS, IS_VARIABLE_UNITS\", \"SUBJECT_OFFERED\": \"None\", \"SUBJECT_OFFERED_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS\", \"SUBJECT_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREP_UNITS, DESIGN_UNITS\", \"TIP_SUBJECT_OFFERED\": \"None\", \"LIBRARY_SUBJECT_OFFERED\": \"None\"}, {\"dimension\": \"Distinctive attributes\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"HGN_DESC level, GRADE_TYPE/GRADE_RULE, HASS/GIR attributes, IS_OFFERED_* flags, MEET_PLACE (room key), ACADEMIC_YEAR, EFFECTIVE_TERM_CODE\", \"SUBJECT_OFFERED\": \"IS_REPEATABLE_SUBJECT, CLUSTER_TYPE, section flags, FORM_TYPE, EVALUATE_THIS_SUBJECT\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_SCHOOL_NAME, COURSE_NUMBER, cluster info at subject level\", \"SUBJECT_SUMMARY\": \"SCHOOL_CODE/SCHOOL_NAME, SUBJECT_GROUP_ID, SUBJECT_OR_CLUSTER, detailed weekly enrollment\", \"TIP_SUBJECT_OFFERED\": \"IS_NO_COURSE_MATERIAL flag; parent of TIP_DETAIL materials\", \"LIBRARY_SUBJECT_OFFERED\": \"COURSE_NUMBER/COURSE_NUMBER_DESC; parent of LIBRARY_RESERVE_MATRL_DETAIL\"}, {\"dimension\": \"Department column naming\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_SUMMARY\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"TIP_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\"}], \"decision_guide\": {\"Questions about credit units, grading type/rules, HGN level (undergraduate/graduate), HASS/GIR attributes, or term offering flags (fall/spring/IAP/summer)\": \"Use COURSE_CATALOG_SUBJECT_OFFERED; it is the only offering table carrying full catalog attributes.\", \"Questions about actual section-level offerings, repeatability, cluster type, or section flags\": \"Use SUBJECT_OFFERED (section grain); roll up via SUBJECT_OFFERED_SUMMARY when subject-level totals are needed.\", \"Questions about final enrollment statistics, weekly enrollment snapshots, credit vs listener counts, subject groups, or school-level unit statistics\": \"Use SUBJECT_SUMMARY.\", \"Questions about textbooks/course materials per subject (required/optional status, ISBN, record counts)\": \"Start from TIP_SUBJECT_OFFERED (subject scope, IS_NO_COURSE_MATERIAL) joined to TIP_DETAIL (material rows).\", \"Questions about library reserve materials, reserve counts per subject, or library course numbers\": \"Start from LIBRARY_SUBJECT_OFFERED joined to LIBRARY_RESERVE_MATRL_DETAIL.\", \"Questions about subject-level units with offering department/school (e.g. Engineering school enrollment totals by department)\": \"Use SUBJECT_OFFERED_SUMMARY, which carries both TOTAL_UNITS and OFFER_SCHOOL_NAME.\"}}, {\"id\": \"concept_academic_term_dimension\", \"name\": \"Academic Term Dimension\", \"desc\": \"Tables describing academic terms and their calendar/status attributes. They jointly answer questions about when terms run, which academic/financial-aid/degree year a term belongs to, and whether a term is current, previous, future, or regular. Coverage differs: the full historical term list, the status-tracked term subset, and the three-row relative term parameter reference.\", \"tables\": [\"ACADEMIC_TERMS\", \"ACADEMIC_TERMS_ALL\", \"ACADEMIC_TERM_PARAMETER\"], \"comparisons\": [{\"dimension\": \"Row coverage\", \"ACADEMIC_TERMS\": \"Terms with full status tracking (subset of all terms)\", \"ACADEMIC_TERMS_ALL\": \"All terms known to the warehouse (superset of ACADEMIC_TERMS)\", \"ACADEMIC_TERM_PARAMETER\": \"Exactly 3 rows: current, previous, and upcoming term\"}, {\"dimension\": \"Unique columns\", \"ACADEMIC_TERMS\": \"IS_REGULAR_TERM, TERM_STATUS ('Previous'/'Current'/'Future'/'Unspecified'), ADD_DATE, DROP_DATE\", \"ACADEMIC_TERMS_ALL\": \"No IS_REGULAR_TERM/TERM_STATUS/ADD_DATE/DROP_DATE; shares TERM_STATUS_INDICATOR, FINANCIAL_AID_YEAR, DEGREE_YEAR\", \"ACADEMIC_TERM_PARAMETER\": \"TERM_PARAMETER name (SIS_CURRENT_TERM/SIS_PREVIOUS_TERM/SIS_UPCOMING_TERM), TERM_INDICATOR ('C'/'P'/'F'), TERM_LAST_DAY_BEFORE_NEXT_TERM\"}, {\"dimension\": \"Typical role in queries\", \"ACADEMIC_TERMS\": \"Filtering by regular-term flag or term status; term start/end dates and registration milestones\", \"ACADEMIC_TERMS_ALL\": \"Source of academic year, academic year description, financial aid year, degree year for windowed/running-sum statistics\", \"ACADEMIC_TERM_PARAMETER\": \"Resolving relative term references ('current term', 'previous term', term indicator 'C'/'P') to concrete term codes\"}, {\"dimension\": \"Join keys\", \"ACADEMIC_TERMS\": \"TERM_CODE, ACADEMIC_TERMS_KEY\", \"ACADEMIC_TERMS_ALL\": \"TERM_CODE, ACADEMIC_TERMS_KEY\", \"ACADEMIC_TERM_PARAMETER\": \"TERM_CODE\"}], \"decision_guide\": {\"Questions needing IS_REGULAR_TERM or TERM_STATUS ('Previous'/'Current'/'Future') filtering\": \"Use ACADEMIC_TERMS; these columns exist only there.\", \"Questions needing academic year, financial aid year, or degree year attributes over the widest term coverage, or joining fact tables whose terms may not be status-tracked\": \"Use ACADEMIC_TERMS_ALL, optionally joined to ACADEMIC_TERMS on TERM_CODE when regular-term/status flags are also needed.\", \"Questions referring to 'the current term', 'the previous term', 'the upcoming term', or term indicator 'C'/'P'/'F'\": \"Use ACADEMIC_TERM_PARAMETER to resolve the relative reference to a TERM_CODE, then join ACADEMIC_TERMS for full attributes.\", \"Questions needing registration milestones (add date, drop date, first day of classes, last day of final exam)\": \"Use ACADEMIC_TERMS (ADD_DATE/DROP_DATE only exist there; other milestone dates exist in both ACADEMIC_TERMS and ACADEMIC_TERMS_ALL).\"}}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_bbf16359f6c848bfab4859f5",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS\", \"SUBJECT_SUMMARY.TOTAL_UNITS\", \"SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS\", \"CIS_COURSE_CATALOG.TOTAL_UNITS\", \"DRUPAL_COURSE_CATALOG.TOTAL_UNITS\"], \"comparisons\": [{\"dimension\": \"Source process\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS is the catalog-declared unit value per offering; SUBJECT_SUMMARY.TOTAL_UNITS and SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS are registrar subject-level values; CIS/DRUPAL catalog feeds carry their own copies\"}, {\"dimension\": \"Companion unit columns\", \"detail\": \"All these tables also expose LECTURE_UNITS, LAB_UNITS, and preparation units (PREPARATION_UNITS except SUBJECT_SUMMARY which uses PREP_UNITS); DESIGN_UNITS exists in COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY, CIS and DRUPAL catalogs but not in SUBJECT_OFFERED_SUMMARY\"}, {\"dimension\": \"Variability flag\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS marks subjects whose units vary; analyses of fixed-unit statistics typically filter IS_VARIABLE_UNITS='N'\"}], \"decision_guide\": {\"Unit statistics (avg/stddev/variance/geometric mean) over catalog offerings, optionally split by lecture/lab/design or filtered by variable-units flag\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS with its companion unit columns.\", \"Unit statistics tied to actual enrollment records or subject groups per term\": \"Use SUBJECT_SUMMARY.TOTAL_UNITS.\", \"Unit statistics at subject-offering rollup level with offering department/school\": \"Use SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS.\", \"Fixed-unit analyses excluding variable-unit subjects\": \"Filter COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS = 'N'.\"}, \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\", \"id\": \"column_concept_total_units\", \"name\": \"Total Credit Units\"}, {\"id\": \"column_concept_department_name\", \"name\": \"Department Name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME\", \"SUBJECT_SUMMARY.DEPARTMENT_NAME\", \"SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY.OFFER_DEPT_NAME\", \"TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SIS_DEPARTMENT.DEPARTMENT_NAME\", \"STUDENT_DEPARTMENT.DEPARTMENT_NAME\", \"SIS_COURSE_DESCRIPTION.DEPARTMENT_NAME\", \"SIS_SUBJECT_CODE.DEPARTMENT_NAME\", \"EMPLOYEE_DIRECTORY.DEPARTMENT_NAME\", \"LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT\", \"MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME\", \"SE_PERSON.ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DEPARTMENT_NAME is used by catalog/summary tables (COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY), department/course lookup tables, and the student directory (MIT_STUDENT_DIRECTORY); OFFER_DEPT_NAME is used by offering/program tables (SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY, TIP_SUBJECT_OFFERED, LIBRARY_SUBJECT_OFFERED) and denotes the department that actually offers the subject; LIBRARY_COURSE_INSTRUCTOR uses the plain column name DEPARTMENT for the course's academic department; SE_PERSON uses ORGANIZATION for the person's organizational unit\"}, {\"dimension\": \"Value format\", \"detail\": \"Catalog, summary, offering, student-directory, and lookup tables store plain department names (e.g. 'Mathematics', 'Chemistry', 'Electrical Eng & Computer Sci'); LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT stores a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics', '06 - Electrical Eng & Computer Sci'), with some unprefixed values (e.g. 'Architecture'), so it is not directly comparable to plain-name columns without stripping the prefix\"}, {\"dimension\": \"Academic vs HR/organization value domain\", \"detail\": \"Catalog, summary, offering, library, student-directory, and lookup tables share the academic department domain; EMPLOYEE_DIRECTORY.DEPARTMENT_NAME is the HR organizational unit name and has a different domain (e.g. 'Lincoln Laboratory', 'Department of Physics'), where some values coincide with academic names but many do not, and some carry a 'Department of ...' prefix; SE_PERSON.ORGANIZATION holds organizational unit names that may use different naming variants than the academic domain for the same unit (e.g. 'Electrical Engineering-Computer Science' vs the academic 'Electrical Eng & Computer Sci'), so equality filters across the two conventions must use each table's own variant\"}, {\"dimension\": \"Companion code column\", \"detail\": \"Catalog/summary tables carry DEPARTMENT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE; offering/program tables carry OFFER_DEPT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE or STUDENT_DEPARTMENT.DEPARTMENT_CODE; MIT_STUDENT_DIRECTORY carries DEPARTMENT (the academic department code) joining SIS_DEPARTMENT.DEPARTMENT_CODE, which is the reliable join key instead of the name; LIBRARY_COURSE_INSTRUCTOR has no department code column, only the prefixed name text; EMPLOYEE_DIRECTORY carries DEPARTMENT_NUMBER (HR department number) and SE_PERSON carries no department code, neither joining to SIS_DEPARTMENT.DEPARTMENT_CODE\"}], \"decision_guide\": {\"Filtering subjects by department in catalog or summary analysis\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME or SUBJECT_SUMMARY.DEPARTMENT_NAME.\", \"Filtering by department in section-level, textbook-program, or library analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Joining fact tables to department dimension attributes (school, full name, degree-granting)\": \"Prefer code joins: DEPARTMENT_CODE / OFFER_DEPT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE; name equality joins are used when codes are unavailable.\", \"Matching departments across a DEPARTMENT_NAME table and an OFFER_DEPT_NAME table\": \"The values are directly comparable (same academic name domain), e.g. joining SUBJECT_SUMMARY.DEPARTMENT_NAME to TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME.\", \"Filtering employees by their HR organizational unit (e.g. names containing 'Department', or HR units like 'Political Science')\": \"Use EMPLOYEE_DIRECTORY.DEPARTMENT_NAME; do not join it to SIS_DEPARTMENT.DEPARTMENT_CODE, and pair it with DEPARTMENT_NUMBER for HR grouping.\", \"Filtering by department in section-level, textbook-program, or library subject analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Filtering library reserve course instructors by academic department or library unit\": \"Use LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT with the prefixed value format (e.g. '18 - Mathematics'); do not compare it directly to plain department-name columns.\", \"Filtering students by their academic department\": \"Use MIT_STUDENT_DIRECTORY.DEPARTMENT (code) joined to SIS_DEPARTMENT.DEPARTMENT_CODE for reliable matching, or MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME for direct name filters; the name shares the academic domain with SIS_DEPARTMENT.DEPARTMENT_NAME.\", \"Filtering a person master (SE_PERSON) record by organizational unit such as an academic department\": \"Use SE_PERSON.ORGANIZATION with its own naming variant (e.g. 'Electrical Engineering-Computer Science'); do not equate it directly to MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME or SIS_DEPARTMENT.DEPARTMENT_NAME, which use the academic variant (e.g. 'Electrical Eng & Computer Sci').\"}}, {\"id\": \"column_concept_subject_id\", \"name\": \"Subject Identifier\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_ID\", \"SUBJECT_OFFERED.SUBJECT_ID\", \"SUBJECT_OFFERED_SUMMARY.SUBJECT_ID\", \"SUBJECT_SUMMARY.SUBJECT_ID\", \"TIP_DETAIL.SUBJECT_ID\", \"TIP_SUBJECT_OFFERED.SUBJECT_ID\", \"LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\", \"LIBRARY_RESERVE_MATRL_DETAIL.SUBJECT_ID\"], \"comparisons\": [{\"dimension\": \"Format\", \"detail\": \"SUBJECT_CODE + '.' + SUBJECT_NUMBER in all tables, e.g. '18.01'; can be reconstructed via CONCAT(SUBJECT_CODE, '.', SUBJECT_NUMBER)\"}, {\"dimension\": \"Grain difference\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED: catalog offering scope, one SUBJECT_ID may repeat across terms/academic years; SUBJECT_OFFERED: section scope, same SUBJECT_ID appears once per section; SUBJECT_SUMMARY / SUBJECT_OFFERED_SUMMARY: subject scope per term, one row per SUBJECT_ID per term; TIP and LIBRARY tables: program scope, SUBJECT_ID present only if the subject is tracked by that program\"}], \"decision_guide\": {\"Joining textbook materials or library reserves to catalog/summary subject attributes\": \"Match on SUBJECT_ID (plus TERM_CODE when term scope matters).\", \"Joining catalog offerings that only expose SUBJECT_CODE/SUBJECT_NUMBER to SUBJECT_ID-based tables\": \"Reconstruct SUBJECT_ID as CONCAT(SUBJECT_CODE, '.', SUBJECT_NUMBER).\", \"Counting distinct subjects per term/department\": \"Use COUNT(DISTINCT SUBJECT_ID) on a subject-grain table (SUBJECT_SUMMARY or SUBJECT_OFFERED_SUMMARY) to avoid section/program duplication.\"}}, {\"columns\": [\"ACADEMIC_TERMS.ACADEMIC_YEAR\", \"ACADEMIC_TERMS_ALL.ACADEMIC_YEAR\", \"COURSE_CATALOG_SUBJECT_OFFERED.ACADEMIC_YEAR\", \"TIME_DAY.ACADEMIC_YEAR\", \"TIME_DAY.FISCAL_YEAR\", \"TIME_DAY.CALENDAR_YEAR\", \"TIME_MONTH.ACADEMIC_YEAR\", \"TIME_MONTH.FISCAL_YEAR\", \"TIME_MONTH.CALENDAR_YEAR\", \"TIME_MONTH.FINANCIAL_AID_YEAR\", \"TIME_QUARTER.FISCAL_YEAR\", \"TIME_QUARTER.CALENDAR_YEAR\", \"ACADEMIC_TERMS.FINANCIAL_AID_YEAR\", \"ACADEMIC_TERMS_ALL.FINANCIAL_AID_YEAR\", \"ACADEMIC_TERMS.DEGREE_YEAR\"], \"comparisons\": [{\"dimension\": \"Year system\", \"detail\": \"ACADEMIC_YEAR is the academic year a term/offering/date belongs to; FISCAL_YEAR is the institute fiscal year (MIT fiscal year starts in July, so a fiscal year spans two calendar years); CALENDAR_YEAR is the natural calendar year; FINANCIAL_AID_YEAR is the aid year a term/month maps to; DEGREE_YEAR is the degree-conferral year a term maps to. These year systems do not always coincide for the same term or date.\"}, {\"dimension\": \"Location\", \"detail\": \"Term tables (ACADEMIC_TERMS/ACADEMIC_TERMS_ALL) carry academic/financial-aid/degree years per term; COURSE_CATALOG_SUBJECT_OFFERED carries its own ACADEMIC_YEAR per catalog record; the time dimension tables carry year systems at their own granularity: TIME_DAY (fiscal/calendar/academic year per day), TIME_MONTH (fiscal/calendar/academic/aid year per month), TIME_QUARTER (fiscal/calendar year per quarter, no academic year).\"}, {\"dimension\": \"Grouping behavior\", \"detail\": \"Grouping offerings by catalog ACADEMIC_YEAR vs joining to term tables' ACADEMIC_YEAR can yield different groupings when a catalog record's TERM_CODE and ACADEMIC_YEAR disagree; grouping time-dimension rows by FISCAL_YEAR vs CALENDAR_YEAR yields different period assignments for dates between January and June.\"}], \"decision_guide\": {\"Yearly statistics over subject offerings\": \"Group by COURSE_CATALOG_SUBJECT_OFFERED.ACADEMIC_YEAR when the question says 'academic year YYYY' for offerings; join term tables for term-status filters.\", \"Yearly statistics over terms themselves (e.g. degree year geometric means, financial aid year partitions)\": \"Use ACADEMIC_TERMS / ACADEMIC_TERMS_ALL year columns (DEGREE_YEAR, FINANCIAL_AID_YEAR).\", \"Matching IAP activity dates to academic years via calendar\": \"Use TIME_DAY.FISCAL_YEAR or TIME_DAY.ACADEMIC_YEAR through TERM_CODE = ACADEMIC_TERM_CODE.\", \"Windowed running sums partitioned by aid year\": \"Use ACADEMIC_TERMS_ALL.FINANCIAL_AID_YEAR as the partition key.\", \"Fiscal-year or calendar-month statistics over months/days\": \"Use TIME_MONTH.FISCAL_YEAR / TIME_MONTH.CALENDAR_YEAR (month grain) or TIME_DAY.CALENDAR_YEAR (day grain), joined on FISCAL_PERIOD when both grains are needed.\"}, \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\", \"id\": \"column_concept_year_columns\", \"name\": \"Academic and Fiscal Year Columns\"}, {\"id\": \"column_concept_term_code\", \"name\": \"Term Code\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\", \"columns\": [\"ACADEMIC_TERMS.TERM_CODE\", \"ACADEMIC_TERMS_ALL.TERM_CODE\", \"ACADEMIC_TERM_PARAMETER.TERM_CODE\", \"COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE\", \"COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE\", \"SUBJECT_OFFERED.TERM_CODE\", \"SUBJECT_OFFERED_SUMMARY.TERM_CODE\", \"SUBJECT_SUMMARY.TERM_CODE\", \"TIP_DETAIL.TERM_CODE\", \"TIP_SUBJECT_OFFERED.TERM_CODE\", \"LIBRARY_SUBJECT_OFFERED.TERM_CODE\", \"LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE\", \"IAP_SUBJECT_DETAIL.TERM_CODE\", \"TIME_DAY.ACADEMIC_TERM_CODE\"], \"comparisons\": [{\"dimension\": \"Semantics\", \"TERM_CODE (fact tables)\": \"The term in which the offering/material/activity record exists\", \"EFFECTIVE_TERM_CODE (COURSE_CATALOG_SUBJECT_OFFERED)\": \"The term from which the catalog attributes take effect; may differ from the record's TERM_CODE\", \"TIME_DAY.ACADEMIC_TERM_CODE\": \"The academic term a calendar day belongs to\"}, {\"dimension\": \"Join behavior\", \"TERM_CODE\": \"Direct equality join between fact tables and ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\", \"EFFECTIVE_TERM_CODE\": \"Joined to ACADEMIC_TERMS.TERM_CODE when catalog attributes must be evaluated as of the term they became effective\", \"ACADEMIC_TERM_CODE\": \"Joined to term tables' TERM_CODE or to fact tables' TERM_CODE for calendar attributes\"}], \"decision_guide\": {\"Filtering subject offerings by the term they are offered in\": \"Use the fact table's TERM_CODE.\", \"Filtering catalog attributes by when they took effect (e.g. regular-term status of the effective term)\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE joined to ACADEMIC_TERMS.TERM_CODE.\", \"Attaching calendar day attributes (day of week, fiscal year) to terms or IAP activities\": \"Use TIME_DAY.ACADEMIC_TERM_CODE or TIME_DAY.CALENDAR_DATE = TERM_START_DATE.\", \"Resolving 'current/previous/upcoming term' references\": \"Use ACADEMIC_TERM_PARAMETER.TERM_CODE with TERM_INDICATOR.\"}}], \"not_found\": []}"
    },
