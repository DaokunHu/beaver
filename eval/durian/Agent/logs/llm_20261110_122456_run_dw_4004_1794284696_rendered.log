      "tool_call_id": "call_4c5a45252da34b4c9f05a39d",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"columns\": {\"SIS_COURSE_DESCRIPTION_KEY\": {\"desc\": \"Surrogate key of the course description record\"}, \"COURSE\": {\"desc\": \"Course/subject code, e.g. '18'; joins to SIS_SUBJECT_CODE.SUBJECT_CODE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"COURSE_DESCRIPTION\": {\"desc\": \"Short course description text; its character length is used in description-length statistics\"}, \"COURSE_DESCRIPTION_LONG\": {\"desc\": \"Long-form course description text\"}, \"DEPARTMENT\": {\"desc\": \"Department code offering the course; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name offering the course\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME\": {\"desc\": \"School name offering the course, e.g. 'Engineering'\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"FROM_TERM\": {\"desc\": \"First term the course description is effective from\"}, \"FROM_TERM_DESCRIPTION\": {\"desc\": \"Description of the from-term\"}, \"THRU_TERM\": {\"desc\": \"Last term the course description is effective through\"}, \"THRU_TERM_DESCRIPTION\": {\"desc\": \"Description of the thru-term\"}, \"COURSE_OPTION\": {\"desc\": \"Course option designation\"}, \"COURSE_LEVEL\": {\"desc\": \"Course level code, e.g. 'U' = undergraduate, 'G' = graduate\"}, \"CIP_PROGRAM_CODE\": {\"desc\": \"Six-digit CIP (Classification of Instructional Programs) program code of the course; joins to CIP.PROGRAM_CODE (current classification, one row per code) and CIP_WITH_VERSION.PROGRAM_CODE (all revision versions)\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the course counts toward a degree\"}, \"DEFAULT_ULTIMATE_DEGREE\": {\"desc\": \"Default ultimate degree awarded for the course\"}, \"GRADAUTE_LEVEL\": {\"desc\": \"Legacy misspelled graduate level column (kept for compatibility)\"}, \"GRADUATE_LEVEL\": {\"desc\": \"Graduate level designation of the course\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per course description\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}, {\"id\": \"CIS_COURSE_CATALOG\", \"name\": \"CIS_COURSE_CATALOG\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\", \"columns\": {\"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether offered during IAP\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog record\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, SUBJECT_CODE.SUBJECT_NUMBER\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject code, e.g. '18'\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_SUBJECT_CODE.DEPARTMENT_CODE and SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which catalog attributes take effect\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject; joins to CIS_COURSE_CATALOG-based subject title matching\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description\"}, \"HGN_CODE\": {\"desc\": \"HGN level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text\"}, \"JOINT_SUBJECTS\": {\"desc\": \"Joint subjects list\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether offered this academic year\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"SECTION_ID\": {\"desc\": \"Section identifier\"}, \"TERM_CODE\": {\"desc\": \"Term code of the catalog record\"}}, \"default_granularity\": \"one row per subject per term in the CIS course catalog\"}, {\"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS_ALL.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2025FA' (FA=Fall, SP=Spring, JA=January/IAP, SU=Summer)\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description, e.g. 'Fall Term 2024-2025'\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date; can match TIME_DAY.CALENDAR_DATE for calendar-based joins\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to, e.g. 2025\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"IS_REGULAR_TERM\": {\"desc\": \"'Y'/'N' flag indicating a regular term (Fall/Spring) versus non-regular terms (Summer, January/IAP); only present in ACADEMIC_TERMS, not in ACADEMIC_TERMS_ALL\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"TERM_STATUS\": {\"desc\": \"Term status text: 'Previous', 'Current', 'Future', or 'Unspecified'\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to; used in degree-year statistics\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"ADD_DATE\": {\"desc\": \"Last day to add a subject in the term; only present in ACADEMIC_TERMS\"}, \"DROP_DATE\": {\"desc\": \"Last day to drop a subject in the term; only present in ACADEMIC_TERMS\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period for the term\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period for the term\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_d3542a73c8374d95b15210d0",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level where the course is degree granting and the total units are greater than 6, provide the number of unique courses, the minimum total units offered, and the number of courses where the design units are at least 3. Do not return any rounded answers.\", \"id\": \"dw_3163\", \"name\": \"Degree-Granting Course Level Counts with Min Total Units and Design-Unit Course Counts\", \"sql\": \"WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT scd.COURSE) AS course_count, MIN(ccc.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units, COUNT(DISTINCT CASE WHEN ccc.DESIGN_UNITS >= 3 THEN scd.COURSE END) AS courses_with_design_units_3_or_more FROM inner_cte ic JOIN SIS_COURSE_DESCRIPTION scd ON ic.DEPARTMENT_NAME = scd.DEPARTMENT_NAME AND ic.COURSE_LEVEL = scd.COURSE_LEVEL JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units;\"}, {\"category\": \"Academic Term and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per previous-status term\", \"desc\": \"For each academic term where the term status indicator is 'P', show the term code, the term parameter, the term description, the academic year, the term start date, and the average academic year in a window of 2 preceding and 2 following rows grouped by the term indicator and ordered by the term start date. Additionally, for the academic year of each such term, give the academic year description, the average total units, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in regular terms, with the results ordered by term code and by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\", \"id\": \"dw_3417\", \"name\": \"Previous Terms Windowed Academic Year Average with Regular-Term Unit Stddev by Year\", \"sql\": \"WITH AcademicYearStats AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS avg_total_units, STDDEV(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS stddev_total_units FROM ACADEMIC_TERMS JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC ORDER BY stddev_total_units DESC ), PreviousTerms AS ( SELECT t0.TERM_CODE, t1.TERM_PARAMETER, t2.TERM_DESCRIPTION, t0.ACADEMIC_YEAR, t1.TERM_START_DATE, AVG(t0.ACADEMIC_YEAR) OVER ( PARTITION BY t1.TERM_INDICATOR ORDER BY t0.TERM_START_DATE ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN ACADEMIC_TERM_PARAMETER t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_INDICATOR = 'P' ) SELECT pts.TERM_CODE, pts.TERM_PARAMETER, pts.TERM_DESCRIPTION, pts.ACADEMIC_YEAR, pts.TERM_START_DATE, pts.window_column, ays.ACADEMIC_YEAR_DESC, ays.avg_total_units, ays.stddev_total_units FROM PreviousTerms pts JOIN AcademicYearStats ays ON pts.ACADEMIC_YEAR = ays.ACADEMIC_YEAR ORDER BY pts.TERM_CODE, ays.stddev_total_units DESC;\"}, {\"category\": \"Subject Offering Analysis\", \"default_granularity\": \"one row per department per academic year\", \"desc\": \"For each academic year, what is the description of the academic year, the department name, the average total units for all subjects offered by that department in terms that match that academic year and have a term status indicator of 'P', and the deviation of each department's average total units from the overall average total units for that academic year? Do not return any rounded answers.\", \"id\": \"dw_2597\", \"name\": \"Department Average Total Units Deviation from Yearly Overall Average in Previous Terms\", \"sql\": \"WITH inner_cte AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS dept_avg_total_units FROM ACADEMIC_TERMS_ALL JOIN ACADEMIC_TERMS ON ACADEMIC_TERMS_ALL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.TERM_STATUS_INDICATOR = 'P' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.ACADEMIC_YEAR_DESC, inner_cte.DEPARTMENT_NAME, inner_cte.dept_avg_total_units, (inner_cte.dept_avg_total_units - overall.avg_total_units) AS deviation_from_overall_avg FROM inner_cte JOIN ( SELECT ACADEMIC_YEAR, AVG(dept_avg_total_units) AS avg_total_units FROM ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS dept_avg_total_units FROM ACADEMIC_TERMS_ALL JOIN ACADEMIC_TERMS ON ACADEMIC_TERMS_ALL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.TERM_STATUS_INDICATOR = 'P' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME ) dept_avgs GROUP BY ACADEMIC_YEAR ) overall ON inner_cte.ACADEMIC_YEAR = overall.ACADEMIC_YEAR ORDER BY inner_cte.ACADEMIC_YEAR, deviation_from_overall_avg DESC;\"}], \"not_found\": []}"
    },
