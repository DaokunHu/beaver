          "type": "function",
          "function": {
            "name": "mysql_query",
            "arguments": "{\"sql\": \"SELECT COUNT(*) AS cnt FROM (\\nSELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL,\\n       COUNT(DISTINCT scd.COURSE) AS course_count,\\n       MIN(ccc.TOTAL_UNITS) AS min_total_units,\\n       COUNT(DISTINCT CASE WHEN ccc.DESIGN_UNITS >= 3 THEN scd.COURSE END) AS courses_with_design_units_3_or_more\\nFROM SIS_COURSE_DESCRIPTION scd\\nJOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE\\nJOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE\\nWHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6\\nGROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL) t;\"}"
          }
        },
        {
          "id": "call_a33350c7f96245f39daffe71",
          "type": "function",
          "function": {
            "name": "mysql_query",
            "arguments": "{\"sql\": \"SELECT COUNT(*) AS subject_rows FROM ACADEMIC_TERMS at\\nJOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE\\nWHERE at.IS_REGULAR_TERM = 'Y';\"}"
          }
        }
      ]
