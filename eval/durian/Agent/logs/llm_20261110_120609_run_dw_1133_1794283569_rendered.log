            "name": "mysql_query",
            "arguments": "{\"sql\": \"SELECT COUNT(*) FROM SIS_DEPARTMENT\"}"
          }
        },
        {
          "id": "call_6dea82f37ddd4fdcbefdb352",
          "type": "function",
          "function": {
            "name": "semantic_search",
            "arguments": "{\"query\": \"top 10 departments by number of subjects offered 2022 academic year degree-granting exclude Political Science\", \"topk\": 20}"
          }
        }
      ]
