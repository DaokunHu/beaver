    {
      "role": "tool",
      "tool_call_id": "call_2b445bb33812470cb9655e6c",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 97, \"items_by_type\": {\"table\": [{\"id\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\"}, {\"id\": \"CIS_COURSE_CATALOG\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\"}, {\"id\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\"}, {\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\"}, {\"id\": \"DRUPAL_COURSE_CATALOG\", \"desc\": \"Drupal-sourced course catalog table: an alternative catalog feed with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags, section flags, meeting time/place), plus subject-offering reference columns (SO_SUBJECT_ID, SO_TERM_CODE, SO_TERM_DESCRIPTION, SO_CLUSTER_TYPE) linking catalog records to registrar subject offerings.\"}, {\"id\": \"STUDENT_DEGREE_PROGRAM\", \"desc\": \"19 columns in total\"}, {\"id\": \"SUBJECT_OFFERED\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\"}, {\"id\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\"}, {\"id\": \"FCLT_ORGANIZATION\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\"}, {\"id\": \"STUDENT_DEPARTMENT\", \"desc\": \"Student-facing department lookup table with department code, name, full name, and school attribution (code and name). Similar in content to SIS_DEPARTMENT but oriented to student information systems reporting; joins to offering tables via DEPARTMENT_CODE.\"}, {\"id\": \"FAC_ORGANIZATION\", \"desc\": \"Facilities organization snapshot table with the same hierarchical organization structure as FCLT_ORGANIZATION (organization identifiers, parent/major organization, level, assignable flag, course number, description, HR cross-references) but keyed by ORGANIZATION_KEY and carrying D_CODE instead of DLC_KEY/DLC_NAME. Contains fewer organizations than FCLT_ORGANIZATION; used as an alternative organization dimension in FAC_* family queries.\"}, {\"id\": \"SIS_SUBJECT_CODE\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\"}, {\"id\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\"}, {\"id\": \"HR_ORG_UNIT_NEW\", \"desc\": \"Newer HR organization unit dimension table: one row per HR organization unit with the same unit/department identity and hierarchy-path structure as HR_ORG_UNIT (unit key/ID/title/level, HR department code and name variants, school-area/top-level/root names, hierarchy path levels 1-5, DLC_KEY) but a shallower hierarchy path (levels 6-7 absent), no HR_DEPARTMENT_ID and no DLC_NAME column, and an extra HR_DEPARTMENT_ABBR abbreviation column. Holds more unit rows than HR_ORG_UNIT (691 vs 641, including units absent from HR_ORG_UNIT); use HR_ORG_UNIT when DLC_NAME or the deeper hierarchy path is required, HR_ORG_UNIT_NEW for the newer unit coverage.\"}, {\"id\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\"}, {\"id\": \"HR_ORG_UNIT\", \"desc\": \"HR organization unit dimension table: one row per HR organization unit with unit key/ID/title, unit level classification (ALL MIT, TOP LEVEL, DEPARTMENTS, SUB DEPARTMENT, ORGANIZATION LEVEL, NON HIERARCHY ORG UNITS), HR department identifiers and name variants (short, long, alphabetical), organization hierarchy area names (school area, top level, root), the full HR hierarchy path levels 1-7 (each with ID, sort order, and name), and DLC_KEY/DLC_NAME cross-references to departments/labs/centers. Joined from FCLT_ORGANIZATION and MASTER_DEPT_HIERARCHY via DLC_KEY to attach HR department attributes (title, level, department name, long name, hierarchy path) to facilities organizations and DLCs; a single DLC_KEY can map to multiple HR org unit rows, so joins via DLC_KEY may fan out.\"}, {\"id\": \"MASTER_DEPT_HIERARCHY\", \"desc\": \"Master department hierarchy table: one row per department/lab/center (DLC) under the 'Standard Hierarchy' hierarchy type, recording the DLC key/code/name and its five-level hierarchy path from the institute root (level 1 'All Departments') through executive areas down to the DLC's placement, with each level's code and name (null for levels deeper than the DLC's position). Joins to HR_ORG_UNIT and FCLT_ORGANIZATION via DLC_KEY; used to report or filter the master-hierarchy placement (school/area path) of a DLC, and as a DLC scope filter when only DLCs present in the standard hierarchy should be included.\"}, {\"id\": \"SPACE_UNIT\", \"desc\": \"Space unit dimension table: one row per space unit (an organizational space-assignment unit such as a department, program, or office that receives space allocation), with space unit key/code, space unit name, the facilities organization it belongs to, and DLC key. Bridges FCLT_ORGANIZATION (organization attribution) and SPACE_DETAIL (rooms assigned to the space unit); used to group room counts and space statistics by space unit.\"}, {\"id\": \"LIBRARY_COURSE_INSTRUCTOR\", \"desc\": \"Library course instructor table recording instructors of courses with library reserve materials, including course name, instructor name, department (in 'COURSE_NUMBER - Department Name' format), assignment date range, and library organizational unit/branch. Referenced by LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_COURSE_INSTRUCTOR_KEY; instructor names resolve to person records via INSTRUCTOR_NAME = SE_PERSON.FULL_NAME.\"}, {\"id\": \"CIS_HASS_ATTRIBUTE\", \"desc\": \"CIS lookup table decoding HASS (Humanities, Arts, and Social Sciences) attribute codes used in course catalog subject records. Each code (e.g. 'HA', 'HH', 'HS', 'HE', 'HD1'-'HD5', 'HDL', and combined codes like 'HA,HH') maps to two description variants: the description shown on the registration form and the shorter description printed in the bulletin, plus the CIS attribute group ('H' = HASS_ATTRIBUTE for students entering Fall 2010 or later, 'G' = GIR_ATTRIBUTE for students entering prior to Fall 2010) with a group note, and icon display attributes. Catalog tables (COURSE_CATALOG_SUBJECT_OFFERED, CIS_COURSE_CATALOG, DRUPAL_COURSE_CATALOG) join to this lookup via HASS_ATTRIBUTE. Note: a code can appear once per attribute group (e.g. 'HE' exists in both group H and group G), so joins on HASS_ATTRIBUTE alone may produce multiple matching rows.\"}, {\"id\": \"LIBRARY_SUBJECT_OFFERED\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\"}, {\"id\": \"CIP\", \"desc\": \"Classification of Instructional Programs (CIP) lookup table: one row per six-digit CIP program code, classifying instructional programs into a two-digit category and a four-digit series, with program/category/four-digit titles, a change note, the CIP revision version year (1990/2000/2010/2020), and the warehouse load date. Joins to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE to attribute courses to CIP programs, categories, and schools/departments; CIP_WITH_VERSION is the multi-version variant keeping every revision of each program code.\"}, {\"id\": \"SUBJECT_ATTRIBUTE\", \"desc\": \"Subject attribute lookup table decoding attribute codes attached to subjects: academic attributes (type 'A') such as calculus/science prerequisites and HASS-D/HASS category codes, and non-academic program flags (type 'N') such as ROTC, ESG, Concourse, co-op, and listener rules. Provides short, full, and reporting descriptions per code. Overlaps with CIS_HASS_ATTRIBUTE on HASS-family codes (HD1-HD5, HDL, HE, HA, HH, HS) but differs in scope: SUBJECT_ATTRIBUTE covers all subject attribute types with one description variant per code, while CIS_HASS_ATTRIBUTE covers only HASS attribute codes with separate registration-form and bulletin descriptions plus attribute-group (H/G) classification. Catalog subject records' GIR_ATTRIBUTE codes all resolve against SUBJECT_ATTRIBUTE_CODE.\"}, {\"id\": \"FCLT_ROOMS\", \"desc\": \"Facilities room inventory table: one row per physical room with building/floor keys, room identifiers, use classifications (major/minor use), organization assignment, area in square meters, access level, and geographic coordinates. Joins to FCLT_BUILDING via FCLT_BUILDING_KEY; referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE via FCLT_ROOM_KEY.\"}, {\"id\": \"TIP_DETAIL\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\"}, {\"id\": \"ACADEMIC_TERMS_ALL\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\"}, {\"id\": \"MASTER_DEPT_HIERARCHY_LINKS\", \"desc\": \"Master department hierarchy link table: one row per association between a department/lab/center (DLC) and a linked administrative object, classified by link type (Standard Funds Center, PCMIT-0 Profit Center, New/Old Org. Unit, Facilities Org., Student Systems Unit, NIMBUS B.A.G.). A DLC may hold many links of several types. Joins to MASTER_DEPT_HIERARCHY via DLC_KEY; used to map DLCs to their fund centers, profit centers, facilities organizations, and other linked object codes.\"}, {\"id\": \"HR_FACULTY_ROSTER\", \"desc\": \"HR faculty roster table: one row per faculty member keyed by MIT_ID with name components, terminal degree, appointment type, job/position titles across HR, administrative, and directory organization units, endowed chair, and emeritus status. Used for faculty appointment and credential analysis; joins to EMPLOYEE_DIRECTORY on MIT_ID for contact details.\"}, {\"id\": \"TIP_MATERIAL_STATUS\", \"desc\": \"TIP material status lookup table decoding material status keys/codes used in TIP_DETAIL. Holds 12 status rows where key and code are identical: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and four keys ('NL', 'NS', 'NB', and a blank/space key) that share a NULL description.\"}], \"metric\": [{\"id\": \"dw_3163\", \"desc\": \"For each department name and course level where the course is degree granting and the total units are greater than 6, provide the number of unique courses, the minimum total units offered, and the number of courses where the design units are at least 3. Do not return any rounded answers.\"}, {\"id\": \"dw_2924\", \"desc\": \"For degree-granting courses in the School of Engineering, show the course description, department name, subject title, and the subject's grade type description, but only include those courses where the total units for the subject exceed the average total units for that department. Do not return any rounded answers.\"}, {\"id\": \"dw_3904\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name (from subject code), school name, the number of subject codes per school name and whether the subject code description is present ('Has Description') or missing ('No Description'), and for each matching department in subjects offered in the term with code '2022SU', show the subject's ID, total units, department name (from subject offered), and their dense rank considering the current and 2 preceding rows ordered by the total number of units. For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes, null, null, null, null). Do not return any rounded answers.\"}, {\"id\": \"dw_3989\", \"desc\": \"For each department and each subject offered in the academic year 2024, show the department name, subject code, subject number, subject title, term code, term description, and the highest minimum total units (in a window of 3 preceding and 1 following row ordered by academic year) for that subject, along with the course description, subject code description, and the difference between the number of characters in the course description and the average number of characters in course descriptions for that department, for courses in the School of Engineering that are degree granting. Do not return any rounded answers.\"}, {\"id\": \"dw_3273\", \"desc\": \"For courses in the School of Engineering with a total of 12 units, display the course number, course description, subject title, total units, offering department name, the row number of the course within its offering department ordered by course number, and the dense rank of the subject (considering the current and 2 preceding rows ordered by total units) if available. Do not return any rounded answers.\"}, {\"id\": \"dw_1427\", \"desc\": \"For each course in the Mathematics department that is degree granting and has a course level of 'G', show the course description, department name, school name, the administrative department name, and the dense rank over the administrative department name ordered by the administrative department name. Additionally, for each administrative department name, include a grand total of the number of such courses in the format of (null, null, null, administrative department name, null, total courses). Also, show the minimum total units, the sum of lecture units, and the number of unique subjects for letter graded Mathematics department subjects offered in the Spring Term 2021, along with the department name and term description (with all other columns as null). Do not return any rounded answers.\"}, {\"id\": \"dw_1393\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_2335\", \"desc\": \"For each department name and course level, where the total number of enrolled students in offered subjects is greater than 10, and the department is Mathematics (Course 18), provide the number of unique courses, the minimum total units among those subjects that are degree-granting courses, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for Mathematics courses (considering only departments that offer more than five courses), and the number of unique subject codes for Mathematics in the SIS_SUBJECT_CODE table. List the department name, course level, number of unique courses, minimum total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the number of unique subject codes, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_3311\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\"}, {\"id\": \"dw_3294\", \"desc\": \"For courses in the School of Engineering that are degree granting, and for academic term parameters where the term indicator is 'C', show the course description, department name, the dense rank of each course considering the current and 2 preceding rows ordered by the department's budget code, the term parameter, the term code, the academic year, and the running sum of academic years within each department ordered by academic year, for cases where the department matches in both sets. Do not return any rounded answers.\"}, {\"id\": \"dw_3828\", \"desc\": \"For courses in the School of Engineering that are degree granting, show the course description, department name, the dense rank of each course considering the current and 2 preceding rows ordered by the department's budget code, the subject code description, and the row number of each course within a window of 2 preceding and 1 following rows ordered by course description. Do not return any rounded answers.\"}, {\"id\": \"dw_3660\", \"desc\": \"For courses in the School of Engineering that are degree granting, and for each subject offered in the term with the description \\\"Fall Term 2024-2025\\\" by the same department, show the course description, department name, the dense rank of each course considering the current and 2 preceding rows ordered by the department's budget code, the subject offered key, subject title, offering department name, the term description, and the rank of each subject within its offering department ordered by subject offered key. Do not return any rounded answers.\"}, {\"id\": \"dw_1692\", \"desc\": \"For each department name and course level in the Mathematics department (Course 18) where the total number of enrolled students in offered subjects is greater than the average number of enrolled students for that department and the subjects are degree-granting, provide the number of unique courses and the minimum total units among those subjects, along with the term description, the minimum total units, the sum of lecture units, and the number of unique subjects for letter graded Mathematics subjects offered in the Spring Term 2021. List the columns in the following order: department name, course level, number of unique courses, minimum total units from the first set, term description, minimum total units from the second set, sum of lecture units, and number of unique subjects. Do not return any rounded answers.\"}, {\"id\": \"dw_4756\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\"}, {\"id\": \"dw_4812\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_2151\", \"desc\": \"For each department that grants degrees (excluding the Biology department), provide the department name, the average and variance of the total units for subjects offered by that department in the 2022 academic year, and, if the department is Political Science, also include for each HGN code the maximum number of lecture units among all subjects in the course catalog and the subject title from the subject offered table for subjects offered in the year 2012 with more than 2 lecture units, as well as the number of enrolled students for those subjects. List the results ordered by the variance of total units in descending order, and for Political Science, by the maximum lecture units in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_2210\", \"desc\": \"For each subject code in degree-granting departments where the department is Mathematics, and for subjects offered in the academic year 2024 that are also present in the CIS course catalog and are in the Mathematics department, show the subject code, subject code description, department name, school name, rank of the subject code within each school name group ordered by subject code, subject ID, subject number, subject short title, subject title, lecture units, lab units, total units, grade type, grade rule, the minimum total units value over each department code group, and the subject description from the CIS course catalog, ordered by school name, rank, and subject number. Do not return any rounded answers.\"}, {\"id\": \"dw_4490\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name, school name, the number of subject codes per school name, and whether the subject code description is present ('Has Description') or missing ('No Description'). For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes). Additionally, for subjects offered in the term '2016SP' with a school code of 'E', show the subject title, course description, the offering department name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Present all columns in the following order: subject code, subject code description, department name, school name, description status, total subject codes, subject title, course description, offering department name, and window column. Do not return any rounded answers.\"}, {\"id\": \"dw_3493\", \"desc\": \"For subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook, show the subject code, subject number, department name, subject title, term description, total units, the average subject enrollment number in a window of 2 preceding and 2 following rows grouped by department code and ordered by total units, the textbook material key, the textbook material status key, and the row number of the course within each department ordered by subject code. List the results in order by department name, subject code, and subject number. Do not return any rounded answers.\"}, {\"id\": \"dw_1766\", \"desc\": \"For each department name and course level where the course is degree granting, the total units are greater than 6, and the department is Mathematics (Course 18), provide the department name, course level, number of unique courses, minimum total units offered, school name, number of distinct course options available, and the highest average number of enrolled students in any term for courses offered by that department, considering only courses with more than 0 enrolled students and departments whose name is not null. Do not return any rounded answers.\"}, {\"id\": \"dw_2272\", \"desc\": \"For the Mathematics department, what is the department name, the average of the total units, the range of the total units, the variance of the total units for courses with total units greater than 0, and for each course level, what is the number of unique students and the minimum CIP program code among their courses, considering only degree-granting departments? Additionally, for each course level, what is the average number of lecture units and the maximum number of lab units for Mathematics courses? Do not return any rounded answers.\"}, {\"id\": \"dw_2090\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units in the Mathematics department, show the subject code, subject number, subject title, department name, term description, and the rank of each subject within its department ordered by subject code, along with the department name, school name, the highest number of degree-granting undergraduate courses in the Mathematics department (Course 18), and the subject short title and subject description for each subject. Do not return any rounded answers.\"}, {\"id\": \"dw_4448\", \"desc\": \"For each department, show the department name, the highest total units among its subjects with exactly 12 units in the Fall Term 2024-2025, and for each course in that department that was offered in 2022 and has at least one required or optional textbook and has total units greater than the average for such courses, show the course's subject code, subject number, subject title, the term description, the textbook material key, the textbook material status key, and the row number within the department ordered by subject code. Do not return any rounded answers.\"}, {\"id\": \"dw_3901\", \"desc\": \"For each offer department code in the 2012SU term with total units greater than 0, list the subject title, course number, department name, the dense rank over the offer department code, the course, course description, school name, program code, program title, category code, category title, four digit code, four digit title, and the minimum warehouse load date from the CIP table over each category code group for courses in department 6, and include a grand total of subjects per offer department code and a grand total for all courses in each school in the format (nulls for subject-specific fields, department name, total subjects, course-specific fields, school name, and total courses). Do not return any rounded answers.\"}, {\"id\": \"dw_3644\", \"desc\": \"For subjects offered in the 2012SU term with a total of 1 unit, show the subject title from the summary, the course number from the offered table, the subject title from the offered summary, the department name from the summary, the offer department name from the offered summary, the row number within each department name group ordered by subject title from the summary, and for each department, also provide the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student). List the results ordered by department name and row number. Do not return any rounded answers.\"}, {\"id\": \"dw_3277\", \"desc\": \"List all subject titles that are either (a) offered in the term '2022FA' with a total of 12 units, showing the subject title, department name from the course description, and the dense rank of each subject considering the current and 2 preceding rows ordered by the subject code from the course catalog, or (b) for each subject offered, show the subject title, subject ID, offer department name, offer school name, term description, academic year, and the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject key. The results should include all these columns in the following order: subject title, department name, window column, offer department name, offer school name, term description, academic year, and maximum number of enrolled students, with NULLs for columns not relevant to each case. Do not return any rounded answers.\"}, {\"id\": \"dw_4911\", \"desc\": \"From the top 10 subjects offered by departments in the School of Engineering with the highest maximum enrolled students (considering the current and next 2 rows ordered by subject key), display each subject's title, total units, department full name, row number within a window of 2 preceding and 1 following rows ordered by subject title, subject ID, offer department name, offer school name, term description, academic year, and the department that offered the subject. Do not return any rounded answers.\"}, {\"id\": \"dw_1335\", \"desc\": \"List, for each department, either (a) the department's full name, the range and variance of the total units for degree-granting Mathematics department courses offered in the 2008 academic year along with the long course description for each course (with the reason 'Math 2008 Stats'), or (b) the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units) where the average total units is greater than the overall average across all departments (with the reason 'High Avg Units'). Show the columns in the following order: department name, total units range, total units variance, average total units, standard deviation (using STDDEV only and never STDDEV_POP) of total units, long course description, and reason for inclusion. Do not return any rounded answers.\"}, {\"id\": \"dw_3280\", \"desc\": \"For subjects offered in the 2019FA term that have total units greater than 1, show the subject title, the dense rank of each subject considering the current and 2 preceding rows ordered by the academic year, the subject ID, the department name, and the running sum of total units within each school ordered by subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_4683\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\"}], \"concept\": [{\"id\": \"concept_course_catalog_sources\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\"}, {\"id\": \"concept_subject_offering_facts\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\"}, {\"id\": \"concept_cip_program_classification\", \"desc\": \"Lookup tables of the Classification of Instructional Programs (CIP) used to classify courses/instructional programs into two-digit categories, four-digit series, and six-digit program codes, with revision version years (1990/2000/2010/2020). CIP holds the current single-version classification (one row per program code, with a change NOTE), while CIP_WITH_VERSION preserves every revision of each program code across versions. Both join to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE to attribute courses to CIP programs and categories.\"}, {\"id\": \"concept_department_dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\"}, {\"id\": \"concept_dept_hr_org_hierarchy\", \"desc\": \"Tables describing the institute's department/lab/center (DLC) and HR organization hierarchies: the HR organization unit dimension in two feed variants (HR_ORG_UNIT, HR_ORG_UNIT_NEW), the master department standard hierarchy path (MASTER_DEPT_HIERARCHY), its DLC-to-administrative-object link table (MASTER_DEPT_HIERARCHY_LINKS), and the direct-parent department lookup (MASTER_DEPT_DCODE_PARENT). They jointly answer questions about which HR department/area a DLC or organization belongs to, the hierarchy path or parent of a department, and HR department names/codes/levels, and are joined to FCLT_ORGANIZATION via DLC_KEY for facilities/space attribution. They differ in hierarchy representation (full path vs direct parent vs HR unit attributes), unit coverage, and companion columns.\"}, {\"id\": \"concept_academic_term_dimension\", \"desc\": \"Tables describing academic terms and their calendar/status attributes. They jointly answer questions about when terms run, which academic/financial-aid/degree year a term belongs to, and whether a term is current, previous, future, or regular. Coverage differs: the full historical term list, the status-tracked term subset, and the three-row relative term parameter reference.\"}, {\"id\": \"concept_course_material_programs\", \"desc\": \"Tables covering course material provisioning: the Textbook Information Program (TIP) tracking textbook adoption status per subject offering, and library reserve processing tracking catalog items placed on reserve for subjects. They jointly answer questions about which subjects have course materials/textbooks, material status (TIP statuses such as 'RQ' Required, 'EO' Electronic options; library statuses such as 'U' Unknown, 'Y' Required Course Material), ISBNs, record counts, and reserve catalog item attributes. The two programs are linked by SUBJECT_ID + TERM_CODE.\"}, {\"id\": \"concept_facility_organization_dimension\", \"desc\": \"Organization dimension tables describing the institute's hierarchical organization tree used for facilities/space attribution: FCLT_ORGANIZATION (keyed by FCLT_ORGANIZATION_KEY, with DLC_KEY/DLC_NAME) and FAC_ORGANIZATION (keyed by ORGANIZATION_KEY, with D_CODE). They answer the same questions about organization names, hierarchy levels, parent/major organizations, assignable flags, and HR cross-references, but belong to different table families and coverage.\"}, {\"id\": \"concept_room_major_use_classification\", \"desc\": \"Lookup tables classifying rooms by major use (classrooms, offices, laboratories, residential, circulation, etc.) with a short code, description, and assignable-space flag. They cover the current classification in the FCLT and FAC table families and the fiscal-period historical classification in the FCLT family, jointly answering questions about what a room is primarily used for and whether that use counts as assignable space.\"}, {\"id\": \"concept_space_unit_dimension\", \"desc\": \"Space unit lookup tables identifying the organizational units that receive space allocation: SPACE_UNIT (with FCLT_ORGANIZATION_KEY organization attribution) and SPACE_UNIT2 (identity/name only). They answer the same space-unit identity questions but differ in organization linkage and coverage.\"}, {\"id\": \"concept_person_directory\", \"desc\": \"Tables describing people of the institute keyed by MIT_ID: the primary employee directory (contact details, titles, HR department), the Drupal-sourced employee feed (employee group/type, appointment flags, HR org unit), the person master table (payroll rank, position title, active flag), the HR faculty roster (appointment type, terminal degree, emeritus status), the OPA current-person snapshot (HR job/appointment attributes, faculty flag, sabbatical), and the student directory (students with department attribution and student year). They jointly answer questions about who a person is, their contact details, job/appointment attributes, and whether they are employee, faculty, or student; responsible faculty in subject offering tables resolve to these tables via RESPONSIBLE_FACULTY_MIT_ID = MIT_ID.\"}, {\"id\": \"concept_time_dimension\", \"desc\": \"Time dimension tables of the warehouse at three granularities: TIME_DAY (one row per calendar date, with fiscal/calendar year and period, academic year, financial aid year, day of week, and the academic term code/description of the day), TIME_MONTH (one row per fiscal period in YYYYMM format, covering fiscal years 1996-2035, with fiscal quarter, calendar month, academic term, and financial aid year mappings), and TIME_QUARTER (one row per fiscal quarter, covering fiscal years 2000-2035, with quarter dates, payroll certification deadlines, and quarter status flags). They jointly answer questions about when fiscal periods/quarters/days run, which fiscal/calendar/academic year a date or month belongs to, and how day-level records roll up to months and quarters. They link to each other via FISCAL_PERIOD (day-month), FY_QUARTER_CODE (month-quarter), and FISCAL_YEAR (month-quarter association within the same fiscal year, fanning out months across all quarters of the year), and to the academic term tables via TIME_DAY.ACADEMIC_TERM_CODE or TIME_MONTH.ACADEMIC_TERM = TERM_CODE.\"}, {\"id\": \"concept_iap_activities\", \"desc\": \"Tables describing Independent Activities Period (IAP) activities offered in January terms: activity details (title, enrollment type, max enrollment, fee, cancellation flags), sessions (location, date, times), sponsors (name, type), categories, and persons. They jointly answer questions about IAP activity counts, enrollment capacity, fees, session scheduling, and sponsorship.\"}, {\"id\": \"concept_building_inventory\", \"desc\": \"Tables recording the physical building inventory and its attributes (number/name, type, ownership, site, campus sector, access level, gross/assignable/non-assignable areas, number of rooms, key dates): the current FCLT_* family snapshot, its fiscal-period history (in two date-format variants), the FAC_* family snapshot, and the lightweight space-domain building lookup. They jointly answer questions about building characteristics, areas, and room counts, but differ in time coverage, table family, attribute richness, and area units.\"}, {\"id\": \"concept_room_space_inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\"}, {\"id\": \"concept_floor_inventory\", \"desc\": \"Tables recording the floor level of buildings: the current FCLT_* family floor inventory with floor areas, the FAC_* family floor snapshot with the same structure, the fiscal-period historical floor table, and the lightweight space-domain floor lookup. They jointly answer questions about floor numbers and per-floor assignable/non-assignable areas, but differ in time coverage, table family, and attribute richness.\"}, {\"id\": \"concept_moira_mailing_lists\", \"desc\": \"Tables of the Moira mailing-list/group domain: the list master (one row per list with name, description, active flag, and type flags such as mailing list, group, NFS group, public, hidden), the membership detail (one row per list member with member login, full name, MIT ID, and last update date), and the owner lookup (one row per owner entity with owner name and owner type LIST/USER/KERBEROS). They jointly answer questions about which lists exist and their properties, who belongs to a list, and who owns a list; MOIRA_LIST is the parent of MOIRA_LIST_DETAIL via MOIRA_LIST_KEY, and MOIRA_LIST_OWNER is referenced by MOIRA_LIST_DETAIL via MOIRA_LIST_OWNER_KEY.\"}, {\"id\": \"concept_building_address\", \"desc\": \"Tables recording the postal/street addresses of buildings: the current FCLT_* family address table (multiple purpose-typed address rows per building), its fiscal-period historical counterpart, the FAC_* family address snapshot, and the single-text address fields of the space-domain BUILDINGS lookup. They jointly answer questions about where a building is located (street number/name, city, state, postal code), but differ in time coverage, address decomposition, and table family.\"}], \"column_concept\": [{\"id\": \"column_concept_total_units\", \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\"}, {\"id\": \"column_concept_hass_attribute\", \"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code and description columns. The code columns appear in the three course catalog feeds and in the CIS_HASS_ATTRIBUTE lookup; description columns exist in three variants: the catalog-embedded HASS_ATTRIBUTE_DESC, the lookup's DESCRIPTION_ON_FORM (registration-form wording), and DESCRIPTION_IN_BULLETIN (short bulletin wording). Selecting the right description variant depends on the wording requested by the question.\"}, {\"id\": \"column_concept_department_name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\"}, {\"id\": \"column_concept_master_subject_id\", \"desc\": \"Master subject identifier columns (MASTER_SUBJECT_ID and its sortable variant MASTER_SUBJECT_ID_SORT) replicated across the registrar offering tables, the subject summary, the textbook program, the library reserve program, and the CIS course catalog. For clustered subjects (e.g. joint or cross-listed offerings), the master subject identifier points to the leading subject of the cluster, so joining on it matches offerings that share the same master subject even when their own SUBJECT_ID differs. SUBJECT_ID/SUBJECT_ID_SORT identify the subject itself, while MASTER_SUBJECT_ID/MASTER_SUBJECT_ID_SORT identify the cluster's master; the _SORT columns are the sortable forms of the same values used for cross-table joins.\"}, {\"id\": \"column_concept_dlc_key\", \"desc\": \"Department/Lab/Center key columns (values like 'D_AEROASTRO', 'D_IDSS', 'D_BIOLOGY') identifying a DLC across the facilities, HR, space, and academic-department domains. They are the universal cross-domain join key linking facilities organizations and space units to HR organization units, the master department hierarchy, and academic departments. Naming and completeness vary: DLC_KEY in most tables, D_CODE in MASTER_DEPT_DCODE_PARENT, DLC_CODE in the master hierarchy tables; some columns carry composite values ('D_DSL:HQ') or nulls.\"}, {\"id\": \"column_concept_enrollment_measures\", \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\"}, {\"id\": \"column_concept_subject_id\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\"}, {\"id\": \"column_concept_term_code\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\"}, {\"id\": \"column_concept_material_status_key\", \"desc\": \"Material status key columns of the textbook program (TIP) and library reserve program. Both are coded status references decoded by their own lookup tables (key value equals code value), with independent value domains: TIP statuses ('RQ' Required, 'EO' Electronic options, 'RC' Recommended, 'PC' Val-u option, 'BR' Bookstore recommends, 'CL' Go to class first, 'NM' Course has no materials, 'U' Unknown, plus NULL-description keys) vs library reserve statuses ('U' Unknown, 'R' null description, 'N' Non-Required Course Material, 'O' Reserve only, 'X' No Required Textbook, 'Y' Required Course Material).\"}, {\"id\": \"column_concept_access_level\", \"desc\": \"Access level columns recorded at three granularity levels of the facilities domain plus the space-planning room feed: building-level ACCESS_LEVEL_CODE/ACCESS_LEVEL_NAME (current and per-fiscal-period history), floor-level ACCESS_LEVEL, and room-level ACCESS_LEVEL (FCLT_ROOMS, FAC_ROOMS, ZPM_ROOMS_LOAD). They share a numeric value domain (observed 0-3) but describe the access restriction of different physical objects or come from different feeds, so filters and joins must target the granularity and table family the question refers to.\"}, {\"id\": \"column_concept_year_columns\", \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\"}, {\"id\": \"column_concept_building_type_site\", \"desc\": \"Building classification columns replicated across the current and historical building tables of both table families: BUILDING_TYPE ('ACADEMIC', 'SERVICE', 'RESIDENT') and SITE ('MIT', 'BATES', 'LINC', 'BOS', etc.). They carry the same value domain but differ in time semantics: the building-table columns are the current classification, while the history-table columns are the classification recorded at each fiscal period, so filtering by one versus the other can select different building sets.\"}, {\"id\": \"column_concept_assignable_area\", \"desc\": \"Assignable-area measure columns at different granularity levels and time semantics: building-level current and per-fiscal-period assignable area, floor-level assignable area, and the space-domain assignable square footage. All FCLT_*/FAC_* columns are in square meters; BUILDINGS.BLDG_ASSIGNABLE_SQUARE_FOOTAGE is in square feet. Choosing the right column determines whether the measure is a building total, a floor total, a historical value, or a space-assignment figure.\"}, {\"id\": \"column_concept_space_unit_key\", \"desc\": \"Space unit key columns identifying the organizational space-assignment unit across the space dimension and fact tables. SPACE_UNIT_KEY is the join key linking SPACE_DETAIL room rows to space unit identity (name/code) and, through SPACE_UNIT, to the owning facilities organization.\"}, {\"id\": \"column_concept_office_location\", \"desc\": \"OFFICE_LOCATION columns recording where a person's office/desk is, replicated across the person-directory tables (SE_PERSON, MIT_STUDENT_DIRECTORY, EMPLOYEE_DIRECTORY, DRUPAL_EMPLOYEE_DIRECTORY). All hold a building or building-room text identifier in the same value domain as FCLT_ROOMS.BUILDING_ROOM, but they describe different populations (employee/person master vs student vs primary employee directory vs Drupal employee feed) and differ sharply in non-null coverage and in how many values are building-room ('BLDG-ROOM') versus building-only ('BLDG'). Choosing the right column determines whose office is reported and whether room-level joins to FCLT_ROOMS succeed.\"}, {\"id\": \"column_concept_facility_organization_key\", \"desc\": \"Facility organization key columns attributing space units and rooms to organizations in the hierarchical organization tree. Two naming conventions exist across table families (FCLT_ORGANIZATION_KEY in FCLT_*/SPACE_* tables vs ORGANIZATION_KEY in FAC_* tables) with the same value domain.\"}, {\"id\": \"column_concept_building_room\", \"desc\": \"Combined building-room identifier columns (e.g. '1-080') appearing in both the space assignment fact table and the facilities room inventory. They identify the same physical room concept but come from different business processes with different coverage and companion measures.\"}, {\"id\": \"column_concept_num_of_rooms\", \"desc\": \"NUM_OF_ROOMS columns recording how many rooms a building contains, replicated across the current and historical building tables of both families. The building-table columns hold the current room count (one value per building); the history-table columns hold the room count at each fiscal period, used for room-count statistics (average, range, variance, minimum) across a building's history records.\"}, {\"id\": \"column_concept_fiscal_period\", \"desc\": \"Fiscal period code columns in YYYYMM format (e.g. '199602' = FY1996 period 2, '201505') appearing in two distinct roles: as the primary key of the month-grain time dimension (TIME_MONTH.FISCAL_PERIOD, also mirrored in TIME_DAY.FISCAL_PERIOD for day-to-month linkage), and as the snapshot-period stamp of the facilities historical tables (FCLT_BUILDING_HIST, FCLT_BUILDING_HIST_1, FCLT_BUILDING_ADDRESS_HIST, FCLT_FLOOR_HIST, FCLT_ROOMS_HIST, FCLT_MAJOR_USE_HIST). Both roles share the same YYYYMM value domain, but the time dimension uses it for calendar grouping while the history tables use it to mark when a facilities snapshot was taken.\"}]}}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_057c4a3d52f347688137551b",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 97, \"items_by_type\": {\"table\": [{\"id\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\"}, {\"id\": \"ACADEMIC_TERMS_ALL\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\"}, {\"id\": \"ACADEMIC_TERM_PARAMETER\", \"desc\": \"Term parameter reference table holding exactly three rows that identify the SIS current term, previous term, and upcoming term, each with its term code, description, start/end dates and the last day before the next term. Used to resolve relative term references ('C', 'P', 'F') to concrete term codes.\"}, {\"id\": \"TIME_MONTH\", \"desc\": \"Month-level (fiscal period) time dimension table: one row per fiscal period in YYYYMM format, mapping each month to its fiscal year/quarter, calendar year/period/month, academic year and academic term, and financial aid year, with period start/end dates and current/previous/closing period flags. Covers fiscal years 1996-2035 (640 periods). Joins to TIME_DAY via FISCAL_PERIOD for day-level detail, to TIME_QUARTER via FY_QUARTER_CODE for quarter attributes, and to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL via ACADEMIC_TERM = TERM_CODE for term attributes; used for fiscal-period grouping and month-level calendar statistics.\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\"}, {\"id\": \"TIME_DAY\", \"desc\": \"Day-level time dimension table mapping each calendar date to fiscal year/period, calendar year/period, academic year, financial aid year, day of week, and the academic term code/description the day belongs to. Used to attach calendar attributes to terms and activities.\"}, {\"id\": \"CIS_COURSE_CATALOG\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\"}, {\"id\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\"}, {\"id\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\"}, {\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\"}, {\"id\": \"IAP_SUBJECT_DETAIL\", \"desc\": \"Independent Activities Period (IAP) subject detail table: one row per IAP activity offered in a January term, with activity title/description, enrollment type, maximum enrollment, fee, prerequisites, preregistration deadline, cancellation and multiple-session flags, and foreign keys to category, sponsor, session, and person tables.\"}, {\"id\": \"SIS_TERM_ADDRESS_CATEGORY\", \"desc\": \"8 columns in total\"}, {\"id\": \"SUBJECT_OFFERED\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\"}, {\"id\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\"}, {\"id\": \"TIP_DETAIL\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\"}, {\"id\": \"LIBRARY_SUBJECT_OFFERED\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\"}, {\"id\": \"MIT_HOLIDAY_CLOSING_CALENDAR\", \"desc\": \"4 columns in total\"}, {\"id\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\"}, {\"id\": \"IAP_SUBJECT_CATEGORY\", \"desc\": \"IAP subject category lookup table with category name and description. Referenced by IAP_SUBJECT_DETAIL via IAP_SUBJECT_CATEGORY_KEY.\"}, {\"id\": \"SUBJECT_ATTRIBUTE\", \"desc\": \"Subject attribute lookup table decoding attribute codes attached to subjects: academic attributes (type 'A') such as calculus/science prerequisites and HASS-D/HASS category codes, and non-academic program flags (type 'N') such as ROTC, ESG, Concourse, co-op, and listener rules. Provides short, full, and reporting descriptions per code. Overlaps with CIS_HASS_ATTRIBUTE on HASS-family codes (HD1-HD5, HDL, HE, HA, HH, HS) but differs in scope: SUBJECT_ATTRIBUTE covers all subject attribute types with one description variant per code, while CIS_HASS_ATTRIBUTE covers only HASS attribute codes with separate registration-form and bulletin descriptions plus attribute-group (H/G) classification. Catalog subject records' GIR_ATTRIBUTE codes all resolve against SUBJECT_ATTRIBUTE_CODE.\"}, {\"id\": \"DRUPAL_COURSE_CATALOG\", \"desc\": \"Drupal-sourced course catalog table: an alternative catalog feed with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags, section flags, meeting time/place), plus subject-offering reference columns (SO_SUBJECT_ID, SO_TERM_CODE, SO_TERM_DESCRIPTION, SO_CLUSTER_TYPE) linking catalog records to registrar subject offerings.\"}, {\"id\": \"SIS_SUBJECT_CODE\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\"}, {\"id\": \"STUDENT_DEPARTMENT\", \"desc\": \"Student-facing department lookup table with department code, name, full name, and school attribution (code and name). Similar in content to SIS_DEPARTMENT but oriented to student information systems reporting; joins to offering tables via DEPARTMENT_CODE.\"}, {\"id\": \"CIP_WITH_VERSION\", \"desc\": \"Versioned Classification of Instructional Programs (CIP) lookup table: one row per CIP program code per revision version year (1990/2000/2010/2020), preserving the historical classification of each program across CIP revisions. Carries the same program/category/four-digit code and title attributes as CIP plus a surrogate key, but no NOTE column and fewer distinct program codes than CIP. Joins to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE (matching more course rows than CIP because a program code can appear under several versions); use CIP when one row per program code is required.\"}, {\"id\": \"SUBJECT_IAP_SCHEDULE\", \"desc\": \"10 columns in total\"}, {\"id\": \"CIS_HASS_ATTRIBUTE\", \"desc\": \"CIS lookup table decoding HASS (Humanities, Arts, and Social Sciences) attribute codes used in course catalog subject records. Each code (e.g. 'HA', 'HH', 'HS', 'HE', 'HD1'-'HD5', 'HDL', and combined codes like 'HA,HH') maps to two description variants: the description shown on the registration form and the shorter description printed in the bulletin, plus the CIS attribute group ('H' = HASS_ATTRIBUTE for students entering Fall 2010 or later, 'G' = GIR_ATTRIBUTE for students entering prior to Fall 2010) with a group note, and icon display attributes. Catalog tables (COURSE_CATALOG_SUBJECT_OFFERED, CIS_COURSE_CATALOG, DRUPAL_COURSE_CATALOG) join to this lookup via HASS_ATTRIBUTE. Note: a code can appear once per attribute group (e.g. 'HE' exists in both group H and group G), so joins on HASS_ATTRIBUTE alone may produce multiple matching rows.\"}, {\"id\": \"IAP_SUBJECT_SESSION\", \"desc\": \"IAP subject session table: session-level details of IAP activities including session title, description, location, date, start/end times, and sequence. Referenced by IAP_SUBJECT_DETAIL via IAP_SUBJECT_SESSION_KEY.\"}, {\"id\": \"FCLT_MAJOR_USE\", \"desc\": \"Facilities major use classification lookup table (FCLT family): one row per major use code (e.g. CLASSRMS classrooms, OFFICES offices, LABS laboratories, RESIDENT residential) with its short code, description, and assignable-space flag. Joined from FCLT_ROOMS via FCLT_MAJOR_USE_KEY to decode a room's major use; current snapshot only, use FCLT_MAJOR_USE_HIST for fiscal-period historical variants.\"}, {\"id\": \"CIP\", \"desc\": \"Classification of Instructional Programs (CIP) lookup table: one row per six-digit CIP program code, classifying instructional programs into a two-digit category and a four-digit series, with program/category/four-digit titles, a change note, the CIP revision version year (1990/2000/2010/2020), and the warehouse load date. Joins to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE to attribute courses to CIP programs, categories, and schools/departments; CIP_WITH_VERSION is the multi-version variant keeping every revision of each program code.\"}, {\"id\": \"FRC_FISCAL_PERIODS\", \"desc\": \"3 columns in total\"}], \"metric\": [{\"id\": \"dw_3417\", \"desc\": \"For each academic term where the term status indicator is 'P', show the term code, the term parameter, the term description, the academic year, the term start date, and the average academic year in a window of 2 preceding and 2 following rows grouped by the term indicator and ordered by the term start date. Additionally, for the academic year of each such term, give the academic year description, the average total units, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in regular terms, with the results ordered by term code and by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_5095\", \"desc\": \"For each previous academic term where the term start date matches the minimum academic term start date for a subject category and academic year with more than 10 maximum enrollment, show the term code, term description, term start date, calendar date, day of week, the average calendar year within each calendar year group ordered by term start date, the subject category key, academic year, number of unique subjects, minimum academic term start date, the normalized subjects per year rounded (number of unique subjects divided by the average calendar year), and for each such term, also list the number of unique subject IDs offered in that term and the earliest preregistration deadline among those subjects.\"}, {\"id\": \"dw_3966\", \"desc\": \"For each academic year where the running sum of academic years within each financial aid year group for previous terms is greater than the average academic year across all previous terms, and for each subject in the term \\\"2010FA\\\" that is a regular term, show the previous term code, previous term description, previous academic year, the running sum of academic years for previous terms, the financial aid year, the subject ID, the subject's term description, the material status key, the subject's academic year, and the rank of the subject within its academic year group ordered by subject ID. The results are ordered by financial aid year, previous academic year, and subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_4325\", \"desc\": \"For each academic term that is not cancelled, has at least one IAP subject activity with a non-null maximum enrollment, and where the term status is 'Previous', provide the term description, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment values for IAP subject activities in that term, the academic year description, the term code, term start date, calendar date, day of week, the average calendar year within each calendar year group ordered by term start date, the academic year, and the last day of final exam, ordered by the range of maximum enrollment in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_2597\", \"desc\": \"For each academic year, what is the description of the academic year, the department name, the average total units for all subjects offered by that department in terms that match that academic year and have a term status indicator of 'P', and the deviation of each department's average total units from the overall average total units for that academic year? Do not return any rounded answers.\"}, {\"id\": \"dw_3973\", \"desc\": \"List the term code, subject ID, minimum record count from TIP_DETAIL, total new shelf price from TIP_MATERIAL, academic year, number of enrolled students, and deviation from the average number of enrolled students for that academic year, for each term and subject where the material has a non-null author and a material info source of 'ISBN', and considering only terms that are not the current term. Do not return any rounded answers.\"}, {\"id\": \"dw_4558\", \"desc\": \"For tip details where the material status key is 'RQ' and for IAP subject activities that are not cancelled and have a maximum enrollment greater than 10, show the tip subject offered key, material key, subject ID, term description, academic year, the average record count in a window of 2 preceding and 2 following rows grouped by academic year (as tip_window_avg_record_count), the activity title, enrollment type, maximum enrollment, academic term description from the time day table, term start date from the academic terms table, the minimum maximum enrollment value over each term code group (as iap_min_max_enrollment), and the academic year description from the academic terms table, ordered by academic year and IAP term code. Do not return any rounded answers.\"}, {\"id\": \"dw_3131\", \"desc\": \"For each fiscal period, what is the fiscal period description, the variance of the calendar year for all days in that period where the academic year is not null, and whether the variance is 'HIGH_VARIANCE' (at least 20% greater than the average variance across all periods), 'LOW_VARIANCE' (at least 20% less than the average), or 'AVERAGE'? Do not return any rounded answers.\"}, {\"id\": \"dw_4978\", \"desc\": \"For each library reserve material detail with material status key 'U', show the reserve catalog key, subject offered key, term code, academic year, term description, tip material key, tip material status key, and the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, along with the corresponding textbook material in the TIP_DETAIL table with material status key 'RQ' that matches on tip material key and academic year, showing the textbook subject offered key, textbook material key, subject ID, textbook academic year, textbook term description, and the row number within each textbook academic year group ordered by term code. Additionally, for each matching textbook material, include the term start date and term end date from the ACADEMIC_TERMS_ALL table. Present the results in the order of reserve material academic year descending and textbook row number. Do not return any rounded answers.\"}, {\"id\": \"dw_4826\", \"desc\": \"For each library reserve material with material status key 'U', list the subject ID, library course instructor key, term description, academic year, term start date, the minimum academic year in a window of 3 preceding and 1 following row ordered by library reserve catalog key, the library subject offered key, the tip material key, the tip material status key, the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, and for each, include the academic year description and the last day of final exam from the ACADEMIC_TERMS_ALL table, and calculate the normalized year to average record count ratio (academic year divided by average record count in the window), ordered by the normalized year to average record count ratio descending.\"}, {\"id\": \"dw_2574\", \"desc\": \"For each subject category and enrollment type where the maximum enrollment is greater than 10, provide the number of activities, the earliest start date of the corresponding academic term, and the latest end date of the corresponding academic term. Do not return any rounded answers.\"}, {\"id\": \"dw_41\", \"desc\": \"For each academic year, provide the academic year description and calculate the average and variance of the total units for subjects offered in terms that are not the current term, have a term status indicator of 'P', are offered by the Mathematics department, and are full term subjects. Do not return any rounded answers.\"}, {\"id\": \"dw_3357\", \"desc\": \"For each library reserve material detail with material status key 'U', show the reserve catalog key, subject offered key, term code, academic year, term description, tip material key, tip material status key, and the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, along with the corresponding textbook material in the TIP_DETAIL table with material status key 'RQ' that matches on tip material key and academic year, showing the textbook subject offered key, textbook material key, subject ID, textbook academic year, textbook term description, and the row number within each textbook academic year group ordered by term code. Present the results in the order of reserve material academic year descending and textbook row number. Do not return any rounded answers.\"}, {\"id\": \"dw_3612\", \"desc\": \"For IAP subject activities with a maximum enrollment of 30 and tip details where the material status key is 'RQ', show the activity title, enrollment type, prerequisites, term code, IAP term description, term start date, term end date, the minimum term start date over each term code group, the tip subject offered key, tip material key, subject ID, tip term description, academic year, and the average record count in a window of 2 preceding and 2 following rows grouped by academic year, ordered by term code and academic year. Do not return any rounded answers.\"}, {\"id\": \"dw_359\", \"desc\": \"For each academic year, what is the total number of lecture units for all subjects offered in regular terms by the Mathematics department (Course 18), where at least 60% of those subjects are undergraduate-level (HGN_DESC = 'Undergraduate'), considering only those academic years where the total lecture units are more than one standard deviation (using STDDEV only and never STDDEV_POP) above the mean total lecture units across all academic years? Do not return any rounded answers.\"}, {\"id\": \"dw_4701\", \"desc\": \"For each academic year, what is the academic year, academic year description, the geometric mean of the number of library reserve material details per subject offered (considering only records where the material status is 'U' and the academic term is a regular term), the average total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the average number of design units for subjects that are offered in the fall term and have a material status of 'U' in the library reserve? List the results ordered by the geometric mean of materials per subject in descending order, then by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_2957\", \"desc\": \"For each academic year, provide the academic year description, the geometric mean of the degree year from all academic terms where the degree year is greater than 1900, and classify the academic year as 'RECENT' if the geometric mean is at least 2010, 'OLD' if it is less than 1980, or 'AVERAGE' otherwise. Do not return any rounded answers.\"}, {\"id\": \"dw_3248\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units that are also offered in the library by the Mathematics department during regular terms, show the subject code, subject number, subject title, department name, term description, the rank of each subject within its department ordered by subject code, the number of enrolled students, offering department name, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_3952\", \"desc\": \"For IAP subject activities with a maximum enrollment of at least 20, show the activity title, the dense rank of each activity considering the current and 2 preceding rows ordered by the academic year of the associated term, the IAP term description, and for each such activity, show the previous academic term code, previous term description, previous academic year, the running sum of academic years within each financial aid year group for previous terms, and the previous academic year description, for all previous academic terms that share the same term code as the IAP activity. Order the results by activity title and previous academic year. Do not return any rounded answers.\"}, {\"id\": \"dw_2850\", \"desc\": \"For each term and department, what is the term, department, and the variance of the reserve catalog keys for courses in that department and term where the material status is 'U'? Include subtotals for each term (the corresponding term field is 'SUBTOTAL') and a grand total across all terms (the corresponding term field is 'TOTAL'). Do not repeat the term if it is the same as the previous row. Sort the table by term and department. Do not return any rounded answers.\"}, {\"id\": \"dw_4584\", \"desc\": \"For Mathematics department courses with at least 5 enrolled students, show the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, and the average calendar year within each calendar year group ordered by term start date, but only for academic terms where the term status is 'Previous', and only include results where the number of enrolled students is greater than the average number of enrolled students for that academic year. Do not return any rounded answers.\"}, {\"id\": \"dw_1973\", \"desc\": \"For all subjects offered in the academic year 2022 by the Mathematics department that have at least one associated TIP material and are also offered this year as letter graded, show the subject ID, subject title, term code, term description, the rank of each subject within its term (ordered by subject ID), subject code, subject number, department name, academic year, the maximum total units for each subject considering the current row and the next 2 rows ordered by subject code, and the start and end dates of the term. Do not return any rounded answers.\"}, {\"id\": \"dw_2858\", \"desc\": \"For IAP subject activities with a maximum enrollment of 30, show the activity title, enrollment type, prerequisites, term code, term description, term start date, term end date, the minimum term start date over each term code group, and the total number of such activities per term code. Do not return any rounded answers.\"}, {\"id\": \"dw_2735\", \"desc\": \"For each fiscal year, what is the minimum calendar month and the sum of calendar years from TIME_MONTH for months that have at least one corresponding day in TIME_DAY with the academic term code '2020FA'? Show only fiscal years where such months exist. Do not return any rounded answers.\"}, {\"id\": \"dw_1301\", \"desc\": \"For each academic year, where the maximum number of total units for any Mathematics (Course 18) subject offered in that year is greater than 9 and there are more than 5 Mathematics subjects offered in the fall term, what are the academic year, the maximum total units, the corresponding term description, the subject title, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in library subjects offered during terms in that year, and the average number of equivalent subjects for those library subjects? List the results in order of academic year. Do not return any rounded answers.\"}, {\"id\": \"dw_4724\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\"}, {\"id\": \"dw_3664\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', display each subject title, the offering department name, the count of reserved materials, the academic year, the department name, the average of the total units, and the variance of the total units for subjects offered in regular terms, with the columns shown in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_3047\", \"desc\": \"For each IAP subject activity with a maximum enrollment greater than 10, show the activity title, enrollment type, term description, subject ID, and the sum of maximum enrollment within each academic year, but only include activities that are not cancelled and are part of multiple sessions. Order the results by activity title. Do not return any rounded answers.\"}, {\"id\": \"dw_4130\", \"desc\": \"For subjects offered in the academic year 2012 that also have a section ID of 0 and a cluster type of 'S', show the subject key, subject title, offer department name, academic year, term description, the total number of subjects offered by each department in that year, the row number within each offer department name group ordered by subject key, the department name from SUBJECT_SUMMARY, the term start date from ACADEMIC_TERMS, and the row number within a window of 2 preceding and 1 following rows ordered by the subject title from SUBJECT_OFFERED. List the results in order by offer department name and subject key. Do not return any rounded answers.\"}, {\"id\": \"dw_2790\", \"desc\": \"For IAP subject activities with a maximum enrollment of 12, show the activity title, enrollment type, term description, subject ID, and the earliest create date for each activity within each term description group. Do not return any rounded answers.\"}], \"concept\": [{\"id\": \"concept_academic_term_dimension\", \"desc\": \"Tables describing academic terms and their calendar/status attributes. They jointly answer questions about when terms run, which academic/financial-aid/degree year a term belongs to, and whether a term is current, previous, future, or regular. Coverage differs: the full historical term list, the status-tracked term subset, and the three-row relative term parameter reference.\"}, {\"id\": \"concept_time_dimension\", \"desc\": \"Time dimension tables of the warehouse at three granularities: TIME_DAY (one row per calendar date, with fiscal/calendar year and period, academic year, financial aid year, day of week, and the academic term code/description of the day), TIME_MONTH (one row per fiscal period in YYYYMM format, covering fiscal years 1996-2035, with fiscal quarter, calendar month, academic term, and financial aid year mappings), and TIME_QUARTER (one row per fiscal quarter, covering fiscal years 2000-2035, with quarter dates, payroll certification deadlines, and quarter status flags). They jointly answer questions about when fiscal periods/quarters/days run, which fiscal/calendar/academic year a date or month belongs to, and how day-level records roll up to months and quarters. They link to each other via FISCAL_PERIOD (day-month), FY_QUARTER_CODE (month-quarter), and FISCAL_YEAR (month-quarter association within the same fiscal year, fanning out months across all quarters of the year), and to the academic term tables via TIME_DAY.ACADEMIC_TERM_CODE or TIME_MONTH.ACADEMIC_TERM = TERM_CODE.\"}, {\"id\": \"concept_subject_offering_facts\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\"}, {\"id\": \"concept_course_material_programs\", \"desc\": \"Tables covering course material provisioning: the Textbook Information Program (TIP) tracking textbook adoption status per subject offering, and library reserve processing tracking catalog items placed on reserve for subjects. They jointly answer questions about which subjects have course materials/textbooks, material status (TIP statuses such as 'RQ' Required, 'EO' Electronic options; library statuses such as 'U' Unknown, 'Y' Required Course Material), ISBNs, record counts, and reserve catalog item attributes. The two programs are linked by SUBJECT_ID + TERM_CODE.\"}, {\"id\": \"concept_iap_activities\", \"desc\": \"Tables describing Independent Activities Period (IAP) activities offered in January terms: activity details (title, enrollment type, max enrollment, fee, cancellation flags), sessions (location, date, times), sponsors (name, type), categories, and persons. They jointly answer questions about IAP activity counts, enrollment capacity, fees, session scheduling, and sponsorship.\"}, {\"id\": \"concept_department_dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\"}, {\"id\": \"concept_cip_program_classification\", \"desc\": \"Lookup tables of the Classification of Instructional Programs (CIP) used to classify courses/instructional programs into two-digit categories, four-digit series, and six-digit program codes, with revision version years (1990/2000/2010/2020). CIP holds the current single-version classification (one row per program code, with a change NOTE), while CIP_WITH_VERSION preserves every revision of each program code across versions. Both join to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE to attribute courses to CIP programs and categories.\"}, {\"id\": \"concept_course_catalog_sources\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\"}, {\"id\": \"concept_room_major_use_classification\", \"desc\": \"Lookup tables classifying rooms by major use (classrooms, offices, laboratories, residential, circulation, etc.) with a short code, description, and assignable-space flag. They cover the current classification in the FCLT and FAC table families and the fiscal-period historical classification in the FCLT family, jointly answering questions about what a room is primarily used for and whether that use counts as assignable space.\"}, {\"id\": \"concept_person_directory\", \"desc\": \"Tables describing people of the institute keyed by MIT_ID: the primary employee directory (contact details, titles, HR department), the Drupal-sourced employee feed (employee group/type, appointment flags, HR org unit), the person master table (payroll rank, position title, active flag), the HR faculty roster (appointment type, terminal degree, emeritus status), the OPA current-person snapshot (HR job/appointment attributes, faculty flag, sabbatical), and the student directory (students with department attribution and student year). They jointly answer questions about who a person is, their contact details, job/appointment attributes, and whether they are employee, faculty, or student; responsible faculty in subject offering tables resolve to these tables via RESPONSIBLE_FACULTY_MIT_ID = MIT_ID.\"}, {\"id\": \"concept_building_inventory\", \"desc\": \"Tables recording the physical building inventory and its attributes (number/name, type, ownership, site, campus sector, access level, gross/assignable/non-assignable areas, number of rooms, key dates): the current FCLT_* family snapshot, its fiscal-period history (in two date-format variants), the FAC_* family snapshot, and the lightweight space-domain building lookup. They jointly answer questions about building characteristics, areas, and room counts, but differ in time coverage, table family, attribute richness, and area units.\"}, {\"id\": \"concept_room_space_inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\"}, {\"id\": \"concept_facility_organization_dimension\", \"desc\": \"Organization dimension tables describing the institute's hierarchical organization tree used for facilities/space attribution: FCLT_ORGANIZATION (keyed by FCLT_ORGANIZATION_KEY, with DLC_KEY/DLC_NAME) and FAC_ORGANIZATION (keyed by ORGANIZATION_KEY, with D_CODE). They answer the same questions about organization names, hierarchy levels, parent/major organizations, assignable flags, and HR cross-references, but belong to different table families and coverage.\"}, {\"id\": \"concept_floor_inventory\", \"desc\": \"Tables recording the floor level of buildings: the current FCLT_* family floor inventory with floor areas, the FAC_* family floor snapshot with the same structure, the fiscal-period historical floor table, and the lightweight space-domain floor lookup. They jointly answer questions about floor numbers and per-floor assignable/non-assignable areas, but differ in time coverage, table family, and attribute richness.\"}, {\"id\": \"concept_dept_hr_org_hierarchy\", \"desc\": \"Tables describing the institute's department/lab/center (DLC) and HR organization hierarchies: the HR organization unit dimension in two feed variants (HR_ORG_UNIT, HR_ORG_UNIT_NEW), the master department standard hierarchy path (MASTER_DEPT_HIERARCHY), its DLC-to-administrative-object link table (MASTER_DEPT_HIERARCHY_LINKS), and the direct-parent department lookup (MASTER_DEPT_DCODE_PARENT). They jointly answer questions about which HR department/area a DLC or organization belongs to, the hierarchy path or parent of a department, and HR department names/codes/levels, and are joined to FCLT_ORGANIZATION via DLC_KEY for facilities/space attribution. They differ in hierarchy representation (full path vs direct parent vs HR unit attributes), unit coverage, and companion columns.\"}, {\"id\": \"concept_space_unit_dimension\", \"desc\": \"Space unit lookup tables identifying the organizational units that receive space allocation: SPACE_UNIT (with FCLT_ORGANIZATION_KEY organization attribution) and SPACE_UNIT2 (identity/name only). They answer the same space-unit identity questions but differ in organization linkage and coverage.\"}, {\"id\": \"concept_building_address\", \"desc\": \"Tables recording the postal/street addresses of buildings: the current FCLT_* family address table (multiple purpose-typed address rows per building), its fiscal-period historical counterpart, the FAC_* family address snapshot, and the single-text address fields of the space-domain BUILDINGS lookup. They jointly answer questions about where a building is located (street number/name, city, state, postal code), but differ in time coverage, address decomposition, and table family.\"}, {\"id\": \"concept_moira_mailing_lists\", \"desc\": \"Tables of the Moira mailing-list/group domain: the list master (one row per list with name, description, active flag, and type flags such as mailing list, group, NFS group, public, hidden), the membership detail (one row per list member with member login, full name, MIT ID, and last update date), and the owner lookup (one row per owner entity with owner name and owner type LIST/USER/KERBEROS). They jointly answer questions about which lists exist and their properties, who belongs to a list, and who owns a list; MOIRA_LIST is the parent of MOIRA_LIST_DETAIL via MOIRA_LIST_KEY, and MOIRA_LIST_OWNER is referenced by MOIRA_LIST_DETAIL via MOIRA_LIST_OWNER_KEY.\"}], \"column_concept\": [{\"id\": \"column_concept_term_code\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\"}, {\"id\": \"column_concept_year_columns\", \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\"}, {\"id\": \"column_concept_subject_id\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\"}, {\"id\": \"column_concept_master_subject_id\", \"desc\": \"Master subject identifier columns (MASTER_SUBJECT_ID and its sortable variant MASTER_SUBJECT_ID_SORT) replicated across the registrar offering tables, the subject summary, the textbook program, the library reserve program, and the CIS course catalog. For clustered subjects (e.g. joint or cross-listed offerings), the master subject identifier points to the leading subject of the cluster, so joining on it matches offerings that share the same master subject even when their own SUBJECT_ID differs. SUBJECT_ID/SUBJECT_ID_SORT identify the subject itself, while MASTER_SUBJECT_ID/MASTER_SUBJECT_ID_SORT identify the cluster's master; the _SORT columns are the sortable forms of the same values used for cross-table joins.\"}, {\"id\": \"column_concept_material_status_key\", \"desc\": \"Material status key columns of the textbook program (TIP) and library reserve program. Both are coded status references decoded by their own lookup tables (key value equals code value), with independent value domains: TIP statuses ('RQ' Required, 'EO' Electronic options, 'RC' Recommended, 'PC' Val-u option, 'BR' Bookstore recommends, 'CL' Go to class first, 'NM' Course has no materials, 'U' Unknown, plus NULL-description keys) vs library reserve statuses ('U' Unknown, 'R' null description, 'N' Non-Required Course Material, 'O' Reserve only, 'X' No Required Textbook, 'Y' Required Course Material).\"}, {\"id\": \"column_concept_fiscal_period\", \"desc\": \"Fiscal period code columns in YYYYMM format (e.g. '199602' = FY1996 period 2, '201505') appearing in two distinct roles: as the primary key of the month-grain time dimension (TIME_MONTH.FISCAL_PERIOD, also mirrored in TIME_DAY.FISCAL_PERIOD for day-to-month linkage), and as the snapshot-period stamp of the facilities historical tables (FCLT_BUILDING_HIST, FCLT_BUILDING_HIST_1, FCLT_BUILDING_ADDRESS_HIST, FCLT_FLOOR_HIST, FCLT_ROOMS_HIST, FCLT_MAJOR_USE_HIST). Both roles share the same YYYYMM value domain, but the time dimension uses it for calendar grouping while the history tables use it to mark when a facilities snapshot was taken.\"}, {\"id\": \"column_concept_total_units\", \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\"}, {\"id\": \"column_concept_enrollment_measures\", \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\"}, {\"id\": \"column_concept_department_name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\"}, {\"id\": \"column_concept_building_type_site\", \"desc\": \"Building classification columns replicated across the current and historical building tables of both table families: BUILDING_TYPE ('ACADEMIC', 'SERVICE', 'RESIDENT') and SITE ('MIT', 'BATES', 'LINC', 'BOS', etc.). They carry the same value domain but differ in time semantics: the building-table columns are the current classification, while the history-table columns are the classification recorded at each fiscal period, so filtering by one versus the other can select different building sets.\"}, {\"id\": \"column_concept_hass_attribute\", \"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code and description columns. The code columns appear in the three course catalog feeds and in the CIS_HASS_ATTRIBUTE lookup; description columns exist in three variants: the catalog-embedded HASS_ATTRIBUTE_DESC, the lookup's DESCRIPTION_ON_FORM (registration-form wording), and DESCRIPTION_IN_BULLETIN (short bulletin wording). Selecting the right description variant depends on the wording requested by the question.\"}, {\"id\": \"column_concept_num_of_rooms\", \"desc\": \"NUM_OF_ROOMS columns recording how many rooms a building contains, replicated across the current and historical building tables of both families. The building-table columns hold the current room count (one value per building); the history-table columns hold the room count at each fiscal period, used for room-count statistics (average, range, variance, minimum) across a building's history records.\"}, {\"id\": \"column_concept_office_location\", \"desc\": \"OFFICE_LOCATION columns recording where a person's office/desk is, replicated across the person-directory tables (SE_PERSON, MIT_STUDENT_DIRECTORY, EMPLOYEE_DIRECTORY, DRUPAL_EMPLOYEE_DIRECTORY). All hold a building or building-room text identifier in the same value domain as FCLT_ROOMS.BUILDING_ROOM, but they describe different populations (employee/person master vs student vs primary employee directory vs Drupal employee feed) and differ sharply in non-null coverage and in how many values are building-room ('BLDG-ROOM') versus building-only ('BLDG'). Choosing the right column determines whose office is reported and whether room-level joins to FCLT_ROOMS succeed.\"}, {\"id\": \"column_concept_dlc_key\", \"desc\": \"Department/Lab/Center key columns (values like 'D_AEROASTRO', 'D_IDSS', 'D_BIOLOGY') identifying a DLC across the facilities, HR, space, and academic-department domains. They are the universal cross-domain join key linking facilities organizations and space units to HR organization units, the master department hierarchy, and academic departments. Naming and completeness vary: DLC_KEY in most tables, D_CODE in MASTER_DEPT_DCODE_PARENT, DLC_CODE in the master hierarchy tables; some columns carry composite values ('D_DSL:HQ') or nulls.\"}, {\"id\": \"column_concept_access_level\", \"desc\": \"Access level columns recorded at three granularity levels of the facilities domain plus the space-planning room feed: building-level ACCESS_LEVEL_CODE/ACCESS_LEVEL_NAME (current and per-fiscal-period history), floor-level ACCESS_LEVEL, and room-level ACCESS_LEVEL (FCLT_ROOMS, FAC_ROOMS, ZPM_ROOMS_LOAD). They share a numeric value domain (observed 0-3) but describe the access restriction of different physical objects or come from different feeds, so filters and joins must target the granularity and table family the question refers to.\"}, {\"id\": \"column_concept_building_room\", \"desc\": \"Combined building-room identifier columns (e.g. '1-080') appearing in both the space assignment fact table and the facilities room inventory. They identify the same physical room concept but come from different business processes with different coverage and companion measures.\"}, {\"id\": \"column_concept_assignable_area\", \"desc\": \"Assignable-area measure columns at different granularity levels and time semantics: building-level current and per-fiscal-period assignable area, floor-level assignable area, and the space-domain assignable square footage. All FCLT_*/FAC_* columns are in square meters; BUILDINGS.BLDG_ASSIGNABLE_SQUARE_FOOTAGE is in square feet. Choosing the right column determines whether the measure is a building total, a floor total, a historical value, or a space-assignment figure.\"}, {\"id\": \"column_concept_space_unit_key\", \"desc\": \"Space unit key columns identifying the organizational space-assignment unit across the space dimension and fact tables. SPACE_UNIT_KEY is the join key linking SPACE_DETAIL room rows to space unit identity (name/code) and, through SPACE_UNIT, to the owning facilities organization.\"}, {\"id\": \"column_concept_facility_organization_key\", \"desc\": \"Facility organization key columns attributing space units and rooms to organizations in the hierarchical organization tree. Two naming conventions exist across table families (FCLT_ORGANIZATION_KEY in FCLT_*/SPACE_* tables vs ORGANIZATION_KEY in FAC_* tables) with the same value domain.\"}]}}"
    },
    {
      "role": "assistant",
      "tool_calls": [
        {
          "id": "call_b6f42f3ee94042c19477f2fd",
          "type": "function",
          "function": {
            "name": "semantic_get",
            "arguments": "{\"entity_ids\": \n[\"dw_3163\", \"dw_2597\", \"dw_3417\", \"dw_1049\", \"SIS_COURSE_DESCRIPTION\", \"COURSE_CATALOG_SUBJECT_OFFERED\", \"SUBJECT_SUMMARY\", \"ACADEMIC_TERMS\", \"SIS_DEPARTMENT\"]\n\n}"
          }
        }
      ]
    },
    {
      "role": "tool",
      "tool_call_id": "call_b6f42f3ee94042c19477f2fd",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level where the course is degree granting and the total units are greater than 6, provide the number of unique courses, the minimum total units offered, and the number of courses where the design units are at least 3. Do not return any rounded answers.\", \"id\": \"dw_3163\", \"name\": \"Degree-Granting Course Level Counts with Min Total Units and Design-Unit Course Counts\", \"sql\": \"WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT scd.COURSE) AS course_count, MIN(ccc.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units, COUNT(DISTINCT CASE WHEN ccc.DESIGN_UNITS >= 3 THEN scd.COURSE END) AS courses_with_design_units_3_or_more FROM inner_cte ic JOIN SIS_COURSE_DESCRIPTION scd ON ic.DEPARTMENT_NAME = scd.DEPARTMENT_NAME AND ic.COURSE_LEVEL = scd.COURSE_LEVEL JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units;\"}, {\"category\": \"Subject Offering Analysis\", \"default_granularity\": \"one row per department per academic year\", \"desc\": \"For each academic year, what is the description of the academic year, the department name, the average total units for all subjects offered by that department in terms that match that academic year and have a term status indicator of 'P', and the deviation of each department's average total units from the overall average total units for that academic year? Do not return any rounded answers.\", \"id\": \"dw_2597\", \"name\": \"Department Average Total Units Deviation from Yearly Overall Average in Previous Terms\", \"sql\": \"WITH inner_cte AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS dept_avg_total_units FROM ACADEMIC_TERMS_ALL JOIN ACADEMIC_TERMS ON ACADEMIC_TERMS_ALL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.TERM_STATUS_INDICATOR = 'P' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.ACADEMIC_YEAR_DESC, inner_cte.DEPARTMENT_NAME, inner_cte.dept_avg_total_units, (inner_cte.dept_avg_total_units - overall.avg_total_units) AS deviation_from_overall_avg FROM inner_cte JOIN ( SELECT ACADEMIC_YEAR, AVG(dept_avg_total_units) AS avg_total_units FROM ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS dept_avg_total_units FROM ACADEMIC_TERMS_ALL JOIN ACADEMIC_TERMS ON ACADEMIC_TERMS_ALL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.TERM_STATUS_INDICATOR = 'P' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME ) dept_avgs GROUP BY ACADEMIC_YEAR ) overall ON inner_cte.ACADEMIC_YEAR = overall.ACADEMIC_YEAR ORDER BY inner_cte.ACADEMIC_YEAR, deviation_from_overall_avg DESC;\"}, {\"category\": \"Academic Term and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per previous-status term\", \"desc\": \"For each academic term where the term status indicator is 'P', show the term code, the term parameter, the term description, the academic year, the term start date, and the average academic year in a window of 2 preceding and 2 following rows grouped by the term indicator and ordered by the term start date. Additionally, for the academic year of each such term, give the academic year description, the average total units, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in regular terms, with the results ordered by term code and by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\", \"id\": \"dw_3417\", \"name\": \"Previous Terms Windowed Academic Year Average with Regular-Term Unit Stddev by Year\", \"sql\": \"WITH AcademicYearStats AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS avg_total_units, STDDEV(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS stddev_total_units FROM ACADEMIC_TERMS JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC ORDER BY stddev_total_units DESC ), PreviousTerms AS ( SELECT t0.TERM_CODE, t1.TERM_PARAMETER, t2.TERM_DESCRIPTION, t0.ACADEMIC_YEAR, t1.TERM_START_DATE, AVG(t0.ACADEMIC_YEAR) OVER ( PARTITION BY t1.TERM_INDICATOR ORDER BY t0.TERM_START_DATE ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN ACADEMIC_TERM_PARAMETER t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_INDICATOR = 'P' ) SELECT pts.TERM_CODE, pts.TERM_PARAMETER, pts.TERM_DESCRIPTION, pts.ACADEMIC_YEAR, pts.TERM_START_DATE, pts.window_column, ays.ACADEMIC_YEAR_DESC, ays.avg_total_units, ays.stddev_total_units FROM PreviousTerms pts JOIN AcademicYearStats ays ON pts.ACADEMIC_YEAR = ays.ACADEMIC_YEAR ORDER BY pts.TERM_CODE, ays.stddev_total_units DESC;\"}, {\"id\": \"dw_1049\", \"name\": \"Mathematics Total Units Stddev for Regular Non-Current Terms vs 2022 Degree-Granting Departments\", \"category\": \"Subject Offering Analysis\", \"desc\": \"For the Mathematics department, what is the department name, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for its subjects in regular terms that are not the current term, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department in the 2022 academic year (considering only departments that have more than five subjects offered in 2022, are degree-granting, and are not the Chemistry department)? Show the department name, the standard deviation (using STDDEV only and never STDDEV_POP) for regular non-current terms, and the standard deviation (using STDDEV only and never STDDEV_POP) for 2022. Do not return any rounded answers.\", \"sql\": \"WITH MathDeptStddev AS ( SELECT ss.DEPARTMENT_NAME, STDDEV(ss.TOTAL_UNITS) AS stddev_total_units FROM SUBJECT_SUMMARY ss JOIN ACADEMIC_TERMS at ON ss.TERM_CODE = at.TERM_CODE WHERE ss.DEPARTMENT_NAME = 'Mathematics' AND at.IS_REGULAR_TERM = 'Y' AND at.IS_CURRENT_TERM = 'N' GROUP BY ss.DEPARTMENT_NAME ), DeptStddev2022 AS ( SELECT scd.DEPARTMENT_NAME, STDDEV(ccso.TOTAL_UNITS) AS total_units_stddev FROM SIS_SUBJECT_CODE ssc JOIN SIS_COURSE_DESCRIPTION scd ON ssc.SUBJECT_CODE = scd.COURSE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON scd.COURSE = ccso.SUBJECT_CODE WHERE ccso.ACADEMIC_YEAR = 2022 AND scd.IS_DEGREE_GRANTING = 'Y' AND scd.DEPARTMENT_NAME <> 'Chemistry' GROUP BY scd.DEPARTMENT_NAME HAVING COUNT(*) > 5 ORDER BY total_units_stddev DESC ) SELECT mds.DEPARTMENT_NAME, mds.stddev_total_units AS math_stddev_total_units, dsd.total_units_stddev AS dept_stddev_2022 FROM MathDeptStddev mds LEFT JOIN DeptStddev2022 dsd ON mds.DEPARTMENT_NAME = dsd.DEPARTMENT_NAME;\", \"default_granularity\": \"one row per department\"}, {\"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"columns\": {\"SIS_COURSE_DESCRIPTION_KEY\": {\"desc\": \"Surrogate key of the course description record\"}, \"COURSE\": {\"desc\": \"Course/subject code, e.g. '18'; joins to SIS_SUBJECT_CODE.SUBJECT_CODE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"COURSE_DESCRIPTION\": {\"desc\": \"Short course description text; its character length is used in description-length statistics\"}, \"COURSE_DESCRIPTION_LONG\": {\"desc\": \"Long-form course description text\"}, \"DEPARTMENT\": {\"desc\": \"Department code offering the course; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name offering the course\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME\": {\"desc\": \"School name offering the course, e.g. 'Engineering'\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"FROM_TERM\": {\"desc\": \"First term the course description is effective from\"}, \"FROM_TERM_DESCRIPTION\": {\"desc\": \"Description of the from-term\"}, \"THRU_TERM\": {\"desc\": \"Last term the course description is effective through\"}, \"THRU_TERM_DESCRIPTION\": {\"desc\": \"Description of the thru-term\"}, \"COURSE_OPTION\": {\"desc\": \"Course option designation\"}, \"COURSE_LEVEL\": {\"desc\": \"Course level code, e.g. 'U' = undergraduate, 'G' = graduate\"}, \"CIP_PROGRAM_CODE\": {\"desc\": \"Six-digit CIP (Classification of Instructional Programs) program code of the course; joins to CIP.PROGRAM_CODE (current classification, one row per code) and CIP_WITH_VERSION.PROGRAM_CODE (all revision versions)\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the course counts toward a degree\"}, \"DEFAULT_ULTIMATE_DEGREE\": {\"desc\": \"Default ultimate degree awarded for the course\"}, \"GRADAUTE_LEVEL\": {\"desc\": \"Legacy misspelled graduate level column (kept for compatibility)\"}, \"GRADUATE_LEVEL\": {\"desc\": \"Graduate level designation of the course\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per course description\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}, {\"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"columns\": {\"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject summary record\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, COURSE_CATALOG_SUBJECT_OFFERED subject IDs\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SUBJECT_OR_CLUSTER\": {\"desc\": \"Indicator whether the row represents a subject or a cluster\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"ULT_MASTER_SUBJECT_ID\": {\"desc\": \"Ultimate master subject identifier in cluster hierarchies\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics'\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name, e.g. 'Engineering'\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREP_UNITS\": {\"desc\": \"Preparation credit units (named PREP_UNITS here vs PREPARATION_UNITS in other tables)\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the subject\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the cluster\"}, \"SUBJECT_GROUP_ID\": {\"desc\": \"Subject group identifier used for grouping related subjects\"}, \"SUBJECT_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Subject enrollment in the first week\"}, \"CLUSTER_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Cluster enrollment in the first week\"}, \"SUBJECT_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Subject enrollment in the fifth week\"}, \"CLUSTER_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Cluster enrollment in the fifth week\"}, \"SUBJECT_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the subject for credit\"}, \"SUBJECT_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the subject\"}, \"CLUSTER_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the cluster for credit\"}, \"CLUSTER_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the cluster\"}, \"SUBJECT_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the cluster\"}, \"SUBJECT_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS_ALL.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2025FA' (FA=Fall, SP=Spring, JA=January/IAP, SU=Summer)\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description, e.g. 'Fall Term 2024-2025'\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date; can match TIME_DAY.CALENDAR_DATE for calendar-based joins\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to, e.g. 2025\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"IS_REGULAR_TERM\": {\"desc\": \"'Y'/'N' flag indicating a regular term (Fall/Spring) versus non-regular terms (Summer, January/IAP); only present in ACADEMIC_TERMS, not in ACADEMIC_TERMS_ALL\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"TERM_STATUS\": {\"desc\": \"Term status text: 'Previous', 'Current', 'Future', or 'Unspecified'\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to; used in degree-year statistics\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"ADD_DATE\": {\"desc\": \"Last day to add a subject in the term; only present in ACADEMIC_TERMS\"}, \"DROP_DATE\": {\"desc\": \"Last day to drop a subject in the term; only present in ACADEMIC_TERMS\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period for the term\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period for the term\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}], \"not_found\": []}"
    },
