            "arguments": "{\"entity_ids\": \n[\"dw_1023\", \"dw_1766\", \"CIS_COURSE_CATALOG\", \"SUBJECT_OFFERED_SUMMARY\", \"ACADEMIC_TERMS_ALL\"]\n\n}"
