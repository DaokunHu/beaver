    {
      "role": "tool",
      "tool_call_id": "call_a83e021e2ebb482c94a645f9",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Surrogate key of the facilities organization; joins to SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY\"}, \"ORGANIZATION_ID\": {\"desc\": \"Organization identifier (same value as the organization key in current data)\"}, \"ORGANIZATION\": {\"desc\": \"Short organization abbreviation, e.g. 'AERO', 'ADMISS'\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Display name of the organization, e.g. 'AERO & ASTRO'; used for organization-name reporting\"}, \"FCLT_ORG_PARENT_KEY\": {\"desc\": \"Key of the parent organization in the hierarchy tree; null for the top-level organization\"}, \"ORG_PARENT\": {\"desc\": \"Abbreviation of the parent organization, e.g. 'S ENG' (School of Engineering)\"}, \"FCLT_MAJOR_ORG_KEY\": {\"desc\": \"Key of the major (top-level grouping) organization this organization rolls up to\"}, \"MAJOR_ORG\": {\"desc\": \"Abbreviation of the major organization, e.g. 'PROVST', 'CHNCLR'\"}, \"ORGANIZATION_LEVEL\": {\"desc\": \"Level of the organization in the hierarchy tree (1 = institute-wide root, 2-4 = intermediate divisions/schools, 5 = department/DLC level, 6 = sub-organization); stored as string, filter with values like '5'\"}, \"ORGANIZATION_NUMBER\": {\"desc\": \"Official organization number used in administrative systems\"}, \"ORGANIZATION_SORT\": {\"desc\": \"Sortable hierarchical organization code reflecting the tree path\"}, \"ASSIGNABLE\": {\"desc\": \"Flag ('1'/'0') indicating whether the organization is an assignable-space organizational unit\"}, \"COURSE\": {\"desc\": \"Academic course (department) number for degree-granting academic departments, e.g. '16' for Aeronautics and Astronautics; null for non-academic organizations\"}, \"DESCRIPTION\": {\"desc\": \"Long description of the organization, e.g. 'Department of Aeronautics and Astronautics'; null for many non-academic organizations\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_AEROASTRO'; joins to FCLT_ORG_DLC_KEY.DLC_KEY, HR_ORG_UNIT.DLC_KEY (for HR org unit title/level and HR department attributes; may fan out when a DLC maps to multiple HR org units), and MASTER_DEPT_HIERARCHY.DLC_KEY (for the standard department hierarchy path)\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Aeronautics and Astronautics'\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code cross-reference\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"HR organization unit identifier cross-reference; links to HR_ORG_UNIT\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"Department name as recorded in HR systems\"}}, \"default_granularity\": \"one row per facilities organization\"}, {\"id\": \"FAC_ORGANIZATION\", \"name\": \"FAC_ORGANIZATION\", \"desc\": \"Facilities organization snapshot table with the same hierarchical organization structure as FCLT_ORGANIZATION (organization identifiers, parent/major organization, level, assignable flag, course number, description, HR cross-references) but keyed by ORGANIZATION_KEY and carrying D_CODE instead of DLC_KEY/DLC_NAME. Contains fewer organizations than FCLT_ORGANIZATION; used as an alternative organization dimension in FAC_* family queries.\", \"columns\": {\"ORGANIZATION_KEY\": {\"desc\": \"Surrogate key of the organization; same value domain as FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY\"}, \"ORGANIZATION_ID\": {\"desc\": \"Organization identifier\"}, \"ORGANIZATION\": {\"desc\": \"Short organization abbreviation\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Display name of the organization\"}, \"ORG_PARENT_KEY\": {\"desc\": \"Key of the parent organization in the hierarchy\"}, \"ORG_PARENT\": {\"desc\": \"Abbreviation of the parent organization\"}, \"MAJOR_ORG_KEY\": {\"desc\": \"Key of the major (top-level) organization\"}, \"MAJOR_ORG\": {\"desc\": \"Abbreviation of the major organization\"}, \"ORGANIZATION_LEVEL\": {\"desc\": \"Level of the organization in the hierarchy tree (1 = root, 5 = department/DLC level, 6 = sub-organization)\"}, \"ORGANIZATION_NUMBER\": {\"desc\": \"Official organization number\"}, \"ORGANIZATION_SORT\": {\"desc\": \"Sortable hierarchical organization code\"}, \"ASSIGNABLE\": {\"desc\": \"Flag indicating whether the organization is an assignable-space unit\"}, \"COURSE\": {\"desc\": \"Academic course (department) number for academic departments\"}, \"DESCRIPTION\": {\"desc\": \"Long description of the organization\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"D_CODE\": {\"desc\": \"Department/Lab/Center code (equivalent role to DLC_KEY in FCLT_ORGANIZATION)\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code cross-reference\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"HR organization unit identifier cross-reference\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"Department name as recorded in HR systems\"}}, \"default_granularity\": \"one row per facilities organization\"}, {\"id\": \"MASTER_DEPT_HIERARCHY\", \"name\": \"MASTER_DEPT_HIERARCHY\", \"desc\": \"Master department hierarchy table: one row per department/lab/center (DLC) under the 'Standard Hierarchy' hierarchy type, recording the DLC key/code/name and its five-level hierarchy path from the institute root (level 1 'All Departments') through executive areas down to the DLC's placement, with each level's code and name (null for levels deeper than the DLC's position). Joins to HR_ORG_UNIT and FCLT_ORGANIZATION via DLC_KEY; used to report or filter the master-hierarchy placement (school/area path) of a DLC, and as a DLC scope filter when only DLCs present in the standard hierarchy should be included.\", \"columns\": {\"HIERARCHY_TYPE\": {\"desc\": \"Hierarchy classification of the row; only 'Standard Hierarchy' exists in current data\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_CAMPLAN'; joins to HR_ORG_UNIT.DLC_KEY and FCLT_ORGANIZATION.DLC_KEY\"}, \"DLC_CODE\": {\"desc\": \"Department/Lab/Center code (same value as DLC_KEY in current data); matches MASTER_DEPT_DCODE_PARENT.D_CODE\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Campus Planning'\"}, \"MASTER_DEPT_HIER_LEVEL_1_CODE\": {\"desc\": \"Code of the level-1 hierarchy node, 'D_ALL' for all rows\"}, \"MASTER_DEPT_HIER_LEVEL_1_NAME\": {\"desc\": \"Name of the level-1 hierarchy node, 'All Departments'\"}, \"MASTER_DEPT_HIER_LEVEL_2_CODE\": {\"desc\": \"Code of the level-2 hierarchy node, e.g. 'D_EXECVP_AREA'\"}, \"MASTER_DEPT_HIER_LEVEL_2_NAME\": {\"desc\": \"Name of the level-2 hierarchy node, e.g. \\\"Executive Vice President's Area\\\"\"}, \"MASTER_DEPT_HIER_LEVEL_3_CODE\": {\"desc\": \"Code of the level-3 hierarchy node; null when the DLC's path is shallower than 3 levels\"}, \"MASTER_DEPT_HIER_LEVEL_3_NAME\": {\"desc\": \"Name of the level-3 hierarchy node, e.g. 'VP Finance Area'; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_4_CODE\": {\"desc\": \"Code of the level-4 hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_4_NAME\": {\"desc\": \"Name of the level-4 hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_5_CODE\": {\"desc\": \"Code of the level-5 (deepest) hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_5_NAME\": {\"desc\": \"Name of the level-5 (deepest) hierarchy node; null for shallow paths\"}}, \"default_granularity\": \"one row per DLC under the standard hierarchy type\"}, {\"id\": \"HR_ORG_UNIT\", \"name\": \"HR_ORG_UNIT\", \"desc\": \"HR organization unit dimension table: one row per HR organization unit with unit key/ID/title, unit level classification (ALL MIT, TOP LEVEL, DEPARTMENTS, SUB DEPARTMENT, ORGANIZATION LEVEL, NON HIERARCHY ORG UNITS), HR department identifiers and name variants (short, long, alphabetical), organization hierarchy area names (school area, top level, root), the full HR hierarchy path levels 1-7 (each with ID, sort order, and name), and DLC_KEY/DLC_NAME cross-references to departments/labs/centers. Joined from FCLT_ORGANIZATION and MASTER_DEPT_HIERARCHY via DLC_KEY to attach HR department attributes (title, level, department name, long name, hierarchy path) to facilities organizations and DLCs; a single DLC_KEY can map to multiple HR org unit rows, so joins via DLC_KEY may fan out.\", \"columns\": {\"HR_ORG_UNIT_KEY\": {\"desc\": \"Surrogate key of the HR organization unit, formatted 'O' + numeric ID (e.g. 'O10000333'); joins to HR_ORG_UNIT_NEW.HR_ORG_UNIT_KEY\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"Numeric HR organization unit identifier (e.g. '10000333'); cross-referenced by FCLT_ORGANIZATION.HR_ORG_UNIT_ID\"}, \"HR_ORG_UNIT_TITLE\": {\"desc\": \"Title of the HR organization unit, e.g. 'Institute for Data, Systems, and Society'; reported as the HR org unit title of a facilities organization joined via DLC_KEY\"}, \"HR_ORG_UNIT_LEVEL\": {\"desc\": \"Level classification of the HR organization unit; observed values: 'ALL MIT', 'TOP LEVEL', 'DEPARTMENTS', 'SUB DEPARTMENT', 'ORGANIZATION LEVEL', 'NON HIERARCHY ORG UNITS', and null; distinct from the numeric ORGANIZATION_LEVEL of FCLT_ORGANIZATION\"}, \"HR_DEPARTMENT_ID\": {\"desc\": \"Numeric HR department identifier (same value as HR_ORG_UNIT_ID in current data); absent from HR_ORG_UNIT_NEW\"}, \"HR_DEPARTMENT_CODE\": {\"desc\": \"HR department code in 'HR-NNNNNN' format, e.g. 'HR-068100'\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code (numeric part of HR_DEPARTMENT_CODE), e.g. '68100'\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"HR department name, e.g. 'Institute for Data, Systems, and Society'; the HR-side counterpart of academic department names, used for grouping/partitioning organizations by HR department\"}, \"HR_DEPARTMENT_NAME_LONG\": {\"desc\": \"Long form of the HR department name (often identical to HR_DEPARTMENT_NAME)\"}, \"HR_DEPARTMENT_NAME_ALPHA\": {\"desc\": \"Alphabetical-sort variant of the HR department name\"}, \"ORG_HIER_SCHOOL_AREA_NAME\": {\"desc\": \"Name of the school/area the unit belongs to in the organization hierarchy, e.g. 'Schwarzman College of Computing Area', 'VP for Finance Area'\"}, \"ORG_HIER_TOP_LEVEL_NAME\": {\"desc\": \"Name of the top-level area of the unit in the organization hierarchy, e.g. 'Provost Area', 'Executive Vice President Area'\"}, \"ORG_HIER_ROOT_NAME\": {\"desc\": \"Root name of the organization hierarchy, 'MIT-All' for all rows\"}, \"HR_ORG_LEVEL1_ID\": {\"desc\": \"ID of the level-1 node (institute root, '10000000') in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL1_SORT\": {\"desc\": \"Sort order of the level-1 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL1_NAME\": {\"desc\": \"Name of the level-1 node, 'MIT-All'\"}, \"HR_ORG_LEVEL2_ID\": {\"desc\": \"ID of the level-2 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL2_SORT\": {\"desc\": \"Sort order of the level-2 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL2_NAME\": {\"desc\": \"Name of the level-2 node, e.g. 'Provost Area', 'Executive Vice President Area'\"}, \"HR_ORG_LEVEL3_ID\": {\"desc\": \"ID of the level-3 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL3_SORT\": {\"desc\": \"Sort order of the level-3 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL3_NAME\": {\"desc\": \"Name of the level-3 node, e.g. a school/VP area name\"}, \"HR_ORG_LEVEL4_ID\": {\"desc\": \"ID of the level-4 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL4_SORT\": {\"desc\": \"Sort order of the level-4 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL4_NAME\": {\"desc\": \"Name of the level-4 node, e.g. an area/office name\"}, \"HR_ORG_LEVEL5_ID\": {\"desc\": \"ID of the level-5 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL5_SORT\": {\"desc\": \"Sort order of the level-5 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL5_NAME\": {\"desc\": \"Name of the level-5 node, e.g. a department/unit name\"}, \"HR_ORG_LEVEL6_ID\": {\"desc\": \"ID of the level-6 node in the HR organization hierarchy path; null when the path is shallower; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL6_SORT\": {\"desc\": \"Sort order of the level-6 node; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL6_NAME\": {\"desc\": \"Name of the level-6 node; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL7_ID\": {\"desc\": \"ID of the level-7 (deepest) node in the HR organization hierarchy path; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL7_SORT\": {\"desc\": \"Sort order of the level-7 node; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL7_NAME\": {\"desc\": \"Name of the level-7 node; absent from HR_ORG_UNIT_NEW\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key cross-reference, e.g. 'D_IDSS', 'D_OTP'; joins to FCLT_ORGANIZATION.DLC_KEY and MASTER_DEPT_HIERARCHY.DLC_KEY; null for units without a DLC assignment, and one DLC_KEY may appear on multiple HR org unit rows\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name cross-reference, e.g. 'Office of Treasury and Planning'; may differ from the HR unit title; carried only by HR_ORG_UNIT (not HR_ORG_UNIT_NEW); can be used for name-based self-matching of units sharing a DLC\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per HR organization unit\"}, {\"id\": \"dw_1864\", \"name\": \"Level-5 Assignable Organization Space Units with Provost Area HR Department Statistics\", \"desc\": \"For each organization whose organization level is 5 and is not 'ADMISSIONS', and for each organization and its corresponding HR department where the organization is assignable, the HR organization unit level is 'DEPARTMENTS', the organization is not 'Cambridge-MIT Institute', and the organization is in the 'Provost Area' top-level HR hierarchy, but excluding organizations with organization IDs '138' and '250', show the organization name, description, the corresponding space unit name, the total number of space units associated with each organization, the HR department name, the number of organizations, and the minimum organization number. Do not return any rounded answers.\", \"sql\": \"WITH org_space_units AS ( SELECT ORGANIZATION_NAME, DESCRIPTION, SPACE_UNIT, COUNT(SPACE_UNIT) OVER (PARTITION BY ORGANIZATION_NAME) AS total_space_units, DLC_KEY FROM ( SELECT t0.ORGANIZATION_NAME, t0.DESCRIPTION, t1.SPACE_UNIT, ROW_NUMBER() OVER (ORDER BY t1.SPACE_UNIT ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t0.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN SPACE_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.ORGANIZATION_LEVEL = 5 AND t0.ORGANIZATION_NAME <> 'ADMISSIONS' AND t0.ORGANIZATION_ID NOT IN ('138', '250') ) inner_cte ), org_hr_dept AS ( SELECT ic.ORGANIZATION, ic.HR_DEPARTMENT_NAME, ic.organization_count, ic.min_organization_number, f.DLC_KEY FROM ( SELECT f.ORGANIZATION, h.HR_DEPARTMENT_NAME, COUNT(f.FCLT_ORGANIZATION_KEY) AS organization_count, MIN(f.ORGANIZATION_NUMBER) AS min_organization_number FROM FCLT_ORGANIZATION f JOIN HR_ORG_UNIT h ON f.HR_DEPARTMENT_CODE_OLD = h.HR_DEPARTMENT_CODE_OLD WHERE f.ASSIGNABLE = 1 AND h.HR_ORG_UNIT_LEVEL = 'DEPARTMENTS' AND f.ORGANIZATION_NAME NOT IN ('CAMBRIDGE-MIT INST') AND f.ORGANIZATION_ID NOT IN ('138', '250') GROUP BY f.ORGANIZATION, h.HR_DEPARTMENT_NAME ) ic JOIN HR_ORG_UNIT h2 ON ic.HR_DEPARTMENT_NAME = h2.HR_DEPARTMENT_NAME JOIN FCLT_ORGANIZATION f ON ic.ORGANIZATION = f.ORGANIZATION WHERE h2.ORG_HIER_TOP_LEVEL_NAME = 'Provost Area' ) SELECT osu.ORGANIZATION_NAME, osu.DESCRIPTION, osu.SPACE_UNIT, osu.total_space_units, ohd.HR_DEPARTMENT_NAME, ohd.organization_count, ohd.min_organization_number FROM org_space_units osu JOIN org_hr_dept ohd ON osu.DLC_KEY = ohd.DLC_KEY;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per level-5 organization space unit matched with its Provost Area HR department statistics\"}, {\"id\": \"dw_1465\", \"name\": \"Provost Area School of Science Department Organizations with Max Average Organization Number and Room Area Stddev\", \"desc\": \"For each department in the Provost Area at the School of Science level, excluding the Biology department, and for each organization within those departments (excluding organizations with IDs '138' and '250'), show the department name, department code, organization name, organization ID, the maximum average organization number within each department code group, and the standard deviation (using STDDEV only and never STDDEV_POP) of the area of rooms assigned to the organization (considering only organizations with more than 5 rooms and excluding organizations named 'ADMISSIONS'), ordered by department name and organization name. Do not return any rounded answers.\", \"sql\": \"WITH dept_max_avg_org AS ( WITH inner_cte AS ( SELECT t0.DLC_NAME, t0.DLC_CODE, t1.ORGANIZATION_NAME, t1.ORGANIZATION_ID, AVG(t1.ORGANIZATION_NUMBER) OVER (PARTITION BY t0.DLC_CODE ORDER BY t1.ORGANIZATION_SORT) AS avg_org_number FROM MASTER_DEPT_HIERARCHY t0 JOIN FCLT_ORGANIZATION t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' AND t0.MASTER_DEPT_HIER_LEVEL_3_NAME = 'School of Science' AND LOWER(t0.DLC_NAME) <> LOWER('Biology') AND t1.ORGANIZATION_ID NOT IN ('138', '250') ) SELECT DLC_NAME, DLC_CODE, ORGANIZATION_NAME, ORGANIZATION_ID, MAX(avg_org_number) AS max_avg_org_number FROM inner_cte GROUP BY DLC_NAME, DLC_CODE, ORGANIZATION_NAME, ORGANIZATION_ID ), org_area_stddev AS ( WITH inner_cte AS ( SELECT fo.ORGANIZATION_NAME, STDDEV(fr.AREA) AS area_stddev, fo.FCLT_ORGANIZATION_KEY FROM FCLT_ROOMS fr JOIN FCLT_ORGANIZATION fo ON fr.FCLT_ORGANIZATION_KEY = fo.FCLT_ORGANIZATION_KEY WHERE fo.ORGANIZATION_NAME <> 'ADMISSIONS' GROUP BY fo.ORGANIZATION_NAME, fo.FCLT_ORGANIZATION_KEY HAVING COUNT(fr.FCLT_ROOM_KEY) > 5 ) SELECT i.ORGANIZATION_NAME, fo.ORGANIZATION_NUMBER AS dept_code, i.area_stddev, fo.FCLT_ORGANIZATION_KEY FROM inner_cte i JOIN FCLT_ORGANIZATION fo ON i.FCLT_ORGANIZATION_KEY = fo.FCLT_ORGANIZATION_KEY ) SELECT d.DLC_NAME, d.DLC_CODE, d.ORGANIZATION_NAME, d.ORGANIZATION_ID, d.max_avg_org_number, o.area_stddev FROM dept_max_avg_org d JOIN FCLT_ORGANIZATION fo ON d.ORGANIZATION_ID = fo.ORGANIZATION_ID JOIN org_area_stddev o ON fo.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY ORDER BY d.DLC_NAME, d.ORGANIZATION_NAME\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per School-of-Science department organization matched with its room area standard deviation\"}, {\"id\": \"concept_facility_organization_dimension\", \"name\": \"Facility Organization Dimension\", \"desc\": \"Organization dimension tables describing the institute's hierarchical organization tree used for facilities/space attribution: FCLT_ORGANIZATION (keyed by FCLT_ORGANIZATION_KEY, with DLC_KEY/DLC_NAME) and FAC_ORGANIZATION (keyed by ORGANIZATION_KEY, with D_CODE). They answer the same questions about organization names, hierarchy levels, parent/major organizations, assignable flags, and HR cross-references, but belong to different table families and coverage.\", \"tables\": [\"FCLT_ORGANIZATION\", \"FAC_ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Key family\", \"differences\": \"FCLT_ORGANIZATION uses FCLT_ORGANIZATION_KEY/FCLT_ORG_PARENT_KEY/FCLT_MAJOR_ORG_KEY and is referenced by SPACE_UNIT and FCLT_ROOMS; FAC_ORGANIZATION uses ORGANIZATION_KEY/ORG_PARENT_KEY/MAJOR_ORG_KEY and is referenced by FAC_ROOMS.\"}, {\"dimension\": \"Coverage\", \"differences\": \"FCLT_ORGANIZATION holds more organizations (180 rows) than FAC_ORGANIZATION (169 rows); key values overlap almost entirely, so FCLT_ORGANIZATION is the broader dimension.\"}, {\"dimension\": \"DLC attribution columns\", \"differences\": \"FCLT_ORGANIZATION carries both DLC_KEY and DLC_NAME plus an HR_DEPARTMENT_NAME; FAC_ORGANIZATION carries only D_CODE (no DLC name column).\"}, {\"dimension\": \"Shared structure\", \"differences\": \"Both share ORGANIZATION_ID/ORGANIZATION/ORGANIZATION_NAME, ORGANIZATION_LEVEL (1-6, level 5 = department/DLC), ORGANIZATION_NUMBER, ORGANIZATION_SORT, ASSIGNABLE, COURSE, DESCRIPTION, and HR cross-reference columns.\"}], \"decision_guide\": {\"Organization level, name, description, or hierarchy questions linked to space units or FCLT rooms\": \"Use FCLT_ORGANIZATION: it joins SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY and has the widest organization coverage.\", \"Organization questions inside the FAC_* family (FAC_ROOMS occupancy, FAC_BUILDING analysis)\": \"Use FAC_ORGANIZATION: FAC_ROOMS.ORGANIZATION_KEY references it directly.\", \"DLC name reporting for an organization\": \"Use FCLT_ORGANIZATION: it is the only one carrying DLC_NAME alongside DLC_KEY.\"}}, {\"id\": \"concept_dept_hr_org_hierarchy\", \"name\": \"Department and HR Organization Hierarchy\", \"desc\": \"Tables describing the institute's department/lab/center (DLC) and HR organization hierarchies: the HR organization unit dimension in two feed variants (HR_ORG_UNIT, HR_ORG_UNIT_NEW), the master department standard hierarchy path (MASTER_DEPT_HIERARCHY), its DLC-to-administrative-object link table (MASTER_DEPT_HIERARCHY_LINKS), and the direct-parent department lookup (MASTER_DEPT_DCODE_PARENT). They jointly answer questions about which HR department/area a DLC or organization belongs to, the hierarchy path or parent of a department, and HR department names/codes/levels, and are joined to FCLT_ORGANIZATION via DLC_KEY for facilities/space attribution. They differ in hierarchy representation (full path vs direct parent vs HR unit attributes), unit coverage, and companion columns.\", \"tables\": [\"HR_ORG_UNIT\", \"HR_ORG_UNIT_NEW\", \"MASTER_DEPT_HIERARCHY\", \"MASTER_DEPT_HIERARCHY_LINKS\", \"MASTER_DEPT_DCODE_PARENT\"], \"comparisons\": [{\"dimension\": \"Granularity and business object\", \"detail\": \"HR_ORG_UNIT and HR_ORG_UNIT_NEW hold one row per HR organization unit (641 and 691 rows respectively); MASTER_DEPT_HIERARCHY holds one row per DLC (310 rows) with its 5-level standard hierarchy path; MASTER_DEPT_HIERARCHY_LINKS holds one row per DLC-to-linked-object association (fund centers, profit centers, facilities orgs, org units); MASTER_DEPT_DCODE_PARENT holds one row per department code with only its direct parent.\"}, {\"dimension\": \"Hierarchy representation\", \"detail\": \"HR_ORG_UNIT carries the HR hierarchy path levels 1-7 plus school-area/top-level/root names and a unit level classification (ALL MIT, TOP LEVEL, DEPARTMENTS, SUB DEPARTMENT, ORGANIZATION LEVEL, NON HIERARCHY ORG UNITS); HR_ORG_UNIT_NEW carries only levels 1-5; MASTER_DEPT_HIERARCHY carries the master standard-hierarchy path levels 1-5 by code and name; MASTER_DEPT_DCODE_PARENT carries no path, only the immediate parent code/name.\"}, {\"dimension\": \"Coverage and feed differences\", \"detail\": \"HR_ORG_UNIT_NEW is the newer feed with more units (691 vs 641, including 50 units absent from HR_ORG_UNIT) but lacks HR_DEPARTMENT_ID, DLC_NAME, and hierarchy levels 6-7, and adds HR_DEPARTMENT_ABBR; HR_ORG_UNIT is required when DLC_NAME or the deeper path is needed. MASTER_DEPT_HIERARCHY covers only DLCs placed in the 'Standard Hierarchy'; MASTER_DEPT_DCODE_PARENT covers 340 department codes including some outside that hierarchy.\"}, {\"dimension\": \"DLC cross-reference columns\", \"detail\": \"HR_ORG_UNIT carries DLC_KEY and DLC_NAME (DLC_KEY null for 133 units, and one DLC_KEY may map to multiple HR unit rows); HR_ORG_UNIT_NEW carries only DLC_KEY (possibly composite like 'D_DSL:HQ'); MASTER_DEPT_HIERARCHY and MASTER_DEPT_HIERARCHY_LINKS carry DLC_KEY/DLC_CODE as their primary DLC identity; MASTER_DEPT_DCODE_PARENT uses D_CODE/D_NAME naming for the same value domain.\"}, {\"dimension\": \"Companion attributes\", \"detail\": \"Only the HR_ORG_UNIT tables carry HR department identifiers/codes (HR_ORG_UNIT_ID, HR_DEPARTMENT_CODE 'HR-NNNNNN', HR_DEPARTMENT_CODE_OLD) and department name variants (short/long/alpha) used for HR department reporting; only MASTER_DEPT_HIERARCHY_LINKS carries linked administrative object keys/codes and link type classification.\"}], \"decision_guide\": {\"HR org unit title, HR org unit level, HR department name/code/long name for a facilities organization or DLC\": \"Use HR_ORG_UNIT joined via DLC_KEY; it is the only table carrying DLC_NAME alongside the HR department attributes and the full levels 1-7 path.\", \"HR department attributes for units missing from the older feed, or when the newer unit coverage is required\": \"Use HR_ORG_UNIT_NEW; it holds 50 units absent from HR_ORG_UNIT but lacks DLC_NAME and hierarchy levels 6-7.\", \"School/area placement or full standard-hierarchy path of a DLC, or restricting analysis to DLCs in the standard hierarchy\": \"Use MASTER_DEPT_HIERARCHY (levels 1-5 codes and names per DLC).\", \"Fund center, profit center, facilities organization, or other administrative object linked to a DLC\": \"Use MASTER_DEPT_HIERARCHY_LINKS filtered by LINK_TYPE_CODE (FC, PMIT, FORG, ORG2, ORGU, SIS, BAG).\", \"Direct parent department of a department code (single-level parent lookup)\": \"Use MASTER_DEPT_DCODE_PARENT (PARENT_D_CODE/PARENT_D_NAME); use MASTER_DEPT_HIERARCHY instead when the multi-level path is needed.\"}}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_29bf1cd75a754cddb81a0037",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"count\": 12, \"items\": [{\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Space unit dimension table: one row per space unit (an organizational space-assignment unit such as a department, program, or office that receives space allocation), with space unit key/code, space unit name, the facilities organization it belongs to, and DLC key. Bridges FCLT_ORGANIZATION (organization attribution) and SPACE_DETAIL (rooms assigned to the space unit); used to group room counts and space statistics by space unit.\", \"entity_type\": \"table\", \"id\": \"SPACE_UNIT\", \"name\": \"SPACE_UNIT\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Facilities room inventory table: one row per physical room with building/floor keys, room identifiers, use classifications (major/minor use), organization assignment, area in square meters, access level, and geographic coordinates. Joins to FCLT_BUILDING via FCLT_BUILDING_KEY; referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE via FCLT_ROOM_KEY.\", \"entity_type\": \"table\", \"id\": \"FCLT_ROOMS\", \"name\": \"FCLT_ROOMS\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Bridge table mapping facilities organizations to their department/lab/center (DLC) keys: one row per organization-DLC key assignment. Used to filter organizations that have a non-null DLC key assignment before joining FCLT_ORGANIZATION (via FCLT_ORGANIZATION_KEY or DLC_KEY) for DLC-level facility and room statistics.\", \"entity_type\": \"table\", \"id\": \"FCLT_ORG_DLC_KEY\", \"name\": \"FCLT_ORG_DLC_KEY\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"entity_type\": \"table\", \"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"entity_type\": \"table\", \"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"entity_type\": \"table\", \"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"HR organization unit dimension table: one row per HR organization unit with unit key/ID/title, unit level classification (ALL MIT, TOP LEVEL, DEPARTMENTS, SUB DEPARTMENT, ORGANIZATION LEVEL, NON HIERARCHY ORG UNITS), HR department identifiers and name variants (short, long, alphabetical), organization hierarchy area names (school area, top level, root), the full HR hierarchy path levels 1-7 (each with ID, sort order, and name), and DLC_KEY/DLC_NAME cross-references to departments/labs/centers. Joined from FCLT_ORGANIZATION and MASTER_DEPT_HIERARCHY via DLC_KEY to attach HR department attributes (title, level, department name, long name, hierarchy path) to facilities organizations and DLCs; a single DLC_KEY can map to multiple HR org unit rows, so joins via DLC_KEY may fan out.\", \"entity_type\": \"table\", \"id\": \"HR_ORG_UNIT\", \"name\": \"HR_ORG_UNIT\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Master department hierarchy table: one row per department/lab/center (DLC) under the 'Standard Hierarchy' hierarchy type, recording the DLC key/code/name and its five-level hierarchy path from the institute root (level 1 'All Departments') through executive areas down to the DLC's placement, with each level's code and name (null for levels deeper than the DLC's position). Joins to HR_ORG_UNIT and FCLT_ORGANIZATION via DLC_KEY; used to report or filter the master-hierarchy placement (school/area path) of a DLC, and as a DLC scope filter when only DLCs present in the standard hierarchy should be included.\", \"entity_type\": \"table\", \"id\": \"MASTER_DEPT_HIERARCHY\", \"name\": \"MASTER_DEPT_HIERARCHY\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Space-planning room load table: one row per room record from the space planning feed, with the building-room identifier, building component, floor (numeric or label such as 'G9'), space usage text (e.g. 'DSGN STUDIO', 'CONF RM'), space unit code, HR organization unit id, and room access level. Links rooms to SPACE_UNIT via SPACE_UNIT_CODE and to FCLT_ORGANIZATION/HR_ORG_UNIT via HR_ORG_UNIT_ID; used for floor/access-level/space-usage room analysis from the space-planning perspective, without the area and use-key columns carried by FCLT_ROOMS.\", \"entity_type\": \"table\", \"id\": \"ZPM_ROOMS_LOAD\", \"name\": \"ZPM_ROOMS_LOAD\"}, {\"relation_type\": \"concept\", \"direction\": \"incoming\", \"desc\": \"Organization dimension tables describing the institute's hierarchical organization tree used for facilities/space attribution: FCLT_ORGANIZATION (keyed by FCLT_ORGANIZATION_KEY, with DLC_KEY/DLC_NAME) and FAC_ORGANIZATION (keyed by ORGANIZATION_KEY, with D_CODE). They answer the same questions about organization names, hierarchy levels, parent/major organizations, assignable flags, and HR cross-references, but belong to different table families and coverage.\", \"entity_type\": \"concept\", \"id\": \"concept_facility_organization_dimension\", \"name\": \"Facility Organization Dimension\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Facility organization key columns attributing space units and rooms to organizations in the hierarchical organization tree. Two naming conventions exist across table families (FCLT_ORGANIZATION_KEY in FCLT_*/SPACE_* tables vs ORGANIZATION_KEY in FAC_* tables) with the same value domain.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_facility_organization_key\", \"name\": \"Facility Organization Key\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Department/Lab/Center key columns (values like 'D_AEROASTRO', 'D_IDSS', 'D_BIOLOGY') identifying a DLC across the facilities, HR, space, and academic-department domains. They are the universal cross-domain join key linking facilities organizations and space units to HR organization units, the master department hierarchy, and academic departments. Naming and completeness vary: DLC_KEY in most tables, D_CODE in MASTER_DEPT_DCODE_PARENT, DLC_CODE in the master hierarchy tables; some columns carry composite values ('D_DSL:HQ') or nulls.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_dlc_key\", \"name\": \"DLC Key (Department/Lab/Center)\"}]}"
