      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_2850\", \"name\": \"Status-U Reserve Catalog Key Variance by Term and Department with Rollup Totals\", \"desc\": \"For each term and department, what is the term, department, and the variance of the reserve catalog keys for courses in that department and term where the material status is 'U'? Include subtotals for each term (the corresponding term field is 'SUBTOTAL') and a grand total across all terms (the corresponding term field is 'TOTAL'). Do not repeat the term if it is the same as the previous row. Sort the table by term and department. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT lci.DEPARTMENT, lrmd.TERM_CODE, VARIANCE(lrmd.LIBRARY_RESERVE_CATALOG_KEY) AS catalog_key_variance FROM LIBRARY_COURSE_INSTRUCTOR lci JOIN LIBRARY_RESERVE_MATRL_DETAIL lrmd ON lci.LIBRARY_COURSE_INSTRUCTOR_KEY = lrmd.LIBRARY_COURSE_INSTRUCTOR_KEY WHERE lrmd.LIBRARY_MATERIAL_STATUS_KEY = 'U' GROUP BY lci.DEPARTMENT, lrmd.TERM_CODE ) SELECT CASE WHEN LAG(term) OVER (ORDER BY term_sort, term, dept_sort) = term THEN NULL ELSE term END AS term, dept, catalog_key_variance FROM ( SELECT CASE WHEN GROUPING(TERM_CODE) = 1 AND GROUPING(DEPARTMENT) = 1 THEN 'zzz' ELSE TERM_CODE END AS term_sort, CASE WHEN GROUPING(TERM_CODE) = 0 AND GROUPING(DEPARTMENT) = 1 THEN 'SUBTOTAL' WHEN GROUPING(TERM_CODE) = 1 AND GROUPING(DEPARTMENT) = 1 THEN 'TOTAL' ELSE TERM_CODE END AS term, CASE WHEN GROUPING(TERM_CODE) = 0 AND GROUPING(DEPARTMENT) = 1 THEN 'zzz' ELSE DEPARTMENT END AS dept_sort, DEPARTMENT AS dept, VARIANCE(LIBRARY_RESERVE_CATALOG_KEY) AS catalog_key_variance FROM ( SELECT lci.DEPARTMENT, lrmd.TERM_CODE, lrmd.LIBRARY_RESERVE_CATALOG_KEY FROM LIBRARY_COURSE_INSTRUCTOR lci JOIN LIBRARY_RESERVE_MATRL_DETAIL lrmd ON lci.LIBRARY_COURSE_INSTRUCTOR_KEY = lrmd.LIBRARY_COURSE_INSTRUCTOR_KEY WHERE lrmd.LIBRARY_MATERIAL_STATUS_KEY = 'U' ) base GROUP BY TERM_CODE, DEPARTMENT WITH ROLLUP ) tbltmp ORDER BY term_sort, dept_sort;\", \"category\": \"Library Reserve and Course Instructor Comprehensive Analysis\", \"default_granularity\": \"one row per term and department, plus per-term subtotal rows and a grand total row\"}, {\"id\": \"dw_3234\", \"name\": \"Top 10 TIP Material Statuses by Material Count with 2009SP Library Reserve Status Counts\", \"desc\": \"For the top 10 material statuses by the number of materials, what is the material status description, the count of materials for each status, the associated library material status, and the count of reserve catalog items for each library material status for term code '2009SP'? Do not return any rounded answers.\", \"sql\": \"WITH TopMaterialStatuses AS ( SELECT tms.TIP_MATERIAL_STATUS, COUNT(td.TIP_MATERIAL_KEY) AS material_count FROM TIP_DETAIL td JOIN TIP_MATERIAL_STATUS tms ON td.TIP_MATERIAL_STATUS_KEY = tms.TIP_MATERIAL_STATUS_KEY GROUP BY tms.TIP_MATERIAL_STATUS ORDER BY material_count DESC LIMIT 10 ), ReserveCounts AS ( SELECT lms.LIBRARY_MATERIAL_STATUS, COUNT(lrmd.LIBRARY_RESERVE_CATALOG_KEY) AS reserve_count, lrmd.LIBRARY_MATERIAL_STATUS_KEY FROM LIBRARY_MATERIAL_STATUS lms JOIN LIBRARY_RESERVE_MATRL_DETAIL lrmd ON lms.LIBRARY_MATERIAL_STATUS_KEY = lrmd.LIBRARY_MATERIAL_STATUS_KEY WHERE lrmd.TERM_CODE = '2009SP' GROUP BY lms.LIBRARY_MATERIAL_STATUS, lrmd.LIBRARY_MATERIAL_STATUS_KEY ORDER BY reserve_count DESC ) SELECT tms.TIP_MATERIAL_STATUS, tms.material_count, rc.LIBRARY_MATERIAL_STATUS, rc.reserve_count FROM TopMaterialStatuses tms JOIN TIP_MATERIAL_STATUS tms2 ON tms.TIP_MATERIAL_STATUS = tms2.TIP_MATERIAL_STATUS JOIN TIP_DETAIL td ON td.TIP_MATERIAL_STATUS_KEY = tms2.TIP_MATERIAL_STATUS_KEY JOIN LIBRARY_RESERVE_MATRL_DETAIL lrmd ON td.SUBJECT_ID = lrmd.SUBJECT_ID AND td.TERM_CODE = lrmd.TERM_CODE JOIN ReserveCounts rc ON lrmd.LIBRARY_MATERIAL_STATUS_KEY = rc.LIBRARY_MATERIAL_STATUS_KEY\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per top material status matched with library reserve material status of term 2009SP\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Fall 2024-2025 subject with status-U reserve materials\", \"desc\": \"For each subject offered in the term with the description \\\"Fall Term 2024-2025\\\" that also has more than 0 enrolled students and a material status key of 'U', show the subject offered key, subject title, offering department name, the term description, the rank of each subject within its offering department, the course number, course number description, number of enrolled students, the reserve catalog key, the dense rank over the material status key, and the academic year description, ordered by subject offered key and course number. Do not return any rounded answers.\", \"id\": \"dw_4566\", \"name\": \"Fall 2024-2025 Subjects with Status-U Library Reserve Materials Ranked per Department\", \"sql\": \"WITH inner_cte AS ( WITH SubjectOfferings AS ( SELECT t0.TIP_SUBJECT_OFFERED_KEY, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.TIP_SUBJECT_OFFERED_KEY) AS window_column, t0.SUBJECT_ID, t1.ACADEMIC_YEAR_DESC FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_DESCRIPTION = 'Fall Term 2024-2025' ), LibrarySubjectStats AS ( SELECT t1.COURSE_NUMBER, t1.COURSE_NUMBER_DESC, t1.NUM_ENROLLED_STUDENTS, t2.LIBRARY_RESERVE_CATALOG_KEY, DENSE_RANK() OVER (PARTITION BY t2.LIBRARY_MATERIAL_STATUS_KEY ORDER BY t2.LIBRARY_MATERIAL_STATUS_KEY) AS window_column, t1.SUBJECT_ID FROM LIBRARY_SUBJECT_OFFERED t1 JOIN LIBRARY_RESERVE_MATRL_DETAIL t2 ON t1.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.NUM_ENROLLED_STUDENTS > 0 AND t2.LIBRARY_MATERIAL_STATUS_KEY = 'U' ) SELECT so.TIP_SUBJECT_OFFERED_KEY, so.SUBJECT_TITLE, so.OFFER_DEPT_NAME, so.TERM_DESCRIPTION, so.windo