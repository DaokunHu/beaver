    {
      "role": "tool",
      "tool_call_id": "call_23bbdbf2dd4a4af0ae34d570",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per subject with textbooks\", \"desc\": \"For subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook, show the subject code, subject number, department name, subject title, term description, total units, the average subject enrollment number in a window of 2 preceding and 2 following rows grouped by department code and ordered by total units, the textbook material key, the textbook material status key, and the row number of the course within each department ordered by subject code. List the results in order by department name, subject code, and subject number. Do not return any rounded answers.\", \"id\": \"dw_3493\", \"name\": \"2022 12-Unit Subjects with Required or Optional Textbooks and Enrollment Windows\", \"sql\": \"WITH SubjectUnitsWindow AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ), CourseTextbookWindow AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t2.TIP_MATERIAL_KEY, t2.TIP_MATERIAL_STATUS_KEY, ROW_NUMBER() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.ACADEMIC_YEAR = 2022 AND t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') ) SELECT s.SUBJECT_CODE, s.SUBJECT_NUMBER, s.DEPARTMENT_NAME, s.SUBJECT_TITLE, s.TERM_DESCRIPTION, s.TOTAL_UNITS, s.window_column AS avg_enrollment_window, c.TIP_MATERIAL_KEY, c.TIP_MATERIAL_STATUS_KEY, c.window_column AS textbook_row_number FROM SubjectUnitsWindow s JOIN CourseTextbookWindow c ON s.SUBJECT_CODE = c.SUBJECT_CODE AND s.SUBJECT_NUMBER = c.SUBJECT_NUMBER AND s.DEPARTMENT_NAME = c.DEPARTMENT_NAME AND s.SUBJECT_TITLE = c.SUBJECT_TITLE AND s.TERM_DESCRIPTION = c.TERM_DESCRIPTION AND s.TERM_CODE = c.TERM_CODE AND s.SUBJECT_ID = c.SUBJECT_ID ORDER BY s.DEPARTMENT_NAME, s.SUBJECT_CODE, s.SUBJECT_NUMBER;\"}, {\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per department matched with 2022 textbook subjects above average units\", \"desc\": \"For each department, show the department name, the highest total units among its subjects with exactly 12 units in the Fall Term 2024-2025, and for each course in that department that was offered in 2022 and has at least one required or optional textbook and has total units greater than the average for such courses, show the course's subject code, subject number, subject title, the term description, the textbook material key, the textbook material status key, and the row number within the department ordered by subject code. Do not return any rounded answers.\", \"id\": \"dw_4448\", \"name\": \"Department Highest 12-Unit Fall 2024-2025 Subjects with 2022 Above-Average Textbook Courses\", \"sql\": \"WITH inner_cte1 AS ( SELECT t2.SUBJECT_ID, t2.SUBJECT_TITLE, t2.DEPARTMENT_NAME, t2.SCHOOL_NAME, t2.TOTAL_UNITS, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, ROW_NUMBER() OVER (PARTITION BY t2.DEPARTMENT_NAME ORDER BY t2.SUBJECT_ID) AS window_column FROM ACADEMIC_TERM_PARAMETER t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_DESCRIPTION = 'Fall Term 2024-2025' AND t2.TOTAL_UNITS = 12 ), subq1 AS ( SELECT DEPARTMENT_NAME, MAX(TOTAL_UNITS) AS highest_total_units FROM inner_cte1 GROUP BY DEPARTMENT_NAME ), inner_cte2 AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t2.TIP_MATERIAL_KEY, t2.TIP_MATERIAL_STATUS_KEY, t0.TOTAL_UNITS, ROW_NUMBER() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.ACADEMIC_YEAR = 2022 AND t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') ), subq2 AS ( SELECT SUBJECT_CODE, SUBJECT_NUMBER, DEPARTMENT_NAME, SUBJECT_TITLE, TERM_DESCRIPTION, TIP_MATERIAL_KEY, TIP_MATERIAL_STATUS_KEY, window_column FROM inner_cte2 WHERE TOTAL_UNITS > ( SELECT AVG(TOTAL_UNITS) FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.ACADEMIC_YEAR = 2022 AND t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') ) ) SELECT s1.DEPARTMENT_NAME, s1.highest_total_units, s2.SUBJECT_CODE, s2.SUBJECT_NUMBER, s2.SUBJECT_TITLE, s2.TERM_DESCRIPTION, s2.TIP_MATERIAL_KEY, s2.TIP_MATERIAL_STATUS_KEY, s2.window_column FROM subq1 s1 JOIN subq2 s2 ON s1.DEPARTMENT_NAME = s2.DEPARTMENT_NAME;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department per subject code\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\", \"id\": \"dw_4756\", \"name\": \"Department Course Counts with 2022 12-Unit Subjects Having Textbooks\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ) SELECT sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL, Total_Courses.Total_Courses, COALESCE(SubjectsWithTextbooks.Subjects_With_Textbooks, 0) AS Subjects_With_Textbooks_2022_12units FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER JOIN ( SELECT sd.DEPARTMENT_NAME, COUNT(DISTINCT COURSE_NUMBER) AS Total_Courses FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER GROUP BY sd.DEPARTMENT_NAME ) AS Total_Courses ON sd.DEPARTMENT_NAME = Total_Courses.DEPARTMENT_NAME LEFT JOIN ( SELECT s1.DEPARTMENT_NAME, COUNT(DISTINCT s1.SUBJECT_CODE || '-' || s1.SUBJECT_NUMBER) AS Subjects_With_Textbooks FROM inner_cte s1 JOIN TIP_DETAIL t2 ON s1.TERM_CODE = t2.TERM_CODE AND s1.SUBJECT_ID = t2.SUBJECT_ID WHERE t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') GROUP BY s1.DEPARTMENT_NAME ) AS SubjectsWithTextbooks ON sd.DEPARTMENT_NAME = SubjectsWithTextbooks.DEPARTMENT_NAME ;\"}, {\"id\": \"dw_104\", \"name\": \"Math 2022 Bulletin-Printed Subject Total Units Deviation from Department Average\", \"desc\": \"For subjects offered in the academic year 2022 that are printed in the bulletin and belong to the Mathematics department (Course 18), show the subject title, department name, total units, and the difference between the total units of each subject and the average total units for Mathematics subjects in 2022. Do not return any rounded answers.\", \"category\": \"Course Catalog and Department Analysis\", \"sql\": \"WITH inner_cte AS ( SELECT c.SUBJECT_TITLE, d.DEPARTMENT_NAME, c.TOTAL_UNITS FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT_CODE = d.DEPARTMENT_CODE WHERE c.ACADEMIC_YEAR = 2022 AND c.IS_PRINTED_IN_BULLETIN = 'Y' AND c.DEPARTMENT_CODE = '18' AND d.DEPARTMENT_NAME = 'Mathematics' ) , avg_units AS ( SELECT AVG(TOTAL_UNITS) AS avg_total_units FROM inner_cte ) SELECT i.SUBJECT_TITLE, i.DEPARTMENT_NAME, i.TOTAL_UNITS, (i.TOTAL_UNITS - a.avg_total_units) AS deviation_from_avg_units FROM inner_cte i CROSS JOIN avg_units a;\", \"default_granularity\": \"one row per bulletin-printed Mathematics subject offered in 2022\"}], \"not_found\": []}"
