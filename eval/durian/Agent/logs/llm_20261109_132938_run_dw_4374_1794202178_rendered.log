      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per department per course number\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\", \"id\": \"dw_4683\", \"name\": \"Current Term Department Enrollments with Library Course Counts and Min Units\", \"sql\": \"WITH inner_cte AS ( SELECT de.DEPARTMENT_NAME, de.total_enrollments, lss.COURSE_NUMBER, lss.subject_count, lss.min_total_units FROM ( SELECT s.DEPARTMENT_NAME, SUM(s.SUBJECT_ENROLLMENT_NUMBER) AS total_enrollments FROM ACADEMIC_TERM_PARAMETER p JOIN ACADEMIC_TERMS t ON p.TERM_CODE = t.TERM_CODE JOIN SUBJECT_SUMMARY s ON t.TERM_CODE = s.TERM_CODE WHERE p.IS_CURRENT_TERM = 'Y' GROUP BY s.DEPARTMENT_NAME HAVING SUM(s.SUBJECT_ENROLLMENT_NUMBER) > 10 ) de JOIN ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, COUNT(DISTINCT l.LIBRARY_SUBJECT_OFFERED_KEY) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 GROUP BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ) lss ON de.DEPARTMENT_NAME = lss.OFFER_DEPT_NAME ) SELECT ic.DEPARTMENT_NAME, ic.total_enrollments, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sos.RESPONSIBLE_FACULTY_NAME FROM inner_cte ic JOIN LIBRARY_SUBJECT_OFFERED lso ON ic.DEPARTMENT_NAME = lso.OFFER_DEPT_NAME AND ic.COURSE_NUMBER = lso.COURSE_NUMBER JOIN SUBJECT_OFFERED_SUMMARY sos ON lso.SUBJECT_ID = sos.SUBJECT_ID WHERE sos.NUM_ENROLLED_STUDENTS > 2 GROUP BY ic.DEPARTMENT_NAME, ic.total_enrollments, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sos.RESPONSIBLE_FACULTY_NAME;\"}, {\"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per top reserved subject\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', display each subject title, the offering department name, the count of reserved materials, the academic year, the department name, the average of the total units, and the variance of the total units for subjects offered in regular terms, with the columns shown in that order. Do not return any rounded answers.\", \"id\": \"dw_3664\", \"name\": \"Top 10 Reserved-Material Subjects in 2009SP with Regular-Term Unit Average and Variance\", \"sql\": \"WITH avg_var_units AS ( SELECT c.ACADEMIC_YEAR, c.DEPARTMENT_NAME, AVG(c.TOTAL_UNITS) AS avg_total_units, VARIANCE(c.TOTAL_UNITS) AS var_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS t ON c.TERM_CODE = t.TERM_CODE WHERE t.IS_REGULAR_TERM = 'Y' GROUP BY c.ACADEMIC_YEAR, c.DEPARTMENT_NAME ORDER BY var_total_units DESC ), top_reserved_subjects AS ( SELECT s.SUBJECT_TITLE, s.OFFER_DEPT_NAME, COUNT(l.LIBRARY_RESERVE_CATALOG_KEY) AS reserved_materials FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE l.TERM_CODE = '2009SP' GROUP BY s.SUBJECT_TITLE, s.OFFER_DEPT_NAME ORDER BY reserved_materials DESC LIMIT 10 ) SELECT trs.SUBJECT_TITLE, trs.OFFER_DEPT_NAME, trs.reserved_materials, avu.ACADEMIC_YEAR, avu.DEPARTMENT_NAME, avu.avg_total_units, avu.var_total_units FROM top_reserved_subjects trs LEFT JOIN avg_var_units avu ON trs.OFFER_DEPT_NAME = avu.DEPARTMENT_NAME ORDER BY trs.reserved_materials DESC, avu.var_total_units DESC;\"}, {\"id\": \"dw_4812\", \"name\": \"Top 10 Degree-Granting Department Subject Code and Course Number Combinations by Unique Library Subject Count\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH DeptSubjectStats AS ( SELECT d.DEPARTMENT_NAME, s.SUBJECT_CODE, COUNT(s.SUBJECT_CODE) AS subject_code_count, MIN(d.DEPT_BUDGET_CODE) AS min_dept_budget_code FROM SIS_DEPARTMENT d JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' GROUP BY d.DEPARTMENT_NAME, s.SUBJECT_CODE ), DeptCourseStats AS ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, COUNT(DISTINCT l.LIBRARY_SUBJECT_OFFERED_KEY) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 GROUP BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ) SELECT dss.DEPARTMENT_NAME, dss.SUBJECT_CODE, dss.subject_code_count, dss.min_dept_budget_code, dcs.COURSE_NUMBER, dcs.subject_count, dcs.min_total_units FROM DeptSubjectStats dss JOIN SIS_SUBJECT_CODE ssc ON dss.SUBJECT_CODE = ssc.SUBJECT_CODE JOIN DeptCourseStats dcs ON dss.DEPARTMENT_NAME = dcs.OFFER_DEPT_NAME AND ssc.COURSE_NUMBER = dcs.COURSE_NUMBER ), SubjectMaxEnroll AS ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, ROW_NUMBER() OVER (PARTITION BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ORDER BY s.NUM_ENROLLED_STUDENTS DESC) AS rn FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 ) SELECT ic.DEPARTMENT_NAME, ic.SUBJECT_CODE, ic.subject_code_count, ic.min_dept_budget_code, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sme.SUBJECT_TITLE AS Top_Subject_Title, sme.NUM_ENROLLED_STUDENTS AS Top_Subject_Enrollment FROM inner_cte ic LEFT JOIN SubjectMaxEnroll sme ON ic.DEPARTMENT_NAME = sme.OFFER_DEPT_NAME AND ic.COURSE_NUMBER = sme.COURSE_NUMBER AND sme.rn = 1 ORDER BY ic.subject_count DESC LIMIT 10;\", \"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per top-10 department/subject-code/course-number combination with its highest-enrollment subject\"}, {\"id\": \"dw_1221\", \"name\": \"2014FA Chemistry Library Subjects Windowed Enrollment with Department Reserve Enrollment Average and Normalized Ratio\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, and the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, as well as the average and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in courses with at least one reserved library material and a material status of 'U' offered by either the Chemistry or Biology department, and calculate the normalized enrollment ratio (the number of enrolled students in the library subject divided by the average enrollment for the department, rounded to two decimal places). List the results in descending order of normalized enrollment ratio.\", \"sql\": \"WITH Subquery1 AS ( SELECT l.SUBJECT_TITLE, l.NUM_ENROLLED_STUDENTS, t.RESPONSIBLE_FACULTY_NAME, t.OFFER_DEPT_NAME, MIN(l.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t.RESPONSIBLE_FACULTY_MIT_ID ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t.RESPONSIBLE_FACULTY_MIT_ID FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_SUBJECT_OFFERED t ON l.TERM_CODE = t.TERM_CODE WHERE l.TERM_CODE = '2014FA' AND t.OFFER_DEPT_NAME = 'Chemistry' ), Subquery2 AS ( SELECT t.OFFER_DEPT_NAME, AVG(t.NUM_ENROLLED_STUDENTS) AS avg_enrollment, STDDEV(t.NUM_ENROLLED_STUDENTS) AS enrollment_stddev FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_SUBJECT_OFFERED t ON l.TERM_CODE = t.TERM_CODE WHERE l.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND t.OFFER_DEPT_NAME IN ('Chemistry', 'Biology') GROUP BY t.OFFER_DEPT_NAME ORDER BY enrollment_stddev DESC ) SELECT s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.RESPONSIBLE_FACULTY_NAME, s1.OFFER_DEPT_NAME, s1.window_column, s2.avg_enrollment, s2.enrollment_stddev, ROUND(s1.NUM_ENROLLED_STUDENTS / NULLIF(s2.avg_enrollment, 0), 2) AS normalized_enrollment_ratio FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME ORDER BY normalized_enrollment_ratio DESC;\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2014FA Chemistry library subject offering matched with department-level reserve enrollment statistics\"}], \"not_found\": []}"
    },
