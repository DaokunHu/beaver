      "content": "{\"ok\": true, \"entities\": [{\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}, {\"id\": \"ACADEMIC_TERMS_ALL\", \"name\": \"ACADEMIC_TERMS_ALL\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2019FA'\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to; used to partition running sums by financial aid year\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term (all terms)\"}, {\"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"columns\": {\"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject summary record\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, COURSE_CATALOG_SUBJECT_OFFERED subject IDs\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SUBJECT_OR_CLUSTER\": {\"desc\": \"Indicator whether the row represents a subject or a cluster\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"ULT_MASTER_SUBJECT_ID\": {\"desc\": \"Ultimate master subject identifier in cluster hierarchies\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics'\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name, e.g. 'Engineering'\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREP_UNITS\": {\"desc\": \"Preparation credit units (named PREP_UNITS here vs PREPARATION_UNITS in other tables)\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the subject\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the cluster\"}, \"SUBJECT_GROUP_ID\": {\"desc\": \"Subject group identifier used for grouping related subjects\"}, \"SUBJECT_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Subject enrollment in the first week\"}, \"CLUSTER_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Cluster enrollment in the first week\"}, \"SUBJECT_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Subject enrollment in the fifth week\"}, \"CLUSTER_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Cluster enrollment in the fifth week\"}, \"SUBJECT_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the subject for credit\"}, \"SUBJECT_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the subject\"}, \"CLUSTER_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the cluster for credit\"}, \"CLUSTER_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the cluster\"}, \"SUBJECT_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the cluster\"}, \"SUBJECT_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}, {\"id\": \"SIS_ADMIN_DEPARTMENT\", \"name\": \"SIS_ADMIN_DEPARTMENT\", \"desc\": \"SIS administrative department table with administrative department code/name, phone area code and phone number, and clearing cost collector. Joins to SIS_DEPARTMENT via SIS_ADMIN_DEPARTMENT_CODE = DEPARTMENT_CODE for department contact information.\", \"columns\": {\"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"SIS_ADMIN_DEPARTMENT_CODE\": {\"desc\": \"Administrative department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"SIS_ADMIN_DEPARTMENT_NAME\": {\"desc\": \"Administrative department name\"}, \"DEPARTMENT_PHONE_AREA_CODE\": {\"desc\": \"Area code of the department phone number\"}, \"DEPARTMENT_PHONE_NUMBER\": {\"desc\": \"Phone number of the administrative department\"}, \"CLEARING_COST_COLLECTOR\": {\"desc\": \"Clearing cost collector of the administrative department\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}}, \"default_granularity\": \"one row per administrative department\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_e5b3e13c7f744c9b94e95abd",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per academic year per department per graduate level\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\", \"entity_type_note\": \"\", \"id\": \"dw_1393\", \"name\": \"Math Current-Term Unit Dispersion with Degree-Granting Department Course Counts\", \"sql\": \"WITH inner_cte1 AS ( SELECT ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, SUBJECT_SUMMARY.TOTAL_UNITS, SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER FROM COURSE_CATALOG_SUBJECT_OFFERED JOIN ACADEMIC_TERMS_ALL ON COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE = ACADEMIC_TERMS_ALL.TERM_CODE JOIN SUBJECT_SUMMARY ON ACADEMIC_TERMS_ALL.TERM_CODE = SUBJECT_SUMMARY.TERM_CODE WHERE ACADEMIC_TERMS_ALL.IS_CURRENT_TERM = 'Y' AND SUBJECT_SUMMARY.TOTAL_UNITS > 0 AND COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME = 'Mathematics' ), avg_enrollment AS ( SELECT ACADEMIC_YEAR, DEPARTMENT_NAME, AVG(SUBJECT_ENROLLMENT_NUMBER) AS avg_enrollment FROM inner_cte1 GROUP BY ACADEMIC_YEAR, DEPARTMENT_NAME ), math_units_stats AS ( SELECT i.ACADEMIC_YEAR, i.DEPARTMENT_NAME, VARIANCE(i.TOTAL_UNITS) AS total_units_variance, STDDEV(i.TOTAL_UNITS) AS total_units_stddev FROM inner_cte1 i JOIN avg_enrollment a ON i.ACADEMIC_YEAR = a.ACADEMIC_YEAR AND i.DEPARTMENT_NAME = a.DEPARTMENT_NAME WHERE i.SUBJECT_ENROLLMENT_NUMBER > a.avg_enrollment GROUP BY i.ACADEMIC_YEAR, i.DEPARTMENT_NAME ), inner_cte2 AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, ad.SIS_ADMIN_DEPARTMENT_NAME, COUNT(DISTINCT c.COURSE) AS num_distinct_courses FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT ad ON d.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND UPPER(ad.SIS_ADMIN_DEPARTMENT_NAME) <> 'MANAGEMENT' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, ad.SIS_ADMIN_DEPARTMENT_NAME ), dept_courses AS ( SELECT ic.DEPARTMENT_CODE, ic.DEPARTMENT_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, scd.GRADUATE_LEVEL, ic.num_distinct_courses FROM inner_cte2 ic JOIN SIS_COURSE_DESCRIPTION scd ON ic.DEPARTMENT_CODE = scd.DEPARTMENT GROUP BY ic.DEPARTMENT_CODE, ic.DEPARTMENT_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, scd.GRADUATE_LEVEL, ic.num_distinct_courses ) SELECT mus.ACADEMIC_YEAR, mus.DEPARTMENT_NAME, mus.total_units_variance, mus.total_units_stddev, dc.DEPARTMENT_CODE, dc.SIS_ADMIN_DEPARTMENT_NAME, dc.GRADUATE_LEVEL, dc.num_distinct_courses FROM math_units_stats mus JOIN SIS_DEPARTMENT sd ON mus.DEPARTMENT_NAME = sd.DEPARTMENT_NAME JOIN dept_courses dc ON sd.DEPARTMENT_CODE = dc.DEPARTMENT_CODE ORDER BY mus.total_units_variance DESC, dc.DEPARTMENT_CODE, dc.GRADUATE_LEVEL;\"}, {\"id\": \"dw_2224\", \"name\": \"Math Subject Code School Budget Code Windows with Non-Math Admin Department Clearing Cost Statistics\", \"desc\": \"For each subject code where the department is degree granting and the department is Mathematics, and for each department that is degree granting and is not the Mathematics department (Course 18), show the subject code, subject code description, mathematics department name, school name, the average department budget code within each school, the administrative department name, the average clearing cost collector, the variance of the clearing cost collector, the standard deviation (using STDDEV only and never STDDEV_POP) of the clearing cost collector, and the most recent activity date for the administrative department. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT scm.SUBJECT_CODE, scm.SUBJECT_CODE_DESC, scm.DEPARTMENT_NAME AS mathematics_department_name, scm.SCHOOL_NAME, scm.avg_dept_budget_code, ads.DEPARTMENT_NAME AS admin_department_name, ads.avg_clearing_cost_collector, ads.clearing_cost_collector_variance, ads.clearing_cost_collector_stddev FROM ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME, AVG(t0.DEPT_BUDGET_CODE) OVER (PARTITION BY t1.SCHOOL_NAME ORDER BY t0.DEPARTMENT_NAME) AS avg_dept_budget_code FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' AND t0.DEPARTMENT_NAME = 'Mathematics' ORDER BY t0.DEPARTMENT_NAME ) scm CROSS JOIN ( SELECT d.DEPARTMENT_NAME, AVG(a.CLEARING_COST_COLLECTOR) AS avg_clearing_cost_collector, VARIANCE(a.CLEARING_COST_COLLECTOR) AS clearing_cost_collector_variance, STDDEV(a.CLEARING_COST_COLLECTOR) AS clearing_cost_collector_stddev, MAX(a.LAST_ACTIVITY_DATE) AS most_recent_activity_date FROM SIS_DEPARTMENT d JOIN SIS_ADMIN_DEPARTMENT a ON d.DEPARTMENT_CODE = a.SIS_ADMIN_DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_NAME != 'Mathematics' AND d.DEPARTMENT_CODE != '18' GROUP BY d.DEPARTMENT_NAME ORDER BY clearing_cost_collector_variance DESC ) ads ) SELECT inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.mathematics_department_name, inner_cte.SCHOOL_NAME, inner_cte.avg_dept_budget_code, inner_cte.admin_department_name, inner_cte.avg_clearing_cost_collector, inner_cte.clearing_cost_collector_variance, inner_cte.clearing_cost_collector_stddev, ads2.most_recent_activity_date FROM inner_cte JOIN ( SELECT d.DEPARTMENT_NAME, MAX(a.LAST_ACTIVITY_DATE) AS most_recent_activity_date FROM SIS_DEPARTMENT d JOIN SIS_ADMIN_DEPARTMENT a ON d.DEPARTMENT_CODE = a.SIS_ADMIN_DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_NAME != 'Mathematics' AND d.DEPARTMENT_CODE != '18' GROUP BY d.DEPARTMENT_NAME ) ads2 ON inner_cte.admin_department_name = ads2.DEPARTMENT_NAME;\", \"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per Mathematics subject code crossed with each non-Mathematics degree-granting administrative department\"}, {\"id\": \"dw_1023\", \"name\": \"Math Fall Non-Variable Unit Statistics by Academic Year with Enrollment Filter\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"desc\": \"For each academic year where the Mathematics department has at least one unique subject with subject enrollment number greater than 10, what are the academic year, academic year description, department name, number of unique subjects, minimum total units offered, variance of total units, and standard deviation (using STDDEV only and never STDDEV_POP) of total units for subjects offered in the fall term that are not variable units and are offered by the Mathematics department? Do not return any rounded answers.\", \"sql\": \"WITH AcademicYearStats AS ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, VARIANCE(ccso.TOTAL_UNITS) AS variance_total_units, STDDEV(ccso.TOTAL_UNITS) AS stddev_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED ccso JOIN ACADEMIC_TERMS at ON ccso.TERM_CODE = at.TERM_CODE WHERE ccso.IS_OFFERED_FALL_TERM = 'Y' AND ccso.IS_VARIABLE_UNITS = 'N' AND ccso.DEPARTMENT_NAME = 'Mathematics' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ORDER BY at.ACADEMIC_YEAR ), DepartmentYearStats AS ( SELECT cso.DEPARTMENT_NAME, at.ACADEMIC_YEAR, COUNT(DISTINCT ss.SUBJECT_ID) AS num_unique_subjects, MIN(ss.TOTAL_UNITS) AS min_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED cso JOIN ACADEMIC_TERMS at ON cso.EFFECTIVE_TERM_CODE = at.TERM_CODE JOIN SUBJECT_SUMMARY ss ON at.TERM_CODE = ss.TERM_CODE AND cso.DEPARTMENT_NAME = ss.DEPARTMENT_NAME WHERE cso.DEPARTMENT_NAME = 'Mathematics' AND ss.SUBJECT_ENROLLMENT_NUMBER > 10 GROUP BY cso.DEPARTMENT_NAME, at.ACADEMIC_YEAR ) SELECT ays.ACADEMIC_YEAR, ays.ACADEMIC_YEAR_DESC, dys.DEPARTMENT_NAME, dys.num_unique_subjects, dys.min_total_units, ays.variance_total_units, ays.stddev_total_units FROM AcademicYearStats ays JOIN DepartmentYearStats dys ON ays.ACADEMIC_YEAR = dys.ACADEMIC_YEAR WHERE dys.num_unique_subjects > 0 ORDER BY ays.ACADEMIC_YEAR;\", \"default_granularity\": \"one row per academic year\"}, {\"id\": \"dw_41\", \"name\": \"Yearly Average and Variance of Math Full-Term Subject Total Units in Previous Terms\", \"desc\": \"For each academic year, provide the academic year description and calculate the average and variance of the total units for subjects offered in terms that are not the current term, have a term status indicator of 'P', are offered by the Mathematics department, and are full term subjects. Do not return any rounded answers.\", \"category\": \"Subject Offering Analysis\", \"sql\": \"WITH inner_cte AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, AVG(ccso.TOTAL_UNITS) AS avg_total_units, VARIANCE(ccso.TOTAL_UNITS) AS total_units_variance FROM ACADEMIC_TERMS_ALL ata JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE ata.IS_CURRENT_TERM = 'N' AND ata.TERM_STATUS_INDICATOR = 'P' AND ccso.DEPARTMENT_NAME = 'Mathematics' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC ) SELECT ic.ACADEMIC_YEAR, ic.ACADEMIC_YEAR_DESC, ic.avg_total_units, ic.total_units_variance FROM inner_cte ic JOIN ACADEMIC_TERMS_ALL ata ON ic.ACADEMIC_YEAR = ata.ACADEMIC_YEAR JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE ccso.TERM_DURATION = 'Full Term Subject' GROUP BY ic.ACADEMIC_YEAR, ic.ACADEMIC_YEAR_DESC, ic.avg_total_units, ic.total_units_variance ORDER BY ic.total_units_variance DESC;\", \"default_granularity\": \"one row per academic year\"}], \"not_found\": []}"
    },
