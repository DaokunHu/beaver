          "function": {
            "name": "mysql_query",
            "arguments": "{\"sql\": \"WITH engineering_dept_enrollment AS (\\n  WITH inner_cte AS (\\n    SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment\\n    FROM SIS_DEPARTMENT s\\n    JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE\\n    JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE\\n    WHERE s.SCHOOL_NAME = 'Engineering'\\n    GROUP BY s.DEPARTMENT_NAME\\n    HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50\\n  )\\n  SELECT i.DEPARTMENT_NAME, i.total_enrollment\\n  FROM inner_cte i\\n  JOIN (\\n    SELECT AVG(total_enrollment) AS avg_enrollment FROM (\\n      SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment\\n      FROM SIS_DEPARTMENT s\\n      JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE\\n      JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE\\n      WHERE s.SCHOOL_NAME = 'Engineering'\\n      GROUP BY s.DEPARTMENT_NAME\\n      HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50\\n    ) sub\\n  ) a ON i.total_enrollment > a.avg_enrollment\\n),\\nlibrary_reserve_materials AS (\\n  WITH inner_cte AS (\\n    SELECT l.LIBRARY_COURSE_INSTRUCTOR_KEY, l.LIBRARY_RESERVE_CATALOG_KEY, l.TERM_CODE, l.SUBJECT_ID,\\n           t.TIP_MATERIAL_KEY, t.TIP_MATERIAL_STATUS_KEY, t.ISBN, s.SUBJECT_TITLE,\\n           MIN(t.TIP_MATERIAL_STATUS_KEY) OVER (ORDER BY s.NUM_ENROLLED_STUDENTS ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column,\\n           s.TIP_SUBJECT_OFFERED_KEY\\n    FROM LIBRARY_RESERVE_MATRL_DETAIL l\\n    JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID\\n    JOIN TIP_SUBJECT_OFFERED s ON t.SUBJECT_ID = s.SUBJECT_ID\\n    WHERE l.LIBRARY_MATERIAL_STATUS_KEY = 'U'\\n  )\\n  SELECT inner_cte.LIBRARY_COURSE_INSTRUCTOR_KEY, inner_cte.LIBRARY_RESERVE_CATALOG_KEY, inner_cte.TERM_CODE,\\n         inner_cte.SUBJECT_ID, inner_cte.TIP_MATERIAL_KEY, inner_cte.TIP_MATERIAL_STATUS_KEY, inner_cte.ISBN,\\n         inner_cte.SUBJECT_TITLE, inner_cte.window_column, s.RESPONSIBLE_FACULTY_NAME, s.OFFER_DEPT_NAME, s.OFFER_DEPT_CODE\\n  FROM inner_cte\\n  JOIN TIP_SUBJECT_OFFERED s ON inner_cte.TIP_SUBJECT_OFFERED_KEY = s.TIP_SUBJECT_OFFERED_KEY\\n)\\nSELECT ede.DEPARTMENT_NAME, ede.total_enrollment,\\n       lrm.LIBRARY_COURSE_INSTRUCTOR_KEY, lrm.LIBRARY_RESERVE_CATALOG_KEY, lrm.TERM_CODE, lrm.SUBJECT_ID,\\n       lrm.TIP_MATERIAL_KEY, lrm.TIP_MATERIAL_STATUS_KEY, lrm.ISBN, lrm.SUBJECT_TITLE, lrm.window_column,\\n       lrm.RESPONSIBLE_FACULTY_NAME, lrm.OFFER_DEPT_NAME\\nFROM engineering_dept_enrollment ede\\nJOIN library_reserve_materials lrm ON ede.DEPARTMENT_NAME = lrm.OFFER_DEPT_NAME\\nLIMIT 20\"}"
          }
        }
      ]
