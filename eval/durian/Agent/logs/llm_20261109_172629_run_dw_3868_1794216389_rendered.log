    {
      "role": "tool",
      "tool_call_id": "call_41db989f1dbb4a0da896215f",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per status-U reserve material of an above-average-enrollment Engineering department\", \"desc\": \"For each department in the School of Engineering where the total number of students enrolled in courses offered by that department is greater than the average total enrollment across all Engineering departments (and the total enrollment is greater than 50), show the department name and total enrollment, and for each such department, show the library reserve material details with material status key equal to 'U', including the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students, as well as the responsible faculty name and the offer department name, for materials offered by that department. The columns should be: department name, total enrollment, library course instructor key, library reserve catalog key, term code, subject ID, tip material key, tip material status key, tip ISBN, subject title, windowed minimum tip material status key, responsible faculty name, and offer department name. Do not return any rounded answers.\", \"entity_type\": \"metric\", \"id\": \"dw_3868\", \"name\": \"Above-Average Engineering Department Enrollments with Status-U Reserve Material and Textbook Details\", \"sql\": \"WITH engineering_dept_enrollment AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) SELECT i.DEPARTMENT_NAME, i.total_enrollment FROM inner_cte i JOIN ( SELECT AVG(total_enrollment) AS avg_enrollment FROM ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) sub ) a ON i.total_enrollment > a.avg_enrollment ), library_reserve_materials AS ( WITH inner_cte AS ( SELECT l.LIBRARY_COURSE_INSTRUCTOR_KEY, l.LIBRARY_RESERVE_CATALOG_KEY, l.TERM_CODE, l.SUBJECT_ID, t.TIP_MATERIAL_KEY, t.TIP_MATERIAL_STATUS_KEY, t.ISBN, s.SUBJECT_TITLE, MIN(t.TIP_MATERIAL_STATUS_KEY) OVER ( ORDER BY s.NUM_ENROLLED_STUDENTS ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column, s.TIP_SUBJECT_OFFERED_KEY FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN TIP_SUBJECT_OFFERED s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE l.LIBRARY_MATERIAL_STATUS_KEY = 'U' ) SELECT inner_cte.LIBRARY_COURSE_INSTRUCTOR_KEY, inner_cte.LIBRARY_RESERVE_CATALOG_KEY, inner_cte.TERM_CODE, inner_cte.SUBJECT_ID, inner_cte.TIP_MATERIAL_KEY, inner_cte.TIP_MATERIAL_STATUS_KEY, inner_cte.ISBN, inner_cte.SUBJECT_TITLE, inner_cte.window_column, s.RESPONSIBLE_FACULTY_NAME, s.OFFER_DEPT_NAME, s.OFFER_DEPT_CODE FROM inner_cte JOIN TIP_SUBJECT_OFFERED s ON inner_cte.TIP_SUBJECT_OFFERED_KEY = s.TIP_SUBJECT_OFFERED_KEY ) SELECT ede.DEPARTMENT_NAME, ede.total_enrollment, lrm.LIBRARY_COURSE_INSTRUCTOR_KEY, lrm.LIBRARY_RESERVE_CATALOG_KEY, lrm.TERM_CODE, lrm.SUBJECT_ID, lrm.TIP_MATERIAL_KEY, lrm.TIP_MATERIAL_STATUS_KEY, lrm.ISBN, lrm.SUBJECT_TITLE, lrm.window_column, lrm.RESPONSIBLE_FACULTY_NAME, lrm.OFFER_DEPT_NAME FROM engineering_dept_enrollment ede JOIN library_reserve_materials lrm ON ede.DEPARTMENT_NAME = lrm.OFFER_DEPT_NAME\"}, {\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per status-U reserve material matched with 2025FA subject\", \"desc\": \"For each library reserve material detail with material status key equal to 'U' and for subjects offered in the term with code '2025FA', show the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title from the subject offered table, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students (only including those where the number of enrolled students is greater than the average across all subjects), the offering department name, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, the offering school name, and the responsible faculty name for each subject. Order the results by offering department and descending number of enrolled students. Do not return any rounded answers.\", \"id\": \"dw_4287\", \"name\": \"Status-U Reserve Materials Above-Average Enrollment Matched with 2025FA Subject Attributes\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT l.LIBRARY_COURSE_INSTRUCTOR_KEY, l.LIBRARY_RESERVE_CATALOG_KEY, l.TERM_CODE, l.SUBJECT_ID, t.TIP_MATERIAL_KEY, t.TIP_MATERIAL_STATUS_KEY, t.ISBN, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, MIN(t.TIP_MATERIAL_STATUS_KEY) OVER ( ORDER BY s.NUM_ENROLLED_STUDENTS ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN TIP_SUBJECT_OFFERED s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE l.LIBRARY_MATERIAL_STATUS_KEY = 'U' ) SELECT LIBRARY_COURSE_INSTRUCTOR_KEY, LIBRARY_RESERVE_CATALOG_KEY, TERM_CODE, SUBJECT_ID, TIP_MATERIAL_KEY, TIP_MATERIAL_STATUS_KEY, ISBN, SUBJECT_TITLE, window_column, NUM_ENROLLED_STUDENTS FROM inner_cte WHERE NUM_ENROLLED_STUDENTS > ( SELECT AVG(NUM_ENROLLED_STUDENTS) FROM TIP_SUBJECT_OFFERED ) ), subq2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TERM_START_DATE, t1.TERM_END_DATE, t2.TERM_PARAMETER, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_students_per_dept, t0.OFFER_SCHOOL_NAME, t0.RESPONSIBLE_FACULTY_NAME FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2025FA' ) SELECT SUBJECT_ID, SUBJECT_TITLE, OFFER_DEPT_NAME, NUM_ENROLLED_STUDENTS, TERM_DESCRIPTION, ACADEMIC_YEAR, TERM_START_DATE, TERM_END_DATE, TERM_PARAMETER, min_enrolled_students_per_dept, OFFER_SCHOOL_NAME, RESPONSIBLE_FACULTY_NAME FROM inner_cte ) SELECT s1.LIBRARY_COURSE_INSTRUCTOR_KEY, s1.LIBRARY_RESERVE_CATALOG_KEY, s1.TERM_CODE, s1.SUBJECT_ID, s1.TIP_MATERIAL_KEY, s1.TIP_MATERIAL_STATUS_KEY, s1.ISBN, s1.SUBJECT_TITLE, s1.window_column, s2.OFFER_DEPT_NAME, s2.TERM_DESCRIPTION, s2.ACADEMIC_YEAR, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.TERM_PARAMETER, s2.min_enrolled_students_per_dept, s2.OFFER_SCHOOL_NAME, s2.RESPONSIBLE_FACULTY_NAME FROM subq1 s1 JOIN subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID ORDER BY s2.OFFER_DEPT_NAME, s1.NUM_ENROLLED_STUDENTS DESC\"}, {\"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering department above average enrollment\", \"desc\": \"For each department in the School of Engineering with total student enrollment in its courses greater than the average total enrollment across all Engineering departments (and with total enrollment greater than 50), display the department name, the total number of students enrolled in its courses, and the highest average total units for subjects it has ever offered in a regular academic term, listing the results in descending order of total enrollment. Do not return any rounded answers.\", \"id\": \"dw_4387\", \"name\": \"Engineering Departments Above-Average Enrollment with Highest Regular-Term Average Units\", \"sql\": \"WITH highest_avg_units AS ( WITH inner_cte AS ( SELECT c.DEPARTMENT_NAME, t.TERM_CODE, AVG(c.TOTAL_UNITS) AS avg_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS t ON c.TERM_CODE = t.TERM_CODE WHERE t.IS_REGULAR_TERM = 'Y' GROUP BY c.DEPARTMENT_NAME, t.TERM_CODE ) SELECT DEPARTMENT_NAME, MAX(avg_total_units) AS highest_avg_total_units FROM inner_cte GROUP BY DEPARTMENT_NAME ORDER BY highest_avg_total_units DESC ), eng_dept_enrollment AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) SELECT i.DEPARTMENT_NAME, i.total_enrollment FROM inner_cte i JOIN ( SELECT AVG(total_enrollment) AS avg_enrollment FROM ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) sub ) a ON i.total_enrollment > a.avg_enrollment ) SELECT e.DEPARTMENT_NAME, e.total_enrollment, h.highest_avg_total_units FROM eng_dept_enrollment e LEFT JOIN highest_avg_units h ON e.DEPARTMENT_NAME = h.DEPARTMENT_NAME ORDER BY e.total_enrollment DESC;\"}, {\"id\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"name\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"desc\": \"Library reserve material detail bridge table linking reserve catalog items, library subject offerings, course instructors, and material status per term. Used to count reserved materials per subject and to filter by library material status (e.g. 'U').\", \"columns\": {\"LIBRARY_COURSE_INSTRUCTOR_KEY\": {\"desc\": \"Foreign key to LIBRARY_COURSE_INSTRUCTOR.LIBRARY_COURSE_INSTRUCTOR_KEY identifying the course instructor\"}, \"LIBRARY_RESERVE_CATALOG_KEY\": {\"desc\": \"Foreign key to LIBRARY_RESERVE_CATALOG.LIBRARY_RESERVE_CATALOG_KEY identifying the reserve catalog item\"}, \"LIBRARY_SUBJECT_OFFERED_KEY\": {\"desc\": \"Foreign key to LIBRARY_SUBJECT_OFFERED.LIBRARY_SUBJECT_OFFERED_KEY identifying the subject offering\"}, \"LIBRARY_MATERIAL_STATUS_KEY\": {\"desc\": \"Library material status key; joins to LIBRARY_MATERIAL_STATUS.LIBRARY_MATERIAL_STATUS_KEY for decoding. Value domain (key = code): 'U' = Unknown, 'R' = (null description), 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material. Distinct from TIP_DETAIL.TIP_MATERIAL_STATUS_KEY, which belongs to the textbook program domain.\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per reserve material per subject offering per term\"}, {\"id\": \"LIBRARY_SUBJECT_OFFERED\", \"name\": \"LIBRARY_SUBJECT_OFFERED\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\", \"columns\": {\"LIBRARY_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the library subject offered record; joins to LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject as used by the library\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_RESERVE_MATRL_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject per library records\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in library reserve scope\"}, {\"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the TIP subject offered record; joins to TIP_DETAIL.TIP_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"IS_NO_COURSE_MATERIAL\": {\"desc\": \"'Y'/'N' flag whether the subject has no course material; 'N' means the subject has course materials\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '5.01'; joins to TIP_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE and STUDENT_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Chemistry', 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject; used for enrollment-based rankings and window statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in the textbook program\"}, {\"id\": \"TIP_DETAIL\", \"name\": \"TIP_DETAIL\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Foreign key to TIP_SUBJECT_OFFERED.TIP_SUBJECT_OFFERED_KEY\"}, \"TIP_MATERIAL_KEY\": {\"desc\": \"Foreign key to TIP_MATERIAL.TIP_MATERIAL_KEY identifying the specific textbook material\"}, \"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB'/blank keys with no description. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_SUBJECT_OFFERED.SUBJECT_ID, LIBRARY_SUBJECT_OFFERED.SUBJECT_ID, SUBJECT_SUMMARY.SUBJECT_ID\"}, \"ISBN\": {\"desc\": \"ISBN of the textbook material associated with the subject offering\"}, \"RECORD_COUNT\": {\"desc\": \"Number of material records for this subject/material combination; used in material-count statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject-material-status combination per term\", \"entity\": {\"columns\": {\"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB' = None variants. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}}}, \"reason\": \"Data verification of TIP_MATERIAL_STATUS shows 12 status values beyond the previously documented 'RQ'/'EO'; enriching the description supports material-status grouping questions such as case dw_2989 (per material status and publisher statistics).\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_c2572e47120e4df3b5cac0d9",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"concept_course_material_programs\", \"name\": \"Course Material and Library Reserve Domain\", \"desc\": \"Tables covering course material provisioning: the Textbook Information Program (TIP) tracking textbook adoption status per subject offering, and library reserve processing tracking catalog items placed on reserve for subjects. They jointly answer questions about which subjects have course materials/textbooks, material status (TIP statuses such as 'RQ' Required, 'EO' Electronic options; library statuses such as 'U' Unknown, 'Y' Required Course Material), ISBNs, record counts, and reserve catalog item attributes. The two programs are linked by SUBJECT_ID + TERM_CODE.\", \"tables\": [\"TIP_SUBJECT_OFFERED\", \"TIP_DETAIL\", \"TIP_MATERIAL\", \"TIP_MATERIAL_STATUS\", \"LIBRARY_SUBJECT_OFFERED\", \"LIBRARY_RESERVE_MATRL_DETAIL\", \"LIBRARY_RESERVE_CATALOG\", \"LIBRARY_MATERIAL_STATUS\", \"LIBRARY_COURSE_INSTRUCTOR\"], \"comparisons\": [{\"dimension\": \"Business process\", \"TIP_SUBJECT_OFFERED / TIP_DETAIL / TIP_MATERIAL / TIP_MATERIAL_STATUS\": \"Textbook program: subjects tracked for textbook adoption, material rows with status and ISBN, material bibliographic details, status decoding\", \"LIBRARY_SUBJECT_OFFERED / LIBRARY_RESERVE_MATRL_DETAIL / LIBRARY_RESERVE_CATALOG / LIBRARY_MATERIAL_STATUS / LIBRARY_COURSE_INSTRUCTOR\": \"Library reserve: subjects in reserve processing, reserve material detail rows, catalog item bibliographic records, status decoding, instructor assignments\"}, {\"dimension\": \"Status semantics\", \"TIP_MATERIAL_STATUS_KEY\": \"12 statuses decoded by TIP_MATERIAL_STATUS: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, plus NULL-description keys 'NL'/'NS'/'NB'/blank\", \"LIBRARY_MATERIAL_STATUS_KEY\": \"6 statuses decoded by LIBRARY_MATERIAL_STATUS: 'U' = Unknown, 'R' = NULL description, 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material\"}, {\"dimension\": \"Count measures\", \"TIP_DETAIL\": \"COUNT(TIP_MATERIAL_KEY) or RECORD_COUNT for material-count statistics per status/subject\", \"LIBRARY_RESERVE_MATRL_DETAIL\": \"COUNT(LIBRARY_RESERVE_CATALOG_KEY) for reserve catalog item counts per status/subject; LIBRARY_RESERVE_CATALOG.RECORD_COUNTER is a catalog record counter\"}, {\"dimension\": \"Parent-child structure\", \"TIP_SUBJECT_OFFERED → TIP_DETAIL\": \"TIP_SUBJECT_OFFERED_KEY / SUBJECT_ID links subject rows to material rows\", \"LIBRARY_SUBJECT_OFFERED → LIBRARY_RESERVE_MATRL_DETAIL → LIBRARY_RESERVE_CATALOG\": \"LIBRARY_SUBJECT_OFFERED_KEY and LIBRARY_RESERVE_CATALOG_KEY chain subjects to reserve items\"}], \"decision_guide\": {\"Questions about required/optional textbooks, ISBNs, or whether subjects have course materials\": \"Use TIP_SUBJECT_OFFERED (IS_NO_COURSE_MATERIAL flag) with TIP_DETAIL (TIP_MATERIAL_STATUS_KEY 'RQ'/'EO').\", \"Questions about library reserve items, reserve counts per subject, or catalog titles/authors\": \"Use LIBRARY_RESERVE_MATRL_DETAIL joined to LIBRARY_RESERVE_CATALOG, scoped by LIBRARY_SUBJECT_OFFERED.\", \"Questions about enrollment of subjects within the textbook program or library reserve scope\": \"Use TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS or LIBRARY_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS respectively; these are program-specific snapshots, not the official SUBJECT_SUMMARY enrollment.\", \"Questions about textbook prices, editions, or publishers\": \"Use TIP_MATERIAL via TIP_DETAIL.TIP_MATERIAL_KEY.\", \"Questions about instructors of courses with reserve materials\": \"Use LIBRARY_COURSE_INSTRUCTOR via LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_COURSE_INSTRUCTOR_KEY.\", \"Questions about required textbooks, ISBNs, or whether subjects have course materials\": \"Use TIP_SUBJECT_OFFERED (IS_NO_COURSE_MATERIAL flag) with TIP_DETAIL (TIP_MATERIAL_STATUS_KEY, e.g. 'RQ' Required).\", \"Questions combining textbook material statuses with library reserve statuses\": \"Join TIP_DETAIL and LIBRARY_RESERVE_MATRL_DETAIL on SUBJECT_ID + TERM_CODE, decode each status via its own lookup table, and aggregate each side separately; never equate the two status key columns.\"}}, {\"id\": \"concept_subject_offering_facts\", \"name\": \"Subject Offering Fact Tables\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\", \"tables\": [\"COURSE_CATALOG_SUBJECT_OFFERED\", \"SUBJECT_OFFERED\", \"SUBJECT_OFFERED_SUMMARY\", \"SUBJECT_SUMMARY\", \"TIP_SUBJECT_OFFERED\", \"LIBRARY_SUBJECT_OFFERED\"], \"comparisons\": [{\"dimension\": \"Granularity\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Subject offering per term/academic year (catalog record, includes section flags)\", \"SUBJECT_OFFERED\": \"Subject section per term (finest grain, SECTION_ID)\", \"SUBJECT_OFFERED_SUMMARY\": \"Subject per term (rollup of sections)\", \"SUBJECT_SUMMARY\": \"Subject or cluster per term\", \"TIP_SUBJECT_OFFERED\": \"Subject per term within textbook program scope\", \"LIBRARY_SUBJECT_OFFERED\": \"Subject per term within library reserve scope\"}, {\"dimension\": \"Enrollment measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"None (catalog attributes only)\", \"SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, SECTION_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_OFFERED_SUMMARY\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_SUMMARY\": \"SUBJECT_ENROLLMENT_NUMBER plus first-week/fifth-week and credit/listener enrollment splits\", \"TIP_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\", \"LIBRARY_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\"}, {\"dimension\": \"Unit measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS, DESIGN_UNITS, TOTAL_UNITS, IS_VARIABLE_UNITS\", \"SUBJECT_OFFERED\": \"None\", \"SUBJECT_OFFERED_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS\", \"SUBJECT_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREP_UNITS, DESIGN_UNITS\", \"TIP_SUBJECT_OFFERED\": \"None\", \"LIBRARY_SUBJECT_OFFERED\": \"None\"}, {\"dimension\": \"Distinctive attributes\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"HGN_DESC level, GRADE_TYPE/GRADE_RULE, HASS/GIR attributes, IS_OFFERED_* flags, MEET_PLACE (room key), ACADEMIC_YEAR, EFFECTIVE_TERM_CODE\", \"SUBJECT_OFFERED\": \"IS_REPEATABLE_SUBJECT, CLUSTER_TYPE, section flags, FORM_TYPE, EVALUATE_THIS_SUBJECT\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_SCHOOL_NAME, COURSE_NUMBER, cluster info at subject level\", \"SUBJECT_SUMMARY\": \"SCHOOL_CODE/SCHOOL_NAME, SUBJECT_GROUP_ID, SUBJECT_OR_CLUSTER, detailed weekly enrollment\", \"TIP_SUBJECT_OFFERED\": \"IS_NO_COURSE_MATERIAL flag; parent of TIP_DETAIL materials\", \"LIBRARY_SUBJECT_OFFERED\": \"COURSE_NUMBER/COURSE_NUMBER_DESC; parent of LIBRARY_RESERVE_MATRL_DETAIL\"}, {\"dimension\": \"Department column naming\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_SUMMARY\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"TIP_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\"}], \"decision_guide\": {\"Questions about credit units, grading type/rules, HGN level (undergraduate/graduate), HASS/GIR attributes, or term offering flags (fall/spring/IAP/summer)\": \"Use COURSE_CATALOG_SUBJECT_OFFERED; it is the only offering table carrying full catalog attributes.\", \"Questions about actual section-level offerings, repeatability, cluster type, or section flags\": \"Use SUBJECT_OFFERED (section grain); roll up via SUBJECT_OFFERED_SUMMARY when subject-level totals are needed.\", \"Questions about final enrollment statistics, weekly enrollment snapshots, credit vs listener counts, subject groups, or school-level unit statistics\": \"Use SUBJECT_SUMMARY.\", \"Questions about textbooks/course materials per subject (required/optional status, ISBN, record counts)\": \"Start from TIP_SUBJECT_OFFERED (subject scope, IS_NO_COURSE_MATERIAL) joined to TIP_DETAIL (material rows).\", \"Questions about library reserve materials, reserve counts per subject, or library course numbers\": \"Start from LIBRARY_SUBJECT_OFFERED joined to LIBRARY_RESERVE_MATRL_DETAIL.\", \"Questions about subject-level units with offering department/school (e.g. Engineering school enrollment totals by department)\": \"Use SUBJECT_OFFERED_SUMMARY, which carries both TOTAL_UNITS and OFFER_SCHOOL_NAME.\"}}, {\"id\": \"concept_department_dimension\", \"name\": \"Department and School Dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\", \"tables\": [\"SIS_DEPARTMENT\", \"STUDENT_DEPARTMENT\", \"SIS_ADMIN_DEPARTMENT\"], \"comparisons\": [{\"dimension\": \"Attribute coverage\", \"SIS_DEPARTMENT\": \"Richest: DEPARTMENT_FULL_NAME, SCHOOL_CODE/SCHOOL_NAME, DEPT_BUDGET_CODE, IS_DEGREE_GRANTING, commencement-book names, DLC key\", \"STUDENT_DEPARTMENT\": \"Minimal: code, name, full name, school code/name only\", \"SIS_ADMIN_DEPARTMENT\": \"Administrative contact: department phone area code/number, clearing cost collector\"}, {\"dimension\": \"Degree-granting and school filtering\", \"SIS_DEPARTMENT\": \"Supports IS_DEGREE_GRANTING and SCHOOL_NAME filters directly\", \"STUDENT_DEPARTMENT\": \"Only school code/name attribution, no degree-granting flag\", \"SIS_ADMIN_DEPARTMENT\": \"No school or degree-granting attributes\"}, {\"dimension\": \"Typical join path\", \"SIS_DEPARTMENT\": \"DEPARTMENT_CODE = offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE; also joins SIS_COURSE_DESCRIPTION.DEPARTMENT and SIS_ADMIN_DEPARTMENT.SIS_ADMIN_DEPARTMENT_CODE\", \"STUDENT_DEPARTMENT\": \"DEPARTMENT_CODE = TIP_SUBJECT_OFFERED.OFFER_DEPT_CODE and other offering department codes\", \"SIS_ADMIN_DEPARTMENT\": \"SIS_ADMIN_DEPARTMENT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE\"}, {\"dimension\": \"Budget/finance attributes\", \"SIS_DEPARTMENT\": \"DEPT_BUDGET_CODE available for budget-based ranking\", \"STUDENT_DEPARTMENT\": \"None\", \"SIS_ADMIN_DEPARTMENT\": \"CLEARING_COST_COLLECTOR\"}], \"decision_guide\": {\"Questions filtering departments by school (e.g. 'School of Engineering') or degree-granting status\": \"Use SIS_DEPARTMENT; it carries SCHOOL_NAME and IS_DEGREE_GRANTING.\", \"Questions needing only department full name and school name for offering departments (e.g. TIP subject offerings)\": \"STUDENT_DEPARTMENT suffices and is the lighter lookup; SIS_DEPARTMENT also works.\", \"Questions needing department phone numbers or administrative contact details\": \"Join SIS_ADMIN_DEPARTMENT via SIS_DEPARTMENT.DEPARTMENT_CODE = SIS_ADMIN_DEPARTMENT_CODE.\", \"Questions ranking or grouping departments by budget code\": \"Use SIS_DEPARTMENT.DEPT_BUDGET_CODE.\"}}, {\"columns\": [\"TIP_DETAIL.TIP_MATERIAL_STATUS_KEY\", \"TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY\", \"LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY\", \"LIBRARY_MATERIAL_STATUS.LIBRARY_MATERIAL_STATUS_KEY\"], \"comparisons\": [{\"dimension\": \"Program\", \"detail\": \"TIP_MATERIAL_STATUS_KEY belongs to the textbook program (decoded by TIP_MATERIAL_STATUS); LIBRARY_MATERIAL_STATUS_KEY belongs to library reserve processing (decoded by LIBRARY_MATERIAL_STATUS). The two key domains are independent and must not be joined to each other.\"}, {\"dimension\": \"Value domains\", \"detail\": \"TIP statuses: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, plus 'NL'/'NS'/'NB'/blank keys with NULL descriptions. Library statuses: 'U' = Unknown, 'R' = NULL description, 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material. Both domains contain 'U' but it means 'Unknown' in each program independently.\"}, {\"dimension\": \"Usage pattern\", \"detail\": \"Fact-side filtering uses the key columns on TIP_DETAIL / LIBRARY_RESERVE_MATRL_DETAIL directly; the lookup tables provide human-readable status text when needed. Grouping by the description column instead of the key merges statuses with NULL or identical descriptions.\"}, {\"dimension\": \"Cross-domain equality risk\", \"detail\": \"Some warehouse analyses equate TIP_MATERIAL_STATUS_KEY with LIBRARY_MATERIAL_STATUS_KEY to attach per-status statistics across the two programs. Because the value domains are independent, such an equality only matches on coincidental code overlap (e.g. 'U') and carries semantic risk; results should be interpreted as code-level matching, not as a true business relationship between textbook status and library reserve status.\"}], \"decision_guide\": {\"Questions about required or optional textbooks\": \"Filter TIP_DETAIL.TIP_MATERIAL_STATUS_KEY IN ('RQ','EO'); 'RQ' for required only.\", \"Questions about library reserve material status\": \"Filter/group LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY (e.g. 'U' Unknown, 'Y' Required Course Material); decode text via LIBRARY_MATERIAL_STATUS.\", \"Questions needing status description text rather than codes\": \"Join TIP_MATERIAL_STATUS or LIBRARY_MATERIAL_STATUS on the respective key; note that description columns contain NULLs for some keys.\", \"Matching reserve materials to textbook materials\": \"Match via SUBJECT_ID + TERM_CODE (or TIP_MATERIAL_KEY paths) between TIP_DETAIL and LIBRARY_RESERVE_MATRL_DETAIL, never by equating the two status key columns.\", \"Questions about required textbooks or textbook material statuses\": \"Filter/group TIP_DETAIL.TIP_MATERIAL_STATUS_KEY (e.g. 'RQ' for Required); decode text via TIP_MATERIAL_STATUS.\"}, \"desc\": \"Material status key columns of the textbook program (TIP) and library reserve program. Both are coded status references decoded by their own lookup tables (key value equals code value), with independent value domains: TIP statuses ('RQ' Required, 'EO' Electronic options, 'RC' Recommended, 'PC' Val-u option, 'BR' Bookstore recommends, 'CL' Go to class first, 'NM' Course has no materials, 'U' Unknown, plus NULL-description keys) vs library reserve statuses ('U' Unknown, 'R' null description, 'N' Non-Required Course Material, 'O' Reserve only, 'X' No Required Textbook, 'Y' Required Course Material).\", \"id\": \"column_concept_material_status_key\", \"name\": \"Material Status Key\"}, {\"id\": \"column_concept_department_name\", \"name\": \"Department Name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME\", \"SUBJECT_SUMMARY.DEPARTMENT_NAME\", \"SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY.OFFER_DEPT_NAME\", \"TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SIS_DEPARTMENT.DEPARTMENT_NAME\", \"STUDENT_DEPARTMENT.DEPARTMENT_NAME\", \"SIS_COURSE_DESCRIPTION.DEPARTMENT_NAME\", \"SIS_SUBJECT_CODE.DEPARTMENT_NAME\", \"EMPLOYEE_DIRECTORY.DEPARTMENT_NAME\", \"LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT\", \"MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME\", \"SE_PERSON.ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DEPARTMENT_NAME is used by catalog/summary tables (COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY), department/course lookup tables, and the student directory (MIT_STUDENT_DIRECTORY); OFFER_DEPT_NAME is used by offering/program tables (SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY, TIP_SUBJECT_OFFERED, LIBRARY_SUBJECT_OFFERED) and denotes the department that actually offers the subject; LIBRARY_COURSE_INSTRUCTOR uses the plain column name DEPARTMENT for the course's academic department; SE_PERSON uses ORGANIZATION for the person's organizational unit\"}, {\"dimension\": \"Value format\", \"detail\": \"Catalog, summary, offering, student-directory, and lookup tables store plain department names (e.g. 'Mathematics', 'Chemistry', 'Electrical Eng & Computer Sci'); LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT stores a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics', '06 - Electrical Eng & Computer Sci'), with some unprefixed values (e.g. 'Architecture'), so it is not directly comparable to plain-name columns without stripping the prefix\"}, {\"dimension\": \"Academic vs HR/organization value domain\", \"detail\": \"Catalog, summary, offering, library, student-directory, and lookup tables share the academic department domain; EMPLOYEE_DIRECTORY.DEPARTMENT_NAME is the HR organizational unit name and has a different domain (e.g. 'Lincoln Laboratory', 'Department of Physics'), where some values coincide with academic names but many do not, and some carry a 'Department of ...' prefix; SE_PERSON.ORGANIZATION holds organizational unit names that may use different naming variants than the academic domain for the same unit (e.g. 'Electrical Engineering-Computer Science' vs the academic 'Electrical Eng & Computer Sci'), so equality filters across the two conventions must use each table's own variant\"}, {\"dimension\": \"Companion code column\", \"detail\": \"Catalog/summary tables carry DEPARTMENT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE; offering/program tables carry OFFER_DEPT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE or STUDENT_DEPARTMENT.DEPARTMENT_CODE; MIT_STUDENT_DIRECTORY carries DEPARTMENT (the academic department code) joining SIS_DEPARTMENT.DEPARTMENT_CODE, which is the reliable join key instead of the name; LIBRARY_COURSE_INSTRUCTOR has no department code column, only the prefixed name text; EMPLOYEE_DIRECTORY carries DEPARTMENT_NUMBER (HR department number) and SE_PERSON carries no department code, neither joining to SIS_DEPARTMENT.DEPARTMENT_CODE\"}], \"decision_guide\": {\"Filtering subjects by department in catalog or summary analysis\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME or SUBJECT_SUMMARY.DEPARTMENT_NAME.\", \"Filtering by department in section-level, textbook-program, or library analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Joining fact tables to department dimension attributes (school, full name, degree-granting)\": \"Prefer code joins: DEPARTMENT_CODE / OFFER_DEPT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE; name equality joins are used when codes are unavailable.\", \"Matching departments across a DEPARTMENT_NAME table and an OFFER_DEPT_NAME table\": \"The values are directly comparable (same academic name domain), e.g. joining SUBJECT_SUMMARY.DEPARTMENT_NAME to TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME.\", \"Filtering employees by their HR organizational unit (e.g. names containing 'Department', or HR units like 'Political Science')\": \"Use EMPLOYEE_DIRECTORY.DEPARTMENT_NAME; do not join it to SIS_DEPARTMENT.DEPARTMENT_CODE, and pair it with DEPARTMENT_NUMBER for HR grouping.\", \"Filtering by department in section-level, textbook-program, or library subject analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Filtering library reserve course instructors by academic department or library unit\": \"Use LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT with the prefixed value format (e.g. '18 - Mathematics'); do not compare it directly to plain department-name columns.\", \"Filtering students by their academic department\": \"Use MIT_STUDENT_DIRECTORY.DEPARTMENT (code) joined to SIS_DEPARTMENT.DEPARTMENT_CODE for reliable matching, or MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME for direct name filters; the name shares the academic domain with SIS_DEPARTMENT.DEPARTMENT_NAME.\", \"Filtering a person master (SE_PERSON) record by organizational unit such as an academic department\": \"Use SE_PERSON.ORGANIZATION with its own naming variant (e.g. 'Electrical Engineering-Computer Science'); do not equate it directly to MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME or SIS_DEPARTMENT.DEPARTMENT_NAME, which use the academic variant (e.g. 'Electrical Eng & Computer Sci').\"}}, {\"columns\": [\"SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"SUBJECT_OFFERED_SUMMARY.NUM_ENROLLED_STUDENTS\", \"SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER\", \"TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"LIBRARY_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"SUBJECT_OFFERED.SUBJECT_ENROLLMENT_NUMBER\", \"SUBJECT_OFFERED_SUMMARY.SUBJECT_ENROLLMENT_NUMBER\"], \"comparisons\": [{\"dimension\": \"Measure meaning\", \"detail\": \"NUM_ENROLLED_STUDENTS is the headcount of students enrolled (present in SUBJECT_OFFERED at section grain, SUBJECT_OFFERED_SUMMARY at subject grain, and in TIP/LIBRARY program snapshots); SUBJECT_ENROLLMENT_NUMBER is the official subject enrollment number recorded by the registrar (SUBJECT_SUMMARY, SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY)\"}, {\"dimension\": \"Grain\", \"detail\": \"SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS is per section; SUBJECT_OFFERED_SUMMARY.NUM_ENROLLED_STUDENTS is per subject per term; SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER is the final subject-level enrollment with weekly/credit/listener breakdowns available in sibling columns\"}, {\"dimension\": \"Program scope\", \"detail\": \"TIP_SUBJECT_OFFERED and LIBRARY_SUBJECT_OFFERED enrollment values are snapshots within the textbook-program and library-reserve scopes respectively and may not cover all subjects\"}], \"decision_guide\": {\"Questions about official subject enrollment (e.g. 'subject enrollment number greater than 10')\": \"Use SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER.\", \"Questions about number of enrolled students per subject offering or per department totals\": \"Use NUM_ENROLLED_STUDENTS from SUBJECT_OFFERED_SUMMARY (subject grain) or SUBJECT_OFFERED (section grain, needs aggregation).\", \"Questions about enrollment of subjects within the textbook program or library reserve scope\": \"Use TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS or LIBRARY_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS respectively.\", \"Questions needing enrollment timing (first week, fifth week) or credit vs listener splits\": \"Use SUBJECT_SUMMARY's SUBJECT_ENROLLMENT_FIRST_WEEK / FIFTH_WEEK and *_CREDIT / *_LISTEN columns.\"}, \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\", \"id\": \"column_concept_enrollment_measures\", \"name\": \"Enrollment Measures\"}], \"not_found\": []}"
