    {
      "role": "tool",
      "tool_call_id": "call_adafefa26b7243bfa307690a",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per top-10 department subject-code group matched with a Kevin-named Course-6 student course\", \"desc\": \"For the top 10 degree-granting departments (excluding 'Political Science' and Course 17) that have offered at least one subject in the 'Engineering' school, list the department name, school name, subject code description, the total number of subjects they offered, and the average number of enrolled students per subject, and for each such department, show the full names, email addresses, student years, department full names, course descriptions, course levels, the minimum course level in a window of 3 preceding and 1 following row ordered by the student's last name, and the corresponding subject code and subject code description for each course taken by students named 'Kevin' in 'Electrical Eng & Computer Sci' (Course 6). Do not return any rounded answers.\", \"id\": \"dw_1474\", \"name\": \"Top 10 Engineering Degree-Granting Department Subject Counts with Kevin EECS Student Course Windows\", \"sql\": \"WITH TopDepartments AS ( WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, d.SCHOOL_NAME, s.SUBJECT_CODE_DESC, COUNT(sos.SUBJECT_OFFERED_SUMMARY_KEY) AS num_subjects FROM SIS_SUBJECT_CODE s JOIN SIS_DEPARTMENT d ON s.DEPARTMENT_CODE = d.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY sos ON d.DEPARTMENT_CODE = sos.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND sos.OFFER_SCHOOL_NAME = 'Engineering' AND d.DEPARTMENT_NAME <> 'Political Science' AND d.DEPARTMENT_CODE <> '17' GROUP BY d.DEPARTMENT_NAME, d.SCHOOL_NAME, s.SUBJECT_CODE_DESC ) SELECT ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SUBJECT_CODE_DESC, ic.num_subjects, AVG(sos.NUM_ENROLLED_STUDENTS) AS avg_enrollment, d.DEPARTMENT_CODE FROM inner_cte ic JOIN SIS_DEPARTMENT d ON ic.DEPARTMENT_NAME = d.DEPARTMENT_NAME AND ic.SCHOOL_NAME = d.SCHOOL_NAME JOIN SUBJECT_OFFERED_SUMMARY sos ON d.DEPARTMENT_CODE = sos.OFFER_DEPT_CODE GROUP BY ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SUBJECT_CODE_DESC, ic.num_subjects, d.DEPARTMENT_CODE ORDER BY ic.num_subjects DESC LIMIT 10 ), KevinStudents AS ( WITH inner_cte AS ( SELECT t2.FULL_NAME, t2.EMAIL_ADDRESS, t2.STUDENT_YEAR, t1.DEPARTMENT_FULL_NAME, t0.COURSE_DESCRIPTION, t0.COURSE_LEVEL, MIN(t0.COURSE_LEVEL) OVER (ORDER BY t2.LAST_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t0.COURSE, t1.DEPARTMENT_CODE FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT WHERE t2.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' AND t2.FIRST_NAME = 'Kevin' AND t2.DEPARTMENT = '6' ) SELECT inner_cte.FULL_NAME, inner_cte.EMAIL_ADDRESS, inner_cte.STUDENT_YEAR, inner_cte.DEPARTMENT_FULL_NAME, inner_cte.COURSE_DESCRIPTION, inner_cte.COURSE_LEVEL, inner_cte.window_column, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, inner_cte.DEPARTMENT_CODE FROM inner_cte JOIN SIS_SUBJECT_CODE sc ON inner_cte.COURSE = sc.COURSE_NUMBER ) SELECT td.DEPARTMENT_NAME, td.SCHOOL_NAME, td.SUBJECT_CODE_DESC, td.num_subjects, td.avg_enrollment, ks.FULL_NAME, ks.EMAIL_ADDRESS, ks.STUDENT_YEAR, ks.DEPARTMENT_FULL_NAME, ks.COURSE_DESCRIPTION, ks.COURSE_LEVEL, ks.window_column, ks.SUBJECT_CODE, ks.SUBJECT_CODE_DESC FROM TopDepartments td JOIN KevinStudents ks ON td.DEPARTMENT_CODE = ks.DEPARTMENT_CODE ORDER BY td.DEPARTMENT_NAME, ks.FULL_NAME;\"}, {\"id\": \"dw_1689\", \"name\": \"School Highest Department Average TIP Enrollment with 2019FA Chemistry Course-Material Subject Dense Ranks\", \"desc\": \"For each school, what is the school name and the highest average number of enrolled students per department (among its degree-granting departments, excluding Chemistry, and only considering subjects with at least one enrolled student), and for each subject offered by the Chemistry department in the 2019FA term that has course materials, what is the subject title, the dense rank of the subject considering the current and 2 preceding rows ordered by the number of enrolled students descending, the full name of the offering department, and the school name of the Chemistry department? List the school name and highest average enrolled students per department first, followed by the Chemistry subject title, dense rank, department full name, and Chemistry school name. Do not return any rounded answers.\", \"sql\": \"WITH dept_enrollment_stats AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, AVG(tso.NUM_ENROLLED_STUDENTS) AS avg_enrolled, MAX(tso.NUM_ENROLLED_STUDENTS) - MIN(tso.NUM_ENROLLED_STUDENTS) AS range_enrolled, VARIANCE(tso.NUM_ENROLLED_STUDENTS) AS var_enrolled FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 AND tso.OFFER_DEPT_NAME <> 'Chemistry' GROUP BY sd.DEPARTMENT_NAME, sd.SCHOOL_NAME ), school_max_avg_enrollment AS ( SELECT SCHOOL_NAME, MAX(avg_enrolled) AS highest_avg_enrolled_per_dept FROM dept_enrollment_stats GROUP BY SCHOOL_NAME ), chemistry_subjects_ranked AS ( SELECT inner_cte.SUBJECT_TITLE, inner_cte.dense_rank_num_enrolled, inner_cte.DEPARTMENT_FULL_NAME, sd.SCHOOL_NAME FROM ( SELECT tso.SUBJECT_TITLE, DENSE_RANK() OVER ( ORDER BY tso.NUM_ENROLLED_STUDENTS DESC ROWS BETWEEN 2 PRECEDING AND CURRENT ROW ) AS dense_rank_num_enrolled, sd.DEPARTMENT_FULL_NAME, tso.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED tso JOIN STUDENT_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE WHERE tso.TERM_CODE = '2019FA' AND tso.OFFER_DEPT_NAME = 'Chemistry' AND tso.IS_NO_COURSE_MATERIAL = 'N' ) inner_cte JOIN STUDENT_DEPARTMENT sd ON inner_cte.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE ) SELECT smax.SCHOOL_NAME, smax.highest_avg_enrolled_per_dept, csr.SUBJECT_TITLE, csr.dense_rank_num_enrolled, csr.DEPARTMENT_FULL_NAME, csr.SCHOOL_NAME AS chemistry_school_name FROM school_max_avg_enrollment smax CROSS JOIN chemistry_subjects_ranked csr;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per school-level highest department average enrollment cross joined with each 2019FA Chemistry TIP subject having course materials\"}, {\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per department per academic year\", \"desc\": \"For each academic year, among subjects that are not repeatable, what is the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by each department? List the academic year, department name, average enrollment, variance, and standard deviation (using STDDEV only and never STDDEV_POP), ordered by variance descending. Do not return any rounded answers.\", \"id\": \"dw_2958\", \"name\": \"Non-Repeatable Subject Enrollment Average Variance Stddev by Department and Year\", \"sql\": \"WITH inner_cte AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, SUBJECT_OFFERED.OFFER_DEPT_NAME, SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS FROM SUBJECT_OFFERED JOIN ACADEMIC_TERMS ON SUBJECT_OFFERED.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE SUBJECT_OFFERED.IS_REPEATABLE_SUBJECT = 'N' ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.OFFER_DEPT_NAME, AVG(inner_cte.NUM_ENROLLED_STUDENTS) AS avg_enrollment, VARIANCE(inner_cte.NUM_ENROLLED_STUDENTS) AS enrollment_variance, STDDEV(inner_cte.NUM_ENROLLED_STUDENTS) AS enrollment_stddev FROM inner_cte GROUP BY inner_cte.ACADEMIC_YEAR, inner_cte.OFFER_DEPT_NAME ORDER BY enrollment_variance DESC;\"}, {\"id\": \"dw_4527\", \"name\": \"2021 Engineering Degree-Granting Department Enrollment Dispersion with Above-Average Subject Details\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only subjects with a non-null subject code description), and, for each subject in 2021 offered by these departments in the School of Engineering, list the subject id, subject title, and the number of enrolled students, but only include subjects where the number of enrolled students exceeds the average enrollment for that department in 2021. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH eng_dept_2021_summary AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), dept_enrollment_stats AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, VARIANCE(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_variance, STDDEV(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_stddev FROM TIP_SUBJECT_OFFERED t JOIN SIS_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.SUBJECT_CODE_DESC IS NOT NULL GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME ) SELECT e.DEPARTMENT_CODE, e.DEPARTMENT_NAME, e.DEPARTMENT_FULL_NAME, e.subject_count, e.total_enrollment, d.enrolled_students_variance, d.enrolled_students_stddev FROM eng_dept_2021_summary e JOIN dept_enrollment_stats d ON e.DEPARTMENT_CODE = d.DEPARTMENT_CODE ), dept_avg_enrollment AS ( SELECT s.OFFER_DEPT_CODE, AVG(s.NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM SUBJECT_OFFERED_SUMMARY s JOIN SIS_DEPARTMENT d ON s.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY s.OFFER_DEPT_CODE ) SELECT i.DEPARTMENT_CODE, i.DEPARTMENT_NAME, i.DEPARTMENT_FULL_NAME, i.subject_count, i.total_enrollment, i.enrolled_students_variance, i.enrolled_students_stddev, s.SUBJECT_ID, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS FROM inner_cte i JOIN SUBJECT_OFFERED_SUMMARY s ON i.DEPARTMENT_CODE = s.OFFER_DEPT_CODE JOIN dept_avg_enrollment a ON s.OFFER_DEPT_CODE = a.OFFER_DEPT_CODE WHERE s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' AND s.NUM_ENROLLED_STUDENTS > a.avg_enrollment ORDER BY i.DEPARTMENT_CODE, s.NUM_ENROLLED_STUDENTS DESC;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2021 Engineering subject with above-department-average enrollment within its degree-granting department summary\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per top reserved subject title matched with degree-granting department enrollment dispersion\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', what are the subject title, the offering department name, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only departments that grant degrees and subjects with a non-null subject code description), and the count of reserved materials? Please provide the subject title, the offering department name, the variance, the standard deviation (using STDDEV only and never STDDEV_POP), and the count of reserved materials, in that order. Do not return any rounded answers.\", \"entity_type\": \"metric\", \"id\": \"dw_3356\", \"name\": \"Top 10 Reserved-Material Subjects in 2009SP with Degree-Granting Department Enrollment Variance and Stddev\", \"sql\": \"WITH DepartmentEnrollmentStats AS ( SELECT d.DEPARTMENT_NAME, d.DEPARTMENT_CODE, VARIANCE(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_variance, STDDEV(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_stddev FROM TIP_SUBJECT_OFFERED t JOIN SIS_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.SUBJECT_CODE_DESC IS NOT NULL GROUP BY d.DEPARTMENT_NAME, d.DEPARTMENT_CODE ORDER BY enrolled_students_variance DESC ), TopReservedSubjects AS ( SELECT s.SUBJECT_TITLE, s.OFFER_DEPT_NAME, s.OFFER_DEPT_CODE, COUNT(l.LIBRARY_RESERVE_CATALOG_KEY) AS reserved_materials FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE l.TERM_CODE = '2009SP' GROUP BY s.SUBJECT_TITLE, s.OFFER_DEPT_NAME, s.OFFER_DEPT_CODE ORDER BY reserved_materials DESC LIMIT 10 ) SELECT trs.SUBJECT_TITLE, trs.OFFER_DEPT_NAME, des.enrolled_students_variance, des.enrolled_students_stddev, trs.reserved_materials FROM TopReservedSubjects trs JOIN DepartmentEnrollmentStats des ON trs.OFFER_DEPT_CODE = des.DEPARTMENT_CODE ORDER BY trs.reserved_materials DESC;\"}, {\"id\": \"dw_1165\", \"name\": \"Library-TIP Matched Subjects by Faculty or Enrollment with Degree-Granting Graduate Department Enrollment Dispersion\", \"desc\": \"For each subject where the responsible faculty MIT ID in the library subject offered table is 928034000 or the number of enrolled students in the tip subject offered table is greater than 5, and where the offer department name in the tip subject offered table is either 'Chemistry' or 'Biology', show the subject title from the library subject offered table, the offer department name from the tip subject offered table, the term code from both tables, the number of enrolled students from both tables, and the minimum number of enrolled students in the tip subject offered table over each master subject ID group. Additionally, for the department offering the subject, show the department name, the range of enrolled students, and the variance of enrolled students in the subjects offered by that department, considering only departments that grant degrees, courses that are at the graduate level, and excluding the Biology department. Present the results ordered by subject title and department name. Do not return any rounded answers.\", \"sql\": \"WITH Subquery1 AS ( SELECT lso.SUBJECT_TITLE, tso.OFFER_DEPT_NAME, lso.TERM_CODE AS LIBRARY_TERM_CODE, tso.TERM_CODE AS TIP_TERM_CODE, lso.NUM_ENROLLED_STUDENTS AS LIBRARY_NUM_ENROLLED, tso.NUM_ENROLLED_STUDENTS AS TIP_NUM_ENROLLED, MIN(tso.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY tso.MASTER_SUBJECT_ID) AS MIN_TIP_NUM_ENROLLED, tso.OFFER_DEPT_CODE FROM LIBRARY_SUBJECT_OFFERED lso JOIN TIP_SUBJECT_OFFERED tso ON lso.MASTER_SUBJECT_ID = tso.MASTER_SUBJECT_ID WHERE ( lso.RESPONSIBLE_FACULTY_MIT_ID = 928034000 OR tso.NUM_ENROLLED_STUDENTS > 5 ) AND tso.OFFER_DEPT_NAME IN ('Chemistry', 'Biology') ), Subquery2 AS ( SELECT sd.DEPARTMENT_NAME, MAX(tso.NUM_ENROLLED_STUDENTS) - MIN(tso.NUM_ENROLLED_STUDENTS) AS enrolled_range, VARIANCE(tso.NUM_ENROLLED_STUDENTS) AS enrolled_variance, sd.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED tso JOIN SIS_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT WHERE sd.IS_DEGREE_GRANTING = 'Y' AND scd.COURSE_LEVEL = 'G' AND sd.DEPARTMENT_CODE <> '7' GROUP BY sd.DEPARTMENT_NAME, sd.DEPARTMENT_CODE ), CombinedResults AS ( SELECT s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME, s1.LIBRARY_TERM_CODE, s1.TIP_TERM_CODE, s1.LIBRARY_NUM_ENROLLED, s1.TIP_NUM_ENROLLED, s1.MIN_TIP_NUM_ENROLLED, s2.DEPARTMENT_NAME, s2.enrolled_range, s2.enrolled_variance FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.OFFER_DEPT_CODE = s2.DEPARTMENT_CODE ) SELECT SUBJECT_TITLE, OFFER_DEPT_NAME, LIBRARY_TERM_CODE, TIP_TERM_CODE, LIBRARY_NUM_ENROLLED, TIP_NUM_ENROLLED, MIN_TIP_NUM_ENROLLED, DEPARTMENT_NAME, enrolled_range, enrolled_variance FROM CombinedResults ORDER BY SUBJECT_TITLE, DEPARTMENT_NAME;\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per library-TIP matched subject offering per degree-granting graduate department\"}, {\"id\": \"dw_4640\", \"name\": \"2017JA Subject Enrollment Windows with Department Enrollment Coefficient of Variation and School Code\", \"desc\": \"For each subject offered in the term '2017JA', what is the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code, the coefficient of variation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in the subjects offered by that department (considering only subjects with at least one enrolled student), and the department's school code? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH DeptVariation AS ( SELECT sd.DEPARTMENT_NAME, STDDEV(tso.NUM_ENROLLED_STUDENTS) / NULLIF(AVG(tso.NUM_ENROLLED_STUDENTS), 0) AS coefficient_of_variation FROM TIP_SUBJECT_OFFERED tso JOIN STUDENT_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE WHERE tso.NUM_ENROLLED_STUDENTS > 0 GROUP BY sd.DEPARTMENT_NAME HAVING AVG(tso.NUM_ENROLLED_STUDENTS) > 0 ORDER BY coefficient_of_variation DESC ), Subjects2017JA AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, t1.DEPARTMENT_NAME, t1.DEPARTMENT_CODE, MIN(t0.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t1.DEPARTMENT_CODE ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ) SELECT s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, s.RESPONSIBLE_FACULTY_NAME, s.OFFER_DEPT_NAME, s.DEPARTMENT_FULL_NAME, s.SCHOOL_NAME, s.window_column, dv.coefficient_of_variation, sd.SCHOOL_CODE FROM Subjects2017JA s LEFT JOIN DeptVariation dv ON s.DEPARTMENT_NAME = dv.DEPARTMENT_NAME JOIN STUDENT_DEPARTMENT sd ON s.DEPARTMENT_CODE = sd.DEPARTMENT_CODE ) SELECT * FROM inner_cte;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA TIP subject offering enriched with department-level enrollment coefficient of variation and school code\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per department/school enrollment statistic (plus per-school rollup rows), left joined with Mathematics students named Peter\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\", \"id\": \"dw_1350\", \"name\": \"Degree-Granting Department TIP Enrollment Statistics with School Rollups and Math Peter Student Budget Code Windows\", \"sql\": \"WITH inner_cte1 AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, tso.NUM_ENROLLED_STUDENTS FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 ), DepartmentStats AS ( SELECT DEPARTMENT_NAME, SCHOOL_NAME, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled_students, MAX(NUM_ENROLLED_STUDENTS) - MIN(NUM_ENROLLED_STUDENTS) AS range_enrolled_students, VARIANCE(NUM_ENROLLED_STUDENTS) AS var_enrolled_students, SUM(NUM_ENROLLED_STUDENTS) AS total_enrolled_students FROM inner_cte1 GROUP BY DEPARTMENT_NAME, SCHOOL_NAME ), SchoolRollup AS ( SELECT NULL AS DEPARTMENT_NAME, SCHOOL_NAME, NULL AS avg_enrolled_students, NULL AS range_enrolled_students, NULL AS var_enrolled_students, SUM(total_enrolled_students) AS total_enrolled_students FROM DepartmentStats GROUP BY SCHOOL_NAME ), inner_cte2 AS ( SELECT t1.LAST_NAME, t1.EMAIL_ADDRESS, t1.STUDENT_YEAR, t1.DEPARTMENT_NAME, t0.SCHOOL_NAME, MIN(t0.DEPT_BUDGET_CODE) OVER (ORDER BY t1.FULL_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_DEPARTMENT t0 JOIN MIT_STUDENT_DIRECTORY t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT WHERE t1.FIRST_NAME = 'Peter' AND t0.DEPARTMENT_NAME = 'Mathematics' ) SELECT ds.DEPARTMENT_NAME, ds.SCHOOL_NAME, ds.avg_enrolled_students, ds.range_enrolled_students, ds.var_enrolled_students, ds.total_enrolled_students, ic2.LAST_NAME, ic2.EMAIL_ADDRESS, ic2.STUDENT_YEAR, ic2.window_column, sd.DEPARTMENT_FULL_NAME, sd.DEPARTMENT_LAST_ACTIVITY_DATE FROM (SELECT * FROM DepartmentStats UNION ALL SELECT * FROM SchoolRollup) ds LEFT JOIN inner_cte2 ic2 ON ds.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME AND ds.SCHOOL_NAME = ic2.SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON ds.DEPARTMENT_NAME = sd.DEPARTMENT_NAME ORDER BY ds.SCHOOL_NAME, ds.DEPARTMENT_NAME, ic2.LAST_NAME ;\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_31b08287e8fd4483b8d7e257",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"columns\": {\"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject summary record\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, COURSE_CATALOG_SUBJECT_OFFERED subject IDs\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SUBJECT_OR_CLUSTER\": {\"desc\": \"Indicator whether the row represents a subject or a cluster\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"ULT_MASTER_SUBJECT_ID\": {\"desc\": \"Ultimate master subject identifier in cluster hierarchies\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics'\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name, e.g. 'Engineering'\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREP_UNITS\": {\"desc\": \"Preparation credit units (named PREP_UNITS here vs PREPARATION_UNITS in other tables)\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the subject\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the cluster\"}, \"SUBJECT_GROUP_ID\": {\"desc\": \"Subject group identifier used for grouping related subjects\"}, \"SUBJECT_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Subject enrollment in the first week\"}, \"CLUSTER_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Cluster enrollment in the first week\"}, \"SUBJECT_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Subject enrollment in the fifth week\"}, \"CLUSTER_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Cluster enrollment in the fifth week\"}, \"SUBJECT_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the subject for credit\"}, \"SUBJECT_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the subject\"}, \"CLUSTER_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the cluster for credit\"}, \"CLUSTER_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the cluster\"}, \"SUBJECT_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the cluster\"}, \"SUBJECT_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject offered summary record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject; joins to SIS_SUBJECT_CODE.COURSE_NUMBER and SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'; used for school-level filtering\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}, {\"columns\": [\"SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"SUBJECT_OFFERED_SUMMARY.NUM_ENROLLED_STUDENTS\", \"SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER\", \"TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"LIBRARY_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"SUBJECT_OFFERED.SUBJECT_ENROLLMENT_NUMBER\", \"SUBJECT_OFFERED_SUMMARY.SUBJECT_ENROLLMENT_NUMBER\"], \"comparisons\": [{\"dimension\": \"Measure meaning\", \"detail\": \"NUM_ENROLLED_STUDENTS is the headcount of students enrolled (present in SUBJECT_OFFERED at section grain, SUBJECT_OFFERED_SUMMARY at subject grain, and in TIP/LIBRARY program snapshots); SUBJECT_ENROLLMENT_NUMBER is the official subject enrollment number recorded by the registrar (SUBJECT_SUMMARY, SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY)\"}, {\"dimension\": \"Grain\", \"detail\": \"SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS is per section; SUBJECT_OFFERED_SUMMARY.NUM_ENROLLED_STUDENTS is per subject per term; SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER is the final subject-level enrollment with weekly/credit/listener breakdowns available in sibling columns\"}, {\"dimension\": \"Program scope\", \"detail\": \"TIP_SUBJECT_OFFERED and LIBRARY_SUBJECT_OFFERED enrollment values are snapshots within the textbook-program and library-reserve scopes respectively and may not cover all subjects\"}], \"decision_guide\": {\"Questions about official subject enrollment (e.g. 'subject enrollment number greater than 10')\": \"Use SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER.\", \"Questions about number of enrolled students per subject offering or per department totals\": \"Use NUM_ENROLLED_STUDENTS from SUBJECT_OFFERED_SUMMARY (subject grain) or SUBJECT_OFFERED (section grain, needs aggregation).\", \"Questions about enrollment of subjects within the textbook program or library reserve scope\": \"Use TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS or LIBRARY_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS respectively.\", \"Questions needing enrollment timing (first week, fifth week) or credit vs listener splits\": \"Use SUBJECT_SUMMARY's SUBJECT_ENROLLMENT_FIRST_WEEK / FIFTH_WEEK and *_CREDIT / *_LISTEN columns.\"}, \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\", \"id\": \"column_concept_enrollment_measures\", \"name\": \"Enrollment Measures\"}, {\"id\": \"concept_department_dimension\", \"name\": \"Department and School Dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\", \"tables\": [\"SIS_DEPARTMENT\", \"STUDENT_DEPARTMENT\", \"SIS_ADMIN_DEPARTMENT\"], \"comparisons\": [{\"dimension\": \"Attribute coverage\", \"SIS_DEPARTMENT\": \"Richest: DEPARTMENT_FULL_NAME, SCHOOL_CODE/SCHOOL_NAME, DEPT_BUDGET_CODE, IS_DEGREE_GRANTING, commencement-book names, DLC key\", \"STUDENT_DEPARTMENT\": \"Minimal: code, name, full name, school code/name only\", \"SIS_ADMIN_DEPARTMENT\": \"Administrative contact: department phone area code/number, clearing cost collector\"}, {\"dimension\": \"Degree-granting and school filtering\", \"SIS_DEPARTMENT\": \"Supports IS_DEGREE_GRANTING and SCHOOL_NAME filters directly\", \"STUDENT_DEPARTMENT\": \"Only school code/name attribution, no degree-granting flag\", \"SIS_ADMIN_DEPARTMENT\": \"No school or degree-granting attributes\"}, {\"dimension\": \"Typical join path\", \"SIS_DEPARTMENT\": \"DEPARTMENT_CODE = offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE; also joins SIS_COURSE_DESCRIPTION.DEPARTMENT and SIS_ADMIN_DEPARTMENT.SIS_ADMIN_DEPARTMENT_CODE\", \"STUDENT_DEPARTMENT\": \"DEPARTMENT_CODE = TIP_SUBJECT_OFFERED.OFFER_DEPT_CODE and other offering department codes\", \"SIS_ADMIN_DEPARTMENT\": \"SIS_ADMIN_DEPARTMENT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE\"}, {\"dimension\": \"Budget/finance attributes\", \"SIS_DEPARTMENT\": \"DEPT_BUDGET_CODE available for budget-based ranking\", \"STUDENT_DEPARTMENT\": \"None\", \"SIS_ADMIN_DEPARTMENT\": \"CLEARING_COST_COLLECTOR\"}], \"decision_guide\": {\"Questions filtering departments by school (e.g. 'School of Engineering') or degree-granting status\": \"Use SIS_DEPARTMENT; it carries SCHOOL_NAME and IS_DEGREE_GRANTING.\", \"Questions needing only department full name and school name for offering departments (e.g. TIP subject offerings)\": \"STUDENT_DEPARTMENT suffices and is the lighter lookup; SIS_DEPARTMENT also works.\", \"Questions needing department phone numbers or administrative contact details\": \"Join SIS_ADMIN_DEPARTMENT via SIS_DEPARTMENT.DEPARTMENT_CODE = SIS_ADMIN_DEPARTMENT_CODE.\", \"Questions ranking or grouping departments by budget code\": \"Use SIS_DEPARTMENT.DEPT_BUDGET_CODE.\"}}, {\"id\": \"column_concept_department_name\", \"name\": \"Department Name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME\", \"SUBJECT_SUMMARY.DEPARTMENT_NAME\", \"SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY.OFFER_DEPT_NAME\", \"TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SIS_DEPARTMENT.DEPARTMENT_NAME\", \"STUDENT_DEPARTMENT.DEPARTMENT_NAME\", \"SIS_COURSE_DESCRIPTION.DEPARTMENT_NAME\", \"SIS_SUBJECT_CODE.DEPARTMENT_NAME\", \"EMPLOYEE_DIRECTORY.DEPARTMENT_NAME\", \"LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT\", \"MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME\", \"SE_PERSON.ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DEPARTMENT_NAME is used by catalog/summary tables (COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY), department/course lookup tables, and the student directory (MIT_STUDENT_DIRECTORY); OFFER_DEPT_NAME is used by offering/program tables (SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY, TIP_SUBJECT_OFFERED, LIBRARY_SUBJECT_OFFERED) and denotes the department that actually offers the subject; LIBRARY_COURSE_INSTRUCTOR uses the plain column name DEPARTMENT for the course's academic department; SE_PERSON uses ORGANIZATION for the person's organizational unit\"}, {\"dimension\": \"Value format\", \"detail\": \"Catalog, summary, offering, student-directory, and lookup tables store plain department names (e.g. 'Mathematics', 'Chemistry', 'Electrical Eng & Computer Sci'); LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT stores a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics', '06 - Electrical Eng & Computer Sci'), with some unprefixed values (e.g. 'Architecture'), so it is not directly comparable to plain-name columns without stripping the prefix\"}, {\"dimension\": \"Academic vs HR/organization value domain\", \"detail\": \"Catalog, summary, offering, library, student-directory, and lookup tables share the academic department domain; EMPLOYEE_DIRECTORY.DEPARTMENT_NAME is the HR organizational unit name and has a different domain (e.g. 'Lincoln Laboratory', 'Department of Physics'), where some values coincide with academic names but many do not, and some carry a 'Department of ...' prefix; SE_PERSON.ORGANIZATION holds organizational unit names that may use different naming variants than the academic domain for the same unit (e.g. 'Electrical Engineering-Computer Science' vs the academic 'Electrical Eng & Computer Sci'), so equality filters across the two conventions must use each table's own variant\"}, {\"dimension\": \"Companion code column\", \"detail\": \"Catalog/summary tables carry DEPARTMENT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE; offering/program tables carry OFFER_DEPT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE or STUDENT_DEPARTMENT.DEPARTMENT_CODE; MIT_STUDENT_DIRECTORY carries DEPARTMENT (the academic department code) joining SIS_DEPARTMENT.DEPARTMENT_CODE, which is the reliable join key instead of the name; LIBRARY_COURSE_INSTRUCTOR has no department code column, only the prefixed name text; EMPLOYEE_DIRECTORY carries DEPARTMENT_NUMBER (HR department number) and SE_PERSON carries no department code, neither joining to SIS_DEPARTMENT.DEPARTMENT_CODE\"}], \"decision_guide\": {\"Filtering subjects by department in catalog or summary analysis\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME or SUBJECT_SUMMARY.DEPARTMENT_NAME.\", \"Filtering by department in section-level, textbook-program, or library analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Joining fact tables to department dimension attributes (school, full name, degree-granting)\": \"Prefer code joins: DEPARTMENT_CODE / OFFER_DEPT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE; name equality joins are used when codes are unavailable.\", \"Matching departments across a DEPARTMENT_NAME table and an OFFER_DEPT_NAME table\": \"The values are directly comparable (same academic name domain), e.g. joining SUBJECT_SUMMARY.DEPARTMENT_NAME to TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME.\", \"Filtering employees by their HR organizational unit (e.g. names containing 'Department', or HR units like 'Political Science')\": \"Use EMPLOYEE_DIRECTORY.DEPARTMENT_NAME; do not join it to SIS_DEPARTMENT.DEPARTMENT_CODE, and pair it with DEPARTMENT_NUMBER for HR grouping.\", \"Filtering by department in section-level, textbook-program, or library subject analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Filtering library reserve course instructors by academic department or library unit\": \"Use LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT with the prefixed value format (e.g. '18 - Mathematics'); do not compare it directly to plain department-name columns.\", \"Filtering students by their academic department\": \"Use MIT_STUDENT_DIRECTORY.DEPARTMENT (code) joined to SIS_DEPARTMENT.DEPARTMENT_CODE for reliable matching, or MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME for direct name filters; the name shares the academic domain with SIS_DEPARTMENT.DEPARTMENT_NAME.\", \"Filtering a person master (SE_PERSON) record by organizational unit such as an academic department\": \"Use SE_PERSON.ORGANIZATION with its own naming variant (e.g. 'Electrical Engineering-Computer Science'); do not equate it directly to MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME or SIS_DEPARTMENT.DEPARTMENT_NAME, which use the academic variant (e.g. 'Electrical Eng & Computer Sci').\"}}], \"not_found\": []}"
    },
