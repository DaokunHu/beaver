      "role": "tool",
      "tool_call_id": "call_2f9e0155fa944839b7ba2932",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Department Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per degree-granting Engineering department\", \"desc\": \"For each degree-granting department that offered at least one subject in the School of Engineering in 2021 and has more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the total number of tip materials, the average number of enrolled students per subject (rounded to two decimal places), and the ratio of total enrolled students to total tip materials (rounded to two decimal places), listing the results in descending order of the average number of enrolled students per subject.\", \"id\": \"dw_4650\", \"name\": \"Engineering Degree-Granting Departments 2021 Enrollment per Subject and per TIP Material Ratios\", \"sql\": \"WITH inner_cte AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ) SELECT icte.DEPARTMENT_CODE, icte.DEPARTMENT_NAME, icte.DEPARTMENT_FULL_NAME, icte.subject_count, icte.total_enrollment, dtm.total_tip_materials, ROUND(icte.total_enrollment / NULLIF(icte.subject_count, 0), 2) AS Avg_Enrollment_per_Subject, ROUND(icte.total_enrollment / NULLIF(dtm.total_tip_materials, 0), 2) AS Enrollment_per_TipMaterial FROM inner_cte icte JOIN ( SELECT s.DEPARTMENT_NAME, SUM(t.RECORD_COUNT) AS total_tip_materials FROM TIP_DETAIL t JOIN ACADEMIC_TERMS a ON t.TERM_CODE = a.TERM_CODE JOIN SUBJECT_SUMMARY s ON a.TERM_CODE = s.TERM_CODE AND t.SUBJECT_ID = s.SUBJECT_ID WHERE s.SCHOOL_NAME = 'Engineering' AND a.IS_REGULAR_TERM = 'Y' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.RECORD_COUNT) > 10 ) dtm ON icte.DEPARTMENT_NAME = dtm.DEPARTMENT_NAME ORDER BY Avg_Enrollment_per_Subject DESC;\"}, {\"category\": \"Department Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per department\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, or for each department that offered more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of tip materials. List the department code, department name, department full name, number of subjects offered, total number of enrolled students, and total number of tip materials in that order. Do not return any rounded answers.\", \"id\": \"dw_3727\", \"name\": \"Engineering Degree-Granting Departments 2021 Subject Counts and TIP Material Totals Union\", \"sql\": \"WITH DeptSubjects AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), DeptTipMaterials AS ( SELECT s.DEPARTMENT_NAME, SUM(t.RECORD_COUNT) AS total_tip_materials FROM TIP_DETAIL t JOIN ACADEMIC_TERMS a ON t.TERM_CODE = a.TERM_CODE JOIN SUBJECT_SUMMARY s ON a.TERM_CODE = s.TERM_CODE AND t.SUBJECT_ID = s.SUBJECT_ID WHERE s.SCHOOL_NAME = 'Engineering' AND a.IS_REGULAR_TERM = 'Y' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.RECORD_COUNT) > 10 ), CombinedDept AS ( SELECT ds.DEPARTMENT_CODE, ds.DEPARTMENT_NAME, ds.DEPARTMENT_FULL_NAME, ds.subject_count, ds.total_enrollment, dtm.total_tip_materials FROM DeptSubjects ds LEFT JOIN DeptTipMaterials dtm ON ds.DEPARTMENT_NAME = dtm.DEPARTMENT_NAME UNION ALL SELECT NULL AS DEPARTMENT_CODE, dtm.DEPARTMENT_NAME, NULL AS DEPARTMENT_FULL_NAME, NULL AS subject_count, NULL AS total_enrollment, dtm.total_tip_materials FROM DeptTipMaterials dtm LEFT JOIN DeptSubjects ds ON dtm.DEPARTMENT_NAME = ds.DEPARTMENT_NAME WHERE ds.DEPARTMENT_NAME IS NULL ) SELECT * FROM CombinedDept ORDER BY DEPARTMENT_NAME;\"}, {\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per current-term subject matched with 2016SP degree-granting department summary\", \"desc\": \"For each department that both offered subjects in the current SIS term and is a degree-granting department that offered subjects in the term '2016SP', list the department code, offering department name, subject title, responsible faculty name, term description, academic year description, total number of subjects offered per department in the current term, department name, number of subjects offered in 2016SP, and total units for those subjects in 2016SP. Include all columns in the order: department code, offering department name, subject title, responsible faculty name, term description, academic year description, total number of subjects offered per department in the current term, department name, number of subjects offered in 2016SP, and total units for those subjects in 2016SP. Do not return any rounded answers.\", \"id\": \"dw_4231\", \"name\": \"Current SIS Term Department Subjects Matched with 2016SP Degree-Granting Department Unit Totals\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.RESPONSIBLE_FACULTY_NAME, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR_DESC, t0.OFFER_DEPT_CODE, MIN(t0.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.ACADEMIC_YEAR ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t2.TERM_PARAMETER = 'SIS_CURRENT_TERM' ) SELECT inner_cte.OFFER_DEPT_NAME, inner_cte.SUBJECT_TITLE, inner_cte.RESPONSIBLE_FACULTY_NAME, inner_cte.TERM_DESCRIPTION, inner_cte.ACADEMIC_YEAR_DESC, dept_counts.Total_Subjects, inner_cte.OFFER_DEPT_CODE FROM inner_cte JOIN ( SELECT t0.OFFER_DEPT_NAME, t0.OFFER_DEPT_CODE, COUNT(DISTINCT t0.SUBJECT_TITLE) AS Total_Subjects FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t2.TERM_PARAMETER = 'SIS_CURRENT_TERM' GROUP BY t0.OFFER_DEPT_NAME, t0.OFFER_DEPT_CODE ) dept_counts ON inner_cte.OFFER_DEPT_NAME = dept_counts.OFFER_DEPT_NAME AND inner_cte.OFFER_DEPT_CODE = dept_counts.OFFER_DEPT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t2.SUBJECT_ID, dense_rank() OVER (ORDER BY t2.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) window_column FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t2.TERM_CODE = '2016SP' AND t1.IS_DEGREE_GRANTING = 'Y' ), DeptSubjectSummary AS ( SELECT t1.DEPARTMENT_CODE, t1.DEPARTMENT_NAME, COUNT(DISTINCT t2.SUBJECT_ID) AS num_subjects, SUM(t2.TOTAL_UNITS) AS total_units FROM SIS_DEPARTMENT t1 JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t1.IS_DEGREE_GRANTING = 'Y' AND t2.TERM_CODE = '2016SP' GROUP BY t1.DEPARTMENT_CODE, t1.DEPARTMENT_NAME ) SELECT dss.DEPARTMENT_CODE, dss.DEPARTMENT_NAME, dss.num_subjects, dss.total_units FROM DeptSubjectSummary dss UNION ALL SELECT dss.DEPARTMENT_CODE, NULL AS DEPARTMENT_NAME, SUM(dss.num_subjects) AS num_subjects, SUM(dss.total_units) AS total_units FROM DeptSubjectSummary dss GROUP BY dss.DEPARTMENT_CODE ) SELECT s1.OFFER_DEPT_CODE, s1.OFFER_DEPT_NAME, s1.SUBJECT_TITLE, s1.RESPONSIBLE_FACULTY_NAME, s1.TERM_DESCRIPTION, s1.ACADEMIC_YEAR_DESC, s1.Total_Subjects, s2.DEPARTMENT_NAME, s2.num_subjects, s2.total_units FROM subq1 s1 JOIN subq2 s2 ON s1.OFFER_DEPT_CODE = s2.DEPARTMENT_CODE ORDER BY s1.OFFER_DEPT_CODE, s1.SUBJECT_TITLE, s2.DEPARTMENT_NAME\"}, {\"id\": \"dw_1049\", \"name\": \"Mathematics Total Units Stddev for Regular Non-Current Terms vs 2022 Degree-Granting Departments\", \"category\": \"Subject Offering Analysis\", \"desc\": \"For the Mathematics department, what is the department name, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for its subjects in regular terms that are not the current term, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department in the 2022 academic year (considering only departments that have more than five subjects offered in 2022, are degree-granting, and are not the Chemistry department)? Show the department name, the standard deviation (using STDDEV only and never STDDEV_POP) for regular non-current terms, and the standard deviation (using STDDEV only and never STDDEV_POP) for 2022. Do not return any rounded answers.\", \"sql\": \"WITH MathDeptStddev AS ( SELECT ss.DEPARTMENT_NAME, STDDEV(ss.TOTAL_UNITS) AS stddev_total_units FROM SUBJECT_SUMMARY ss JOIN ACADEMIC_TERMS at ON ss.TERM_CODE = at.TERM_CODE WHERE ss.DEPARTMENT_NAME = 'Mathematics' AND at.IS_REGULAR_TERM = 'Y' AND at.IS_CURRENT_TERM = 'N' GROUP BY ss.DEPARTMENT_NAME ), DeptStddev2022 AS ( SELECT scd.DEPARTMENT_NAME, STDDEV(ccso.TOTAL_UNITS) AS total_units_stddev FROM SIS_SUBJECT_CODE ssc JOIN SIS_COURSE_DESCRIPTION scd ON ssc.SUBJECT_CODE = scd.COURSE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON scd.COURSE = ccso.SUBJECT_CODE WHERE ccso.ACADEMIC_YEAR = 2022 AND scd.IS_DEGREE_GRANTING = 'Y' AND scd.DEPARTMENT_NAME <> 'Chemistry' GROUP BY scd.DEPARTMENT_NAME HAVING COUNT(*) > 5 ORDER BY total_units_stddev DESC ) SELECT mds.DEPARTMENT_NAME, mds.stddev_total_units AS math_stddev_total_units, dsd.total_units_stddev AS dept_stddev_2022 FROM MathDeptStddev mds LEFT JOIN DeptStddev2022 dsd ON mds.DEPARTMENT_NAME = dsd.DEPARTMENT_NAME;\", \"default_granularity\": \"one row per department\"}], \"not_found\": []}"
    },
