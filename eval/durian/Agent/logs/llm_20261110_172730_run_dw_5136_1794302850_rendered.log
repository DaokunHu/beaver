    {
      "role": "tool",
      "tool_call_id": "call_a976372e06b5423abdd2e749",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Facility Space Comprehensive Analysis\", \"default_granularity\": \"one row per department-year matched with academic building\", \"desc\": \"For each department and academic year, show the department name, academic year, academic year description, and the geometric mean of the total units for all subjects offered by the department in regular terms with total units greater than zero, along with, for each academic building where these subjects are held and which has rooms larger than 40 square meters, the building name, the average, range, and variance of the room areas, as well as the total assignable area of the building and the year the building was built. The results are ordered by department name, academic year (descending), and room area range (descending). Do not return any rounded answers.\", \"id\": \"dw_4061\", \"name\": \"Department Geometric Mean Total Units with Academic Building Room Area Statistics\", \"sql\": \"WITH dept_units AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, EXP(AVG(LN(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS))) AS geometric_mean_total_units, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME FROM ACADEMIC_TERMS JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' AND COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS > 0 GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME ), building_stats AS ( SELECT b.BUILDING_NAME, AVG(r.AREA) AS avg_room_area, MAX(r.AREA) - MIN(r.AREA) AS room_area_range, VARIANCE(r.AREA) AS room_area_variance FROM FCLT_ROOMS r JOIN FCLT_BUILDING b ON r.FCLT_BUILDING_KEY = b.FCLT_BUILDING_KEY WHERE b.BUILDING_TYPE = 'ACADEMIC' AND r.AREA > 40 GROUP BY b.BUILDING_NAME ) SELECT ds.DEPARTMENT_NAME, ds.ACADEMIC_YEAR, ds.ACADEMIC_YEAR_DESC, ds.geometric_mean_total_units, bs.BUILDING_NAME, bs.avg_room_area, bs.room_area_range, bs.room_area_variance, fb.ASSIGNABLE_AREA, fb.DATE_BUILT FROM dept_units ds JOIN COURSE_CATALOG_SUBJECT_OFFERED cso ON ds.DEPARTMENT_NAME = cso.DEPARTMENT_NAME AND ds.ACADEMIC_YEAR = cso.ACADEMIC_YEAR JOIN FCLT_ROOMS fr ON cso.MEET_PLACE = fr.FCLT_ROOM_KEY JOIN FCLT_BUILDING fb ON fr.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY JOIN building_stats bs ON fb.BUILDING_NAME = bs.BUILDING_NAME ORDER BY ds.DEPARTMENT_NAME, ds.ACADEMIC_YEAR DESC, bs.room_area_range DESC;\"}, {\"id\": \"dw_1864\", \"name\": \"Level-5 Assignable Organization Space Units with Provost Area HR Department Statistics\", \"desc\": \"For each organization whose organization level is 5 and is not 'ADMISSIONS', and for each organization and its corresponding HR department where the organization is assignable, the HR organization unit level is 'DEPARTMENTS', the organization is not 'Cambridge-MIT Institute', and the organization is in the 'Provost Area' top-level HR hierarchy, but excluding organizations with organization IDs '138' and '250', show the organization name, description, the corresponding space unit name, the total number of space units associated with each organization, the HR department name, the number of organizations, and the minimum organization number. Do not return any rounded answers.\", \"sql\": \"WITH org_space_units AS ( SELECT ORGANIZATION_NAME, DESCRIPTION, SPACE_UNIT, COUNT(SPACE_UNIT) OVER (PARTITION BY ORGANIZATION_NAME) AS total_space_units, DLC_KEY FROM ( SELECT t0.ORGANIZATION_NAME, t0.DESCRIPTION, t1.SPACE_UNIT, ROW_NUMBER() OVER (ORDER BY t1.SPACE_UNIT ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t0.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN SPACE_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.ORGANIZATION_LEVEL = 5 AND t0.ORGANIZATION_NAME <> 'ADMISSIONS' AND t0.ORGANIZATION_ID NOT IN ('138', '250') ) inner_cte ), org_hr_dept AS ( SELECT ic.ORGANIZATION, ic.HR_DEPARTMENT_NAME, ic.organization_count, ic.min_organization_number, f.DLC_KEY FROM ( SELECT f.ORGANIZATION, h.HR_DEPARTMENT_NAME, COUNT(f.FCLT_ORGANIZATION_KEY) AS organization_count, MIN(f.ORGANIZATION_NUMBER) AS min_organization_number FROM FCLT_ORGANIZATION f JOIN HR_ORG_UNIT h ON f.HR_DEPARTMENT_CODE_OLD = h.HR_DEPARTMENT_CODE_OLD WHERE f.ASSIGNABLE = 1 AND h.HR_ORG_UNIT_LEVEL = 'DEPARTMENTS' AND f.ORGANIZATION_NAME NOT IN ('CAMBRIDGE-MIT INST') AND f.ORGANIZATION_ID NOT IN ('138', '250') GROUP BY f.ORGANIZATION, h.HR_DEPARTMENT_NAME ) ic JOIN HR_ORG_UNIT h2 ON ic.HR_DEPARTMENT_NAME = h2.HR_DEPARTMENT_NAME JOIN FCLT_ORGANIZATION f ON ic.ORGANIZATION = f.ORGANIZATION WHERE h2.ORG_HIER_TOP_LEVEL_NAME = 'Provost Area' ) SELECT osu.ORGANIZATION_NAME, osu.DESCRIPTION, osu.SPACE_UNIT, osu.total_space_units, ohd.HR_DEPARTMENT_NAME, ohd.organization_count, ohd.min_organization_number FROM org_space_units osu JOIN org_hr_dept ohd ON osu.DLC_KEY = ohd.DLC_KEY;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per level-5 organization space unit matched with its Provost Area HR department statistics\"}, {\"id\": \"dw_2896\", \"name\": \"Two-Supervisee Supervisor Records with 5-Row Windowed Average Square Footage Above 200 per Facility Organization\", \"desc\": \"For each facility organization, show the research volume, department names, square footage, MIT ID, and the average square footage in a window of 2 preceding and 2 following rows (grouped by facility organization key and ordered by research volume) for space supervisor usage records where the number of supervisees is 2, and only include those records where the average square footage in the window is greater than 200. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT t0.RESEARCH_VOLUME, t0.DEPT_NAMES, t0.SQFT, t0.MIT_ID, AVG(t0.SQFT) OVER ( PARTITION BY t1.FCLT_ORGANIZATION_KEY ORDER BY t0.RESEARCH_VOLUME ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column FROM SPACE_SUPERVISOR_USAGE t0 JOIN SPACE_UNIT t1 ON t0.DEPT_NAMES = t1.DLC_KEY WHERE t0.NUM_OF_SUPERVISEES = 2 ) SELECT RESEARCH_VOLUME, DEPT_NAMES, SQFT, MIT_ID, window_column FROM inner_cte WHERE window_column > 200;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per supervisor usage record with 2 supervisees whose 5-row windowed average square footage (per facility organization, ordered by research volume) exceeds 200\"}, {\"default_granularity\": \"one row per Provost Area department rank matched with a space-unit-97500 supervisor usage statistics row of the same DLC\", \"desc\": \"For each department in the \\\"Provost Area\\\" that is associated with a space unit with space unit code 97500, show the department code, department name, school area name, the rank of each department within its school area based on department code, the corresponding DLC name, the space unit name, space unit code, associated organization name, department count, number of supervisees, and the highest research volume ever recorded for each department count group. Do not return any rounded answers.\", \"id\": \"dw_4452\", \"name\": \"Provost Area Department School-Area Ranks with Space Unit 97500 Supervisor Usage Statistics\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.HR_DEPARTMENT_CODE, t1.HR_DEPARTMENT_NAME, t1.ORG_HIER_SCHOOL_AREA_NAME, RANK() OVER (PARTITION BY t1.ORG_HIER_SCHOOL_AREA_NAME ORDER BY t1.HR_DEPARTMENT_CODE) AS window_column, t1.DLC_KEY FROM MASTER_DEPT_HIERARCHY t0 INNER JOIN HR_ORG_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' ), DeptRanked AS ( SELECT inner_cte1.HR_DEPARTMENT_CODE, inner_cte1.HR_DEPARTMENT_NAME, inner_cte1.ORG_HIER_SCHOOL_AREA_NAME, inner_cte1.window_column, t2.DLC_NAME, inner_cte1.DLC_KEY FROM inner_cte1 INNER JOIN HR_ORG_UNIT t2 ON inner_cte1.DLC_KEY = t2.DLC_KEY ), inner_cte2 AS ( SELECT t1.SPACE_UNIT AS space_unit_name, t1.SPACE_UNIT_CODE, t0.ORGANIZATION_NAME, t2.DEPT_COUNT, t2.NUM_OF_SUPERVISEES, t2.RESEARCH_VOLUME, t1.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN SPACE_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY JOIN SPACE_SUPERVISOR_USAGE t2 ON t1.DLC_KEY = t2.DEPT_NAMES WHERE t1.SPACE_UNIT_CODE = 97500 ), SpaceStats AS ( SELECT space_unit_name, SPACE_UNIT_CODE, ORGANIZATION_NAME, DEPT_COUNT, NUM_OF_SUPERVISEES, MAX(RESEARCH_VOLUME) AS highest_research_volume, DLC_KEY FROM inner_cte2 GROUP BY space_unit_name, SPACE_UNIT_CODE, ORGANIZATION_NAME, DEPT_COUNT, NUM_OF_SUPERVISEES, DLC_KEY ) SELECT d.HR_DEPARTMENT_CODE, d.HR_DEPARTMENT_NAME, d.ORG_HIER_SCHOOL_AREA_NAME, d.window_column, d.DLC_NAME, s.space_unit_name, s.SPACE_UNIT_CODE, s.ORGANIZATION_NAME, s.DEPT_COUNT, s.NUM_OF_SUPERVISEES, s.highest_research_volume FROM DeptRanked d JOIN SpaceStats s ON d.DLC_KEY = s.DLC_KEY ORDER BY d.HR_DEPARTMENT_CODE, s.space_unit_name;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\"}], \"not_found\": []}"
    },
