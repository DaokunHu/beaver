      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"MASTER_DEPT_HIERARCHY\", \"name\": \"MASTER_DEPT_HIERARCHY\", \"desc\": \"Master department hierarchy table: one row per department/lab/center (DLC) under the 'Standard Hierarchy' hierarchy type, recording the DLC key/code/name and its five-level hierarchy path from the institute root (level 1 'All Departments') through executive areas down to the DLC's placement, with each level's code and name (null for levels deeper than the DLC's position). Joins to HR_ORG_UNIT and FCLT_ORGANIZATION via DLC_KEY; used to report or filter the master-hierarchy placement (school/area path) of a DLC, and as a DLC scope filter when only DLCs present in the standard hierarchy should be included.\", \"columns\": {\"HIERARCHY_TYPE\": {\"desc\": \"Hierarchy classification of the row; only 'Standard Hierarchy' exists in current data\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_CAMPLAN'; joins to HR_ORG_UNIT.DLC_KEY and FCLT_ORGANIZATION.DLC_KEY\"}, \"DLC_CODE\": {\"desc\": \"Department/Lab/Center code (same value as DLC_KEY in current data); matches MASTER_DEPT_DCODE_PARENT.D_CODE\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Campus Planning'\"}, \"MASTER_DEPT_HIER_LEVEL_1_CODE\": {\"desc\": \"Code of the level-1 hierarchy node, 'D_ALL' for all rows\"}, \"MASTER_DEPT_HIER_LEVEL_1_NAME\": {\"desc\": \"Name of the level-1 hierarchy node, 'All Departments'\"}, \"MASTER_DEPT_HIER_LEVEL_2_CODE\": {\"desc\": \"Code of the level-2 hierarchy node, e.g. 'D_EXECVP_AREA'\"}, \"MASTER_DEPT_HIER_LEVEL_2_NAME\": {\"desc\": \"Name of the level-2 hierarchy node, e.g. \\\"Executive Vice President's Area\\\"\"}, \"MASTER_DEPT_HIER_LEVEL_3_CODE\": {\"desc\": \"Code of the level-3 hierarchy node; null when the DLC's path is shallower than 3 levels\"}, \"MASTER_DEPT_HIER_LEVEL_3_NAME\": {\"desc\": \"Name of the level-3 hierarchy node, e.g. 'VP Finance Area'; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_4_CODE\": {\"desc\": \"Code of the level-4 hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_4_NAME\": {\"desc\": \"Name of the level-4 hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_5_CODE\": {\"desc\": \"Code of the level-5 (deepest) hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_5_NAME\": {\"desc\": \"Name of the level-5 (deepest) hierarchy node; null for shallow paths\"}}, \"default_granularity\": \"one row per DLC under the standard hierarchy type\"}, {\"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Surrogate key of the facilities organization; joins to SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY\"}, \"ORGANIZATION_ID\": {\"desc\": \"Organization identifier (same value as the organization key in current data)\"}, \"ORGANIZATION\": {\"desc\": \"Short organization abbreviation, e.g. 'AERO', 'ADMISS'\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Display name of the organization, e.g. 'AERO & ASTRO'; used for organization-name reporting\"}, \"FCLT_ORG_PARENT_KEY\": {\"desc\": \"Key of the parent organization in the hierarchy tree; null for the top-level organization\"}, \"ORG_PARENT\": {\"desc\": \"Abbreviation of the parent organization, e.g. 'S ENG' (School of Engineering)\"}, \"FCLT_MAJOR_ORG_KEY\": {\"desc\": \"Key of the major (top-level grouping) organization this organization rolls up to\"}, \"MAJOR_ORG\": {\"desc\": \"Abbreviation of the major organization, e.g. 'PROVST', 'CHNCLR'\"}, \"ORGANIZATION_LEVEL\": {\"desc\": \"Level of the organization in the hierarchy tree (1 = institute-wide root, 2-4 = intermediate divisions/schools, 5 = department/DLC level, 6 = sub-organization); stored as string, filter with values like '5'\"}, \"ORGANIZATION_NUMBER\": {\"desc\": \"Official organization number used in administrative systems\"}, \"ORGANIZATION_SORT\": {\"desc\": \"Sortable hierarchical organization code reflecting the tree path\"}, \"ASSIGNABLE\": {\"desc\": \"Flag ('1'/'0') indicating whether the organization is an assignable-space organizational unit\"}, \"COURSE\": {\"desc\": \"Academic course (department) number for degree-granting academic departments, e.g. '16' for Aeronautics and Astronautics; null for non-academic organizations\"}, \"DESCRIPTION\": {\"desc\": \"Long description of the organization, e.g. 'Department of Aeronautics and Astronautics'; null for many non-academic organizations\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_AEROASTRO'; joins to FCLT_ORG_DLC_KEY.DLC_KEY, HR_ORG_UNIT.DLC_KEY (for HR org unit title/level and HR department attributes; may fan out when a DLC maps to multiple HR org units), and MASTER_DEPT_HIERARCHY.DLC_KEY (for the standard department hierarchy path)\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Aeronautics and Astronautics'\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code cross-reference\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"HR organization unit identifier cross-reference; links to HR_ORG_UNIT\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"Department name as recorded in HR systems\"}}, \"default_granularity\": \"one row per facilities organization\"}, {\"id\": \"SPACE_UNIT\", \"name\": \"SPACE_UNIT\", \"desc\": \"Space unit dimension table: one row per space unit (an organizational space-assignment unit such as a department, program, or office that receives space allocation), with space unit key/code, space unit name, the facilities organization it belongs to, and DLC key. Bridges FCLT_ORGANIZATION (organization attribution) and SPACE_DETAIL (rooms assigned to the space unit); used to group room counts and space statistics by space unit.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Foreign key to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY; the organization that owns/occupies this space unit\"}, \"SPACE_UNIT_KEY\": {\"desc\": \"Surrogate key of the space unit; joins to SPACE_DETAIL.SPACE_UNIT_KEY and SPACE_UNIT2.SPACE_UNIT_KEY; used for partitioning/ordering in space analyses\"}, \"SPACE_UNIT_CODE\": {\"desc\": \"Business code of the space unit (same numeric value as the key in current data)\"}, \"SPACE_UNIT\": {\"desc\": \"Name of the space unit, e.g. 'Physics', 'Technology & Policy Program'\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_PHYSICS'; may contain composite values like 'D_DSL:HQ'\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per space unit\"}, {\"id\": \"SPACE_SUPERVISOR_USAGE\", \"name\": \"SPACE_SUPERVISOR_USAGE\", \"desc\": \"Space supervisor usage fact table: one row per supervisor (MIT_ID) recording how much space they supervise and for how many departments: department count, department DLC key list (comma-separated when multiple), number of supervisees, supervised square footage, research volume, and derived ratio measures (sqft per supervisee, sqft per research volume, research volume per sqft). Joins to SPACE_UNIT and other DLC-carrying tables via DEPT_NAMES = DLC_KEY (only single-department rows match); used for supervisor space-usage and research-volume statistics per department/DLC.\", \"columns\": {\"MIT_ID\": {\"desc\": \"MIT ID of the supervisor; one row per supervisor\"}, \"DEPT_COUNT\": {\"desc\": \"Number of departments (DLCs) the supervisor's space spans; observed values 1-4\"}, \"DEPT_NAMES\": {\"desc\": \"DLC key(s) of the supervised departments, e.g. 'D_CEE'; comma-separated list when DEPT_COUNT > 1 (e.g. 'D_IDSS,D_LIDS'). Single-value rows join to DLC key columns such as SPACE_UNIT.DLC_KEY\"}, \"NUM_OF_SUPERVISEES\": {\"desc\": \"Number of supervisees under the supervisor; observed range 1-121\"}, \"SQFT\": {\"desc\": \"Total square footage of space supervised\"}, \"RESEARCH_VOLUME\": {\"desc\": \"Research volume attributed to the supervisor's space; can be negative\"}, \"SQFT_PER_SUPERVISEE\": {\"desc\": \"Derived ratio: supervised square footage per supervisee\"}, \"SQFT_PER_RES_VOL\": {\"desc\": \"Derived ratio: supervised square footage per unit of research volume\"}, \"RES_VOL_PER_SQFT\": {\"desc\": \"Derived ratio: research volume per square foot of supervised space\"}, \"default_granularity\": \"one row per supervisor\"}, \"default_granularity\": \"one row per supervisor\"}], \"not_found\": []}"
