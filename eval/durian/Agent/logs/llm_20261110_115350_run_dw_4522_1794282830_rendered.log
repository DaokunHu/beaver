            "name": "semantic_search",
            "arguments": "{\"query\": \"school name department phone number department contact information\", \"topk\": 20}"
          }
        },
        {
          "id": "call_d3a4902c30474a93bbcf39ae",
          "type": "function",
          "function": {
            "name": "semantic_search",
            "arguments": "{\"query\": \"regular academic term IS_REGULAR_TERM term status\", \"topk\": 20}"
          }
