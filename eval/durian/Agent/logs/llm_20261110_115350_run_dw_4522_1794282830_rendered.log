            "arguments": "{\"sql\": \"WITH TopSubjects AS (\\n  SELECT ss.SUBJECT_TITLE,\\n         ss.DEPARTMENT_NAME,\\n         COUNT(td.TIP_MATERIAL_KEY) AS material_count,\\n         ss.SUBJECT_ID\\n  FROM TIP_DETAIL td\\n  JOIN ACADEMIC_TERMS at ON td.TERM_CODE = at.TERM_CODE\\n  JOIN SUBJECT_SUMMARY ss ON at.TERM_CODE = ss.TERM_CODE AND td.SUBJECT_ID = ss.SUBJECT_ID\\n  WHERE at.IS_REGULAR_TERM = 'Y'\\n  GROUP BY ss.SUBJECT_TITLE, ss.DEPARTMENT_NAME, ss.SUBJECT_ID\\n  ORDER BY material_count DESC\\n  LIMIT 10\\n),\\nSubjects2014FA AS (\\n  SELECT lso.SUBJECT_TITLE,\\n         lso.OFFER_DEPT_NAME,\\n         lso.RESPONSIBLE_FACULTY_NAME,\\n         td.TIP_MATERIAL_STATUS_KEY,\\n         sos.TOTAL_UNITS,\\n         MIN(sos.TOTAL_UNITS) OVER (ORDER BY sos.COURSE_NUMBER ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column,\\n         lso.SUBJECT_ID\\n  FROM LIBRARY_SUBJECT_OFFERED lso\\n  JOIN TIP_DETAIL td ON lso.SUBJECT_ID = td.SUBJECT_ID\\n  JOIN SUBJECT_OFFERED_SUMMARY sos ON td.SUBJECT_ID = sos.SUBJECT_ID\\n  WHERE lso.TERM_CODE = '2014FA' AND lso.NUM_ENROLLED_STUDENTS > 0\\n),\\nCombinedSubjects AS (\\n  SELECT ts.SUBJECT_TITLE,\\n         ts.DEPARTMENT_NAME,\\n         ts.material_count,\\n         NULL AS OFFER_DEPT_NAME,\\n         NULL AS RESPONSIBLE_FACULTY_NAME,\\n         NULL AS TIP_MATERIAL_STATUS_KEY,\\n         NULL AS TOTAL_UNITS,\\n         NULL AS window_column,\\n         'TopSubjects' AS Reason\\n  FROM TopSubjects ts\\n  UNION ALL\\n  SELECT s2014.SUBJECT_TITLE,\\n         NULL AS DEPARTMENT_NAME,\\n         NULL AS material_count,\\n         s2014.OFFER_DEPT_NAME,\\n         s2014.RESPONSIBLE_FACULTY_NAME,\\n         s2014.TIP_MATERIAL_STATUS_KEY,\\n         s2014.TOTAL_UNITS,\\n         s2014.window_column,\\n         'Subjects2014FA' AS Reason\\n  FROM Subjects2014FA s2014\\n)\\nSELECT c.SUBJECT_TITLE,\\n       c.DEPARTMENT_NAME,\\n       c.material_count,\\n       c.OFFER_DEPT_NAME,\\n       c.RESPONSIBLE_FACULTY_NAME,\\n       c.TIP_MATERIAL_STATUS_KEY,\\n       c.TOTAL_UNITS,\\n       c.window_column,\\n       sd.SCHOOL_NAME,\\n       ad.DEPARTMENT_PHONE_NUMBER,\\n       c.Reason\\nFROM CombinedSubjects c\\nLEFT JOIN SIS_DEPARTMENT sd ON COALESCE(c.DEPARTMENT_NAME, c.OFFER_DEPT_NAME) = sd.DEPARTMENT_NAME\\nLEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE\\nORDER BY c.SUBJECT_TITLE\"}"
