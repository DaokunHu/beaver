    {
      "role": "tool",
      "tool_call_id": "call_017678e654ba4b60ae1ad54c",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_2591\", \"name\": \"2014FA Enrolled Library Subjects with TIP Material Status and 3-Row Min Total Units\", \"desc\": \"For all subjects in the 2014FA term with at least one enrolled student, show the subject title, offering department name, responsible faculty name, the TIP material status key, the total number of units, and the minimum total number of units in a window of 3 preceding and 1 following row ordered by the course number, along with the cluster type description and the HGN code description for each subject. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT lso.SUBJECT_TITLE, lso.OFFER_DEPT_NAME, lso.RESPONSIBLE_FACULTY_NAME, td.TIP_MATERIAL_STATUS_KEY, sos.TOTAL_UNITS, MIN(sos.TOTAL_UNITS) OVER ( ORDER BY sos.COURSE_NUMBER ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column, sos.SUBJECT_ID FROM LIBRARY_SUBJECT_OFFERED lso JOIN TIP_DETAIL td ON lso.SUBJECT_ID = td.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY sos ON td.SUBJECT_ID = sos.SUBJECT_ID WHERE lso.TERM_CODE = '2014FA' AND lso.NUM_ENROLLED_STUDENTS > 0 ) SELECT inner_cte.SUBJECT_TITLE, inner_cte.OFFER_DEPT_NAME, inner_cte.RESPONSIBLE_FACULTY_NAME, inner_cte.TIP_MATERIAL_STATUS_KEY, inner_cte.TOTAL_UNITS, inner_cte.window_column, sos.CLUSTER_TYPE_DESC, sos.HGN_CODE_DESC FROM inner_cte JOIN SUBJECT_OFFERED_SUMMARY sos ON inner_cte.SUBJECT_ID = sos.SUBJECT_ID AND sos.TERM_CODE = '2014FA'\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2014FA library subject with textbook material matched to its subject offering summary\"}, {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject per inclusion reason\", \"desc\": \"List all subjects that are either offered in the term with code '2025FA' or are offered by departments in the School of Engineering with a total of at least 6 units. For each subject, show the subject ID, subject title, department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, the running sum of total units within each school, and the reason for inclusion ('2025FA Subjects' for subjects offered in the term '2025FA' and 'Engineering 6+ Units' for subjects offered by Engineering departments with at least 6 units), ordered by subject ID. Do not return any rounded answers.\", \"id\": \"dw_3268\", \"name\": \"Union of 2025FA Offered Subjects and Engineering 6+ Unit Subjects with Running Unit Sums\", \"sql\": \"WITH Subquery1 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TERM_START_DATE, t1.TERM_END_DATE, t2.TERM_PARAMETER, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_students_per_dept, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2025FA' ORDER BY t0.OFFER_DEPT_NAME ), Subquery2 AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t0.DEPARTMENT_NAME, SUM(t1.TOTAL_UNITS) OVER (PARTITION BY t0.SCHOOL_NAME ORDER BY t1.SUBJECT_ID) AS window_column, t1.OFFER_DEPT_CODE FROM SIS_DEPARTMENT t0 JOIN SUBJECT_OFFERED_SUMMARY t1 ON t0.DEPARTMENT_CODE = t1.OFFER_DEPT_CODE WHERE t0.SCHOOL_NAME = 'Engineering' AND t1.TOTAL_UNITS >= 6 ), CombinedSubjects AS ( SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME AS DEPARTMENT_NAME, s1.NUM_ENROLLED_STUDENTS, s1.TERM_DESCRIPTION, s1.ACADEMIC_YEAR, s1.TERM_START_DATE, s1.TERM_END_DATE, s1.TERM_PARAMETER, s1.min_enrolled_students_per_dept, NULL AS window_column, '2025FA Subjects' AS Reason FROM Subquery1 s1 UNION ALL SELECT s2.SUBJECT_ID, s2.SUBJECT_TITLE, s2.DEPARTMENT_NAME, NULL AS NUM_ENROLLED_STUDENTS, NULL AS TERM_DESCRIPTION, NULL AS ACADEMIC_YEAR, NULL AS TERM_START_DATE, NULL AS TERM_END_DATE, NULL AS TERM_PARAMETER, NULL AS min_enrolled_students_per_dept, s2.window_column, 'Engineering 6+ Units' AS Reason FROM Subquery2 s2 ) SELECT * FROM CombinedSubjects ORDER BY SUBJECT_ID;\"}, {\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics library subject in regular terms\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\", \"id\": \"dw_4724\", \"name\": \"Mathematics Library Regular-Term Subjects 3-Row Max Units with Required Material Department Statistics\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t2.SUBJECT_SHORT_TITLE, MAX(t2.TOTAL_UNITS) OVER (ORDER BY t0.SUBJECT_ID ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS MAX_TOTAL_UNITS, t0.SUBJECT_ID, t0.OFFER_DEPT_NAME AS SUB1_OFFER_DEPT_NAME, t0.OFFER_SCHOOL_NAME AS SUB1_OFFER_SCHOOL_NAME, t0.RESPONSIBLE_FACULTY_NAME FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t1.IS_REGULAR_TERM = 'Y' ), Sub2 AS ( SELECT tso.OFFER_DEPT_NAME, tso.OFFER_SCHOOL_NAME, COUNT(DISTINCT tso.SUBJECT_ID) AS subject_count, MIN(sos.TOTAL_UNITS) AS min_total_units FROM TIP_SUBJECT_OFFERED tso JOIN TIP_DETAIL td ON tso.SUBJECT_ID = td.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY sos ON td.SUBJECT_ID = sos.SUBJECT_ID WHERE td.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY tso.OFFER_DEPT_NAME, tso.OFFER_SCHOOL_NAME ) SELECT icte.SUBJECT_TITLE, icte.NUM_ENROLLED_STUDENTS, icte.OFFER_DEPT_NAME, icte.TERM_DESCRIPTION, icte.ACADEMIC_YEAR, icte.SUBJECT_SHORT_TITLE, icte.MAX_TOTAL_UNITS, s2.subject_count, s2.min_total_units, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.SCHOOL_NAME AS school_name, icte.RESPONSIBLE_FACULTY_NAME FROM inner_cte icte LEFT JOIN Sub2 s2 ON icte.SUB1_OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME AND icte.SUB1_OFFER_SCHOOL_NAME = s2.OFFER_SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON icte.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE\"}, {\"id\": \"dw_4208\", \"name\": \"2016SP Engineering School Subject Row Numbers Matched with 2017JA TIP Subject Enrollment Windows\", \"desc\": \"For subjects offered in the term '2016SP' with a school code of 'E', and for subjects offered in the term '2017JA', show the subject title, department name, course description, the number of enrolled students in 2016SP, the row number within a window of 2 preceding and 1 following rows ordered by subject title, the number of enrolled students in 2017JA, the offering department name, department full name, subject code, subject code description, the minimum number of enrolled students over each subject code group in 2017JA, the school name, and the department phone number. Order the results by subject title and subject code. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte1 AS ( SELECT t2.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.COURSE_DESCRIPTION, ROW_NUMBER() OVER (ORDER BY t2.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.COURSE_NUMBER = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.TERM_CODE = '2016SP' AND t0.SCHOOL_CODE = 'E' ), cte1 AS ( SELECT inner_cte.SUBJECT_TITLE, inner_cte.DEPARTMENT_NAME, inner_cte.COURSE_DESCRIPTION, t2.NUM_ENROLLED_STUDENTS, inner_cte.window_column, t2.OFFER_DEPT_CODE FROM inner_cte1 inner_cte JOIN SUBJECT_OFFERED_SUMMARY t2 ON inner_cte.SUBJECT_TITLE = t2.SUBJECT_TITLE AND t2.TERM_CODE = '2016SP' ), inner_cte2 AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), cte2 AS ( SELECT inner_cte.SUBJECT_TITLE, inner_cte.NUM_ENROLLED_STUDENTS, inner_cte.OFFER_DEPT_NAME, inner_cte.DEPARTMENT_FULL_NAME, inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.window_column, sd.SCHOOL_NAME, ad.DEPARTMENT_PHONE_NUMBER, sd.DEPARTMENT_CODE FROM inner_cte2 inner_cte LEFT JOIN SIS_DEPARTMENT sd ON inner_cte.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ) SELECT cte1.SUBJECT_TITLE, cte1.DEPARTMENT_NAME, cte1.COURSE_DESCRIPTION, cte1.NUM_ENROLLED_STUDENTS AS NUM_ENROLLED_STUDENTS_2016SP, cte1.window_column AS WINDOW_COLUMN_2016SP, cte2.NUM_ENROLLED_STUDENTS AS NUM_ENROLLED_STUDENTS_2017JA, cte2.OFFER_DEPT_NAME, cte2.DEPARTMENT_FULL_NAME, cte2.SUBJECT_CODE, cte2.SUBJECT_CODE_DESC, cte2.window_column AS MIN_ENROLLED_STUDENTS_OVER_SUBJECT_CODE_2017JA, cte2.SCHOOL_NAME, cte2.DEPARTMENT_PHONE_NUMBER FROM cte1 JOIN cte2 ON cte1.OFFER_DEPT_CODE = cte2.DEPARTMENT_CODE ORDER BY cte1.SUBJECT_TITLE, cte2.SUBJECT_CODE;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2016SP Engineering-school subject matched with a 2017JA TIP subject of the same offer department\"}], \"not_found\": []}"
