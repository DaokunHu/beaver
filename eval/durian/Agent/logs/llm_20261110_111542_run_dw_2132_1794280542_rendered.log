    {
      "role": "tool",
      "tool_call_id": "call_a59783030e9e4f088b40fc04",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_4527\", \"name\": \"2021 Engineering Degree-Granting Department Enrollment Dispersion with Above-Average Subject Details\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only subjects with a non-null subject code description), and, for each subject in 2021 offered by these departments in the School of Engineering, list the subject id, subject title, and the number of enrolled students, but only include subjects where the number of enrolled students exceeds the average enrollment for that department in 2021. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH eng_dept_2021_summary AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), dept_enrollment_stats AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, VARIANCE(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_variance, STDDEV(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_stddev FROM TIP_SUBJECT_OFFERED t JOIN SIS_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.SUBJECT_CODE_DESC IS NOT NULL GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME ) SELECT e.DEPARTMENT_CODE, e.DEPARTMENT_NAME, e.DEPARTMENT_FULL_NAME, e.subject_count, e.total_enrollment, d.enrolled_students_variance, d.enrolled_students_stddev FROM eng_dept_2021_summary e JOIN dept_enrollment_stats d ON e.DEPARTMENT_CODE = d.DEPARTMENT_CODE ), dept_avg_enrollment AS ( SELECT s.OFFER_DEPT_CODE, AVG(s.NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM SUBJECT_OFFERED_SUMMARY s JOIN SIS_DEPARTMENT d ON s.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY s.OFFER_DEPT_CODE ) SELECT i.DEPARTMENT_CODE, i.DEPARTMENT_NAME, i.DEPARTMENT_FULL_NAME, i.subject_count, i.total_enrollment, i.enrolled_students_variance, i.enrolled_students_stddev, s.SUBJECT_ID, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS FROM inner_cte i JOIN SUBJECT_OFFERED_SUMMARY s ON i.DEPARTMENT_CODE = s.OFFER_DEPT_CODE JOIN dept_avg_enrollment a ON s.OFFER_DEPT_CODE = a.OFFER_DEPT_CODE WHERE s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' AND s.NUM_ENROLLED_STUDENTS > a.avg_enrollment ORDER BY i.DEPARTMENT_CODE, s.NUM_ENROLLED_STUDENTS DESC;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2021 Engineering subject with above-department-average enrollment within its degree-granting department summary\"}, {\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per top-enrolled Fall 2024-2025 subject in high-average-unit departments\", \"desc\": \"For the top 10 subjects offered in the term with the description \\\"Fall Term 2024-2025\\\" that have the highest number of enrolled students, display each subject's offered key, subject title, offering department name, the term description, the number of enrolled students, and the rank of each subject within its offering department (ordered by subject offered key), but only include subjects where the offering department is among those that, in the term with code '2022SU', had an average total units for their subjects greater than the average total units for all subjects offered in that term. List the subject offered key, subject title, offering department name, term description, number of enrolled students, and the rank within the department, in that order, and order the results by department name and number of enrolled students descending. Do not return any rounded answers.\", \"id\": \"dw_4305\", \"name\": \"Top 10 Fall 2024-2025 Enrolled Subjects in Departments with Above-Average 2022SU Units\", \"sql\": \"WITH TopSubjects AS ( WITH inner_cte AS ( SELECT t0.TIP_SUBJECT_OFFERED_KEY, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t0.NUM_ENROLLED_STUDENTS, RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.TIP_SUBJECT_OFFERED_KEY) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_DESCRIPTION = 'Fall Term 2024-2025' ) SELECT icte.TIP_SUBJECT_OFFERED_KEY, icte.SUBJECT_TITLE, icte.OFFER_DEPT_NAME, icte.TERM_DESCRIPTION, icte.NUM_ENROLLED_STUDENTS, icte.window_column FROM inner_cte icte ORDER BY icte.NUM_ENROLLED_STUDENTS DESC LIMIT 10 ), HighAvgUnitDepartments AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, dense_rank() OVER (ORDER BY t1.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) SELECT t2.DEPARTMENT_NAME, AVG(t2.TOTAL_UNITS) AS avg_total_units FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t0.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2022SU' GROUP BY t2.DEPARTMENT_NAME HAVING AVG(t2.TOTAL_UNITS) > ( SELECT AVG(t3.TOTAL_UNITS) FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t3 ON t0.TERM_CODE = t3.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) ) SELECT ts.TIP_SUBJECT_OFFERED_KEY, ts.SUBJECT_TITLE, ts.OFFER_DEPT_NAME, ts.TERM_DESCRIPTION, ts.NUM_ENROLLED_STUDENTS, ts.window_column FROM TopSubjects ts WHERE ts.OFFER_DEPT_NAME IN (SELECT had.DEPARTMENT_NAME FROM HighAvgUnitDepartments had) ORDER BY ts.OFFER_DEPT_NAME, ts.NUM_ENROLLED_STUDENTS DESC;\"}, {\"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering catalog subject matched with 2017JA TIP offering\", \"desc\": \"For subjects offered by departments in the School of Engineering that are also offered in the term '2017JA', show the subject title, total units, department full name, the row number within a window of 2 preceding and 1 following rows ordered by subject title, number of enrolled students, offering department name, department full name for the term, subject code, subject code description, and the minimum number of enrolled students over each subject code group, ordered by subject title and subject code. Do not return any rounded answers.\", \"id\": \"dw_3236\", \"name\": \"Engineering Catalog Subjects Row Numbers Matched with 2017JA TIP Enrollment Windows\", \"sql\": \"WITH EngSubjects AS ( SELECT t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t0.DEPARTMENT_FULL_NAME, ROW_NUMBER() OVER (ORDER BY t1.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DEPARTMENT_CODE FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_NAME = 'Engineering' ), TermSubjects AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ) SELECT es.SUBJECT_TITLE, es.TOTAL_UNITS, es.DEPARTMENT_FULL_NAME, es.window_column AS eng_window_row_number, ts.NUM_ENROLLED_STUDENTS, ts.OFFER_DEPT_NAME, ts.DEPARTMENT_FULL_NAME AS term_dept_full_name, ts.SUBJECT_CODE, ts.SUBJECT_CODE_DESC, ts.window_column AS min_enrolled_by_code FROM EngSubjects es JOIN TermSubjects ts ON es.SUBJECT_TITLE = ts.SUBJECT_TITLE AND es.DEPARTMENT_CODE = ts.OFFER_DEPT_CODE ORDER BY es.SUBJECT_TITLE, ts.SUBJECT_CODE\"}], \"not_found\": []}"
    },
