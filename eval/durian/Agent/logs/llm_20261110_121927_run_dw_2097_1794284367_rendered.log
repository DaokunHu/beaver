    {
      "role": "tool",
      "tool_call_id": "call_32450a4b47b747d9a2b2349b",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per top-enrolled Fall 2024-2025 subject in high-average-unit departments\", \"desc\": \"For the top 10 subjects offered in the term with the description \\\"Fall Term 2024-2025\\\" that have the highest number of enrolled students, display each subject's offered key, subject title, offering department name, the term description, the number of enrolled students, and the rank of each subject within its offering department (ordered by subject offered key), but only include subjects where the offering department is among those that, in the term with code '2022SU', had an average total units for their subjects greater than the average total units for all subjects offered in that term. List the subject offered key, subject title, offering department name, term description, number of enrolled students, and the rank within the department, in that order, and order the results by department name and number of enrolled students descending. Do not return any rounded answers.\", \"id\": \"dw_4305\", \"name\": \"Top 10 Fall 2024-2025 Enrolled Subjects in Departments with Above-Average 2022SU Units\", \"sql\": \"WITH TopSubjects AS ( WITH inner_cte AS ( SELECT t0.TIP_SUBJECT_OFFERED_KEY, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t0.NUM_ENROLLED_STUDENTS, RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.TIP_SUBJECT_OFFERED_KEY) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_DESCRIPTION = 'Fall Term 2024-2025' ) SELECT icte.TIP_SUBJECT_OFFERED_KEY, icte.SUBJECT_TITLE, icte.OFFER_DEPT_NAME, icte.TERM_DESCRIPTION, icte.NUM_ENROLLED_STUDENTS, icte.window_column FROM inner_cte icte ORDER BY icte.NUM_ENROLLED_STUDENTS DESC LIMIT 10 ), HighAvgUnitDepartments AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, dense_rank() OVER (ORDER BY t1.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) SELECT t2.DEPARTMENT_NAME, AVG(t2.TOTAL_UNITS) AS avg_total_units FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t0.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2022SU' GROUP BY t2.DEPARTMENT_NAME HAVING AVG(t2.TOTAL_UNITS) > ( SELECT AVG(t3.TOTAL_UNITS) FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t3 ON t0.TERM_CODE = t3.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) ) SELECT ts.TIP_SUBJECT_OFFERED_KEY, ts.SUBJECT_TITLE, ts.OFFER_DEPT_NAME, ts.TERM_DESCRIPTION, ts.NUM_ENROLLED_STUDENTS, ts.window_column FROM TopSubjects ts WHERE ts.OFFER_DEPT_NAME IN (SELECT had.DEPARTMENT_NAME FROM HighAvgUnitDepartments had) ORDER BY ts.OFFER_DEPT_NAME, ts.NUM_ENROLLED_STUDENTS DESC;\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject code matched with 2022FA subject\", \"desc\": \"For each subject in a department where the school code and subject title are not null, and for each subject offered in the 2022FA term with total units greater than the average for that term, display the subject code, subject code description, department name, subject title, the number of subjects in the same department, the subject ID, the term description, and the running sum of total units for that academic year, ordered by subject ID. Do not return any rounded answers.\", \"id\": \"dw_3867\", \"name\": \"Subject Code Department Counts Matched with 2022FA Above-Average Unit Running Sums\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SUBJECT_TITLE, t0.DEPARTMENT_CODE FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL ) SELECT inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.DEPARTMENT_NAME, inner_cte.SUBJECT_TITLE, dept_counts.subjects_in_department, inner_cte.DEPARTMENT_CODE FROM inner_cte JOIN ( SELECT t0.DEPARTMENT_CODE, COUNT(*) AS subjects_in_department FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL GROUP BY t0.DEPARTMENT_CODE ) dept_counts ON inner_cte.DEPARTMENT_CODE = dept_counts.DEPARTMENT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t1.DEPARTMENT_NAME, t0.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TOTAL_UNITS FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TERM_CODE = '2022FA' ) SELECT SUBJECT_ID, DEPARTMENT_NAME, TERM_DESCRIPTION, SUM(TOTAL_UNITS) OVER (PARTITION BY ACADEMIC_YEAR ORDER BY SUBJECT_ID) AS window_column, ACADEMIC_YEAR, TOTAL_UNITS FROM inner_cte WHERE TOTAL_UNITS > ( SELECT AVG(TOTAL_UNITS) FROM COURSE_CATALOG_SUBJECT_OFFERED WHERE TERM_CODE = '2022FA' ) ORDER BY SUBJECT_ID ) SELECT subq1.SUBJECT_CODE, subq1.SUBJECT_CODE_DESC, subq1.DEPARTMENT_NAME, subq1.SUBJECT_TITLE, subq1.subjects_in_department, subq2.SUBJECT_ID, subq2.TERM_DESCRIPTION, subq2.window_column FROM subq1 JOIN CIS_COURSE_CATALOG ccc ON subq1.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE JOIN subq2 ON ccc.SUBJECT_ID = subq2.SUBJECT_ID ORDER BY subq2.SUBJECT_ID;\"}, {\"id\": \"dw_1689\", \"name\": \"School Highest Department Average TIP Enrollment with 2019FA Chemistry Course-Material Subject Dense Ranks\", \"desc\": \"For each school, what is the school name and the highest average number of enrolled students per department (among its degree-granting departments, excluding Chemistry, and only considering subjects with at least one enrolled student), and for each subject offered by the Chemistry department in the 2019FA term that has course materials, what is the subject title, the dense rank of the subject considering the current and 2 preceding rows ordered by the number of enrolled students descending, the full name of the offering department, and the school name of the Chemistry department? List the school name and highest average enrolled students per department first, followed by the Chemistry subject title, dense rank, department full name, and Chemistry school name. Do not return any rounded answers.\", \"sql\": \"WITH dept_enrollment_stats AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, AVG(tso.NUM_ENROLLED_STUDENTS) AS avg_enrolled, MAX(tso.NUM_ENROLLED_STUDENTS) - MIN(tso.NUM_ENROLLED_STUDENTS) AS range_enrolled, VARIANCE(tso.NUM_ENROLLED_STUDENTS) AS var_enrolled FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 AND tso.OFFER_DEPT_NAME <> 'Chemistry' GROUP BY sd.DEPARTMENT_NAME, sd.SCHOOL_NAME ), school_max_avg_enrollment AS ( SELECT SCHOOL_NAME, MAX(avg_enrolled) AS highest_avg_enrolled_per_dept FROM dept_enrollment_stats GROUP BY SCHOOL_NAME ), chemistry_subjects_ranked AS ( SELECT inner_cte.SUBJECT_TITLE, inner_cte.dense_rank_num_enrolled, inner_cte.DEPARTMENT_FULL_NAME, sd.SCHOOL_NAME FROM ( SELECT tso.SUBJECT_TITLE, DENSE_RANK() OVER ( ORDER BY tso.NUM_ENROLLED_STUDENTS DESC ROWS BETWEEN 2 PRECEDING AND CURRENT ROW ) AS dense_rank_num_enrolled, sd.DEPARTMENT_FULL_NAME, tso.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED tso JOIN STUDENT_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE WHERE tso.TERM_CODE = '2019FA' AND tso.OFFER_DEPT_NAME = 'Chemistry' AND tso.IS_NO_COURSE_MATERIAL = 'N' ) inner_cte JOIN STUDENT_DEPARTMENT sd ON inner_cte.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE ) SELECT smax.SCHOOL_NAME, smax.highest_avg_enrolled_per_dept, csr.SUBJECT_TITLE, csr.dense_rank_num_enrolled, csr.DEPARTMENT_FULL_NAME, csr.SCHOOL_NAME AS chemistry_school_name FROM school_max_avg_enrollment smax CROSS JOIN chemistry_subjects_ranked csr;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per school-level highest department average enrollment cross joined with each 2019FA Chemistry TIP subject having course materials\"}], \"not_found\": []}"
