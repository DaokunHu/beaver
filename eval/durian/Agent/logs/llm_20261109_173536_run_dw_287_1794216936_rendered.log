            "name": "submit_SQL",
            "arguments": "{\"sql\": \"WITH dept_avg AS (\\n    SELECT AVG(s.NUM_ENROLLED_STUDENTS) AS avg_enrolled\\n    FROM SUBJECT_OFFERED_SUMMARY s\\n    JOIN SIS_DEPARTMENT d ON s.OFFER_DEPT_CODE = d.DEPARTMENT_CODE\\n    WHERE d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18'\\n)\\nSELECT d.DEPARTMENT_NAME,\\n       s.SUBJECT_TITLE,\\n       s.NUM_ENROLLED_STUDENTS,\\n       d.SCHOOL_NAME,\\n       DENSE_RANK() OVER (PARTITION BY d.DEPARTMENT_CODE ORDER BY d.DEPARTMENT_CODE) AS window_column\\nFROM SUBJECT_OFFERED_SUMMARY s\\nJOIN SIS_DEPARTMENT d ON s.OFFER_DEPT_CODE = d.DEPARTMENT_CODE\\nCROSS JOIN dept_avg a\\nWHERE d.DEPARTMENT_NAME = 'Mathematics'\\n  AND d.DEPARTMENT_CODE = '18'\\n  AND s.NUM_ENROLLED_STUDENTS > 0\\n  AND d.IS_DEGREE_GRANTING = 'Y'\\n  AND s.NUM_ENROLLED_STUDENTS > a.avg_enrolled\"}"
