    {
      "role": "tool",
      "tool_call_id": "call_22eec20d4b9a4d48b1093b76",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_1689\", \"name\": \"School Highest Department Average TIP Enrollment with 2019FA Chemistry Course-Material Subject Dense Ranks\", \"desc\": \"For each school, what is the school name and the highest average number of enrolled students per department (among its degree-granting departments, excluding Chemistry, and only considering subjects with at least one enrolled student), and for each subject offered by the Chemistry department in the 2019FA term that has course materials, what is the subject title, the dense rank of the subject considering the current and 2 preceding rows ordered by the number of enrolled students descending, the full name of the offering department, and the school name of the Chemistry department? List the school name and highest average enrolled students per department first, followed by the Chemistry subject title, dense rank, department full name, and Chemistry school name. Do not return any rounded answers.\", \"sql\": \"WITH dept_enrollment_stats AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, AVG(tso.NUM_ENROLLED_STUDENTS) AS avg_enrolled, MAX(tso.NUM_ENROLLED_STUDENTS) - MIN(tso.NUM_ENROLLED_STUDENTS) AS range_enrolled, VARIANCE(tso.NUM_ENROLLED_STUDENTS) AS var_enrolled FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 AND tso.OFFER_DEPT_NAME <> 'Chemistry' GROUP BY sd.DEPARTMENT_NAME, sd.SCHOOL_NAME ), school_max_avg_enrollment AS ( SELECT SCHOOL_NAME, MAX(avg_enrolled) AS highest_avg_enrolled_per_dept FROM dept_enrollment_stats GROUP BY SCHOOL_NAME ), chemistry_subjects_ranked AS ( SELECT inner_cte.SUBJECT_TITLE, inner_cte.dense_rank_num_enrolled, inner_cte.DEPARTMENT_FULL_NAME, sd.SCHOOL_NAME FROM ( SELECT tso.SUBJECT_TITLE, DENSE_RANK() OVER ( ORDER BY tso.NUM_ENROLLED_STUDENTS DESC ROWS BETWEEN 2 PRECEDING AND CURRENT ROW ) AS dense_rank_num_enrolled, sd.DEPARTMENT_FULL_NAME, tso.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED tso JOIN STUDENT_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE WHERE tso.TERM_CODE = '2019FA' AND tso.OFFER_DEPT_NAME = 'Chemistry' AND tso.IS_NO_COURSE_MATERIAL = 'N' ) inner_cte JOIN STUDENT_DEPARTMENT sd ON inner_cte.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE ) SELECT smax.SCHOOL_NAME, smax.highest_avg_enrolled_per_dept, csr.SUBJECT_TITLE, csr.dense_rank_num_enrolled, csr.DEPARTMENT_FULL_NAME, csr.SCHOOL_NAME AS chemistry_school_name FROM school_max_avg_enrollment smax CROSS JOIN chemistry_subjects_ranked csr;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per school-level highest department average enrollment cross joined with each 2019FA Chemistry TIP subject having course materials\"}, {\"id\": \"dw_1954\", \"name\": \"2019FA Chemistry TIP Subjects Windowed Min Enrollment with Department Subject Code Statistics\", \"desc\": \"For subjects offered in the term '2019FA' with more than 0 enrolled students, offered by the Chemistry department (Course 5), and only including courses that have course materials, show the subject title, offering department name, school name, department full name, and the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department name. Additionally, for the same department, provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the number of unique subject codes associated with its courses that are offered by degree-granting departments, but only include departments other than 'Mathematics' (Course 18). Also, for each of these departments, show the total number of courses offered by the department in the '2019FA' term that have at least one enrolled student and have course materials. Present the subject title, offering department name, school name, department full name, windowed minimum enrolled students, department name, average number of unique subject codes, standard deviation (using STDDEV only and never STDDEV_POP) of unique subject codes, and the total number of such courses, in that order. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.OFFER_SCHOOL_NAME, t1.DEPARTMENT_FULL_NAME, MIN(t0.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.DEPARTMENT_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT t2 ON t1.DEPARTMENT_CODE = t2.SIS_ADMIN_DEPARTMENT_CODE WHERE t0.TERM_CODE = '2019FA' AND t0.NUM_ENROLLED_STUDENTS > 0 AND t0.OFFER_DEPT_NAME = 'Chemistry' AND t0.IS_NO_COURSE_MATERIAL = 'N' ), course_counts AS ( SELECT t1.DEPARTMENT_CODE, COUNT(DISTINCT t0.MASTER_COURSE_NUMBER) AS total_courses FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2019FA' AND t0.NUM_ENROLLED_STUDENTS > 0 AND t0.IS_NO_COURSE_MATERIAL = 'N' GROUP BY t1.DEPARTMENT_CODE ), subject_code_stats AS ( SELECT d.DEPARTMENT_NAME, AVG(subj_count) AS avg_subject_codes, STDDEV(subj_count) AS stddev_subject_codes, d.DEPARTMENT_CODE FROM ( SELECT cd.DEPARTMENT, COUNT(DISTINCT sc.SUBJECT_CODE) AS subj_count FROM SIS_COURSE_DESCRIPTION cd JOIN SIS_DEPARTMENT d ON cd.DEPARTMENT = d.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE sc ON d.DEPARTMENT_CODE = sc.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_NAME != 'Mathematics' GROUP BY cd.COURSE, cd.DEPARTMENT ) course_subjects JOIN SIS_DEPARTMENT d ON course_subjects.DEPARTMENT = d.DEPARTMENT_CODE WHERE d.DEPARTMENT_CODE != '18' GROUP BY d.DEPARTMENT_NAME, d.DEPARTMENT_CODE ) SELECT icte.SUBJECT_TITLE, icte.OFFER_DEPT_NAME, icte.OFFER_SCHOOL_NAME, icte.DEPARTMENT_FULL_NAME, icte.window_column, scs.DEPARTMENT_NAME, scs.avg_subject_codes, scs.stddev_subject_codes, cc.total_courses FROM inner_cte icte JOIN subject_code_stats scs ON icte.DEPARTMENT_CODE = scs.DEPARTMENT_CODE JOIN course_counts cc ON icte.DEPARTMENT_CODE = cc.DEPARTMENT_CODE ORDER BY icte.SUBJECT_TITLE, scs.avg_subject_codes DESC\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per 2019FA Chemistry TIP subject with course materials matched with department-level subject code statistics\"}, {\"id\": \"dw_1288\", \"name\": \"Math IAP Max Enrollment Variance Rollup with Library and TIP Department Enrollment Totals\", \"desc\": \"For each academic year, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered in that year by the Mathematics department, considering only activities that require advance sign-up and are not cancelled, and also provide the academic year description? For each department, include a grand total for all activities in the format of (department name, null, total variance and stddev). Additionally, for each such department, provide the department code, the department name, and the total number of enrolled students in both the library and tip subject offerings, but only for those departments where the total number of enrolled students is more than one standard deviation (using STDDEV only and never STDDEV_POP) above the mean total enrolled students across all departments, and restrict your answer to departments whose name is 'Mathematics' (Course 18). Also, for each such department, list the names of the responsible faculty members from both the library and tip subject offerings. The columns to display, in order, are: department name, academic year description, total variance, total standard deviation (using STDDEV only and never STDDEV_POP), department code, department name, total enrolled, library faculty, and tip faculty. Do not return any rounded answers.\", \"category\": \"Library Reserve and IAP Activity Comprehensive Analysis\", \"sql\": \"WITH inner_cte1 AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, VARIANCE(isd.MAX_ENROLLMENT) AS max_enrollment_variance, STDDEV(isd.MAX_ENROLLMENT) AS max_enrollment_stddev, ccso.DEPARTMENT_NAME FROM IAP_SUBJECT_DETAIL isd JOIN ACADEMIC_TERMS_ALL ata ON isd.TERM_CODE = ata.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE isd.ENROLLMENT_TYPE = 'Advance sign-up required' AND isd.IS_CANCELLED = 'N' AND isd.MAX_ENROLLMENT IS NOT NULL AND ccso.DEPARTMENT_NAME = 'Mathematics' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, ccso.DEPARTMENT_NAME ), RollupResults AS ( SELECT DEPARTMENT_NAME, ACADEMIC_YEAR_DESC, SUM(max_enrollment_variance) AS total_variance, SUM(max_enrollment_stddev) AS total_stddev FROM inner_cte1 GROUP BY DEPARTMENT_NAME, ACADEMIC_YEAR_DESC WITH ROLLUP HAVING SUM(max_enrollment_variance) IS NOT NULL ), inner_cte2 AS ( SELECT l.OFFER_DEPT_CODE, l.OFFER_DEPT_NAME, SUM(l.NUM_ENROLLED_STUDENTS + t.NUM_ENROLLED_STUDENTS) AS total_enrolled FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_SUBJECT_OFFERED t ON l.MASTER_SUBJECT_ID_SORT = t.MASTER_SUBJECT_ID_SORT WHERE l.OFFER_DEPT_NAME = 'Mathematics' GROUP BY l.OFFER_DEPT_CODE, l.OFFER_DEPT_NAME HAVING SUM(l.NUM_ENROLLED_STUDENTS + t.NUM_ENROLLED_STUDENTS) > ( SELECT AVG(total_sum) + STDDEV(total_sum) FROM ( SELECT SUM(l2.NUM_ENROLLED_STUDENTS + t2.NUM_ENROLLED_STUDENTS) AS total_sum FROM LIBRARY_SUBJECT_OFFERED l2 JOIN TIP_SUBJECT_OFFERED t2 ON l2.MASTER_SUBJECT_ID_SORT = t2.MASTER_SUBJECT_ID_SORT GROUP BY l2.OFFER_DEPT_CODE ) dept_totals ) AND l.OFFER_DEPT_CODE = '18' ) SELECT rr.DEPARTMENT_NAME, rr.ACADEMIC_YEAR_DESC, rr.total_variance, rr.total_stddev, c.OFFER_DEPT_CODE, c.OFFER_DEPT_NAME, c.total_enrolled, l.RESPONSIBLE_FACULTY_NAME AS library_faculty, t.RESPONSIBLE_FACULTY_NAME AS tip_faculty FROM RollupResults rr JOIN inner_cte2 c ON rr.DEPARTMENT_NAME = c.OFFER_DEPT_NAME JOIN LIBRARY_SUBJECT_OFFERED l ON c.OFFER_DEPT_CODE = l.OFFER_DEPT_CODE AND l.OFFER_DEPT_NAME = c.OFFER_DEPT_NAME JOIN TIP_SUBJECT_OFFERED t ON l.MASTER_SUBJECT_ID_SORT = t.MASTER_SUBJECT_ID_SORT WHERE l.OFFER_DEPT_NAME = 'Mathematics' ORDER BY rr.DEPARTMENT_NAME, rr.ACADEMIC_YEAR_DESC, c.OFFER_DEPT_CODE, c.OFFER_DEPT_NAME, c.total_enrolled, l.RESPONSIBLE_FACULTY_NAME, t.RESPONSIBLE_FACULTY_NAME;\", \"default_granularity\": \"one row per department per academic year description plus rollup totals\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per department/school enrollment statistic (plus per-school rollup rows), left joined with Mathematics students named Peter\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\", \"id\": \"dw_1350\", \"name\": \"Degree-Granting Department TIP Enrollment Statistics with School Rollups and Math Peter Student Budget Code Windows\", \"sql\": \"WITH inner_cte1 AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, tso.NUM_ENROLLED_STUDENTS FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 ), DepartmentStats AS ( SELECT DEPARTMENT_NAME, SCHOOL_NAME, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled_students, MAX(NUM_ENROLLED_STUDENTS) - MIN(NUM_ENROLLED_STUDENTS) AS range_enrolled_students, VARIANCE(NUM_ENROLLED_STUDENTS) AS var_enrolled_students, SUM(NUM_ENROLLED_STUDENTS) AS total_enrolled_students FROM inner_cte1 GROUP BY DEPARTMENT_NAME, SCHOOL_NAME ), SchoolRollup AS ( SELECT NULL AS DEPARTMENT_NAME, SCHOOL_NAME, NULL AS avg_enrolled_students, NULL AS range_enrolled_students, NULL AS var_enrolled_students, SUM(total_enrolled_students) AS total_enrolled_students FROM DepartmentStats GROUP BY SCHOOL_NAME ), inner_cte2 AS ( SELECT t1.LAST_NAME, t1.EMAIL_ADDRESS, t1.STUDENT_YEAR, t1.DEPARTMENT_NAME, t0.SCHOOL_NAME, MIN(t0.DEPT_BUDGET_CODE) OVER (ORDER BY t1.FULL_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_DEPARTMENT t0 JOIN MIT_STUDENT_DIRECTORY t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT WHERE t1.FIRST_NAME = 'Peter' AND t0.DEPARTMENT_NAME = 'Mathematics' ) SELECT ds.DEPARTMENT_NAME, ds.SCHOOL_NAME, ds.avg_enrolled_students, ds.range_enrolled_students, ds.var_enrolled_students, ds.total_enrolled_students, ic2.LAST_NAME, ic2.EMAIL_ADDRESS, ic2.STUDENT_YEAR, ic2.window_column, sd.DEPARTMENT_FULL_NAME, sd.DEPARTMENT_LAST_ACTIVITY_DATE FROM (SELECT * FROM DepartmentStats UNION ALL SELECT * FROM SchoolRollup) ds LEFT JOIN inner_cte2 ic2 ON ds.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME AND ds.SCHOOL_NAME = ic2.SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON ds.DEPARTMENT_NAME = sd.DEPARTMENT_NAME ORDER BY ds.SCHOOL_NAME, ds.DEPARTMENT_NAME, ic2.LAST_NAME ;\"}], \"not_found\": []}"
    },
