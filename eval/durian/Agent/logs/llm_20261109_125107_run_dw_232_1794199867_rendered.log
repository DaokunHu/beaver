    {
      "role": "tool",
      "tool_call_id": "call_01c24bffe5b0495c95986b8d",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_1221\", \"name\": \"2014FA Chemistry Library Subjects Windowed Enrollment with Department Reserve Enrollment Average and Normalized Ratio\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, and the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, as well as the average and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in courses with at least one reserved library material and a material status of 'U' offered by either the Chemistry or Biology department, and calculate the normalized enrollment ratio (the number of enrolled students in the library subject divided by the average enrollment for the department, rounded to two decimal places). List the results in descending order of normalized enrollment ratio.\", \"sql\": \"WITH Subquery1 AS ( SELECT l.SUBJECT_TITLE, l.NUM_ENROLLED_STUDENTS, t.RESPONSIBLE_FACULTY_NAME, t.OFFER_DEPT_NAME, MIN(l.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t.RESPONSIBLE_FACULTY_MIT_ID ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t.RESPONSIBLE_FACULTY_MIT_ID FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_SUBJECT_OFFERED t ON l.TERM_CODE = t.TERM_CODE WHERE l.TERM_CODE = '2014FA' AND t.OFFER_DEPT_NAME = 'Chemistry' ), Subquery2 AS ( SELECT t.OFFER_DEPT_NAME, AVG(t.NUM_ENROLLED_STUDENTS) AS avg_enrollment, STDDEV(t.NUM_ENROLLED_STUDENTS) AS enrollment_stddev FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_SUBJECT_OFFERED t ON l.TERM_CODE = t.TERM_CODE WHERE l.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND t.OFFER_DEPT_NAME IN ('Chemistry', 'Biology') GROUP BY t.OFFER_DEPT_NAME ORDER BY enrollment_stddev DESC ) SELECT s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.RESPONSIBLE_FACULTY_NAME, s1.OFFER_DEPT_NAME, s1.window_column, s2.avg_enrollment, s2.enrollment_stddev, ROUND(s1.NUM_ENROLLED_STUDENTS / NULLIF(s2.avg_enrollment, 0), 2) AS normalized_enrollment_ratio FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME ORDER BY normalized_enrollment_ratio DESC;\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2014FA Chemistry library subject offering matched with department-level reserve enrollment statistics\"}, {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Chemistry subject with materials per term\", \"desc\": \"For each subject offered by the Chemistry department (Course 5) that has course materials, show the subject title, term code, offering department name, responsible faculty name, department full name, school name, the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject offered key, along with the minimum academic year and average total units for the corresponding academic term in the Mathematics department, where the academic year is between 2000 and 2020 or the total units are at least 6, and the total units are between 1 and 12. Also, include the term description and the first day of classes for each term from the academic terms table. The results are ordered by term code and subject title. Do not return any rounded answers.\", \"id\": \"dw_2181\", \"name\": \"Chemistry Subjects with Course Materials 3-Row Max Enrollment vs Math Term Unit Statistics\", \"sql\": \"WITH inner_cte AS ( WITH MathTermStats AS ( SELECT s.TERM_CODE, MIN(a.ACADEMIC_YEAR) AS min_academic_year, AVG(s.TOTAL_UNITS) AS avg_total_units FROM SUBJECT_SUMMARY s JOIN ACADEMIC_TERMS_ALL a ON s.TERM_CODE = a.TERM_CODE WHERE s.DEPARTMENT_NAME = 'Mathematics' AND s.TOTAL_UNITS BETWEEN 1 AND 12 AND ( a.ACADEMIC_YEAR BETWEEN 2000 AND 2020 OR s.TOTAL_UNITS >= 6 ) GROUP BY s.TERM_CODE ORDER BY s.TERM_CODE ), ChemistrySubjectStats AS ( SELECT t0.SUBJECT_TITLE, t0.TERM_CODE, t0.OFFER_DEPT_NAME, t0.RESPONSIBLE_FACULTY_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, MAX(t0.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t0.TIP_SUBJECT_OFFERED_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING ) AS max_num_enrolled_students FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.NUM_ENROLLED_STUDENTS >= 0 AND t0.TERM_CODE IS NOT NULL AND t0.OFFER_DEPT_NAME = 'Chemistry' AND t0.IS_NO_COURSE_MATERIAL = 'N' ) SELECT css.SUBJECT_TITLE, css.TERM_CODE, css.OFFER_DEPT_NAME, css.RESPONSIBLE_FACULTY_NAME, css.DEPARTMENT_FULL_NAME, css.SCHOOL_NAME, css.max_num_enrolled_students, mts.min_academic_year, mts.avg_total_units FROM ChemistrySubjectStats css JOIN MathTermStats mts ON css.TERM_CODE = mts.TERM_CODE ) SELECT ic.SUBJECT_TITLE, ic.TERM_CODE, ic.OFFER_DEPT_NAME, ic.RESPONSIBLE_FACULTY_NAME, ic.DEPARTMENT_FULL_NAME, ic.SCHOOL_NAME, ic.max_num_enrolled_students, ic.min_academic_year, ic.avg_total_units, at.TERM_DESCRIPTION, at.FIRST_DAY_OF_CLASSES FROM inner_cte ic JOIN ACADEMIC_TERMS at ON ic.TERM_CODE = at.TERM_CODE ORDER BY ic.TERM_CODE, ic.SUBJECT_TITLE\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per top reserved subject title matched with degree-granting department enrollment dispersion\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', what are the subject title, the offering department name, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only departments that grant degrees and subjects with a non-null subject code description), and the count of reserved materials? Please provide the subject title, the offering department name, the variance, the standard deviation (using STDDEV only and never STDDEV_POP), and the count of reserved materials, in that order. Do not return any rounded answers.\", \"entity_type\": \"metric\", \"id\": \"dw_3356\", \"name\": \"Top 10 Reserved-Material Subjects in 2009SP with Degree-Granting Department Enrollment Variance and Stddev\", \"sql\": \"WITH DepartmentEnrollmentStats AS ( SELECT d.DEPARTMENT_NAME, d.DEPARTMENT_CODE, VARIANCE(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_variance, STDDEV(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_stddev FROM TIP_SUBJECT_OFFERED t JOIN SIS_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.SUBJECT_CODE_DESC IS NOT NULL GROUP BY d.DEPARTMENT_NAME, d.DEPARTMENT_CODE ORDER BY enrolled_students_variance DESC ), TopReservedSubjects AS ( SELECT s.SUBJECT_TITLE, s.OFFER_DEPT_NAME, s.OFFER_DEPT_CODE, COUNT(l.LIBRARY_RESERVE_CATALOG_KEY) AS reserved_materials FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE l.TERM_CODE = '2009SP' GROUP BY s.SUBJECT_TITLE, s.OFFER_DEPT_NAME, s.OFFER_DEPT_CODE ORDER BY reserved_materials DESC LIMIT 10 ) SELECT trs.SUBJECT_TITLE, trs.OFFER_DEPT_NAME, des.enrolled_students_variance, des.enrolled_students_stddev, trs.reserved_materials FROM TopReservedSubjects trs JOIN DepartmentEnrollmentStats des ON trs.OFFER_DEPT_CODE = des.DEPARTMENT_CODE ORDER BY trs.reserved_materials DESC;\"}], \"not_found\": []}"
