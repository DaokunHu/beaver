    {
      "role": "tool",
      "tool_call_id": "call_5658b940829c48ee96056a96",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per department per academic year\", \"desc\": \"For each academic year, among subjects that are not repeatable, what is the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by each department? List the academic year, department name, average enrollment, variance, and standard deviation (using STDDEV only and never STDDEV_POP), ordered by variance descending. Do not return any rounded answers.\", \"id\": \"dw_2958\", \"name\": \"Non-Repeatable Subject Enrollment Average Variance Stddev by Department and Year\", \"sql\": \"WITH inner_cte AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, SUBJECT_OFFERED.OFFER_DEPT_NAME, SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS FROM SUBJECT_OFFERED JOIN ACADEMIC_TERMS ON SUBJECT_OFFERED.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE SUBJECT_OFFERED.IS_REPEATABLE_SUBJECT = 'N' ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.OFFER_DEPT_NAME, AVG(inner_cte.NUM_ENROLLED_STUDENTS) AS avg_enrollment, VARIANCE(inner_cte.NUM_ENROLLED_STUDENTS) AS enrollment_variance, STDDEV(inner_cte.NUM_ENROLLED_STUDENTS) AS enrollment_stddev FROM inner_cte GROUP BY inner_cte.ACADEMIC_YEAR, inner_cte.OFFER_DEPT_NAME ORDER BY enrollment_variance DESC;\"}, {\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per subject with textbooks\", \"desc\": \"For subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook, show the subject code, subject number, department name, subject title, term description, total units, the average subject enrollment number in a window of 2 preceding and 2 following rows grouped by department code and ordered by total units, the textbook material key, the textbook material status key, and the row number of the course within each department ordered by subject code. List the results in order by department name, subject code, and subject number. Do not return any rounded answers.\", \"id\": \"dw_3493\", \"name\": \"2022 12-Unit Subjects with Required or Optional Textbooks and Enrollment Windows\", \"sql\": \"WITH SubjectUnitsWindow AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ), CourseTextbookWindow AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t2.TIP_MATERIAL_KEY, t2.TIP_MATERIAL_STATUS_KEY, ROW_NUMBER() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.ACADEMIC_YEAR = 2022 AND t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') ) SELECT s.SUBJECT_CODE, s.SUBJECT_NUMBER, s.DEPARTMENT_NAME, s.SUBJECT_TITLE, s.TERM_DESCRIPTION, s.TOTAL_UNITS, s.window_column AS avg_enrollment_window, c.TIP_MATERIAL_KEY, c.TIP_MATERIAL_STATUS_KEY, c.window_column AS textbook_row_number FROM SubjectUnitsWindow s JOIN CourseTextbookWindow c ON s.SUBJECT_CODE = c.SUBJECT_CODE AND s.SUBJECT_NUMBER = c.SUBJECT_NUMBER AND s.DEPARTMENT_NAME = c.DEPARTMENT_NAME AND s.SUBJECT_TITLE = c.SUBJECT_TITLE AND s.TERM_DESCRIPTION = c.TERM_DESCRIPTION AND s.TERM_CODE = c.TERM_CODE AND s.SUBJECT_ID = c.SUBJECT_ID ORDER BY s.DEPARTMENT_NAME, s.SUBJECT_CODE, s.SUBJECT_NUMBER;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department per subject code\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\", \"id\": \"dw_4756\", \"name\": \"Department Course Counts with 2022 12-Unit Subjects Having Textbooks\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ) SELECT sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL, Total_Courses.Total_Courses, COALESCE(SubjectsWithTextbooks.Subjects_With_Textbooks, 0) AS Subjects_With_Textbooks_2022_12units FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER JOIN ( SELECT sd.DEPARTMENT_NAME, COUNT(DISTINCT COURSE_NUMBER) AS Total_Courses FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER GROUP BY sd.DEPARTMENT_NAME ) AS Total_Courses ON sd.DEPARTMENT_NAME = Total_Courses.DEPARTMENT_NAME LEFT JOIN ( SELECT s1.DEPARTMENT_NAME, COUNT(DISTINCT s1.SUBJECT_CODE || '-' || s1.SUBJECT_NUMBER) AS Subjects_With_Textbooks FROM inner_cte s1 JOIN TIP_DETAIL t2 ON s1.TERM_CODE = t2.TERM_CODE AND s1.SUBJECT_ID = t2.SUBJECT_ID WHERE t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') GROUP BY s1.DEPARTMENT_NAME ) AS SubjectsWithTextbooks ON sd.DEPARTMENT_NAME = SubjectsWithTextbooks.DEPARTMENT_NAME ;\"}, {\"id\": \"dw_4527\", \"name\": \"2021 Engineering Degree-Granting Department Enrollment Dispersion with Above-Average Subject Details\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only subjects with a non-null subject code description), and, for each subject in 2021 offered by these departments in the School of Engineering, list the subject id, subject title, and the number of enrolled students, but only include subjects where the number of enrolled students exceeds the average enrollment for that department in 2021. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH eng_dept_2021_summary AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), dept_enrollment_stats AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, VARIANCE(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_variance, STDDEV(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_stddev FROM TIP_SUBJECT_OFFERED t JOIN SIS_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.SUBJECT_CODE_DESC IS NOT NULL GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME ) SELECT e.DEPARTMENT_CODE, e.DEPARTMENT_NAME, e.DEPARTMENT_FULL_NAME, e.subject_count, e.total_enrollment, d.enrolled_students_variance, d.enrolled_students_stddev FROM eng_dept_2021_summary e JOIN dept_enrollment_stats d ON e.DEPARTMENT_CODE = d.DEPARTMENT_CODE ), dept_avg_enrollment AS ( SELECT s.OFFER_DEPT_CODE, AVG(s.NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM SUBJECT_OFFERED_SUMMARY s JOIN SIS_DEPARTMENT d ON s.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY s.OFFER_DEPT_CODE ) SELECT i.DEPARTMENT_CODE, i.DEPARTMENT_NAME, i.DEPARTMENT_FULL_NAME, i.subject_count, i.total_enrollment, i.enrolled_students_variance, i.enrolled_students_stddev, s.SUBJECT_ID, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS FROM inner_cte i JOIN SUBJECT_OFFERED_SUMMARY s ON i.DEPARTMENT_CODE = s.OFFER_DEPT_CODE JOIN dept_avg_enrollment a ON s.OFFER_DEPT_CODE = a.OFFER_DEPT_CODE WHERE s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' AND s.NUM_ENROLLED_STUDENTS > a.avg_enrollment ORDER BY i.DEPARTMENT_CODE, s.NUM_ENROLLED_STUDENTS DESC;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2021 Engineering subject with above-department-average enrollment within its degree-granting department summary\"}], \"not_found\": []}"
    },
