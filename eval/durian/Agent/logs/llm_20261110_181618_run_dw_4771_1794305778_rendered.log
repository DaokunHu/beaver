      ]
    },
    {
      "role": "tool",
      "tool_call_id": "call_1d7113aec99d4d60b069a120",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 77, \"items_by_type\": {\"table\": [{\"id\": \"TIP_DETAIL\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\"}, {\"id\": \"LIBRARY_SUBJECT_OFFERED\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\"}, {\"id\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\"}, {\"id\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\"}, {\"id\": \"CIS_COURSE_CATALOG\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\"}, {\"id\": \"TIP_MATERIAL\", \"desc\": \"TIP material dimension table describing textbook materials: title, author, edition, publisher, year, ISBN, new/used shelf prices and rental prices, and information source. Referenced by TIP_DETAIL via TIP_MATERIAL_KEY.\"}, {\"id\": \"LIBRARY_COURSE_INSTRUCTOR\", \"desc\": \"Library course instructor table recording instructors of courses with library reserve materials, including course name, instructor name, department (in 'COURSE_NUMBER - Department Name' format), assignment date range, and library organizational unit/branch. Referenced by LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_COURSE_INSTRUCTOR_KEY; instructor names resolve to person records via INSTRUCTOR_NAME = SE_PERSON.FULL_NAME.\"}, {\"id\": \"STUDENT_DEPARTMENT\", \"desc\": \"Student-facing department lookup table with department code, name, full name, and school attribution (code and name). Similar in content to SIS_DEPARTMENT but oriented to student information systems reporting; joins to offering tables via DEPARTMENT_CODE.\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\"}, {\"id\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\"}, {\"id\": \"SIS_SUBJECT_CODE\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\"}, {\"id\": \"SUBJECT_OFFERED\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\"}, {\"id\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"desc\": \"Library reserve material detail bridge table linking reserve catalog items, library subject offerings, course instructors, and material status per term. Used to count reserved materials per subject and to filter by library material status (e.g. 'U').\"}, {\"id\": \"TIP_MATERIAL_STATUS\", \"desc\": \"TIP material status lookup table decoding material status keys/codes used in TIP_DETAIL. Holds 12 status rows where key and code are identical: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and four keys ('NL', 'NS', 'NB', and a blank/space key) that share a NULL description.\"}, {\"id\": \"MIT_STUDENT_DIRECTORY\", \"desc\": \"Student directory table: one row per student with name components, full name, office location and phone, email address, department code and department name, and student year. The DEPARTMENT column stores the academic department code and joins to SIS_DEPARTMENT.DEPARTMENT_CODE, enabling per-department student counts.\"}, {\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\"}, {\"id\": \"LIBRARY_MATERIAL_STATUS\", \"desc\": \"Library material status lookup table decoding library material status keys/codes used in LIBRARY_RESERVE_MATRL_DETAIL. Holds six statuses where key and code are identical: 'U' = Unknown, 'R' = (null description), 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material.\"}, {\"id\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\"}, {\"id\": \"LIBRARY_RESERVE_CATALOG\", \"desc\": \"Library reserve catalog table describing catalog items placed on reserve: title, author, publication year, publisher, call number, ISBN, system number, record create/update dates, and a record counter. Referenced by LIBRARY_RESERVE_MATRL_DETAIL.\"}, {\"id\": \"SUBJECT_ENROLLABLE\", \"desc\": \"11 columns in total\"}], \"metric\": [{\"id\": \"dw_3393\", \"desc\": \"For subjects with at least 5 enrolled students that are offered by the library in the term with code '2014FA', show the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, row number within each material status group ordered by subject ID, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, ordered by offering department name, material status key, and subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_3973\", \"desc\": \"List the term code, subject ID, minimum record count from TIP_DETAIL, total new shelf price from TIP_MATERIAL, academic year, number of enrolled students, and deviation from the average number of enrolled students for that academic year, for each term and subject where the material has a non-null author and a material info source of 'ISBN', and considering only terms that are not the current term. Do not return any rounded answers.\"}, {\"id\": \"dw_4683\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\"}, {\"id\": \"dw_4812\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_3311\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\"}, {\"id\": \"dw_3868\", \"desc\": \"For each department in the School of Engineering where the total number of students enrolled in courses offered by that department is greater than the average total enrollment across all Engineering departments (and the total enrollment is greater than 50), show the department name and total enrollment, and for each such department, show the library reserve material details with material status key equal to 'U', including the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students, as well as the responsible faculty name and the offer department name, for materials offered by that department. The columns should be: department name, total enrollment, library course instructor key, library reserve catalog key, term code, subject ID, tip material key, tip material status key, tip ISBN, subject title, windowed minimum tip material status key, responsible faculty name, and offer department name. Do not return any rounded answers.\"}, {\"id\": \"dw_4602\", \"desc\": \"Show the department full names, subject titles, total units, and the number of unique course materials per subject for subjects offered by departments in the School of Engineering. For each subject, also provide the material status key, term code, subject ID, ISBN, material key, course number description, offering department name, and the maximum number of enrolled students for each row considering the current row and the next 2 rows ordered by material key, where the subject title and department code match between the subject and course material datasets. Do not return any rounded answers.\"}, {\"id\": \"dw_3436\", \"desc\": \"List all subjects with at least 5 enrolled students, showing the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, and the row number within each material status group ordered by subject ID, as well as all IAP subject activities with a maximum enrollment of 12, showing the subject ID, activity title, enrollment type, term description, and the rank of each record within each term description group ordered by activity title. Indicate the source of each record as either 'LibrarySubject' or 'IAPActivity'. The columns should be: subject ID, subject title, number of enrolled students, term code, material status key, ISBN, window column, activity title, enrollment type, term description, and source. Do not return any rounded answers.\"}, {\"id\": \"dw_3668\", \"desc\": \"For subjects offered by departments in the School of Engineering, show the subject title, total units, department full name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Additionally, for each matching course material detail, provide the material status key, term code, subject ID, ISBN, material key, the course number description, the offering department name, and the maximum number of enrolled students for each row considering the current row and the next 2 rows ordered by material key. The results should include the subject title, total units, department full name, window row number, material status key, term code, subject ID, ISBN, material key, course number description, offering department name, and the maximum number of enrolled students, in that order, for subjects and course materials where the subject title and department code match between the two datasets. Do not return any rounded answers.\"}, {\"id\": \"dw_4287\", \"desc\": \"For each library reserve material detail with material status key equal to 'U' and for subjects offered in the term with code '2025FA', show the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title from the subject offered table, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students (only including those where the number of enrolled students is greater than the average across all subjects), the offering department name, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, the offering school name, and the responsible faculty name for each subject. Order the results by offering department and descending number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_3398\", \"desc\": \"For each subject offered in the same term as a TIP detail record with material status 'RQ', show the subject key, subject title, offer department name, TIP material key, and the rank of each record within each offer department name group ordered by subject key, along with the subject title, subject ID, offer department name, offer school name, term description, academic year, and the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject key, where the subject, term, and offer department name match in both cases. List the columns in the following order: subject key, subject title, offer department name, TIP material key, rank, subject title (from the second subquery), subject ID, offer department name (from the second subquery), offer school name, term description, academic year, and the maximum number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_3632\", \"desc\": \"For subjects offered in the term \\\"2012SU\\\", show the subject title, subject key, offer department name, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, subject ID, academic year, term description, and the minimum number of enrolled students in a window of 3 preceding and 1 following row, ordered by offer department name and academic year. Do not return any rounded answers.\"}, {\"id\": \"dw_3911\", \"desc\": \"For each subject offered by the library in the term with code '2014FA', show the subject ID, subject title, total number of enrolled students, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, as well as the maximum windowed average record count from tip detail records with material status key 'RQ' (using a window of 2 preceding and 2 following rows grouped by financial aid year). Additionally, for each offering department, include a grand total row showing the total number of enrolled students across all its subjects (with nulls for subject ID and subject title), and the corresponding maximum windowed average record count if available. Order the results by offering department name and subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_3493\", \"desc\": \"For subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook, show the subject code, subject number, department name, subject title, term description, total units, the average subject enrollment number in a window of 2 preceding and 2 following rows grouped by department code and ordered by total units, the textbook material key, the textbook material status key, and the row number of the course within each department ordered by subject code. List the results in order by department name, subject code, and subject number. Do not return any rounded answers.\"}, {\"id\": \"dw_3356\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', what are the subject title, the offering department name, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only departments that grant degrees and subjects with a non-null subject code description), and the count of reserved materials? Please provide the subject title, the offering department name, the variance, the standard deviation (using STDDEV only and never STDDEV_POP), and the count of reserved materials, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_4405\", \"desc\": \"For each combination of activity and department/academic year enrollment statistics, list the activity title, enrollment type, maximum enrollment, category name, category description, and the dense rank of each row partitioned by the category name and ordered by the category name, along with the department name, academic year, number of unique subjects offered (subject count), minimum number of total units for those subjects, and the average number of enrolled students per subject (for departments and academic years where the number of enrolled students in a subject is greater than 5). Do not return any rounded answers.\"}, {\"id\": \"dw_4724\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\"}, {\"id\": \"dw_4515\", \"desc\": \"For each department, academic year, activity title, and sponsor name where the subject enrollment number is greater than 10 and the maximum enrollment for the activity is greater than 10, provide the department name, academic year, number of unique subjects, minimum total units offered, activity title, sponsor name, number of unique activities, minimum fee, and the sponsor type. Do not return any rounded answers.\"}, {\"id\": \"dw_4756\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\"}, {\"id\": \"dw_4558\", \"desc\": \"For tip details where the material status key is 'RQ' and for IAP subject activities that are not cancelled and have a maximum enrollment greater than 10, show the tip subject offered key, material key, subject ID, term description, academic year, the average record count in a window of 2 preceding and 2 following rows grouped by academic year (as tip_window_avg_record_count), the activity title, enrollment type, maximum enrollment, academic term description from the time day table, term start date from the academic terms table, the minimum maximum enrollment value over each term code group (as iap_min_max_enrollment), and the academic year description from the academic terms table, ordered by academic year and IAP term code. Do not return any rounded answers.\"}], \"concept\": [{\"id\": \"concept_course_material_programs\", \"desc\": \"Tables covering course material provisioning: the Textbook Information Program (TIP) tracking textbook adoption status per subject offering, and library reserve processing tracking catalog items placed on reserve for subjects. They jointly answer questions about which subjects have course materials/textbooks, material status (TIP statuses such as 'RQ' Required, 'EO' Electronic options; library statuses such as 'U' Unknown, 'Y' Required Course Material), ISBNs, record counts, and reserve catalog item attributes. The two programs are linked by SUBJECT_ID + TERM_CODE.\"}, {\"id\": \"concept_subject_offering_facts\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\"}, {\"id\": \"concept_course_catalog_sources\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\"}, {\"id\": \"concept_department_dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\"}, {\"id\": \"concept_cip_program_classification\", \"desc\": \"Lookup tables of the Classification of Instructional Programs (CIP) used to classify courses/instructional programs into two-digit categories, four-digit series, and six-digit program codes, with revision version years (1990/2000/2010/2020). CIP holds the current single-version classification (one row per program code, with a change NOTE), while CIP_WITH_VERSION preserves every revision of each program code across versions. Both join to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE to attribute courses to CIP programs and categories.\"}, {\"id\": \"concept_person_directory\", \"desc\": \"Tables describing people of the institute keyed by MIT_ID: the primary employee directory (contact details, titles, HR department), the Drupal-sourced employee feed (employee group/type, appointment flags, HR org unit), the person master table (payroll rank, position title, active flag), the HR faculty roster (appointment type, terminal degree, emeritus status), the OPA current-person snapshot (HR job/appointment attributes, faculty flag, sabbatical), and the student directory (students with department attribution and student year). They jointly answer questions about who a person is, their contact details, job/appointment attributes, and whether they are employee, faculty, or student; responsible faculty in subject offering tables resolve to these tables via RESPONSIBLE_FACULTY_MIT_ID = MIT_ID.\"}, {\"id\": \"concept_iap_activities\", \"desc\": \"Tables describing Independent Activities Period (IAP) activities offered in January terms: activity details (title, enrollment type, max enrollment, fee, cancellation flags), sessions (location, date, times), sponsors (name, type), categories, and persons. They jointly answer questions about IAP activity counts, enrollment capacity, fees, session scheduling, and sponsorship.\"}, {\"id\": \"concept_academic_term_dimension\", \"desc\": \"Tables describing academic terms and their calendar/status attributes. They jointly answer questions about when terms run, which academic/financial-aid/degree year a term belongs to, and whether a term is current, previous, future, or regular. Coverage differs: the full historical term list, the status-tracked term subset, and the three-row relative term parameter reference.\"}, {\"id\": \"concept_room_major_use_classification\", \"desc\": \"Lookup tables classifying rooms by major use (classrooms, offices, laboratories, residential, circulation, etc.) with a short code, description, and assignable-space flag. They cover the current classification in the FCLT and FAC table families and the fiscal-period historical classification in the FCLT family, jointly answering questions about what a room is primarily used for and whether that use counts as assignable space.\"}, {\"id\": \"concept_building_inventory\", \"desc\": \"Tables recording the physical building inventory and its attributes (number/name, type, ownership, site, campus sector, access level, gross/assignable/non-assignable areas, number of rooms, key dates): the current FCLT_* family snapshot, its fiscal-period history (in two date-format variants), the FAC_* family snapshot, and the lightweight space-domain building lookup. They jointly answer questions about building characteristics, areas, and room counts, but differ in time coverage, table family, attribute richness, and area units.\"}, {\"id\": \"concept_time_dimension\", \"desc\": \"Time dimension tables of the warehouse at three granularities: TIME_DAY (one row per calendar date, with fiscal/calendar year and period, academic year, financial aid year, day of week, and the academic term code/description of the day), TIME_MONTH (one row per fiscal period in YYYYMM format, covering fiscal years 1996-2035, with fiscal quarter, calendar month, academic term, and financial aid year mappings), and TIME_QUARTER (one row per fiscal quarter, covering fiscal years 2000-2035, with quarter dates, payroll certification deadlines, and quarter status flags). They jointly answer questions about when fiscal periods/quarters/days run, which fiscal/calendar/academic year a date or month belongs to, and how day-level records roll up to months and quarters. They link to each other via FISCAL_PERIOD (day-month), FY_QUARTER_CODE (month-quarter), and FISCAL_YEAR (month-quarter association within the same fiscal year, fanning out months across all quarters of the year), and to the academic term tables via TIME_DAY.ACADEMIC_TERM_CODE or TIME_MONTH.ACADEMIC_TERM = TERM_CODE.\"}, {\"id\": \"concept_room_space_inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\"}, {\"id\": \"concept_dept_hr_org_hierarchy\", \"desc\": \"Tables describing the institute's department/lab/center (DLC) and HR organization hierarchies: the HR organization unit dimension in two feed variants (HR_ORG_UNIT, HR_ORG_UNIT_NEW), the master department standard hierarchy path (MASTER_DEPT_HIERARCHY), its DLC-to-administrative-object link table (MASTER_DEPT_HIERARCHY_LINKS), and the direct-parent department lookup (MASTER_DEPT_DCODE_PARENT). They jointly answer questions about which HR department/area a DLC or organization belongs to, the hierarchy path or parent of a department, and HR department names/codes/levels, and are joined to FCLT_ORGANIZATION via DLC_KEY for facilities/space attribution. They differ in hierarchy representation (full path vs direct parent vs HR unit attributes), unit coverage, and companion columns.\"}, {\"id\": \"concept_moira_mailing_lists\", \"desc\": \"Tables of the Moira mailing-list/group domain: the list master (one row per list with name, description, active flag, and type flags such as mailing list, group, NFS group, public, hidden), the membership detail (one row per list member with member login, full name, MIT ID, and last update date), and the owner lookup (one row per owner entity with owner name and owner type LIST/USER/KERBEROS). They jointly answer questions about which lists exist and their properties, who belongs to a list, and who owns a list; MOIRA_LIST is the parent of MOIRA_LIST_DETAIL via MOIRA_LIST_KEY, and MOIRA_LIST_OWNER is referenced by MOIRA_LIST_DETAIL via MOIRA_LIST_OWNER_KEY.\"}, {\"id\": \"concept_facility_organization_dimension\", \"desc\": \"Organization dimension tables describing the institute's hierarchical organization tree used for facilities/space attribution: FCLT_ORGANIZATION (keyed by FCLT_ORGANIZATION_KEY, with DLC_KEY/DLC_NAME) and FAC_ORGANIZATION (keyed by ORGANIZATION_KEY, with D_CODE). They answer the same questions about organization names, hierarchy levels, parent/major organizations, assignable flags, and HR cross-references, but belong to different table families and coverage.\"}, {\"id\": \"concept_floor_inventory\", \"desc\": \"Tables recording the floor level of buildings: the current FCLT_* family floor inventory with floor areas, the FAC_* family floor snapshot with the same structure, the fiscal-period historical floor table, and the lightweight space-domain floor lookup. They jointly answer questions about floor numbers and per-floor assignable/non-assignable areas, but differ in time coverage, table family, and attribute richness.\"}, {\"id\": \"concept_space_unit_dimension\", \"desc\": \"Space unit lookup tables identifying the organizational units that receive space allocation: SPACE_UNIT (with FCLT_ORGANIZATION_KEY organization attribution) and SPACE_UNIT2 (identity/name only). They answer the same space-unit identity questions but differ in organization linkage and coverage.\"}, {\"id\": \"concept_building_address\", \"desc\": \"Tables recording the postal/street addresses of buildings: the current FCLT_* family address table (multiple purpose-typed address rows per building), its fiscal-period historical counterpart, the FAC_* family address snapshot, and the single-text address fields of the space-domain BUILDINGS lookup. They jointly answer questions about where a building is located (street number/name, city, state, postal code), but differ in time coverage, address decomposition, and table family.\"}], \"column_concept\": [{\"id\": \"column_concept_enrollment_measures\", \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\"}, {\"id\": \"column_concept_material_status_key\", \"desc\": \"Material status key columns of the textbook program (TIP) and library reserve program. Both are coded status references decoded by their own lookup tables (key value equals code value), with independent value domains: TIP statuses ('RQ' Required, 'EO' Electronic options, 'RC' Recommended, 'PC' Val-u option, 'BR' Bookstore recommends, 'CL' Go to class first, 'NM' Course has no materials, 'U' Unknown, plus NULL-description keys) vs library reserve statuses ('U' Unknown, 'R' null description, 'N' Non-Required Course Material, 'O' Reserve only, 'X' No Required Textbook, 'Y' Required Course Material).\"}, {\"id\": \"column_concept_department_name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\"}, {\"id\": \"column_concept_subject_id\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\"}, {\"id\": \"column_concept_master_subject_id\", \"desc\": \"Master subject identifier columns (MASTER_SUBJECT_ID and its sortable variant MASTER_SUBJECT_ID_SORT) replicated across the registrar offering tables, the subject summary, the textbook program, the library reserve program, and the CIS course catalog. For clustered subjects (e.g. joint or cross-listed offerings), the master subject identifier points to the leading subject of the cluster, so joining on it matches offerings that share the same master subject even when their own SUBJECT_ID differs. SUBJECT_ID/SUBJECT_ID_SORT identify the subject itself, while MASTER_SUBJECT_ID/MASTER_SUBJECT_ID_SORT identify the cluster's master; the _SORT columns are the sortable forms of the same values used for cross-table joins.\"}, {\"id\": \"column_concept_term_code\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\"}, {\"id\": \"column_concept_hass_attribute\", \"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code and description columns. The code columns appear in the three course catalog feeds and in the CIS_HASS_ATTRIBUTE lookup; description columns exist in three variants: the catalog-embedded HASS_ATTRIBUTE_DESC, the lookup's DESCRIPTION_ON_FORM (registration-form wording), and DESCRIPTION_IN_BULLETIN (short bulletin wording). Selecting the right description variant depends on the wording requested by the question.\"}, {\"id\": \"column_concept_total_units\", \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\"}, {\"id\": \"column_concept_dlc_key\", \"desc\": \"Department/Lab/Center key columns (values like 'D_AEROASTRO', 'D_IDSS', 'D_BIOLOGY') identifying a DLC across the facilities, HR, space, and academic-department domains. They are the universal cross-domain join key linking facilities organizations and space units to HR organization units, the master department hierarchy, and academic departments. Naming and completeness vary: DLC_KEY in most tables, D_CODE in MASTER_DEPT_DCODE_PARENT, DLC_CODE in the master hierarchy tables; some columns carry composite values ('D_DSL:HQ') or nulls.\"}, {\"id\": \"column_concept_building_type_site\", \"desc\": \"Building classification columns replicated across the current and historical building tables of both table families: BUILDING_TYPE ('ACADEMIC', 'SERVICE', 'RESIDENT') and SITE ('MIT', 'BATES', 'LINC', 'BOS', etc.). They carry the same value domain but differ in time semantics: the building-table columns are the current classification, while the history-table columns are the classification recorded at each fiscal period, so filtering by one versus the other can select different building sets.\"}, {\"id\": \"column_concept_num_of_rooms\", \"desc\": \"NUM_OF_ROOMS columns recording how many rooms a building contains, replicated across the current and historical building tables of both families. The building-table columns hold the current room count (one value per building); the history-table columns hold the room count at each fiscal period, used for room-count statistics (average, range, variance, minimum) across a building's history records.\"}, {\"id\": \"column_concept_office_location\", \"desc\": \"OFFICE_LOCATION columns recording where a person's office/desk is, replicated across the person-directory tables (SE_PERSON, MIT_STUDENT_DIRECTORY, EMPLOYEE_DIRECTORY, DRUPAL_EMPLOYEE_DIRECTORY). All hold a building or building-room text identifier in the same value domain as FCLT_ROOMS.BUILDING_ROOM, but they describe different populations (employee/person master vs student vs primary employee directory vs Drupal employee feed) and differ sharply in non-null coverage and in how many values are building-room ('BLDG-ROOM') versus building-only ('BLDG'). Choosing the right column determines whose office is reported and whether room-level joins to FCLT_ROOMS succeed.\"}, {\"id\": \"column_concept_year_columns\", \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\"}, {\"id\": \"column_concept_access_level\", \"desc\": \"Access level columns recorded at three granularity levels of the facilities domain plus the space-planning room feed: building-level ACCESS_LEVEL_CODE/ACCESS_LEVEL_NAME (current and per-fiscal-period history), floor-level ACCESS_LEVEL, and room-level ACCESS_LEVEL (FCLT_ROOMS, FAC_ROOMS, ZPM_ROOMS_LOAD). They share a numeric value domain (observed 0-3) but describe the access restriction of different physical objects or come from different feeds, so filters and joins must target the granularity and table family the question refers to.\"}, {\"id\": \"column_concept_building_room\", \"desc\": \"Combined building-room identifier columns (e.g. '1-080') appearing in both the space assignment fact table and the facilities room inventory. They identify the same physical room concept but come from different business processes with different coverage and companion measures.\"}, {\"id\": \"column_concept_space_unit_key\", \"desc\": \"Space unit key columns identifying the organizational space-assignment unit across the space dimension and fact tables. SPACE_UNIT_KEY is the join key linking SPACE_DETAIL room rows to space unit identity (name/code) and, through SPACE_UNIT, to the owning facilities organization.\"}, {\"id\": \"column_concept_assignable_area\", \"desc\": \"Assignable-area measure columns at different granularity levels and time semantics: building-level current and per-fiscal-period assignable area, floor-level assignable area, and the space-domain assignable square footage. All FCLT_*/FAC_* columns are in square meters; BUILDINGS.BLDG_ASSIGNABLE_SQUARE_FOOTAGE is in square feet. Choosing the right column determines whether the measure is a building total, a floor total, a historical value, or a space-assignment figure.\"}, {\"id\": \"column_concept_fiscal_period\", \"desc\": \"Fiscal period code columns in YYYYMM format (e.g. '199602' = FY1996 period 2, '201505') appearing in two distinct roles: as the primary key of the month-grain time dimension (TIME_MONTH.FISCAL_PERIOD, also mirrored in TIME_DAY.FISCAL_PERIOD for day-to-month linkage), and as the snapshot-period stamp of the facilities historical tables (FCLT_BUILDING_HIST, FCLT_BUILDING_HIST_1, FCLT_BUILDING_ADDRESS_HIST, FCLT_FLOOR_HIST, FCLT_ROOMS_HIST, FCLT_MAJOR_USE_HIST). Both roles share the same YYYYMM value domain, but the time dimension uses it for calendar grouping while the history tables use it to mark when a facilities snapshot was taken.\"}, {\"id\": \"column_concept_facility_organization_key\", \"desc\": \"Facility organization key columns attributing space units and rooms to organizations in the hierarchical organization tree. Two naming conventions exist across table families (FCLT_ORGANIZATION_KEY in FCLT_*/SPACE_* tables vs ORGANIZATION_KEY in FAC_* tables) with the same value domain.\"}]}}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_402d688edd3845a88ced3cae",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"count\": 20, \"items\": [{\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\", \"entity_type\": \"table\", \"id\": \"TIP_DETAIL\", \"name\": \"TIP_DETAIL\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"entity_type\": \"table\", \"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"entity_type\": \"table\", \"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Student-facing department lookup table with department code, name, full name, and school attribution (code and name). Similar in content to SIS_DEPARTMENT but oriented to student information systems reporting; joins to offering tables via DEPARTMENT_CODE.\", \"entity_type\": \"table\", \"id\": \"STUDENT_DEPARTMENT\", \"name\": \"STUDENT_DEPARTMENT\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"entity_type\": \"table\", \"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\", \"entity_type\": \"table\", \"id\": \"LIBRARY_SUBJECT_OFFERED\", \"name\": \"LIBRARY_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\", \"entity_type\": \"table\", \"id\": \"ACADEMIC_TERMS_ALL\", \"name\": \"ACADEMIC_TERMS_ALL\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Term parameter reference table holding exactly three rows that identify the SIS current term, previous term, and upcoming term, each with its term code, description, start/end dates and the last day before the next term. Used to resolve relative term references ('C', 'P', 'F') to concrete term codes.\", \"entity_type\": \"table\", \"id\": \"ACADEMIC_TERM_PARAMETER\", \"name\": \"ACADEMIC_TERM_PARAMETER\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"entity_type\": \"table\", \"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"entity_type\": \"table\", \"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\", \"entity_type\": \"table\", \"id\": \"SIS_SUBJECT_CODE\", \"name\": \"SIS_SUBJECT_CODE\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Library reserve material detail bridge table linking reserve catalog items, library subject offerings, course instructors, and material status per term. Used to count reserved materials per subject and to filter by library material status (e.g. 'U').\", \"entity_type\": \"table\", \"id\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"name\": \"LIBRARY_RESERVE_MATRL_DETAIL\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_OFFERED\", \"name\": \"SUBJECT_OFFERED\"}, {\"relation_type\": \"concept\", \"direction\": \"incoming\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\", \"entity_type\": \"concept\", \"id\": \"concept_subject_offering_facts\", \"name\": \"Subject Offering Fact Tables\"}, {\"relation_type\": \"concept\", \"direction\": \"incoming\", \"desc\": \"Tables covering course material provisioning: the Textbook Information Program (TIP) tracking textbook adoption status per subject offering, and library reserve processing tracking catalog items placed on reserve for subjects. They jointly answer questions about which subjects have course materials/textbooks, material status (TIP statuses such as 'RQ' Required, 'EO' Electronic options; library statuses such as 'U' Unknown, 'Y' Required Course Material), ISBNs, record counts, and reserve catalog item attributes. The two programs are linked by SUBJECT_ID + TERM_CODE.\", \"entity_type\": \"concept\", \"id\": \"concept_course_material_programs\", \"name\": \"Course Material and Library Reserve Domain\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_term_code\", \"name\": \"Term Code\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_subject_id\", \"name\": \"Subject Identifier\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_department_name\", \"name\": \"Department Name\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_enrollment_measures\", \"name\": \"Enrollment Measures\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Master subject identifier columns (MASTER_SUBJECT_ID and its sortable variant MASTER_SUBJECT_ID_SORT) replicated across the registrar offering tables, the subject summary, the textbook program, the library reserve program, and the CIS course catalog. For clustered subjects (e.g. joint or cross-listed offerings), the master subject identifier points to the leading subject of the cluster, so joining on it matches offerings that share the same master subject even when their own SUBJECT_ID differs. SUBJECT_ID/SUBJECT_ID_SORT identify the subject itself, while MASTER_SUBJECT_ID/MASTER_SUBJECT_ID_SORT identify the cluster's master; the _SORT columns are the sortable forms of the same values used for cross-table joins.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_master_subject_id\", \"name\": \"Master Subject Identifier\"}]}"
    },
