          "function": {
            "name": "submit_SQL",
            "arguments": "{\"sql\": \"SELECT\\n    sd.DEPARTMENT_NAME,\\n    MAX(tso.NUM_ENROLLED_STUDENTS) - MIN(tso.NUM_ENROLLED_STUDENTS) AS range_enrolled_students,\\n    VARIANCE(tso.NUM_ENROLLED_STUDENTS) AS variance_enrolled_students,\\n    COUNT(DISTINCT tso.SUBJECT_ID) AS distinct_subject_count,\\n    MIN(td.ISBN) AS min_isbn,\\n    AVG(tso.NUM_ENROLLED_STUDENTS) AS avg_enrolled_students\\nFROM TIP_SUBJECT_OFFERED tso\\nJOIN SIS_DEPARTMENT sd\\n    ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE\\nJOIN SIS_COURSE_DESCRIPTION scd\\n    ON sd.DEPARTMENT_CODE = scd.DEPARTMENT\\nJOIN TIP_DETAIL td\\n    ON td.SUBJECT_ID = tso.SUBJECT_ID\\nWHERE sd.IS_DEGREE_GRANTING = 'Y'\\n  AND scd.COURSE_LEVEL = 'G'\\n  AND tso.NUM_ENROLLED_STUDENTS > 2\\nGROUP BY sd.DEPARTMENT_NAME\"}"
          }
        }
