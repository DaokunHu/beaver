    {
      "role": "tool",
      "tool_call_id": "call_e2f12899567545c296117a35",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SIS_SUBJECT_CODE\", \"name\": \"SIS_SUBJECT_CODE\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\", \"columns\": {\"COURSE_NUMBER\": {\"desc\": \"Course number; joins to SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject code, e.g. '18'; joins to SIS_COURSE_DESCRIPTION.COURSE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"SUBJECT_CODE_DESC\": {\"desc\": \"Description of the subject code, typically the department/program name for that code\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering; used for school-level filtering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject code / course number\"}, {\"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"columns\": {\"SIS_COURSE_DESCRIPTION_KEY\": {\"desc\": \"Surrogate key of the course description record\"}, \"COURSE\": {\"desc\": \"Course/subject code, e.g. '18'; joins to SIS_SUBJECT_CODE.SUBJECT_CODE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"COURSE_DESCRIPTION\": {\"desc\": \"Short course description text; its character length is used in description-length statistics\"}, \"COURSE_DESCRIPTION_LONG\": {\"desc\": \"Long-form course description text\"}, \"DEPARTMENT\": {\"desc\": \"Department code offering the course; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name offering the course\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME\": {\"desc\": \"School name offering the course, e.g. 'Engineering'\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"FROM_TERM\": {\"desc\": \"First term the course description is effective from\"}, \"FROM_TERM_DESCRIPTION\": {\"desc\": \"Description of the from-term\"}, \"THRU_TERM\": {\"desc\": \"Last term the course description is effective through\"}, \"THRU_TERM_DESCRIPTION\": {\"desc\": \"Description of the thru-term\"}, \"COURSE_OPTION\": {\"desc\": \"Course option designation\"}, \"COURSE_LEVEL\": {\"desc\": \"Course level code, e.g. 'U' = undergraduate, 'G' = graduate\"}, \"CIP_PROGRAM_CODE\": {\"desc\": \"Six-digit CIP (Classification of Instructional Programs) program code of the course; joins to CIP.PROGRAM_CODE (current classification, one row per code) and CIP_WITH_VERSION.PROGRAM_CODE (all revision versions)\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the course counts toward a degree\"}, \"DEFAULT_ULTIMATE_DEGREE\": {\"desc\": \"Default ultimate degree awarded for the course\"}, \"GRADAUTE_LEVEL\": {\"desc\": \"Legacy misspelled graduate level column (kept for compatibility)\"}, \"GRADUATE_LEVEL\": {\"desc\": \"Graduate level designation of the course\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per course description\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}, {\"id\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"name\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"desc\": \"Library reserve material detail bridge table linking reserve catalog items, library subject offerings, course instructors, and material status per term. Used to count reserved materials per subject and to filter by library material status (e.g. 'U').\", \"columns\": {\"LIBRARY_COURSE_INSTRUCTOR_KEY\": {\"desc\": \"Foreign key to LIBRARY_COURSE_INSTRUCTOR.LIBRARY_COURSE_INSTRUCTOR_KEY identifying the course instructor\"}, \"LIBRARY_RESERVE_CATALOG_KEY\": {\"desc\": \"Foreign key to LIBRARY_RESERVE_CATALOG.LIBRARY_RESERVE_CATALOG_KEY identifying the reserve catalog item\"}, \"LIBRARY_SUBJECT_OFFERED_KEY\": {\"desc\": \"Foreign key to LIBRARY_SUBJECT_OFFERED.LIBRARY_SUBJECT_OFFERED_KEY identifying the subject offering\"}, \"LIBRARY_MATERIAL_STATUS_KEY\": {\"desc\": \"Library material status key; joins to LIBRARY_MATERIAL_STATUS.LIBRARY_MATERIAL_STATUS_KEY for decoding. Value domain (key = code): 'U' = Unknown, 'R' = (null description), 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material. Distinct from TIP_DETAIL.TIP_MATERIAL_STATUS_KEY, which belongs to the textbook program domain.\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per reserve material per subject offering per term\"}, {\"id\": \"ACADEMIC_TERMS_ALL\", \"name\": \"ACADEMIC_TERMS_ALL\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2019FA'\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to; used to partition running sums by financial aid year\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term (all terms)\"}, {\"id\": \"LIBRARY_MATERIAL_STATUS\", \"name\": \"LIBRARY_MATERIAL_STATUS\", \"desc\": \"Library material status lookup table decoding library material status keys/codes used in LIBRARY_RESERVE_MATRL_DETAIL. Holds six statuses where key and code are identical: 'U' = Unknown, 'R' = (null description), 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material.\", \"columns\": {\"LIBRARY_MATERIAL_STATUS_KEY\": {\"desc\": \"Surrogate key; joins to LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY\"}, \"LIBRARY_MATERIAL_STATUS_CODE\": {\"desc\": \"Library material status code, e.g. 'U'\"}, \"LIBRARY_MATERIAL_STATUS\": {\"desc\": \"Library material status description text: 'Unknown' (U), 'Non-Required Course Material' (N), 'Reserve only' (O), 'No Required Textbook' (X), 'Required Course Material' (Y); NULL for key 'R'. Grouping by this column merges statuses sharing the same description.\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per library material status\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_7d74c6ed8398486c918c6540",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS\", \"SUBJECT_SUMMARY.TOTAL_UNITS\", \"SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS\", \"CIS_COURSE_CATALOG.TOTAL_UNITS\", \"DRUPAL_COURSE_CATALOG.TOTAL_UNITS\"], \"comparisons\": [{\"dimension\": \"Source process\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS is the catalog-declared unit value per offering; SUBJECT_SUMMARY.TOTAL_UNITS and SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS are registrar subject-level values; CIS/DRUPAL catalog feeds carry their own copies\"}, {\"dimension\": \"Companion unit columns\", \"detail\": \"All these tables also expose LECTURE_UNITS, LAB_UNITS, and preparation units (PREPARATION_UNITS except SUBJECT_SUMMARY which uses PREP_UNITS); DESIGN_UNITS exists in COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY, CIS and DRUPAL catalogs but not in SUBJECT_OFFERED_SUMMARY\"}, {\"dimension\": \"Variability flag\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS marks subjects whose units vary; analyses of fixed-unit statistics typically filter IS_VARIABLE_UNITS='N'\"}], \"decision_guide\": {\"Unit statistics (avg/stddev/variance/geometric mean) over catalog offerings, optionally split by lecture/lab/design or filtered by variable-units flag\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS with its companion unit columns.\", \"Unit statistics tied to actual enrollment records or subject groups per term\": \"Use SUBJECT_SUMMARY.TOTAL_UNITS.\", \"Unit statistics at subject-offering rollup level with offering department/school\": \"Use SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS.\", \"Fixed-unit analyses excluding variable-unit subjects\": \"Filter COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS = 'N'.\"}, \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\", \"id\": \"column_concept_total_units\", \"name\": \"Total Credit Units\"}, {\"id\": \"column_concept_department_name\", \"name\": \"Department Name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME\", \"SUBJECT_SUMMARY.DEPARTMENT_NAME\", \"SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY.OFFER_DEPT_NAME\", \"TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SIS_DEPARTMENT.DEPARTMENT_NAME\", \"STUDENT_DEPARTMENT.DEPARTMENT_NAME\", \"SIS_COURSE_DESCRIPTION.DEPARTMENT_NAME\", \"SIS_SUBJECT_CODE.DEPARTMENT_NAME\", \"EMPLOYEE_DIRECTORY.DEPARTMENT_NAME\", \"LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT\", \"MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME\", \"SE_PERSON.ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DEPARTMENT_NAME is used by catalog/summary tables (COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY), department/course lookup tables, and the student directory (MIT_STUDENT_DIRECTORY); OFFER_DEPT_NAME is used by offering/program tables (SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY, TIP_SUBJECT_OFFERED, LIBRARY_SUBJECT_OFFERED) and denotes the department that actually offers the subject; LIBRARY_COURSE_INSTRUCTOR uses the plain column name DEPARTMENT for the course's academic department; SE_PERSON uses ORGANIZATION for the person's organizational unit\"}, {\"dimension\": \"Value format\", \"detail\": \"Catalog, summary, offering, student-directory, and lookup tables store plain department names (e.g. 'Mathematics', 'Chemistry', 'Electrical Eng & Computer Sci'); LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT stores a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics', '06 - Electrical Eng & Computer Sci'), with some unprefixed values (e.g. 'Architecture'), so it is not directly comparable to plain-name columns without stripping the prefix\"}, {\"dimension\": \"Academic vs HR/organization value domain\", \"detail\": \"Catalog, summary, offering, library, student-directory, and lookup tables share the academic department domain; EMPLOYEE_DIRECTORY.DEPARTMENT_NAME is the HR organizational unit name and has a different domain (e.g. 'Lincoln Laboratory', 'Department of Physics'), where some values coincide with academic names but many do not, and some carry a 'Department of ...' prefix; SE_PERSON.ORGANIZATION holds organizational unit names that may use different naming variants than the academic domain for the same unit (e.g. 'Electrical Engineering-Computer Science' vs the academic 'Electrical Eng & Computer Sci'), so equality filters across the two conventions must use each table's own variant\"}, {\"dimension\": \"Companion code column\", \"detail\": \"Catalog/summary tables carry DEPARTMENT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE; offering/program tables carry OFFER_DEPT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE or STUDENT_DEPARTMENT.DEPARTMENT_CODE; MIT_STUDENT_DIRECTORY carries DEPARTMENT (the academic department code) joining SIS_DEPARTMENT.DEPARTMENT_CODE, which is the reliable join key instead of the name; LIBRARY_COURSE_INSTRUCTOR has no department code column, only the prefixed name text; EMPLOYEE_DIRECTORY carries DEPARTMENT_NUMBER (HR department number) and SE_PERSON carries no department code, neither joining to SIS_DEPARTMENT.DEPARTMENT_CODE\"}], \"decision_guide\": {\"Filtering subjects by department in catalog or summary analysis\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME or SUBJECT_SUMMARY.DEPARTMENT_NAME.\", \"Filtering by department in section-level, textbook-program, or library analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Joining fact tables to department dimension attributes (school, full name, degree-granting)\": \"Prefer code joins: DEPARTMENT_CODE / OFFER_DEPT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE; name equality joins are used when codes are unavailable.\", \"Matching departments across a DEPARTMENT_NAME table and an OFFER_DEPT_NAME table\": \"The values are directly comparable (same academic name domain), e.g. joining SUBJECT_SUMMARY.DEPARTMENT_NAME to TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME.\", \"Filtering employees by their HR organizational unit (e.g. names containing 'Department', or HR units like 'Political Science')\": \"Use EMPLOYEE_DIRECTORY.DEPARTMENT_NAME; do not join it to SIS_DEPARTMENT.DEPARTMENT_CODE, and pair it with DEPARTMENT_NUMBER for HR grouping.\", \"Filtering by department in section-level, textbook-program, or library subject analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Filtering library reserve course instructors by academic department or library unit\": \"Use LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT with the prefixed value format (e.g. '18 - Mathematics'); do not compare it directly to plain department-name columns.\", \"Filtering students by their academic department\": \"Use MIT_STUDENT_DIRECTORY.DEPARTMENT (code) joined to SIS_DEPARTMENT.DEPARTMENT_CODE for reliable matching, or MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME for direct name filters; the name shares the academic domain with SIS_DEPARTMENT.DEPARTMENT_NAME.\", \"Filtering a person master (SE_PERSON) record by organizational unit such as an academic department\": \"Use SE_PERSON.ORGANIZATION with its own naming variant (e.g. 'Electrical Engineering-Computer Science'); do not equate it directly to MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME or SIS_DEPARTMENT.DEPARTMENT_NAME, which use the academic variant (e.g. 'Electrical Eng & Computer Sci').\"}}, {\"columns\": [\"TIP_DETAIL.TIP_MATERIAL_STATUS_KEY\", \"TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY\", \"LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY\", \"LIBRARY_MATERIAL_STATUS.LIBRARY_MATERIAL_STATUS_KEY\"], \"comparisons\": [{\"dimension\": \"Program\", \"detail\": \"TIP_MATERIAL_STATUS_KEY belongs to the textbook program (decoded by TIP_MATERIAL_STATUS); LIBRARY_MATERIAL_STATUS_KEY belongs to library reserve processing (decoded by LIBRARY_MATERIAL_STATUS). The two key domains are independent and must not be joined to each other.\"}, {\"dimension\": \"Value domains\", \"detail\": \"TIP statuses: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, plus 'NL'/'NS'/'NB'/blank keys with NULL descriptions. Library statuses: 'U' = Unknown, 'R' = NULL description, 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material. Both domains contain 'U' but it means 'Unknown' in each program independently.\"}, {\"dimension\": \"Usage pattern\", \"detail\": \"Fact-side filtering uses the key columns on TIP_DETAIL / LIBRARY_RESERVE_MATRL_DETAIL directly; the lookup tables provide human-readable status text when needed. Grouping by the description column instead of the key merges statuses with NULL or identical descriptions.\"}, {\"dimension\": \"Cross-domain equality risk\", \"detail\": \"Some warehouse analyses equate TIP_MATERIAL_STATUS_KEY with LIBRARY_MATERIAL_STATUS_KEY to attach per-status statistics across the two programs. Because the value domains are independent, such an equality only matches on coincidental code overlap (e.g. 'U') and carries semantic risk; results should be interpreted as code-level matching, not as a true business relationship between textbook status and library reserve status.\"}], \"decision_guide\": {\"Questions about required or optional textbooks\": \"Filter TIP_DETAIL.TIP_MATERIAL_STATUS_KEY IN ('RQ','EO'); 'RQ' for required only.\", \"Questions about library reserve material status\": \"Filter/group LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY (e.g. 'U' Unknown, 'Y' Required Course Material); decode text via LIBRARY_MATERIAL_STATUS.\", \"Questions needing status description text rather than codes\": \"Join TIP_MATERIAL_STATUS or LIBRARY_MATERIAL_STATUS on the respective key; note that description columns contain NULLs for some keys.\", \"Matching reserve materials to textbook materials\": \"Match via SUBJECT_ID + TERM_CODE (or TIP_MATERIAL_KEY paths) between TIP_DETAIL and LIBRARY_RESERVE_MATRL_DETAIL, never by equating the two status key columns.\", \"Questions about required textbooks or textbook material statuses\": \"Filter/group TIP_DETAIL.TIP_MATERIAL_STATUS_KEY (e.g. 'RQ' for Required); decode text via TIP_MATERIAL_STATUS.\"}, \"desc\": \"Material status key columns of the textbook program (TIP) and library reserve program. Both are coded status references decoded by their own lookup tables (key value equals code value), with independent value domains: TIP statuses ('RQ' Required, 'EO' Electronic options, 'RC' Recommended, 'PC' Val-u option, 'BR' Bookstore recommends, 'CL' Go to class first, 'NM' Course has no materials, 'U' Unknown, plus NULL-description keys) vs library reserve statuses ('U' Unknown, 'R' null description, 'N' Non-Required Course Material, 'O' Reserve only, 'X' No Required Textbook, 'Y' Required Course Material).\", \"id\": \"column_concept_material_status_key\", \"name\": \"Material Status Key\"}, {\"columns\": [\"ACADEMIC_TERMS.ACADEMIC_YEAR\", \"ACADEMIC_TERMS_ALL.ACADEMIC_YEAR\", \"COURSE_CATALOG_SUBJECT_OFFERED.ACADEMIC_YEAR\", \"TIME_DAY.ACADEMIC_YEAR\", \"TIME_DAY.FISCAL_YEAR\", \"TIME_DAY.CALENDAR_YEAR\", \"TIME_MONTH.ACADEMIC_YEAR\", \"TIME_MONTH.FISCAL_YEAR\", \"TIME_MONTH.CALENDAR_YEAR\", \"TIME_MONTH.FINANCIAL_AID_YEAR\", \"TIME_QUARTER.FISCAL_YEAR\", \"TIME_QUARTER.CALENDAR_YEAR\", \"ACADEMIC_TERMS.FINANCIAL_AID_YEAR\", \"ACADEMIC_TERMS_ALL.FINANCIAL_AID_YEAR\", \"ACADEMIC_TERMS.DEGREE_YEAR\"], \"comparisons\": [{\"dimension\": \"Year system\", \"detail\": \"ACADEMIC_YEAR is the academic year a term/offering/date belongs to; FISCAL_YEAR is the institute fiscal year (MIT fiscal year starts in July, so a fiscal year spans two calendar years); CALENDAR_YEAR is the natural calendar year; FINANCIAL_AID_YEAR is the aid year a term/month maps to; DEGREE_YEAR is the degree-conferral year a term maps to. These year systems do not always coincide for the same term or date.\"}, {\"dimension\": \"Location\", \"detail\": \"Term tables (ACADEMIC_TERMS/ACADEMIC_TERMS_ALL) carry academic/financial-aid/degree years per term; COURSE_CATALOG_SUBJECT_OFFERED carries its own ACADEMIC_YEAR per catalog record; the time dimension tables carry year systems at their own granularity: TIME_DAY (fiscal/calendar/academic year per day), TIME_MONTH (fiscal/calendar/academic/aid year per month), TIME_QUARTER (fiscal/calendar year per quarter, no academic year).\"}, {\"dimension\": \"Grouping behavior\", \"detail\": \"Grouping offerings by catalog ACADEMIC_YEAR vs joining to term tables' ACADEMIC_YEAR can yield different groupings when a catalog record's TERM_CODE and ACADEMIC_YEAR disagree; grouping time-dimension rows by FISCAL_YEAR vs CALENDAR_YEAR yields different period assignments for dates between January and June.\"}], \"decision_guide\": {\"Yearly statistics over subject offerings\": \"Group by COURSE_CATALOG_SUBJECT_OFFERED.ACADEMIC_YEAR when the question says 'academic year YYYY' for offerings; join term tables for term-status filters.\", \"Yearly statistics over terms themselves (e.g. degree year geometric means, financial aid year partitions)\": \"Use ACADEMIC_TERMS / ACADEMIC_TERMS_ALL year columns (DEGREE_YEAR, FINANCIAL_AID_YEAR).\", \"Matching IAP activity dates to academic years via calendar\": \"Use TIME_DAY.FISCAL_YEAR or TIME_DAY.ACADEMIC_YEAR through TERM_CODE = ACADEMIC_TERM_CODE.\", \"Windowed running sums partitioned by aid year\": \"Use ACADEMIC_TERMS_ALL.FINANCIAL_AID_YEAR as the partition key.\", \"Fiscal-year or calendar-month statistics over months/days\": \"Use TIME_MONTH.FISCAL_YEAR / TIME_MONTH.CALENDAR_YEAR (month grain) or TIME_DAY.CALENDAR_YEAR (day grain), joined on FISCAL_PERIOD when both grains are needed.\"}, \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\", \"id\": \"column_concept_year_columns\", \"name\": \"Academic and Fiscal Year Columns\"}, {\"id\": \"concept_course_material_programs\", \"name\": \"Course Material and Library Reserve Domain\", \"desc\": \"Tables covering course material provisioning: the Textbook Information Program (TIP) tracking textbook adoption status per subject offering, and library reserve processing tracking catalog items placed on reserve for subjects. They jointly answer questions about which subjects have course materials/textbooks, material status (TIP statuses such as 'RQ' Required, 'EO' Electronic options; library statuses such as 'U' Unknown, 'Y' Required Course Material), ISBNs, record counts, and reserve catalog item attributes. The two programs are linked by SUBJECT_ID + TERM_CODE.\", \"tables\": [\"TIP_SUBJECT_OFFERED\", \"TIP_DETAIL\", \"TIP_MATERIAL\", \"TIP_MATERIAL_STATUS\", \"LIBRARY_SUBJECT_OFFERED\", \"LIBRARY_RESERVE_MATRL_DETAIL\", \"LIBRARY_RESERVE_CATALOG\", \"LIBRARY_MATERIAL_STATUS\", \"LIBRARY_COURSE_INSTRUCTOR\"], \"comparisons\": [{\"dimension\": \"Business process\", \"TIP_SUBJECT_OFFERED / TIP_DETAIL / TIP_MATERIAL / TIP_MATERIAL_STATUS\": \"Textbook program: subjects tracked for textbook adoption, material rows with status and ISBN, material bibliographic details, status decoding\", \"LIBRARY_SUBJECT_OFFERED / LIBRARY_RESERVE_MATRL_DETAIL / LIBRARY_RESERVE_CATALOG / LIBRARY_MATERIAL_STATUS / LIBRARY_COURSE_INSTRUCTOR\": \"Library reserve: subjects in reserve processing, reserve material detail rows, catalog item bibliographic records, status decoding, instructor assignments\"}, {\"dimension\": \"Status semantics\", \"TIP_MATERIAL_STATUS_KEY\": \"12 statuses decoded by TIP_MATERIAL_STATUS: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, plus NULL-description keys 'NL'/'NS'/'NB'/blank\", \"LIBRARY_MATERIAL_STATUS_KEY\": \"6 statuses decoded by LIBRARY_MATERIAL_STATUS: 'U' = Unknown, 'R' = NULL description, 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material\"}, {\"dimension\": \"Count measures\", \"TIP_DETAIL\": \"COUNT(TIP_MATERIAL_KEY) or RECORD_COUNT for material-count statistics per status/subject\", \"LIBRARY_RESERVE_MATRL_DETAIL\": \"COUNT(LIBRARY_RESERVE_CATALOG_KEY) for reserve catalog item counts per status/subject; LIBRARY_RESERVE_CATALOG.RECORD_COUNTER is a catalog record counter\"}, {\"dimension\": \"Parent-child structure\", \"TIP_SUBJECT_OFFERED → TIP_DETAIL\": \"TIP_SUBJECT_OFFERED_KEY / SUBJECT_ID links subject rows to material rows\", \"LIBRARY_SUBJECT_OFFERED → LIBRARY_RESERVE_MATRL_DETAIL → LIBRARY_RESERVE_CATALOG\": \"LIBRARY_SUBJECT_OFFERED_KEY and LIBRARY_RESERVE_CATALOG_KEY chain subjects to reserve items\"}], \"decision_guide\": {\"Questions about required/optional textbooks, ISBNs, or whether subjects have course materials\": \"Use TIP_SUBJECT_OFFERED (IS_NO_COURSE_MATERIAL flag) with TIP_DETAIL (TIP_MATERIAL_STATUS_KEY 'RQ'/'EO').\", \"Questions about library reserve items, reserve counts per subject, or catalog titles/authors\": \"Use LIBRARY_RESERVE_MATRL_DETAIL joined to LIBRARY_RESERVE_CATALOG, scoped by LIBRARY_SUBJECT_OFFERED.\", \"Questions about enrollment of subjects within the textbook program or library reserve scope\": \"Use TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS or LIBRARY_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS respectively; these are program-specific snapshots, not the official SUBJECT_SUMMARY enrollment.\", \"Questions about textbook prices, editions, or publishers\": \"Use TIP_MATERIAL via TIP_DETAIL.TIP_MATERIAL_KEY.\", \"Questions about instructors of courses with reserve materials\": \"Use LIBRARY_COURSE_INSTRUCTOR via LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_COURSE_INSTRUCTOR_KEY.\", \"Questions about required textbooks, ISBNs, or whether subjects have course materials\": \"Use TIP_SUBJECT_OFFERED (IS_NO_COURSE_MATERIAL flag) with TIP_DETAIL (TIP_MATERIAL_STATUS_KEY, e.g. 'RQ' Required).\", \"Questions combining textbook material statuses with library reserve statuses\": \"Join TIP_DETAIL and LIBRARY_RESERVE_MATRL_DETAIL on SUBJECT_ID + TERM_CODE, decode each status via its own lookup table, and aggregate each side separately; never equate the two status key columns.\"}}, {\"id\": \"concept_academic_term_dimension\", \"name\": \"Academic Term Dimension\", \"desc\": \"Tables describing academic terms and their calendar/status attributes. They jointly answer questions about when terms run, which academic/financial-aid/degree year a term belongs to, and whether a term is current, previous, future, or regular. Coverage differs: the full historical term list, the status-tracked term subset, and the three-row relative term parameter reference.\", \"tables\": [\"ACADEMIC_TERMS\", \"ACADEMIC_TERMS_ALL\", \"ACADEMIC_TERM_PARAMETER\"], \"comparisons\": [{\"dimension\": \"Row coverage\", \"ACADEMIC_TERMS\": \"Terms with full status tracking (subset of all terms)\", \"ACADEMIC_TERMS_ALL\": \"All terms known to the warehouse (superset of ACADEMIC_TERMS)\", \"ACADEMIC_TERM_PARAMETER\": \"Exactly 3 rows: current, previous, and upcoming term\"}, {\"dimension\": \"Unique columns\", \"ACADEMIC_TERMS\": \"IS_REGULAR_TERM, TERM_STATUS ('Previous'/'Current'/'Future'/'Unspecified'), ADD_DATE, DROP_DATE\", \"ACADEMIC_TERMS_ALL\": \"No IS_REGULAR_TERM/TERM_STATUS/ADD_DATE/DROP_DATE; shares TERM_STATUS_INDICATOR, FINANCIAL_AID_YEAR, DEGREE_YEAR\", \"ACADEMIC_TERM_PARAMETER\": \"TERM_PARAMETER name (SIS_CURRENT_TERM/SIS_PREVIOUS_TERM/SIS_UPCOMING_TERM), TERM_INDICATOR ('C'/'P'/'F'), TERM_LAST_DAY_BEFORE_NEXT_TERM\"}, {\"dimension\": \"Typical role in queries\", \"ACADEMIC_TERMS\": \"Filtering by regular-term flag or term status; term start/end dates and registration milestones\", \"ACADEMIC_TERMS_ALL\": \"Source of academic year, academic year description, financial aid year, degree year for windowed/running-sum statistics\", \"ACADEMIC_TERM_PARAMETER\": \"Resolving relative term references ('current term', 'previous term', term indicator 'C'/'P') to concrete term codes\"}, {\"dimension\": \"Join keys\", \"ACADEMIC_TERMS\": \"TERM_CODE, ACADEMIC_TERMS_KEY\", \"ACADEMIC_TERMS_ALL\": \"TERM_CODE, ACADEMIC_TERMS_KEY\", \"ACADEMIC_TERM_PARAMETER\": \"TERM_CODE\"}], \"decision_guide\": {\"Questions needing IS_REGULAR_TERM or TERM_STATUS ('Previous'/'Current'/'Future') filtering\": \"Use ACADEMIC_TERMS; these columns exist only there.\", \"Questions needing academic year, financial aid year, or degree year attributes over the widest term coverage, or joining fact tables whose terms may not be status-tracked\": \"Use ACADEMIC_TERMS_ALL, optionally joined to ACADEMIC_TERMS on TERM_CODE when regular-term/status flags are also needed.\", \"Questions referring to 'the current term', 'the previous term', 'the upcoming term', or term indicator 'C'/'P'/'F'\": \"Use ACADEMIC_TERM_PARAMETER to resolve the relative reference to a TERM_CODE, then join ACADEMIC_TERMS for full attributes.\", \"Questions needing registration milestones (add date, drop date, first day of classes, last day of final exam)\": \"Use ACADEMIC_TERMS (ADD_DATE/DROP_DATE only exist there; other milestone dates exist in both ACADEMIC_TERMS and ACADEMIC_TERMS_ALL).\"}}], \"not_found\": []}"
    },
