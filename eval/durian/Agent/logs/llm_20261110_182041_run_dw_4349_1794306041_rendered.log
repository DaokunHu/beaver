      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"ACADEMIC_TERMS_ALL\", \"name\": \"ACADEMIC_TERMS_ALL\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2019FA'\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to; used to partition running sums by financial aid year\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term (all terms)\"}, {\"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS_ALL.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2025FA' (FA=Fall, SP=Spring, JA=January/IAP, SU=Summer)\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description, e.g. 'Fall Term 2024-2025'\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date; can match TIME_DAY.CALENDAR_DATE for calendar-based joins\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to, e.g. 2025\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"IS_REGULAR_TERM\": {\"desc\": \"'Y'/'N' flag indicating a regular term (Fall/Spring) versus non-regular terms (Summer, January/IAP); only present in ACADEMIC_TERMS, not in ACADEMIC_TERMS_ALL\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"TERM_STATUS\": {\"desc\": \"Term status text: 'Previous', 'Current', 'Future', or 'Unspecified'\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to; used in degree-year statistics\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"ADD_DATE\": {\"desc\": \"Last day to add a subject in the term; only present in ACADEMIC_TERMS\"}, \"DROP_DATE\": {\"desc\": \"Last day to drop a subject in the term; only present in ACADEMIC_TERMS\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period for the term\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period for the term\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term\"}, {\"id\": \"LIBRARY_SUBJECT_OFFERED\", \"name\": \"LIBRARY_SUBJECT_OFFERED\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\", \"columns\": {\"LIBRARY_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the library subject offered record; joins to LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject as used by the library\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_RESERVE_MATRL_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject per library records\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in library reserve scope\"}, {\"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the TIP subject offered record; joins to TIP_DETAIL.TIP_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"IS_NO_COURSE_MATERIAL\": {\"desc\": \"'Y'/'N' flag whether the subject has no course material; 'N' means the subject has course materials\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '5.01'; joins to TIP_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE and STUDENT_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Chemistry', 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject; used for enrollment-based rankings and window statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in the textbook program\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_87fdcc0da825429bbca67d8a",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_1301\", \"name\": \"Math Yearly Max Total Units with Fall-Term Library Enrollment Stddev and Equivalent Subjects\", \"desc\": \"For each academic year, where the maximum number of total units for any Mathematics (Course 18) subject offered in that year is greater than 9 and there are more than 5 Mathematics subjects offered in the fall term, what are the academic year, the maximum total units, the corresponding term description, the subject title, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in library subjects offered during terms in that year, and the average number of equivalent subjects for those library subjects? List the results in order of academic year. Do not return any rounded answers.\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"sql\": \"WITH inner_cte1 AS ( SELECT c.ACADEMIC_YEAR, MAX(c.TOTAL_UNITS) AS max_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c WHERE c.DEPARTMENT_NAME = 'Mathematics' GROUP BY c.ACADEMIC_YEAR HAVING max_total_units > 9 ), MaxUnitsSubjects AS ( SELECT ic.ACADEMIC_YEAR, ic.max_total_units, ata.TERM_DESCRIPTION, c.SUBJECT_TITLE FROM inner_cte1 ic JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON c.ACADEMIC_YEAR = ic.ACADEMIC_YEAR AND c.TOTAL_UNITS = ic.max_total_units AND c.DEPARTMENT_NAME = 'Mathematics' JOIN ACADEMIC_TERMS_ALL ata ON ata.TERM_CODE = c.TERM_CODE ), inner_cte2 AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, STDDEV(lso.NUM_ENROLLED_STUDENTS) AS stddev_num_enrolled_students FROM LIBRARY_SUBJECT_OFFERED lso JOIN ACADEMIC_TERMS_ALL ata ON lso.TERM_CODE = ata.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON lso.TERM_CODE = ccso.TERM_CODE AND lso.SUBJECT_ID = ccso.SUBJECT_ID WHERE ccso.DEPARTMENT_NAME = 'Mathematics' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC HAVING COUNT(*) > 5 ), LibraryStats AS ( SELECT icte.ACADEMIC_YEAR, icte.ACADEMIC_YEAR_DESC, icte.stddev_num_enrolled_students, AVG( CASE WHEN ccso.EQUIVALENT_SUBJECTS IS NULL OR ccso.EQUIVALENT_SUBJECTS = '' THEN 0 ELSE 1 + LENGTH(ccso.EQUIVALENT_SUBJECTS) - LENGTH(REPLACE(ccso.EQUIVALENT_SUBJECTS, ',', '')) END ) AS avg_num_equivalent_subjects FROM inner_cte2 icte JOIN ACADEMIC_TERMS_ALL ata ON icte.ACADEMIC_YEAR = ata.ACADEMIC_YEAR JOIN LIBRARY_SUBJECT_OFFERED lso ON ata.TERM_CODE = lso.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON lso.TERM_CODE = ccso.TERM_CODE AND lso.SUBJECT_ID = ccso.SUBJECT_ID WHERE ccso.DEPARTMENT_NAME = 'Mathematics' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY icte.ACADEMIC_YEAR, icte.ACADEMIC_YEAR_DESC, icte.stddev_num_enrolled_students ) SELECT mus.ACADEMIC_YEAR, mus.max_total_units, mus.TERM_DESCRIPTION, mus.SUBJECT_TITLE, ls.ACADEMIC_YEAR_DESC, ls.stddev_num_enrolled_students, ls.avg_num_equivalent_subjects FROM MaxUnitsSubjects mus JOIN LibraryStats ls ON mus.ACADEMIC_YEAR = ls.ACADEMIC_YEAR ORDER BY mus.ACADEMIC_YEAR;\", \"default_granularity\": \"one row per academic year per max-unit subject\"}, {\"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per academic year\", \"desc\": \"For each academic year, what is the academic year, academic year description, the geometric mean of the number of library reserve material details per subject offered (considering only records where the material status is 'U' and the academic term is a regular term), the average total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the average number of design units for subjects that are offered in the fall term and have a material status of 'U' in the library reserve? List the results ordered by the geometric mean of materials per subject in descending order, then by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\", \"id\": \"dw_4701\", \"name\": \"Yearly Geometric Mean Reserve Materials per Subject with Fall Term Unit Statistics\", \"sql\": \"WITH inner_cte AS ( WITH GeometricMeanMaterialsPerSubject AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, EXP(AVG(LN(material_count))) AS geometric_mean_materials_per_subject FROM ( SELECT LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY, COUNT(*) AS material_count, LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE FROM LIBRARY_RESERVE_MATRL_DETAIL WHERE LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY = 'U' GROUP BY LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY, LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE ) sub JOIN ACADEMIC_TERMS ON sub.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC ), AvgStddevTotalUnitsFallU AS ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, AVG(ccso.TOTAL_UNITS) AS avg_total_units, STDDEV(ccso.TOTAL_UNITS) AS stddev_total_units FROM LIBRARY_RESERVE_MATRL_DETAIL lrm JOIN ACADEMIC_TERMS at ON lrm.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE lrm.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ) SELECT gmmps.ACADEMIC_YEAR, gmmps.ACADEMIC_YEAR_DESC, gmmps.geometric_mean_materials_per_subject, astu.avg_total_units, astu.stddev_total_units FROM GeometricMeanMaterialsPerSubject gmmps JOIN AvgStddevTotalUnitsFallU astu ON gmmps.ACADEMIC_YEAR = astu.ACADEMIC_YEAR AND gmmps.ACADEMIC_YEAR_DESC = astu.ACADEMIC_YEAR_DESC ORDER BY gmmps.geometric_mean_materials_per_subject DESC, astu.stddev_total_units DESC ) SELECT icte.ACADEMIC_YEAR, icte.ACADEMIC_YEAR_DESC, icte.geometric_mean_materials_per_subject, icte.avg_total_units, icte.stddev_total_units, avg_design.avg_design_units FROM inner_cte icte JOIN ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, AVG(ccso.DESIGN_UNITS) AS avg_design_units FROM LIBRARY_RESERVE_MATRL_DETAIL lrm JOIN ACADEMIC_TERMS at ON lrm.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE lrm.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ) avg_design ON icte.ACADEMIC_YEAR = avg_design.ACADEMIC_YEAR AND icte.ACADEMIC_YEAR_DESC = avg_design.ACADEMIC_YEAR_DESC ORDER BY icte.geometric_mean_materials_per_subject DESC, icte.stddev_total_units DESC;\"}, {\"id\": \"dw_3131\", \"name\": \"Fiscal Period Calendar Year Variance with High/Low/Average Classification\", \"desc\": \"For each fiscal period, what is the fiscal period description, the variance of the calendar year for all days in that period where the academic year is not null, and whether the variance is 'HIGH_VARIANCE' (at least 20% greater than the average variance across all periods), 'LOW_VARIANCE' (at least 20% less than the average), or 'AVERAGE'? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT TIME_MONTH.FISCAL_PERIOD, TIME_MONTH.FISCAL_PERIOD_DESCRIPTION, VARIANCE(TIME_DAY.CALENDAR_YEAR) AS calendar_year_variance FROM TIME_MONTH JOIN TIME_DAY ON TIME_MONTH.FISCAL_PERIOD = TIME_DAY.FISCAL_PERIOD WHERE TIME_DAY.ACADEMIC_YEAR IS NOT NULL GROUP BY TIME_MONTH.FISCAL_PERIOD, TIME_MONTH.FISCAL_PERIOD_DESCRIPTION ) SELECT inner_cte.FISCAL_PERIOD, inner_cte.FISCAL_PERIOD_DESCRIPTION, inner_cte.calendar_year_variance, CASE WHEN inner_cte.calendar_year_variance > avg_stats.avg_variance * 1.2 THEN 'HIGH_VARIANCE' WHEN inner_cte.calendar_year_variance < avg_stats.avg_variance * 0.8 THEN 'LOW_VARIANCE' ELSE 'AVERAGE' END AS variance_category FROM inner_cte CROSS JOIN ( SELECT AVG(calendar_year_variance) AS avg_variance FROM inner_cte ) avg_stats ORDER BY inner_cte.calendar_year_variance DESC;\", \"category\": \"Fiscal Calendar Analysis\", \"default_granularity\": \"one row per fiscal period with days having a non-null academic year\"}, {\"category\": \"Academic Term Analysis\", \"default_granularity\": \"one row per academic year\", \"desc\": \"For each academic year, provide the academic year description, the geometric mean of the degree year from all academic terms where the degree year is greater than 1900, and classify the academic year as 'RECENT' if the geometric mean is at least 2010, 'OLD' if it is less than 1980, or 'AVERAGE' otherwise. Do not return any rounded answers.\", \"id\": \"dw_2957\", \"name\": \"Geometric Mean Degree Year by Academic Year with Recency Classification\", \"sql\": \"WITH inner_cte AS ( SELECT ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, ACADEMIC_TERMS_ALL.ACADEMIC_YEAR_DESC, EXP(AVG(LN(ACADEMIC_TERMS.DEGREE_YEAR))) AS geometric_mean_degree_year FROM ACADEMIC_TERMS_ALL JOIN ACADEMIC_TERMS ON ACADEMIC_TERMS_ALL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE ACADEMIC_TERMS.DEGREE_YEAR > 1900 GROUP BY ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, ACADEMIC_TERMS_ALL.ACADEMIC_YEAR_DESC ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.ACADEMIC_YEAR_DESC, inner_cte.geometric_mean_degree_year, CASE WHEN inner_cte.geometric_mean_degree_year >= 2010 THEN 'RECENT' WHEN inner_cte.geometric_mean_degree_year < 1980 THEN 'OLD' ELSE 'AVERAGE' END AS year_category FROM inner_cte ORDER BY inner_cte.geometric_mean_degree_year DESC;\"}], \"not_found\": []}"
    },
