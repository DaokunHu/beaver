    {
      "role": "tool",
      "tool_call_id": "call_70ac006f63cf4d66b2085909",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SPACE_SUPERVISOR_USAGE\", \"name\": \"SPACE_SUPERVISOR_USAGE\", \"desc\": \"Space supervisor usage fact table: one row per supervisor (MIT_ID) recording how much space they supervise and for how many departments: department count, department DLC key list (comma-separated when multiple), number of supervisees, supervised square footage, research volume, and derived ratio measures (sqft per supervisee, sqft per research volume, research volume per sqft). Joins to SPACE_UNIT and other DLC-carrying tables via DEPT_NAMES = DLC_KEY (only single-department rows match); used for supervisor space-usage and research-volume statistics per department/DLC.\", \"columns\": {\"MIT_ID\": {\"desc\": \"MIT ID of the supervisor; one row per supervisor\"}, \"DEPT_COUNT\": {\"desc\": \"Number of departments (DLCs) the supervisor's space spans; observed values 1-4\"}, \"DEPT_NAMES\": {\"desc\": \"DLC key(s) of the supervised departments, e.g. 'D_CEE'; comma-separated list when DEPT_COUNT > 1 (e.g. 'D_IDSS,D_LIDS'). Single-value rows join to DLC key columns such as SPACE_UNIT.DLC_KEY\"}, \"NUM_OF_SUPERVISEES\": {\"desc\": \"Number of supervisees under the supervisor; observed range 1-121\"}, \"SQFT\": {\"desc\": \"Total square footage of space supervised\"}, \"RESEARCH_VOLUME\": {\"desc\": \"Research volume attributed to the supervisor's space; can be negative\"}, \"SQFT_PER_SUPERVISEE\": {\"desc\": \"Derived ratio: supervised square footage per supervisee\"}, \"SQFT_PER_RES_VOL\": {\"desc\": \"Derived ratio: supervised square footage per unit of research volume\"}, \"RES_VOL_PER_SQFT\": {\"desc\": \"Derived ratio: research volume per square foot of supervised space\"}, \"default_granularity\": \"one row per supervisor\"}, \"default_granularity\": \"one row per supervisor\"}, {\"id\": \"SPACE_UNIT\", \"name\": \"SPACE_UNIT\", \"desc\": \"Space unit dimension table: one row per space unit (an organizational space-assignment unit such as a department, program, or office that receives space allocation), with space unit key/code, space unit name, the facilities organization it belongs to, and DLC key. Bridges FCLT_ORGANIZATION (organization attribution) and SPACE_DETAIL (rooms assigned to the space unit); used to group room counts and space statistics by space unit.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Foreign key to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY; the organization that owns/occupies this space unit\"}, \"SPACE_UNIT_KEY\": {\"desc\": \"Surrogate key of the space unit; joins to SPACE_DETAIL.SPACE_UNIT_KEY and SPACE_UNIT2.SPACE_UNIT_KEY; used for partitioning/ordering in space analyses\"}, \"SPACE_UNIT_CODE\": {\"desc\": \"Business code of the space unit (same numeric value as the key in current data)\"}, \"SPACE_UNIT\": {\"desc\": \"Name of the space unit, e.g. 'Physics', 'Technology & Policy Program'\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_PHYSICS'; may contain composite values like 'D_DSL:HQ'\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per space unit\"}, {\"id\": \"SPACE_UNIT2\", \"name\": \"SPACE_UNIT2\", \"desc\": \"Alternative space unit lookup table containing space unit key, code, name, and DLC key, but without the FCLT_ORGANIZATION_KEY organization attribution present in SPACE_UNIT. Holds fewer space units than SPACE_UNIT; used when only space unit identity/name is needed without organization linkage.\", \"columns\": {\"SPACE_UNIT_KEY\": {\"desc\": \"Surrogate key of the space unit; same value domain as SPACE_UNIT.SPACE_UNIT_KEY and referenced by SPACE_DETAIL.SPACE_UNIT_KEY\"}, \"SPACE_UNIT_CODE\": {\"desc\": \"Business code of the space unit\"}, \"SPACE_UNIT\": {\"desc\": \"Name of the space unit\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key of the space unit\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per space unit\"}, {\"id\": \"dw_2896\", \"name\": \"Two-Supervisee Supervisor Records with 5-Row Windowed Average Square Footage Above 200 per Facility Organization\", \"desc\": \"For each facility organization, show the research volume, department names, square footage, MIT ID, and the average square footage in a window of 2 preceding and 2 following rows (grouped by facility organization key and ordered by research volume) for space supervisor usage records where the number of supervisees is 2, and only include those records where the average square footage in the window is greater than 200. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT t0.RESEARCH_VOLUME, t0.DEPT_NAMES, t0.SQFT, t0.MIT_ID, AVG(t0.SQFT) OVER ( PARTITION BY t1.FCLT_ORGANIZATION_KEY ORDER BY t0.RESEARCH_VOLUME ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column FROM SPACE_SUPERVISOR_USAGE t0 JOIN SPACE_UNIT t1 ON t0.DEPT_NAMES = t1.DLC_KEY WHERE t0.NUM_OF_SUPERVISEES = 2 ) SELECT RESEARCH_VOLUME, DEPT_NAMES, SQFT, MIT_ID, window_column FROM inner_cte WHERE window_column > 200;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per supervisor usage record with 2 supervisees whose 5-row windowed average square footage (per facility organization, ordered by research volume) exceeds 200\"}, {\"default_granularity\": \"one row per Provost Area department rank matched with a space-unit-97500 supervisor usage statistics row of the same DLC\", \"desc\": \"For each department in the \\\"Provost Area\\\" that is associated with a space unit with space unit code 97500, show the department code, department name, school area name, the rank of each department within its school area based on department code, the corresponding DLC name, the space unit name, space unit code, associated organization name, department count, number of supervisees, and the highest research volume ever recorded for each department count group. Do not return any rounded answers.\", \"id\": \"dw_4452\", \"name\": \"Provost Area Department School-Area Ranks with Space Unit 97500 Supervisor Usage Statistics\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.HR_DEPARTMENT_CODE, t1.HR_DEPARTMENT_NAME, t1.ORG_HIER_SCHOOL_AREA_NAME, RANK() OVER (PARTITION BY t1.ORG_HIER_SCHOOL_AREA_NAME ORDER BY t1.HR_DEPARTMENT_CODE) AS window_column, t1.DLC_KEY FROM MASTER_DEPT_HIERARCHY t0 INNER JOIN HR_ORG_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' ), DeptRanked AS ( SELECT inner_cte1.HR_DEPARTMENT_CODE, inner_cte1.HR_DEPARTMENT_NAME, inner_cte1.ORG_HIER_SCHOOL_AREA_NAME, inner_cte1.window_column, t2.DLC_NAME, inner_cte1.DLC_KEY FROM inner_cte1 INNER JOIN HR_ORG_UNIT t2 ON inner_cte1.DLC_KEY = t2.DLC_KEY ), inner_cte2 AS ( SELECT t1.SPACE_UNIT AS space_unit_name, t1.SPACE_UNIT_CODE, t0.ORGANIZATION_NAME, t2.DEPT_COUNT, t2.NUM_OF_SUPERVISEES, t2.RESEARCH_VOLUME, t1.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN SPACE_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY JOIN SPACE_SUPERVISOR_USAGE t2 ON t1.DLC_KEY = t2.DEPT_NAMES WHERE t1.SPACE_UNIT_CODE = 97500 ), SpaceStats AS ( SELECT space_unit_name, SPACE_UNIT_CODE, ORGANIZATION_NAME, DEPT_COUNT, NUM_OF_SUPERVISEES, MAX(RESEARCH_VOLUME) AS highest_research_volume, DLC_KEY FROM inner_cte2 GROUP BY space_unit_name, SPACE_UNIT_CODE, ORGANIZATION_NAME, DEPT_COUNT, NUM_OF_SUPERVISEES, DLC_KEY ) SELECT d.HR_DEPARTMENT_CODE, d.HR_DEPARTMENT_NAME, d.ORG_HIER_SCHOOL_AREA_NAME, d.window_column, d.DLC_NAME, s.space_unit_name, s.SPACE_UNIT_CODE, s.ORGANIZATION_NAME, s.DEPT_COUNT, s.NUM_OF_SUPERVISEES, s.highest_research_volume FROM DeptRanked d JOIN SpaceStats s ON d.DLC_KEY = s.DLC_KEY ORDER BY d.HR_DEPARTMENT_CODE, s.space_unit_name;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\"}, {\"default_granularity\": \"one row per S H&SS organization space unit rollup row (including SUBTOTAL and TOTAL rows) with supervisor usage statistics\", \"desc\": \"For each organization whose parent is 'S H&SS' and that is associated with a space unit with space unit code 97500, list the organization name, description, HR org unit title, row number within a window of 2 preceding and 1 following rows ordered by the organization name, the space unit name, space unit code, department count, number of supervisees, the average department count within each department count group ordered by number of supervisees, and the total square footage for each organization. Include subtotals for each organization (the corresponding organization name field is 'SUBTOTAL') and a grand total across all organizations (the corresponding organization name field is 'TOTAL'). Do not repeat the organization name if it is the same as the previous row. Sort the table by organization name and space unit name. Do not return any rounded answers.\", \"id\": \"dw_4612\", \"name\": \"S H&SS Organization Rollup with Space Unit 97500 Supervisor Usage Statistics and Total Square Footage\", \"sql\": \"WITH inner_cte AS ( WITH OrgWindowed AS ( SELECT t0.ORGANIZATION_NAME, t0.DESCRIPTION, t1.HR_ORG_UNIT_TITLE, ROW_NUMBER() OVER (ORDER BY t0.ORGANIZATION_NAME ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t0.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN HR_ORG_UNIT t1 ON t0.HR_ORG_UNIT_ID = t1.HR_ORG_UNIT_ID WHERE t0.ORG_PARENT = 'S H&SS' ), SpaceUnitStats AS ( SELECT t1.SPACE_UNIT AS space_unit_name, t1.SPACE_UNIT_CODE, t0.ORGANIZATION_NAME, t2.DEPT_COUNT, t2.NUM_OF_SUPERVISEES, AVG(t2.DEPT_COUNT) OVER (PARTITION BY t2.DEPT_COUNT ORDER BY t2.NUM_OF_SUPERVISEES) AS avg_dept_count_within_group, t2.SQFT, t1.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN SPACE_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY JOIN SPACE_SUPERVISOR_USAGE t2 ON t1.DLC_KEY = t2.DEPT_NAMES WHERE t1.SPACE_UNIT_CODE = 97500 ) SELECT ow.ORGANIZATION_NAME, ow.DESCRIPTION, ow.HR_ORG_UNIT_TITLE, ow.window_column, sus.space_unit_name, sus.SPACE_UNIT_CODE, sus.DEPT_COUNT, sus.NUM_OF_SUPERVISEES, sus.avg_dept_count_within_group, sus.SQFT FROM OrgWindowed ow JOIN SpaceUnitStats sus ON ow.DLC_KEY = sus.DLC_KEY ) SELECT CASE WHEN LAG(ORGANIZATION_NAME) OVER (ORDER BY org_sort, space_unit_name) = ORGANIZATION_NAME THEN NULL ELSE ORGANIZATION_NAME END AS organization_name, DESCRIPTION, HR_ORG_UNIT_TITLE, window_column, space_unit_name, SPACE_UNIT_CODE, DEPT_COUNT, NUM_OF_SUPERVISEES, avg_dept_count_within_group, SQFT, SUM(SQFT) OVER (PARTITION BY ORGANIZATION_NAME) AS total_sqft_per_org FROM ( SELECT CASE WHEN GROUPING(ORGANIZATION_NAME) = 1 AND GROUPING(space_unit_name) = 1 THEN 'zzz' ELSE ORGANIZATION_NAME END AS org_sort, CASE WHEN GROUPING(ORGANIZATION_NAME) = 0 AND GROUPING(space_unit_name) = 1 THEN 'SUBTOTAL' WHEN GROUPING(ORGANIZATION_NAME) = 1 AND GROUPING(space_unit_name) = 1 THEN 'TOTAL' ELSE ORGANIZATION_NAME END AS ORGANIZATION_NAME, DESCRIPTION, HR_ORG_UNIT_TITLE, window_column, CASE WHEN GROUPING(ORGANIZATION_NAME) = 0 AND GROUPING(space_unit_name) = 1 THEN 'zzz' ELSE space_unit_name END AS space_unit_sort, space_unit_name, SPACE_UNIT_CODE, DEPT_COUNT, NUM_OF_SUPERVISEES, avg_dept_count_within_group, SQFT FROM inner_cte GROUP BY ORGANIZATION_NAME, DESCRIPTION, HR_ORG_UNIT_TITLE, window_column, space_unit_name, SPACE_UNIT_CODE, DEPT_COUNT, NUM_OF_SUPERVISEES, avg_dept_count_within_group, SQFT WITH ROLLUP ) tbl ORDER BY org_sort, space_unit_sort;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\"}], \"not_found\": []}"
    },
