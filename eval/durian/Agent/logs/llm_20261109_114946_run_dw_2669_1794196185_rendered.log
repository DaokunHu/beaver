      "tool_call_id": "call_d560afdd636b4b80b5bdd6c1",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_3235\", \"name\": \"Provost Area Department Facility Organization Counts with HR Org Unit Count Dispersion\", \"desc\": \"For each department name and its corresponding facility organization key where the department is in the Provost Area, provide the number of organizations, the minimum department hierarchy level 3 code, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the number of HR organization units per facility organization (considering only those with a non-null DLC key and where the hierarchy type is 'Standard Hierarchy'), listing the results in order by department name and facility organization key. Do not return any rounded answers.\", \"sql\": \"WITH ProvostAreaDepts AS ( SELECT m.DLC_NAME, f.FCLT_ORGANIZATION_KEY, COUNT(f.FCLT_ORGANIZATION_KEY) AS org_count, MIN(m.MASTER_DEPT_HIER_LEVEL_3_CODE) AS min_level3_code FROM MASTER_DEPT_HIERARCHY m JOIN FCLT_ORG_DLC_KEY f ON m.DLC_KEY = f.DLC_KEY WHERE m.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' GROUP BY m.DLC_NAME, f.FCLT_ORGANIZATION_KEY ), FacilityOrgStats AS ( SELECT f.FCLT_ORGANIZATION_KEY, MAX(hr_unit_count) - MIN(hr_unit_count) AS org_unit_count_range, VARIANCE(hr_unit_count) AS org_unit_count_variance, STDDEV(hr_unit_count) AS org_unit_count_stddev FROM FCLT_ORG_DLC_KEY f JOIN MASTER_DEPT_HIERARCHY m ON f.DLC_KEY = m.DLC_KEY JOIN ( SELECT h.DLC_KEY, COUNT(*) AS hr_unit_count FROM HR_ORG_UNIT h WHERE h.DLC_KEY IS NOT NULL GROUP BY h.DLC_KEY ) AS hr_stats ON m.DLC_KEY = hr_stats.DLC_KEY WHERE f.DLC_KEY IS NOT NULL AND m.HIERARCHY_TYPE = 'Standard Hierarchy' GROUP BY f.FCLT_ORGANIZATION_KEY ORDER BY org_unit_count_range DESC ), CombinedProvostFacility AS ( SELECT p.DLC_NAME, p.FCLT_ORGANIZATION_KEY, p.org_count, p.min_level3_code, f.org_unit_count_range, f.org_unit_count_variance, f.org_unit_count_stddev FROM ProvostAreaDepts p JOIN FacilityOrgStats f ON p.FCLT_ORGANIZATION_KEY = f.FCLT_ORGANIZATION_KEY ) SELECT * FROM CombinedProvostFacility ORDER BY DLC_NAME, FCLT_ORGANIZATION_KEY;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per Provost Area department name and facility organization key with HR org unit count dispersion statistics\"}, {\"id\": \"dw_1465\", \"name\": \"Provost Area School of Science Department Organizations with Max Average Organization Number and Room Area Stddev\", \"desc\": \"For each department in the Provost Area at the School of Science level, excluding the Biology department, and for each organization within those departments (excluding organizations with IDs '138' and '250'), show the department name, department code, organization name, organization ID, the maximum average organization number within each department code group, and the standard deviation (using STDDEV only and never STDDEV_POP) of the area of rooms assigned to the organization (considering only organizations with more than 5 rooms and excluding organizations named 'ADMISSIONS'), ordered by department name and organization name. Do not return any rounded answers.\", \"sql\": \"WITH dept_max_avg_org AS ( WITH inner_cte AS ( SELECT t0.DLC_NAME, t0.DLC_CODE, t1.ORGANIZATION_NAME, t1.ORGANIZATION_ID, AVG(t1.ORGANIZATION_NUMBER) OVER (PARTITION BY t0.DLC_CODE ORDER BY t1.ORGANIZATION_SORT) AS avg_org_number FROM MASTER_DEPT_HIERARCHY t0 JOIN FCLT_ORGANIZATION t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' AND t0.MASTER_DEPT_HIER_LEVEL_3_NAME = 'School of Science' AND LOWER(t0.DLC_NAME) <> LOWER('Biology') AND t1.ORGANIZATION_ID NOT IN ('138', '250') ) SELECT DLC_NAME, DLC_CODE, ORGANIZATION_NAME, ORGANIZATION_ID, MAX(avg_org_number) AS max_avg_org_number FROM inner_cte GROUP BY DLC_NAME, DLC_CODE, ORGANIZATION_NAME, ORGANIZATION_ID ), org_area_stddev AS ( WITH inner_cte AS ( SELECT fo.ORGANIZATION_NAME, STDDEV(fr.AREA) AS area_stddev, fo.FCLT_ORGANIZATION_KEY FROM FCLT_ROOMS fr JOIN FCLT_ORGANIZATION fo ON fr.FCLT_ORGANIZATION_KEY = fo.FCLT_ORGANIZATION_KEY WHERE fo.ORGANIZATION_NAME <> 'ADMISSIONS' GROUP BY fo.ORGANIZATION_NAME, fo.FCLT_ORGANIZATION_KEY HAVING COUNT(fr.FCLT_ROOM_KEY) > 5 ) SELECT i.ORGANIZATION_NAME, fo.ORGANIZATION_NUMBER AS dept_code, i.area_stddev, fo.FCLT_ORGANIZATION_KEY FROM inner_cte i JOIN FCLT_ORGANIZATION fo ON i.FCLT_ORGANIZATION_KEY = fo.FCLT_ORGANIZATION_KEY ) SELECT d.DLC_NAME, d.DLC_CODE, d.ORGANIZATION_NAME, d.ORGANIZATION_ID, d.max_avg_org_number, o.area_stddev FROM dept_max_avg_org d JOIN FCLT_ORGANIZATION fo ON d.ORGANIZATION_ID = fo.ORGANIZATION_ID JOIN org_area_stddev o ON fo.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY ORDER BY d.DLC_NAME, d.ORGANIZATION_NAME\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per School-of-Science department organization matched with its room area standard deviation\"}, {\"id\": \"dw_2559\", \"name\": \"Office-Named DLCs with Assignable Organization Counts, Provost Area Department Max Organization Number, Space Unit, and Earliest Load Date\", \"desc\": \"For each DLC whose DLC name contains the word 'Office', is not the biology department, and has at least one assignable organization, what are the DLC key, DLC name, the number of unique organizations, the total number of assignable organizations, the department name, the maximum organization number, the name of the space unit associated with that department, and the earliest warehouse load date among its organizations, considering only departments in the \\\"Provost Area\\\" with a maximum organization number greater than 50000 and excluding the \\\"Political Science\\\" department (Course 17)? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT d.DLC_KEY, o.DLC_NAME, COUNT(DISTINCT o.FCLT_ORGANIZATION_KEY) AS organization_count, SUM(CASE WHEN o.ASSIGNABLE = 1 THEN 1 ELSE 0 END) AS assignable_organization_count FROM FCLT_ORG_DLC_KEY d JOIN FCLT_ORGANIZATION o ON d.DLC_KEY = o.DLC_KEY WHERE o.ASSIGNABLE = 1 AND o.DLC_NAME LIKE '%Office%' AND LOWER(o.DLC_NAME) != LOWER('Biology') GROUP BY d.DLC_KEY, o.DLC_NAME ), Dept_Max_Org_Space AS ( SELECT mdh.DLC_KEY, mdh.DLC_NAME AS department, MAX(fo.ORGANIZATION_NUMBER) AS max_organization_number, su.SPACE_UNIT AS space_unit_name FROM MASTER_DEPT_HIERARCHY mdh JOIN FCLT_ORGANIZATION fo ON mdh.DLC_KEY = fo.DLC_KEY LEFT JOIN SPACE_UNIT su ON fo.DLC_KEY = su.DLC_KEY WHERE mdh.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' AND fo.ORGANIZATION_NUMBER > 50000 AND mdh.DLC_NAME <> 'Political Science' GROUP BY mdh.DLC_KEY, mdh.DLC_NAME, su.SPACE_UNIT ), Org_Earliest_Load AS ( SELECT o.DLC_KEY, MIN(o.WAREHOUSE_LOAD_DATE) AS earliest_warehouse_load_date FROM FCLT_ORGANIZATION o GROUP BY o.DLC_KEY ) SELECT ic.DLC_KEY, ic.DLC_NAME, ic.organization_count, ic.assignable_organization_count, dmos.department, dmos.max_organization_number, dmos.space_unit_name, oel.earliest_warehouse_load_date FROM inner_cte ic JOIN Dept_Max_Org_Space dmos ON ic.DLC_KEY = dmos.DLC_KEY LEFT JOIN Org_Earliest_Load oel ON ic.DLC_KEY = oel.DLC_KEY;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per Office-named DLC matched with Provost Area department space unit and load date statistics\"}, {\"category\": \"Course Catalog and Facility Space Comprehensive Analysis\", \"default_granularity\": \"one row per department-grade-type rollup row matched with organization room area statistics\", \"desc\": \"For each department and subject grade type where the subject is offered in the current academic year, is letter graded, and the department is Mathematics (Course 18), provide the number of subjects, the minimum total units, the school name, the department phone number, the organization name, the standard deviation (using STDDEV only and never STDDEV_POP) of the areas of its rooms, and the department's DLC name, including subtotals for each department (the corresponding department field is 'SUBTOTAL') and a grand total across all departments (the corresponding department field is 'TOTAL'). Do not repeat the department if it is the same as the previous row. Only include organizations that have more than 5 rooms, are associated with a non-null DLC key, and are not the 'ADMISSIONS' department or the 'Political Science' department. Sort the table by department, grade type, and descending standard deviation (using STDDEV only and never STDDEV_POP) of room areas. Do not return any rounded answers.\", \"id\": \"dw_1833\", \"name\": \"Math Letter-Graded Subject Rollup by Grade Type with Organization Room Area Stddev and DLC Name\", \"sql\": \"WITH inner_cte1 AS ( SELECT d.DEPARTMENT_NAME, c.GRADE_TYPE, COUNT(c.SUBJECT_ID) AS subject_count, MIN(c.TOTAL_UNITS) AS min_total_units FROM SIS_DEPARTMENT d JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON d.DEPARTMENT_CODE = c.DEPARTMENT_CODE WHERE c.IS_OFFERED_THIS_YEAR = 'Y' AND c.GRADE_TYPE = 'L' AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME, c.GRADE_TYPE ), cte1 AS ( SELECT CASE WHEN LAG(dept) OVER (ORDER BY dept_sort, grade_type) = dept THEN NULL ELSE dept END AS department, grade_type, subject_count, min_total_units, sd.SCHOOL_NAME AS school_name, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.DLC_KEY AS dlc_key FROM ( SELECT CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'zzz' ELSE DEPARTMENT_NAME END AS dept_sort, CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'TOTAL' ELSE DEPARTMENT_NAME END AS dept, GRADE_TYPE AS grade_type, COUNT(SUBJECT_COUNT) AS subject_count, MIN(min_total_units) AS min_total_units FROM inner_cte1 GROUP BY DEPARTMENT_NAME, GRADE_TYPE WITH ROLLUP ) tbltmp LEFT JOIN SIS_DEPARTMENT sd ON tbltmp.dept = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), inner_cte2 AS ( SELECT o.ORGANIZATION_NAME, STDDEV(r.AREA) AS area_stddev, o.DLC_KEY FROM FCLT_ORG_DLC_KEY d JOIN FCLT_ORGANIZATION o ON d.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY JOIN FCLT_ROOMS r ON o.FCLT_ORGANIZATION_KEY = r.FCLT_ORGANIZATION_KEY WHERE d.DLC_KEY IS NOT NULL AND o.ORGANIZATION_NAME NOT IN ('ADMISSIONS') AND o.ORGANIZATION_NAME <> 'Political Science' GROUP BY o.ORGANIZATION_NAME, o.DLC_KEY HAVING COUNT(*) > 5 ), cte2 AS ( SELECT inner_cte2.ORGANIZATION_NAME, inner_cte2.area_stddev, o2.DLC_NAME, inner_cte2.DLC_KEY FROM inner_cte2 JOIN FCLT_ORGANIZATION o2 ON inner_cte2.DLC_KEY = o2.DLC_KEY ) SELECT cte1.department, cte1.grade_type, cte1.subject_count, cte1.min_total_units, cte1.school_name, cte1.department_phone, cte2.ORGANIZATION_NAME, cte2.area_stddev, cte2.DLC_NAME FROM cte1 LEFT JOIN cte2 ON cte1.dlc_key = cte2.DLC_KEY ORDER BY cte1.department, cte1.grade_type, cte2.area_stddev DESC;\"}], \"not_found\": []}"
    },
