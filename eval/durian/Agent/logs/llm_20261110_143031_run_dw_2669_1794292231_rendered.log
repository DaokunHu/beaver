      "name": "semantic_graph",
      "content": "{\"ok\": true, \"table_id\": \"SPACE_SUPERVISOR_USAGE\", \"table_name\": \"SPACE_SUPERVISOR_USAGE\", \"count\": 3, \"items\": [{\"metric_id\": \"dw_4452\", \"name\": \"Provost Area Department School-Area Ranks with Space Unit 97500 Supervisor Usage Statistics\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"desc\": \"For each department in the \\\"Provost Area\\\" that is associated with a space unit with space unit code 97500, show the department code, department name, school area name, the rank of each department within its school area based on department code, the corresponding DLC name, the space unit name, space unit code, associated organization name, department count, number of supervisees, and the highest research volume ever recorded for each department count group. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4612\", \"name\": \"S H&SS Organization Rollup with Space Unit 97500 Supervisor Usage Statistics and Total Square Footage\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"desc\": \"For each organization whose parent is 'S H&SS' and that is associated with a space unit with space unit code 97500, list the organization name, description, HR org unit title, row number within a window of 2 preceding and 1 following rows ordered by the organization name, the space unit name, space unit code, department count, number of supervisees, the average department count within each department count group ordered by number of supervisees, and the total square footage for each organization. Include subtotals for each organization (the corresponding organization name field is 'SUBTOTAL') and a grand total across all organizations (the corresponding organization name field is 'TOTAL'). Do not repeat the organization name if it is the same as the previous row. Sort the table by organization name and space unit name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2896\", \"name\": \"Two-Supervisee Supervisor Records with 5-Row Windowed Average Square Footage Above 200 per Facility Organization\", \"category\": \"Facility Space Analysis\", \"desc\": \"For each facility organization, show the research volume, department names, square footage, MIT ID, and the average square footage in a window of 2 preceding and 2 following rows (grouped by facility organization key and ordered by research volume) for space supervisor usage records where the number of supervisees is 2, and only include those records where the average square footage in the window is greater than 200. Do not return any rounded answers.\"}]}"
