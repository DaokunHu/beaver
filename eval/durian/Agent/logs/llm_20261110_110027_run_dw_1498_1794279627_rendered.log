      "content": "{\"ok\": true, \"entity\": {\"id\": \"concept_department_dimension\", \"name\": \"Department and School Dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\", \"tables\": [\"SIS_DEPARTMENT\", \"STUDENT_DEPARTMENT\", \"SIS_ADMIN_DEPARTMENT\"], \"comparisons\": [{\"dimension\": \"Attribute coverage\", \"SIS_DEPARTMENT\": \"Richest: DEPARTMENT_FULL_NAME, SCHOOL_CODE/SCHOOL_NAME, DEPT_BUDGET_CODE, IS_DEGREE_GRANTING, commencement-book names, DLC key\", \"STUDENT_DEPARTMENT\": \"Minimal: code, name, full name, school code/name only\", \"SIS_ADMIN_DEPARTMENT\": \"Administrative contact: department phone area code/number, clearing cost collector\"}, {\"dimension\": \"Degree-granting and school filtering\", \"SIS_DEPARTMENT\": \"Supports IS_DEGREE_GRANTING and SCHOOL_NAME filters directly\", \"STUDENT_DEPARTMENT\": \"Only school code/name attribution, no degree-granting flag\", \"SIS_ADMIN_DEPARTMENT\": \"No school or degree-granting attributes\"}, {\"dimension\": \"Typical join path\", \"SIS_DEPARTMENT\": \"DEPARTMENT_CODE = offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE; also joins SIS_COURSE_DESCRIPTION.DEPARTMENT and SIS_ADMIN_DEPARTMENT.SIS_ADMIN_DEPARTMENT_CODE\", \"STUDENT_DEPARTMENT\": \"DEPARTMENT_CODE = TIP_SUBJECT_OFFERED.OFFER_DEPT_CODE and other offering department codes\", \"SIS_ADMIN_DEPARTMENT\": \"SIS_ADMIN_DEPARTMENT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE\"}, {\"dimension\": \"Budget/finance attributes\", \"SIS_DEPARTMENT\": \"DEPT_BUDGET_CODE available for budget-based ranking\", \"STUDENT_DEPARTMENT\": \"None\", \"SIS_ADMIN_DEPARTMENT\": \"CLEARING_COST_COLLECTOR\"}], \"decision_guide\": {\"Questions filtering departments by school (e.g. 'School of Engineering') or degree-granting status\": \"Use SIS_DEPARTMENT; it carries SCHOOL_NAME and IS_DEGREE_GRANTING.\", \"Questions needing only department full name and school name for offering departments (e.g. TIP subject offerings)\": \"STUDENT_DEPARTMENT suffices and is the lighter lookup; SIS_DEPARTMENT also works.\", \"Questions needing department phone numbers or administrative contact details\": \"Join SIS_ADMIN_DEPARTMENT via SIS_DEPARTMENT.DEPARTMENT_CODE = SIS_ADMIN_DEPARTMENT_CODE.\", \"Questions ranking or grouping departments by budget code\": \"Use SIS_DEPARTMENT.DEPT_BUDGET_CODE.\"}}}"
