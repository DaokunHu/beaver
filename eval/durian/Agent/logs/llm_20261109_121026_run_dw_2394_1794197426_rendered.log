            "arguments": "{\"sql\": \"WITH cip_dept AS (\\n  SELECT d.DEPARTMENT_NAME, MAX(c.CIP_PROGRAM_CODE) AS max_cip_code, d.DEPARTMENT_FULL_NAME\\n  FROM SIS_COURSE_DESCRIPTION c\\n  JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE\\n  WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_NAME != 'Mathematics'\\n  GROUP BY d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME\\n  HAVING MAX(c.CIP_PROGRAM_CODE) > 120000\\n),\\nbase AS (\\n  SELECT t.TERM_CODE, d.DEPARTMENT_NAME, t.NUM_ENROLLED_STUDENTS, cd.max_cip_code, cd.DEPARTMENT_FULL_NAME\\n  FROM TIP_SUBJECT_OFFERED t\\n  JOIN SIS_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE\\n  JOIN cip_dept cd ON d.DEPARTMENT_NAME = cd.DEPARTMENT_NAME\\n  WHERE t.OFFER_DEPT_NAME = 'Chemistry' AND t.IS_NO_COURSE_MATERIAL = 'N'\\n)\\nSELECT CASE WHEN LAG(term) OVER (ORDER BY term_sort, dept_sort) = term THEN NULL ELSE term END AS term,\\n       dept, avg_enrolled, stddev_enrolled, max_cip_code, dept_full_name\\nFROM (\\n  SELECT CASE WHEN GROUPING(TERM_CODE)=1 AND GROUPING(DEPARTMENT_NAME)=1 THEN 'zzz' ELSE TERM_CODE END AS term_sort,\\n         CASE WHEN GROUPING(TERM_CODE)=0 AND GROUPING(DEPARTMENT_NAME)=1 THEN 'SUBTOTAL'\\n              WHEN GROUPING(TERM_CODE)=1 AND GROUPING(DEPARTMENT_NAME)=1 THEN 'TOTAL'\\n              ELSE TERM_CODE END AS term,\\n         CASE WHEN GROUPING(TERM_CODE)=0 AND GROUPING(DEPARTMENT_NAME)=1 THEN 'zzz' ELSE DEPARTMENT_NAME END AS dept_sort,\\n         DEPARTMENT_NAME AS dept,\\n         AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled,\\n         STDDEV(NUM_ENROLLED_STUDENTS) AS stddev_enrolled,\\n         MAX(max_cip_code) AS max_cip_code,\\n         MAX(DEPARTMENT_FULL_NAME) AS dept_full_name\\n  FROM base\\n  GROUP BY TERM_CODE, DEPARTMENT_NAME WITH ROLLUP\\n) tbltmp\\nORDER BY term_sort, dept_sort\"}"
