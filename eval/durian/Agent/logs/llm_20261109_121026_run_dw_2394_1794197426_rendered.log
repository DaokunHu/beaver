    {
      "role": "tool",
      "tool_call_id": "call_1fa14da2c6e641d2b227b766",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Facility Space Comprehensive Analysis\", \"default_granularity\": \"one row per department-grade-type rollup row matched with organization room area statistics\", \"desc\": \"For each department and subject grade type where the subject is offered in the current academic year, is letter graded, and the department is Mathematics (Course 18), provide the number of subjects, the minimum total units, the school name, the department phone number, the organization name, the standard deviation (using STDDEV only and never STDDEV_POP) of the areas of its rooms, and the department's DLC name, including subtotals for each department (the corresponding department field is 'SUBTOTAL') and a grand total across all departments (the corresponding department field is 'TOTAL'). Do not repeat the department if it is the same as the previous row. Only include organizations that have more than 5 rooms, are associated with a non-null DLC key, and are not the 'ADMISSIONS' department or the 'Political Science' department. Sort the table by department, grade type, and descending standard deviation (using STDDEV only and never STDDEV_POP) of room areas. Do not return any rounded answers.\", \"id\": \"dw_1833\", \"name\": \"Math Letter-Graded Subject Rollup by Grade Type with Organization Room Area Stddev and DLC Name\", \"sql\": \"WITH inner_cte1 AS ( SELECT d.DEPARTMENT_NAME, c.GRADE_TYPE, COUNT(c.SUBJECT_ID) AS subject_count, MIN(c.TOTAL_UNITS) AS min_total_units FROM SIS_DEPARTMENT d JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON d.DEPARTMENT_CODE = c.DEPARTMENT_CODE WHERE c.IS_OFFERED_THIS_YEAR = 'Y' AND c.GRADE_TYPE = 'L' AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME, c.GRADE_TYPE ), cte1 AS ( SELECT CASE WHEN LAG(dept) OVER (ORDER BY dept_sort, grade_type) = dept THEN NULL ELSE dept END AS department, grade_type, subject_count, min_total_units, sd.SCHOOL_NAME AS school_name, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.DLC_KEY AS dlc_key FROM ( SELECT CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'zzz' ELSE DEPARTMENT_NAME END AS dept_sort, CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'TOTAL' ELSE DEPARTMENT_NAME END AS dept, GRADE_TYPE AS grade_type, COUNT(SUBJECT_COUNT) AS subject_count, MIN(min_total_units) AS min_total_units FROM inner_cte1 GROUP BY DEPARTMENT_NAME, GRADE_TYPE WITH ROLLUP ) tbltmp LEFT JOIN SIS_DEPARTMENT sd ON tbltmp.dept = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), inner_cte2 AS ( SELECT o.ORGANIZATION_NAME, STDDEV(r.AREA) AS area_stddev, o.DLC_KEY FROM FCLT_ORG_DLC_KEY d JOIN FCLT_ORGANIZATION o ON d.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY JOIN FCLT_ROOMS r ON o.FCLT_ORGANIZATION_KEY = r.FCLT_ORGANIZATION_KEY WHERE d.DLC_KEY IS NOT NULL AND o.ORGANIZATION_NAME NOT IN ('ADMISSIONS') AND o.ORGANIZATION_NAME <> 'Political Science' GROUP BY o.ORGANIZATION_NAME, o.DLC_KEY HAVING COUNT(*) > 5 ), cte2 AS ( SELECT inner_cte2.ORGANIZATION_NAME, inner_cte2.area_stddev, o2.DLC_NAME, inner_cte2.DLC_KEY FROM inner_cte2 JOIN FCLT_ORGANIZATION o2 ON inner_cte2.DLC_KEY = o2.DLC_KEY ) SELECT cte1.department, cte1.grade_type, cte1.subject_count, cte1.min_total_units, cte1.school_name, cte1.department_phone, cte2.ORGANIZATION_NAME, cte2.area_stddev, cte2.DLC_NAME FROM cte1 LEFT JOIN cte2 ON cte1.dlc_key = cte2.DLC_KEY ORDER BY cte1.department, cte1.grade_type, cte2.area_stddev DESC;\"}, {\"id\": \"dw_1357\", \"name\": \"Access Level Campus Sector Room Count Variance Rollup with Fairchild Floor Room Area Statistics\", \"desc\": \"For each access level code and campus sector, what is the access level code, access level name, campus sector, the variance of the number of rooms in the building history for buildings with a nonzero number of rooms, assignable area greater than 0, and that are residential buildings at MIT, as well as, for each floor in the Fairchild Building with access level 1 or 2 and in academic buildings, the floor number, the building's long name, the range and variance of the area of rooms on that floor? Only include buildings that are at MIT. Also, include subtotals for each access level code (the corresponding campus sector field is 'SUBTOTAL') and a grand total across all access level codes (the corresponding campus sector field is 'TOTAL'). Do not repeat the access level code if it is the same as the previous row. Sort the table by access level code, campus sector, and floor. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte1 AS ( SELECT fb.ACCESS_LEVEL_CODE, fb.ACCESS_LEVEL_NAME, fbh.CAMPUS_SECTOR, fbh.NUM_OF_ROOMS FROM FCLT_BUILDING fb JOIN FCLT_BUILDING_HIST fbh ON fb.ACCESS_LEVEL_CODE = fbh.ACCESS_LEVEL_CODE WHERE fbh.NUM_OF_ROOMS > 0 AND fbh.ASSIGNABLE_AREA > 0 AND fbh.BUILDING_TYPE = 'RESIDENT' AND fbh.SITE = 'MIT' ), access_level_variance AS ( SELECT CASE WHEN LAG(ACCESS_LEVEL_CODE) OVER (ORDER BY access_level_code_sort, campus_sector_sort) = ACCESS_LEVEL_CODE THEN NULL ELSE ACCESS_LEVEL_CODE END AS access_level_code, ACCESS_LEVEL_NAME, campus_sector, num_of_rooms_variance, ACCESS_LEVEL_CODE AS join_access_level_code FROM ( SELECT CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 1 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'zzz' ELSE ACCESS_LEVEL_CODE END AS access_level_code_sort, CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 0 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'SUBTOTAL' WHEN GROUPING(ACCESS_LEVEL_CODE) = 1 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'TOTAL' ELSE CAMPUS_SECTOR END AS campus_sector, CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 0 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'zzz' ELSE CAMPUS_SECTOR END AS campus_sector_sort, ACCESS_LEVEL_CODE, MAX(ACCESS_LEVEL_NAME) AS ACCESS_LEVEL_NAME, VARIANCE(NUM_OF_ROOMS) AS num_of_rooms_variance FROM inner_cte1 GROUP BY ACCESS_LEVEL_CODE, CAMPUS_SECTOR WITH ROLLUP ) tbl ORDER BY access_level_code_sort, campus_sector_sort ), inner_cte2 AS ( SELECT fb.BUILDING_NAME_LONG, fr.FCLT_FLOOR_KEY, fr.AREA FROM FCLT_ROOMS fr JOIN FCLT_BUILDING fb ON fr.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY WHERE fr.ACCESS_LEVEL IN (1, 2) AND fb.BUILDING_TYPE = 'ACADEMIC' AND fb.FCLT_BUILDING_KEY = '36' ), floor_area_stats AS ( SELECT f.FLOOR, i.BUILDING_NAME_LONG, MAX(i.AREA) - MIN(i.AREA) AS area_range, VARIANCE(i.AREA) AS area_variance, fb.ACCESS_LEVEL_CODE AS join_access_level_code FROM inner_cte2 i JOIN FCLT_FLOOR f ON i.FCLT_FLOOR_KEY = f.FCLT_FLOOR_KEY JOIN FCLT_BUILDING fb ON fb.BUILDING_NAME_LONG = i.BUILDING_NAME_LONG GROUP BY f.FLOOR, i.BUILDING_NAME_LONG, fb.ACCESS_LEVEL_CODE ) SELECT alv.access_level_code, alv.ACCESS_LEVEL_NAME, alv.campus_sector, alv.num_of_rooms_variance, fas.FLOOR, fas.BUILDING_NAME_LONG, fas.area_range, fas.area_variance FROM access_level_variance alv JOIN floor_area_stats fas ON alv.join_access_level_code = fas.join_access_level_code ORDER BY alv.access_level_code, alv.campus_sector, fas.FLOOR\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per access-level/campus-sector rollup row matched with a floor of the selected academic building\"}], \"not_found\": []}"
