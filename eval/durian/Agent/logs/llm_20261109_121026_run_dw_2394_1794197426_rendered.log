    {
      "role": "tool",
      "tool_call_id": "call_05c4cb62c3da4584ac49ccc3",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 20, \"items_by_type\": {\"metric\": [{\"id\": \"dw_2958\", \"desc\": \"For each academic year, among subjects that are not repeatable, what is the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by each department? List the academic year, department name, average enrollment, variance, and standard deviation (using STDDEV only and never STDDEV_POP), ordered by variance descending. Do not return any rounded answers.\"}, {\"id\": \"dw_2597\", \"desc\": \"For each academic year, what is the description of the academic year, the department name, the average total units for all subjects offered by that department in terms that match that academic year and have a term status indicator of 'P', and the deviation of each department's average total units from the overall average total units for that academic year? Do not return any rounded answers.\"}, {\"id\": \"dw_3417\", \"desc\": \"For each academic term where the term status indicator is 'P', show the term code, the term parameter, the term description, the academic year, the term start date, and the average academic year in a window of 2 preceding and 2 following rows grouped by the term indicator and ordered by the term start date. Additionally, for the academic year of each such term, give the academic year description, the average total units, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in regular terms, with the results ordered by term code and by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_2850\", \"desc\": \"For each term and department, what is the term, department, and the variance of the reserve catalog keys for courses in that department and term where the material status is 'U'? Include subtotals for each term (the corresponding term field is 'SUBTOTAL') and a grand total across all terms (the corresponding term field is 'TOTAL'). Do not repeat the term if it is the same as the previous row. Sort the table by term and department. Do not return any rounded answers.\"}, {\"id\": \"dw_4325\", \"desc\": \"For each academic term that is not cancelled, has at least one IAP subject activity with a non-null maximum enrollment, and where the term status is 'Previous', provide the term description, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment values for IAP subject activities in that term, the academic year description, the term code, term start date, calendar date, day of week, the average calendar year within each calendar year group ordered by term start date, the academic year, and the last day of final exam, ordered by the range of maximum enrollment in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_1393\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_41\", \"desc\": \"For each academic year, provide the academic year description and calculate the average and variance of the total units for subjects offered in terms that are not the current term, have a term status indicator of 'P', are offered by the Mathematics department, and are full term subjects. Do not return any rounded answers.\"}, {\"id\": \"dw_1350\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\"}, {\"id\": \"dw_1833\", \"desc\": \"For each department and subject grade type where the subject is offered in the current academic year, is letter graded, and the department is Mathematics (Course 18), provide the number of subjects, the minimum total units, the school name, the department phone number, the organization name, the standard deviation (using STDDEV only and never STDDEV_POP) of the areas of its rooms, and the department's DLC name, including subtotals for each department (the corresponding department field is 'SUBTOTAL') and a grand total across all departments (the corresponding department field is 'TOTAL'). Do not repeat the department if it is the same as the previous row. Only include organizations that have more than 5 rooms, are associated with a non-null DLC key, and are not the 'ADMISSIONS' department or the 'Political Science' department. Sort the table by department, grade type, and descending standard deviation (using STDDEV only and never STDDEV_POP) of room areas. Do not return any rounded answers.\"}, {\"id\": \"dw_1288\", \"desc\": \"For each academic year, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered in that year by the Mathematics department, considering only activities that require advance sign-up and are not cancelled, and also provide the academic year description? For each department, include a grand total for all activities in the format of (department name, null, total variance and stddev). Additionally, for each such department, provide the department code, the department name, and the total number of enrolled students in both the library and tip subject offerings, but only for those departments where the total number of enrolled students is more than one standard deviation (using STDDEV only and never STDDEV_POP) above the mean total enrolled students across all departments, and restrict your answer to departments whose name is 'Mathematics' (Course 18). Also, for each such department, list the names of the responsible faculty members from both the library and tip subject offerings. The columns to display, in order, are: department name, academic year description, total variance, total standard deviation (using STDDEV only and never STDDEV_POP), department code, department name, total enrolled, library faculty, and tip faculty. Do not return any rounded answers.\"}, {\"id\": \"dw_3911\", \"desc\": \"For each subject offered by the library in the term with code '2014FA', show the subject ID, subject title, total number of enrolled students, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, as well as the maximum windowed average record count from tip detail records with material status key 'RQ' (using a window of 2 preceding and 2 following rows grouped by financial aid year). Additionally, for each offering department, include a grand total row showing the total number of enrolled students across all its subjects (with nulls for subject ID and subject title), and the corresponding maximum windowed average record count if available. Order the results by offering department name and subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_1357\", \"desc\": \"For each access level code and campus sector, what is the access level code, access level name, campus sector, the variance of the number of rooms in the building history for buildings with a nonzero number of rooms, assignable area greater than 0, and that are residential buildings at MIT, as well as, for each floor in the Fairchild Building with access level 1 or 2 and in academic buildings, the floor number, the building's long name, the range and variance of the area of rooms on that floor? Only include buildings that are at MIT. Also, include subtotals for each access level code (the corresponding campus sector field is 'SUBTOTAL') and a grand total across all access level codes (the corresponding campus sector field is 'TOTAL'). Do not repeat the access level code if it is the same as the previous row. Sort the table by access level code, campus sector, and floor. Do not return any rounded answers.\"}, {\"id\": \"dw_3530\", \"desc\": \"For each subject offered in the term with code '2012SU', show the subject title, subject ID, offer department name, academic year, term description, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the academic year, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for that subject (considering only subjects offered by the \\\"Harvard Cross-Enrollment Prog\\\" department and with more than 5 offerings). Do not return any rounded answers.\"}, {\"id\": \"dw_4701\", \"desc\": \"For each academic year, what is the academic year, academic year description, the geometric mean of the number of library reserve material details per subject offered (considering only records where the material status is 'U' and the academic term is a regular term), the average total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the average number of design units for subjects that are offered in the fall term and have a material status of 'U' in the library reserve? List the results ordered by the geometric mean of materials per subject in descending order, then by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_4184\", \"desc\": \"For each department, show the offer department name, the number of distinct subjects offered by the department in the academic year 2012, and for each subject that was offered in the term \\\"2012SU\\\", display the subject key, subject title, academic year, term description, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, and the deviation of each subject's enrollment number from the average enrollment number for its subject key group, ordered by offer department name and subject key. Do not return any rounded answers.\"}, {\"id\": \"dw_3973\", \"desc\": \"List the term code, subject ID, minimum record count from TIP_DETAIL, total new shelf price from TIP_MATERIAL, academic year, number of enrolled students, and deviation from the average number of enrolled students for that academic year, for each term and subject where the material has a non-null author and a material info source of 'ISBN', and considering only terms that are not the current term. Do not return any rounded answers.\"}, {\"id\": \"dw_3644\", \"desc\": \"For subjects offered in the 2012SU term with a total of 1 unit, show the subject title from the summary, the course number from the offered table, the subject title from the offered summary, the department name from the summary, the offer department name from the offered summary, the row number within each department name group ordered by subject title from the summary, and for each department, also provide the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student). List the results ordered by department name and row number. Do not return any rounded answers.\"}, {\"id\": \"dw_1301\", \"desc\": \"For each academic year, where the maximum number of total units for any Mathematics (Course 18) subject offered in that year is greater than 9 and there are more than 5 Mathematics subjects offered in the fall term, what are the academic year, the maximum total units, the corresponding term description, the subject title, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in library subjects offered during terms in that year, and the average number of equivalent subjects for those library subjects? List the results in order of academic year. Do not return any rounded answers.\"}, {\"id\": \"dw_1023\", \"desc\": \"For each academic year where the Mathematics department has at least one unique subject with subject enrollment number greater than 10, what are the academic year, academic year description, department name, number of unique subjects, minimum total units offered, variance of total units, and standard deviation (using STDDEV only and never STDDEV_POP) of total units for subjects offered in the fall term that are not variable units and are offered by the Mathematics department? Do not return any rounded answers.\"}, {\"id\": \"dw_3867\", \"desc\": \"For each subject in a department where the school code and subject title are not null, and for each subject offered in the 2022FA term with total units greater than the average for that term, display the subject code, subject code description, department name, subject title, the number of subjects in the same department, the subject ID, the term description, and the running sum of total units for that academic year, ordered by subject ID. Do not return any rounded answers.\"}]}}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_58608253df184543bf33b3e8",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entity\": {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per top-3 Mathematics course per effective term\", \"desc\": \"For the top 3 most frequently offered courses in the Mathematics department, for each course and each term it was offered, display the course number, course description, subject title, number of times offered, department name, number of unique course descriptions for that course and department, the minimum CIP program code for that course and department, the term code, the term description, the school name, and the department phone number. Do not repeat the course number if it is the same as the previous row. Sort the table by course number and term code. Do not return any rounded answers.\", \"id\": \"dw_2365\", \"name\": \"Top 3 Most Offered Math Courses per Term with Description Counts, Min CIP Code, and Department Phone\", \"sql\": \"WITH inner_cte AS ( WITH course_desc_stats AS ( SELECT scd.COURSE, sd.DEPARTMENT_NAME, COUNT(DISTINCT scd.COURSE_DESCRIPTION) AS course_description_count, MIN(scd.CIP_PROGRAM_CODE) AS min_cip_program_code FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT sad ON sd.DEPARTMENT_CODE = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY scd.COURSE, sd.DEPARTMENT_NAME ), top_math_courses AS ( SELECT ssc.COURSE_NUMBER, scd.COURSE_DESCRIPTION, ccc.SUBJECT_TITLE, COUNT(*) AS offer_count FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_SUBJECT_CODE ssc ON scd.COURSE = ssc.SUBJECT_CODE JOIN CIS_COURSE_CATALOG ccc ON ssc.SUBJECT_CODE = ccc.SUBJECT_CODE WHERE scd.DEPARTMENT_NAME = 'Mathematics' GROUP BY ssc.COURSE_NUMBER, scd.COURSE_DESCRIPTION, ccc.SUBJECT_TITLE ORDER BY offer_count DESC LIMIT 3 ) SELECT tmc.COURSE_NUMBER, tmc.COURSE_DESCRIPTION, tmc.SUBJECT_TITLE, tmc.offer_count, cds.DEPARTMENT_NAME, cds.course_description_count, cds.min_cip_program_code, scd.FROM_TERM, scd.FROM_TERM_DESCRIPTION, scd.SCHOOL_NAME, sad.DEPARTMENT_PHONE_NUMBER FROM top_math_courses tmc JOIN SIS_COURSE_DESCRIPTION scd ON tmc.COURSE_DESCRIPTION = scd.COURSE_DESCRIPTION JOIN course_desc_stats cds ON scd.COURSE = cds.COURSE AND cds.DEPARTMENT_NAME = 'Mathematics' JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT sad ON sd.DEPARTMENT_CODE = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY tmc.COURSE_NUMBER, tmc.COURSE_DESCRIPTION, tmc.SUBJECT_TITLE, tmc.offer_count, cds.DEPARTMENT_NAME, cds.course_description_count, cds.min_cip_program_code, scd.FROM_TERM, scd.FROM_TERM_DESCRIPTION, scd.SCHOOL_NAME, sad.DEPARTMENT_PHONE_NUMBER ORDER BY tmc.COURSE_NUMBER, scd.FROM_TERM ) SELECT CASE WHEN LAG(COURSE_NUMBER) OVER (ORDER BY COURSE_NUMBER, FROM_TERM) = COURSE_NUMBER THEN NULL ELSE COURSE_NUMBER END AS COURSE_NUMBER, COURSE_DESCRIPTION, SUBJECT_TITLE, offer_count, DEPARTMENT_NAME, course_description_count, min_cip_program_code, FROM_TERM, FROM_TERM_DESCRIPTION, SCHOOL_NAME, DEPARTMENT_PHONE_NUMBER FROM inner_cte ORDER BY COURSE_NUMBER, FROM_TERM;\"}}"
    },
