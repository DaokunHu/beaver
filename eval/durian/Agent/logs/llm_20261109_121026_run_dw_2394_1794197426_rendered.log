      "content": "{\"ok\": true, \"entity\": {\"id\": \"dw_2850\", \"name\": \"Status-U Reserve Catalog Key Variance by Term and Department with Rollup Totals\", \"desc\": \"For each term and department, what is the term, department, and the variance of the reserve catalog keys for courses in that department and term where the material status is 'U'? Include subtotals for each term (the corresponding term field is 'SUBTOTAL') and a grand total across all terms (the corresponding term field is 'TOTAL'). Do not repeat the term if it is the same as the previous row. Sort the table by term and department. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT lci.DEPARTMENT, lrmd.TERM_CODE, VARIANCE(lrmd.LIBRARY_RESERVE_CATALOG_KEY) AS catalog_key_variance FROM LIBRARY_COURSE_INSTRUCTOR lci JOIN LIBRARY_RESERVE_MATRL_DETAIL lrmd ON lci.LIBRARY_COURSE_INSTRUCTOR_KEY = lrmd.LIBRARY_COURSE_INSTRUCTOR_KEY WHERE lrmd.LIBRARY_MATERIAL_STATUS_KEY = 'U' GROUP BY lci.DEPARTMENT, lrmd.TERM_CODE ) SELECT CASE WHEN LAG(term) OVER (ORDER BY term_sort, term, dept_sort) = term THEN NULL ELSE term END AS term, dept, catalog_key_variance FROM ( SELECT CASE WHEN GROUPING(TERM_CODE) = 1 AND GROUPING(DEPARTMENT) = 1 THEN 'zzz' ELSE TERM_CODE END AS term_sort, CASE WHEN GROUPING(TERM_CODE) = 0 AND GROUPING(DEPARTMENT) = 1 THEN 'SUBTOTAL' WHEN GROUPING(TERM_CODE) = 1 AND GROUPING(DEPARTMENT) = 1 THEN 'TOTAL' ELSE TERM_CODE END AS term, CASE WHEN GROUPING(TERM_CODE) = 0 AND GROUPING(DEPARTMENT) = 1 THEN 'zzz' ELSE DEPARTMENT END AS dept_sort, DEPARTMENT AS dept, VARIANCE(LIBRARY_RESERVE_CATALOG_KEY) AS catalog_key_variance FROM ( SELECT lci.DEPARTMENT, lrmd.TERM_CODE, lrmd.LIBRARY_RESERVE_CATALOG_KEY FROM LIBRARY_COURSE_INSTRUCTOR lci JOIN LIBRARY_RESERVE_MATRL_DETAIL lrmd ON lci.LIBRARY_COURSE_INSTRUCTOR_KEY = lrmd.LIBRARY_COURSE_INSTRUCTOR_KEY WHERE lrmd.LIBRARY_MATERIAL_STATUS_KEY = 'U' ) base GROUP BY TERM_CODE, DEPARTMENT WITH ROLLUP ) tbltmp ORDER BY term_sort, dept_sort;\", \"category\": \"Library Reserve and Course Instructor Comprehensive Analysis\", \"default_granularity\": \"one row per term and department, plus per-term subtotal rows and a grand total row\"}}"
