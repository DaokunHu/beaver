      "tool_call_id": "call_8943308b5a88484486fb1e3e",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"MIT_STUDENT_DIRECTORY\", \"name\": \"MIT_STUDENT_DIRECTORY\", \"desc\": \"Student directory table: one row per student with name components, full name, office location and phone, email address, department code and department name, and student year. The DEPARTMENT column stores the academic department code and joins to SIS_DEPARTMENT.DEPARTMENT_CODE, enabling per-department student counts.\", \"columns\": {\"FIRST_NAME\": {\"desc\": \"Student first name\"}, \"MIDDLE_NAME\": {\"desc\": \"Student middle name\"}, \"LAST_NAME\": {\"desc\": \"Student last name\"}, \"FULL_NAME\": {\"desc\": \"Full name in 'Last, First M.' format; counted distinctly for per-department student counts\"}, \"OFFICE_LOCATION\": {\"desc\": \"Building-room office/desk location of the student; same building-room identifier format as EMPLOYEE_DIRECTORY.OFFICE_LOCATION and FCLT_ROOMS.BUILDING_ROOM\"}, \"OFFICE_PHONE\": {\"desc\": \"Student office phone number stored as a numeric value; used in per-department phone average/stddev statistics, typically filtered with OFFICE_PHONE IS NOT NULL since many students have no office phone\"}, \"EMAIL_ADDRESS\": {\"desc\": \"Student email address\"}, \"DEPARTMENT\": {\"desc\": \"Academic department code the student belongs to; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Academic department name of the student, e.g. 'Materials Science and Eng', 'Electrical Eng & Computer Sci'; shares the academic name domain with SIS_DEPARTMENT.DEPARTMENT_NAME, but SE_PERSON.ORGANIZATION may use a different naming variant (e.g. 'Electrical Engineering-Computer Science') for the same unit\"}, \"STUDENT_YEAR\": {\"desc\": \"Student year/level code, e.g. 'G' for graduate\"}, \"FULL_NAME_UPPERCASE\": {\"desc\": \"Uppercase full name\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per student\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}, {\"id\": \"STUDENT_DEPARTMENT\", \"name\": \"STUDENT_DEPARTMENT\", \"desc\": \"Student-facing department lookup table with department code, name, full name, and school attribution (code and name). Similar in content to SIS_DEPARTMENT but oriented to student information systems reporting; joins to offering tables via DEPARTMENT_CODE.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' OFFER_DEPT_CODE and SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to\"}}, \"default_granularity\": \"one row per department\"}, {\"id\": \"LIBRARY_SUBJECT_OFFERED\", \"name\": \"LIBRARY_SUBJECT_OFFERED\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\", \"columns\": {\"LIBRARY_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the library subject offered record; joins to LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject as used by the library\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_RESERVE_MATRL_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject per library records\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in library reserve scope\"}, {\"id\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"name\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"desc\": \"Library reserve material detail bridge table linking reserve catalog items, library subject offerings, course instructors, and material status per term. Used to count reserved materials per subject and to filter by library material status (e.g. 'U').\", \"columns\": {\"LIBRARY_COURSE_INSTRUCTOR_KEY\": {\"desc\": \"Foreign key to LIBRARY_COURSE_INSTRUCTOR.LIBRARY_COURSE_INSTRUCTOR_KEY identifying the course instructor\"}, \"LIBRARY_RESERVE_CATALOG_KEY\": {\"desc\": \"Foreign key to LIBRARY_RESERVE_CATALOG.LIBRARY_RESERVE_CATALOG_KEY identifying the reserve catalog item\"}, \"LIBRARY_SUBJECT_OFFERED_KEY\": {\"desc\": \"Foreign key to LIBRARY_SUBJECT_OFFERED.LIBRARY_SUBJECT_OFFERED_KEY identifying the subject offering\"}, \"LIBRARY_MATERIAL_STATUS_KEY\": {\"desc\": \"Library material status key; joins to LIBRARY_MATERIAL_STATUS.LIBRARY_MATERIAL_STATUS_KEY for decoding. Value domain (key = code): 'U' = Unknown, 'R' = (null description), 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material. Distinct from TIP_DETAIL.TIP_MATERIAL_STATUS_KEY, which belongs to the textbook program domain.\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per reserve material per subject offering per term\"}, {\"id\": \"LIBRARY_MATERIAL_STATUS\", \"name\": \"LIBRARY_MATERIAL_STATUS\", \"desc\": \"Library material status lookup table decoding library material status keys/codes used in LIBRARY_RESERVE_MATRL_DETAIL. Holds six statuses where key and code are identical: 'U' = Unknown, 'R' = (null description), 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material.\", \"columns\": {\"LIBRARY_MATERIAL_STATUS_KEY\": {\"desc\": \"Surrogate key; joins to LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY\"}, \"LIBRARY_MATERIAL_STATUS_CODE\": {\"desc\": \"Library material status code, e.g. 'U'\"}, \"LIBRARY_MATERIAL_STATUS\": {\"desc\": \"Library material status description text: 'Unknown' (U), 'Non-Required Course Material' (N), 'Reserve only' (O), 'No Required Textbook' (X), 'Required Course Material' (Y); NULL for key 'R'. Grouping by this column merges statuses sharing the same description.\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per library material status\"}, {\"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the TIP subject offered record; joins to TIP_DETAIL.TIP_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"IS_NO_COURSE_MATERIAL\": {\"desc\": \"'Y'/'N' flag whether the subject has no course material; 'N' means the subject has course materials\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '5.01'; joins to TIP_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE and STUDENT_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Chemistry', 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject; used for enrollment-based rankings and window statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in the textbook program\"}, {\"id\": \"TIP_DETAIL\", \"name\": \"TIP_DETAIL\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Foreign key to TIP_SUBJECT_OFFERED.TIP_SUBJECT_OFFERED_KEY\"}, \"TIP_MATERIAL_KEY\": {\"desc\": \"Foreign key to TIP_MATERIAL.TIP_MATERIAL_KEY identifying the specific textbook material\"}, \"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB'/blank keys with no description. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_SUBJECT_OFFERED.SUBJECT_ID, LIBRARY_SUBJECT_OFFERED.SUBJECT_ID, SUBJECT_SUMMARY.SUBJECT_ID\"}, \"ISBN\": {\"desc\": \"ISBN of the textbook material associated with the subject offering\"}, \"RECORD_COUNT\": {\"desc\": \"Number of material records for this subject/material combination; used in material-count statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject-material-status combination per term\", \"entity\": {\"columns\": {\"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB' = None variants. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}}}, \"reason\": \"Data verification of TIP_MATERIAL_STATUS shows 12 status values beyond the previously documented 'RQ'/'EO'; enriching the description supports material-status grouping questions such as case dw_2989 (per material status and publisher statistics).\"}, {\"id\": \"TIP_MATERIAL_STATUS\", \"name\": \"TIP_MATERIAL_STATUS\", \"desc\": \"TIP material status lookup table decoding material status keys/codes used in TIP_DETAIL. Holds 12 status rows where key and code are identical: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and four keys ('NL', 'NS', 'NB', and a blank/space key) that share a NULL description.\", \"columns\": {\"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Surrogate key of the material status; joins to TIP_DETAIL.TIP_MATERIAL_STATUS_KEY\"}, \"TIP_MATERIAL_STATUS_CODE\": {\"desc\": \"Material status code, identical in value to TIP_MATERIAL_STATUS_KEY: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, plus NULL-description keys 'NL', 'NS', 'NB' and a blank key.\"}, \"TIP_MATERIAL_STATUS\": {\"desc\": \"Material status description text. NULL for four of the twelve keys ('NL', 'NS', 'NB', blank), so grouping by this column merges those keys into one NULL group and yields fewer distinct statuses than grouping by key.\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per material status\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_dab787cd23d54e5a9c950788",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics graduate student, unioned with department-level CIP statistics rows for Mathematics departments without such students\", \"desc\": \"Show the department name, department full name, student full name, student email address, dense rank over the school code, CIP program code range, and CIP program code variance for all graduate students in degree-granting Mathematics departments, as well as for all Mathematics departments that are degree granting and have at least one course with a non-null CIP program code, including the CIP program code range and variance for those departments even if they have no such students. List the results ordered by department full name and student full name. Do not return any rounded answers.\", \"id\": \"dw_1033\", \"name\": \"Math Graduate Students School Dense Ranks Unioned with Department CIP Code Range-Variance\", \"sql\": \"WITH StudentInfo AS ( SELECT sd.DEPT_NAME_IN_COMMENCEMENT_BK AS department_name, sd.DEPARTMENT_FULL_NAME AS department_full_name, msd.FULL_NAME AS student_full_name, msd.EMAIL_ADDRESS AS student_email_address, DENSE_RANK() OVER (ORDER BY sd.SCHOOL_CODE) AS school_code_dense_rank, sd.DEPARTMENT_CODE FROM MIT_STUDENT_DIRECTORY msd JOIN SIS_DEPARTMENT sd ON msd.DEPARTMENT = sd.DEPARTMENT_CODE WHERE msd.STUDENT_YEAR = 'G' AND sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_CODE = '18' ), DepartmentCIPStats AS ( SELECT sd.DEPARTMENT_CODE, sd.DEPARTMENT_FULL_NAME, MAX(scd.CIP_PROGRAM_CODE) - MIN(scd.CIP_PROGRAM_CODE) AS cip_code_range, VARIANCE(scd.CIP_PROGRAM_CODE) AS cip_code_variance FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND scd.CIP_PROGRAM_CODE IS NOT NULL AND sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY sd.DEPARTMENT_CODE, sd.DEPARTMENT_FULL_NAME ), CombinedResults AS ( SELECT si.department_name, si.department_full_name, si.student_full_name, si.student_email_address, si.school_code_dense_rank, dcs.cip_code_range, dcs.cip_code_variance FROM StudentInfo si LEFT JOIN DepartmentCIPStats dcs ON si.DEPARTMENT_CODE = dcs.DEPARTMENT_CODE UNION ALL SELECT NULL AS department_name, dcs.DEPARTMENT_FULL_NAME AS department_full_name, NULL AS student_full_name, NULL AS student_email_address, NULL AS school_code_dense_rank, dcs.cip_code_range, dcs.cip_code_variance FROM DepartmentCIPStats dcs WHERE dcs.DEPARTMENT_CODE NOT IN (SELECT DEPARTMENT_CODE FROM StudentInfo) ) SELECT department_name, department_full_name, student_full_name, student_email_address, school_code_dense_rank, cip_code_range, cip_code_variance FROM CombinedResults ORDER BY department_full_name, student_full_name;\"}, {\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics library subject in regular terms\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\", \"id\": \"dw_4724\", \"name\": \"Mathematics Library Regular-Term Subjects 3-Row Max Units with Required Material Department Statistics\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t2.SUBJECT_SHORT_TITLE, MAX(t2.TOTAL_UNITS) OVER (ORDER BY t0.SUBJECT_ID ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS MAX_TOTAL_UNITS, t0.SUBJECT_ID, t0.OFFER_DEPT_NAME AS SUB1_OFFER_DEPT_NAME, t0.OFFER_SCHOOL_NAME AS SUB1_OFFER_SCHOOL_NAME, t0.RESPONSIBLE_FACULTY_NAME FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t1.IS_REGULAR_TERM = 'Y' ), Sub2 AS ( SELECT tso.OFFER_DEPT_NAME, tso.OFFER_SCHOOL_NAME, COUNT(DISTINCT tso.SUBJECT_ID) AS subject_count, MIN(sos.TOTAL_UNITS) AS min_total_units FROM TIP_SUBJECT_OFFERED tso JOIN TIP_DETAIL td ON tso.SUBJECT_ID = td.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY sos ON td.SUBJECT_ID = sos.SUBJECT_ID WHERE td.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY tso.OFFER_DEPT_NAME, tso.OFFER_SCHOOL_NAME ) SELECT icte.SUBJECT_TITLE, icte.NUM_ENROLLED_STUDENTS, icte.OFFER_DEPT_NAME, icte.TERM_DESCRIPTION, icte.ACADEMIC_YEAR, icte.SUBJECT_SHORT_TITLE, icte.MAX_TOTAL_UNITS, s2.subject_count, s2.min_total_units, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.SCHOOL_NAME AS school_name, icte.RESPONSIBLE_FACULTY_NAME FROM inner_cte icte LEFT JOIN Sub2 s2 ON icte.SUB1_OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME AND icte.SUB1_OFFER_SCHOOL_NAME = s2.OFFER_SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON icte.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per library subject\", \"desc\": \"For subjects with at least 5 enrolled students that are offered by the library in the term with code '2014FA', show the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, row number within each material status group ordered by subject ID, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, ordered by offering department name, material status key, and subject ID. Do not return any rounded answers.\", \"id\": \"dw_3393\", \"name\": \"2014FA Library Subjects with 5+ Enrolled Students by Material Status and Department Min Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.TERM_CODE, t1.TIP_MATERIAL_STATUS_KEY, t1.ISBN, ROW_NUMBER() OVER (PARTITION BY t1.TIP_MATERIAL_STATUS_KEY ORDER BY t0.SUBJECT_ID) AS window_column FROM LIBRARY_SUBJECT_OFFERED t0 JOIN TIP_DETAIL t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.NUM_ENROLLED_STUDENTS >= 5 ), Subq2 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t1.TERM_END_DATE, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_per_dept FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2014FA' ) SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.TERM_CODE, s1.TIP_MATERIAL_STATUS_KEY, s1.ISBN, s1.window_column, s2.OFFER_DEPT_NAME, s2.TERM_DESCRIPTION, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.min_enrolled_per_dept FROM Subq1 s1 JOIN Subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID ORDER BY s2.OFFER_DEPT_NAME, s1.TIP_MATERIAL_STATUS_KEY, s1.SUBJECT_ID\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per library subject plus department rollup rows\", \"desc\": \"For each subject offered by the library in the term with code '2014FA', show the subject ID, subject title, total number of enrolled students, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, as well as the maximum windowed average record count from tip detail records with material status key 'RQ' (using a window of 2 preceding and 2 following rows grouped by financial aid year). Additionally, for each offering department, include a grand total row showing the total number of enrolled students across all its subjects (with nulls for subject ID and subject title), and the corresponding maximum windowed average record count if available. Order the results by offering department name and subject ID. Do not return any rounded answers.\", \"id\": \"dw_3911\", \"name\": \"2014FA Library Subjects Enrollment Rollup by Department with Required Textbook Windowed Record Counts\", \"sql\": \"WITH Subq1 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t0.TERM_DESCRIPTION, t0.TERM_START_DATE, t1.TIP_MATERIAL_KEY, AVG(t1.RECORD_COUNT) OVER ( PARTITION BY t0.FINANCIAL_AID_YEAR ORDER BY t1.SUBJECT_ID ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN TIP_DETAIL t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TIP_MATERIAL_STATUS_KEY = 'RQ' ) SELECT SUBJECT_ID, MAX(window_column) AS max_windowed_avg_record_count FROM inner_cte GROUP BY SUBJECT_ID ), Subq2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t1.TERM_END_DATE, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_per_dept FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2014FA' ) SELECT CASE WHEN GROUPING(SUBJECT_ID) = 1 THEN NULL ELSE SUBJECT_ID END AS SUBJECT_ID, CASE WHEN GROUPING(SUBJECT_TITLE) = 1 THEN NULL ELSE SUBJECT_TITLE END AS SUBJECT_TITLE, SUM(NUM_ENROLLED_STUDENTS) AS total_enrolled_students, OFFER_DEPT_NAME, MAX(TERM_DESCRIPTION) AS TERM_DESCRIPTION, MAX(TERM_START_DATE) AS TERM_START_DATE, MAX(TERM_END_DATE) AS TERM_END_DATE, MIN(min_enrolled_per_dept) AS min_enrolled_per_dept FROM inner_cte GROUP BY OFFER_DEPT_NAME, SUBJECT_ID, SUBJECT_TITLE WITH ROLLUP HAVING OFFER_DEPT_NAME IS NOT NULL ORDER BY OFFER_DEPT_NAME, SUBJECT_ID ) SELECT s2.SUBJECT_ID, s2.SUBJECT_TITLE, s2.total_enrolled_students, s2.OFFER_DEPT_NAME, s2.TERM_DESCRIPTION, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.min_enrolled_per_dept, s1.max_windowed_avg_record_count FROM Subq2 s2 LEFT JOIN Subq1 s1 ON s2.SUBJECT_ID = s1.SUBJECT_ID ORDER BY s2.OFFER_DEPT_NAME, s2.SUBJECT_ID\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per department/school enrollment statistic (plus per-school rollup rows), left joined with Mathematics students named Peter\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\", \"id\": \"dw_1350\", \"name\": \"Degree-Granting Department TIP Enrollment Statistics with School Rollups and Math Peter Student Budget Code Windows\", \"sql\": \"WITH inner_cte1 AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, tso.NUM_ENROLLED_STUDENTS FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 ), DepartmentStats AS ( SELECT DEPARTMENT_NAME, SCHOOL_NAME, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled_students, MAX(NUM_ENROLLED_STUDENTS) - MIN(NUM_ENROLLED_STUDENTS) AS range_enrolled_students, VARIANCE(NUM_ENROLLED_STUDENTS) AS var_enrolled_students, SUM(NUM_ENROLLED_STUDENTS) AS total_enrolled_students FROM inner_cte1 GROUP BY DEPARTMENT_NAME, SCHOOL_NAME ), SchoolRollup AS ( SELECT NULL AS DEPARTMENT_NAME, SCHOOL_NAME, NULL AS avg_enrolled_students, NULL AS range_enrolled_students, NULL AS var_enrolled_students, SUM(total_enrolled_students) AS total_enrolled_students FROM DepartmentStats GROUP BY SCHOOL_NAME ), inner_cte2 AS ( SELECT t1.LAST_NAME, t1.EMAIL_ADDRESS, t1.STUDENT_YEAR, t1.DEPARTMENT_NAME, t0.SCHOOL_NAME, MIN(t0.DEPT_BUDGET_CODE) OVER (ORDER BY t1.FULL_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_DEPARTMENT t0 JOIN MIT_STUDENT_DIRECTORY t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT WHERE t1.FIRST_NAME = 'Peter' AND t0.DEPARTMENT_NAME = 'Mathematics' ) SELECT ds.DEPARTMENT_NAME, ds.SCHOOL_NAME, ds.avg_enrolled_students, ds.range_enrolled_students, ds.var_enrolled_students, ds.total_enrolled_students, ic2.LAST_NAME, ic2.EMAIL_ADDRESS, ic2.STUDENT_YEAR, ic2.window_column, sd.DEPARTMENT_FULL_NAME, sd.DEPARTMENT_LAST_ACTIVITY_DATE FROM (SELECT * FROM DepartmentStats UNION ALL SELECT * FROM SchoolRollup) ds LEFT JOIN inner_cte2 ic2 ON ds.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME AND ds.SCHOOL_NAME = ic2.SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON ds.DEPARTMENT_NAME = sd.DEPARTMENT_NAME ORDER BY ds.SCHOOL_NAME, ds.DEPARTMENT_NAME, ic2.LAST_NAME ;\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics department combining subject unit statistics with graduate student counts\", \"desc\": \"For the Mathematics department (Course 18), provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student), the number of graduate students in the department, and the most recent warehouse load date for those students, considering only departments that are degree granting and students whose year is 'G'. Do not return any rounded answers.\", \"id\": \"dw_1212\", \"name\": \"Math Department Subject Unit Average-Stddev with Graduate Student Count and Latest Load Date\", \"sql\": \"WITH DeptUnits AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_total_units, STDDEV(s.TOTAL_UNITS) AS stddev_total_units FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.TOTAL_UNITS > 0 AND s.NUM_ENROLLED_STUDENTS >= 1 AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME ORDER BY stddev_total_units DESC ), DeptStudents AS ( SELECT sd.DEPARTMENT_NAME, COUNT(msd.FULL_NAME) AS student_count, MAX(msd.WAREHOUSE_LOAD_DATE) AS latest_student_load FROM SIS_DEPARTMENT sd JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT JOIN SIS_ADMIN_DEPARTMENT sad ON msd.DEPARTMENT = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND msd.STUDENT_YEAR = 'G' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_NAME ORDER BY student_count DESC LIMIT 10 ) SELECT du.DEPARTMENT_NAME, du.avg_total_units, du.stddev_total_units, ds.student_count, ds.latest_student_load FROM DeptUnits du JOIN DeptStudents ds ON du.DEPARTMENT_NAME = ds.DEPARTMENT_NAME;\"}], \"not_found\": []}"
    },
