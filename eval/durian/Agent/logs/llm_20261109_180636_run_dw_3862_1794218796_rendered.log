      "tool_call_id": "call_91757c2341d54fdd9ec88298",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering catalog subject matched with TIP material detail and material count\", \"desc\": \"Show the department full names, subject titles, total units, and the number of unique course materials per subject for subjects offered by departments in the School of Engineering. For each subject, also provide the material status key, term code, subject ID, ISBN, material key, course number description, offering department name, and the maximum number of enrolled students for each row considering the current row and the next 2 rows ordered by material key, where the subject title and department code match between the subject and course material datasets. Do not return any rounded answers.\", \"id\": \"dw_4602\", \"name\": \"Engineering Subjects with Unique Course Material Counts and TIP Material Detail Enrollment Windows\", \"sql\": \"WITH inner_cte AS ( SELECT t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t0.DEPARTMENT_FULL_NAME, ROW_NUMBER() OVER (ORDER BY t1.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DEPARTMENT_CODE FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_NAME = 'Engineering' ) SELECT icte.DEPARTMENT_FULL_NAME, icte.SUBJECT_TITLE, icte.TOTAL_UNITS, mat_count.num_materials, s2.TIP_MATERIAL_STATUS_KEY, s2.TERM_CODE, s2.SUBJECT_ID, s2.ISBN, s2.TIP_MATERIAL_KEY, s2.COURSE_NUMBER_DESC, s2.OFFER_DEPT_NAME, s2.max_enrolled_students FROM inner_cte icte JOIN ( SELECT t0.TIP_MATERIAL_STATUS_KEY, t0.TERM_CODE, t0.SUBJECT_ID, t0.ISBN, t0.TIP_MATERIAL_KEY, t1.COURSE_NUMBER_DESC, t1.SUBJECT_TITLE, t1.OFFER_DEPT_NAME, MAX(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t0.TIP_MATERIAL_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_enrolled_students, t1.OFFER_DEPT_CODE FROM TIP_DETAIL t0 JOIN TIP_SUBJECT_OFFERED t1 ON t0.TIP_SUBJECT_OFFERED_KEY = t1.TIP_SUBJECT_OFFERED_KEY WHERE t0.TIP_MATERIAL_STATUS_KEY IS NOT NULL AND t1.NUM_ENROLLED_STUDENTS >= 0 ) s2 ON icte.DEPARTMENT_CODE = s2.OFFER_DEPT_CODE AND icte.SUBJECT_TITLE = s2.SUBJECT_TITLE JOIN ( SELECT t1.DEPARTMENT_CODE, t1.SUBJECT_TITLE, COUNT(DISTINCT t0.TIP_MATERIAL_KEY) AS num_materials FROM COURSE_CATALOG_SUBJECT_OFFERED t1 JOIN SIS_DEPARTMENT t0d ON t1.DEPARTMENT_CODE = t0d.DEPARTMENT_CODE JOIN TIP_SUBJECT_OFFERED t2 ON t1.SUBJECT_TITLE = t2.SUBJECT_TITLE AND t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE JOIN TIP_DETAIL t0 ON t2.TIP_SUBJECT_OFFERED_KEY = t0.TIP_SUBJECT_OFFERED_KEY WHERE t0d.SCHOOL_NAME = 'Engineering' GROUP BY t1.DEPARTMENT_CODE, t1.SUBJECT_TITLE ) mat_count ON icte.DEPARTMENT_CODE = mat_count.DEPARTMENT_CODE AND icte.SUBJECT_TITLE = mat_count.SUBJECT_TITLE\"}, {\"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering catalog subject matched with TIP material detail\", \"desc\": \"For subjects offered by departments in the School of Engineering, show the subject title, total units, department full name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Additionally, for each matching course material detail, provide the material status key, term code, subject ID, ISBN, material key, the course number description, the offering department name, and the maximum number of enrolled students for each row considering the current row and the next 2 rows ordered by material key. The results should include the subject title, total units, department full name, window row number, material status key, term code, subject ID, ISBN, material key, course number description, offering department name, and the maximum number of enrolled students, in that order, for subjects and course materials where the subject title and department code match between the two datasets. Do not return any rounded answers.\", \"id\": \"dw_3668\", \"name\": \"Engineering Catalog Subjects Row Numbers Matched with TIP Material Detail Enrollment Windows\", \"sql\": \"WITH Subq1 AS ( SELECT t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t0.DEPARTMENT_FULL_NAME, ROW_NUMBER() OVER (ORDER BY t1.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DEPARTMENT_CODE FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_NAME = 'Engineering' ), Subq2 AS ( SELECT t0.TIP_MATERIAL_STATUS_KEY, t0.TERM_CODE, t0.SUBJECT_ID, t0.ISBN, t0.TIP_MATERIAL_KEY, t1.COURSE_NUMBER_DESC, t1.SUBJECT_TITLE, t1.OFFER_DEPT_NAME, MAX(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t0.TIP_MATERIAL_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_enrolled_students, t1.OFFER_DEPT_CODE FROM TIP_DETAIL t0 JOIN TIP_SUBJECT_OFFERED t1 ON t0.TIP_SUBJECT_OFFERED_KEY = t1.TIP_SUBJECT_OFFERED_KEY WHERE t0.TIP_MATERIAL_STATUS_KEY IS NOT NULL AND t1.NUM_ENROLLED_STUDENTS >= 0 ) SELECT s1.SUBJECT_TITLE, s1.TOTAL_UNITS, s1.DEPARTMENT_FULL_NAME, s1.window_column, s2.TIP_MATERIAL_STATUS_KEY, s2.TERM_CODE, s2.SUBJECT_ID, s2.ISBN, s2.TIP_MATERIAL_KEY, s2.COURSE_NUMBER_DESC, s2.OFFER_DEPT_NAME, s2.max_enrolled_students FROM Subq1 s1 JOIN Subq2 s2 ON s1.DEPARTMENT_CODE = s2.OFFER_DEPT_CODE AND s1.SUBJECT_TITLE = s2.SUBJECT_TITLE\"}, {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per 2025FA Engineering subject\", \"desc\": \"For subjects offered in the term with code '2025FA' by departments in the School of Engineering, show the subject ID, subject title, offering department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, total units, department full name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title, ordered by offering department name and subject title. Do not return any rounded answers.\", \"id\": \"dw_3684\", \"name\": \"2025FA Engineering Subjects Enrollment Windows with Catalog Unit Row Numbers\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TERM_START_DATE, t1.TERM_END_DATE, t2.TERM_PARAMETER, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_students_per_dept, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2025FA' ORDER BY t0.OFFER_DEPT_NAME ), Subq2 AS ( SELECT t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t0.DEPARTMENT_FULL_NAME, ROW_NUMBER() OVER (ORDER BY t1.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DEPARTMENT_CODE FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_NAME = 'Engineering' ) SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME, s1.NUM_ENROLLED_STUDENTS, s1.TERM_DESCRIPTION, s1.ACADEMIC_YEAR, s1.TERM_START_DATE, s1.TERM_END_DATE, s1.TERM_PARAMETER, s1.min_enrolled_students_per_dept, s2.TOTAL_UNITS, s2.DEPARTMENT_FULL_NAME, s2.window_column FROM Subq1 s1 JOIN Subq2 s2 ON s1.OFFER_DEPT_CODE = s2.DEPARTMENT_CODE AND s1.SUBJECT_TITLE = s2.SUBJECT_TITLE ORDER BY s1.OFFER_DEPT_NAME, s1.SUBJECT_TITLE\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per degree-granting department that offered Engineering-school subjects in 2021\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of active graduate students with an office location assigned in that department. Do not return any rounded answers.\", \"id\": \"dw_3237\", \"name\": \"2021 Engineering Degree-Granting Department Subject Counts with Active Graduate Student Office Totals\", \"sql\": \"WITH DeptSubjects AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), DeptActiveGradStudents AS ( SELECT m.DEPARTMENT_NAME, m.DEPARTMENT, COUNT(*) AS total_active_grad_students FROM SE_PERSON s JOIN MIT_STUDENT_DIRECTORY m ON s.FULL_NAME = m.FULL_NAME WHERE s.IS_ACTIVE = 'Y' AND m.STUDENT_YEAR = 'G' AND m.OFFICE_LOCATION IS NOT NULL GROUP BY m.DEPARTMENT_NAME, m.DEPARTMENT HAVING COUNT(*) > 0 ) SELECT ds.DEPARTMENT_CODE, ds.DEPARTMENT_NAME, ds.DEPARTMENT_FULL_NAME, ds.subject_count, ds.total_enrollment, dag.total_active_grad_students FROM DeptSubjects ds LEFT JOIN SIS_DEPARTMENT d ON ds.DEPARTMENT_CODE = d.DEPARTMENT_CODE LEFT JOIN DeptActiveGradStudents dag ON d.DEPARTMENT_CODE = dag.DEPARTMENT ORDER BY ds.DEPARTMENT_NAME;\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per top-10 department subject-code group matched with a Kevin-named Course-6 student course\", \"desc\": \"For the top 10 degree-granting departments (excluding 'Political Science' and Course 17) that have offered at least one subject in the 'Engineering' school, list the department name, school name, subject code description, the total number of subjects they offered, and the average number of enrolled students per subject, and for each such department, show the full names, email addresses, student years, department full names, course descriptions, course levels, the minimum course level in a window of 3 preceding and 1 following row ordered by the student's last name, and the corresponding subject code and subject code description for each course taken by students named 'Kevin' in 'Electrical Eng & Computer Sci' (Course 6). Do not return any rounded answers.\", \"id\": \"dw_1474\", \"name\": \"Top 10 Engineering Degree-Granting Department Subject Counts with Kevin EECS Student Course Windows\", \"sql\": \"WITH TopDepartments AS ( WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, d.SCHOOL_NAME, s.SUBJECT_CODE_DESC, COUNT(sos.SUBJECT_OFFERED_SUMMARY_KEY) AS num_subjects FROM SIS_SUBJECT_CODE s JOIN SIS_DEPARTMENT d ON s.DEPARTMENT_CODE = d.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY sos ON d.DEPARTMENT_CODE = sos.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND sos.OFFER_SCHOOL_NAME = 'Engineering' AND d.DEPARTMENT_NAME <> 'Political Science' AND d.DEPARTMENT_CODE <> '17' GROUP BY d.DEPARTMENT_NAME, d.SCHOOL_NAME, s.SUBJECT_CODE_DESC ) SELECT ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SUBJECT_CODE_DESC, ic.num_subjects, AVG(sos.NUM_ENROLLED_STUDENTS) AS avg_enrollment, d.DEPARTMENT_CODE FROM inner_cte ic JOIN SIS_DEPARTMENT d ON ic.DEPARTMENT_NAME = d.DEPARTMENT_NAME AND ic.SCHOOL_NAME = d.SCHOOL_NAME JOIN SUBJECT_OFFERED_SUMMARY sos ON d.DEPARTMENT_CODE = sos.OFFER_DEPT_CODE GROUP BY ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SUBJECT_CODE_DESC, ic.num_subjects, d.DEPARTMENT_CODE ORDER BY ic.num_subjects DESC LIMIT 10 ), KevinStudents AS ( WITH inner_cte AS ( SELECT t2.FULL_NAME, t2.EMAIL_ADDRESS, t2.STUDENT_YEAR, t1.DEPARTMENT_FULL_NAME, t0.COURSE_DESCRIPTION, t0.COURSE_LEVEL, MIN(t0.COURSE_LEVEL) OVER (ORDER BY t2.LAST_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t0.COURSE, t1.DEPARTMENT_CODE FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT WHERE t2.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' AND t2.FIRST_NAME = 'Kevin' AND t2.DEPARTMENT = '6' ) SELECT inner_cte.FULL_NAME, inner_cte.EMAIL_ADDRESS, inner_cte.STUDENT_YEAR, inner_cte.DEPARTMENT_FULL_NAME, inner_cte.COURSE_DESCRIPTION, inner_cte.COURSE_LEVEL, inner_cte.window_column, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, inner_cte.DEPARTMENT_CODE FROM inner_cte JOIN SIS_SUBJECT_CODE sc ON inner_cte.COURSE = sc.COURSE_NUMBER ) SELECT td.DEPARTMENT_NAME, td.SCHOOL_NAME, td.SUBJECT_CODE_DESC, td.num_subjects, td.avg_enrollment, ks.FULL_NAME, ks.EMAIL_ADDRESS, ks.STUDENT_YEAR, ks.DEPARTMENT_FULL_NAME, ks.COURSE_DESCRIPTION, ks.COURSE_LEVEL, ks.window_column, ks.SUBJECT_CODE, ks.SUBJECT_CODE_DESC FROM TopDepartments td JOIN KevinStudents ks ON td.DEPARTMENT_CODE = ks.DEPARTMENT_CODE ORDER BY td.DEPARTMENT_NAME, ks.FULL_NAME;\"}], \"not_found\": []}"
