    {
      "role": "tool",
      "tool_call_id": "call_b6a8bbbf1a7048a484fb3361",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per subject with textbooks\", \"desc\": \"For subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook, show the subject code, subject number, department name, subject title, term description, total units, the average subject enrollment number in a window of 2 preceding and 2 following rows grouped by department code and ordered by total units, the textbook material key, the textbook material status key, and the row number of the course within each department ordered by subject code. List the results in order by department name, subject code, and subject number. Do not return any rounded answers.\", \"id\": \"dw_3493\", \"name\": \"2022 12-Unit Subjects with Required or Optional Textbooks and Enrollment Windows\", \"sql\": \"WITH SubjectUnitsWindow AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ), CourseTextbookWindow AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t2.TIP_MATERIAL_KEY, t2.TIP_MATERIAL_STATUS_KEY, ROW_NUMBER() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.ACADEMIC_YEAR = 2022 AND t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') ) SELECT s.SUBJECT_CODE, s.SUBJECT_NUMBER, s.DEPARTMENT_NAME, s.SUBJECT_TITLE, s.TERM_DESCRIPTION, s.TOTAL_UNITS, s.window_column AS avg_enrollment_window, c.TIP_MATERIAL_KEY, c.TIP_MATERIAL_STATUS_KEY, c.window_column AS textbook_row_number FROM SubjectUnitsWindow s JOIN CourseTextbookWindow c ON s.SUBJECT_CODE = c.SUBJECT_CODE AND s.SUBJECT_NUMBER = c.SUBJECT_NUMBER AND s.DEPARTMENT_NAME = c.DEPARTMENT_NAME AND s.SUBJECT_TITLE = c.SUBJECT_TITLE AND s.TERM_DESCRIPTION = c.TERM_DESCRIPTION AND s.TERM_CODE = c.TERM_CODE AND s.SUBJECT_ID = c.SUBJECT_ID ORDER BY s.DEPARTMENT_NAME, s.SUBJECT_CODE, s.SUBJECT_NUMBER;\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject per Engineering course in same department\", \"desc\": \"For each department and each subject offered in the academic year 2024, show the department name, subject code, subject number, subject title, term code, term description, and the highest minimum total units (in a window of 3 preceding and 1 following row ordered by academic year) for that subject, along with the course description, subject code description, and the difference between the number of characters in the course description and the average number of characters in course descriptions for that department, for courses in the School of Engineering that are degree granting. Do not return any rounded answers.\", \"id\": \"dw_3989\", \"name\": \"2024 Subjects Windowed Min Units with Engineering Course Description Length Deviation\", \"sql\": \"WITH inner_cte1 AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.SUBJECT_TITLE, t0.TERM_CODE, t1.TERM_DESCRIPTION, t0.DEPARTMENT_NAME, MIN(t0.TOTAL_UNITS) OVER (ORDER BY t1.ACADEMIC_YEAR ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2024 ), cte1 AS ( SELECT DEPARTMENT_NAME, SUBJECT_CODE, SUBJECT_NUMBER, SUBJECT_TITLE, TERM_CODE, TERM_DESCRIPTION, MAX(window_column) AS highest_min_total_units FROM inner_cte1 GROUP BY DEPARTMENT_NAME, SUBJECT_CODE, SUBJECT_NUMBER, SUBJECT_TITLE, TERM_CODE, TERM_DESCRIPTION ), inner_cte2 AS ( SELECT t1.COURSE_DESCRIPTION, t1.DEPARTMENT_NAME, t0.SUBJECT_CODE_DESC, t1.COURSE FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.SUBJECT_CODE = t1.COURSE WHERE t1.SCHOOL_NAME = 'Engineering' AND t1.IS_DEGREE_GRANTING = 'Y' ), dept_avg AS ( SELECT DEPARTMENT_NAME, AVG(LENGTH(COURSE_DESCRIPTION)) AS avg_desc_length FROM inner_cte2 GROUP BY DEPARTMENT_NAME ), cte2 AS ( SELECT i.COURSE_DESCRIPTION, i.DEPARTMENT_NAME, i.SUBJECT_CODE_DESC, (LENGTH(i.COURSE_DESCRIPTION) - d.avg_desc_length) AS desc_length_deviation, i.COURSE FROM inner_cte2 i JOIN dept_avg d ON i.DEPARTMENT_NAME = d.DEPARTMENT_NAME ) SELECT cte1.DEPARTMENT_NAME, cte1.SUBJECT_CODE, cte1.SUBJECT_NUMBER, cte1.SUBJECT_TITLE, cte1.TERM_CODE, cte1.TERM_DESCRIPTION, cte1.highest_min_total_units, cte2.COURSE_DESCRIPTION, cte2.SUBJECT_CODE_DESC, cte2.desc_length_deviation FROM cte1 JOIN cte2 ON cte1.DEPARTMENT_NAME = cte2.DEPARTMENT_NAME AND cte1.SUBJECT_CODE = cte2.COURSE ORDER BY cte1.DEPARTMENT_NAME, cte1.SUBJECT_CODE, cte1.SUBJECT_NUMBER;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department per subject code\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\", \"id\": \"dw_4756\", \"name\": \"Department Course Counts with 2022 12-Unit Subjects Having Textbooks\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ) SELECT sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL, Total_Courses.Total_Courses, COALESCE(SubjectsWithTextbooks.Subjects_With_Textbooks, 0) AS Subjects_With_Textbooks_2022_12units FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER JOIN ( SELECT sd.DEPARTMENT_NAME, COUNT(DISTINCT COURSE_NUMBER) AS Total_Courses FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER GROUP BY sd.DEPARTMENT_NAME ) AS Total_Courses ON sd.DEPARTMENT_NAME = Total_Courses.DEPARTMENT_NAME LEFT JOIN ( SELECT s1.DEPARTMENT_NAME, COUNT(DISTINCT s1.SUBJECT_CODE || '-' || s1.SUBJECT_NUMBER) AS Subjects_With_Textbooks FROM inner_cte s1 JOIN TIP_DETAIL t2 ON s1.TERM_CODE = t2.TERM_CODE AND s1.SUBJECT_ID = t2.SUBJECT_ID WHERE t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') GROUP BY s1.DEPARTMENT_NAME ) AS SubjectsWithTextbooks ON sd.DEPARTMENT_NAME = SubjectsWithTextbooks.DEPARTMENT_NAME ;\"}], \"not_found\": []}"
