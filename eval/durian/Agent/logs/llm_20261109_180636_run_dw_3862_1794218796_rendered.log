    {
      "role": "tool",
      "tool_call_id": "call_70abdf23a7c54c3e9b48d373",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_2895\", \"name\": \"Subjects with Status-U Library Reserve and Required Textbooks Min Status, Record Totals, and Latest Load Dates\", \"desc\": \"For each subject that has a library material status of 'U' and a tip material status of 'RQ', what is the minimum library material status key, the total record count, and the most recent warehouse load date from both the library reserve and tip detail tables? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT lrmd.SUBJECT_ID, MIN(lrmd.LIBRARY_MATERIAL_STATUS_KEY) AS min_material_status, SUM(td.RECORD_COUNT) AS total_records FROM LIBRARY_RESERVE_MATRL_DETAIL lrmd JOIN TIP_DETAIL td ON lrmd.SUBJECT_ID = td.SUBJECT_ID WHERE lrmd.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND td.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY lrmd.SUBJECT_ID ) SELECT inner_cte.SUBJECT_ID, inner_cte.min_material_status, inner_cte.total_records, MAX(lrmd.WAREHOUSE_LOAD_DATE) AS latest_library_warehouse_date, MAX(td.WAREHOUSE_LOAD_DATE) AS latest_tip_warehouse_date FROM inner_cte JOIN LIBRARY_RESERVE_MATRL_DETAIL lrmd ON inner_cte.SUBJECT_ID = lrmd.SUBJECT_ID JOIN TIP_DETAIL td ON inner_cte.SUBJECT_ID = td.SUBJECT_ID WHERE lrmd.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND td.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY inner_cte.SUBJECT_ID, inner_cte.min_material_status, inner_cte.total_records ORDER BY inner_cte.total_records DESC;\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per subject having both status-U library reserve materials and required (RQ) textbooks\"}, {\"id\": \"dw_3234\", \"name\": \"Top 10 TIP Material Statuses by Material Count with 2009SP Library Reserve Status Counts\", \"desc\": \"For the top 10 material statuses by the number of materials, what is the material status description, the count of materials for each status, the associated library material status, and the count of reserve catalog items for each library material status for term code '2009SP'? Do not return any rounded answers.\", \"sql\": \"WITH TopMaterialStatuses AS ( SELECT tms.TIP_MATERIAL_STATUS, COUNT(td.TIP_MATERIAL_KEY) AS material_count FROM TIP_DETAIL td JOIN TIP_MATERIAL_STATUS tms ON td.TIP_MATERIAL_STATUS_KEY = tms.TIP_MATERIAL_STATUS_KEY GROUP BY tms.TIP_MATERIAL_STATUS ORDER BY material_count DESC LIMIT 10 ), ReserveCounts AS ( SELECT lms.LIBRARY_MATERIAL_STATUS, COUNT(lrmd.LIBRARY_RESERVE_CATALOG_KEY) AS reserve_count, lrmd.LIBRARY_MATERIAL_STATUS_KEY FROM LIBRARY_MATERIAL_STATUS lms JOIN LIBRARY_RESERVE_MATRL_DETAIL lrmd ON lms.LIBRARY_MATERIAL_STATUS_KEY = lrmd.LIBRARY_MATERIAL_STATUS_KEY WHERE lrmd.TERM_CODE = '2009SP' GROUP BY lms.LIBRARY_MATERIAL_STATUS, lrmd.LIBRARY_MATERIAL_STATUS_KEY ORDER BY reserve_count DESC ) SELECT tms.TIP_MATERIAL_STATUS, tms.material_count, rc.LIBRARY_MATERIAL_STATUS, rc.reserve_count FROM TopMaterialStatuses tms JOIN TIP_MATERIAL_STATUS tms2 ON tms.TIP_MATERIAL_STATUS = tms2.TIP_MATERIAL_STATUS JOIN TIP_DETAIL td ON td.TIP_MATERIAL_STATUS_KEY = tms2.TIP_MATERIAL_STATUS_KEY JOIN LIBRARY_RESERVE_MATRL_DETAIL lrmd ON td.SUBJECT_ID = lrmd.SUBJECT_ID AND td.TERM_CODE = lrmd.TERM_CODE JOIN ReserveCounts rc ON lrmd.LIBRARY_MATERIAL_STATUS_KEY = rc.LIBRARY_MATERIAL_STATUS_KEY\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per top material status matched with library reserve material status of term 2009SP\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Fall 2024-2025 subject with status-U reserve materials\", \"desc\": \"For each subject offered in the term with the description \\\"Fall Term 2024-2025\\\" that also has more than 0 enrolled students and a material status key of 'U', show the subject offered key, subject title, offering department name, the term description, the rank of each subject within its offering department, the course number, course number description, number of enrolled students, the reserve catalog key, the dense rank over the material status key, and the academic year description, ordered by subject offered key and course number. Do not return any rounded answers.\", \"id\": \"dw_4566\", \"name\": \"Fall 2024-2025 Subjects with Status-U Library Reserve Materials Ranked per Department\", \"sql\": \"WITH inner_cte AS ( WITH SubjectOfferings AS ( SELECT t0.TIP_SUBJECT_OFFERED_KEY, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.TIP_SUBJECT_OFFERED_KEY) AS window_column, t0.SUBJECT_ID, t1.ACADEMIC_YEAR_DESC FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_DESCRIPTION = 'Fall Term 2024-2025' ), LibrarySubjectStats AS ( SELECT t1.COURSE_NUMBER, t1.COURSE_NUMBER_DESC, t1.NUM_ENROLLED_STUDENTS, t2.LIBRARY_RESERVE_CATALOG_KEY, DENSE_RANK() OVER (PARTITION BY t2.LIBRARY_MATERIAL_STATUS_KEY ORDER BY t2.LIBRARY_MATERIAL_STATUS_KEY) AS window_column, t1.SUBJECT_ID FROM LIBRARY_SUBJECT_OFFERED t1 JOIN LIBRARY_RESERVE_MATRL_DETAIL t2 ON t1.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.NUM_ENROLLED_STUDENTS > 0 AND t2.LIBRARY_MATERIAL_STATUS_KEY = 'U' ) SELECT so.TIP_SUBJECT_OFFERED_KEY, so.SUBJECT_TITLE, so.OFFER_DEPT_NAME, so.TERM_DESCRIPTION, so.window_column AS subject_rank_in_dept, lss.COURSE_NUMBER, lss.COURSE_NUMBER_DESC, lss.NUM_ENROLLED_STUDENTS, lss.LIBRARY_RESERVE_CATALOG_KEY, lss.window_column AS dense_rank_material_status, so.ACADEMIC_YEAR_DESC FROM SubjectOfferings so JOIN LibrarySubjectStats lss ON so.SUBJECT_ID = lss.SUBJECT_ID ) SELECT * FROM inner_cte ORDER BY TIP_SUBJECT_OFFERED_KEY, COURSE_NUMBER;\"}, {\"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per library subject with status-U reserve materials matched with department unit statistics\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\", \"id\": \"dw_3311\", \"name\": \"Status-U Library Subjects with Enrollment Matched with Department Offered-This-Year Unit Dispersion\", \"sql\": \"WITH DeptStats AS ( SELECT scd.DEPARTMENT_NAME, MAX(ccc.total_units) - MIN(ccc.total_units) AS total_units_range, VARIANCE(ccc.total_units) AS total_units_variance, STDDEV(ccc.total_units) AS total_units_stddev FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_SUBJECT_CODE ssc ON scd.COURSE = ssc.SUBJECT_CODE JOIN CIS_COURSE_CATALOG ccc ON ssc.SUBJECT_CODE = ccc.SUBJECT_CODE WHERE ccc.IS_OFFERED_THIS_YEAR = 'Y' AND ccc.total_units IS NOT NULL GROUP BY scd.DEPARTMENT_NAME ORDER BY total_units_range DESC ), SubjectEnroll AS ( SELECT t1.COURSE_NUMBER, t1.COURSE_NUMBER_DESC, t1.NUM_ENROLLED_STUDENTS, t2.LIBRARY_RESERVE_CATALOG_KEY, DENSE_RANK() OVER (PARTITION BY t2.LIBRARY_MATERIAL_STATUS_KEY ORDER BY t2.LIBRARY_MATERIAL_STATUS_KEY) AS window_column, t1.OFFER_DEPT_NAME FROM LIBRARY_SUBJECT_OFFERED t1 JOIN LIBRARY_RESERVE_MATRL_DETAIL t2 ON t1.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.NUM_ENROLLED_STUDENTS > 0 AND t2.LIBRARY_MATERIAL_STATUS_KEY = 'U' ), CombinedResults AS ( SELECT s.COURSE_NUMBER, s.COURSE_NUMBER_DESC, s.NUM_ENROLLED_STUDENTS, s.LIBRARY_RESERVE_CATALOG_KEY, s.window_column, d.DEPARTMENT_NAME, d.total_units_range, d.total_units_variance, d.total_units_stddev FROM SubjectEnroll s JOIN DeptStats d ON s.OFFER_DEPT_NAME = d.DEPARTMENT_NAME ) SELECT * FROM CombinedResults ORDER BY COURSE_NUMBER, COURSE_NUMBER_DESC;\"}], \"not_found\": []}"
    },
