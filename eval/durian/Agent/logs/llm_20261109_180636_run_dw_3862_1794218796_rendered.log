olumn, sbd.SUBJECT_TITLE, sbd.TOTAL_UNITS, sbd.DEPARTMENT_NAME AS SUBJECT_DEPARTMENT_NAME, sbd.COURSE_DESCRIPTION, sbd.window_column AS subject_window_column, sbd.OFFER_DEPT_CODE FROM ( SELECT t1.FIRST_NAME, t1.LAST_NAME, t1.DEPARTMENT_NAME, t1.STUDENT_YEAR, t0.DEPARTMENT_FULL_NAME, t2.SIS_ADMIN_DEPARTMENT_NAME, AVG(t2.DEPARTMENT_PHONE_NUMBER) OVER ( PARTITION BY t2.SIS_ADMIN_DEPARTMENT_NAME ORDER BY t1.FIRST_NAME ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t1.DEPARTMENT FROM SIS_DEPARTMENT t0 JOIN MIT_STUDENT_DIRECTORY t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT JOIN SIS_ADMIN_DEPARTMENT t2 ON t1.DEPARTMENT = t2.SIS_ADMIN_DEPARTMENT_CODE WHERE t1.DEPARTMENT = '6' AND t1.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' ) sd JOIN ( SELECT t2.SUBJECT_TITLE, t2.TOTAL_UNITS, t1.DEPARTMENT_NAME, t1.COURSE_DESCRIPTION, DENSE_RANK() OVER (PARTITION BY t2.OFFER_DEPT_CODE ORDER BY t2.OFFER_DEPT_CODE) AS window_column, t2.OFFER_DEPT_CODE, t1.SCHOOL_NAME FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.SUBJECT_CODE = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.OFFER_SCHOOL_NAME = 'Engineering' AND t2.TOTAL_UNITS > 0 AND t1.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' ) sbd ON sd.DEPARTMENT = sbd.OFFER_DEPT_CODE ) SELECT inner_cte.FIRST_NAME, inner_cte.LAST_NAME, inner_cte.DEPARTMENT_NAME, inner_cte.STUDENT_YEAR, inner_cte.DEPARTMENT_FULL_NAME, inner_cte.SIS_ADMIN_DEPARTMENT_NAME, inner_cte.student_window_column, inner_cte.SUBJECT_TITLE, inner_cte.TOTAL_UNITS, inner_cte.SUBJECT_DEPARTMENT_NAME, inner_cte.COURSE_DESCRIPTION, inner_cte.subject_window_column, d.SCHOOL_NAME, CASE WHEN inner_cte.TOTAL_UNITS >= 12 THEN 'HIGH_LOAD' WHEN inner_cte.TOTAL_UNITS <= 6 THEN 'LOW_LOAD' ELSE 'MEDIUM_LOAD' END AS SUBJECT_LOAD_CATEGORY FROM inner_cte JOIN SIS_DEPARTMENT d ON inner_cte.OFFER_DEPT_CODE = d.DEPARTMENT_CODE ORDER BY inner_cte.FIRST_NAME, inner_cte.SUBJECT_TITLE;\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per offer department code of the matched EECS subjects and students\", \"desc\": \"For each subject offered in the 'Engineering' school with total units greater than 0 and only for subjects in the 'Electrical Eng & Computer Sci' department (Course 6), show the subject title, total units, department name, course description, and dense rank over the offer department code ordered by offer department code, along with the first name, last name, department name, student year, corresponding department's full name, administrative department name, and the average department phone number in a window of 2 preceding and 2 following rows grouped by the administrative department name and ordered by the student's first name, for students whose department is '6' and whose department name is 'Electrical Eng & Computer Sci', where the subject's offer department code matches the student's department. Then, for each offer department code, provide the maximum total units among these subjects and the count of distinct student years among the matched students. Do not return any rounded answers.\", \"id\": \"dw_2240\", \"name\": \"EECS Engineering Subject Max Units and Distinct Student Year Counts per Offer Department\", \"sql\": \"WITH inner_cte AS ( WITH subject_summary AS ( SELECT t2.SUBJECT_TITLE, t2.TOTAL_UNITS, t1.DEPARTMENT_NAME, t1.COURSE_DESCRIPTION, DENSE_RANK() OVER (PARTITION BY t2.OFFER_DEPT_CODE ORDER BY t2.OFFER_DEPT_CODE) AS window_column, t2.OFFER_DEPT_CODE FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.SUBJECT_CODE = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.OFFER_SCHOOL_NAME = 'Engineering' AND t2.TOTAL_UNITS > 0 AND t1.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' ), student_summary AS ( SELECT t1.FIRST_NAME, t1.LAST_NAME, t1.DEPARTMENT_NAME, t1.STUDENT_YEAR, t0.DEPARTMENT_FULL_NAME, t2.SIS_ADMIN_DEPARTMENT_NAME, AVG(t2.DEPARTMENT_PHONE_NUMBER) OVER ( PARTITION BY t2.SIS_ADMIN_DEPARTMENT_NAME ORDER BY t1.FIRST_NAME ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t1.DEPARTMENT FROM SIS_DEPARTMENT t0 JOIN MIT_STUDENT_DIRECTORY t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT JOIN SIS_ADMIN_DEPARTMENT t2 ON t1.DEPARTMENT = t2.SIS_ADMIN_DEPARTMENT_CODE WHERE t1.DEPARTMENT = '6' AND t1.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' ) SELECT ss.SUBJECT_TITLE, ss.TOTAL_UNITS, ss.DEPARTMENT_NAME, ss.COURSE_DESCRIPTION, ss.window_column AS subject_window_rank, ss.OFFER_DEPT_CODE, st.FIRST_NAME, st.LAST_NAME, st.DEPARTMENT_NAME AS student_department_name, st.STUDENT_YEAR, st.DEPARTMENT_FULL_NAME, st.SIS_ADMIN_DEPARTMENT_NAME, st.window_column AS student_window_avg_phone FROM subject_summary ss JOIN student_summary st ON ss.OFFER_DEPT_CODE = st.DEPARTMENT ) SELECT OFFER_DEPT_CODE, MAX(TOTAL_UNITS) AS max_total_units, COUNT(DISTINCT student_year) AS distinct_student_years FROM inner_cte GROUP BY OFFER_DEPT_CODE;\"}], \"not_found\": []}"
