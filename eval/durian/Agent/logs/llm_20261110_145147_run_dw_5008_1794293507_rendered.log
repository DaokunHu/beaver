          "function": {
            "name": "semantic_get",
            "arguments": "{\"entity_ids\": \n[\"TIP_DETAIL\", \"ACADEMIC_TERMS_ALL\", \"ACADEMIC_TERM_PARAMETER\", \"COURSE_CATALOG_SUBJECT_OFFERED\", \"ACADEMIC_TERMS\", \"TIP_MATERIAL_STATUS\"]\n\n}"
          }
        },
        {
