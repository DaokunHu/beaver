      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA subject matched with 2022FA catalog subject in same department\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, and the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code. Additionally, for subjects offered in the term with code '2022FA' in the same department, provide the subject ID, department name, term description, the running sum of total units within each academic year ordered by subject ID, and the subject's short title and responsible faculty name from the course catalog. Do not return any rounded answers.\", \"id\": \"dw_5103\", \"name\": \"2017JA TIP Subjects Enrollment Windows Matched with 2022FA Catalog Running Unit Sums per Department\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, MIN(t0.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.DEPARTMENT_CODE ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), Subq2 AS ( SELECT t1.SUBJECT_ID, t1.DEPARTMENT_NAME, t0.TERM_DESCRIPTION, SUM(t1.TOTAL_UNITS) OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t1.SUBJECT_ID) AS running_sum_total_units, t1.DEPARTMENT_CODE, t1.SUBJECT_SHORT_TITLE, t1.RESPONSIBLE_FACULTY_NAME AS CATALOG_RESPONSIBLE_FACULTY_NAME FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TERM_CODE = '2022FA' ) SELECT s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.RESPONSIBLE_FACULTY_NAME, s1.OFFER_DEPT_NAME, s1.DEPARTMENT_FULL_NAME, s1.SCHOOL_NAME, s1.window_column AS min_enrolled_window, s2.SUBJECT_ID, s2.DEPARTMENT_NAME, s2.TERM_DESCRIPTION, s2.running_sum_total_units, s2.SUBJECT_SHORT_TITLE, s2.CATALOG_RESPONSIBLE_FACULTY_NAME FROM inner_cte s1 JOIN Subq2 s2 ON s1.OFFER_DEPT_CODE = s2.DEPARTMENT_CODE ORDER BY s1.OFFER_DEPT_NAME, s2.SUBJECT_ID\"}, {\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics library subject in regular terms\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\", \"id\": \"dw_4724\", \"name\": \"Mathematics Library Regular-Term Subjects 3-Row Max Units with Required Material Department Statistics\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t2.SUBJECT_SHORT_TITLE, MAX(t2.TOTAL_UNITS) OVER (ORDER BY t0.SUBJECT_ID ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS MAX_TOTAL_UNITS, t0.SUBJECT_ID, t0.OFFER_DEPT_NAME AS SUB1_OFFER_DEPT_NAME, t0.OFFER_SCHOOL_NAME AS SUB1_OFFER_SCHOOL_NAME, t0.RESPONSIBLE_FACULTY_NAME FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t1.IS_REGULAR_TERM = 'Y' ), Sub2 AS ( SELECT tso.OFFER_DEPT_NAME, tso.OFFER_SCHOOL_NAME, COUNT(DISTINCT tso.SUBJECT_ID) AS subject_count, MIN(sos.TOTAL_UNITS) AS min_total_units FROM TIP_SUBJECT_OFFERED tso JOIN TIP_DETAIL td ON tso.SUBJECT_ID = td.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY sos ON td.SUBJECT_ID = sos.SUBJECT_ID WHERE td.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY tso.OFFER_DEPT_NAME, tso.OFFER_SCHOOL_NAME ) SELECT icte.SUBJECT_TITLE, icte.NUM_ENROLLED_STUDENTS, icte.OFFER_DEPT_NAME, icte.TERM_DESCRIPTION, icte.ACADEMIC_YEAR, icte.SUBJECT_SHORT_TITLE, icte.MAX_TOTAL_UNITS, s2.subject_count, s2.min_total_units, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.SCHOOL_NAME AS school_name, icte.RESPONSIBLE_FACULTY_NAME FROM inner_cte icte LEFT JOIN Sub2 s2 ON icte.SUB1_OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME AND icte.SUB1_OFFER_SCHOOL_NAME = s2.OFFER_SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON icte.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject code matched with 2022FA subject\", \"desc\": \"For each subject in a department where the school code and subject title are not null, and for each subject offered in the 2022FA term with total units greater than the average for that term, display the subject code, subject code description, department name, subject title, the number of subjects in the same department, the subject ID, the term description, and the running sum of total units for that academic year, ordered by subject ID. Do not return any rounded answers.\", \"id\": \"dw_3867\", \"name\": \"Subject Code Department Counts Matched with 2022FA Above-Average Unit Running Sums\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SUBJECT_TITLE, t0.DEPARTMENT_CODE FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL ) SELECT inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.DEPARTMENT_NAME, inner_cte.SUBJECT_TITLE, dept_counts.subjects_in_department, inner_cte.DEPARTMENT_CODE FROM inner_cte JOIN ( SELECT t0.DEPARTMENT_CODE, COUNT(*) AS subjects_in_department FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL GROUP BY t0.DEPARTMENT_CODE ) dept_counts ON inner_cte.DEPARTMENT_CODE = dept_counts.DEPARTMENT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t1.DEPARTMENT_NAME, t0.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TOTAL_UNITS FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TERM_CODE = '2022FA' ) SELECT SUBJECT_ID, DEPARTMENT_NAME, TERM_DESCRIPTION, SUM(TOTAL_UNITS) OVER (PARTITION BY ACADEMIC_YEAR ORDER BY SUBJECT_ID) AS window_column, ACADEMIC_YEAR, TOTAL_UNITS FROM inner_cte WHERE TOTAL_UNITS > ( SELECT AVG(TOTAL_UNITS) FROM COURSE_CATALOG_SUBJECT_OFFERED WHERE TERM_CODE = '2022FA' ) ORDER BY SUBJECT_ID ) SELECT subq1.SUBJECT_CODE, subq1.SUBJECT_CODE_DESC, subq1.DEPARTMENT_NAME, subq1.SUBJECT_TITLE, subq1.subjects_in_department, subq2.SUBJECT_ID, subq2.TERM_DESCRIPTION, subq2.window_column FROM subq1 JOIN CIS_COURSE_CATALOG ccc ON subq1.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE JOIN subq2 ON ccc.SUBJECT_ID = subq2.SUBJECT_ID ORDER BY subq2.SUBJECT_ID;\"}], \"not_found\": []}"
