          "type": "function",
          "function": {
            "name": "submit_SQL",
            "arguments": "{\"sql\": \"WITH dept_cv AS (\\n    SELECT STDDEV(tso.NUM_ENROLLED_STUDENTS) / AVG(tso.NUM_ENROLLED_STUDENTS) AS coefficient_of_variation\\n    FROM TIP_SUBJECT_OFFERED tso\\n    JOIN STUDENT_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE\\n    WHERE sd.DEPARTMENT_NAME = 'Mathematics'\\n)\\nSELECT\\n    sc.SUBJECT_CODE,\\n    sc.SUBJECT_CODE_DESC,\\n    sc.DEPARTMENT_NAME,\\n    sc.SCHOOL_NAME,\\n    l.SUBJECT_TITLE,\\n    l.NUM_ENROLLED_STUDENTS,\\n    ROW_NUMBER() OVER (PARTITION BY sc.DEPARTMENT_NAME ORDER BY sc.SUBJECT_CODE) AS row_number,\\n    cv.coefficient_of_variation\\nFROM LIBRARY_SUBJECT_OFFERED l\\nJOIN SIS_SUBJECT_CODE sc ON l.COURSE_NUMBER = sc.COURSE_NUMBER\\nJOIN SIS_DEPARTMENT d ON sc.DEPARTMENT_CODE = d.DEPARTMENT_CODE\\nCROSS JOIN dept_cv cv\\nWHERE l.TERM_CODE = '2014FA'\\n  AND l.NUM_ENROLLED_STUDENTS > 5\\n  AND d.DEPARTMENT_NAME = 'Mathematics'\\n  AND d.DEPARTMENT_CODE = '18'\\nORDER BY sc.SUBJECT_CODE\"}"
          }
        }
