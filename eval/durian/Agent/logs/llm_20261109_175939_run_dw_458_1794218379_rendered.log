    {
      "role": "tool",
      "tool_call_id": "call_1e61f85d5e234fbba1fdb5a3",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"FCLT_BUILDING\", \"name\": \"FCLT_BUILDING\", \"desc\": \"Facilities building inventory table: one row per physical building with building number/name, type (e.g. ACADEMIC), ownership, use, occupancy class, gross/assignable/non-assignable areas, number of rooms, key dates (built/acquired/occupied), site and geographic coordinates. Parent of FCLT_ROOMS via FCLT_BUILDING_KEY.\", \"columns\": {\"FCLT_BUILDING_KEY\": {\"desc\": \"Surrogate key of the building; joins to FCLT_ROOMS.FCLT_BUILDING_KEY\"}, \"BUILDING_NUMBER\": {\"desc\": \"Building number/code, e.g. '32', 'E38'; same value as FCLT_BUILDING_KEY in current data; can be matched to FCLT_BUILDING_ADDRESS.BUILDING_NUMBER\"}, \"PARENT_BUILDING_NUMBER\": {\"desc\": \"Parent building number\"}, \"PARENT_BUILDING_NAME\": {\"desc\": \"Parent building name\"}, \"PARENT_BUILDING_NAME_LONG\": {\"desc\": \"Long parent building name\"}, \"BUILDING_NAME_LONG\": {\"desc\": \"Long building name, e.g. 'Stanley Gordon Brown Building'; fuller naming variant of BUILDING_NAME\"}, \"EXT_GROSS_AREA\": {\"desc\": \"Extended gross area of the building in square meters\"}, \"ASSIGNABLE_AREA\": {\"desc\": \"Total assignable area of the building in square meters\"}, \"NON_ASSIGNABLE_AREA\": {\"desc\": \"Non-assignable area of the building in square meters\"}, \"SITE\": {\"desc\": \"Site/campus the building belongs to, e.g. 'MIT', 'BATES', 'LINC', 'BOS'; 'MIT' filters buildings on the MIT campus\"}, \"CAMPUS_SECTOR\": {\"desc\": \"Campus sector the building is in, e.g. 'MAIN GROUP', 'EAST', 'NORTHWEST', 'WEST', 'OFFCAMPUS'\"}, \"ACCESS_LEVEL_CODE\": {\"desc\": \"Numeric access level code of the building (observed values 0-2); distinct from FCLT_ROOMS.ACCESS_LEVEL (per-room) and FCLT_FLOOR.ACCESS_LEVEL (per-floor)\"}, \"ACCESS_LEVEL_NAME\": {\"desc\": \"Access level name of the building (same numeric value as ACCESS_LEVEL_CODE in current data)\"}, \"BUILDING_TYPE\": {\"desc\": \"Building type classification: 'ACADEMIC' (academic buildings), 'SERVICE', or 'RESIDENT' (residential buildings); used to filter academic/residential buildings\"}, \"OWNERSHIP_TYPE\": {\"desc\": \"Ownership type: 'OWNED' or 'LEASED'\"}, \"BUILDING_USE\": {\"desc\": \"Primary use code of the building, e.g. 'AER', 'DHOA', 'STAC', 'GAR', 'OTH'; may be null\"}, \"OCCUPANCY_CLASS\": {\"desc\": \"Occupancy classification code of the building (e.g. 'UGB', 'UGA3', 'UGR2'); coded combinations of use/grade/occupancy attributes\"}, \"BUILDING_HEIGHT\": {\"desc\": \"Height of the building (numeric, in feet); used in height filters and averages\"}, \"COST_CENTER_CODE\": {\"desc\": \"Cost center code of the building, e.g. '1810200'; alternative join key to FCLT_BUILDING_HIST.COST_CENTER_CODE; null for some buildings\"}, \"COST_COLLECTOR_KEY\": {\"desc\": \"Cost collector key of the building (same value as COST_CENTER_CODE in current data); alternative join key to FCLT_BUILDING_HIST.COST_COLLECTOR_KEY used to count historical records per building\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS)\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS)\"}, \"EASTING_X_SPCS\": {\"desc\": \"Easting coordinate (SPCS)\"}, \"NORTHING_Y_SPCS\": {\"desc\": \"Northing coordinate (SPCS)\"}, \"BUILDING_SORT\": {\"desc\": \"Sortable building name\"}, \"BUILDING_NAMED_FOR\": {\"desc\": \"Person the building is named for\"}, \"BUILDING_NAME\": {\"desc\": \"Building name, e.g. 'Ray and Maria Stata Center', 'BROWN BUILDING'; used for building-level grouping and name filters (values are uppercase for some buildings)\"}, \"DATE_BUILT\": {\"desc\": \"Date the building was built, stored in MM/DD/YYYY format (FCLT_BUILDING_HIST_1 variant uses DD-MON-YY); the year built is derived from this column\"}, \"DATE_ACQUIRED\": {\"desc\": \"Date the building was acquired, MM/DD/YYYY format; often null\"}, \"DATE_OCCUPIED\": {\"desc\": \"Date the building was first occupied, MM/DD/YYYY format\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_OF_ROOMS\": {\"desc\": \"Current number of rooms in the building; distinct from FCLT_BUILDING_HIST.NUM_OF_ROOMS which is the per-fiscal-period historical value\"}}, \"default_granularity\": \"one row per building\"}, {\"id\": \"FCLT_ROOMS\", \"name\": \"FCLT_ROOMS\", \"desc\": \"Facilities room inventory table: one row per physical room with building/floor keys, room identifiers, use classifications (major/minor use), organization assignment, area in square meters, access level, and geographic coordinates. Joins to FCLT_BUILDING via FCLT_BUILDING_KEY; referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE via FCLT_ROOM_KEY.\", \"columns\": {\"FCLT_ROOM_KEY\": {\"desc\": \"Surrogate key of the room; joins to COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE for class-meeting location analysis\"}, \"BUILDING_ROOM\": {\"desc\": \"Combined building-room identifier\"}, \"FCLT_BUILDING_KEY\": {\"desc\": \"Building identifier key of the room, storing the building number/code itself (e.g. 'E38', '14N'); can be filtered directly for a building or joined to FCLT_BUILDING.FCLT_BUILDING_KEY for building attributes\"}, \"FLOOR\": {\"desc\": \"Floor the room is on\"}, \"FCLT_FLOOR_KEY\": {\"desc\": \"Foreign key to FCLT_FLOOR\"}, \"ROOM\": {\"desc\": \"Room number/name\"}, \"SPACE_ID\": {\"desc\": \"Space identifier\"}, \"FCLT_MAJOR_USE_KEY\": {\"desc\": \"Major use key of the room; joins to FCLT_MAJOR_USE.FCLT_MAJOR_USE_KEY to decode the major use code/description and assignable flag\"}, \"MAJOR_USE_DESC\": {\"desc\": \"Major use description, e.g. classroom\"}, \"FCLT_USE_KEY\": {\"desc\": \"\"}, \"USE_DESC\": {\"desc\": \"Use description of the room\"}, \"FCLT_MINOR_USE_KEY\": {\"desc\": \"Minor use key of the room\"}, \"MINOR_USE_DESC\": {\"desc\": \"Minor use description\"}, \"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Organization key of the room\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Organization name occupying the room\"}, \"FCLT_MINOR_ORGANIZATION_KEY\": {\"desc\": \"Minor organization key of the room\"}, \"MINOR_ORGANIZATION\": {\"desc\": \"Minor organization name\"}, \"AREA\": {\"desc\": \"Room area in square meters; used in area statistics (average, range, variance)\"}, \"ROOM_FULL_NAME\": {\"desc\": \"Full room name\"}, \"DEPT_CODE\": {\"desc\": \"Department code assigned to the room\"}, \"ACCESS_LEVEL\": {\"desc\": \"Numeric access level code of the room (observed values 0-3); used to filter rooms by access restriction level, e.g. ACCESS_LEVEL = 1\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS)\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS)\"}, \"NORTHING_SPCS\": {\"desc\": \"Northing coordinate (SPCS)\"}, \"EASTING_SPCS\": {\"desc\": \"Easting coordinate (SPCS)\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per room\"}, {\"id\": \"FCLT_BUILDING_ADDRESS\", \"name\": \"FCLT_BUILDING_ADDRESS\", \"desc\": \"Facilities building address table: one row per address record of a building (a building may hold several addresses for different purposes such as street, mail, parcel, and E911 emergency addresses), with street number and suffix, directional prefixes/suffixes, street name and suffix, city, state, postal code, address purpose, city identifier, and E911 flag. Joins to FCLT_BUILDING via FCLT_BUILDING_KEY; used to locate buildings by city/state/street and to report address attributes alongside building characteristics.\", \"columns\": {\"POSTAL_CODE\": {\"desc\": \"Postal (ZIP) code of the address\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"FCLT_BUILDING_ADDRESS_KEY\": {\"desc\": \"Surrogate key of the address record\"}, \"FCLT_BUILDING_KEY\": {\"desc\": \"Building identifier key the address belongs to; joins to FCLT_BUILDING.FCLT_BUILDING_KEY\"}, \"BUILDING_NUMBER\": {\"desc\": \"Building number as written on the address record; can also be matched directly to FCLT_BUILDING.BUILDING_NUMBER\"}, \"ADDRESS_PURPOSE\": {\"desc\": \"Purpose of the address record, e.g. 'STREET', 'MAIL', 'PARCL1'-'PARCL3', 'E911_1'-'E911_5'; one building can have multiple address rows with different purposes\"}, \"ADDRESS_CITY_ID\": {\"desc\": \"Internal identifier of the address city\"}, \"IS_E911_ADDRESS\": {\"desc\": \"Flag indicating whether the address is the E911 emergency address\"}, \"STREET_NUMBER\": {\"desc\": \"Numeric street number of the address (stored as string; compared numerically in address-range filters)\"}, \"STREET_NUMBER_SUFFIX\": {\"desc\": \"Suffix attached to the street number, e.g. 'A'\"}, \"PRE_DIRECTIONAL\": {\"desc\": \"Directional prefix of the street, e.g. 'N', 'SW'\"}, \"STREET_NAME\": {\"desc\": \"Street name of the address, e.g. 'MASSACHUSETTS AVENUE'\"}, \"STREET_SUFFIX\": {\"desc\": \"Street type suffix, e.g. 'AVE', 'ST', 'RD'\"}, \"POST_DIRECTIONAL\": {\"desc\": \"Directional suffix of the street\"}, \"CITY\": {\"desc\": \"City of the address, e.g. 'CAMBRIDGE', 'BOSTON'; used to filter buildings by city\"}, \"STATE\": {\"desc\": \"State abbreviation of the address, e.g. 'MA', 'DC'\"}}, \"default_granularity\": \"one row per building address record\"}, {\"id\": \"FAC_BUILDING\", \"name\": \"FAC_BUILDING\", \"desc\": \"Facilities building snapshot table (FAC_* family): one row per physical building with the same building attribute structure as FCLT_BUILDING (number/name, type, ownership, use, occupancy class, gross/assignable/non-assignable areas, number of rooms, key dates, site, coordinates) but keyed by FAC_BUILDING_KEY and joining the FAC_* family (FAC_ROOMS, FAC_FLOOR, FAC_BUILDING_ADDRESS, FAC_ORGANIZATION). Used as the building dimension when FAC_* family keys are involved; FCLT_BUILDING is the counterpart in the FCLT_* family.\", \"columns\": {\"DATE_ACQUIRED\": {\"desc\": \"Date the building was acquired\"}, \"DATE_OCCUPIED\": {\"desc\": \"Date the building was first occupied\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_OF_ROOMS\": {\"desc\": \"Number of rooms in the building\"}, \"FAC_BUILDING_KEY\": {\"desc\": \"Surrogate key of the building in the FAC_* family; joins to FAC_ROOMS.BUILDING_KEY, FAC_FLOOR.BUILDING_KEY, FAC_BUILDING_ADDRESS.BUILDING_KEY; same value domain as FCLT_BUILDING.FCLT_BUILDING_KEY (building number)\"}, \"BUILDING_NUMBER\": {\"desc\": \"Building number/code, e.g. '39'\"}, \"PARENT_BUILDING_NUMBER\": {\"desc\": \"Parent building number\"}, \"PARENT_BUILDING_NAME\": {\"desc\": \"Parent building name\"}, \"PARENT_BUILDING_NAME_LONG\": {\"desc\": \"Long parent building name\"}, \"BUILDING_NAME_LONG\": {\"desc\": \"Long building name\"}, \"EXT_GROSS_AREA\": {\"desc\": \"Extended gross area of the building in square meters\"}, \"ASSIGNABLE_AREA\": {\"desc\": \"Total assignable area of the building in square meters\"}, \"NON_ASSIGNABLE_AREA\": {\"desc\": \"Non-assignable area of the building in square meters\"}, \"SITE\": {\"desc\": \"Site of the building, e.g. 'MIT'\"}, \"CAMPUS_SECTOR\": {\"desc\": \"Campus sector the building is in\"}, \"ACCESS_LEVEL_CODE\": {\"desc\": \"Numeric access level code of the building\"}, \"ACCESS_LEVEL_NAME\": {\"desc\": \"Access level name of the building\"}, \"BUILDING_TYPE\": {\"desc\": \"Building type: 'ACADEMIC', 'SERVICE', or 'RESIDENT'\"}, \"OWNERSHIP_TYPE\": {\"desc\": \"Ownership type: 'OWNED' or 'LEASED'\"}, \"BUILDING_USE\": {\"desc\": \"Primary use code of the building\"}, \"OCCUPANCY_CLASS\": {\"desc\": \"Occupancy classification code of the building\"}, \"BUILDING_HEIGHT\": {\"desc\": \"Height of the building\"}, \"COST_CENTER_CODE\": {\"desc\": \"Cost center code of the building\"}, \"COST_COLLECTOR_KEY\": {\"desc\": \"Cost collector key of the building\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS)\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS)\"}, \"EASTING_X_SPCS\": {\"desc\": \"Easting coordinate (SPCS)\"}, \"NORTHING_Y_SPCS\": {\"desc\": \"Northing coordinate (SPCS)\"}, \"BUILDING_SORT\": {\"desc\": \"Sortable building name\"}, \"BUILDING_NAMED_FOR\": {\"desc\": \"Person the building is named for\"}, \"BUILDING_NAME\": {\"desc\": \"Building name, e.g. 'BROWN BUILDING'\"}, \"DATE_BUILT\": {\"desc\": \"Date the building was built\"}}, \"default_granularity\": \"one row per building\"}, {\"id\": \"FAC_ROOMS\", \"name\": \"FAC_ROOMS\", \"desc\": \"Facilities room snapshot table with the same room inventory structure as FCLT_ROOMS (building/floor keys, room identifiers, major/minor use classifications, organization assignment, area, access level, coordinates) but keyed by FAC_ROOM_KEY and joining the FAC_* family (FAC_BUILDING, FAC_FLOOR, FAC_ORGANIZATION). Used as an alternative room source when FAC_* family keys are involved.\", \"columns\": {\"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"FAC_ROOM_KEY\": {\"desc\": \"Surrogate key of the room in the FAC_* family\"}, \"BUILDING_KEY\": {\"desc\": \"Foreign key to FAC_BUILDING.FAC_BUILDING_KEY\"}, \"FLOOR\": {\"desc\": \"Floor the room is on\"}, \"FLOOR_KEY\": {\"desc\": \"Foreign key to FAC_FLOOR.FLOOR_KEY\"}, \"ROOM\": {\"desc\": \"Room number/name\"}, \"SPACE_ID\": {\"desc\": \"Space identifier\"}, \"MAJOR_USE_KEY\": {\"desc\": \"Major use key of the room\"}, \"MAJOR_USE_DESC\": {\"desc\": \"Major use description, e.g. classroom\"}, \"USE_KEY\": {\"desc\": \"Use key of the room\"}, \"USE_DESC\": {\"desc\": \"Use description of the room\"}, \"MINOR_USE_KEY\": {\"desc\": \"Minor use key of the room\"}, \"MINOR_USE_DESC\": {\"desc\": \"Minor use description\"}, \"ORGANIZATION_KEY\": {\"desc\": \"Foreign key to FAC_ORGANIZATION.ORGANIZATION_KEY; organization occupying the room\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Organization name occupying the room\"}, \"MINOR_ORGANIZATION_KEY\": {\"desc\": \"Key of the secondary organization for the room\"}, \"MINOR_ORGANIZATION\": {\"desc\": \"Secondary organization name\"}, \"AREA\": {\"desc\": \"Room area in square meters\"}, \"ROOM_FULL_NAME\": {\"desc\": \"Full room name\"}, \"DEPT_CODE\": {\"desc\": \"Department code assigned to the room\"}, \"ACCESS_LEVEL\": {\"desc\": \"Access level of the room\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS)\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS)\"}, \"NORTHING_SPCS\": {\"desc\": \"Northing coordinate (SPCS)\"}, \"EASTING_SPCS\": {\"desc\": \"Easting coordinate (SPCS)\"}}, \"default_granularity\": \"one row per physical room\"}, {\"id\": \"FAC_BUILDING_ADDRESS\", \"name\": \"FAC_BUILDING_ADDRESS\", \"desc\": \"Facilities building address table (FAC_* family): one row per address record of a building (street, mail, parcel, E911 purposes), with street number/name/suffix, directionals, city, state, postal code, address purpose, and E911 flag. Same address structure as FCLT_BUILDING_ADDRESS but keyed by BUILDING_KEY joining FAC_BUILDING.FAC_BUILDING_KEY; used as the address source when FAC_* family keys are involved.\", \"columns\": {\"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"BUILDING_ADDRESS_KEY\": {\"desc\": \"Surrogate key of the address record in the FAC_* family\"}, \"BUILDING_KEY\": {\"desc\": \"Foreign key to FAC_BUILDING.FAC_BUILDING_KEY; the building the address belongs to\"}, \"ADDRESS_PURPOSE\": {\"desc\": \"Purpose of the address record, e.g. 'STREET', 'MAIL', 'PARCL1', 'E911_1'\"}, \"ADDRESS_CITY_ID\": {\"desc\": \"Internal identifier of the address city\"}, \"IS_E911_ADDRESS\": {\"desc\": \"Flag indicating whether the address is the E911 emergency address\"}, \"STREET_NUMBER\": {\"desc\": \"Numeric street number of the address (stored as string)\"}, \"STREET_NUMBER_SUFFIX\": {\"desc\": \"Suffix attached to the street number\"}, \"PRE_DIRECTIONAL\": {\"desc\": \"Directional prefix of the street\"}, \"STREET_NAME\": {\"desc\": \"Street name of the address\"}, \"STREET_SUFFIX\": {\"desc\": \"Street type suffix, e.g. 'AVE', 'ST'\"}, \"POST_DIRECTIONAL\": {\"desc\": \"Directional suffix of the street\"}, \"CITY\": {\"desc\": \"City of the address, e.g. 'CAMBRIDGE'\"}, \"STATE\": {\"desc\": \"State abbreviation of the address, e.g. 'MA'\"}, \"POSTAL_CODE\": {\"desc\": \"Postal (ZIP) code of the address\"}}, \"default_granularity\": \"one row per building address record\"}, {\"id\": \"BUILDINGS\", \"name\": \"BUILDINGS\", \"desc\": \"Space-domain building lookup table: one row per building with building key/number, building name, street and mailing addresses as single text fields, gross and assignable square footage (in square feet), and a building counter. Referenced by SPACE_DETAIL via BUILDING_KEY; a lightweight building reference for space-assignment reporting, without the type/ownership/site classification carried by FCLT_BUILDING or FAC_BUILDING.\", \"columns\": {\"BUILDING_KEY\": {\"desc\": \"Building key (same value as BUILDING_NUMBER, e.g. 'NW32'); joins to SPACE_DETAIL.BUILDING_KEY and matches FCLT_BUILDING.FCLT_BUILDING_KEY value domain\"}, \"BUILDING_NUMBER\": {\"desc\": \"Building number/code, e.g. 'NW35'\"}, \"BUILDING_NAME\": {\"desc\": \"Building name, e.g. 'Ashdown House'; may be a generic 'BUILDING <number>' placeholder\"}, \"BUILDING_STREET_ADDRESS\": {\"desc\": \"Full street address as a single text field, e.g. '235 ALBANY ST'\"}, \"BUILDING_MAILING_ADDRESS\": {\"desc\": \"Mailing address as a single text field; often null\"}, \"BLDG_GROSS_SQUARE_FOOTAGE\": {\"desc\": \"Gross square footage of the building in square feet (note: FCLT_BUILDING.EXT_GROSS_AREA is in square meters)\"}, \"BLDG_ASSIGNABLE_SQUARE_FOOTAGE\": {\"desc\": \"Assignable square footage of the building in square feet\"}, \"BUILDING_COUNTER\": {\"desc\": \"Record counter; equals 1 for every building row\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per building\"}, {\"id\": \"SPACE_DETAIL\", \"name\": \"SPACE_DETAIL\", \"desc\": \"Space assignment detail fact table: one row per physical room assigned to a space unit, with building/floor/space-unit/space-usage keys, room identifiers (building-room number and name, room number), room square footage, room counter, and building component. Used to count rooms per space unit or per building, and to analyze room size and usage distribution. Joins to SPACE_UNIT via SPACE_UNIT_KEY, FCLT_BUILDING via BUILDING_KEY, SPACE_FLOOR via FLOOR_KEY, and SPACE_USAGE via SPACE_USAGE_KEY.\", \"columns\": {\"BUILDING_KEY\": {\"desc\": \"Foreign key to FCLT_BUILDING.FCLT_BUILDING_KEY; the building containing the room; used to find the building with the most rooms within a space unit\"}, \"FLOOR_KEY\": {\"desc\": \"Foreign key to SPACE_FLOOR.FLOOR_KEY; the floor the room is on\"}, \"SPACE_UNIT_KEY\": {\"desc\": \"Foreign key to SPACE_UNIT.SPACE_UNIT_KEY; the space unit the room is assigned to\"}, \"SPACE_USAGE_KEY\": {\"desc\": \"Foreign key to SPACE_USAGE.SPACE_USAGE_KEY; the usage classification of the room (e.g. classroom, office, lab)\"}, \"BUILDING_ROOM\": {\"desc\": \"Combined building-room identifier, e.g. '1-080'; counting rows of this column gives the number of rooms per space unit/building\"}, \"BUILDING_ROOM_NAME\": {\"desc\": \"Room name (usually identical to BUILDING_ROOM)\"}, \"ROOM_NUMBER\": {\"desc\": \"Room number within the building, e.g. '80', '82F'\"}, \"ROOM_SQUARE_FOOTAGE\": {\"desc\": \"Room area in square feet (note: FCLT_ROOMS.AREA is in square meters)\"}, \"ROOM_COUNTER\": {\"desc\": \"Room count indicator; equals 1 for every room row, so SUM(ROOM_COUNTER) also yields room counts\"}, \"BUILDING_COMPONENT\": {\"desc\": \"Building component identifier the room belongs to\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per room assigned to a space unit\", \"entity\": {\"columns\": {\"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the room assignment record, stored as DD-MON-YY text (e.g. '19-DEC-24'); all current rows carry '19-DEC-24'. This is the room-side load date used to filter which room snapshot to analyze; it is distinct from SPACE_FLOOR.WAREHOUSE_LOAD_DATE (the floor lookup record's load date), which is the column to report when a question asks for the floor's warehouse load date.\"}}}, \"reason\": \"Case dw_2528 filters rooms on SPACE_DETAIL.WAREHOUSE_LOAD_DATE='19-DEC-24' while reporting the floor's warehouse load date from SPACE_FLOOR; the two same-named columns are confusing and their difference (room snapshot load date vs floor lookup load date, DD-MON-YY text format) must be documented per column description rules.\"}], \"not_found\": []}"
