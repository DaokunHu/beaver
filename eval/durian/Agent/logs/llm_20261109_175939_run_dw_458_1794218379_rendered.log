      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_565\", \"name\": \"MIT Academic Building Number and Floor Statistics with Address Street and City\", \"desc\": \"For each academic building at MIT with building numbers between '14' and 'E62' or floor numbers at least 2, and floor numbers between 3 and 16, what are the minimum building number, average floor number, and the street name and city of the building's address? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT fb.BUILDING_NUMBER, MIN(fb.BUILDING_NUMBER) AS min_building_number, AVG(ff.FLOOR) AS avg_floor_number, fb.FCLT_BUILDING_KEY FROM FCLT_BUILDING fb JOIN FCLT_FLOOR ff ON fb.FCLT_BUILDING_KEY = ff.FCLT_BUILDING_KEY WHERE fb.BUILDING_TYPE = 'ACADEMIC' AND fb.SITE = 'MIT' AND ( (fb.BUILDING_NUMBER >= '14' AND fb.BUILDING_NUMBER <= 'E62') OR ff.FLOOR >= 2 ) AND ff.FLOOR BETWEEN 3 AND 16 GROUP BY fb.BUILDING_NUMBER, fb.FCLT_BUILDING_KEY ) SELECT ic.BUILDING_NUMBER, ic.min_building_number, ic.avg_floor_number, fba.STREET_NAME, fba.CITY FROM inner_cte ic JOIN FCLT_BUILDING_ADDRESS fba ON ic.BUILDING_NUMBER = fba.BUILDING_NUMBER ORDER BY ic.BUILDING_NUMBER;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per building number matched with its address records\"}, {\"id\": \"dw_5455\", \"name\": \"MIT Residential Building Minimum Room Count and Average Height with Address Street Number Filter\", \"desc\": \"What are the minimum number of rooms and the average building height for each building that is used as a residence, where the number of rooms is between 10 and 400 or the building height is at least 30, and the street number in the building address is between 40 and 27000, and only for buildings at MIT? Do not return any rounded answers.\", \"sql\": \"SELECT fb.FCLT_BUILDING_KEY, MIN(fb.NUM_OF_ROOMS) AS min_num_of_rooms, AVG(fb.BUILDING_HEIGHT) AS avg_building_height FROM FCLT_BUILDING fb JOIN FCLT_BUILDING_ADDRESS fba ON fb.FCLT_BUILDING_KEY = fba.FCLT_BUILDING_KEY WHERE fb.BUILDING_TYPE = 'RESIDENT' AND fb.SITE = 'MIT' AND ( (fb.NUM_OF_ROOMS BETWEEN 10 AND 400) OR (fb.BUILDING_HEIGHT >= 30) ) AND fba.STREET_NUMBER BETWEEN 40 AND 27000 GROUP BY fb.FCLT_BUILDING_KEY ;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per residential building at MIT\"}, {\"id\": \"dw_1488\", \"name\": \"MIT Academic Building Floor Room Area Statistics with Assignable Area Dispersion and Room Counts\", \"desc\": \"For each academic building at MIT and each of its floors with total assignable area greater than 5000 and at least one room with access level 1 or 2, provide the building's long name, the floor number, the range and variance of the area of rooms on that floor (considering only rooms with access level 1 or 2), the range and variance of the assignable area of its floors that have at least one room, and the total number of rooms in the building. Do not return any rounded answers.\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT fb.BUILDING_NAME_LONG, fr.FCLT_FLOOR_KEY, MAX(fr.AREA) - MIN(fr.AREA) AS area_range, VARIANCE(fr.AREA) AS area_variance FROM FCLT_ROOMS fr JOIN FCLT_BUILDING fb ON fr.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY WHERE fr.ACCESS_LEVEL IN (1, 2) AND fb.BUILDING_TYPE = 'ACADEMIC' GROUP BY fb.BUILDING_NAME_LONG, fr.FCLT_FLOOR_KEY ) SELECT ic.BUILDING_NAME_LONG, ff.FLOOR, ic.area_range, ic.area_variance, ff.FCLT_BUILDING_KEY FROM inner_cte ic JOIN FCLT_FLOOR ff ON ic.FCLT_FLOOR_KEY = ff.FCLT_FLOOR_KEY WHERE ff.ASSIGNABLE_AREA > 5000 ), subq2 AS ( WITH inner_cte AS ( WITH floors_with_rooms AS ( SELECT DISTINCT ff.FCLT_BUILDING_KEY, ff.FLOOR, ff.ASSIGNABLE_AREA FROM FCLT_FLOOR ff JOIN FCLT_ROOMS fr ON ff.FCLT_BUILDING_KEY = fr.FCLT_BUILDING_KEY AND ff.FLOOR = fr.FLOOR ), academic_buildings AS ( SELECT DISTINCT fbh.FCLT_BUILDING_KEY, fbh.BUILDING_NAME_LONG FROM FCLT_BUILDING_HIST fbh WHERE fbh.BUILDING_TYPE = 'ACADEMIC' AND fbh.SITE = 'MIT' ) SELECT ab.FCLT_BUILDING_KEY, ab.BUILDING_NAME_LONG, MAX(fwr.ASSIGNABLE_AREA) - MIN(fwr.ASSIGNABLE_AREA) AS assignable_area_range, VARIANCE(fwr.ASSIGNABLE_AREA) AS assignable_area_variance FROM academic_buildings ab JOIN floors_with_rooms fwr ON ab.FCLT_BUILDING_KEY = fwr.FCLT_BUILDING_KEY GROUP BY ab.FCLT_BUILDING_KEY, ab.BUILDING_NAME_LONG ) SELECT ic.BUILDING_NAME_LONG, ic.assignable_area_range, ic.assignable_area_variance, COUNT(fr.FCLT_ROOM_KEY) AS total_room_count, ic.FCLT_BUILDING_KEY FROM inner_cte ic LEFT JOIN FCLT_ROOMS fr ON ic.FCLT_BUILDING_KEY = fr.FCLT_BUILDING_KEY GROUP BY ic.BUILDING_NAME_LONG, ic.assignable_area_range, ic.assignable_area_variance, ic.FCLT_BUILDING_KEY ) SELECT s1.BUILDING_NAME_LONG, s1.FLOOR, s1.area_range, s1.area_variance, s2.assignable_area_range, s2.assignable_area_variance, s2.total_room_count FROM subq1 s1 JOIN subq2 s2 ON s1.BUILDING_NAME_LONG = s2.BUILDING_NAME_LONG AND s1.FCLT_BUILDING_KEY = s2.FCLT_BUILDING_KEY ORDER BY s1.BUILDING_NAME_LONG, s1.FLOOR\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per floor of each MIT academic building with high assignable area\"}], \"not_found\": []}"
