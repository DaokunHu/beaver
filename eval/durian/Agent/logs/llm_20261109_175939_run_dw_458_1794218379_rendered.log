    {
      "role": "tool",
      "tool_call_id": "call_2a3d3af622e347e5b6c8d653",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"concept_building_inventory\", \"name\": \"Building Inventory\", \"desc\": \"Tables recording the physical building inventory and its attributes (number/name, type, ownership, site, campus sector, access level, gross/assignable/non-assignable areas, number of rooms, key dates): the current FCLT_* family snapshot, its fiscal-period history (in two date-format variants), the FAC_* family snapshot, and the lightweight space-domain building lookup. They jointly answer questions about building characteristics, areas, and room counts, but differ in time coverage, table family, attribute richness, and area units.\", \"tables\": [\"FCLT_BUILDING\", \"FCLT_BUILDING_HIST\", \"FCLT_BUILDING_HIST_1\", \"FAC_BUILDING\", \"BUILDINGS\"], \"comparisons\": [{\"dimension\": \"Time coverage\", \"differences\": \"FCLT_BUILDING, FAC_BUILDING, and BUILDINGS are current snapshots (one row per building); FCLT_BUILDING_HIST and FCLT_BUILDING_HIST_1 carry one row per building per fiscal period (201505-201906, ~48 periods), enabling trend and dispersion statistics (stddev/variance of assignable area, room counts) across historical records.\"}, {\"dimension\": \"Table family and join paths\", \"differences\": \"FCLT_BUILDING/FCLT_BUILDING_HIST join the FCLT_* family (FCLT_ROOMS, FCLT_FLOOR, FCLT_BUILDING_ADDRESS via FCLT_BUILDING_KEY); FAC_BUILDING joins the FAC_* family (FAC_ROOMS, FAC_FLOOR, FAC_BUILDING_ADDRESS via FAC_BUILDING_KEY); BUILDINGS joins the space domain (SPACE_DETAIL via BUILDING_KEY). FCLT_BUILDING_KEY, FAC_BUILDING_KEY, and BUILDINGS.BUILDING_KEY share the same building-number value domain.\"}, {\"dimension\": \"Attribute richness\", \"differences\": \"FCLT_BUILDING, FCLT_BUILDING_HIST, FCLT_BUILDING_HIST_1, and FAC_BUILDING carry full classification attributes (BUILDING_TYPE ACADEMIC/SERVICE/RESIDENT, OWNERSHIP_TYPE OWNED/LEASED, SITE, CAMPUS_SECTOR, ACCESS_LEVEL_CODE, OCCUPANCY_CLASS, BUILDING_HEIGHT, DATE_BUILT); BUILDINGS only carries key/number, name, single-text street and mailing addresses, and square-footage measures.\"}, {\"dimension\": \"Area units\", \"differences\": \"FCLT_*/FAC_* building tables measure EXT_GROSS_AREA/ASSIGNABLE_AREA/NON_ASSIGNABLE_AREA in square meters; BUILDINGS measures BLDG_GROSS_SQUARE_FOOTAGE/BLDG_ASSIGNABLE_SQUARE_FOOTAGE in square feet. Unit choice matters for area thresholds and averages.\"}, {\"dimension\": \"Date column formats\", \"differences\": \"FCLT_BUILDING and FCLT_BUILDING_HIST store DATE_BUILT/DATE_ACQUIRED/DATE_OCCUPIED as MM/DD/YYYY strings; FCLT_BUILDING_HIST_1 is identical to FCLT_BUILDING_HIST except these dates are stored as DD-MON-YY strings (e.g. '25-APR-03').\"}, {\"dimension\": \"Alternative join keys to history\", \"differences\": \"FCLT_BUILDING joins FCLT_BUILDING_HIST primarily on FCLT_BUILDING_KEY, but COST_CENTER_CODE and COST_COLLECTOR_KEY are also valid join keys (used when counting historical records per cost collector); ACCESS_LEVEL_CODE joins associate buildings sharing the same access level with history attributes.\"}], \"decision_guide\": {\"Current building attributes, type/site/ownership filters, or current area and room-count values\": \"Use FCLT_BUILDING: the current FCLT_* family snapshot with full classification attributes and square-meter areas.\", \"Historical trends, per-fiscal-period values, or dispersion statistics (stddev/variance/count) across a building's history records\": \"Use FCLT_BUILDING_HIST: one row per building per fiscal period; count its rows for 'number of historical records' and aggregate ASSIGNABLE_AREA/NUM_OF_ROOMS across periods.\", \"Building history where dates must appear in DD-MON-YY format\": \"Use FCLT_BUILDING_HIST_1: identical to FCLT_BUILDING_HIST except DATE_BUILT/DATE_ACQUIRED/DATE_OCCUPIED formatting.\", \"Building analysis that must stay inside the FAC_* key family (FAC_ROOMS/FAC_FLOOR/FAC_ORGANIZATION)\": \"Use FAC_BUILDING: mirrors FCLT_BUILDING attributes but joins via FAC_BUILDING_KEY.\", \"Building name/address text and square-footage measures for space-assignment reporting\": \"Use BUILDINGS: the space-domain lookup referenced by SPACE_DETAIL via BUILDING_KEY, with square-footage (not square-meter) measures.\"}}, {\"id\": \"concept_room_space_inventory\", \"name\": \"Room and Space Inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\", \"tables\": [\"SPACE_DETAIL\", \"FCLT_ROOMS\", \"FAC_ROOMS\", \"ZPM_ROOMS_LOAD\"], \"comparisons\": [{\"dimension\": \"Business perspective\", \"differences\": \"SPACE_DETAIL records rooms from the space-assignment perspective (which space unit each room is allocated to, with SPACE_USAGE_KEY usage code); FCLT_ROOMS and FAC_ROOMS record rooms from the facilities inventory perspective (major/minor use descriptions, primary and minor organization occupancy); ZPM_ROOMS_LOAD records rooms from the space-planning load perspective (space usage text, floor, access level, occupying HR org unit).\"}, {\"dimension\": \"Key family and join paths\", \"differences\": \"SPACE_DETAIL joins SPACE_UNIT/SPACE_FLOOR/SPACE_USAGE and FCLT_BUILDING via BUILDING_KEY; FCLT_ROOMS joins FCLT_BUILDING via FCLT_BUILDING_KEY and FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, and is referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE; FAC_ROOMS joins the FAC_* family (FAC_BUILDING, FAC_FLOOR, FAC_ORGANIZATION); ZPM_ROOMS_LOAD joins SPACE_UNIT via SPACE_UNIT_CODE and FCLT_ORGANIZATION/HR_ORG_UNIT via HR_ORG_UNIT_ID (no building/floor keys).\"}, {\"dimension\": \"Area measure and units\", \"differences\": \"SPACE_DETAIL.ROOM_SQUARE_FOOTAGE is in square feet; FCLT_ROOMS.AREA and FAC_ROOMS.AREA are in square meters; ZPM_ROOMS_LOAD carries no area measure at all. Unit choice matters for size thresholds and averages.\"}, {\"dimension\": \"Room counting semantics\", \"differences\": \"SPACE_DETAIL supports counting rooms per space unit or per building via BUILDING_ROOM rows (and ROOM_COUNTER=1 per row); FCLT_BUILDING also carries a precomputed NUM_OF_ROOMS attribute per building, while FCLT_ROOMS/FAC_ROOMS/ZPM_ROOMS_LOAD require COUNT over room rows.\"}, {\"dimension\": \"Usage classification detail\", \"differences\": \"SPACE_DETAIL uses a coded SPACE_USAGE_KEY decoded by SPACE_USAGE; FCLT_ROOMS/FAC_ROOMS carry denormalized MAJOR_USE_DESC/USE_DESC/MINOR_USE_DESC text classifications plus ACCESS_LEVEL and coordinates; ZPM_ROOMS_LOAD carries a free-text SPACE_USAGE (e.g. 'DSGN STUDIO', 'CONF RM') plus ACCESS_LEVEL and a text FLOOR that can hold labels such as 'G9'.\"}], \"decision_guide\": {\"Counting rooms per space unit or finding the building with the most rooms in a space unit\": \"Use SPACE_DETAIL: it is the only table keyed by SPACE_UNIT_KEY, so room counts can be grouped by space unit and by BUILDING_KEY directly.\", \"Room area statistics in square meters, use-classification filters (e.g. classrooms), or linking class meeting places to rooms\": \"Use FCLT_ROOMS: it carries AREA in square meters, denormalized use descriptions, and FCLT_ROOM_KEY referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE.\", \"Room analysis that must stay inside the FAC_* key family (FAC_BUILDING/FAC_FLOOR/FAC_ORGANIZATION)\": \"Use FAC_ROOMS: it mirrors FCLT_ROOMS structure but joins FAC_* family tables via FAC_ROOM_KEY/BUILDING_KEY/ORGANIZATION_KEY.\", \"Room occupancy by organization hierarchy (level, parent organization)\": \"Use FCLT_ROOMS joined to FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, SPACE_DETAIL joined via SPACE_UNIT to SPACE_UNIT.FCLT_ORGANIZATION_KEY when the space-assignment view is required, or ZPM_ROOMS_LOAD joined to FCLT_ORGANIZATION via HR_ORG_UNIT_ID for the space-planning view.\", \"Room analysis by floor, space usage text, or access level linked to space units or HR org units (no area needed)\": \"Use ZPM_ROOMS_LOAD: it links rooms to SPACE_UNIT via SPACE_UNIT_CODE and to organizations/HR units via HR_ORG_UNIT_ID.\"}}, {\"id\": \"concept_building_address\", \"name\": \"Building Address\", \"desc\": \"Tables recording the postal/street addresses of buildings: the current FCLT_* family address table (multiple purpose-typed address rows per building), its fiscal-period historical counterpart, the FAC_* family address snapshot, and the single-text address fields of the space-domain BUILDINGS lookup. They jointly answer questions about where a building is located (street number/name, city, state, postal code), but differ in time coverage, address decomposition, and table family.\", \"tables\": [\"FCLT_BUILDING_ADDRESS\", \"FCLT_BUILDING_ADDRESS_HIST\", \"FAC_BUILDING_ADDRESS\", \"BUILDINGS\"], \"comparisons\": [{\"dimension\": \"Time coverage\", \"differences\": \"FCLT_BUILDING_ADDRESS, FAC_BUILDING_ADDRESS, and BUILDINGS are current snapshots; FCLT_BUILDING_ADDRESS_HIST carries one row per address record per fiscal period, enabling historical address comparison.\"}, {\"dimension\": \"Address decomposition\", \"differences\": \"FCLT_BUILDING_ADDRESS, FCLT_BUILDING_ADDRESS_HIST, and FAC_BUILDING_ADDRESS decompose the address into structured components (STREET_NUMBER, STREET_NUMBER_SUFFIX, PRE_DIRECTIONAL, STREET_NAME, STREET_SUFFIX, POST_DIRECTIONAL, CITY, STATE, POSTAL_CODE) plus ADDRESS_PURPOSE ('STREET', 'MAIL', 'PARCL1'-'PARCL3', 'E911_1'-'E911_5') and IS_E911_ADDRESS; BUILDINGS stores only unstructured BUILDING_STREET_ADDRESS and BUILDING_MAILING_ADDRESS text fields.\"}, {\"dimension\": \"Table family and join paths\", \"differences\": \"FCLT_BUILDING_ADDRESS(_HIST) join FCLT_BUILDING via FCLT_BUILDING_KEY (BUILDING_NUMBER is an alternative match); FAC_BUILDING_ADDRESS joins FAC_BUILDING via BUILDING_KEY = FAC_BUILDING_KEY; BUILDINGS is referenced by SPACE_DETAIL via BUILDING_KEY.\"}, {\"dimension\": \"Row multiplicity\", \"differences\": \"All three structured address tables hold multiple rows per building (one per address purpose), so joining buildings to addresses can multiply building rows; BUILDINGS holds exactly one row per building.\"}], \"decision_guide\": {\"Filtering buildings by city/state or reporting structured address components (street number, street name, postal code)\": \"Use FCLT_BUILDING_ADDRESS joined to FCLT_BUILDING via FCLT_BUILDING_KEY; expect multiple address rows per building (one per ADDRESS_PURPOSE).\", \"Historical per-fiscal-period address values\": \"Use FCLT_BUILDING_ADDRESS_HIST: the only address table with a FISCAL_PERIOD time dimension.\", \"Address lookup inside the FAC_* key family\": \"Use FAC_BUILDING_ADDRESS joined to FAC_BUILDING via BUILDING_KEY.\", \"Displaying a building's full street/mailing address as text for space-assignment reporting\": \"Use BUILDINGS.BUILDING_STREET_ADDRESS / BUILDING_MAILING_ADDRESS; no structured components are available there.\"}}, {\"id\": \"column_concept_building_type_site\", \"name\": \"Building Type and Site Classification\", \"desc\": \"Building classification columns replicated across the current and historical building tables of both table families: BUILDING_TYPE ('ACADEMIC', 'SERVICE', 'RESIDENT') and SITE ('MIT', 'BATES', 'LINC', 'BOS', etc.). They carry the same value domain but differ in time semantics: the building-table columns are the current classification, while the history-table columns are the classification recorded at each fiscal period, so filtering by one versus the other can select different building sets.\", \"columns\": [\"FCLT_BUILDING.BUILDING_TYPE\", \"FCLT_BUILDING.SITE\", \"FCLT_BUILDING_HIST.BUILDING_TYPE\", \"FCLT_BUILDING_HIST.SITE\", \"FCLT_BUILDING_HIST_1.BUILDING_TYPE\", \"FCLT_BUILDING_HIST_1.SITE\", \"FAC_BUILDING.BUILDING_TYPE\", \"FAC_BUILDING.SITE\"], \"comparisons\": [{\"dimension\": \"Time semantics\", \"differences\": \"FCLT_BUILDING/FAC_BUILDING columns hold the current classification (one value per building); FCLT_BUILDING_HIST(_1) columns hold the classification per fiscal period, so a building can appear with different types/sites across its history rows.\"}, {\"dimension\": \"Row multiplicity when filtering\", \"differences\": \"Filtering on the history columns multiplies result rows by the number of fiscal periods per building; filtering on the building-table columns keeps one row per building.\"}, {\"dimension\": \"Table family\", \"differences\": \"FCLT_* columns join the FCLT_* family via FCLT_BUILDING_KEY; FAC_BUILDING columns join the FAC_* family via FAC_BUILDING_KEY.\"}], \"decision_guide\": {\"Questions about current academic/residential buildings or buildings at a site (e.g. 'academic buildings at MIT')\": \"Prefer FCLT_BUILDING.BUILDING_TYPE and FCLT_BUILDING.SITE: one row per building, no period duplication.\", \"Questions explicitly referencing building history records or per-fiscal-period classification (e.g. 'buildings that were academic in the history', history-based room counts)\": \"Use FCLT_BUILDING_HIST.BUILDING_TYPE / FCLT_BUILDING_HIST.SITE so the filter applies to each historical record.\", \"Same classification questions inside the FAC_* family\": \"Use FAC_BUILDING.BUILDING_TYPE / FAC_BUILDING.SITE.\"}}], \"not_found\": []}"
