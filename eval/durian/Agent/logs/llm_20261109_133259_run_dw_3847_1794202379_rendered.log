    {
      "role": "tool",
      "tool_call_id": "call_191ea3ed78b34a27a326f717",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_1954\", \"name\": \"2019FA Chemistry TIP Subjects Windowed Min Enrollment with Department Subject Code Statistics\", \"desc\": \"For subjects offered in the term '2019FA' with more than 0 enrolled students, offered by the Chemistry department (Course 5), and only including courses that have course materials, show the subject title, offering department name, school name, department full name, and the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department name. Additionally, for the same department, provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the number of unique subject codes associated with its courses that are offered by degree-granting departments, but only include departments other than 'Mathematics' (Course 18). Also, for each of these departments, show the total number of courses offered by the department in the '2019FA' term that have at least one enrolled student and have course materials. Present the subject title, offering department name, school name, department full name, windowed minimum enrolled students, department name, average number of unique subject codes, standard deviation (using STDDEV only and never STDDEV_POP) of unique subject codes, and the total number of such courses, in that order. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.OFFER_SCHOOL_NAME, t1.DEPARTMENT_FULL_NAME, MIN(t0.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.DEPARTMENT_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT t2 ON t1.DEPARTMENT_CODE = t2.SIS_ADMIN_DEPARTMENT_CODE WHERE t0.TERM_CODE = '2019FA' AND t0.NUM_ENROLLED_STUDENTS > 0 AND t0.OFFER_DEPT_NAME = 'Chemistry' AND t0.IS_NO_COURSE_MATERIAL = 'N' ), course_counts AS ( SELECT t1.DEPARTMENT_CODE, COUNT(DISTINCT t0.MASTER_COURSE_NUMBER) AS total_courses FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2019FA' AND t0.NUM_ENROLLED_STUDENTS > 0 AND t0.IS_NO_COURSE_MATERIAL = 'N' GROUP BY t1.DEPARTMENT_CODE ), subject_code_stats AS ( SELECT d.DEPARTMENT_NAME, AVG(subj_count) AS avg_subject_codes, STDDEV(subj_count) AS stddev_subject_codes, d.DEPARTMENT_CODE FROM ( SELECT cd.DEPARTMENT, COUNT(DISTINCT sc.SUBJECT_CODE) AS subj_count FROM SIS_COURSE_DESCRIPTION cd JOIN SIS_DEPARTMENT d ON cd.DEPARTMENT = d.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE sc ON d.DEPARTMENT_CODE = sc.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_NAME != 'Mathematics' GROUP BY cd.COURSE, cd.DEPARTMENT ) course_subjects JOIN SIS_DEPARTMENT d ON course_subjects.DEPARTMENT = d.DEPARTMENT_CODE WHERE d.DEPARTMENT_CODE != '18' GROUP BY d.DEPARTMENT_NAME, d.DEPARTMENT_CODE ) SELECT icte.SUBJECT_TITLE, icte.OFFER_DEPT_NAME, icte.OFFER_SCHOOL_NAME, icte.DEPARTMENT_FULL_NAME, icte.window_column, scs.DEPARTMENT_NAME, scs.avg_subject_codes, scs.stddev_subject_codes, cc.total_courses FROM inner_cte icte JOIN subject_code_stats scs ON icte.DEPARTMENT_CODE = scs.DEPARTMENT_CODE JOIN course_counts cc ON icte.DEPARTMENT_CODE = cc.DEPARTMENT_CODE ORDER BY icte.SUBJECT_TITLE, scs.avg_subject_codes DESC\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per 2019FA Chemistry TIP subject with course materials matched with department-level subject code statistics\"}, {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Chemistry subject with materials per term\", \"desc\": \"For each subject offered by the Chemistry department (Course 5) that has course materials, provide the subject title, term code, offering department name, responsible faculty name, department full name, school name, and the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject offered key, along with the minimum academic year and average total units for the corresponding academic term in the Mathematics department, where the academic year is between 2000 and 2020 or the total units are at least 6, and the total units are between 1 and 12. Additionally, include the term description and the last day of final exam for each term from the academic terms table. The results should be listed in order by term code and subject title. Do not return any rounded answers.\", \"id\": \"dw_2560\", \"name\": \"Chemistry Subjects with Course Materials 3-Row Max Enrollment vs Math Term Unit Statistics with Final Exam Date\", \"sql\": \"WITH inner_cte AS ( WITH MathTermStats AS ( SELECT s.TERM_CODE, MIN(a.ACADEMIC_YEAR) AS min_academic_year, AVG(s.TOTAL_UNITS) AS avg_total_units FROM SUBJECT_SUMMARY s JOIN ACADEMIC_TERMS_ALL a ON s.TERM_CODE = a.TERM_CODE WHERE s.DEPARTMENT_NAME = 'Mathematics' AND s.TOTAL_UNITS BETWEEN 1 AND 12 AND ( a.ACADEMIC_YEAR BETWEEN 2000 AND 2020 OR s.TOTAL_UNITS >= 6 ) GROUP BY s.TERM_CODE ORDER BY s.TERM_CODE ), ChemistrySubjectStats AS ( SELECT t0.SUBJECT_TITLE, t0.TERM_CODE, t0.OFFER_DEPT_NAME, t0.RESPONSIBLE_FACULTY_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, MAX(t0.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t0.TIP_SUBJECT_OFFERED_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING ) AS max_num_enrolled_students FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.NUM_ENROLLED_STUDENTS >= 0 AND t0.TERM_CODE IS NOT NULL AND t0.OFFER_DEPT_NAME = 'Chemistry' AND t0.IS_NO_COURSE_MATERIAL = 'N' ) SELECT c.SUBJECT_TITLE, c.TERM_CODE, c.OFFER_DEPT_NAME, c.RESPONSIBLE_FACULTY_NAME, c.DEPARTMENT_FULL_NAME, c.SCHOOL_NAME, c.max_num_enrolled_students, m.min_academic_year, m.avg_total_units FROM ChemistrySubjectStats c JOIN MathTermStats m ON c.TERM_CODE = m.TERM_CODE ) SELECT i.SUBJECT_TITLE, i.TERM_CODE, i.OFFER_DEPT_NAME, i.RESPONSIBLE_FACULTY_NAME, i.DEPARTMENT_FULL_NAME, i.SCHOOL_NAME, i.max_num_enrolled_students, i.min_academic_year, i.avg_total_units, a.TERM_DESCRIPTION, a.LAST_DAY_OF_FINAL_EXAM FROM inner_cte i JOIN ACADEMIC_TERMS_ALL a ON i.TERM_CODE = a.TERM_CODE ORDER BY i.TERM_CODE, i.SUBJECT_TITLE;\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_345f1b54faad4c459e131cd5",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 30, \"items_by_type\": {\"metric\": [{\"id\": \"dw_4602\", \"desc\": \"Show the department full names, subject titles, total units, and the number of unique course materials per subject for subjects offered by departments in the School of Engineering. For each subject, also provide the material status key, term code, subject ID, ISBN, material key, course number description, offering department name, and the maximum number of enrolled students for each row considering the current row and the next 2 rows ordered by material key, where the subject title and department code match between the subject and course material datasets. Do not return any rounded answers.\"}, {\"id\": \"dw_3311\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\"}, {\"id\": \"dw_3668\", \"desc\": \"For subjects offered by departments in the School of Engineering, show the subject title, total units, department full name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Additionally, for each matching course material detail, provide the material status key, term code, subject ID, ISBN, material key, the course number description, the offering department name, and the maximum number of enrolled students for each row considering the current row and the next 2 rows ordered by material key. The results should include the subject title, total units, department full name, window row number, material status key, term code, subject ID, ISBN, material key, course number description, offering department name, and the maximum number of enrolled students, in that order, for subjects and course materials where the subject title and department code match between the two datasets. Do not return any rounded answers.\"}, {\"id\": \"dw_3398\", \"desc\": \"For each subject offered in the same term as a TIP detail record with material status 'RQ', show the subject key, subject title, offer department name, TIP material key, and the rank of each record within each offer department name group ordered by subject key, along with the subject title, subject ID, offer department name, offer school name, term description, academic year, and the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject key, where the subject, term, and offer department name match in both cases. List the columns in the following order: subject key, subject title, offer department name, TIP material key, rank, subject title (from the second subquery), subject ID, offer department name (from the second subquery), offer school name, term description, academic year, and the maximum number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_4650\", \"desc\": \"For each degree-granting department that offered at least one subject in the School of Engineering in 2021 and has more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the total number of tip materials, the average number of enrolled students per subject (rounded to two decimal places), and the ratio of total enrolled students to total tip materials (rounded to two decimal places), listing the results in descending order of the average number of enrolled students per subject.\"}, {\"id\": \"dw_3727\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, or for each department that offered more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of tip materials. List the department code, department name, department full name, number of subjects offered, total number of enrolled students, and total number of tip materials in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_3493\", \"desc\": \"For subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook, show the subject code, subject number, department name, subject title, term description, total units, the average subject enrollment number in a window of 2 preceding and 2 following rows grouped by department code and ordered by total units, the textbook material key, the textbook material status key, and the row number of the course within each department ordered by subject code. List the results in order by department name, subject code, and subject number. Do not return any rounded answers.\"}, {\"id\": \"dw_1758\", \"desc\": \"For subjects offered in the academic year 2024 with total units equal to 12 in the Mathematics department, show the department code, department name, subject code, subject number, subject title, total units, the row number within each department ordered by subject code, the deviation of each subject's total units from the average total units of all Mathematics subjects offered in 2024, the number of enrolled students, responsible faculty name, school name, and the dense rank over the department name ordered by department name for those subjects that also have course materials and were offered in the term '2019FA'. Sort the table by department name and subject title. Do not return any rounded answers.\"}, {\"id\": \"dw_4724\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\"}, {\"id\": \"dw_3868\", \"desc\": \"For each department in the School of Engineering where the total number of students enrolled in courses offered by that department is greater than the average total enrollment across all Engineering departments (and the total enrollment is greater than 50), show the department name and total enrollment, and for each such department, show the library reserve material details with material status key equal to 'U', including the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students, as well as the responsible faculty name and the offer department name, for materials offered by that department. The columns should be: department name, total enrollment, library course instructor key, library reserve catalog key, term code, subject ID, tip material key, tip material status key, tip ISBN, subject title, windowed minimum tip material status key, responsible faculty name, and offer department name. Do not return any rounded answers.\"}, {\"id\": \"dw_4756\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\"}, {\"id\": \"dw_3644\", \"desc\": \"For subjects offered in the 2012SU term with a total of 1 unit, show the subject title from the summary, the course number from the offered table, the subject title from the offered summary, the department name from the summary, the offer department name from the offered summary, the row number within each department name group ordered by subject title from the summary, and for each department, also provide the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student). List the results ordered by department name and row number. Do not return any rounded answers.\"}, {\"id\": \"dw_1393\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_2924\", \"desc\": \"For degree-granting courses in the School of Engineering, show the course description, department name, subject title, and the subject's grade type description, but only include those courses where the total units for the subject exceed the average total units for that department. Do not return any rounded answers.\"}, {\"id\": \"dw_4184\", \"desc\": \"For each department, show the offer department name, the number of distinct subjects offered by the department in the academic year 2012, and for each subject that was offered in the term \\\"2012SU\\\", display the subject key, subject title, academic year, term description, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, and the deviation of each subject's enrollment number from the average enrollment number for its subject key group, ordered by offer department name and subject key. Do not return any rounded answers.\"}, {\"id\": \"dw_2180\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, and for each academic year, also show the academic year and academic year description and the coefficient of variation (using STDDEV only and never STDDEV_POP) of the total units for subjects in the Mathematics department (Course 18) that have more than 0 total units and are offered in terms with a term status indicator of 'P'. Additionally, for each Chemistry subject, include the number of required TIP materials (where TIP_MATERIAL_STATUS_KEY = 'RQ') for that subject in that term. Do not return any rounded answers.\"}, {\"id\": \"dw_2597\", \"desc\": \"For each academic year, what is the description of the academic year, the department name, the average total units for all subjects offered by that department in terms that match that academic year and have a term status indicator of 'P', and the deviation of each department's average total units from the overall average total units for that academic year? Do not return any rounded answers.\"}, {\"id\": \"dw_2158\", \"desc\": \"For each subject offered in the 2022 academic year by a degree-granting department, specifically in the Department of Mathematics (Course 18) and excluding subjects offered by the Department of Physics, provide the subject ID, subject title, department name, the number of enrolled students, the total number of lecture units, and, for each subject, indicate whether it is also offered as a joint subject with another department. Additionally, show the range and variance of the total units for letter graded subjects offered this year in the Mathematics department. List the results in order of subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_3078\", \"desc\": \"For each subject title and department name where the total units are greater than 3, give the number of offered sections, the minimum number of enrolled students, and the average lab units for those subjects. Do not return any rounded answers.\"}, {\"id\": \"dw_3356\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', what are the subject title, the offering department name, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only departments that grant degrees and subjects with a non-null subject code description), and the count of reserved materials? Please provide the subject title, the offering department name, the variance, the standard deviation (using STDDEV only and never STDDEV_POP), and the count of reserved materials, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_4738\", \"desc\": \"For each subject offered in the term with the description \\\"Fall Term 2024-2025\\\", show the subject ID, subject title, offering department name, term description, and the rank of the subject within its offering department. For each tip detail record where the material status key is 'RQ', show the subject ID, term description, term start date, tip material key, and the average record count in a window of 2 preceding and 2 following rows grouped by the financial aid year. Additionally, for each subject offered in \\\"Fall Term 2024-2025\\\", include the academic year description from the academic terms table. Indicate the source of each row as either 'SubjectOffered' or 'TipDetail'. The results should be ordered by subject ID and source. Do not return any rounded answers.\"}, {\"id\": \"dw_4812\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_4448\", \"desc\": \"For each department, show the department name, the highest total units among its subjects with exactly 12 units in the Fall Term 2024-2025, and for each course in that department that was offered in 2022 and has at least one required or optional textbook and has total units greater than the average for such courses, show the course's subject code, subject number, subject title, the term description, the textbook material key, the textbook material status key, and the row number within the department ordered by subject code. Do not return any rounded answers.\"}, {\"id\": \"dw_2151\", \"desc\": \"For each department that grants degrees (excluding the Biology department), provide the department name, the average and variance of the total units for subjects offered by that department in the 2022 academic year, and, if the department is Political Science, also include for each HGN code the maximum number of lecture units among all subjects in the course catalog and the subject title from the subject offered table for subjects offered in the year 2012 with more than 2 lecture units, as well as the number of enrolled students for those subjects. List the results ordered by the variance of total units in descending order, and for Political Science, by the maximum lecture units in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_3989\", \"desc\": \"For each department and each subject offered in the academic year 2024, show the department name, subject code, subject number, subject title, term code, term description, and the highest minimum total units (in a window of 3 preceding and 1 following row ordered by academic year) for that subject, along with the course description, subject code description, and the difference between the number of characters in the course description and the average number of characters in course descriptions for that department, for courses in the School of Engineering that are degree granting. Do not return any rounded answers.\"}, {\"id\": \"dw_3357\", \"desc\": \"For each library reserve material detail with material status key 'U', show the reserve catalog key, subject offered key, term code, academic year, term description, tip material key, tip material status key, and the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, along with the corresponding textbook material in the TIP_DETAIL table with material status key 'RQ' that matches on tip material key and academic year, showing the textbook subject offered key, textbook material key, subject ID, textbook academic year, textbook term description, and the row number within each textbook academic year group ordered by term code. Present the results in the order of reserve material academic year descending and textbook row number. Do not return any rounded answers.\"}, {\"id\": \"dw_4701\", \"desc\": \"For each academic year, what is the academic year, academic year description, the geometric mean of the number of library reserve material details per subject offered (considering only records where the material status is 'U' and the academic term is a regular term), the average total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the average number of design units for subjects that are offered in the fall term and have a material status of 'U' in the library reserve? List the results ordered by the geometric mean of materials per subject in descending order, then by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_1335\", \"desc\": \"List, for each department, either (a) the department's full name, the range and variance of the total units for degree-granting Mathematics department courses offered in the 2008 academic year along with the long course description for each course (with the reason 'Math 2008 Stats'), or (b) the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units) where the average total units is greater than the overall average across all departments (with the reason 'High Avg Units'). Show the columns in the following order: department name, total units range, total units variance, average total units, standard deviation (using STDDEV only and never STDDEV_POP) of total units, long course description, and reason for inclusion. Do not return any rounded answers.\"}, {\"id\": \"dw_4287\", \"desc\": \"For each library reserve material detail with material status key equal to 'U' and for subjects offered in the term with code '2025FA', show the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title from the subject offered table, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students (only including those where the number of enrolled students is greater than the average across all subjects), the offering department name, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, the offering school name, and the responsible faculty name for each subject. Order the results by offering department and descending number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_3664\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', display each subject title, the offering department name, the count of reserved materials, the academic year, the department name, the average of the total units, and the variance of the total units for subjects offered in regular terms, with the columns shown in that order. Do not return any rounded answers.\"}]}}"
