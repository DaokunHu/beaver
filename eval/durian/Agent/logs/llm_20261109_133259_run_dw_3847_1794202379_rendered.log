    {
      "role": "tool",
      "tool_call_id": "call_94307ff72af6410e8cfc6b58",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics department combining subject unit statistics with graduate student counts\", \"desc\": \"For the Mathematics department (Course 18), provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student), the number of graduate students in the department, and the most recent warehouse load date for those students, considering only departments that are degree granting and students whose year is 'G'. Do not return any rounded answers.\", \"id\": \"dw_1212\", \"name\": \"Math Department Subject Unit Average-Stddev with Graduate Student Count and Latest Load Date\", \"sql\": \"WITH DeptUnits AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_total_units, STDDEV(s.TOTAL_UNITS) AS stddev_total_units FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.TOTAL_UNITS > 0 AND s.NUM_ENROLLED_STUDENTS >= 1 AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME ORDER BY stddev_total_units DESC ), DeptStudents AS ( SELECT sd.DEPARTMENT_NAME, COUNT(msd.FULL_NAME) AS student_count, MAX(msd.WAREHOUSE_LOAD_DATE) AS latest_student_load FROM SIS_DEPARTMENT sd JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT JOIN SIS_ADMIN_DEPARTMENT sad ON msd.DEPARTMENT = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND msd.STUDENT_YEAR = 'G' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_NAME ORDER BY student_count DESC LIMIT 10 ) SELECT du.DEPARTMENT_NAME, du.avg_total_units, du.stddev_total_units, ds.student_count, ds.latest_student_load FROM DeptUnits du JOIN DeptStudents ds ON du.DEPARTMENT_NAME = ds.DEPARTMENT_NAME;\"}, {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Chemistry subject with materials per term\", \"desc\": \"For each subject offered by the Chemistry department (Course 5) that has course materials, show the subject title, term code, offering department name, responsible faculty name, department full name, school name, the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject offered key, along with the minimum academic year and average total units for the corresponding academic term in the Mathematics department, where the academic year is between 2000 and 2020 or the total units are at least 6, and the total units are between 1 and 12. Also, include the term description and the first day of classes for each term from the academic terms table. The results are ordered by term code and subject title. Do not return any rounded answers.\", \"id\": \"dw_2181\", \"name\": \"Chemistry Subjects with Course Materials 3-Row Max Enrollment vs Math Term Unit Statistics\", \"sql\": \"WITH inner_cte AS ( WITH MathTermStats AS ( SELECT s.TERM_CODE, MIN(a.ACADEMIC_YEAR) AS min_academic_year, AVG(s.TOTAL_UNITS) AS avg_total_units FROM SUBJECT_SUMMARY s JOIN ACADEMIC_TERMS_ALL a ON s.TERM_CODE = a.TERM_CODE WHERE s.DEPARTMENT_NAME = 'Mathematics' AND s.TOTAL_UNITS BETWEEN 1 AND 12 AND ( a.ACADEMIC_YEAR BETWEEN 2000 AND 2020 OR s.TOTAL_UNITS >= 6 ) GROUP BY s.TERM_CODE ORDER BY s.TERM_CODE ), ChemistrySubjectStats AS ( SELECT t0.SUBJECT_TITLE, t0.TERM_CODE, t0.OFFER_DEPT_NAME, t0.RESPONSIBLE_FACULTY_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, MAX(t0.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t0.TIP_SUBJECT_OFFERED_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING ) AS max_num_enrolled_students FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.NUM_ENROLLED_STUDENTS >= 0 AND t0.TERM_CODE IS NOT NULL AND t0.OFFER_DEPT_NAME = 'Chemistry' AND t0.IS_NO_COURSE_MATERIAL = 'N' ) SELECT css.SUBJECT_TITLE, css.TERM_CODE, css.OFFER_DEPT_NAME, css.RESPONSIBLE_FACULTY_NAME, css.DEPARTMENT_FULL_NAME, css.SCHOOL_NAME, css.max_num_enrolled_students, mts.min_academic_year, mts.avg_total_units FROM ChemistrySubjectStats css JOIN MathTermStats mts ON css.TERM_CODE = mts.TERM_CODE ) SELECT ic.SUBJECT_TITLE, ic.TERM_CODE, ic.OFFER_DEPT_NAME, ic.RESPONSIBLE_FACULTY_NAME, ic.DEPARTMENT_FULL_NAME, ic.SCHOOL_NAME, ic.max_num_enrolled_students, ic.min_academic_year, ic.avg_total_units, at.TERM_DESCRIPTION, at.FIRST_DAY_OF_CLASSES FROM inner_cte ic JOIN ACADEMIC_TERMS at ON ic.TERM_CODE = at.TERM_CODE ORDER BY ic.TERM_CODE, ic.SUBJECT_TITLE\"}, {\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per subject with textbooks\", \"desc\": \"For subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook, show the subject code, subject number, department name, subject title, term description, total units, the average subject enrollment number in a window of 2 preceding and 2 following rows grouped by department code and ordered by total units, the textbook material key, the textbook material status key, and the row number of the course within each department ordered by subject code. List the results in order by department name, subject code, and subject number. Do not return any rounded answers.\", \"id\": \"dw_3493\", \"name\": \"2022 12-Unit Subjects with Required or Optional Textbooks and Enrollment Windows\", \"sql\": \"WITH SubjectUnitsWindow AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ), CourseTextbookWindow AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t2.TIP_MATERIAL_KEY, t2.TIP_MATERIAL_STATUS_KEY, ROW_NUMBER() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.ACADEMIC_YEAR = 2022 AND t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') ) SELECT s.SUBJECT_CODE, s.SUBJECT_NUMBER, s.DEPARTMENT_NAME, s.SUBJECT_TITLE, s.TERM_DESCRIPTION, s.TOTAL_UNITS, s.window_column AS avg_enrollment_window, c.TIP_MATERIAL_KEY, c.TIP_MATERIAL_STATUS_KEY, c.window_column AS textbook_row_number FROM SubjectUnitsWindow s JOIN CourseTextbookWindow c ON s.SUBJECT_CODE = c.SUBJECT_CODE AND s.SUBJECT_NUMBER = c.SUBJECT_NUMBER AND s.DEPARTMENT_NAME = c.DEPARTMENT_NAME AND s.SUBJECT_TITLE = c.SUBJECT_TITLE AND s.TERM_DESCRIPTION = c.TERM_DESCRIPTION AND s.TERM_CODE = c.TERM_CODE AND s.SUBJECT_ID = c.SUBJECT_ID ORDER BY s.DEPARTMENT_NAME, s.SUBJECT_CODE, s.SUBJECT_NUMBER;\"}], \"not_found\": []}"
