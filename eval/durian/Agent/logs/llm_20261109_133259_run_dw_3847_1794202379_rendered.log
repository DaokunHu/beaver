      "tool_call_id": "call_cdeed8089e2f4ad39781a4a8",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_1689\", \"name\": \"School Highest Department Average TIP Enrollment with 2019FA Chemistry Course-Material Subject Dense Ranks\", \"desc\": \"For each school, what is the school name and the highest average number of enrolled students per department (among its degree-granting departments, excluding Chemistry, and only considering subjects with at least one enrolled student), and for each subject offered by the Chemistry department in the 2019FA term that has course materials, what is the subject title, the dense rank of the subject considering the current and 2 preceding rows ordered by the number of enrolled students descending, the full name of the offering department, and the school name of the Chemistry department? List the school name and highest average enrolled students per department first, followed by the Chemistry subject title, dense rank, department full name, and Chemistry school name. Do not return any rounded answers.\", \"sql\": \"WITH dept_enrollment_stats AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, AVG(tso.NUM_ENROLLED_STUDENTS) AS avg_enrolled, MAX(tso.NUM_ENROLLED_STUDENTS) - MIN(tso.NUM_ENROLLED_STUDENTS) AS range_enrolled, VARIANCE(tso.NUM_ENROLLED_STUDENTS) AS var_enrolled FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 AND tso.OFFER_DEPT_NAME <> 'Chemistry' GROUP BY sd.DEPARTMENT_NAME, sd.SCHOOL_NAME ), school_max_avg_enrollment AS ( SELECT SCHOOL_NAME, MAX(avg_enrolled) AS highest_avg_enrolled_per_dept FROM dept_enrollment_stats GROUP BY SCHOOL_NAME ), chemistry_subjects_ranked AS ( SELECT inner_cte.SUBJECT_TITLE, inner_cte.dense_rank_num_enrolled, inner_cte.DEPARTMENT_FULL_NAME, sd.SCHOOL_NAME FROM ( SELECT tso.SUBJECT_TITLE, DENSE_RANK() OVER ( ORDER BY tso.NUM_ENROLLED_STUDENTS DESC ROWS BETWEEN 2 PRECEDING AND CURRENT ROW ) AS dense_rank_num_enrolled, sd.DEPARTMENT_FULL_NAME, tso.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED tso JOIN STUDENT_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE WHERE tso.TERM_CODE = '2019FA' AND tso.OFFER_DEPT_NAME = 'Chemistry' AND tso.IS_NO_COURSE_MATERIAL = 'N' ) inner_cte JOIN STUDENT_DEPARTMENT sd ON inner_cte.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE ) SELECT smax.SCHOOL_NAME, smax.highest_avg_enrolled_per_dept, csr.SUBJECT_TITLE, csr.dense_rank_num_enrolled, csr.DEPARTMENT_FULL_NAME, csr.SCHOOL_NAME AS chemistry_school_name FROM school_max_avg_enrollment smax CROSS JOIN chemistry_subjects_ranked csr;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per school-level highest department average enrollment cross joined with each 2019FA Chemistry TIP subject having course materials\"}, {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Chemistry subject with materials per term\", \"desc\": \"For each subject offered by the Chemistry department (Course 5) that has course materials, show the subject title, term code, offering department name, responsible faculty name, department full name, school name, the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject offered key, along with the minimum academic year and average total units for the corresponding academic term in the Mathematics department, where the academic year is between 2000 and 2020 or the total units are at least 6, and the total units are between 1 and 12. Also, include the term description and the first day of classes for each term from the academic terms table. The results are ordered by term code and subject title. Do not return any rounded answers.\", \"id\": \"dw_2181\", \"name\": \"Chemistry Subjects with Course Materials 3-Row Max Enrollment vs Math Term Unit Statistics\", \"sql\": \"WITH inner_cte AS ( WITH MathTermStats AS ( SELECT s.TERM_CODE, MIN(a.ACADEMIC_YEAR) AS min_academic_year, AVG(s.TOTAL_UNITS) AS avg_total_units FROM SUBJECT_SUMMARY s JOIN ACADEMIC_TERMS_ALL a ON s.TERM_CODE = a.TERM_CODE WHERE s.DEPARTMENT_NAME = 'Mathematics' AND s.TOTAL_UNITS BETWEEN 1 AND 12 AND ( a.ACADEMIC_YEAR BETWEEN 2000 AND 2020 OR s.TOTAL_UNITS >= 6 ) GROUP BY s.TERM_CODE ORDER BY s.TERM_CODE ), ChemistrySubjectStats AS ( SELECT t0.SUBJECT_TITLE, t0.TERM_CODE, t0.OFFER_DEPT_NAME, t0.RESPONSIBLE_FACULTY_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, MAX(t0.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t0.TIP_SUBJECT_OFFERED_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING ) AS max_num_enrolled_students FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.NUM_ENROLLED_STUDENTS >= 0 AND t0.TERM_CODE IS NOT NULL AND t0.OFFER_DEPT_NAME = 'Chemistry' AND t0.IS_NO_COURSE_MATERIAL = 'N' ) SELECT css.SUBJECT_TITLE, css.TERM_CODE, css.OFFER_DEPT_NAME, css.RESPONSIBLE_FACULTY_NAME, css.DEPARTMENT_FULL_NAME, css.SCHOOL_NAME, css.max_num_enrolled_students, mts.min_academic_year, mts.avg_total_units FROM ChemistrySubjectStats css JOIN MathTermStats mts ON css.TERM_CODE = mts.TERM_CODE ) SELECT ic.SUBJECT_TITLE, ic.TERM_CODE, ic.OFFER_DEPT_NAME, ic.RESPONSIBLE_FACULTY_NAME, ic.DEPARTMENT_FULL_NAME, ic.SCHOOL_NAME, ic.max_num_enrolled_students, ic.min_academic_year, ic.avg_total_units, at.TERM_DESCRIPTION, at.FIRST_DAY_OF_CLASSES FROM inner_cte ic JOIN ACADEMIC_TERMS at ON ic.TERM_CODE = at.TERM_CODE ORDER BY ic.TERM_CODE, ic.SUBJECT_TITLE\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per department/school enrollment statistic (plus per-school rollup rows), left joined with Mathematics students named Peter\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\", \"id\": \"dw_1350\", \"name\": \"Degree-Granting Department TIP Enrollment Statistics with School Rollups and Math Peter Student Budget Code Windows\", \"sql\": \"WITH inner_cte1 AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, tso.NUM_ENROLLED_STUDENTS FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 ), DepartmentStats AS ( SELECT DEPARTMENT_NAME, SCHOOL_NAME, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled_students, MAX(NUM_ENROLLED_STUDENTS) - MIN(NUM_ENROLLED_STUDENTS) AS range_enrolled_students, VARIANCE(NUM_ENROLLED_STUDENTS) AS var_enrolled_students, SUM(NUM_ENROLLED_STUDENTS) AS total_enrolled_students FROM inner_cte1 GROUP BY DEPARTMENT_NAME, SCHOOL_NAME ), SchoolRollup AS ( SELECT NULL AS DEPARTMENT_NAME, SCHOOL_NAME, NULL AS avg_enrolled_students, NULL AS range_enrolled_students, NULL AS var_enrolled_students, SUM(total_enrolled_students) AS total_enrolled_students FROM DepartmentStats GROUP BY SCHOOL_NAME ), inner_cte2 AS ( SELECT t1.LAST_NAME, t1.EMAIL_ADDRESS, t1.STUDENT_YEAR, t1.DEPARTMENT_NAME, t0.SCHOOL_NAME, MIN(t0.DEPT_BUDGET_CODE) OVER (ORDER BY t1.FULL_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_DEPARTMENT t0 JOIN MIT_STUDENT_DIRECTORY t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT WHERE t1.FIRST_NAME = 'Peter' AND t0.DEPARTMENT_NAME = 'Mathematics' ) SELECT ds.DEPARTMENT_NAME, ds.SCHOOL_NAME, ds.avg_enrolled_students, ds.range_enrolled_students, ds.var_enrolled_students, ds.total_enrolled_students, ic2.LAST_NAME, ic2.EMAIL_ADDRESS, ic2.STUDENT_YEAR, ic2.window_column, sd.DEPARTMENT_FULL_NAME, sd.DEPARTMENT_LAST_ACTIVITY_DATE FROM (SELECT * FROM DepartmentStats UNION ALL SELECT * FROM SchoolRollup) ds LEFT JOIN inner_cte2 ic2 ON ds.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME AND ds.SCHOOL_NAME = ic2.SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON ds.DEPARTMENT_NAME = sd.DEPARTMENT_NAME ORDER BY ds.SCHOOL_NAME, ds.DEPARTMENT_NAME, ic2.LAST_NAME ;\"}], \"not_found\": []}"
    },
