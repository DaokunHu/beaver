      "content": "{\"ok\": true, \"entities\": [{\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}, {\"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"columns\": {\"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject summary record\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, COURSE_CATALOG_SUBJECT_OFFERED subject IDs\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SUBJECT_OR_CLUSTER\": {\"desc\": \"Indicator whether the row represents a subject or a cluster\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"ULT_MASTER_SUBJECT_ID\": {\"desc\": \"Ultimate master subject identifier in cluster hierarchies\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics'\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name, e.g. 'Engineering'\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREP_UNITS\": {\"desc\": \"Preparation credit units (named PREP_UNITS here vs PREPARATION_UNITS in other tables)\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the subject\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the cluster\"}, \"SUBJECT_GROUP_ID\": {\"desc\": \"Subject group identifier used for grouping related subjects\"}, \"SUBJECT_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Subject enrollment in the first week\"}, \"CLUSTER_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Cluster enrollment in the first week\"}, \"SUBJECT_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Subject enrollment in the fifth week\"}, \"CLUSTER_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Cluster enrollment in the fifth week\"}, \"SUBJECT_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the subject for credit\"}, \"SUBJECT_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the subject\"}, \"CLUSTER_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the cluster for credit\"}, \"CLUSTER_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the cluster\"}, \"SUBJECT_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the cluster\"}, \"SUBJECT_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the TIP subject offered record; joins to TIP_DETAIL.TIP_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"IS_NO_COURSE_MATERIAL\": {\"desc\": \"'Y'/'N' flag whether the subject has no course material; 'N' means the subject has course materials\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '5.01'; joins to TIP_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE and STUDENT_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Chemistry', 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject; used for enrollment-based rankings and window statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in the textbook program\"}, {\"id\": \"TIP_DETAIL\", \"name\": \"TIP_DETAIL\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Foreign key to TIP_SUBJECT_OFFERED.TIP_SUBJECT_OFFERED_KEY\"}, \"TIP_MATERIAL_KEY\": {\"desc\": \"Foreign key to TIP_MATERIAL.TIP_MATERIAL_KEY identifying the specific textbook material\"}, \"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB'/blank keys with no description. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_SUBJECT_OFFERED.SUBJECT_ID, LIBRARY_SUBJECT_OFFERED.SUBJECT_ID, SUBJECT_SUMMARY.SUBJECT_ID\"}, \"ISBN\": {\"desc\": \"ISBN of the textbook material associated with the subject offering\"}, \"RECORD_COUNT\": {\"desc\": \"Number of material records for this subject/material combination; used in material-count statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject-material-status combination per term\", \"entity\": {\"columns\": {\"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB' = None variants. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}}}, \"reason\": \"Data verification of TIP_MATERIAL_STATUS shows 12 status values beyond the previously documented 'RQ'/'EO'; enriching the description supports material-status grouping questions such as case dw_2989 (per material status and publisher statistics).\"}, {\"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS_ALL.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2025FA' (FA=Fall, SP=Spring, JA=January/IAP, SU=Summer)\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description, e.g. 'Fall Term 2024-2025'\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date; can match TIME_DAY.CALENDAR_DATE for calendar-based joins\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to, e.g. 2025\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"IS_REGULAR_TERM\": {\"desc\": \"'Y'/'N' flag indicating a regular term (Fall/Spring) versus non-regular terms (Summer, January/IAP); only present in ACADEMIC_TERMS, not in ACADEMIC_TERMS_ALL\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"TERM_STATUS\": {\"desc\": \"Term status text: 'Previous', 'Current', 'Future', or 'Unspecified'\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to; used in degree-year statistics\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"ADD_DATE\": {\"desc\": \"Last day to add a subject in the term; only present in ACADEMIC_TERMS\"}, \"DROP_DATE\": {\"desc\": \"Last day to drop a subject in the term; only present in ACADEMIC_TERMS\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period for the term\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period for the term\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_1aad0f33c1d44e1fb7091419",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per subject\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units that are also offered in the library by the Mathematics department during regular terms, show the subject code, subject number, subject title, department name, term description, the rank of each subject within its department ordered by subject code, the number of enrolled students, offering department name, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Do not return any rounded answers.\", \"id\": \"dw_3248\", \"name\": \"2024 12-Unit Subjects Matched with Math Library Regular-Term Offerings and 3-Row Max Units\", \"sql\": \"WITH Subjects2024_12Units AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.SUBJECT_TITLE, t0.DEPARTMENT_NAME, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.EFFECTIVE_TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2024 AND t0.TOTAL_UNITS = 12 ), MathLibrarySubjects AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t2.SUBJECT_SHORT_TITLE, MAX(t2.TOTAL_UNITS) OVER (ORDER BY t0.SUBJECT_ID ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_total_units, t0.SUBJECT_ID FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t1.IS_REGULAR_TERM = 'Y' ) SELECT s.SUBJECT_CODE, s.SUBJECT_NUMBER, s.SUBJECT_TITLE, s.DEPARTMENT_NAME, s.TERM_DESCRIPTION, s.window_column, m.NUM_ENROLLED_STUDENTS, m.OFFER_DEPT_NAME, m.ACADEMIC_YEAR, m.SUBJECT_SHORT_TITLE, m.max_total_units FROM Subjects2024_12Units s JOIN MathLibrarySubjects m ON s.SUBJECT_ID = m.SUBJECT_ID ORDER BY s.DEPARTMENT_NAME, s.SUBJECT_CODE, m.NUM_ENROLLED_STUDENTS DESC\"}, {\"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per 2024 subject paired with same-department 2019FA subject\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units, and for subjects offered in the term 2019FA from the same department, show the subject code, subject number, subject title, department name, term description, the rank of each 2024 subject within its department ordered by subject code, the 2019FA subject ID, number of enrolled students in 2019FA, department full name, and the row number of each 2019FA subject within its department name group ordered by subject ID. Order the results by department name, subject code, and 2019FA subject ID. Do not return any rounded answers.\", \"id\": \"dw_3635\", \"name\": \"2024 12-Unit Subjects Matched with Same-Department 2019FA Offerings and Enrollment\", \"sql\": \"WITH Subjects2024_12Units AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.SUBJECT_TITLE, t0.DEPARTMENT_NAME, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.EFFECTIVE_TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2024 AND t0.TOTAL_UNITS = 12 ), Subjects2019FA AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t1.DEPARTMENT_NAME, t1.DEPARTMENT_FULL_NAME, ROW_NUMBER() OVER (PARTITION BY t1.DEPARTMENT_NAME ORDER BY t0.SUBJECT_ID) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2019FA' ) SELECT s24.SUBJECT_CODE, s24.SUBJECT_NUMBER, s24.SUBJECT_TITLE, s24.DEPARTMENT_NAME, s24.TERM_DESCRIPTION, s24.window_column AS department_rank_2024, s19.SUBJECT_ID, s19.NUM_ENROLLED_STUDENTS, s19.DEPARTMENT_FULL_NAME, s19.window_column AS department_rownum_2019 FROM Subjects2024_12Units s24 JOIN Subjects2019FA s19 ON s24.DEPARTMENT_NAME = s19.DEPARTMENT_NAME ORDER BY s24.DEPARTMENT_NAME, s24.SUBJECT_CODE, s19.SUBJECT_ID;\"}, {\"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2024 Mathematics 12-unit subject matched with 2019FA TIP offering\", \"desc\": \"For subjects offered in the academic year 2024 with total units equal to 12 in the Mathematics department, show the department code, department name, subject code, subject number, subject title, total units, the row number within each department ordered by subject code, the deviation of each subject's total units from the average total units of all Mathematics subjects offered in 2024, the number of enrolled students, responsible faculty name, school name, and the dense rank over the department name ordered by department name for those subjects that also have course materials and were offered in the term '2019FA'. Sort the table by department name and subject title. Do not return any rounded answers.\", \"id\": \"dw_1758\", \"name\": \"Math 2024 12-Unit Subjects Row Numbers and Unit Deviations Matched with 2019FA TIP Course-Material Offerings\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.DEPARTMENT_CODE, t0.DEPARTMENT_NAME, t1.SUBJECT_CODE, t1.SUBJECT_NUMBER, t1.SUBJECT_TITLE, t1.TOTAL_UNITS, ROW_NUMBER() OVER (PARTITION BY t0.DEPARTMENT_CODE ORDER BY t1.SUBJECT_CODE) AS window_column FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t1.ACADEMIC_YEAR = 2024 AND t1.TOTAL_UNITS = 12 AND t0.DEPARTMENT_NAME = 'Mathematics' ), math_avg AS ( SELECT t0.DEPARTMENT_CODE, AVG(t1.TOTAL_UNITS) AS avg_total_units FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t1.ACADEMIC_YEAR = 2024 AND t0.DEPARTMENT_NAME = 'Mathematics' GROUP BY t0.DEPARTMENT_CODE ) SELECT i.DEPARTMENT_CODE, i.DEPARTMENT_NAME, i.SUBJECT_CODE, i.SUBJECT_NUMBER, i.SUBJECT_TITLE, i.TOTAL_UNITS, i.window_column, (i.TOTAL_UNITS - m.avg_total_units) AS deviation_from_avg FROM inner_cte i JOIN math_avg m ON i.DEPARTMENT_CODE = m.DEPARTMENT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t1.DEPARTMENT_NAME, t1.SCHOOL_NAME, DENSE_RANK() OVER (PARTITION BY t1.DEPARTMENT_NAME ORDER BY t1.DEPARTMENT_NAME) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_COURSE_DESCRIPTION t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT WHERE t0.TERM_CODE = '2019FA' AND t1.DEPARTMENT_NAME = 'Mathematics' AND t0.IS_NO_COURSE_MATERIAL = 'N' ) SELECT CASE WHEN LAG(DEPARTMENT_NAME) OVER (ORDER BY DEPARTMENT_NAME, SUBJECT_TITLE) = DEPARTMENT_NAME THEN NULL ELSE DEPARTMENT_NAME END AS department_name, SUBJECT_TITLE, NUM_ENROLLED_STUDENTS, RESPONSIBLE_FACULTY_NAME, SCHOOL_NAME, window_column FROM inner_cte ORDER BY DEPARTMENT_NAME, SUBJECT_TITLE ) SELECT s1.DEPARTMENT_CODE, s1.DEPARTMENT_NAME, s1.SUBJECT_CODE, s1.SUBJECT_NUMBER, s1.SUBJECT_TITLE, s1.TOTAL_UNITS, s1.window_column AS subject_row_number, s1.deviation_from_avg, s2.NUM_ENROLLED_STUDENTS, s2.RESPONSIBLE_FACULTY_NAME, s2.SCHOOL_NAME, s2.window_column AS department_dense_rank FROM subq1 s1 LEFT JOIN subq2 s2 ON s1.DEPARTMENT_NAME = s2.department_name AND s1.SUBJECT_TITLE = s2.SUBJECT_TITLE ORDER BY s1.DEPARTMENT_NAME, s1.SUBJECT_TITLE;\"}, {\"id\": \"dw_3644\", \"name\": \"2012SU 1-Unit Subject Row Numbers per Department with Department Offered Summary Unit Average-Stddev\", \"desc\": \"For subjects offered in the 2012SU term with a total of 1 unit, show the subject title from the summary, the course number from the offered table, the subject title from the offered summary, the department name from the summary, the offer department name from the offered summary, the row number within each department name group ordered by subject title from the summary, and for each department, also provide the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student). List the results ordered by department name and row number. Do not return any rounded answers.\", \"sql\": \"WITH subq1 AS ( SELECT t2.SUBJECT_TITLE AS summary_subject_title, t1.COURSE_NUMBER, t0.SUBJECT_TITLE AS offered_summary_subject_title, t2.DEPARTMENT_NAME, t0.OFFER_DEPT_NAME, ROW_NUMBER() OVER (PARTITION BY t2.DEPARTMENT_NAME ORDER BY t2.SUBJECT_TITLE) AS window_column FROM SUBJECT_OFFERED_SUMMARY t0 JOIN SUBJECT_OFFERED t1 ON t0.SUBJECT_ID_SORT = t1.SUBJECT_ID_SORT JOIN SUBJECT_SUMMARY t2 ON t1.SUBJECT_ID_SORT = t2.SUBJECT_ID_SORT WHERE t1.TERM_CODE = '2012SU' AND t2.TOTAL_UNITS = 1 ), subq2 AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_total_units, STDDEV(s.TOTAL_UNITS) AS stddev_total_units FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.TOTAL_UNITS > 0 AND s.NUM_ENROLLED_STUDENTS >= 1 GROUP BY d.DEPARTMENT_NAME ORDER BY stddev_total_units DESC ) SELECT subq1.summary_subject_title, subq1.COURSE_NUMBER, subq1.offered_summary_subject_title, subq1.DEPARTMENT_NAME, subq1.OFFER_DEPT_NAME, subq1.window_column, subq2.avg_total_units, subq2.stddev_total_units FROM subq1 LEFT JOIN subq2 ON subq1.DEPARTMENT_NAME = subq2.DEPARTMENT_NAME ORDER BY subq1.DEPARTMENT_NAME, subq1.window_column;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2012SU 1-unit subject (via SUBJECT_ID_SORT chain across offering tables) left joined with its department's total-units average and standard deviation\"}], \"not_found\": []}"
    },
    {
