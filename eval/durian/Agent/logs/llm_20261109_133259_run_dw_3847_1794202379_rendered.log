      "role": "tool",
      "tool_call_id": "call_7d93f816e20f4bd7b2acef31",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"name\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"desc\": \"Library reserve material detail bridge table linking reserve catalog items, library subject offerings, course instructors, and material status per term. Used to count reserved materials per subject and to filter by library material status (e.g. 'U').\", \"columns\": {\"LIBRARY_COURSE_INSTRUCTOR_KEY\": {\"desc\": \"Foreign key to LIBRARY_COURSE_INSTRUCTOR.LIBRARY_COURSE_INSTRUCTOR_KEY identifying the course instructor\"}, \"LIBRARY_RESERVE_CATALOG_KEY\": {\"desc\": \"Foreign key to LIBRARY_RESERVE_CATALOG.LIBRARY_RESERVE_CATALOG_KEY identifying the reserve catalog item\"}, \"LIBRARY_SUBJECT_OFFERED_KEY\": {\"desc\": \"Foreign key to LIBRARY_SUBJECT_OFFERED.LIBRARY_SUBJECT_OFFERED_KEY identifying the subject offering\"}, \"LIBRARY_MATERIAL_STATUS_KEY\": {\"desc\": \"Library material status key; joins to LIBRARY_MATERIAL_STATUS.LIBRARY_MATERIAL_STATUS_KEY for decoding. Value domain (key = code): 'U' = Unknown, 'R' = (null description), 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material. Distinct from TIP_DETAIL.TIP_MATERIAL_STATUS_KEY, which belongs to the textbook program domain.\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per reserve material per subject offering per term\"}, {\"id\": \"LIBRARY_MATERIAL_STATUS\", \"name\": \"LIBRARY_MATERIAL_STATUS\", \"desc\": \"Library material status lookup table decoding library material status keys/codes used in LIBRARY_RESERVE_MATRL_DETAIL. Holds six statuses where key and code are identical: 'U' = Unknown, 'R' = (null description), 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material.\", \"columns\": {\"LIBRARY_MATERIAL_STATUS_KEY\": {\"desc\": \"Surrogate key; joins to LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY\"}, \"LIBRARY_MATERIAL_STATUS_CODE\": {\"desc\": \"Library material status code, e.g. 'U'\"}, \"LIBRARY_MATERIAL_STATUS\": {\"desc\": \"Library material status description text: 'Unknown' (U), 'Non-Required Course Material' (N), 'Reserve only' (O), 'No Required Textbook' (X), 'Required Course Material' (Y); NULL for key 'R'. Grouping by this column merges statuses sharing the same description.\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per library material status\"}, {\"id\": \"TIP_MATERIAL_STATUS\", \"name\": \"TIP_MATERIAL_STATUS\", \"desc\": \"TIP material status lookup table decoding material status keys/codes used in TIP_DETAIL. Holds 12 status rows where key and code are identical: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and four keys ('NL', 'NS', 'NB', and a blank/space key) that share a NULL description.\", \"columns\": {\"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Surrogate key of the material status; joins to TIP_DETAIL.TIP_MATERIAL_STATUS_KEY\"}, \"TIP_MATERIAL_STATUS_CODE\": {\"desc\": \"Material status code, identical in value to TIP_MATERIAL_STATUS_KEY: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, plus NULL-description keys 'NL', 'NS', 'NB' and a blank key.\"}, \"TIP_MATERIAL_STATUS\": {\"desc\": \"Material status description text. NULL for four of the twelve keys ('NL', 'NS', 'NB', blank), so grouping by this column merges those keys into one NULL group and yields fewer distinct statuses than grouping by key.\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per material status\"}, {\"columns\": [\"TIP_DETAIL.TIP_MATERIAL_STATUS_KEY\", \"TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY\", \"LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY\", \"LIBRARY_MATERIAL_STATUS.LIBRARY_MATERIAL_STATUS_KEY\"], \"comparisons\": [{\"dimension\": \"Program\", \"detail\": \"TIP_MATERIAL_STATUS_KEY belongs to the textbook program (decoded by TIP_MATERIAL_STATUS); LIBRARY_MATERIAL_STATUS_KEY belongs to library reserve processing (decoded by LIBRARY_MATERIAL_STATUS). The two key domains are independent and must not be joined to each other.\"}, {\"dimension\": \"Value domains\", \"detail\": \"TIP statuses: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, plus 'NL'/'NS'/'NB'/blank keys with NULL descriptions. Library statuses: 'U' = Unknown, 'R' = NULL description, 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material. Both domains contain 'U' but it means 'Unknown' in each program independently.\"}, {\"dimension\": \"Usage pattern\", \"detail\": \"Fact-side filtering uses the key columns on TIP_DETAIL / LIBRARY_RESERVE_MATRL_DETAIL directly; the lookup tables provide human-readable status text when needed. Grouping by the description column instead of the key merges statuses with NULL or identical descriptions.\"}, {\"dimension\": \"Cross-domain equality risk\", \"detail\": \"Some warehouse analyses equate TIP_MATERIAL_STATUS_KEY with LIBRARY_MATERIAL_STATUS_KEY to attach per-status statistics across the two programs. Because the value domains are independent, such an equality only matches on coincidental code overlap (e.g. 'U') and carries semantic risk; results should be interpreted as code-level matching, not as a true business relationship between textbook status and library reserve status.\"}], \"decision_guide\": {\"Questions about required or optional textbooks\": \"Filter TIP_DETAIL.TIP_MATERIAL_STATUS_KEY IN ('RQ','EO'); 'RQ' for required only.\", \"Questions about library reserve material status\": \"Filter/group LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY (e.g. 'U' Unknown, 'Y' Required Course Material); decode text via LIBRARY_MATERIAL_STATUS.\", \"Questions needing status description text rather than codes\": \"Join TIP_MATERIAL_STATUS or LIBRARY_MATERIAL_STATUS on the respective key; note that description columns contain NULLs for some keys.\", \"Matching reserve materials to textbook materials\": \"Match via SUBJECT_ID + TERM_CODE (or TIP_MATERIAL_KEY paths) between TIP_DETAIL and LIBRARY_RESERVE_MATRL_DETAIL, never by equating the two status key columns.\", \"Questions about required textbooks or textbook material statuses\": \"Filter/group TIP_DETAIL.TIP_MATERIAL_STATUS_KEY (e.g. 'RQ' for Required); decode text via TIP_MATERIAL_STATUS.\"}, \"desc\": \"Material status key columns of the textbook program (TIP) and library reserve program. Both are coded status references decoded by their own lookup tables (key value equals code value), with independent value domains: TIP statuses ('RQ' Required, 'EO' Electronic options, 'RC' Recommended, 'PC' Val-u option, 'BR' Bookstore recommends, 'CL' Go to class first, 'NM' Course has no materials, 'U' Unknown, plus NULL-description keys) vs library reserve statuses ('U' Unknown, 'R' null description, 'N' Non-Required Course Material, 'O' Reserve only, 'X' No Required Textbook, 'Y' Required Course Material).\", \"id\": \"column_concept_material_status_key\", \"name\": \"Material Status Key\"}], \"not_found\": []}"
    },
