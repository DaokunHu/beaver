      "name": "semantic_get",
      "content": "{\"ok\": true, \"entity\": {\"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per academic year\", \"desc\": \"For each academic year, what is the academic year, academic year description, the geometric mean of the number of library reserve material details per subject offered (considering only records where the material status is 'U' and the academic term is a regular term), the average total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the average number of design units for subjects that are offered in the fall term and have a material status of 'U' in the library reserve? List the results ordered by the geometric mean of materials per subject in descending order, then by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\", \"id\": \"dw_4701\", \"name\": \"Yearly Geometric Mean Reserve Materials per Subject with Fall Term Unit Statistics\", \"sql\": \"WITH inner_cte AS ( WITH GeometricMeanMaterialsPerSubject AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, EXP(AVG(LN(material_count))) AS geometric_mean_materials_per_subject FROM ( SELECT LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY, COUNT(*) AS material_count, LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE FROM LIBRARY_RESERVE_MATRL_DETAIL WHERE LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY = 'U' GROUP BY LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY, LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE ) sub JOIN ACADEMIC_TERMS ON sub.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC ), AvgStddevTotalUnitsFallU AS ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, AVG(ccso.TOTAL_UNITS) AS avg_total_units, STDDEV(ccso.TOTAL_UNITS) AS stddev_total_units FROM LIBRARY_RESERVE_MATRL_DETAIL lrm JOIN ACADEMIC_TERMS at ON lrm.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE lrm.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ) SELECT gmmps.ACADEMIC_YEAR, gmmps.ACADEMIC_YEAR_DESC, gmmps.geometric_mean_materials_per_subject, astu.avg_total_units, astu.stddev_total_units FROM GeometricMeanMaterialsPerSubject gmmps JOIN AvgStddevTotalUnitsFallU astu ON gmmps.ACADEMIC_YEAR = astu.ACADEMIC_YEAR AND gmmps.ACADEMIC_YEAR_DESC = astu.ACADEMIC_YEAR_DESC ORDER BY gmmps.geometric_mean_materials_per_subject DESC, astu.stddev_total_units DESC ) SELECT icte.ACADEMIC_YEAR, icte.ACADEMIC_YEAR_DESC, icte.geometric_mean_materials_per_subject, icte.avg_total_units, icte.stddev_total_units, avg_design.avg_design_units FROM inner_cte icte JOIN ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, AVG(ccso.DESIGN_UNITS) AS avg_design_units FROM LIBRARY_RESERVE_MATRL_DETAIL lrm JOIN ACADEMIC_TERMS at ON lrm.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE lrm.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ) avg_design ON icte.ACADEMIC_YEAR = avg_design.ACADEMIC_YEAR AND icte.ACADEMIC_YEAR_DESC = avg_design.ACADEMIC_YEAR_DESC ORDER BY icte.geometric_mean_materials_per_subject DESC, icte.stddev_total_units DESC;\"}}"
