    {
      "role": "tool",
      "tool_call_id": "call_ea855bfda262488fb346d636",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"count\": 10, \"items\": [{\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"entity_type\": \"table\", \"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Facilities building inventory table: one row per physical building with building number/name, type (e.g. ACADEMIC), ownership, use, occupancy class, gross/assignable/non-assignable areas, number of rooms, key dates (built/acquired/occupied), site and geographic coordinates. Parent of FCLT_ROOMS via FCLT_BUILDING_KEY.\", \"entity_type\": \"table\", \"id\": \"FCLT_BUILDING\", \"name\": \"FCLT_BUILDING\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"entity_type\": \"table\", \"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Facilities major use classification lookup table (FCLT family): one row per major use code (e.g. CLASSRMS classrooms, OFFICES offices, LABS laboratories, RESIDENT residential) with its short code, description, and assignable-space flag. Joined from FCLT_ROOMS via FCLT_MAJOR_USE_KEY to decode a room's major use; current snapshot only, use FCLT_MAJOR_USE_HIST for fiscal-period historical variants.\", \"entity_type\": \"table\", \"id\": \"FCLT_MAJOR_USE\", \"name\": \"FCLT_MAJOR_USE\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Employee directory table: one row per institute employee with MIT ID, legal and preferred name components, directory/primary titles, HR department number and name, office location and office phone, email address, personal URL, and Kerberos name. Used to resolve responsible faculty contact details (full name, email, office phone) for subject offerings via RESPONSIBLE_FACULTY_MIT_ID = MIT_ID, and to link employees to Moira mailing list membership via MIT_ID = MOIRA_LIST_MEMBER_MIT_ID.\", \"entity_type\": \"table\", \"id\": \"EMPLOYEE_DIRECTORY\", \"name\": \"EMPLOYEE_DIRECTORY\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Facilities floor inventory table: one row per floor of a building (floor key formatted '<building key>-<floor>'), with floor number/label, gross, assignable and non-assignable areas of the floor, sort sequence, level identifier, building wing, and access level. Child of FCLT_BUILDING via FCLT_BUILDING_KEY and parent of FCLT_ROOMS via FCLT_FLOOR_KEY; used for per-floor area aggregation and floor-level filtering (e.g. floors with assignable area above a threshold).\", \"entity_type\": \"table\", \"id\": \"FCLT_FLOOR\", \"name\": \"FCLT_FLOOR\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Historical facilities building snapshot table: one row per building per fiscal period (FISCAL_PERIOD in YYYYMM format, covering 201505-201906, 48 periods, ~255 buildings), preserving each building's attributes over time: identifiers and names, gross/assignable/non-assignable areas, site, campus sector, access level, building type, ownership type, use, occupancy class, height, cost center/collector references, coordinates, and number of rooms. Used for fiscal-period building history analysis (area/room-count trends, dispersion statistics across historical records); use FCLT_BUILDING for the current snapshot. Date columns (DATE_BUILT/DATE_ACQUIRED/DATE_OCCUPIED) are stored in MM/DD/YYYY format; FCLT_BUILDING_HIST_1 is the variant storing them in DD-MON-YY format.\", \"entity_type\": \"table\", \"id\": \"FCLT_BUILDING_HIST\", \"name\": \"FCLT_BUILDING_HIST\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Historical facilities room table: one row per room per fiscal period (FISCAL_PERIOD in YYYYMM format; current data covers period 201505), preserving each room's identifiers, floor, use classifications, organization assignment, area, access level, and coordinates over time. Fiscal-period counterpart of FCLT_ROOMS; joins to current room records via FCLT_ROOM_KEY and to buildings via FCLT_BUILDING_KEY.\", \"entity_type\": \"table\", \"id\": \"FCLT_ROOMS_HIST\", \"name\": \"FCLT_ROOMS_HIST\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Space unit dimension table: one row per space unit (an organizational space-assignment unit such as a department, program, or office that receives space allocation), with space unit key/code, space unit name, the facilities organization it belongs to, and DLC key. Bridges FCLT_ORGANIZATION (organization attribution) and SPACE_DETAIL (rooms assigned to the space unit); used to group room counts and space statistics by space unit.\", \"entity_type\": \"table\", \"id\": \"SPACE_UNIT\", \"name\": \"SPACE_UNIT\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Bridge table mapping facilities organizations to their department/lab/center (DLC) keys: one row per organization-DLC key assignment. Used to filter organizations that have a non-null DLC key assignment before joining FCLT_ORGANIZATION (via FCLT_ORGANIZATION_KEY or DLC_KEY) for DLC-level facility and room statistics.\", \"entity_type\": \"table\", \"id\": \"FCLT_ORG_DLC_KEY\", \"name\": \"FCLT_ORG_DLC_KEY\"}]}"
