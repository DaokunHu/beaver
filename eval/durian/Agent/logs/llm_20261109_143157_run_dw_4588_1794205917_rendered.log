    {
      "role": "tool",
      "tool_call_id": "call_3ec7c8981b4a46d19d2aa3e7",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_3410\", \"name\": \"Large Rooms in High-Room-Count Buildings with Space Unit Organization Number Dispersion\", \"desc\": \"For rooms with an area greater than 300 and located in buildings with more than 100 rooms, show the building's long name, the room's full name, the room's area, and the row number within a window of 2 preceding and 1 following rows ordered by the building's long name, along with the name of the space unit, the associated organization name, and both the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the organization numbers for all organizations linked to that space unit (considering only space units with a non-null DLC key and organizations with assignable status), where the room and the space unit share the same organization key. List the columns in the following order: building's long name, room's full name, room's area, window row number, space unit name, organization name, organization number variance, and organization number standard deviation (using STDDEV only and never STDDEV_POP). Do not return any rounded answers.\", \"sql\": \"WITH rooms_windowed AS ( SELECT t1.BUILDING_NAME_LONG, t0.ROOM_FULL_NAME, t0.AREA, t0.FCLT_ORGANIZATION_KEY, ROW_NUMBER() OVER (ORDER BY t1.BUILDING_NAME_LONG ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column FROM FCLT_ROOMS t0 JOIN FCLT_BUILDING t1 ON t0.FCLT_BUILDING_KEY = t1.FCLT_BUILDING_KEY WHERE t0.AREA > 300 AND t1.NUM_OF_ROOMS > 100 ), space_unit_org_stats AS ( SELECT s.SPACE_UNIT, o.ORGANIZATION_NAME, VARIANCE(o.ORGANIZATION_NUMBER) AS org_number_variance, STDDEV(o.ORGANIZATION_NUMBER) AS org_number_stddev, o.FCLT_ORGANIZATION_KEY FROM FCLT_ORG_DLC_KEY d JOIN FCLT_ORGANIZATION o ON d.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY JOIN SPACE_UNIT s ON o.FCLT_ORGANIZATION_KEY = s.FCLT_ORGANIZATION_KEY WHERE s.DLC_KEY IS NOT NULL AND o.ASSIGNABLE = 1 GROUP BY s.SPACE_UNIT, o.ORGANIZATION_NAME, o.FCLT_ORGANIZATION_KEY ORDER BY org_number_variance DESC ) SELECT rw.BUILDING_NAME_LONG, rw.ROOM_FULL_NAME, rw.AREA, rw.window_column, suos.SPACE_UNIT, suos.ORGANIZATION_NAME, suos.org_number_variance, suos.org_number_stddev FROM rooms_windowed rw JOIN space_unit_org_stats suos ON rw.FCLT_ORGANIZATION_KEY = suos.FCLT_ORGANIZATION_KEY\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per large room matched with its organization's space unit statistics\"}, {\"id\": \"dw_1465\", \"name\": \"Provost Area School of Science Department Organizations with Max Average Organization Number and Room Area Stddev\", \"desc\": \"For each department in the Provost Area at the School of Science level, excluding the Biology department, and for each organization within those departments (excluding organizations with IDs '138' and '250'), show the department name, department code, organization name, organization ID, the maximum average organization number within each department code group, and the standard deviation (using STDDEV only and never STDDEV_POP) of the area of rooms assigned to the organization (considering only organizations with more than 5 rooms and excluding organizations named 'ADMISSIONS'), ordered by department name and organization name. Do not return any rounded answers.\", \"sql\": \"WITH dept_max_avg_org AS ( WITH inner_cte AS ( SELECT t0.DLC_NAME, t0.DLC_CODE, t1.ORGANIZATION_NAME, t1.ORGANIZATION_ID, AVG(t1.ORGANIZATION_NUMBER) OVER (PARTITION BY t0.DLC_CODE ORDER BY t1.ORGANIZATION_SORT) AS avg_org_number FROM MASTER_DEPT_HIERARCHY t0 JOIN FCLT_ORGANIZATION t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' AND t0.MASTER_DEPT_HIER_LEVEL_3_NAME = 'School of Science' AND LOWER(t0.DLC_NAME) <> LOWER('Biology') AND t1.ORGANIZATION_ID NOT IN ('138', '250') ) SELECT DLC_NAME, DLC_CODE, ORGANIZATION_NAME, ORGANIZATION_ID, MAX(avg_org_number) AS max_avg_org_number FROM inner_cte GROUP BY DLC_NAME, DLC_CODE, ORGANIZATION_NAME, ORGANIZATION_ID ), org_area_stddev AS ( WITH inner_cte AS ( SELECT fo.ORGANIZATION_NAME, STDDEV(fr.AREA) AS area_stddev, fo.FCLT_ORGANIZATION_KEY FROM FCLT_ROOMS fr JOIN FCLT_ORGANIZATION fo ON fr.FCLT_ORGANIZATION_KEY = fo.FCLT_ORGANIZATION_KEY WHERE fo.ORGANIZATION_NAME <> 'ADMISSIONS' GROUP BY fo.ORGANIZATION_NAME, fo.FCLT_ORGANIZATION_KEY HAVING COUNT(fr.FCLT_ROOM_KEY) > 5 ) SELECT i.ORGANIZATION_NAME, fo.ORGANIZATION_NUMBER AS dept_code, i.area_stddev, fo.FCLT_ORGANIZATION_KEY FROM inner_cte i JOIN FCLT_ORGANIZATION fo ON i.FCLT_ORGANIZATION_KEY = fo.FCLT_ORGANIZATION_KEY ) SELECT d.DLC_NAME, d.DLC_CODE, d.ORGANIZATION_NAME, d.ORGANIZATION_ID, d.max_avg_org_number, o.area_stddev FROM dept_max_avg_org d JOIN FCLT_ORGANIZATION fo ON d.ORGANIZATION_ID = fo.ORGANIZATION_ID JOIN org_area_stddev o ON fo.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY ORDER BY d.DLC_NAME, d.ORGANIZATION_NAME\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per School-of-Science department organization matched with its room area standard deviation\"}, {\"category\": \"Course Catalog and Facility Space Comprehensive Analysis\", \"default_granularity\": \"one row per department-grade-type rollup row matched with organization room area statistics\", \"desc\": \"For each department and subject grade type where the subject is offered in the current academic year, is letter graded, and the department is Mathematics (Course 18), provide the number of subjects, the minimum total units, the school name, the department phone number, the organization name, the standard deviation (using STDDEV only and never STDDEV_POP) of the areas of its rooms, and the department's DLC name, including subtotals for each department (the corresponding department field is 'SUBTOTAL') and a grand total across all departments (the corresponding department field is 'TOTAL'). Do not repeat the department if it is the same as the previous row. Only include organizations that have more than 5 rooms, are associated with a non-null DLC key, and are not the 'ADMISSIONS' department or the 'Political Science' department. Sort the table by department, grade type, and descending standard deviation (using STDDEV only and never STDDEV_POP) of room areas. Do not return any rounded answers.\", \"id\": \"dw_1833\", \"name\": \"Math Letter-Graded Subject Rollup by Grade Type with Organization Room Area Stddev and DLC Name\", \"sql\": \"WITH inner_cte1 AS ( SELECT d.DEPARTMENT_NAME, c.GRADE_TYPE, COUNT(c.SUBJECT_ID) AS subject_count, MIN(c.TOTAL_UNITS) AS min_total_units FROM SIS_DEPARTMENT d JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON d.DEPARTMENT_CODE = c.DEPARTMENT_CODE WHERE c.IS_OFFERED_THIS_YEAR = 'Y' AND c.GRADE_TYPE = 'L' AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME, c.GRADE_TYPE ), cte1 AS ( SELECT CASE WHEN LAG(dept) OVER (ORDER BY dept_sort, grade_type) = dept THEN NULL ELSE dept END AS department, grade_type, subject_count, min_total_units, sd.SCHOOL_NAME AS school_name, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.DLC_KEY AS dlc_key FROM ( SELECT CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'zzz' ELSE DEPARTMENT_NAME END AS dept_sort, CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'TOTAL' ELSE DEPARTMENT_NAME END AS dept, GRADE_TYPE AS grade_type, COUNT(SUBJECT_COUNT) AS subject_count, MIN(min_total_units) AS min_total_units FROM inner_cte1 GROUP BY DEPARTMENT_NAME, GRADE_TYPE WITH ROLLUP ) tbltmp LEFT JOIN SIS_DEPARTMENT sd ON tbltmp.dept = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), inner_cte2 AS ( SELECT o.ORGANIZATION_NAME, STDDEV(r.AREA) AS area_stddev, o.DLC_KEY FROM FCLT_ORG_DLC_KEY d JOIN FCLT_ORGANIZATION o ON d.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY JOIN FCLT_ROOMS r ON o.FCLT_ORGANIZATION_KEY = r.FCLT_ORGANIZATION_KEY WHERE d.DLC_KEY IS NOT NULL AND o.ORGANIZATION_NAME NOT IN ('ADMISSIONS') AND o.ORGANIZATION_NAME <> 'Political Science' GROUP BY o.ORGANIZATION_NAME, o.DLC_KEY HAVING COUNT(*) > 5 ), cte2 AS ( SELECT inner_cte2.ORGANIZATION_NAME, inner_cte2.area_stddev, o2.DLC_NAME, inner_cte2.DLC_KEY FROM inner_cte2 JOIN FCLT_ORGANIZATION o2 ON inner_cte2.DLC_KEY = o2.DLC_KEY ) SELECT cte1.department, cte1.grade_type, cte1.subject_count, cte1.min_total_units, cte1.school_name, cte1.department_phone, cte2.ORGANIZATION_NAME, cte2.area_stddev, cte2.DLC_NAME FROM cte1 LEFT JOIN cte2 ON cte1.dlc_key = cte2.DLC_KEY ORDER BY cte1.department, cte1.grade_type, cte2.area_stddev DESC;\"}], \"not_found\": []}"
    },
