      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"column_concept_access_level\", \"name\": \"Access Level Columns\", \"desc\": \"Access level columns recorded at three granularity levels of the facilities domain plus the space-planning room feed: building-level ACCESS_LEVEL_CODE/ACCESS_LEVEL_NAME (current and per-fiscal-period history), floor-level ACCESS_LEVEL, and room-level ACCESS_LEVEL (FCLT_ROOMS, FAC_ROOMS, ZPM_ROOMS_LOAD). They share a numeric value domain (observed 0-3) but describe the access restriction of different physical objects or come from different feeds, so filters and joins must target the granularity and table family the question refers to.\", \"columns\": [\"FCLT_BUILDING.ACCESS_LEVEL_CODE\", \"FCLT_BUILDING.ACCESS_LEVEL_NAME\", \"FCLT_BUILDING_HIST.ACCESS_LEVEL_CODE\", \"FCLT_BUILDING_HIST.ACCESS_LEVEL_NAME\", \"FCLT_FLOOR.ACCESS_LEVEL\", \"FCLT_ROOMS.ACCESS_LEVEL\", \"FAC_BUILDING.ACCESS_LEVEL_CODE\", \"FAC_FLOOR.ACCESS_LEVEL\", \"FAC_ROOMS.ACCESS_LEVEL\", \"ZPM_ROOMS_LOAD.ACCESS_LEVEL\"], \"comparisons\": [{\"dimension\": \"Granularity\", \"differences\": \"Building columns classify the whole building (one code per building); floor columns classify each floor; room columns classify each individual room. A building with access level 2 can contain rooms with access level 1.\"}, {\"dimension\": \"Code vs name\", \"differences\": \"At building level the code (ACCESS_LEVEL_CODE, integer) and name (ACCESS_LEVEL_NAME, string) carry the same numeric value in current data; joins and filters typically use the code.\"}, {\"dimension\": \"Time semantics\", \"differences\": \"FCLT_BUILDING_HIST.ACCESS_LEVEL_CODE is the per-fiscal-period building access level and can be joined to FCLT_BUILDING.ACCESS_LEVEL_CODE to associate buildings sharing an access level with history attributes; the other columns are current values.\"}, {\"dimension\": \"Room-level feed differences\", \"differences\": \"FCLT_ROOMS.ACCESS_LEVEL and FAC_ROOMS.ACCESS_LEVEL belong to the facilities room inventories (with area and use keys); ZPM_ROOMS_LOAD.ACCESS_LEVEL belongs to the space-planning feed (with space usage text and SPACE_UNIT_CODE/HR_ORG_UNIT_ID links but no area), so room access-level statistics differ depending on the chosen feed.\"}], \"decision_guide\": {\"Rooms restricted by access level (e.g. 'rooms with access level 1 or 2')\": \"Use FCLT_ROOMS.ACCESS_LEVEL (numeric); FAC_ROOMS.ACCESS_LEVEL for the FAC_* family.\", \"Building-level access classification or grouping buildings by access level\": \"Use FCLT_BUILDING.ACCESS_LEVEL_CODE (with ACCESS_LEVEL_NAME for display).\", \"Access level of a specific floor\": \"Use FCLT_FLOOR.ACCESS_LEVEL.\", \"History-based access level analysis (per fiscal period)\": \"Use FCLT_BUILDING_HIST.ACCESS_LEVEL_CODE.\", \"Room access level analysis combined with floor, space usage text, or space unit / HR org unit linkage\": \"Use ZPM_ROOMS_LOAD.ACCESS_LEVEL.\"}}, {\"columns\": [\"SPACE_UNIT.SPACE_UNIT_KEY\", \"SPACE_UNIT2.SPACE_UNIT_KEY\", \"SPACE_DETAIL.SPACE_UNIT_KEY\"], \"comparisons\": [{\"dimension\": \"Role\", \"differences\": \"In SPACE_UNIT and SPACE_UNIT2 it is the primary identity of the space unit dimension; in SPACE_DETAIL it is a foreign key assigning each room to a space unit.\"}, {\"dimension\": \"Organization linkage\", \"differences\": \"Only SPACE_UNIT.SPACE_UNIT_KEY rows carry FCLT_ORGANIZATION_KEY, so joining SPACE_DETAIL through SPACE_UNIT (not SPACE_UNIT2) reaches organization attributes.\"}, {\"dimension\": \"Coverage\", \"differences\": \"SPACE_DETAIL references 66 distinct space unit keys; SPACE_UNIT covers all of them plus unused units, SPACE_UNIT2 is a subset of SPACE_UNIT.\"}], \"decision_guide\": {\"Grouping room counts by space unit with organization attributes\": \"Join SPACE_DETAIL.SPACE_UNIT_KEY to SPACE_UNIT.SPACE_UNIT_KEY, then to FCLT_ORGANIZATION via SPACE_UNIT.FCLT_ORGANIZATION_KEY.\", \"Space unit name lookup without organization context\": \"Either SPACE_UNIT or SPACE_UNIT2 resolves SPACE_DETAIL.SPACE_UNIT_KEY to a name; prefer SPACE_UNIT for full coverage.\"}, \"desc\": \"Space unit key columns identifying the organizational space-assignment unit across the space dimension and fact tables. SPACE_UNIT_KEY is the join key linking SPACE_DETAIL room rows to space unit identity (name/code) and, through SPACE_UNIT, to the owning facilities organization.\", \"id\": \"column_concept_space_unit_key\", \"name\": \"Space Unit Key\"}, {\"columns\": [\"SPACE_DETAIL.BUILDING_ROOM\", \"FCLT_ROOMS.BUILDING_ROOM\", \"ZPM_ROOMS_LOAD.BUILDING_ROOM\"], \"comparisons\": [{\"dimension\": \"Table perspective\", \"differences\": \"In SPACE_DETAIL it identifies a room within a space-unit assignment row (counting rows gives rooms per space unit/building); in FCLT_ROOMS it identifies a room within the facilities inventory with use classifications and organization occupancy; in ZPM_ROOMS_LOAD it identifies a room within the space-planning load feed with floor, space usage text, and access level.\"}, {\"dimension\": \"Coverage\", \"differences\": \"FCLT_ROOMS has more distinct building-room values (9,872) than SPACE_DETAIL (9,332); only about 2,666 values match textually between the two tables, so cross-table room matching on BUILDING_ROOM is unreliable. ZPM_ROOMS_LOAD holds 10,000 room rows from the space-planning feed.\"}, {\"dimension\": \"Companion columns\", \"differences\": \"SPACE_DETAIL pairs it with ROOM_NUMBER, ROOM_SQUARE_FOOTAGE (sq ft), ROOM_COUNTER; FCLT_ROOMS pairs it with ROOM, ROOM_FULL_NAME, AREA (sq m), use descriptions; ZPM_ROOMS_LOAD pairs it with BUILDING_COMPONENT, FLOOR (text, can be labels like 'G9'), SPACE_USAGE, ACCESS_LEVEL.\"}], \"decision_guide\": {\"Counting rooms per space unit or per building\": \"Use SPACE_DETAIL.BUILDING_ROOM with COUNT, grouped by SPACE_UNIT_KEY/BUILDING_KEY.\", \"Room-level analysis with usage classification or square-meter area\": \"Use FCLT_ROOMS.BUILDING_ROOM alongside MAJOR_USE_DESC/AREA.\", \"Matching the same physical room across space assignment and facilities inventory\": \"Do not rely on BUILDING_ROOM text equality alone (low overlap); prefer key-based joins within each table family.\", \"Room-level analysis by floor, space usage text, or access level with space unit / HR org unit linkage\": \"Use ZPM_ROOMS_LOAD.BUILDING_ROOM alongside FLOOR/SPACE_USAGE/ACCESS_LEVEL.\"}, \"desc\": \"Combined building-room identifier columns (e.g. '1-080') appearing in both the space assignment fact table and the facilities room inventory. They identify the same physical room concept but come from different business processes with different coverage and companion measures.\", \"id\": \"column_concept_building_room\", \"name\": \"Building Room Identifier\"}, {\"id\": \"concept_space_unit_dimension\", \"name\": \"Space Unit Dimension\", \"desc\": \"Space unit lookup tables identifying the organizational units that receive space allocation: SPACE_UNIT (with FCLT_ORGANIZATION_KEY organization attribution) and SPACE_UNIT2 (identity/name only). They answer the same space-unit identity questions but differ in organization linkage and coverage.\", \"tables\": [\"SPACE_UNIT\", \"SPACE_UNIT2\"], \"comparisons\": [{\"dimension\": \"Organization attribution\", \"differences\": \"SPACE_UNIT carries FCLT_ORGANIZATION_KEY linking each space unit to its owning organization in FCLT_ORGANIZATION; SPACE_UNIT2 has no organization key, only space unit identity and DLC_KEY.\"}, {\"dimension\": \"Coverage\", \"differences\": \"SPACE_UNIT holds more space units (150 rows) than SPACE_UNIT2 (139 rows); every SPACE_UNIT2 key also exists in SPACE_UNIT, so SPACE_UNIT2 is a subset.\"}, {\"dimension\": \"Join role\", \"differences\": \"Both join SPACE_DETAIL via SPACE_UNIT_KEY; only SPACE_UNIT can bridge SPACE_DETAIL rooms to organization attributes (level, parent, description).\"}], \"decision_guide\": {\"Space unit analysis that needs organization attributes (organization level, name, description)\": \"Use SPACE_UNIT: it is the only space unit table carrying FCLT_ORGANIZATION_KEY for the organization join.\", \"Space unit name/code lookup only, or queries restricted to the SPACE_UNIT2 subset\": \"Use SPACE_UNIT2: it provides SPACE_UNIT_KEY/CODE/NAME and DLC_KEY without organization linkage.\", \"Counting rooms per space unit or ranking space units by room count\": \"Join SPACE_DETAIL to SPACE_UNIT on SPACE_UNIT_KEY (preferred for full coverage and organization attribution).\"}}, {\"id\": \"concept_room_space_inventory\", \"name\": \"Room and Space Inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\", \"tables\": [\"SPACE_DETAIL\", \"FCLT_ROOMS\", \"FAC_ROOMS\", \"ZPM_ROOMS_LOAD\"], \"comparisons\": [{\"dimension\": \"Business perspective\", \"differences\": \"SPACE_DETAIL records rooms from the space-assignment perspective (which space unit each room is allocated to, with SPACE_USAGE_KEY usage code); FCLT_ROOMS and FAC_ROOMS record rooms from the facilities inventory perspective (major/minor use descriptions, primary and minor organization occupancy); ZPM_ROOMS_LOAD records rooms from the space-planning load perspective (space usage text, floor, access level, occupying HR org unit).\"}, {\"dimension\": \"Key family and join paths\", \"differences\": \"SPACE_DETAIL joins SPACE_UNIT/SPACE_FLOOR/SPACE_USAGE and FCLT_BUILDING via BUILDING_KEY; FCLT_ROOMS joins FCLT_BUILDING via FCLT_BUILDING_KEY and FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, and is referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE; FAC_ROOMS joins the FAC_* family (FAC_BUILDING, FAC_FLOOR, FAC_ORGANIZATION); ZPM_ROOMS_LOAD joins SPACE_UNIT via SPACE_UNIT_CODE and FCLT_ORGANIZATION/HR_ORG_UNIT via HR_ORG_UNIT_ID (no building/floor keys).\"}, {\"dimension\": \"Area measure and units\", \"differences\": \"SPACE_DETAIL.ROOM_SQUARE_FOOTAGE is in square feet; FCLT_ROOMS.AREA and FAC_ROOMS.AREA are in square meters; ZPM_ROOMS_LOAD carries no area measure at all. Unit choice matters for size thresholds and averages.\"}, {\"dimension\": \"Room counting semantics\", \"differences\": \"SPACE_DETAIL supports counting rooms per space unit or per building via BUILDING_ROOM rows (and ROOM_COUNTER=1 per row); FCLT_BUILDING also carries a precomputed NUM_OF_ROOMS attribute per building, while FCLT_ROOMS/FAC_ROOMS/ZPM_ROOMS_LOAD require COUNT over room rows.\"}, {\"dimension\": \"Usage classification detail\", \"differences\": \"SPACE_DETAIL uses a coded SPACE_USAGE_KEY decoded by SPACE_USAGE; FCLT_ROOMS/FAC_ROOMS carry denormalized MAJOR_USE_DESC/USE_DESC/MINOR_USE_DESC text classifications plus ACCESS_LEVEL and coordinates; ZPM_ROOMS_LOAD carries a free-text SPACE_USAGE (e.g. 'DSGN STUDIO', 'CONF RM') plus ACCESS_LEVEL and a text FLOOR that can hold labels such as 'G9'.\"}], \"decision_guide\": {\"Counting rooms per space unit or finding the building with the most rooms in a space unit\": \"Use SPACE_DETAIL: it is the only table keyed by SPACE_UNIT_KEY, so room counts can be grouped by space unit and by BUILDING_KEY directly.\", \"Room area statistics in square meters, use-classification filters (e.g. classrooms), or linking class meeting places to rooms\": \"Use FCLT_ROOMS: it carries AREA in square meters, denormalized use descriptions, and FCLT_ROOM_KEY referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE.\", \"Room analysis that must stay inside the FAC_* key family (FAC_BUILDING/FAC_FLOOR/FAC_ORGANIZATION)\": \"Use FAC_ROOMS: it mirrors FCLT_ROOMS structure but joins FAC_* family tables via FAC_ROOM_KEY/BUILDING_KEY/ORGANIZATION_KEY.\", \"Room occupancy by organization hierarchy (level, parent organization)\": \"Use FCLT_ROOMS joined to FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, SPACE_DETAIL joined via SPACE_UNIT to SPACE_UNIT.FCLT_ORGANIZATION_KEY when the space-assignment view is required, or ZPM_ROOMS_LOAD joined to FCLT_ORGANIZATION via HR_ORG_UNIT_ID for the space-planning view.\", \"Room analysis by floor, space usage text, or access level linked to space units or HR org units (no area needed)\": \"Use ZPM_ROOMS_LOAD: it links rooms to SPACE_UNIT via SPACE_UNIT_CODE and to organizations/HR units via HR_ORG_UNIT_ID.\"}}, {\"id\": \"dw_2616\", \"name\": \"Large Rooms Above-Average Total Room Counter per Building Room with Floor Count and Space Usage\", \"desc\": \"For each space unit with a room square footage greater than 100, what is the building room, building room name, space usage, the number of distinct floors it appears on, and the total room counter, but only include those where the total room counter is greater than the average room counter across all space units with room square footage greater than 100? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT sd.BUILDING_ROOM, sd.BUILDING_ROOM_NAME, su.SPACE_USAGE, COUNT(DISTINCT sd.FLOOR_KEY) AS floor_count, SUM(sd.ROOM_COUNTER) AS total_room_counter FROM SPACE_DETAIL sd JOIN SPACE_USAGE su ON sd.SPACE_USAGE_KEY = su.SPACE_USAGE_KEY WHERE sd.ROOM_SQUARE_FOOTAGE > 100 GROUP BY sd.BUILDING_ROOM, sd.BUILDING_ROOM_NAME, su.SPACE_USAGE ) SELECT BUILDING_ROOM, BUILDING_ROOM_NAME, SPACE_USAGE, floor_count, total_room_counter FROM inner_cte WHERE total_room_counter > ( SELECT AVG(total_room_counter) FROM ( SELECT SUM(sd.ROOM_COUNTER) AS total_room_counter FROM SPACE_DETAIL sd WHERE sd.ROOM_SQUARE_FOOTAGE > 100 GROUP BY sd.BUILDING_ROOM, sd.BUILDING_ROOM_NAME, sd.SPACE_USAGE_KEY ) sub )\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per building room and space usage with room square footage > 100 and above-average total room counter\"}], \"not_found\": []}"
    },
