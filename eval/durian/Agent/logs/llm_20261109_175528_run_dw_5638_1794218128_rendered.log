    {
      "role": "tool",
      "tool_call_id": "call_513065eda3f244879b968cf4",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per subject with textbooks\", \"desc\": \"For subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook, show the subject code, subject number, department name, subject title, term description, total units, the average subject enrollment number in a window of 2 preceding and 2 following rows grouped by department code and ordered by total units, the textbook material key, the textbook material status key, and the row number of the course within each department ordered by subject code. List the results in order by department name, subject code, and subject number. Do not return any rounded answers.\", \"id\": \"dw_3493\", \"name\": \"2022 12-Unit Subjects with Required or Optional Textbooks and Enrollment Windows\", \"sql\": \"WITH SubjectUnitsWindow AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ), CourseTextbookWindow AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t2.TIP_MATERIAL_KEY, t2.TIP_MATERIAL_STATUS_KEY, ROW_NUMBER() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.ACADEMIC_YEAR = 2022 AND t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') ) SELECT s.SUBJECT_CODE, s.SUBJECT_NUMBER, s.DEPARTMENT_NAME, s.SUBJECT_TITLE, s.TERM_DESCRIPTION, s.TOTAL_UNITS, s.window_column AS avg_enrollment_window, c.TIP_MATERIAL_KEY, c.TIP_MATERIAL_STATUS_KEY, c.window_column AS textbook_row_number FROM SubjectUnitsWindow s JOIN CourseTextbookWindow c ON s.SUBJECT_CODE = c.SUBJECT_CODE AND s.SUBJECT_NUMBER = c.SUBJECT_NUMBER AND s.DEPARTMENT_NAME = c.DEPARTMENT_NAME AND s.SUBJECT_TITLE = c.SUBJECT_TITLE AND s.TERM_DESCRIPTION = c.TERM_DESCRIPTION AND s.TERM_CODE = c.TERM_CODE AND s.SUBJECT_ID = c.SUBJECT_ID ORDER BY s.DEPARTMENT_NAME, s.SUBJECT_CODE, s.SUBJECT_NUMBER;\"}, {\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per department matched with 2022 textbook subjects above average units\", \"desc\": \"For each department, show the department name, the highest total units among its subjects with exactly 12 units in the Fall Term 2024-2025, and for each course in that department that was offered in 2022 and has at least one required or optional textbook and has total units greater than the average for such courses, show the course's subject code, subject number, subject title, the term description, the textbook material key, the textbook material status key, and the row number within the department ordered by subject code. Do not return any rounded answers.\", \"id\": \"dw_4448\", \"name\": \"Department Highest 12-Unit Fall 2024-2025 Subjects with 2022 Above-Average Textbook Courses\", \"sql\": \"WITH inner_cte1 AS ( SELECT t2.SUBJECT_ID, t2.SUBJECT_TITLE, t2.DEPARTMENT_NAME, t2.SCHOOL_NAME, t2.TOTAL_UNITS, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, ROW_NUMBER() OVER (PARTITION BY t2.DEPARTMENT_NAME ORDER BY t2.SUBJECT_ID) AS window_column FROM ACADEMIC_TERM_PARAMETER t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_DESCRIPTION = 'Fall Term 2024-2025' AND t2.TOTAL_UNITS = 12 ), subq1 AS ( SELECT DEPARTMENT_NAME, MAX(TOTAL_UNITS) AS highest_total_units FROM inner_cte1 GROUP BY DEPARTMENT_NAME ), inner_cte2 AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t2.TIP_MATERIAL_KEY, t2.TIP_MATERIAL_STATUS_KEY, t0.TOTAL_UNITS, ROW_NUMBER() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.ACADEMIC_YEAR = 2022 AND t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') ), subq2 AS ( SELECT SUBJECT_CODE, SUBJECT_NUMBER, DEPARTMENT_NAME, SUBJECT_TITLE, TERM_DESCRIPTION, TIP_MATERIAL_KEY, TIP_MATERIAL_STATUS_KEY, window_column FROM inner_cte2 WHERE TOTAL_UNITS > ( SELECT AVG(TOTAL_UNITS) FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.ACADEMIC_YEAR = 2022 AND t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') ) ) SELECT s1.DEPARTMENT_NAME, s1.highest_total_units, s2.SUBJECT_CODE, s2.SUBJECT_NUMBER, s2.SUBJECT_TITLE, s2.TERM_DESCRIPTION, s2.TIP_MATERIAL_KEY, s2.TIP_MATERIAL_STATUS_KEY, s2.window_column FROM subq1 s1 JOIN subq2 s2 ON s1.DEPARTMENT_NAME = s2.DEPARTMENT_NAME;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department per subject code\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\", \"id\": \"dw_4756\", \"name\": \"Department Course Counts with 2022 12-Unit Subjects Having Textbooks\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ) SELECT sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL, Total_Courses.Total_Courses, COALESCE(SubjectsWithTextbooks.Subjects_With_Textbooks, 0) AS Subjects_With_Textbooks_2022_12units FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER JOIN ( SELECT sd.DEPARTMENT_NAME, COUNT(DISTINCT COURSE_NUMBER) AS Total_Courses FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER GROUP BY sd.DEPARTMENT_NAME ) AS Total_Courses ON sd.DEPARTMENT_NAME = Total_Courses.DEPARTMENT_NAME LEFT JOIN ( SELECT s1.DEPARTMENT_NAME, COUNT(DISTINCT s1.SUBJECT_CODE || '-' || s1.SUBJECT_NUMBER) AS Subjects_With_Textbooks FROM inner_cte s1 JOIN TIP_DETAIL t2 ON s1.TERM_CODE = t2.TERM_CODE AND s1.SUBJECT_ID = t2.SUBJECT_ID WHERE t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') GROUP BY s1.DEPARTMENT_NAME ) AS SubjectsWithTextbooks ON sd.DEPARTMENT_NAME = SubjectsWithTextbooks.DEPARTMENT_NAME ;\"}, {\"id\": \"dw_1973\", \"name\": \"Math 2022 Letter-Graded Subjects with TIP Materials Ranked by Term with 3-Row Max Units\", \"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"desc\": \"For all subjects offered in the academic year 2022 by the Mathematics department that have at least one associated TIP material and are also offered this year as letter graded, show the subject ID, subject title, term code, term description, the rank of each subject within its term (ordered by subject ID), subject code, subject number, department name, academic year, the maximum total units for each subject considering the current row and the next 2 rows ordered by subject code, and the start and end dates of the term. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.TERM_CODE, s1.TERM_DESCRIPTION, s1.window_column, s2.SUBJECT_CODE, s2.SUBJECT_NUMBER, s2.DEPARTMENT_NAME, s2.ACADEMIC_YEAR, s2.max_total_units_3rows FROM ( SELECT c.SUBJECT_ID, c.SUBJECT_TITLE, c.TERM_CODE, a.TERM_DESCRIPTION, RANK() OVER (PARTITION BY c.TERM_CODE ORDER BY c.SUBJECT_ID) AS window_column FROM COURSE_CATALOG_SUBJECT_OFFERED c INNER JOIN ACADEMIC_TERMS_ALL a ON c.TERM_CODE = a.TERM_CODE INNER JOIN TIP_DETAIL t ON a.TERM_CODE = t.TERM_CODE AND c.SUBJECT_ID = t.SUBJECT_ID WHERE c.ACADEMIC_YEAR = 2022 AND c.DEPARTMENT_NAME = 'Mathematics' ) s1 JOIN ( SELECT c.SUBJECT_CODE, c.SUBJECT_NUMBER, c.SUBJECT_TITLE, c.DEPARTMENT_NAME, c.ACADEMIC_YEAR, c.TERM_CODE, a.TERM_DESCRIPTION, GREATEST( c.TOTAL_UNITS, COALESCE(LEAD(c.TOTAL_UNITS, 1) OVER (PARTITION BY c.SUBJECT_CODE, c.SUBJECT_NUMBER ORDER BY c.SUBJECT_CODE), 0), COALESCE(LEAD(c.TOTAL_UNITS, 2) OVER (PARTITION BY c.SUBJECT_CODE, c.SUBJECT_NUMBER ORDER BY c.SUBJECT_CODE), 0) ) AS max_total_units_3rows FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS a ON c.TERM_CODE = a.TERM_CODE WHERE c.DEPARTMENT_NAME = 'Mathematics' AND c.IS_OFFERED_THIS_YEAR = 'Y' AND c.GRADE_TYPE = 'L' ORDER BY c.SUBJECT_CODE, c.SUBJECT_NUMBER, c.TERM_CODE ) s2 ON s1.SUBJECT_ID = CONCAT(s2.SUBJECT_CODE, '.', s2.SUBJECT_NUMBER) AND s1.TERM_CODE = s2.TERM_CODE ) SELECT i.SUBJECT_ID, i.SUBJECT_TITLE, i.TERM_CODE, i.TERM_DESCRIPTION, i.window_column, i.SUBJECT_CODE, i.SUBJECT_NUMBER, i.DEPARTMENT_NAME, i.ACADEMIC_YEAR, i.max_total_units_3rows, t.TERM_START_DATE, t.TERM_END_DATE FROM inner_cte i JOIN ACADEMIC_TERMS t ON i.TERM_CODE = t.TERM_CODE ORDER BY i.TERM_CODE, i.SUBJECT_ID;\", \"default_granularity\": \"one row per subject per term\"}, {\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2014FA Chemistry library subject per academic year per required-material count\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, and for each academic year, also show the academic year and academic year description and the coefficient of variation (using STDDEV only and never STDDEV_POP) of the total units for subjects in the Mathematics department (Course 18) that have more than 0 total units and are offered in terms with a term status indicator of 'P'. Additionally, for each Chemistry subject, include the number of required TIP materials (where TIP_MATERIAL_STATUS_KEY = 'RQ') for that subject in that term. Do not return any rounded answers.\", \"id\": \"dw_2180\", \"name\": \"2014FA Chemistry Library Subjects Windowed Enrollment with Math Unit Coefficient of Variation and Required Material Counts\", \"sql\": \"WITH inner_cte AS ( SELECT l.SUBJECT_TITLE, l.NUM_ENROLLED_STUDENTS, t.RESPONSIBLE_FACULTY_NAME, t.OFFER_DEPT_NAME, MIN(l.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t.RESPONSIBLE_FACULTY_MIT_ID ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column, l.TERM_CODE FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_SUBJECT_OFFERED t ON l.TERM_CODE = t.TERM_CODE WHERE l.TERM_CODE = '2014FA' AND t.OFFER_DEPT_NAME = 'Chemistry' ), math_units_variation AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, STDDEV_SAMP(ss.TOTAL_UNITS) / NULLIF(AVG(ss.TOTAL_UNITS), 0) AS coefficient_of_variation_total_units FROM SUBJECT_SUMMARY ss JOIN ACADEMIC_TERMS_ALL ata ON ss.TERM_CODE = ata.TERM_CODE WHERE ss.DEPARTMENT_NAME = 'Mathematics' AND ss.TOTAL_UNITS > 0 AND ata.TERM_STATUS_INDICATOR = 'P' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC ORDER BY ata.ACADEMIC_YEAR ), required_materials_count AS ( SELECT t.TERM_CODE, t.SUBJECT_ID, COUNT(*) AS num_required_materials FROM TIP_DETAIL t WHERE t.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY t.TERM_CODE, t.SUBJECT_ID ) SELECT c.SUBJECT_TITLE, c.NUM_ENROLLED_STUDENTS, c.RESPONSIBLE_FACULTY_NAME, c.OFFER_DEPT_NAME, c.window_column, m.ACADEMIC_YEAR, m.ACADEMIC_YEAR_DESC, m.coefficient_of_variation_total_units, COALESCE(r.num_required_materials, 0) AS num_required_materials FROM inner_cte c CROSS JOIN math_units_variation m LEFT JOIN TIP_SUBJECT_OFFERED t ON c.TERM_CODE = t.TERM_CODE AND c.SUBJECT_TITLE = t.SUBJECT_TITLE LEFT JOIN required_materials_count r ON t.TERM_CODE = r.TERM_CODE AND t.SUBJECT_ID = r.SUBJECT_ID\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_acd8ad7495454de0a7a1a81e",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"TIP_DETAIL\", \"name\": \"TIP_DETAIL\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Foreign key to TIP_SUBJECT_OFFERED.TIP_SUBJECT_OFFERED_KEY\"}, \"TIP_MATERIAL_KEY\": {\"desc\": \"Foreign key to TIP_MATERIAL.TIP_MATERIAL_KEY identifying the specific textbook material\"}, \"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB'/blank keys with no description. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_SUBJECT_OFFERED.SUBJECT_ID, LIBRARY_SUBJECT_OFFERED.SUBJECT_ID, SUBJECT_SUMMARY.SUBJECT_ID\"}, \"ISBN\": {\"desc\": \"ISBN of the textbook material associated with the subject offering\"}, \"RECORD_COUNT\": {\"desc\": \"Number of material records for this subject/material combination; used in material-count statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject-material-status combination per term\", \"entity\": {\"columns\": {\"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB' = None variants. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}}}, \"reason\": \"Data verification of TIP_MATERIAL_STATUS shows 12 status values beyond the previously documented 'RQ'/'EO'; enriching the description supports material-status grouping questions such as case dw_2989 (per material status and publisher statistics).\"}, {\"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the TIP subject offered record; joins to TIP_DETAIL.TIP_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"IS_NO_COURSE_MATERIAL\": {\"desc\": \"'Y'/'N' flag whether the subject has no course material; 'N' means the subject has course materials\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '5.01'; joins to TIP_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE and STUDENT_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Chemistry', 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject; used for enrollment-based rankings and window statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in the textbook program\"}, {\"id\": \"SUBJECT_OFFERED\", \"name\": \"SUBJECT_OFFERED\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_KEY\": {\"desc\": \"Surrogate key of the subject offered record\"}, \"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_OFFERED_SUMMARY.SUBJECT_OFFERED_SUMMARY_KEY\"}, \"MASTER_SUBJECT_KEY\": {\"desc\": \"Surrogate key of the master subject record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED_SUMMARY.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the section\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SECTION_ID\": {\"desc\": \"Section identifier, e.g. 0 for the primary section\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Harvard Cross-Enrollment Prog'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time of the section\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place of the section\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code, e.g. 'S'\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description (Undergraduate/Graduate/High Graduate)\"}, \"FORM_TYPE\": {\"desc\": \"Subject form type code\"}, \"FORM_TYPE_DESC\": {\"desc\": \"Subject form type description\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"SECTION_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the section\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster the subject belongs to\"}, \"EVALUATE_THIS_SUBJECT\": {\"desc\": \"Flag whether the subject is included in evaluation\"}, \"IS_OSE_SUBJECT\": {\"desc\": \"'Y'/'N' flag for Office of Subject Evaluation subject\"}, \"IS_CREATED_BY_DATA_WAREHOUSE\": {\"desc\": \"'Y'/'N' flag whether the record was synthesized by the data warehouse\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the section\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}, \"IS_REPEATABLE_SUBJECT\": {\"desc\": \"'Y'/'N' flag whether the subject may be repeated for credit\"}}, \"default_granularity\": \"one row per subject section per term\"}, {\"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS_ALL.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2025FA' (FA=Fall, SP=Spring, JA=January/IAP, SU=Summer)\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description, e.g. 'Fall Term 2024-2025'\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date; can match TIME_DAY.CALENDAR_DATE for calendar-based joins\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to, e.g. 2025\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"IS_REGULAR_TERM\": {\"desc\": \"'Y'/'N' flag indicating a regular term (Fall/Spring) versus non-regular terms (Summer, January/IAP); only present in ACADEMIC_TERMS, not in ACADEMIC_TERMS_ALL\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"TERM_STATUS\": {\"desc\": \"Term status text: 'Previous', 'Current', 'Future', or 'Unspecified'\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to; used in degree-year statistics\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"ADD_DATE\": {\"desc\": \"Last day to add a subject in the term; only present in ACADEMIC_TERMS\"}, \"DROP_DATE\": {\"desc\": \"Last day to drop a subject in the term; only present in ACADEMIC_TERMS\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period for the term\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period for the term\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term\"}, {\"id\": \"TIP_MATERIAL_STATUS\", \"name\": \"TIP_MATERIAL_STATUS\", \"desc\": \"TIP material status lookup table decoding material status keys/codes used in TIP_DETAIL. Holds 12 status rows where key and code are identical: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and four keys ('NL', 'NS', 'NB', and a blank/space key) that share a NULL description.\", \"columns\": {\"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Surrogate key of the material status; joins to TIP_DETAIL.TIP_MATERIAL_STATUS_KEY\"}, \"TIP_MATERIAL_STATUS_CODE\": {\"desc\": \"Material status code, identical in value to TIP_MATERIAL_STATUS_KEY: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, plus NULL-description keys 'NL', 'NS', 'NB' and a blank key.\"}, \"TIP_MATERIAL_STATUS\": {\"desc\": \"Material status description text. NULL for four of the twelve keys ('NL', 'NS', 'NB', blank), so grouping by this column merges those keys into one NULL group and yields fewer distinct statuses than grouping by key.\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per material status\"}, {\"columns\": [\"TIP_DETAIL.TIP_MATERIAL_STATUS_KEY\", \"TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY\", \"LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY\", \"LIBRARY_MATERIAL_STATUS.LIBRARY_MATERIAL_STATUS_KEY\"], \"comparisons\": [{\"dimension\": \"Program\", \"detail\": \"TIP_MATERIAL_STATUS_KEY belongs to the textbook program (decoded by TIP_MATERIAL_STATUS); LIBRARY_MATERIAL_STATUS_KEY belongs to library reserve processing (decoded by LIBRARY_MATERIAL_STATUS). The two key domains are independent and must not be joined to each other.\"}, {\"dimension\": \"Value domains\", \"detail\": \"TIP statuses: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, plus 'NL'/'NS'/'NB'/blank keys with NULL descriptions. Library statuses: 'U' = Unknown, 'R' = NULL description, 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material. Both domains contain 'U' but it means 'Unknown' in each program independently.\"}, {\"dimension\": \"Usage pattern\", \"detail\": \"Fact-side filtering uses the key columns on TIP_DETAIL / LIBRARY_RESERVE_MATRL_DETAIL directly; the lookup tables provide human-readable status text when needed. Grouping by the description column instead of the key merges statuses with NULL or identical descriptions.\"}, {\"dimension\": \"Cross-domain equality risk\", \"detail\": \"Some warehouse analyses equate TIP_MATERIAL_STATUS_KEY with LIBRARY_MATERIAL_STATUS_KEY to attach per-status statistics across the two programs. Because the value domains are independent, such an equality only matches on coincidental code overlap (e.g. 'U') and carries semantic risk; results should be interpreted as code-level matching, not as a true business relationship between textbook status and library reserve status.\"}], \"decision_guide\": {\"Questions about required or optional textbooks\": \"Filter TIP_DETAIL.TIP_MATERIAL_STATUS_KEY IN ('RQ','EO'); 'RQ' for required only.\", \"Questions about library reserve material status\": \"Filter/group LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY (e.g. 'U' Unknown, 'Y' Required Course Material); decode text via LIBRARY_MATERIAL_STATUS.\", \"Questions needing status description text rather than codes\": \"Join TIP_MATERIAL_STATUS or LIBRARY_MATERIAL_STATUS on the respective key; note that description columns contain NULLs for some keys.\", \"Matching reserve materials to textbook materials\": \"Match via SUBJECT_ID + TERM_CODE (or TIP_MATERIAL_KEY paths) between TIP_DETAIL and LIBRARY_RESERVE_MATRL_DETAIL, never by equating the two status key columns.\", \"Questions about required textbooks or textbook material statuses\": \"Filter/group TIP_DETAIL.TIP_MATERIAL_STATUS_KEY (e.g. 'RQ' for Required); decode text via TIP_MATERIAL_STATUS.\"}, \"desc\": \"Material status key columns of the textbook program (TIP) and library reserve program. Both are coded status references decoded by their own lookup tables (key value equals code value), with independent value domains: TIP statuses ('RQ' Required, 'EO' Electronic options, 'RC' Recommended, 'PC' Val-u option, 'BR' Bookstore recommends, 'CL' Go to class first, 'NM' Course has no materials, 'U' Unknown, plus NULL-description keys) vs library reserve statuses ('U' Unknown, 'R' null description, 'N' Non-Required Course Material, 'O' Reserve only, 'X' No Required Textbook, 'Y' Required Course Material).\", \"id\": \"column_concept_material_status_key\", \"name\": \"Material Status Key\"}, {\"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS\", \"SUBJECT_SUMMARY.TOTAL_UNITS\", \"SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS\", \"CIS_COURSE_CATALOG.TOTAL_UNITS\", \"DRUPAL_COURSE_CATALOG.TOTAL_UNITS\"], \"comparisons\": [{\"dimension\": \"Source process\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS is the catalog-declared unit value per offering; SUBJECT_SUMMARY.TOTAL_UNITS and SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS are registrar subject-level values; CIS/DRUPAL catalog feeds carry their own copies\"}, {\"dimension\": \"Companion unit columns\", \"detail\": \"All these tables also expose LECTURE_UNITS, LAB_UNITS, and preparation units (PREPARATION_UNITS except SUBJECT_SUMMARY which uses PREP_UNITS); DESIGN_UNITS exists in COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY, CIS and DRUPAL catalogs but not in SUBJECT_OFFERED_SUMMARY\"}, {\"dimension\": \"Variability flag\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS marks subjects whose units vary; analyses of fixed-unit statistics typically filter IS_VARIABLE_UNITS='N'\"}], \"decision_guide\": {\"Unit statistics (avg/stddev/variance/geometric mean) over catalog offerings, optionally split by lecture/lab/design or filtered by variable-units flag\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS with its companion unit columns.\", \"Unit statistics tied to actual enrollment records or subject groups per term\": \"Use SUBJECT_SUMMARY.TOTAL_UNITS.\", \"Unit statistics at subject-offering rollup level with offering department/school\": \"Use SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS.\", \"Fixed-unit analyses excluding variable-unit subjects\": \"Filter COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS = 'N'.\"}, \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\", \"id\": \"column_concept_total_units\", \"name\": \"Total Credit Units\"}], \"not_found\": []}"
    },
    {
