            "arguments": "{\"entity_ids\": \n[\"TIP_DETAIL\", \"TIP_SUBJECT_OFFERED\", \"SUBJECT_OFFERED\", \"ACADEMIC_TERMS\", \"TIP_MATERIAL_STATUS\", \"column_concept_material_status_key\", \"column_concept_total_units\"]\n\n}"
