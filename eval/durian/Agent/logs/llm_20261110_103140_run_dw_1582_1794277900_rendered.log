        {
          "id": "call_37ef4537f3334814a2aba699",
          "type": "function",
          "function": {
            "name": "mysql_query",
            "arguments": "{\"sql\": \"SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, COUNT(*) AS n, VARIANCE(ccc.TOTAL_UNITS) AS var_units, STDDEV(ccc.TOTAL_UNITS) AS sd_units\\nFROM SIS_DEPARTMENT sd\\nJOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE\\nWHERE sd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS IS NOT NULL AND sd.DEPARTMENT_NAME = 'Mathematics'\\nGROUP BY sd.DEPARTMENT_NAME, sd.SCHOOL_NAME\"}"
          }
        }
