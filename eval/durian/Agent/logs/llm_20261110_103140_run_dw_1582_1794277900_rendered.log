        {
          "id": "call_d406bad36214480ca7f2c693",
          "type": "function",
          "function": {
            "name": "mysql_query",
            "arguments": "{\"sql\": \"WITH inner_cte AS (\\n  SELECT t1.SUBJECT_CODE, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t0.SCHOOL_NAME\\n  FROM SIS_DEPARTMENT t0\\n  JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE\\n  WHERE t1.ACADEMIC_YEAR = 2024 AND t1.TOTAL_UNITS = 12 AND t1.DEPARTMENT_NAME = 'Mathematics'\\n),\\nschool_counts AS (\\n  SELECT SCHOOL_NAME, COUNT(*) AS subject_count\\n  FROM inner_cte\\n  GROUP BY SCHOOL_NAME\\n  HAVING COUNT(*) >= 2\\n),\\ndept_stats AS (\\n  SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME,\\n         VARIANCE(ccc.TOTAL_UNITS) AS variance_total_units,\\n         STDDEV(ccc.TOTAL_UNITS) AS stddev_total_units\\n  FROM SIS_DEPARTMENT sd\\n  JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE\\n  WHERE sd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS IS NOT NULL\\n  GROUP BY sd.DEPARTMENT_NAME, sd.SCHOOL_NAME\\n)\\nSELECT ic.SUBJECT_CODE, ic.SUBJECT_TITLE, ic.DEPARTMENT_NAME, ic.SCHOOL_NAME,\\n       sc.subject_count, ds.variance_total_units, ds.stddev_total_units\\nFROM inner_cte ic\\nJOIN school_counts sc ON ic.SCHOOL_NAME = sc.SCHOOL_NAME\\nJOIN dept_stats ds ON ic.DEPARTMENT_NAME = ds.DEPARTMENT_NAME AND ic.SCHOOL_NAME = ds.SCHOOL_NAME\\nORDER BY ic.SCHOOL_NAME, ic.SUBJECT_CODE\"}"
