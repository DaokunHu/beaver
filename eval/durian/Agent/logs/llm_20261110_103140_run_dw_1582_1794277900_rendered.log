    {
      "role": "tool",
      "tool_call_id": "call_577a4e0105a14b47b65642ed",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject offered summary record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject; joins to SIS_SUBJECT_CODE.COURSE_NUMBER and SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'; used for school-level filtering\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"columns\": {\"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject summary record\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, COURSE_CATALOG_SUBJECT_OFFERED subject IDs\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SUBJECT_OR_CLUSTER\": {\"desc\": \"Indicator whether the row represents a subject or a cluster\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"ULT_MASTER_SUBJECT_ID\": {\"desc\": \"Ultimate master subject identifier in cluster hierarchies\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics'\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name, e.g. 'Engineering'\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREP_UNITS\": {\"desc\": \"Preparation credit units (named PREP_UNITS here vs PREPARATION_UNITS in other tables)\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the subject\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the cluster\"}, \"SUBJECT_GROUP_ID\": {\"desc\": \"Subject group identifier used for grouping related subjects\"}, \"SUBJECT_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Subject enrollment in the first week\"}, \"CLUSTER_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Cluster enrollment in the first week\"}, \"SUBJECT_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Subject enrollment in the fifth week\"}, \"CLUSTER_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Cluster enrollment in the fifth week\"}, \"SUBJECT_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the subject for credit\"}, \"SUBJECT_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the subject\"}, \"CLUSTER_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the cluster for credit\"}, \"CLUSTER_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the cluster\"}, \"SUBJECT_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the cluster\"}, \"SUBJECT_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"SUBJECT_OFFERED\", \"name\": \"SUBJECT_OFFERED\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_KEY\": {\"desc\": \"Surrogate key of the subject offered record\"}, \"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_OFFERED_SUMMARY.SUBJECT_OFFERED_SUMMARY_KEY\"}, \"MASTER_SUBJECT_KEY\": {\"desc\": \"Surrogate key of the master subject record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED_SUMMARY.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the section\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SECTION_ID\": {\"desc\": \"Section identifier, e.g. 0 for the primary section\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Harvard Cross-Enrollment Prog'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time of the section\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place of the section\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code, e.g. 'S'\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description (Undergraduate/Graduate/High Graduate)\"}, \"FORM_TYPE\": {\"desc\": \"Subject form type code\"}, \"FORM_TYPE_DESC\": {\"desc\": \"Subject form type description\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"SECTION_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the section\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster the subject belongs to\"}, \"EVALUATE_THIS_SUBJECT\": {\"desc\": \"Flag whether the subject is included in evaluation\"}, \"IS_OSE_SUBJECT\": {\"desc\": \"'Y'/'N' flag for Office of Subject Evaluation subject\"}, \"IS_CREATED_BY_DATA_WAREHOUSE\": {\"desc\": \"'Y'/'N' flag whether the record was synthesized by the data warehouse\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the section\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}, \"IS_REPEATABLE_SUBJECT\": {\"desc\": \"'Y'/'N' flag whether the subject may be repeated for credit\"}}, \"default_granularity\": \"one row per subject section per term\"}, {\"id\": \"DRUPAL_COURSE_CATALOG\", \"name\": \"DRUPAL_COURSE_CATALOG\", \"desc\": \"Drupal-sourced course catalog table: an alternative catalog feed with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags, section flags, meeting time/place), plus subject-offering reference columns (SO_SUBJECT_ID, SO_TERM_CODE, SO_TERM_DESCRIPTION, SO_CLUSTER_TYPE) linking catalog records to registrar subject offerings.\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, SUBJECT_CODE.SUBJECT_NUMBER\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject code, e.g. '18'\"}, \"SUBJECT_NUMBER\": {\"desc\": \"\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"\"}, \"DEPARTMENT_CODE\": {\"desc\": \"\"}, \"DEPARTMENT_NAME\": {\"desc\": \"\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"\"}, \"SUBJECT_TITLE\": {\"desc\": \"\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"\"}, \"LECTURE_UNITS\": {\"desc\": \"\"}, \"LAB_UNITS\": {\"desc\": \"\"}, \"PREPARATION_UNITS\": {\"desc\": \"\"}, \"TOTAL_UNITS\": {\"desc\": \"\"}, \"DESIGN_UNITS\": {\"desc\": \"\"}, \"GRADE_TYPE\": {\"desc\": \"\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"\"}, \"GRADE_RULE\": {\"desc\": \"\"}, \"GRADE_RULE_DESC\": {\"desc\": \"\"}, \"HGN_CODE\": {\"desc\": \"\"}, \"HGN_DESC\": {\"desc\": \"\"}, \"HGN_EXCEPT\": {\"desc\": \"\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"PREREQUISITES\": {\"desc\": \"\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"\"}, \"JOINT_SUBJECTS\": {\"desc\": \"\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"\"}, \"IS_OFFERED_IAP\": {\"desc\": \"\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"\"}, \"STATUS_CHANGE\": {\"desc\": \"\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"TERM_DURATION\": {\"desc\": \"\"}, \"GLOBAL_REGIONS\": {\"desc\": \"\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"\"}, \"SO_SUBJECT_ID\": {\"desc\": \"Subject ID of the linked registrar subject offering record\"}, \"SO_TERM_CODE\": {\"desc\": \"Term code of the linked subject offering record\"}, \"SO_TERM_DESCRIPTION\": {\"desc\": \"Term description of the linked subject offering record\"}, \"SO_CLUSTER_TYPE\": {\"desc\": \"Cluster type of the linked subject offering record\"}, \"SECTION_ID\": {\"desc\": \"\"}, \"IS_MASTER_SECTION\": {\"desc\": \"\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"\"}, \"IS_LAB_SECTION\": {\"desc\": \"\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"\"}, \"MEET_TIME\": {\"desc\": \"\"}, \"MEET_PLACE\": {\"desc\": \"\"}, \"TERM_CODE\": {\"desc\": \"Term code of the catalog record (column missing from this feed's list but implied by structure)\"}}, \"default_granularity\": \"one row per subject per term in the Drupal catalog feed\"}, {\"id\": \"STUDENT_DEPARTMENT\", \"name\": \"STUDENT_DEPARTMENT\", \"desc\": \"Student-facing department lookup table with department code, name, full name, and school attribution (code and name). Similar in content to SIS_DEPARTMENT but oriented to student information systems reporting; joins to offering tables via DEPARTMENT_CODE.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' OFFER_DEPT_CODE and SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to\"}}, \"default_granularity\": \"one row per department\"}, {\"id\": \"SIS_SUBJECT_CODE\", \"name\": \"SIS_SUBJECT_CODE\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\", \"columns\": {\"COURSE_NUMBER\": {\"desc\": \"Course number; joins to SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject code, e.g. '18'; joins to SIS_COURSE_DESCRIPTION.COURSE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"SUBJECT_CODE_DESC\": {\"desc\": \"Description of the subject code, typically the department/program name for that code\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering; used for school-level filtering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject code / course number\"}, {\"id\": \"column_concept_subject_id\", \"name\": \"Subject Identifier\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_ID\", \"SUBJECT_OFFERED.SUBJECT_ID\", \"SUBJECT_OFFERED_SUMMARY.SUBJECT_ID\", \"SUBJECT_SUMMARY.SUBJECT_ID\", \"TIP_DETAIL.SUBJECT_ID\", \"TIP_SUBJECT_OFFERED.SUBJECT_ID\", \"LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\", \"LIBRARY_RESERVE_MATRL_DETAIL.SUBJECT_ID\"], \"comparisons\": [{\"dimension\": \"Format\", \"detail\": \"SUBJECT_CODE + '.' + SUBJECT_NUMBER in all tables, e.g. '18.01'; can be reconstructed via CONCAT(SUBJECT_CODE, '.', SUBJECT_NUMBER)\"}, {\"dimension\": \"Grain difference\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED: catalog offering scope, one SUBJECT_ID may repeat across terms/academic years; SUBJECT_OFFERED: section scope, same SUBJECT_ID appears once per section; SUBJECT_SUMMARY / SUBJECT_OFFERED_SUMMARY: subject scope per term, one row per SUBJECT_ID per term; TIP and LIBRARY tables: program scope, SUBJECT_ID present only if the subject is tracked by that program\"}], \"decision_guide\": {\"Joining textbook materials or library reserves to catalog/summary subject attributes\": \"Match on SUBJECT_ID (plus TERM_CODE when term scope matters).\", \"Joining catalog offerings that only expose SUBJECT_CODE/SUBJECT_NUMBER to SUBJECT_ID-based tables\": \"Reconstruct SUBJECT_ID as CONCAT(SUBJECT_CODE, '.', SUBJECT_NUMBER).\", \"Counting distinct subjects per term/department\": \"Use COUNT(DISTINCT SUBJECT_ID) on a subject-grain table (SUBJECT_SUMMARY or SUBJECT_OFFERED_SUMMARY) to avoid section/program duplication.\"}}, {\"columns\": [\"ACADEMIC_TERMS.ACADEMIC_YEAR\", \"ACADEMIC_TERMS_ALL.ACADEMIC_YEAR\", \"COURSE_CATALOG_SUBJECT_OFFERED.ACADEMIC_YEAR\", \"TIME_DAY.ACADEMIC_YEAR\", \"TIME_DAY.FISCAL_YEAR\", \"TIME_DAY.CALENDAR_YEAR\", \"TIME_MONTH.ACADEMIC_YEAR\", \"TIME_MONTH.FISCAL_YEAR\", \"TIME_MONTH.CALENDAR_YEAR\", \"TIME_MONTH.FINANCIAL_AID_YEAR\", \"TIME_QUARTER.FISCAL_YEAR\", \"TIME_QUARTER.CALENDAR_YEAR\", \"ACADEMIC_TERMS.FINANCIAL_AID_YEAR\", \"ACADEMIC_TERMS_ALL.FINANCIAL_AID_YEAR\", \"ACADEMIC_TERMS.DEGREE_YEAR\"], \"comparisons\": [{\"dimension\": \"Year system\", \"detail\": \"ACADEMIC_YEAR is the academic year a term/offering/date belongs to; FISCAL_YEAR is the institute fiscal year (MIT fiscal year starts in July, so a fiscal year spans two calendar years); CALENDAR_YEAR is the natural calendar year; FINANCIAL_AID_YEAR is the aid year a term/month maps to; DEGREE_YEAR is the degree-conferral year a term maps to. These year systems do not always coincide for the same term or date.\"}, {\"dimension\": \"Location\", \"detail\": \"Term tables (ACADEMIC_TERMS/ACADEMIC_TERMS_ALL) carry academic/financial-aid/degree years per term; COURSE_CATALOG_SUBJECT_OFFERED carries its own ACADEMIC_YEAR per catalog record; the time dimension tables carry year systems at their own granularity: TIME_DAY (fiscal/calendar/academic year per day), TIME_MONTH (fiscal/calendar/academic/aid year per month), TIME_QUARTER (fiscal/calendar year per quarter, no academic year).\"}, {\"dimension\": \"Grouping behavior\", \"detail\": \"Grouping offerings by catalog ACADEMIC_YEAR vs joining to term tables' ACADEMIC_YEAR can yield different groupings when a catalog record's TERM_CODE and ACADEMIC_YEAR disagree; grouping time-dimension rows by FISCAL_YEAR vs CALENDAR_YEAR yields different period assignments for dates between January and June.\"}], \"decision_guide\": {\"Yearly statistics over subject offerings\": \"Group by COURSE_CATALOG_SUBJECT_OFFERED.ACADEMIC_YEAR when the question says 'academic year YYYY' for offerings; join term tables for term-status filters.\", \"Yearly statistics over terms themselves (e.g. degree year geometric means, financial aid year partitions)\": \"Use ACADEMIC_TERMS / ACADEMIC_TERMS_ALL year columns (DEGREE_YEAR, FINANCIAL_AID_YEAR).\", \"Matching IAP activity dates to academic years via calendar\": \"Use TIME_DAY.FISCAL_YEAR or TIME_DAY.ACADEMIC_YEAR through TERM_CODE = ACADEMIC_TERM_CODE.\", \"Windowed running sums partitioned by aid year\": \"Use ACADEMIC_TERMS_ALL.FINANCIAL_AID_YEAR as the partition key.\", \"Fiscal-year or calendar-month statistics over months/days\": \"Use TIME_MONTH.FISCAL_YEAR / TIME_MONTH.CALENDAR_YEAR (month grain) or TIME_DAY.CALENDAR_YEAR (day grain), joined on FISCAL_PERIOD when both grains are needed.\"}, \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\", \"id\": \"column_concept_year_columns\", \"name\": \"Academic and Fiscal Year Columns\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_693abbc1c5ea42b791176d6b",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per degree-granting department matched with Political Science HGN statistics\", \"desc\": \"For each department that grants degrees (excluding the Biology department), provide the department name, the average and variance of the total units for subjects offered by that department in the 2022 academic year, and, if the department is Political Science, also include for each HGN code the maximum number of lecture units among all subjects in the course catalog and the subject title from the subject offered table for subjects offered in the year 2012 with more than 2 lecture units, as well as the number of enrolled students for those subjects. List the results ordered by the variance of total units in descending order, and for Political Science, by the maximum lecture units in descending order. Do not return any rounded answers.\", \"id\": \"dw_2151\", \"name\": \"Degree-Granting Department 2022 Unit Average-Variance with Political Science HGN Lecture Unit Maximums\", \"sql\": \"WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_units, VARIANCE(s.TOTAL_UNITS) AS units_variance FROM SIS_DEPARTMENT d JOIN COURSE_CATALOG_SUBJECT_OFFERED s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE s.ACADEMIC_YEAR = 2022 AND d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_CODE <> '7' GROUP BY d.DEPARTMENT_NAME ORDER BY units_variance DESC ) , PoliSciHGNStats AS ( SELECT c.HGN_CODE, c.DEPARTMENT_NAME, MAX(c.LECTURE_UNITS) AS max_lecture_units, s.SUBJECT_TITLE, so.NUM_ENROLLED_STUDENTS FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN SUBJECT_OFFERED s ON c.HGN_CODE = s.HGN_CODE JOIN SUBJECT_OFFERED so ON s.SUBJECT_KEY = so.SUBJECT_KEY WHERE c.ACADEMIC_YEAR = 2012 AND c.LECTURE_UNITS > 2 AND c.DEPARTMENT_NAME = 'Political Science' GROUP BY c.HGN_CODE, c.DEPARTMENT_NAME, s.SUBJECT_TITLE, so.NUM_ENROLLED_STUDENTS HAVING MAX(c.LECTURE_UNITS) > 2 ) SELECT d.DEPARTMENT_NAME, d.avg_units, d.units_variance, p.HGN_CODE, p.max_lecture_units, p.SUBJECT_TITLE, p.NUM_ENROLLED_STUDENTS FROM inner_cte d LEFT JOIN PoliSciHGNStats p ON d.DEPARTMENT_NAME = p.DEPARTMENT_NAME ORDER BY d.units_variance DESC, p.max_lecture_units DESC\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department from either the Math 2008 stats branch or the high-average-units branch\", \"desc\": \"List, for each department, either (a) the department's full name, the range and variance of the total units for degree-granting Mathematics department courses offered in the 2008 academic year along with the long course description for each course (with the reason 'Math 2008 Stats'), or (b) the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units) where the average total units is greater than the overall average across all departments (with the reason 'High Avg Units'). Show the columns in the following order: department name, total units range, total units variance, average total units, standard deviation (using STDDEV only and never STDDEV_POP) of total units, long course description, and reason for inclusion. Do not return any rounded answers.\", \"id\": \"dw_1335\", \"name\": \"Union of Math 2008 Unit Range-Variance with Long Descriptions and High Average Unit Department Stddev\", \"sql\": \"WITH Subquery1 AS ( WITH inner_cte AS ( SELECT sd.DEPARTMENT_FULL_NAME, MAX(ccc.TOTAL_UNITS) - MIN(ccc.TOTAL_UNITS) AS total_units_range, VARIANCE(ccc.TOTAL_UNITS) AS total_units_variance FROM CIS_COURSE_CATALOG ccc JOIN SIS_DEPARTMENT sd ON ccc.DEPARTMENT_CODE = sd.DEPARTMENT_CODE WHERE ccc.ACADEMIC_YEAR = '2008' AND sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' AND ccc.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_FULL_NAME ) SELECT i.DEPARTMENT_FULL_NAME, i.total_units_range, i.total_units_variance, scd.COURSE_DESCRIPTION_LONG FROM inner_cte i JOIN SIS_COURSE_DESCRIPTION scd ON scd.DEPARTMENT = 18 AND scd.DEPARTMENT_NAME = 'Mathematics' ), Subquery2 AS ( WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, AVG(sos.TOTAL_UNITS) AS avg_total_units, STDDEV(sos.TOTAL_UNITS) AS stddev_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SUBJECT_OFFERED_SUMMARY sos ON scd.COURSE = sos.COURSE_NUMBER WHERE sos.TOTAL_UNITS > 0 GROUP BY scd.DEPARTMENT_NAME ) SELECT DEPARTMENT_NAME, avg_total_units, stddev_total_units FROM inner_cte WHERE avg_total_units > ( SELECT AVG(TOTAL_UNITS) FROM SUBJECT_OFFERED_SUMMARY WHERE TOTAL_UNITS > 0 ) ORDER BY stddev_total_units DESC ), CombinedResults AS ( SELECT s1.DEPARTMENT_FULL_NAME AS DEPARTMENT_NAME, s1.total_units_range, s1.total_units_variance, NULL AS avg_total_units, NULL AS stddev_total_units, s1.COURSE_DESCRIPTION_LONG, 'Math 2008 Stats' AS Reason FROM Subquery1 s1 UNION ALL SELECT s2.DEPARTMENT_NAME, NULL AS total_units_range, NULL AS total_units_variance, s2.avg_total_units, s2.stddev_total_units, NULL AS COURSE_DESCRIPTION_LONG, 'High Avg Units' AS Reason FROM Subquery2 s2 ) SELECT * FROM CombinedResults ORDER BY DEPARTMENT_NAME;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per course level of the Mathematics department\", \"desc\": \"For the Mathematics department, what is the department name, the average of the total units, the range of the total units, the variance of the total units for courses with total units greater than 0, and for each course level, what is the number of unique students and the minimum CIP program code among their courses, considering only degree-granting departments? Additionally, for each course level, what is the average number of lecture units and the maximum number of lab units for Mathematics courses? Do not return any rounded answers.\", \"id\": \"dw_2272\", \"name\": \"Math Department Unit Statistics with Course Level Student Counts and Lecture-Lab Unit Averages\", \"sql\": \"WITH inner_cte AS ( WITH department_units_stats AS ( SELECT SIS_DEPARTMENT.DEPARTMENT_NAME, AVG(CIS_COURSE_CATALOG.TOTAL_UNITS) AS avg_total_units, MAX(CIS_COURSE_CATALOG.TOTAL_UNITS) - MIN(CIS_COURSE_CATALOG.TOTAL_UNITS) AS total_units_range, VARIANCE(CIS_COURSE_CATALOG.TOTAL_UNITS) AS total_units_variance FROM SIS_DEPARTMENT JOIN CIS_COURSE_CATALOG ON SIS_DEPARTMENT.DEPARTMENT_CODE = CIS_COURSE_CATALOG.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE ON CIS_COURSE_CATALOG.DEPARTMENT_CODE = SIS_SUBJECT_CODE.DEPARTMENT_CODE WHERE CIS_COURSE_CATALOG.TOTAL_UNITS > 0 AND SIS_DEPARTMENT.IS_DEGREE_GRANTING = 'Y' AND SIS_DEPARTMENT.DEPARTMENT_NAME = 'Mathematics' AND SIS_DEPARTMENT.DEPARTMENT_CODE = '18' GROUP BY SIS_DEPARTMENT.DEPARTMENT_NAME ORDER BY total_units_range DESC ), department_student_cip_stats AS ( SELECT sd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT msd.FULL_NAME) AS student_count, MIN(scd.CIP_PROGRAM_CODE) AS min_cip_code FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY sd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT dus.DEPARTMENT_NAME, dus.avg_total_units, dus.total_units_range, dus.total_units_variance, dscs.COURSE_LEVEL, dscs.student_count, dscs.min_cip_code FROM department_units_stats dus JOIN department_student_cip_stats dscs ON dus.DEPARTMENT_NAME = dscs.DEPARTMENT_NAME ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.avg_total_units, inner_cte.total_units_range, inner_cte.total_units_variance, inner_cte.COURSE_LEVEL, inner_cte.student_count, inner_cte.min_cip_code, stats.avg_lecture_units, stats.max_lab_units FROM inner_cte JOIN ( SELECT scd.COURSE_LEVEL, AVG(ccc.LECTURE_UNITS) AS avg_lecture_units, MAX(ccc.LAB_UNITS) AS max_lab_units FROM SIS_COURSE_DESCRIPTION scd JOIN CIS_COURSE_CATALOG ccc ON scd.DEPARTMENT = ccc.DEPARTMENT_CODE WHERE scd.DEPARTMENT_NAME = 'Mathematics' AND ccc.DEPARTMENT_CODE = '18' AND ccc.TOTAL_UNITS > 0 GROUP BY scd.COURSE_LEVEL ) stats ON inner_cte.COURSE_LEVEL = stats.COURSE_LEVEL;\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics department combining subject unit statistics with graduate student counts\", \"desc\": \"For the Mathematics department (Course 18), provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student), the number of graduate students in the department, and the most recent warehouse load date for those students, considering only departments that are degree granting and students whose year is 'G'. Do not return any rounded answers.\", \"id\": \"dw_1212\", \"name\": \"Math Department Subject Unit Average-Stddev with Graduate Student Count and Latest Load Date\", \"sql\": \"WITH DeptUnits AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_total_units, STDDEV(s.TOTAL_UNITS) AS stddev_total_units FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.TOTAL_UNITS > 0 AND s.NUM_ENROLLED_STUDENTS >= 1 AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME ORDER BY stddev_total_units DESC ), DeptStudents AS ( SELECT sd.DEPARTMENT_NAME, COUNT(msd.FULL_NAME) AS student_count, MAX(msd.WAREHOUSE_LOAD_DATE) AS latest_student_load FROM SIS_DEPARTMENT sd JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT JOIN SIS_ADMIN_DEPARTMENT sad ON msd.DEPARTMENT = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND msd.STUDENT_YEAR = 'G' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_NAME ORDER BY student_count DESC LIMIT 10 ) SELECT du.DEPARTMENT_NAME, du.avg_total_units, du.stddev_total_units, ds.student_count, ds.latest_student_load FROM DeptUnits du JOIN DeptStudents ds ON du.DEPARTMENT_NAME = ds.DEPARTMENT_NAME;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level, where the total number of enrolled students in offered subjects is greater than 10, and the department is Mathematics (Course 18), provide the number of unique courses, the minimum total units among those subjects that are degree-granting courses, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for Mathematics courses (considering only departments that offer more than five courses), and the number of unique subject codes for Mathematics in the SIS_SUBJECT_CODE table. List the department name, course level, number of unique courses, minimum total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the number of unique subject codes, in that order. Do not return any rounded answers.\", \"id\": \"dw_2335\", \"name\": \"Math Degree-Granting Course Level Counts with Catalog Unit Stddev and Unique Subject Codes\", \"sql\": \"WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, c.COURSE_LEVEL, COUNT(DISTINCT c.COURSE) AS course_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.NUM_ENROLLED_STUDENTS > 10 AND d.DEPARTMENT_NAME = 'Mathematics' AND c.IS_DEGREE_GRANTING = 'Y' GROUP BY d.DEPARTMENT_NAME, c.COURSE_LEVEL ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.COURSE_LEVEL, inner_cte.course_count, inner_cte.min_total_units, subq2.units_stddev, subq3.unique_subject_codes FROM inner_cte JOIN ( SELECT s.DEPARTMENT_NAME, STDDEV(c.TOTAL_UNITS) AS units_stddev FROM SIS_SUBJECT_CODE s JOIN CIS_COURSE_CATALOG c ON s.DEPARTMENT_CODE = c.DEPARTMENT_CODE WHERE c.TOTAL_UNITS IS NOT NULL AND s.DEPARTMENT_NAME = 'Mathematics' GROUP BY s.DEPARTMENT_NAME HAVING COUNT(*) > 5 ) subq2 ON inner_cte.DEPARTMENT_NAME = subq2.DEPARTMENT_NAME JOIN ( SELECT DEPARTMENT_NAME, COUNT(DISTINCT SUBJECT_CODE) AS unique_subject_codes FROM SIS_SUBJECT_CODE WHERE DEPARTMENT_NAME = 'Mathematics' GROUP BY DEPARTMENT_NAME ) subq3 ON inner_cte.DEPARTMENT_NAME = subq3.DEPARTMENT_NAME;\"}, {\"id\": \"dw_41\", \"name\": \"Yearly Average and Variance of Math Full-Term Subject Total Units in Previous Terms\", \"desc\": \"For each academic year, provide the academic year description and calculate the average and variance of the total units for subjects offered in terms that are not the current term, have a term status indicator of 'P', are offered by the Mathematics department, and are full term subjects. Do not return any rounded answers.\", \"category\": \"Subject Offering Analysis\", \"sql\": \"WITH inner_cte AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, AVG(ccso.TOTAL_UNITS) AS avg_total_units, VARIANCE(ccso.TOTAL_UNITS) AS total_units_variance FROM ACADEMIC_TERMS_ALL ata JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE ata.IS_CURRENT_TERM = 'N' AND ata.TERM_STATUS_INDICATOR = 'P' AND ccso.DEPARTMENT_NAME = 'Mathematics' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC ) SELECT ic.ACADEMIC_YEAR, ic.ACADEMIC_YEAR_DESC, ic.avg_total_units, ic.total_units_variance FROM inner_cte ic JOIN ACADEMIC_TERMS_ALL ata ON ic.ACADEMIC_YEAR = ata.ACADEMIC_YEAR JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE ccso.TERM_DURATION = 'Full Term Subject' GROUP BY ic.ACADEMIC_YEAR, ic.ACADEMIC_YEAR_DESC, ic.avg_total_units, ic.total_units_variance ORDER BY ic.total_units_variance DESC;\", \"default_granularity\": \"one row per academic year\"}, {\"id\": \"dw_104\", \"name\": \"Math 2022 Bulletin-Printed Subject Total Units Deviation from Department Average\", \"desc\": \"For subjects offered in the academic year 2022 that are printed in the bulletin and belong to the Mathematics department (Course 18), show the subject title, department name, total units, and the difference between the total units of each subject and the average total units for Mathematics subjects in 2022. Do not return any rounded answers.\", \"category\": \"Course Catalog and Department Analysis\", \"sql\": \"WITH inner_cte AS ( SELECT c.SUBJECT_TITLE, d.DEPARTMENT_NAME, c.TOTAL_UNITS FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT_CODE = d.DEPARTMENT_CODE WHERE c.ACADEMIC_YEAR = 2022 AND c.IS_PRINTED_IN_BULLETIN = 'Y' AND c.DEPARTMENT_CODE = '18' AND d.DEPARTMENT_NAME = 'Mathematics' ) , avg_units AS ( SELECT AVG(TOTAL_UNITS) AS avg_total_units FROM inner_cte ) SELECT i.SUBJECT_TITLE, i.DEPARTMENT_NAME, i.TOTAL_UNITS, (i.TOTAL_UNITS - a.avg_total_units) AS deviation_from_avg_units FROM inner_cte i CROSS JOIN avg_units a;\", \"default_granularity\": \"one row per bulletin-printed Mathematics subject offered in 2022\"}, {\"id\": \"dw_359\", \"name\": \"Yearly Math Lecture Units Above One Stddev with Undergraduate Majority\", \"category\": \"Subject Offering Analysis\", \"desc\": \"For each academic year, what is the total number of lecture units for all subjects offered in regular terms by the Mathematics department (Course 18), where at least 60% of those subjects are undergraduate-level (HGN_DESC = 'Undergraduate'), considering only those academic years where the total lecture units are more than one standard deviation (using STDDEV only and never STDDEV_POP) above the mean total lecture units across all academic years? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT at_all.ACADEMIC_YEAR, ccso.SUBJECT_ID, ccso.HGN_DESC, ccso.LECTURE_UNITS FROM ACADEMIC_TERMS_ALL at_all JOIN ACADEMIC_TERMS at ON at_all.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE at.IS_REGULAR_TERM = 'Y' AND ccso.DEPARTMENT_NAME = 'Mathematics' ), YearlyTotals AS ( SELECT ACADEMIC_YEAR, SUM(LECTURE_UNITS) AS total_lecture_units FROM inner_cte GROUP BY ACADEMIC_YEAR ), YearlyUndergradCounts AS ( SELECT ACADEMIC_YEAR, COUNT(CASE WHEN HGN_DESC = 'Undergraduate' THEN 1 END) AS undergrad_count, COUNT(*) AS total_count FROM inner_cte GROUP BY ACADEMIC_YEAR ), FilteredYears AS ( SELECT yt.ACADEMIC_YEAR, yt.total_lecture_units, yuc.undergrad_count, yuc.total_count FROM YearlyTotals yt JOIN YearlyUndergradCounts yuc ON yt.ACADEMIC_YEAR = yuc.ACADEMIC_YEAR WHERE CASE WHEN yuc.total_count > 0 THEN (1.0 * yuc.undergrad_count / yuc.total_count) ELSE 0 END >= 0.6 ) SELECT fy.ACADEMIC_YEAR, fy.total_lecture_units FROM FilteredYears fy WHERE fy.total_lecture_units > ( SELECT AVG(total_lecture_units) + STDDEV(total_lecture_units) FROM YearlyTotals ) ;\", \"default_granularity\": \"one row per academic year\"}, {\"id\": \"dw_3644\", \"name\": \"2012SU 1-Unit Subject Row Numbers per Department with Department Offered Summary Unit Average-Stddev\", \"desc\": \"For subjects offered in the 2012SU term with a total of 1 unit, show the subject title from the summary, the course number from the offered table, the subject title from the offered summary, the department name from the summary, the offer department name from the offered summary, the row number within each department name group ordered by subject title from the summary, and for each department, also provide the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student). List the results ordered by department name and row number. Do not return any rounded answers.\", \"sql\": \"WITH subq1 AS ( SELECT t2.SUBJECT_TITLE AS summary_subject_title, t1.COURSE_NUMBER, t0.SUBJECT_TITLE AS offered_summary_subject_title, t2.DEPARTMENT_NAME, t0.OFFER_DEPT_NAME, ROW_NUMBER() OVER (PARTITION BY t2.DEPARTMENT_NAME ORDER BY t2.SUBJECT_TITLE) AS window_column FROM SUBJECT_OFFERED_SUMMARY t0 JOIN SUBJECT_OFFERED t1 ON t0.SUBJECT_ID_SORT = t1.SUBJECT_ID_SORT JOIN SUBJECT_SUMMARY t2 ON t1.SUBJECT_ID_SORT = t2.SUBJECT_ID_SORT WHERE t1.TERM_CODE = '2012SU' AND t2.TOTAL_UNITS = 1 ), subq2 AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_total_units, STDDEV(s.TOTAL_UNITS) AS stddev_total_units FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.TOTAL_UNITS > 0 AND s.NUM_ENROLLED_STUDENTS >= 1 GROUP BY d.DEPARTMENT_NAME ORDER BY stddev_total_units DESC ) SELECT subq1.summary_subject_title, subq1.COURSE_NUMBER, subq1.offered_summary_subject_title, subq1.DEPARTMENT_NAME, subq1.OFFER_DEPT_NAME, subq1.window_column, subq2.avg_total_units, subq2.stddev_total_units FROM subq1 LEFT JOIN subq2 ON subq1.DEPARTMENT_NAME = subq2.DEPARTMENT_NAME ORDER BY subq1.DEPARTMENT_NAME, subq1.window_column;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2012SU 1-unit subject (via SUBJECT_ID_SORT chain across offering tables) left joined with its department's total-units average and standard deviation\"}, {\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per department per academic year\", \"desc\": \"For each academic year, among subjects that are not repeatable, what is the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by each department? List the academic year, department name, average enrollment, variance, and standard deviation (using STDDEV only and never STDDEV_POP), ordered by variance descending. Do not return any rounded answers.\", \"id\": \"dw_2958\", \"name\": \"Non-Repeatable Subject Enrollment Average Variance Stddev by Department and Year\", \"sql\": \"WITH inner_cte AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, SUBJECT_OFFERED.OFFER_DEPT_NAME, SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS FROM SUBJECT_OFFERED JOIN ACADEMIC_TERMS ON SUBJECT_OFFERED.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE SUBJECT_OFFERED.IS_REPEATABLE_SUBJECT = 'N' ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.OFFER_DEPT_NAME, AVG(inner_cte.NUM_ENROLLED_STUDENTS) AS avg_enrollment, VARIANCE(inner_cte.NUM_ENROLLED_STUDENTS) AS enrollment_variance, STDDEV(inner_cte.NUM_ENROLLED_STUDENTS) AS enrollment_stddev FROM inner_cte GROUP BY inner_cte.ACADEMIC_YEAR, inner_cte.OFFER_DEPT_NAME ORDER BY enrollment_variance DESC;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department per subject code\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\", \"id\": \"dw_4756\", \"name\": \"Department Course Counts with 2022 12-Unit Subjects Having Textbooks\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ) SELECT sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL, Total_Courses.Total_Courses, COALESCE(SubjectsWithTextbooks.Subjects_With_Textbooks, 0) AS Subjects_With_Textbooks_2022_12units FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER JOIN ( SELECT sd.DEPARTMENT_NAME, COUNT(DISTINCT COURSE_NUMBER) AS Total_Courses FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER GROUP BY sd.DEPARTMENT_NAME ) AS Total_Courses ON sd.DEPARTMENT_NAME = Total_Courses.DEPARTMENT_NAME LEFT JOIN ( SELECT s1.DEPARTMENT_NAME, COUNT(DISTINCT s1.SUBJECT_CODE || '-' || s1.SUBJECT_NUMBER) AS Subjects_With_Textbooks FROM inner_cte s1 JOIN TIP_DETAIL t2 ON s1.TERM_CODE = t2.TERM_CODE AND s1.SUBJECT_ID = t2.SUBJECT_ID WHERE t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') GROUP BY s1.DEPARTMENT_NAME ) AS SubjectsWithTextbooks ON sd.DEPARTMENT_NAME = SubjectsWithTextbooks.DEPARTMENT_NAME ;\"}, {\"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"single aggregate count\", \"desc\": \"How many subjects in the course catalog are offered in the spring term, have a total of at least 6 units, are taught by faculty who are responsible for at least one subject with more than 0 enrolled students according to the subject offered summary, and are in the Mathematics department (Course 18)? Do not return any rounded answers.\", \"id\": \"dw_5150\", \"name\": \"Count of Spring Math Catalog Subjects with 6+ Units Taught by Faculty with Enrolled Subject Offerings\", \"sql\": \"SELECT COUNT(*) AS spring_subjects_with_enrollment FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN SUBJECT_OFFERED s ON c.RESPONSIBLE_FACULTY_MIT_ID = s.RESPONSIBLE_FACULTY_MIT_ID JOIN SUBJECT_OFFERED_SUMMARY ss ON s.RESPONSIBLE_FACULTY_MIT_ID = ss.RESPONSIBLE_FACULTY_MIT_ID WHERE c.IS_OFFERED_SPRING_TERM = 'Y' AND c.TOTAL_UNITS >= 6 AND ss.NUM_ENROLLED_STUDENTS > 0 AND c.DEPARTMENT_NAME = 'Mathematics';\"}], \"not_found\": []}"
    },
