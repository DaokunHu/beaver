umn, fo.ORGANIZATION_NAME, fo.HR_DEPARTMENT_NAME, fo.HR_DEPARTMENT_CODE, fo.HR_DEPARTMENT_NAME_LONG, fo.HR_ORG_UNIT_LEVEL, fo.window_column AS org_window_column FROM RoomMajorUse rm JOIN FilteredOrgs fo ON rm.FCLT_ORGANIZATION_KEY = fo.FCLT_ORGANIZATION_KEY ORDER BY rm.DESCRIPTION, rm.BUILDING_ROOM, fo.ORGANIZATION_NAME\", \"children\": [{\"entity_type\": \"table\", \"id\": \"FCLT_MAJOR_USE\", \"name\": \"FCLT_MAJOR_USE\"}, {\"entity_type\": \"table\", \"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\"}, {\"entity_type\": \"table\", \"id\": \"FCLT_ROOMS\", \"name\": \"FCLT_ROOMS\"}, {\"entity_type\": \"table\", \"id\": \"HR_ORG_UNIT\", \"name\": \"HR_ORG_UNIT\"}, {\"entity_type\": \"table\", \"id\": \"MASTER_DEPT_HIERARCHY\", \"name\": \"MASTER_DEPT_HIERARCHY\"}]}}"
