    {
      "role": "tool",
      "tool_call_id": "call_57a850f8a2b44c739da23106",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"lineage\": {\"metric_id\": \"dw_4387\", \"name\": \"Engineering Departments Above-Average Enrollment with Highest Regular-Term Average Units\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"sql\": \"WITH highest_avg_units AS ( WITH inner_cte AS ( SELECT c.DEPARTMENT_NAME, t.TERM_CODE, AVG(c.TOTAL_UNITS) AS avg_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS t ON c.TERM_CODE = t.TERM_CODE WHERE t.IS_REGULAR_TERM = 'Y' GROUP BY c.DEPARTMENT_NAME, t.TERM_CODE ) SELECT DEPARTMENT_NAME, MAX(avg_total_units) AS highest_avg_total_units FROM inner_cte GROUP BY DEPARTMENT_NAME ORDER BY highest_avg_total_units DESC ), eng_dept_enrollment AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) SELECT i.DEPARTMENT_NAME, i.total_enrollment FROM inner_cte i JOIN ( SELECT AVG(total_enrollment) AS avg_enrollment FROM ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) sub ) a ON i.total_enrollment > a.avg_enrollment ) SELECT e.DEPARTMENT_NAME, e.total_enrollment, h.highest_avg_total_units FROM eng_dept_enrollment e LEFT JOIN highest_avg_units h ON e.DEPARTMENT_NAME = h.DEPARTMENT_NAME ORDER BY e.total_enrollment DESC;\", \"children\": [{\"entity_type\": \"table\", \"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\"}, {\"entity_type\": \"table\", \"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\"}, {\"entity_type\": \"table\", \"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\"}, {\"entity_type\": \"table\", \"id\": \"STUDENT_DEPARTMENT\", \"name\": \"STUDENT_DEPARTMENT\"}, {\"entity_type\": \"table\", \"id\": \"SUBJECT_OFFERED\", \"name\": \"SUBJECT_OFFERED\"}, {\"entity_type\": \"table\", \"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\"}]}}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_d791419ec12b45cc976863fd",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"lineage\": {\"metric_id\": \"dw_359\", \"name\": \"Yearly Math Lecture Units Above One Stddev with Undergraduate Majority\", \"category\": \"Subject Offering Analysis\", \"sql\": \"WITH inner_cte AS ( SELECT at_all.ACADEMIC_YEAR, ccso.SUBJECT_ID, ccso.HGN_DESC, ccso.LECTURE_UNITS FROM ACADEMIC_TERMS_ALL at_all JOIN ACADEMIC_TERMS at ON at_all.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE at.IS_REGULAR_TERM = 'Y' AND ccso.DEPARTMENT_NAME = 'Mathematics' ), YearlyTotals AS ( SELECT ACADEMIC_YEAR, SUM(LECTURE_UNITS) AS total_lecture_units FROM inner_cte GROUP BY ACADEMIC_YEAR ), YearlyUndergradCounts AS ( SELECT ACADEMIC_YEAR, COUNT(CASE WHEN HGN_DESC = 'Undergraduate' THEN 1 END) AS undergrad_count, COUNT(*) AS total_count FROM inner_cte GROUP BY ACADEMIC_YEAR ), FilteredYears AS ( SELECT yt.ACADEMIC_YEAR, yt.total_lecture_units, yuc.undergrad_count, yuc.total_count FROM YearlyTotals yt JOIN YearlyUndergradCounts yuc ON yt.ACADEMIC_YEAR = yuc.ACADEMIC_YEAR WHERE CASE WHEN yuc.total_count > 0 THEN (1.0 * yuc.undergrad_count / yuc.total_count) ELSE 0 END >= 0.6 ) SELECT fy.ACADEMIC_YEAR, fy.total_lecture_units FROM FilteredYears fy WHERE fy.total_lecture_units > ( SELECT AVG(total_lecture_units) + STDDEV(total_lecture_units) FROM YearlyTotals ) ;\", \"children\": [{\"entity_type\": \"table\", \"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\"}, {\"entity_type\": \"table\", \"id\": \"ACADEMIC_TERMS_ALL\", \"name\": \"ACADEMIC_TERMS_ALL\"}, {\"entity_type\": \"table\", \"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\"}, {\"entity_type\": \"table\", \"id\": \"SUBJECT_OFFERED\", \"name\": \"SUBJECT_OFFERED\"}]}}"
    },
