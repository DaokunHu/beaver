    {
      "role": "tool",
      "tool_call_id": "call_2c6a008d6e694681ba09f930",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"FCLT_ROOMS\", \"name\": \"FCLT_ROOMS\", \"desc\": \"Facilities room inventory table: one row per physical room with building/floor keys, room identifiers, use classifications (major/minor use), organization assignment, area in square meters, access level, and geographic coordinates. Joins to FCLT_BUILDING via FCLT_BUILDING_KEY; referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE via FCLT_ROOM_KEY.\", \"columns\": {\"FCLT_ROOM_KEY\": {\"desc\": \"Surrogate key of the room; joins to COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE for class-meeting location analysis\"}, \"BUILDING_ROOM\": {\"desc\": \"Combined building-room identifier\"}, \"FCLT_BUILDING_KEY\": {\"desc\": \"Building identifier key of the room, storing the building number/code itself (e.g. 'E38', '14N'); can be filtered directly for a building or joined to FCLT_BUILDING.FCLT_BUILDING_KEY for building attributes\"}, \"FLOOR\": {\"desc\": \"Floor the room is on\"}, \"FCLT_FLOOR_KEY\": {\"desc\": \"Foreign key to FCLT_FLOOR\"}, \"ROOM\": {\"desc\": \"Room number/name\"}, \"SPACE_ID\": {\"desc\": \"Space identifier\"}, \"FCLT_MAJOR_USE_KEY\": {\"desc\": \"Major use key of the room; joins to FCLT_MAJOR_USE.FCLT_MAJOR_USE_KEY to decode the major use code/description and assignable flag\"}, \"MAJOR_USE_DESC\": {\"desc\": \"Major use description, e.g. classroom\"}, \"FCLT_USE_KEY\": {\"desc\": \"\"}, \"USE_DESC\": {\"desc\": \"Use description of the room\"}, \"FCLT_MINOR_USE_KEY\": {\"desc\": \"Minor use key of the room\"}, \"MINOR_USE_DESC\": {\"desc\": \"Minor use description\"}, \"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Organization key of the room\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Organization name occupying the room\"}, \"FCLT_MINOR_ORGANIZATION_KEY\": {\"desc\": \"Minor organization key of the room\"}, \"MINOR_ORGANIZATION\": {\"desc\": \"Minor organization name\"}, \"AREA\": {\"desc\": \"Room area in square meters; used in area statistics (average, range, variance)\"}, \"ROOM_FULL_NAME\": {\"desc\": \"Full room name\"}, \"DEPT_CODE\": {\"desc\": \"Department code assigned to the room\"}, \"ACCESS_LEVEL\": {\"desc\": \"Numeric access level code of the room (observed values 0-3); used to filter rooms by access restriction level, e.g. ACCESS_LEVEL = 1\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS)\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS)\"}, \"NORTHING_SPCS\": {\"desc\": \"Northing coordinate (SPCS)\"}, \"EASTING_SPCS\": {\"desc\": \"Easting coordinate (SPCS)\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per room\"}, {\"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Surrogate key of the facilities organization; joins to SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY\"}, \"ORGANIZATION_ID\": {\"desc\": \"Organization identifier (same value as the organization key in current data)\"}, \"ORGANIZATION\": {\"desc\": \"Short organization abbreviation, e.g. 'AERO', 'ADMISS'\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Display name of the organization, e.g. 'AERO & ASTRO'; used for organization-name reporting\"}, \"FCLT_ORG_PARENT_KEY\": {\"desc\": \"Key of the parent organization in the hierarchy tree; null for the top-level organization\"}, \"ORG_PARENT\": {\"desc\": \"Abbreviation of the parent organization, e.g. 'S ENG' (School of Engineering)\"}, \"FCLT_MAJOR_ORG_KEY\": {\"desc\": \"Key of the major (top-level grouping) organization this organization rolls up to\"}, \"MAJOR_ORG\": {\"desc\": \"Abbreviation of the major organization, e.g. 'PROVST', 'CHNCLR'\"}, \"ORGANIZATION_LEVEL\": {\"desc\": \"Level of the organization in the hierarchy tree (1 = institute-wide root, 2-4 = intermediate divisions/schools, 5 = department/DLC level, 6 = sub-organization); stored as string, filter with values like '5'\"}, \"ORGANIZATION_NUMBER\": {\"desc\": \"Official organization number used in administrative systems\"}, \"ORGANIZATION_SORT\": {\"desc\": \"Sortable hierarchical organization code reflecting the tree path\"}, \"ASSIGNABLE\": {\"desc\": \"Flag ('1'/'0') indicating whether the organization is an assignable-space organizational unit\"}, \"COURSE\": {\"desc\": \"Academic course (department) number for degree-granting academic departments, e.g. '16' for Aeronautics and Astronautics; null for non-academic organizations\"}, \"DESCRIPTION\": {\"desc\": \"Long description of the organization, e.g. 'Department of Aeronautics and Astronautics'; null for many non-academic organizations\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_AEROASTRO'; joins to FCLT_ORG_DLC_KEY.DLC_KEY, HR_ORG_UNIT.DLC_KEY (for HR org unit title/level and HR department attributes; may fan out when a DLC maps to multiple HR org units), and MASTER_DEPT_HIERARCHY.DLC_KEY (for the standard department hierarchy path)\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Aeronautics and Astronautics'\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code cross-reference\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"HR organization unit identifier cross-reference; links to HR_ORG_UNIT\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"Department name as recorded in HR systems\"}}, \"default_granularity\": \"one row per facilities organization\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}, {\"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS_ALL.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2025FA' (FA=Fall, SP=Spring, JA=January/IAP, SU=Summer)\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description, e.g. 'Fall Term 2024-2025'\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date; can match TIME_DAY.CALENDAR_DATE for calendar-based joins\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to, e.g. 2025\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"IS_REGULAR_TERM\": {\"desc\": \"'Y'/'N' flag indicating a regular term (Fall/Spring) versus non-regular terms (Summer, January/IAP); only present in ACADEMIC_TERMS, not in ACADEMIC_TERMS_ALL\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"TERM_STATUS\": {\"desc\": \"Term status text: 'Previous', 'Current', 'Future', or 'Unspecified'\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to; used in degree-year statistics\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"ADD_DATE\": {\"desc\": \"Last day to add a subject in the term; only present in ACADEMIC_TERMS\"}, \"DROP_DATE\": {\"desc\": \"Last day to drop a subject in the term; only present in ACADEMIC_TERMS\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period for the term\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period for the term\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_adec3a66b29e4044af20531d",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 15, \"items_by_type\": {\"metric\": [{\"id\": \"dw_1833\", \"desc\": \"For each department and subject grade type where the subject is offered in the current academic year, is letter graded, and the department is Mathematics (Course 18), provide the number of subjects, the minimum total units, the school name, the department phone number, the organization name, the standard deviation (using STDDEV only and never STDDEV_POP) of the areas of its rooms, and the department's DLC name, including subtotals for each department (the corresponding department field is 'SUBTOTAL') and a grand total across all departments (the corresponding department field is 'TOTAL'). Do not repeat the department if it is the same as the previous row. Only include organizations that have more than 5 rooms, are associated with a non-null DLC key, and are not the 'ADMISSIONS' department or the 'Political Science' department. Sort the table by department, grade type, and descending standard deviation (using STDDEV only and never STDDEV_POP) of room areas. Do not return any rounded answers.\"}, {\"id\": \"dw_1393\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_2559\", \"desc\": \"For each DLC whose DLC name contains the word 'Office', is not the biology department, and has at least one assignable organization, what are the DLC key, DLC name, the number of unique organizations, the total number of assignable organizations, the department name, the maximum organization number, the name of the space unit associated with that department, and the earliest warehouse load date among its organizations, considering only departments in the \\\"Provost Area\\\" with a maximum organization number greater than 50000 and excluding the \\\"Political Science\\\" department (Course 17)? Do not return any rounded answers.\"}, {\"id\": \"dw_4061\", \"desc\": \"For each department and academic year, show the department name, academic year, academic year description, and the geometric mean of the total units for all subjects offered by the department in regular terms with total units greater than zero, along with, for each academic building where these subjects are held and which has rooms larger than 40 square meters, the building name, the average, range, and variance of the room areas, as well as the total assignable area of the building and the year the building was built. The results are ordered by department name, academic year (descending), and room area range (descending). Do not return any rounded answers.\"}, {\"id\": \"dw_2958\", \"desc\": \"For each academic year, among subjects that are not repeatable, what is the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by each department? List the academic year, department name, average enrollment, variance, and standard deviation (using STDDEV only and never STDDEV_POP), ordered by variance descending. Do not return any rounded answers.\"}, {\"id\": \"dw_1488\", \"desc\": \"For each academic building at MIT and each of its floors with total assignable area greater than 5000 and at least one room with access level 1 or 2, provide the building's long name, the floor number, the range and variance of the area of rooms on that floor (considering only rooms with access level 1 or 2), the range and variance of the assignable area of its floors that have at least one room, and the total number of rooms in the building. Do not return any rounded answers.\"}, {\"id\": \"dw_1190\", \"desc\": \"For each building where the building type is 'ACADEMIC', the building is not the Brown Building, and the building has more than 3 historical records, give the building name, the standard deviation (using STDDEV only and never STDDEV_POP) of the assignable area across its historical records, the average area of its rooms, and the variance of the area of its rooms, including only buildings that are academic buildings or have building number '32'. List the results in descending order of the standard deviation (using STDDEV only and never STDDEV_POP) of the assignable area. Do not return any rounded answers.\"}, {\"id\": \"dw_3356\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', what are the subject title, the offering department name, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only departments that grant degrees and subjects with a non-null subject code description), and the count of reserved materials? Please provide the subject title, the offering department name, the variance, the standard deviation (using STDDEV only and never STDDEV_POP), and the count of reserved materials, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_3311\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\"}, {\"id\": \"dw_4640\", \"desc\": \"For each subject offered in the term '2017JA', what is the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code, the coefficient of variation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in the subjects offered by that department (considering only subjects with at least one enrolled student), and the department's school code? Do not return any rounded answers.\"}, {\"id\": \"dw_488\", \"desc\": \"Among all academic buildings at MIT, which building use type has the largest variance in room area, and what is the name of the building with the largest total room area for that use type? Show the building use, the area variance, and the building name with the largest total room area for that use type. Do not return any rounded answers.\"}, {\"id\": \"dw_4776\", \"desc\": \"For rooms with an area greater than 300 that are associated with departments in the \\\"Provost Area\\\", show the building-room identifier, floor number, major use description, organization name, DLC key, the average area in a window of 2 preceding and 2 following rows grouped by department code and ordered by area, the department code, department name, school area name, and the rank of each department within its school area based on department code. Additionally, include the department's full name from the HR organization unit and the department's hierarchy level 3 name from the master department hierarchy. Present the results ordered by building-room identifier and department code. Do not return any rounded answers.\"}, {\"id\": \"dw_2224\", \"desc\": \"For each subject code where the department is degree granting and the department is Mathematics, and for each department that is degree granting and is not the Mathematics department (Course 18), show the subject code, subject code description, mathematics department name, school name, the average department budget code within each school, the administrative department name, the average clearing cost collector, the variance of the clearing cost collector, the standard deviation (using STDDEV only and never STDDEV_POP) of the clearing cost collector, and the most recent activity date for the administrative department. Do not return any rounded answers.\"}, {\"id\": \"dw_2850\", \"desc\": \"For each term and department, what is the term, department, and the variance of the reserve catalog keys for courses in that department and term where the material status is 'U'? Include subtotals for each term (the corresponding term field is 'SUBTOTAL') and a grand total across all terms (the corresponding term field is 'TOTAL'). Do not repeat the term if it is the same as the previous row. Sort the table by term and department. Do not return any rounded answers.\"}, {\"id\": \"dw_4025\", \"desc\": \"For rooms with a square footage of 150, show the space unit code, space unit name, and the maximum rank within each space unit code group, and for each of those space units, show the major organization, top-level HR organization name, HR department name, the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the organization numbers for each HR department name, considering only organizations that are assignable and have a non-null organization number. The results should include the space unit code, space unit name, maximum rank, major organization, top-level HR organization name, HR department name, average organization number, organization number variance, and organization number standard deviation (using STDDEV only and never STDDEV_POP), in that order. Do not return any rounded answers.\"}]}}"
    },
