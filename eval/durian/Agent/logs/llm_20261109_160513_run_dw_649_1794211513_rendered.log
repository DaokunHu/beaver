      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per 2025FA Engineering subject\", \"desc\": \"For subjects offered in the term with code '2025FA' by departments in the School of Engineering, show the subject ID, subject title, offering department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, total units, department full name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title, ordered by offering department name and subject title. Do not return any rounded answers.\", \"id\": \"dw_3684\", \"name\": \"2025FA Engineering Subjects Enrollment Windows with Catalog Unit Row Numbers\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TERM_START_DATE, t1.TERM_END_DATE, t2.TERM_PARAMETER, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_students_per_dept, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2025FA' ORDER BY t0.OFFER_DEPT_NAME ), Subq2 AS ( SELECT t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t0.DEPARTMENT_FULL_NAME, ROW_NUMBER() OVER (ORDER BY t1.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DEPARTMENT_CODE FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_NAME = 'Engineering' ) SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME, s1.NUM_ENROLLED_STUDENTS, s1.TERM_DESCRIPTION, s1.ACADEMIC_YEAR, s1.TERM_START_DATE, s1.TERM_END_DATE, s1.TERM_PARAMETER, s1.min_enrolled_students_per_dept, s2.TOTAL_UNITS, s2.DEPARTMENT_FULL_NAME, s2.window_column FROM Subq1 s1 JOIN Subq2 s2 ON s1.OFFER_DEPT_CODE = s2.DEPARTMENT_CODE AND s1.SUBJECT_TITLE = s2.SUBJECT_TITLE ORDER BY s1.OFFER_DEPT_NAME, s1.SUBJECT_TITLE\"}, {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject per source term\", \"desc\": \"List all subject IDs that are either offered in the term with code '2025FA' or are offered in the term '2016SP' by departments that grant degrees, along with the subject title, offering department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, and the dense rank considering the current and 2 preceding rows ordered by the total number of units. For subjects from the term '2025FA', show the subject title, offering department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, and the minimum number of enrolled students over each offering department; for subjects from the term '2016SP' by degree-granting departments, show the dense rank as window_column. The results are ordered by subject ID. Do not return any rounded answers.\", \"id\": \"dw_3498\", \"name\": \"Union of 2025FA Offered Subjects and 2016SP Degree-Granting Department Subjects with Unit Dense Ranks\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TERM_START_DATE, t1.TERM_END_DATE, t2.TERM_PARAMETER, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_students_per_dept, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2025FA' ORDER BY t0.OFFER_DEPT_NAME ), Subq2 AS ( SELECT t2.SUBJECT_ID, dense_rank() OVER (ORDER BY t2.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) window_column, t2.OFFER_DEPT_CODE FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t2.TERM_CODE = '2016SP' AND t1.IS_DEGREE_GRANTING = 'Y' ), CombinedSubjects AS ( SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME, s1.NUM_ENROLLED_STUDENTS, s1.TERM_DESCRIPTION, s1.ACADEMIC_YEAR, s1.TERM_START_DATE, s1.TERM_END_DATE, s1.TERM_PARAMETER, s1.min_enrolled_students_per_dept, NULL AS window_column FROM Subq1 s1 UNION ALL SELECT s2.SUBJECT_ID, NULL AS SUBJECT_TITLE, NULL AS OFFER_DEPT_NAME, NULL AS NUM_ENROLLED_STUDENTS, NULL AS TERM_DESCRIPTION, NULL AS ACADEMIC_YEAR, NULL AS TERM_START_DATE, NULL AS TERM_END_DATE, NULL AS TERM_PARAMETER, NULL AS min_enrolled_students_per_dept, s2.window_column FROM Subq2 s2 ) SELECT SUBJECT_ID, SUBJECT_TITLE, OFFER_DEPT_NAME, NUM_ENROLLED_STUDENTS, TERM_DESCRIPTION, ACADEMIC_YEAR, TERM_START_DATE, TERM_END_DATE, TERM_PARAMETER, min_enrolled_students_per_dept, window_column FROM CombinedSubjects ORDER BY SUBJECT_ID;\"}, {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject per source term\", \"desc\": \"List all subjects from the term \\\"2010FA\\\" and all subjects offered in the term with code \\\"2025FA\\\", showing for each row: subject ID, term description, material status key, academic year, rank of the subject within each academic year group ordered by subject ID, subject title, offering department name, number of enrolled students, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, and the source term (\\\"2010FA\\\" or \\\"2025FA\\\"). The columns should appear in the following order: subject ID, term description, material status key, academic year, rank, subject title, offering department name, number of enrolled students, term start date, term end date, term parameter, minimum enrolled students per department, and source term. Order the results by subject ID and source term. Do not return any rounded answers.\", \"id\": \"dw_3224\", \"name\": \"Union of 2010FA TIP Material Subjects and 2025FA Offered Subjects with Department Min Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t2.SUBJECT_ID, t0.TERM_DESCRIPTION, t2.TIP_MATERIAL_STATUS_KEY, t1.ACADEMIC_YEAR, RANK() OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t2.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t2.TERM_CODE = '2010FA' ), Subq2 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TERM_START_DATE, t1.TERM_END_DATE, t2.TERM_PARAMETER, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_students_per_dept FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2025FA' ), CombinedSubjects AS ( SELECT s1.SUBJECT_ID, s1.TERM_DESCRIPTION, s1.TIP_MATERIAL_STATUS_KEY, s1.ACADEMIC_YEAR, s1.window_column, NULL AS SUBJECT_TITLE, NULL AS OFFER_DEPT_NAME, NULL AS NUM_ENROLLED_STUDENTS, NULL AS TERM_START_DATE, NULL AS TERM_END_DATE, NULL AS TERM_PARAMETER, NULL AS min_enrolled_students_per_dept, '2010FA' AS SOURCE_TERM FROM Subq1 s1 UNION ALL SELECT s2.SUBJECT_ID, s2.TERM_DESCRIPTION, NULL AS TIP_MATERIAL_STATUS_KEY, s2.ACADEMIC_YEAR, NULL AS window_column, s2.SUBJECT_TITLE, s2.OFFER_DEPT_NAME, s2.NUM_ENROLLED_STUDENTS, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.TERM_PARAMETER, s2.min_enrolled_students_per_dept, '2025FA' AS SOURCE_TERM FROM Subq2 s2 ) SELECT * FROM CombinedSubjects ORDER BY SUBJECT_ID, SOURCE_TERM;\"}, {\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per top-enrolled Fall 2024-2025 subject in high-average-unit departments\", \"desc\": \"For the top 10 subjects offered in the term with the description \\\"Fall Term 2024-2025\\\" that have the highest number of enrolled students, display each subject's offered key, subject title, offering department name, the term description, the number of enrolled students, and the rank of each subject within its offering department (ordered by subject offered key), but only include subjects where the offering department is among those that, in the term with code '2022SU', had an average total units for their subjects greater than the average total units for all subjects offered in that term. List the subject offered key, subject title, offering department name, term description, number of enrolled students, and the rank within the department, in that order, and order the results by department name and number of enrolled students descending. Do not return any rounded answers.\", \"id\": \"dw_4305\", \"name\": \"Top 10 Fall 2024-2025 Enrolled Subjects in Departments with Above-Average 2022SU Units\", \"sql\": \"WITH TopSubjects AS ( WITH inner_cte AS ( SELECT t0.TIP_SUBJECT_OFFERED_KEY, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t0.NUM_ENROLLED_STUDENTS, RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.TIP_SUBJECT_OFFERED_KEY) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_DESCRIPTION = 'Fall Term 2024-2025' ) SELECT icte.TIP_SUBJECT_OFFERED_KEY, icte.SUBJECT_TITLE, icte.OFFER_DEPT_NAME, icte.TERM_DESCRIPTION, icte.NUM_ENROLLED_STUDENTS, icte.window_column FROM inner_cte icte ORDER BY icte.NUM_ENROLLED_STUDENTS DESC LIMIT 10 ), HighAvgUnitDepartments AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, dense_rank() OVER (ORDER BY t1.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) SELECT t2.DEPARTMENT_NAME, AVG(t2.TOTAL_UNITS) AS avg_total_units FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t0.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2022SU' GROUP BY t2.DEPARTMENT_NAME HAVING AVG(t2.TOTAL_UNITS) > ( SELECT AVG(t3.TOTAL_UNITS) FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t3 ON t0.TERM_CODE = t3.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) ) SELECT ts.TIP_SUBJECT_OFFERED_KEY, ts.SUBJECT_TITLE, ts.OFFER_DEPT_NAME, ts.TERM_DESCRIPTION, ts.NUM_ENROLLED_STUDENTS, ts.window_column FROM TopSubjects ts WHERE ts.OFFER_DEPT_NAME IN (SELECT had.DEPARTMENT_NAME FROM HighAvgUnitDepartments had) ORDER BY ts.OFFER_DEPT_NAME, ts.NUM_ENROLLED_STUDENTS DESC;\"}], \"not_found\": []}"
