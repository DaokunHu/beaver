    {
      "role": "tool",
      "tool_call_id": "call_ddc35a5e8cdd4e429a1f6c75",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering catalog subject matched with 2017JA TIP offering\", \"desc\": \"For subjects offered by departments in the School of Engineering that are also offered in the term '2017JA', show the subject title, total units, department full name, the row number within a window of 2 preceding and 1 following rows ordered by subject title, number of enrolled students, offering department name, department full name for the term, subject code, subject code description, and the minimum number of enrolled students over each subject code group, ordered by subject title and subject code. Do not return any rounded answers.\", \"id\": \"dw_3236\", \"name\": \"Engineering Catalog Subjects Row Numbers Matched with 2017JA TIP Enrollment Windows\", \"sql\": \"WITH EngSubjects AS ( SELECT t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t0.DEPARTMENT_FULL_NAME, ROW_NUMBER() OVER (ORDER BY t1.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DEPARTMENT_CODE FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_NAME = 'Engineering' ), TermSubjects AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ) SELECT es.SUBJECT_TITLE, es.TOTAL_UNITS, es.DEPARTMENT_FULL_NAME, es.window_column AS eng_window_row_number, ts.NUM_ENROLLED_STUDENTS, ts.OFFER_DEPT_NAME, ts.DEPARTMENT_FULL_NAME AS term_dept_full_name, ts.SUBJECT_CODE, ts.SUBJECT_CODE_DESC, ts.window_column AS min_enrolled_by_code FROM EngSubjects es JOIN TermSubjects ts ON es.SUBJECT_TITLE = ts.SUBJECT_TITLE AND es.DEPARTMENT_CODE = ts.OFFER_DEPT_CODE ORDER BY es.SUBJECT_TITLE, ts.SUBJECT_CODE\"}, {\"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA subject per school\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, and the minimum number of enrolled students over each subject code group, as well as the school code, school name, department code, school name from department, department phone number, and the highest running sum of total units for any subject within that school in the 2019FA term (where the subject has more than 1 total unit). Order the results by subject code. Do not return any rounded answers.\", \"id\": \"dw_4308\", \"name\": \"2017JA Subjects Enrollment per Subject Code with 2019FA School Running Unit Sums\", \"sql\": \"WITH inner_cte1 AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column, t1.SCHOOL_CODE, t1.SCHOOL_NAME, t1.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), cte1 AS ( SELECT inner_cte1.SUBJECT_TITLE, inner_cte1.NUM_ENROLLED_STUDENTS, inner_cte1.OFFER_DEPT_NAME, inner_cte1.DEPARTMENT_FULL_NAME, inner_cte1.SUBJECT_CODE, inner_cte1.SUBJECT_CODE_DESC, inner_cte1.window_column, inner_cte1.SCHOOL_CODE, inner_cte1.SCHOOL_NAME, inner_cte1.DEPARTMENT_CODE, sd.SCHOOL_NAME AS SCHOOL_NAME_DEPT, ad.DEPARTMENT_PHONE_NUMBER FROM inner_cte1 LEFT JOIN SIS_DEPARTMENT sd ON inner_cte1.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), inner_cte2 AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.SCHOOL_CODE, t1.SCHOOL_NAME, SUM(t1.TOTAL_UNITS) OVER (PARTITION BY t1.SCHOOL_CODE ORDER BY t1.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_CODE = '2019FA' AND t1.TOTAL_UNITS > 1 ), cte2 AS ( SELECT SCHOOL_CODE, SCHOOL_NAME, MAX(window_column) AS highest_running_sum_total_units FROM inner_cte2 GROUP BY SCHOOL_CODE, SCHOOL_NAME ) SELECT cte1.SUBJECT_TITLE, cte1.NUM_ENROLLED_STUDENTS, cte1.OFFER_DEPT_NAME, cte1.DEPARTMENT_FULL_NAME, cte1.SUBJECT_CODE, cte1.SUBJECT_CODE_DESC, cte1.window_column, cte1.SCHOOL_CODE, cte1.SCHOOL_NAME, cte1.DEPARTMENT_CODE, cte1.SCHOOL_NAME_DEPT, cte1.DEPARTMENT_PHONE_NUMBER, cte2.highest_running_sum_total_units FROM cte1 JOIN cte2 ON cte1.SCHOOL_CODE = cte2.SCHOOL_CODE ORDER BY cte1.SUBJECT_CODE;\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics library subject in previous terms\", \"desc\": \"Show the Mathematics department courses with at least 5 enrolled students, including the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, the average calendar year within each calendar year group ordered by term start date, and for each course, also display the responsible faculty name and the offer school name, but only for academic terms where the term status is 'Previous'. Do not return any rounded answers.\", \"id\": \"dw_4658\", \"name\": \"Mathematics Library Subjects 5+ Enrolled in Previous Terms with Faculty and Calendar Attributes\", \"sql\": \"WITH inner_cte AS ( SELECT t0.COURSE_NUMBER, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t0.TERM_CODE, ROW_NUMBER() OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t0.COURSE_NUMBER) AS window_column FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t0.NUM_ENROLLED_STUDENTS >= 5 ), PreviousTerms AS ( SELECT t1.TERM_CODE, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t0.CALENDAR_DATE, t0.DAY_OF_WEEK, AVG(t0.CALENDAR_YEAR) OVER (PARTITION BY t0.CALENDAR_YEAR ORDER BY t1.TERM_START_DATE) AS window_column FROM TIME_DAY t0 JOIN ACADEMIC_TERMS t1 ON t0.CALENDAR_DATE = t1.TERM_START_DATE WHERE t1.TERM_STATUS = 'Previous' ) SELECT ic.COURSE_NUMBER, ic.SUBJECT_TITLE, ic.NUM_ENROLLED_STUDENTS, ic.TERM_DESCRIPTION, ic.ACADEMIC_YEAR, ic.window_column AS math_window_column, pt.TERM_START_DATE, pt.CALENDAR_DATE, pt.DAY_OF_WEEK, pt.window_column AS previous_terms_window_column, lso.RESPONSIBLE_FACULTY_NAME, lso.OFFER_SCHOOL_NAME FROM inner_cte ic JOIN PreviousTerms pt ON ic.TERM_CODE = pt.TERM_CODE JOIN LIBRARY_SUBJECT_OFFERED lso ON ic.COURSE_NUMBER = lso.COURSE_NUMBER AND ic.TERM_CODE = lso.TERM_CODE ORDER BY ic.COURSE_NUMBER, pt.TERM_START_DATE;\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics library subject above yearly average enrollment\", \"desc\": \"For Mathematics department courses with at least 5 enrolled students, show the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, and the average calendar year within each calendar year group ordered by term start date, but only for academic terms where the term status is 'Previous', and only include results where the number of enrolled students is greater than the average number of enrolled students for that academic year. Do not return any rounded answers.\", \"id\": \"dw_4584\", \"name\": \"Mathematics Library Subjects Above Yearly Average Enrollment in Previous Terms\", \"sql\": \"WITH inner_cte AS ( SELECT t0.COURSE_NUMBER, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t0.TERM_CODE, ROW_NUMBER() OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t0.COURSE_NUMBER) AS window_column, t1.TERM_START_DATE FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t0.NUM_ENROLLED_STUDENTS >= 5 ), PreviousTerms AS ( SELECT t1.TERM_CODE, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t0.CALENDAR_DATE, t0.DAY_OF_WEEK, AVG(t0.CALENDAR_YEAR) OVER (PARTITION BY t0.CALENDAR_YEAR ORDER BY t1.TERM_START_DATE) AS window_column FROM TIME_DAY t0 JOIN ACADEMIC_TERMS t1 ON t0.CALENDAR_DATE = t1.TERM_START_DATE WHERE t1.TERM_STATUS = 'Previous' ), AvgEnrolled AS ( SELECT ACADEMIC_YEAR, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t0.NUM_ENROLLED_STUDENTS >= 5 GROUP BY ACADEMIC_YEAR ) SELECT i.COURSE_NUMBER, i.SUBJECT_TITLE, i.NUM_ENROLLED_STUDENTS, i.TERM_DESCRIPTION, i.ACADEMIC_YEAR, i.window_column AS math_window_column, p.TERM_START_DATE, p.CALENDAR_DATE, p.DAY_OF_WEEK, p.window_column AS previous_terms_window_column FROM inner_cte i JOIN PreviousTerms p ON i.TERM_CODE = p.TERM_CODE JOIN AvgEnrolled a ON i.ACADEMIC_YEAR = a.ACADEMIC_YEAR WHERE i.NUM_ENROLLED_STUDENTS > a.avg_enrolled ORDER BY i.COURSE_NUMBER, p.TERM_START_DATE;\"}, {\"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the TIP subject offered record; joins to TIP_DETAIL.TIP_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"IS_NO_COURSE_MATERIAL\": {\"desc\": \"'Y'/'N' flag whether the subject has no course material; 'N' means the subject has course materials\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '5.01'; joins to TIP_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE and STUDENT_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Chemistry', 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject; used for enrollment-based rankings and window statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in the textbook program\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}], \"not_found\": []}"
