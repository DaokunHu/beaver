      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject code matched with 2024 Mathematics catalog subject\", \"desc\": \"For each subject code in degree-granting departments where the department is Mathematics, and for subjects offered in the academic year 2024 that are also present in the CIS course catalog and are in the Mathematics department, show the subject code, subject code description, department name, school name, rank of the subject code within each school name group ordered by subject code, subject ID, subject number, subject short title, subject title, lecture units, lab units, total units, grade type, grade rule, the minimum total units value over each department code group, and the subject description from the CIS course catalog, ordered by school name, rank, and subject number. Do not return any rounded answers.\", \"id\": \"dw_2210\", \"name\": \"Math Subject Code School Ranks Matched with 2024 Catalog Offerings and Department Min Units\", \"sql\": \"WITH inner_cte AS ( WITH SubjectCodeRanks AS ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME, RANK() OVER (PARTITION BY t1.SCHOOL_NAME ORDER BY t1.SUBJECT_CODE) AS window_column FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' AND t0.DEPARTMENT_NAME = 'Mathematics' ), MathSubjects2024 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_SHORT_TITLE, t0.SUBJECT_TITLE, t0.LECTURE_UNITS, t0.LAB_UNITS, t0.TOTAL_UNITS, t0.GRADE_TYPE, t0.GRADE_RULE, min(t0.TOTAL_UNITS) OVER (PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.DEPARTMENT_CODE) AS min_total_units_by_dept FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN CIS_COURSE_CATALOG t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2024 AND t0.DEPARTMENT_NAME = 'Mathematics' ORDER BY t0.DEPARTMENT_CODE ) SELECT scr.SUBJECT_CODE, scr.SUBJECT_CODE_DESC, scr.DEPARTMENT_NAME, scr.SCHOOL_NAME, scr.window_column, ms.SUBJECT_ID, ms.SUBJECT_NUMBER, ms.SUBJECT_SHORT_TITLE, ms.SUBJECT_TITLE, ms.LECTURE_UNITS, ms.LAB_UNITS, ms.TOTAL_UNITS, ms.GRADE_TYPE, ms.GRADE_RULE, ms.min_total_units_by_dept FROM SubjectCodeRanks scr JOIN MathSubjects2024 ms ON scr.SUBJECT_CODE = ms.SUBJECT_CODE ) SELECT ic.SUBJECT_CODE, ic.SUBJECT_CODE_DESC, ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.window_column, ic.SUBJECT_ID, ic.SUBJECT_NUMBER, ic.SUBJECT_SHORT_TITLE, ic.SUBJECT_TITLE, ic.LECTURE_UNITS, ic.LAB_UNITS, ic.TOTAL_UNITS, ic.GRADE_TYPE, ic.GRADE_RULE, ic.min_total_units_by_dept, ccc.SUBJECT_DESCRIPTION FROM inner_cte ic JOIN CIS_COURSE_CATALOG ccc ON ic.SUBJECT_ID = ccc.SUBJECT_ID ORDER BY ic.SCHOOL_NAME, ic.window_column, ic.SUBJECT_NUMBER;\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject offering\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units in the Mathematics department, show the subject code, subject number, subject title, department name, term description, and the rank of each subject within its department ordered by subject code, along with the department name, school name, the highest number of degree-granting undergraduate courses in the Mathematics department (Course 18), and the subject short title and subject description for each subject. Do not return any rounded answers.\", \"id\": \"dw_2090\", \"name\": \"Math 2024 12-Unit Subjects Ranked with Degree-Granting Undergraduate Course Count\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.SUBJECT_TITLE, t0.DEPARTMENT_NAME, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column, t0.SUBJECT_CODE AS join_subject_code FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.EFFECTIVE_TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2024 AND t0.TOTAL_UNITS = 12 AND t0.DEPARTMENT_NAME = 'Mathematics' ), math_dept_course_count AS ( SELECT DEPARTMENT_NAME, SCHOOL_NAME, COUNT(*) AS num_courses, 'Mathematics' AS join_department_name FROM SIS_COURSE_DESCRIPTION WHERE IS_DEGREE_GRANTING = 'Y' AND COURSE_LEVEL = 'U' AND DEPARTMENT_NAME = 'Mathematics' GROUP BY DEPARTMENT_NAME, SCHOOL_NAME ORDER BY num_courses DESC LIMIT 1 ) SELECT ic.SUBJECT_CODE, ic.SUBJECT_NUMBER, ic.SUBJECT_TITLE, ic.DEPARTMENT_NAME, ic.TERM_DESCRIPTION, ic.window_column, mdc.DEPARTMENT_NAME, mdc.SCHOOL_NAME, mdc.num_courses, cso.SUBJECT_SHORT_TITLE, cso.SUBJECT_DESCRIPTION FROM inner_cte ic CROSS JOIN math_dept_course_count mdc JOIN COURSE_CATALOG_SUBJECT_OFFERED cso ON ic.SUBJECT_CODE = cso.SUBJECT_CODE AND ic.SUBJECT_NUMBER = cso.SUBJECT_NUMBER AND cso.ACADEMIC_YEAR = 2024 AND cso.DEPARTMENT_NAME = 'Mathematics'\"}, {\"id\": \"dw_2591\", \"name\": \"2014FA Enrolled Library Subjects with TIP Material Status and 3-Row Min Total Units\", \"desc\": \"For all subjects in the 2014FA term with at least one enrolled student, show the subject title, offering department name, responsible faculty name, the TIP material status key, the total number of units, and the minimum total number of units in a window of 3 preceding and 1 following row ordered by the course number, along with the cluster type description and the HGN code description for each subject. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT lso.SUBJECT_TITLE, lso.OFFER_DEPT_NAME, lso.RESPONSIBLE_FACULTY_NAME, td.TIP_MATERIAL_STATUS_KEY, sos.TOTAL_UNITS, MIN(sos.TOTAL_UNITS) OVER ( ORDER BY sos.COURSE_NUMBER ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column, sos.SUBJECT_ID FROM LIBRARY_SUBJECT_OFFERED lso JOIN TIP_DETAIL td ON lso.SUBJECT_ID = td.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY sos ON td.SUBJECT_ID = sos.SUBJECT_ID WHERE lso.TERM_CODE = '2014FA' AND lso.NUM_ENROLLED_STUDENTS > 0 ) SELECT inner_cte.SUBJECT_TITLE, inner_cte.OFFER_DEPT_NAME, inner_cte.RESPONSIBLE_FACULTY_NAME, inner_cte.TIP_MATERIAL_STATUS_KEY, inner_cte.TOTAL_UNITS, inner_cte.window_column, sos.CLUSTER_TYPE_DESC, sos.HGN_CODE_DESC FROM inner_cte JOIN SUBJECT_OFFERED_SUMMARY sos ON inner_cte.SUBJECT_ID = sos.SUBJECT_ID AND sos.TERM_CODE = '2014FA'\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2014FA library subject with textbook material matched to its subject offering summary\"}, {\"id\": \"LIBRARY_SUBJECT_OFFERED\", \"name\": \"LIBRARY_SUBJECT_OFFERED\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\", \"columns\": {\"LIBRARY_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the library subject offered record; joins to LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject as used by the library\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_RESERVE_MATRL_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject per library records\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in library reserve scope\"}], \"not_found\": []}"
