    {
      "role": "tool",
      "tool_call_id": "call_66b2de6c8f6b4486934000d0",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level, where the total number of enrolled students in offered subjects is greater than 10, and the department is Mathematics (Course 18), provide the number of unique courses, the minimum total units among those subjects that are degree-granting courses, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for Mathematics courses (considering only departments that offer more than five courses), and the number of unique subject codes for Mathematics in the SIS_SUBJECT_CODE table. List the department name, course level, number of unique courses, minimum total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the number of unique subject codes, in that order. Do not return any rounded answers.\", \"id\": \"dw_2335\", \"name\": \"Math Degree-Granting Course Level Counts with Catalog Unit Stddev and Unique Subject Codes\", \"sql\": \"WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, c.COURSE_LEVEL, COUNT(DISTINCT c.COURSE) AS course_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.NUM_ENROLLED_STUDENTS > 10 AND d.DEPARTMENT_NAME = 'Mathematics' AND c.IS_DEGREE_GRANTING = 'Y' GROUP BY d.DEPARTMENT_NAME, c.COURSE_LEVEL ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.COURSE_LEVEL, inner_cte.course_count, inner_cte.min_total_units, subq2.units_stddev, subq3.unique_subject_codes FROM inner_cte JOIN ( SELECT s.DEPARTMENT_NAME, STDDEV(c.TOTAL_UNITS) AS units_stddev FROM SIS_SUBJECT_CODE s JOIN CIS_COURSE_CATALOG c ON s.DEPARTMENT_CODE = c.DEPARTMENT_CODE WHERE c.TOTAL_UNITS IS NOT NULL AND s.DEPARTMENT_NAME = 'Mathematics' GROUP BY s.DEPARTMENT_NAME HAVING COUNT(*) > 5 ) subq2 ON inner_cte.DEPARTMENT_NAME = subq2.DEPARTMENT_NAME JOIN ( SELECT DEPARTMENT_NAME, COUNT(DISTINCT SUBJECT_CODE) AS unique_subject_codes FROM SIS_SUBJECT_CODE WHERE DEPARTMENT_NAME = 'Mathematics' GROUP BY DEPARTMENT_NAME ) subq3 ON inner_cte.DEPARTMENT_NAME = subq3.DEPARTMENT_NAME;\"}, {\"id\": \"dw_1288\", \"name\": \"Math IAP Max Enrollment Variance Rollup with Library and TIP Department Enrollment Totals\", \"desc\": \"For each academic year, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered in that year by the Mathematics department, considering only activities that require advance sign-up and are not cancelled, and also provide the academic year description? For each department, include a grand total for all activities in the format of (department name, null, total variance and stddev). Additionally, for each such department, provide the department code, the department name, and the total number of enrolled students in both the library and tip subject offerings, but only for those departments where the total number of enrolled students is more than one standard deviation (using STDDEV only and never STDDEV_POP) above the mean total enrolled students across all departments, and restrict your answer to departments whose name is 'Mathematics' (Course 18). Also, for each such department, list the names of the responsible faculty members from both the library and tip subject offerings. The columns to display, in order, are: department name, academic year description, total variance, total standard deviation (using STDDEV only and never STDDEV_POP), department code, department name, total enrolled, library faculty, and tip faculty. Do not return any rounded answers.\", \"category\": \"Library Reserve and IAP Activity Comprehensive Analysis\", \"sql\": \"WITH inner_cte1 AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, VARIANCE(isd.MAX_ENROLLMENT) AS max_enrollment_variance, STDDEV(isd.MAX_ENROLLMENT) AS max_enrollment_stddev, ccso.DEPARTMENT_NAME FROM IAP_SUBJECT_DETAIL isd JOIN ACADEMIC_TERMS_ALL ata ON isd.TERM_CODE = ata.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE isd.ENROLLMENT_TYPE = 'Advance sign-up required' AND isd.IS_CANCELLED = 'N' AND isd.MAX_ENROLLMENT IS NOT NULL AND ccso.DEPARTMENT_NAME = 'Mathematics' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, ccso.DEPARTMENT_NAME ), RollupResults AS ( SELECT DEPARTMENT_NAME, ACADEMIC_YEAR_DESC, SUM(max_enrollment_variance) AS total_variance, SUM(max_enrollment_stddev) AS total_stddev FROM inner_cte1 GROUP BY DEPARTMENT_NAME, ACADEMIC_YEAR_DESC WITH ROLLUP HAVING SUM(max_enrollment_variance) IS NOT NULL ), inner_cte2 AS ( SELECT l.OFFER_DEPT_CODE, l.OFFER_DEPT_NAME, SUM(l.NUM_ENROLLED_STUDENTS + t.NUM_ENROLLED_STUDENTS) AS total_enrolled FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_SUBJECT_OFFERED t ON l.MASTER_SUBJECT_ID_SORT = t.MASTER_SUBJECT_ID_SORT WHERE l.OFFER_DEPT_NAME = 'Mathematics' GROUP BY l.OFFER_DEPT_CODE, l.OFFER_DEPT_NAME HAVING SUM(l.NUM_ENROLLED_STUDENTS + t.NUM_ENROLLED_STUDENTS) > ( SELECT AVG(total_sum) + STDDEV(total_sum) FROM ( SELECT SUM(l2.NUM_ENROLLED_STUDENTS + t2.NUM_ENROLLED_STUDENTS) AS total_sum FROM LIBRARY_SUBJECT_OFFERED l2 JOIN TIP_SUBJECT_OFFERED t2 ON l2.MASTER_SUBJECT_ID_SORT = t2.MASTER_SUBJECT_ID_SORT GROUP BY l2.OFFER_DEPT_CODE ) dept_totals ) AND l.OFFER_DEPT_CODE = '18' ) SELECT rr.DEPARTMENT_NAME, rr.ACADEMIC_YEAR_DESC, rr.total_variance, rr.total_stddev, c.OFFER_DEPT_CODE, c.OFFER_DEPT_NAME, c.total_enrolled, l.RESPONSIBLE_FACULTY_NAME AS library_faculty, t.RESPONSIBLE_FACULTY_NAME AS tip_faculty FROM RollupResults rr JOIN inner_cte2 c ON rr.DEPARTMENT_NAME = c.OFFER_DEPT_NAME JOIN LIBRARY_SUBJECT_OFFERED l ON c.OFFER_DEPT_CODE = l.OFFER_DEPT_CODE AND l.OFFER_DEPT_NAME = c.OFFER_DEPT_NAME JOIN TIP_SUBJECT_OFFERED t ON l.MASTER_SUBJECT_ID_SORT = t.MASTER_SUBJECT_ID_SORT WHERE l.OFFER_DEPT_NAME = 'Mathematics' ORDER BY rr.DEPARTMENT_NAME, rr.ACADEMIC_YEAR_DESC, c.OFFER_DEPT_CODE, c.OFFER_DEPT_NAME, c.total_enrolled, l.RESPONSIBLE_FACULTY_NAME, t.RESPONSIBLE_FACULTY_NAME;\", \"default_granularity\": \"one row per department per academic year description plus rollup totals\"}, {\"category\": \"Textbook Material and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2022 Mathematics TIP subject offering with department unit statistics\", \"desc\": \"For each subject offered in the 2022 academic year by a degree-granting department, specifically in the Department of Mathematics (Course 18) and excluding subjects offered by the Department of Physics, provide the subject ID, subject title, department name, the number of enrolled students, the total number of lecture units, and, for each subject, indicate whether it is also offered as a joint subject with another department. Additionally, show the range and variance of the total units for letter graded subjects offered this year in the Mathematics department. List the results in order of subject ID. Do not return any rounded answers.\", \"id\": \"dw_2158\", \"name\": \"Math 2022 TIP Subjects with Joint-Subject Flag and Letter-Graded Unit Range-Variance\", \"sql\": \"WITH inner_cte AS ( SELECT tso.SUBJECT_ID, ccso.SUBJECT_TITLE, sd.DEPARTMENT_NAME, tso.NUM_ENROLLED_STUDENTS, ccso.LECTURE_UNITS, sd.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED tso JOIN SIS_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON tso.SUBJECT_ID = ccso.SUBJECT_ID AND ccso.ACADEMIC_YEAR = 2022 AND ccso.DEPARTMENT_CODE = sd.DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_NAME <> 'Physics' ), MathDeptUnitStats AS ( SELECT DEPARTMENT_NAME, DEPARTMENT_CODE, MAX(TOTAL_UNITS) - MIN(TOTAL_UNITS) AS total_units_range, VARIANCE(TOTAL_UNITS) AS total_units_variance FROM COURSE_CATALOG_SUBJECT_OFFERED WHERE IS_OFFERED_THIS_YEAR = 'Y' AND GRADE_TYPE = 'L' AND DEPARTMENT_NAME = 'Mathematics' AND DEPARTMENT_CODE = '18' AND TOTAL_UNITS IS NOT NULL GROUP BY DEPARTMENT_NAME, DEPARTMENT_CODE ) SELECT ic.SUBJECT_ID, ic.SUBJECT_TITLE, ic.DEPARTMENT_NAME, ic.NUM_ENROLLED_STUDENTS, ic.LECTURE_UNITS, CASE WHEN ccs.JOINT_SUBJECTS IS NOT NULL AND TRIM(ccs.JOINT_SUBJECTS) <> '' THEN 'Y' ELSE 'N' END AS IS_JOINT_SUBJECT, mds.total_units_range, mds.total_units_variance FROM inner_cte ic JOIN COURSE_CATALOG_SUBJECT_OFFERED ccs ON ic.SUBJECT_ID = ccs.SUBJECT_ID AND ccs.ACADEMIC_YEAR = 2022 AND ccs.DEPARTMENT_CODE = ic.DEPARTMENT_CODE JOIN MathDeptUnitStats mds ON ic.DEPARTMENT_NAME = mds.DEPARTMENT_NAME AND ic.DEPARTMENT_CODE = mds.DEPARTMENT_CODE ORDER BY ic.SUBJECT_ID;\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics department combining subject unit statistics with graduate student counts\", \"desc\": \"For the Mathematics department (Course 18), provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student), the number of graduate students in the department, and the most recent warehouse load date for those students, considering only departments that are degree granting and students whose year is 'G'. Do not return any rounded answers.\", \"id\": \"dw_1212\", \"name\": \"Math Department Subject Unit Average-Stddev with Graduate Student Count and Latest Load Date\", \"sql\": \"WITH DeptUnits AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_total_units, STDDEV(s.TOTAL_UNITS) AS stddev_total_units FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.TOTAL_UNITS > 0 AND s.NUM_ENROLLED_STUDENTS >= 1 AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME ORDER BY stddev_total_units DESC ), DeptStudents AS ( SELECT sd.DEPARTMENT_NAME, COUNT(msd.FULL_NAME) AS student_count, MAX(msd.WAREHOUSE_LOAD_DATE) AS latest_student_load FROM SIS_DEPARTMENT sd JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT JOIN SIS_ADMIN_DEPARTMENT sad ON msd.DEPARTMENT = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND msd.STUDENT_YEAR = 'G' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_NAME ORDER BY student_count DESC LIMIT 10 ) SELECT du.DEPARTMENT_NAME, du.avg_total_units, du.stddev_total_units, ds.student_count, ds.latest_student_load FROM DeptUnits du JOIN DeptStudents ds ON du.DEPARTMENT_NAME = ds.DEPARTMENT_NAME;\"}], \"not_found\": []}"
