      "tool_call_id": "call_558b137f00824cc6b20b3990",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"IAP Activity and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per school per academic year\", \"desc\": \"For each school, what is the school's name, the school's name in the commencement book, the maximum CIP program code among its degree-granting departments' courses (excluding the Mathematics department), the CIP category ('HIGH_CIP', 'LOW_CIP', or 'MEDIUM_CIP'), the academic year, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered by the Mathematics department in that year (considering only years with more than five activities), and the Mathematics department phone number, for schools where the maximum CIP program code is greater than 130000 and the standard deviation (using STDDEV only and never STDDEV_POP) of maximum enrollment is available? Do not return any rounded answers.\", \"id\": \"dw_1618\", \"name\": \"School CIP Categories with Yearly Math IAP Max Enrollment Stddev and Department Phone\", \"sql\": \"WITH school_cip AS ( WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, MAX(c.CIP_PROGRAM_CODE) AS max_cip_code, d.DEPARTMENT_FULL_NAME, d.SCHOOL_NAME, d.SCHOOL_CODE FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_CODE <> '18' GROUP BY d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, d.SCHOOL_NAME, d.SCHOOL_CODE HAVING MAX(c.CIP_PROGRAM_CODE) > 120000 ) SELECT i.SCHOOL_NAME, s.SCHOOL_NAME_IN_COMMENCEMENT_BK, MAX(i.max_cip_code) AS school_max_cip_code, CASE WHEN MAX(i.max_cip_code) > 150000 THEN 'HIGH_CIP' WHEN MAX(i.max_cip_code) < 130000 THEN 'LOW_CIP' ELSE 'MEDIUM_CIP' END AS cip_category FROM inner_cte i JOIN SIS_DEPARTMENT s ON i.SCHOOL_CODE = s.SCHOOL_CODE GROUP BY i.SCHOOL_NAME, s.SCHOOL_NAME_IN_COMMENCEMENT_BK ), math_iap_enroll AS ( WITH inner_cte AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, STDDEV_SAMP(isd.MAX_ENROLLMENT) AS stddev_max_enrollment FROM IAP_SUBJECT_DETAIL isd JOIN ACADEMIC_TERMS_ALL ata ON isd.TERM_CODE = ata.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON isd.TERM_CODE = ccso.TERM_CODE WHERE ccso.DEPARTMENT_NAME = 'Mathematics' AND isd.MAX_ENROLLMENT IS NOT NULL GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC HAVING COUNT(isd.MAX_ENROLLMENT) > 5 ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.ACADEMIC_YEAR_DESC, inner_cte.stddev_max_enrollment, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.SCHOOL_NAME AS school_name FROM inner_cte LEFT JOIN SIS_DEPARTMENT sd ON sd.DEPARTMENT_NAME = 'Mathematics' LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ORDER BY inner_cte.ACADEMIC_YEAR ) SELECT sc.SCHOOL_NAME, sc.SCHOOL_NAME_IN_COMMENCEMENT_BK, sc.school_max_cip_code, sc.cip_category, mie.ACADEMIC_YEAR, mie.ACADEMIC_YEAR_DESC, mie.stddev_max_enrollment, mie.department_phone FROM school_cip sc JOIN math_iap_enroll mie ON sc.SCHOOL_NAME = mie.school_name WHERE sc.school_max_cip_code > 130000 AND mie.stddev_max_enrollment IS NOT NULL ORDER BY sc.SCHOOL_NAME, mie.ACADEMIC_YEAR;\"}, {\"category\": \"Course Catalog and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics graduate student, unioned with department-level CIP statistics rows for Mathematics departments without such students\", \"desc\": \"Show the department name, department full name, student full name, student email address, dense rank over the school code, CIP program code range, and CIP program code variance for all graduate students in degree-granting Mathematics departments, as well as for all Mathematics departments that are degree granting and have at least one course with a non-null CIP program code, including the CIP program code range and variance for those departments even if they have no such students. List the results ordered by department full name and student full name. Do not return any rounded answers.\", \"id\": \"dw_1033\", \"name\": \"Math Graduate Students School Dense Ranks Unioned with Department CIP Code Range-Variance\", \"sql\": \"WITH StudentInfo AS ( SELECT sd.DEPT_NAME_IN_COMMENCEMENT_BK AS department_name, sd.DEPARTMENT_FULL_NAME AS department_full_name, msd.FULL_NAME AS student_full_name, msd.EMAIL_ADDRESS AS student_email_address, DENSE_RANK() OVER (ORDER BY sd.SCHOOL_CODE) AS school_code_dense_rank, sd.DEPARTMENT_CODE FROM MIT_STUDENT_DIRECTORY msd JOIN SIS_DEPARTMENT sd ON msd.DEPARTMENT = sd.DEPARTMENT_CODE WHERE msd.STUDENT_YEAR = 'G' AND sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_CODE = '18' ), DepartmentCIPStats AS ( SELECT sd.DEPARTMENT_CODE, sd.DEPARTMENT_FULL_NAME, MAX(scd.CIP_PROGRAM_CODE) - MIN(scd.CIP_PROGRAM_CODE) AS cip_code_range, VARIANCE(scd.CIP_PROGRAM_CODE) AS cip_code_variance FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND scd.CIP_PROGRAM_CODE IS NOT NULL AND sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY sd.DEPARTMENT_CODE, sd.DEPARTMENT_FULL_NAME ), CombinedResults AS ( SELECT si.department_name, si.department_full_name, si.student_full_name, si.student_email_address, si.school_code_dense_rank, dcs.cip_code_range, dcs.cip_code_variance FROM StudentInfo si LEFT JOIN DepartmentCIPStats dcs ON si.DEPARTMENT_CODE = dcs.DEPARTMENT_CODE UNION ALL SELECT NULL AS department_name, dcs.DEPARTMENT_FULL_NAME AS department_full_name, NULL AS student_full_name, NULL AS student_email_address, NULL AS school_code_dense_rank, dcs.cip_code_range, dcs.cip_code_variance FROM DepartmentCIPStats dcs WHERE dcs.DEPARTMENT_CODE NOT IN (SELECT DEPARTMENT_CODE FROM StudentInfo) ) SELECT department_name, department_full_name, student_full_name, student_email_address, school_code_dense_rank, cip_code_range, cip_code_variance FROM CombinedResults ORDER BY department_full_name, student_full_name;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per course level of the Mathematics department\", \"desc\": \"For the Mathematics department, what is the department name, the average of the total units, the range of the total units, the variance of the total units for courses with total units greater than 0, and for each course level, what is the number of unique students and the minimum CIP program code among their courses, considering only degree-granting departments? Additionally, for each course level, what is the average number of lecture units and the maximum number of lab units for Mathematics courses? Do not return any rounded answers.\", \"id\": \"dw_2272\", \"name\": \"Math Department Unit Statistics with Course Level Student Counts and Lecture-Lab Unit Averages\", \"sql\": \"WITH inner_cte AS ( WITH department_units_stats AS ( SELECT SIS_DEPARTMENT.DEPARTMENT_NAME, AVG(CIS_COURSE_CATALOG.TOTAL_UNITS) AS avg_total_units, MAX(CIS_COURSE_CATALOG.TOTAL_UNITS) - MIN(CIS_COURSE_CATALOG.TOTAL_UNITS) AS total_units_range, VARIANCE(CIS_COURSE_CATALOG.TOTAL_UNITS) AS total_units_variance FROM SIS_DEPARTMENT JOIN CIS_COURSE_CATALOG ON SIS_DEPARTMENT.DEPARTMENT_CODE = CIS_COURSE_CATALOG.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE ON CIS_COURSE_CATALOG.DEPARTMENT_CODE = SIS_SUBJECT_CODE.DEPARTMENT_CODE WHERE CIS_COURSE_CATALOG.TOTAL_UNITS > 0 AND SIS_DEPARTMENT.IS_DEGREE_GRANTING = 'Y' AND SIS_DEPARTMENT.DEPARTMENT_NAME = 'Mathematics' AND SIS_DEPARTMENT.DEPARTMENT_CODE = '18' GROUP BY SIS_DEPARTMENT.DEPARTMENT_NAME ORDER BY total_units_range DESC ), department_student_cip_stats AS ( SELECT sd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT msd.FULL_NAME) AS student_count, MIN(scd.CIP_PROGRAM_CODE) AS min_cip_code FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY sd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT dus.DEPARTMENT_NAME, dus.avg_total_units, dus.total_units_range, dus.total_units_variance, dscs.COURSE_LEVEL, dscs.student_count, dscs.min_cip_code FROM department_units_stats dus JOIN department_student_cip_stats dscs ON dus.DEPARTMENT_NAME = dscs.DEPARTMENT_NAME ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.avg_total_units, inner_cte.total_units_range, inner_cte.total_units_variance, inner_cte.COURSE_LEVEL, inner_cte.student_count, inner_cte.min_cip_code, stats.avg_lecture_units, stats.max_lab_units FROM inner_cte JOIN ( SELECT scd.COURSE_LEVEL, AVG(ccc.LECTURE_UNITS) AS avg_lecture_units, MAX(ccc.LAB_UNITS) AS max_lab_units FROM SIS_COURSE_DESCRIPTION scd JOIN CIS_COURSE_CATALOG ccc ON scd.DEPARTMENT = ccc.DEPARTMENT_CODE WHERE scd.DEPARTMENT_NAME = 'Mathematics' AND ccc.DEPARTMENT_CODE = '18' AND ccc.TOTAL_UNITS > 0 GROUP BY scd.COURSE_LEVEL ) stats ON inner_cte.COURSE_LEVEL = stats.COURSE_LEVEL;\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per academic year per department per graduate level\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\", \"entity_type_note\": \"\", \"id\": \"dw_1393\", \"name\": \"Math Current-Term Unit Dispersion with Degree-Granting Department Course Counts\", \"sql\": \"WITH inner_cte1 AS ( SELECT ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, SUBJECT_SUMMARY.TOTAL_UNITS, SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER FROM COURSE_CATALOG_SUBJECT_OFFERED JOIN ACADEMIC_TERMS_ALL ON COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE = ACADEMIC_TERMS_ALL.TERM_CODE JOIN SUBJECT_SUMMARY ON ACADEMIC_TERMS_ALL.TERM_CODE = SUBJECT_SUMMARY.TERM_CODE WHERE ACADEMIC_TERMS_ALL.IS_CURRENT_TERM = 'Y' AND SUBJECT_SUMMARY.TOTAL_UNITS > 0 AND COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME = 'Mathematics' ), avg_enrollment AS ( SELECT ACADEMIC_YEAR, DEPARTMENT_NAME, AVG(SUBJECT_ENROLLMENT_NUMBER) AS avg_enrollment FROM inner_cte1 GROUP BY ACADEMIC_YEAR, DEPARTMENT_NAME ), math_units_stats AS ( SELECT i.ACADEMIC_YEAR, i.DEPARTMENT_NAME, VARIANCE(i.TOTAL_UNITS) AS total_units_variance, STDDEV(i.TOTAL_UNITS) AS total_units_stddev FROM inner_cte1 i JOIN avg_enrollment a ON i.ACADEMIC_YEAR = a.ACADEMIC_YEAR AND i.DEPARTMENT_NAME = a.DEPARTMENT_NAME WHERE i.SUBJECT_ENROLLMENT_NUMBER > a.avg_enrollment GROUP BY i.ACADEMIC_YEAR, i.DEPARTMENT_NAME ), inner_cte2 AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, ad.SIS_ADMIN_DEPARTMENT_NAME, COUNT(DISTINCT c.COURSE) AS num_distinct_courses FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT ad ON d.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND UPPER(ad.SIS_ADMIN_DEPARTMENT_NAME) <> 'MANAGEMENT' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, ad.SIS_ADMIN_DEPARTMENT_NAME ), dept_courses AS ( SELECT ic.DEPARTMENT_CODE, ic.DEPARTMENT_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, scd.GRADUATE_LEVEL, ic.num_distinct_courses FROM inner_cte2 ic JOIN SIS_COURSE_DESCRIPTION scd ON ic.DEPARTMENT_CODE = scd.DEPARTMENT GROUP BY ic.DEPARTMENT_CODE, ic.DEPARTMENT_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, scd.GRADUATE_LEVEL, ic.num_distinct_courses ) SELECT mus.ACADEMIC_YEAR, mus.DEPARTMENT_NAME, mus.total_units_variance, mus.total_units_stddev, dc.DEPARTMENT_CODE, dc.SIS_ADMIN_DEPARTMENT_NAME, dc.GRADUATE_LEVEL, dc.num_distinct_courses FROM math_units_stats mus JOIN SIS_DEPARTMENT sd ON mus.DEPARTMENT_NAME = sd.DEPARTMENT_NAME JOIN dept_courses dc ON sd.DEPARTMENT_CODE = dc.DEPARTMENT_CODE ORDER BY mus.total_units_variance DESC, dc.DEPARTMENT_CODE, dc.GRADUATE_LEVEL;\"}], \"not_found\": []}"
    },
