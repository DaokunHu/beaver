    {
      "role": "tool",
      "tool_call_id": "call_09ab738dd55d4f5895177d38",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per degree-granting department matched with Political Science HGN statistics\", \"desc\": \"For each department that grants degrees (excluding the Biology department), provide the department name, the average and variance of the total units for subjects offered by that department in the 2022 academic year, and, if the department is Political Science, also include for each HGN code the maximum number of lecture units among all subjects in the course catalog and the subject title from the subject offered table for subjects offered in the year 2012 with more than 2 lecture units, as well as the number of enrolled students for those subjects. List the results ordered by the variance of total units in descending order, and for Political Science, by the maximum lecture units in descending order. Do not return any rounded answers.\", \"id\": \"dw_2151\", \"name\": \"Degree-Granting Department 2022 Unit Average-Variance with Political Science HGN Lecture Unit Maximums\", \"sql\": \"WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_units, VARIANCE(s.TOTAL_UNITS) AS units_variance FROM SIS_DEPARTMENT d JOIN COURSE_CATALOG_SUBJECT_OFFERED s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE s.ACADEMIC_YEAR = 2022 AND d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_CODE <> '7' GROUP BY d.DEPARTMENT_NAME ORDER BY units_variance DESC ) , PoliSciHGNStats AS ( SELECT c.HGN_CODE, c.DEPARTMENT_NAME, MAX(c.LECTURE_UNITS) AS max_lecture_units, s.SUBJECT_TITLE, so.NUM_ENROLLED_STUDENTS FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN SUBJECT_OFFERED s ON c.HGN_CODE = s.HGN_CODE JOIN SUBJECT_OFFERED so ON s.SUBJECT_KEY = so.SUBJECT_KEY WHERE c.ACADEMIC_YEAR = 2012 AND c.LECTURE_UNITS > 2 AND c.DEPARTMENT_NAME = 'Political Science' GROUP BY c.HGN_CODE, c.DEPARTMENT_NAME, s.SUBJECT_TITLE, so.NUM_ENROLLED_STUDENTS HAVING MAX(c.LECTURE_UNITS) > 2 ) SELECT d.DEPARTMENT_NAME, d.avg_units, d.units_variance, p.HGN_CODE, p.max_lecture_units, p.SUBJECT_TITLE, p.NUM_ENROLLED_STUDENTS FROM inner_cte d LEFT JOIN PoliSciHGNStats p ON d.DEPARTMENT_NAME = p.DEPARTMENT_NAME ORDER BY d.units_variance DESC, p.max_lecture_units DESC\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level where the course is degree granting and the total units are greater than 6, provide the number of unique courses, the minimum total units offered, and the number of courses where the design units are at least 3. Do not return any rounded answers.\", \"id\": \"dw_3163\", \"name\": \"Degree-Granting Course Level Counts with Min Total Units and Design-Unit Course Counts\", \"sql\": \"WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT scd.COURSE) AS course_count, MIN(ccc.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units, COUNT(DISTINCT CASE WHEN ccc.DESIGN_UNITS >= 3 THEN scd.COURSE END) AS courses_with_design_units_3_or_more FROM inner_cte ic JOIN SIS_COURSE_DESCRIPTION scd ON ic.DEPARTMENT_NAME = scd.DEPARTMENT_NAME AND ic.COURSE_LEVEL = scd.COURSE_LEVEL JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level where the course is degree granting, the total units are greater than 6, and the department is Mathematics (Course 18), provide the department name, course level, number of unique courses, minimum total units offered, school name, number of distinct course options available, and the highest average number of enrolled students in any term for courses offered by that department, considering only courses with more than 0 enrolled students and departments whose name is not null. Do not return any rounded answers.\", \"id\": \"dw_1766\", \"name\": \"Math Degree-Granting Course Level Counts with Min Units, Course Options, and Highest Term Average Library Enrollment\", \"sql\": \"WITH highest_avg_enrollment AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, l.TERM_CODE, AVG(l.NUM_ENROLLED_STUDENTS) AS avg_enrollment_per_term FROM SIS_SUBJECT_CODE s JOIN LIBRARY_SUBJECT_OFFERED l ON s.COURSE_NUMBER = l.COURSE_NUMBER WHERE l.NUM_ENROLLED_STUDENTS > 0 AND s.DEPARTMENT_NAME IS NOT NULL AND s.DEPARTMENT_NAME = 'Mathematics' GROUP BY s.DEPARTMENT_NAME, l.TERM_CODE ) SELECT DEPARTMENT_NAME, MAX(avg_enrollment_per_term) AS highest_avg_enrollment_per_term FROM inner_cte GROUP BY DEPARTMENT_NAME ), course_stats AS ( WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT scd.COURSE) AS course_count, MIN(ccc.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 AND scd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT icte.DEPARTMENT_NAME, icte.COURSE_LEVEL, icte.course_count, icte.min_total_units, scd.SCHOOL_NAME, COUNT(DISTINCT scd.COURSE_OPTION) AS distinct_course_options FROM inner_cte icte JOIN SIS_COURSE_DESCRIPTION scd ON icte.DEPARTMENT_NAME = scd.DEPARTMENT_NAME AND icte.COURSE_LEVEL = scd.COURSE_LEVEL GROUP BY icte.DEPARTMENT_NAME, icte.COURSE_LEVEL, icte.course_count, icte.min_total_units, scd.SCHOOL_NAME ) SELECT cs.DEPARTMENT_NAME, cs.COURSE_LEVEL, cs.course_count, cs.min_total_units, cs.SCHOOL_NAME, cs.distinct_course_options, hae.highest_avg_enrollment_per_term FROM course_stats cs JOIN highest_avg_enrollment hae ON cs.DEPARTMENT_NAME = hae.DEPARTMENT_NAME ORDER BY cs.DEPARTMENT_NAME, cs.COURSE_LEVEL;\"}, {\"id\": \"concept_course_catalog_sources\", \"name\": \"Course Catalog Sources\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\", \"tables\": [\"COURSE_CATALOG_SUBJECT_OFFERED\", \"CIS_COURSE_CATALOG\", \"DRUPAL_COURSE_CATALOG\"], \"comparisons\": [{\"dimension\": \"Source system\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Warehouse course catalog fact table\", \"CIS_COURSE_CATALOG\": \"CIS (course information system) catalog feed\", \"DRUPAL_COURSE_CATALOG\": \"Drupal publishing-system catalog feed\"}, {\"dimension\": \"Distinctive columns\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"TERM_CODE plus EFFECTIVE_TERM_CODE, MEET_PLACE room key, RESPONSIBLE_FACULTY columns\", \"CIS_COURSE_CATALOG\": \"Same catalog attribute set keyed by ACADEMIC_YEAR/TERM_CODE; no MEET_PLACE/MEET_TIME\", \"DRUPAL_COURSE_CATALOG\": \"Adds SO_SUBJECT_ID, SO_TERM_CODE, SO_TERM_DESCRIPTION, SO_CLUSTER_TYPE linking to registrar subject offerings\"}, {\"dimension\": \"Typical join paths\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"TERM_CODE/EFFECTIVE_TERM_CODE to term tables; SUBJECT_CODE to SIS_SUBJECT_CODE/SIS_COURSE_DESCRIPTION; DEPARTMENT_CODE to SIS_DEPARTMENT; MEET_PLACE to FCLT_ROOMS\", \"CIS_COURSE_CATALOG\": \"DEPARTMENT_CODE to SIS_SUBJECT_CODE for subject-code/department resolution\", \"DRUPAL_COURSE_CATALOG\": \"SO_* columns to subject offering tables; catalog attributes used directly\"}, {\"dimension\": \"Usage in queries\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Default choice for unit statistics, HGN level, grade rules, offering flags\", \"CIS_COURSE_CATALOG\": \"Used when subject titles must be resolved through SIS_SUBJECT_CODE department groupings\", \"DRUPAL_COURSE_CATALOG\": \"Used when catalog data must be tied back to registrar offering records via SO_* keys\"}], \"decision_guide\": {\"Questions about units, grade type/rule, HGN level, HASS/GIR attributes, or IS_OFFERED_* flags of subjects\": \"Use COURSE_CATALOG_SUBJECT_OFFERED as the default catalog source; it also carries MEET_PLACE for location analysis.\", \"Questions that resolve subjects through SIS subject codes by department (e.g. counting subjects per department from the CIS feed)\": \"Use CIS_COURSE_CATALOG joined to SIS_SUBJECT_CODE on DEPARTMENT_CODE.\", \"Questions that need catalog attributes tied to registrar subject offering records (cluster type, offering term description)\": \"Use DRUPAL_COURSE_CATALOG via its SO_SUBJECT_ID / SO_TERM_CODE columns.\"}}, {\"id\": \"concept_department_dimension\", \"name\": \"Department and School Dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\", \"tables\": [\"SIS_DEPARTMENT\", \"STUDENT_DEPARTMENT\", \"SIS_ADMIN_DEPARTMENT\"], \"comparisons\": [{\"dimension\": \"Attribute coverage\", \"SIS_DEPARTMENT\": \"Richest: DEPARTMENT_FULL_NAME, SCHOOL_CODE/SCHOOL_NAME, DEPT_BUDGET_CODE, IS_DEGREE_GRANTING, commencement-book names, DLC key\", \"STUDENT_DEPARTMENT\": \"Minimal: code, name, full name, school code/name only\", \"SIS_ADMIN_DEPARTMENT\": \"Administrative contact: department phone area code/number, clearing cost collector\"}, {\"dimension\": \"Degree-granting and school filtering\", \"SIS_DEPARTMENT\": \"Supports IS_DEGREE_GRANTING and SCHOOL_NAME filters directly\", \"STUDENT_DEPARTMENT\": \"Only school code/name attribution, no degree-granting flag\", \"SIS_ADMIN_DEPARTMENT\": \"No school or degree-granting attributes\"}, {\"dimension\": \"Typical join path\", \"SIS_DEPARTMENT\": \"DEPARTMENT_CODE = offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE; also joins SIS_COURSE_DESCRIPTION.DEPARTMENT and SIS_ADMIN_DEPARTMENT.SIS_ADMIN_DEPARTMENT_CODE\", \"STUDENT_DEPARTMENT\": \"DEPARTMENT_CODE = TIP_SUBJECT_OFFERED.OFFER_DEPT_CODE and other offering department codes\", \"SIS_ADMIN_DEPARTMENT\": \"SIS_ADMIN_DEPARTMENT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE\"}, {\"dimension\": \"Budget/finance attributes\", \"SIS_DEPARTMENT\": \"DEPT_BUDGET_CODE available for budget-based ranking\", \"STUDENT_DEPARTMENT\": \"None\", \"SIS_ADMIN_DEPARTMENT\": \"CLEARING_COST_COLLECTOR\"}], \"decision_guide\": {\"Questions filtering departments by school (e.g. 'School of Engineering') or degree-granting status\": \"Use SIS_DEPARTMENT; it carries SCHOOL_NAME and IS_DEGREE_GRANTING.\", \"Questions needing only department full name and school name for offering departments (e.g. TIP subject offerings)\": \"STUDENT_DEPARTMENT suffices and is the lighter lookup; SIS_DEPARTMENT also works.\", \"Questions needing department phone numbers or administrative contact details\": \"Join SIS_ADMIN_DEPARTMENT via SIS_DEPARTMENT.DEPARTMENT_CODE = SIS_ADMIN_DEPARTMENT_CODE.\", \"Questions ranking or grouping departments by budget code\": \"Use SIS_DEPARTMENT.DEPT_BUDGET_CODE.\"}}, {\"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS\", \"SUBJECT_SUMMARY.TOTAL_UNITS\", \"SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS\", \"CIS_COURSE_CATALOG.TOTAL_UNITS\", \"DRUPAL_COURSE_CATALOG.TOTAL_UNITS\"], \"comparisons\": [{\"dimension\": \"Source process\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS is the catalog-declared unit value per offering; SUBJECT_SUMMARY.TOTAL_UNITS and SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS are registrar subject-level values; CIS/DRUPAL catalog feeds carry their own copies\"}, {\"dimension\": \"Companion unit columns\", \"detail\": \"All these tables also expose LECTURE_UNITS, LAB_UNITS, and preparation units (PREPARATION_UNITS except SUBJECT_SUMMARY which uses PREP_UNITS); DESIGN_UNITS exists in COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY, CIS and DRUPAL catalogs but not in SUBJECT_OFFERED_SUMMARY\"}, {\"dimension\": \"Variability flag\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS marks subjects whose units vary; analyses of fixed-unit statistics typically filter IS_VARIABLE_UNITS='N'\"}], \"decision_guide\": {\"Unit statistics (avg/stddev/variance/geometric mean) over catalog offerings, optionally split by lecture/lab/design or filtered by variable-units flag\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS with its companion unit columns.\", \"Unit statistics tied to actual enrollment records or subject groups per term\": \"Use SUBJECT_SUMMARY.TOTAL_UNITS.\", \"Unit statistics at subject-offering rollup level with offering department/school\": \"Use SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS.\", \"Fixed-unit analyses excluding variable-unit subjects\": \"Filter COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS = 'N'.\"}, \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\", \"id\": \"column_concept_total_units\", \"name\": \"Total Credit Units\"}, {\"id\": \"column_concept_department_name\", \"name\": \"Department Name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME\", \"SUBJECT_SUMMARY.DEPARTMENT_NAME\", \"SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY.OFFER_DEPT_NAME\", \"TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SIS_DEPARTMENT.DEPARTMENT_NAME\", \"STUDENT_DEPARTMENT.DEPARTMENT_NAME\", \"SIS_COURSE_DESCRIPTION.DEPARTMENT_NAME\", \"SIS_SUBJECT_CODE.DEPARTMENT_NAME\", \"EMPLOYEE_DIRECTORY.DEPARTMENT_NAME\", \"LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT\", \"MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME\", \"SE_PERSON.ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DEPARTMENT_NAME is used by catalog/summary tables (COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY), department/course lookup tables, and the student directory (MIT_STUDENT_DIRECTORY); OFFER_DEPT_NAME is used by offering/program tables (SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY, TIP_SUBJECT_OFFERED, LIBRARY_SUBJECT_OFFERED) and denotes the department that actually offers the subject; LIBRARY_COURSE_INSTRUCTOR uses the plain column name DEPARTMENT for the course's academic department; SE_PERSON uses ORGANIZATION for the person's organizational unit\"}, {\"dimension\": \"Value format\", \"detail\": \"Catalog, summary, offering, student-directory, and lookup tables store plain department names (e.g. 'Mathematics', 'Chemistry', 'Electrical Eng & Computer Sci'); LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT stores a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics', '06 - Electrical Eng & Computer Sci'), with some unprefixed values (e.g. 'Architecture'), so it is not directly comparable to plain-name columns without stripping the prefix\"}, {\"dimension\": \"Academic vs HR/organization value domain\", \"detail\": \"Catalog, summary, offering, library, student-directory, and lookup tables share the academic department domain; EMPLOYEE_DIRECTORY.DEPARTMENT_NAME is the HR organizational unit name and has a different domain (e.g. 'Lincoln Laboratory', 'Department of Physics'), where some values coincide with academic names but many do not, and some carry a 'Department of ...' prefix; SE_PERSON.ORGANIZATION holds organizational unit names that may use different naming variants than the academic domain for the same unit (e.g. 'Electrical Engineering-Computer Science' vs the academic 'Electrical Eng & Computer Sci'), so equality filters across the two conventions must use each table's own variant\"}, {\"dimension\": \"Companion code column\", \"detail\": \"Catalog/summary tables carry DEPARTMENT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE; offering/program tables carry OFFER_DEPT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE or STUDENT_DEPARTMENT.DEPARTMENT_CODE; MIT_STUDENT_DIRECTORY carries DEPARTMENT (the academic department code) joining SIS_DEPARTMENT.DEPARTMENT_CODE, which is the reliable join key instead of the name; LIBRARY_COURSE_INSTRUCTOR has no department code column, only the prefixed name text; EMPLOYEE_DIRECTORY carries DEPARTMENT_NUMBER (HR department number) and SE_PERSON carries no department code, neither joining to SIS_DEPARTMENT.DEPARTMENT_CODE\"}], \"decision_guide\": {\"Filtering subjects by department in catalog or summary analysis\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME or SUBJECT_SUMMARY.DEPARTMENT_NAME.\", \"Filtering by department in section-level, textbook-program, or library analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Joining fact tables to department dimension attributes (school, full name, degree-granting)\": \"Prefer code joins: DEPARTMENT_CODE / OFFER_DEPT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE; name equality joins are used when codes are unavailable.\", \"Matching departments across a DEPARTMENT_NAME table and an OFFER_DEPT_NAME table\": \"The values are directly comparable (same academic name domain), e.g. joining SUBJECT_SUMMARY.DEPARTMENT_NAME to TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME.\", \"Filtering employees by their HR organizational unit (e.g. names containing 'Department', or HR units like 'Political Science')\": \"Use EMPLOYEE_DIRECTORY.DEPARTMENT_NAME; do not join it to SIS_DEPARTMENT.DEPARTMENT_CODE, and pair it with DEPARTMENT_NUMBER for HR grouping.\", \"Filtering by department in section-level, textbook-program, or library subject analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Filtering library reserve course instructors by academic department or library unit\": \"Use LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT with the prefixed value format (e.g. '18 - Mathematics'); do not compare it directly to plain department-name columns.\", \"Filtering students by their academic department\": \"Use MIT_STUDENT_DIRECTORY.DEPARTMENT (code) joined to SIS_DEPARTMENT.DEPARTMENT_CODE for reliable matching, or MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME for direct name filters; the name shares the academic domain with SIS_DEPARTMENT.DEPARTMENT_NAME.\", \"Filtering a person master (SE_PERSON) record by organizational unit such as an academic department\": \"Use SE_PERSON.ORGANIZATION with its own naming variant (e.g. 'Electrical Engineering-Computer Science'); do not equate it directly to MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME or SIS_DEPARTMENT.DEPARTMENT_NAME, which use the academic variant (e.g. 'Electrical Eng & Computer Sci').\"}}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_01b7ada8c4274629a94fa112",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"count\": 27, \"items\": [{\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"entity_type\": \"table\", \"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\", \"entity_type\": \"table\", \"id\": \"ACADEMIC_TERMS_ALL\", \"name\": \"ACADEMIC_TERMS_ALL\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\", \"entity_type\": \"table\", \"id\": \"TIP_DETAIL\", \"name\": \"TIP_DETAIL\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\", \"entity_type\": \"table\", \"id\": \"LIBRARY_SUBJECT_OFFERED\", \"name\": \"LIBRARY_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Independent Activities Period (IAP) subject detail table: one row per IAP activity offered in a January term, with activity title/description, enrollment type, maximum enrollment, fee, prerequisites, preregistration deadline, cancellation and multiple-session flags, and foreign keys to category, sponsor, session, and person tables.\", \"entity_type\": \"table\", \"id\": \"IAP_SUBJECT_DETAIL\", \"name\": \"IAP_SUBJECT_DETAIL\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\", \"entity_type\": \"table\", \"id\": \"SIS_SUBJECT_CODE\", \"name\": \"SIS_SUBJECT_CODE\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"entity_type\": \"table\", \"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"entity_type\": \"table\", \"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Facilities room inventory table: one row per physical room with building/floor keys, room identifiers, use classifications (major/minor use), organization assignment, area in square meters, access level, and geographic coordinates. Joins to FCLT_BUILDING via FCLT_BUILDING_KEY; referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE via FCLT_ROOM_KEY.\", \"entity_type\": \"table\", \"id\": \"FCLT_ROOMS\", \"name\": \"FCLT_ROOMS\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"entity_type\": \"table\", \"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_OFFERED\", \"name\": \"SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"entity_type\": \"table\", \"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"entity_type\": \"table\", \"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\", \"entity_type\": \"table\", \"id\": \"CIS_COURSE_CATALOG\", \"name\": \"CIS_COURSE_CATALOG\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Employee directory table: one row per institute employee with MIT ID, legal and preferred name components, directory/primary titles, HR department number and name, office location and office phone, email address, personal URL, and Kerberos name. Used to resolve responsible faculty contact details (full name, email, office phone) for subject offerings via RESPONSIBLE_FACULTY_MIT_ID = MIT_ID, and to link employees to Moira mailing list membership via MIT_ID = MOIRA_LIST_MEMBER_MIT_ID.\", \"entity_type\": \"table\", \"id\": \"EMPLOYEE_DIRECTORY\", \"name\": \"EMPLOYEE_DIRECTORY\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"CIS lookup table decoding HASS (Humanities, Arts, and Social Sciences) attribute codes used in course catalog subject records. Each code (e.g. 'HA', 'HH', 'HS', 'HE', 'HD1'-'HD5', 'HDL', and combined codes like 'HA,HH') maps to two description variants: the description shown on the registration form and the shorter description printed in the bulletin, plus the CIS attribute group ('H' = HASS_ATTRIBUTE for students entering Fall 2010 or later, 'G' = GIR_ATTRIBUTE for students entering prior to Fall 2010) with a group note, and icon display attributes. Catalog tables (COURSE_CATALOG_SUBJECT_OFFERED, CIS_COURSE_CATALOG, DRUPAL_COURSE_CATALOG) join to this lookup via HASS_ATTRIBUTE. Note: a code can appear once per attribute group (e.g. 'HE' exists in both group H and group G), so joins on HASS_ATTRIBUTE alone may produce multiple matching rows.\", \"entity_type\": \"table\", \"id\": \"CIS_HASS_ATTRIBUTE\", \"name\": \"CIS_HASS_ATTRIBUTE\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Subject attribute lookup table decoding attribute codes attached to subjects: academic attributes (type 'A') such as calculus/science prerequisites and HASS-D/HASS category codes, and non-academic program flags (type 'N') such as ROTC, ESG, Concourse, co-op, and listener rules. Provides short, full, and reporting descriptions per code. Overlaps with CIS_HASS_ATTRIBUTE on HASS-family codes (HD1-HD5, HDL, HE, HA, HH, HS) but differs in scope: SUBJECT_ATTRIBUTE covers all subject attribute types with one description variant per code, while CIS_HASS_ATTRIBUTE covers only HASS attribute codes with separate registration-form and bulletin descriptions plus attribute-group (H/G) classification. Catalog subject records' GIR_ATTRIBUTE codes all resolve against SUBJECT_ATTRIBUTE_CODE.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_ATTRIBUTE\", \"name\": \"SUBJECT_ATTRIBUTE\"}, {\"relation_type\": \"concept\", \"direction\": \"incoming\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\", \"entity_type\": \"concept\", \"id\": \"concept_subject_offering_facts\", \"name\": \"Subject Offering Fact Tables\"}, {\"relation_type\": \"concept\", \"direction\": \"incoming\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\", \"entity_type\": \"concept\", \"id\": \"concept_course_catalog_sources\", \"name\": \"Course Catalog Sources\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_term_code\", \"name\": \"Term Code\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_subject_id\", \"name\": \"Subject Identifier\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_department_name\", \"name\": \"Department Name\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_total_units\", \"name\": \"Total Credit Units\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_year_columns\", \"name\": \"Academic and Fiscal Year Columns\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code and description columns. The code columns appear in the three course catalog feeds and in the CIS_HASS_ATTRIBUTE lookup; description columns exist in three variants: the catalog-embedded HASS_ATTRIBUTE_DESC, the lookup's DESCRIPTION_ON_FORM (registration-form wording), and DESCRIPTION_IN_BULLETIN (short bulletin wording). Selecting the right description variant depends on the wording requested by the question.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_hass_attribute\", \"name\": \"HASS Attribute Code and Descriptions\"}]}"
    },
    {
      "role": "assistant",
      "content": "Let me search for precedent metrics with geometric mean and check the actual data:\n\n",
      "tool_calls": [
        {
          "id": "call_d7105387de81474a8a46dd9d",
          "type": "function",
          "function": {
            "name": "semantic_search",
            "arguments": "{\"query\": \"geometric mean of total units per school above below average comparison grand total per school department null\", \"topk\": 20}"
          }
        },
        {
          "id": "call_2dff22201dc04fe88dd89f51",
          "type": "function",
          "function": {
            "name": "mysql_query",
            "arguments": "{\"sql\": \"SELECT COUNT(*) AS n, COUNT(DISTINCT SCHOOL_NAME) AS schools, COUNT(DISTINCT DEPARTMENT_NAME) AS depts FROM SIS_SUBJECT_CODE\"}"
          }
        }
      ]
    },
    {
      "role": "tool",
      "tool_call_id": "call_d7105387de81474a8a46dd9d",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 77, \"items_by_type\": {\"table\": [{\"id\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\"}, {\"id\": \"SPACE_UNIT\", \"desc\": \"Space unit dimension table: one row per space unit (an organizational space-assignment unit such as a department, program, or office that receives space allocation), with space unit key/code, space unit name, the facilities organization it belongs to, and DLC key. Bridges FCLT_ORGANIZATION (organization attribution) and SPACE_DETAIL (rooms assigned to the space unit); used to group room counts and space statistics by space unit.\"}, {\"id\": \"FCLT_ORGANIZATION\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\"}, {\"id\": \"HR_ORG_UNIT_NEW\", \"desc\": \"Newer HR organization unit dimension table: one row per HR organization unit with the same unit/department identity and hierarchy-path structure as HR_ORG_UNIT (unit key/ID/title/level, HR department code and name variants, school-area/top-level/root names, hierarchy path levels 1-5, DLC_KEY) but a shallower hierarchy path (levels 6-7 absent), no HR_DEPARTMENT_ID and no DLC_NAME column, and an extra HR_DEPARTMENT_ABBR abbreviation column. Holds more unit rows than HR_ORG_UNIT (691 vs 641, including units absent from HR_ORG_UNIT); use HR_ORG_UNIT when DLC_NAME or the deeper hierarchy path is required, HR_ORG_UNIT_NEW for the newer unit coverage.\"}, {\"id\": \"SPACE_SUPERVISOR_USAGE\", \"desc\": \"Space supervisor usage fact table: one row per supervisor (MIT_ID) recording how much space they supervise and for how many departments: department count, department DLC key list (comma-separated when multiple), number of supervisees, supervised square footage, research volume, and derived ratio measures (sqft per supervisee, sqft per research volume, research volume per sqft). Joins to SPACE_UNIT and other DLC-carrying tables via DEPT_NAMES = DLC_KEY (only single-department rows match); used for supervisor space-usage and research-volume statistics per department/DLC.\"}, {\"id\": \"SPACE_DETAIL\", \"desc\": \"Space assignment detail fact table: one row per physical room assigned to a space unit, with building/floor/space-unit/space-usage keys, room identifiers (building-room number and name, room number), room square footage, room counter, and building component. Used to count rooms per space unit or per building, and to analyze room size and usage distribution. Joins to SPACE_UNIT via SPACE_UNIT_KEY, FCLT_BUILDING via BUILDING_KEY, SPACE_FLOOR via FLOOR_KEY, and SPACE_USAGE via SPACE_USAGE_KEY.\"}, {\"id\": \"HR_ORG_UNIT\", \"desc\": \"HR organization unit dimension table: one row per HR organization unit with unit key/ID/title, unit level classification (ALL MIT, TOP LEVEL, DEPARTMENTS, SUB DEPARTMENT, ORGANIZATION LEVEL, NON HIERARCHY ORG UNITS), HR department identifiers and name variants (short, long, alphabetical), organization hierarchy area names (school area, top level, root), the full HR hierarchy path levels 1-7 (each with ID, sort order, and name), and DLC_KEY/DLC_NAME cross-references to departments/labs/centers. Joined from FCLT_ORGANIZATION and MASTER_DEPT_HIERARCHY via DLC_KEY to attach HR department attributes (title, level, department name, long name, hierarchy path) to facilities organizations and DLCs; a single DLC_KEY can map to multiple HR org unit rows, so joins via DLC_KEY may fan out.\"}, {\"id\": \"MASTER_DEPT_HIERARCHY\", \"desc\": \"Master department hierarchy table: one row per department/lab/center (DLC) under the 'Standard Hierarchy' hierarchy type, recording the DLC key/code/name and its five-level hierarchy path from the institute root (level 1 'All Departments') through executive areas down to the DLC's placement, with each level's code and name (null for levels deeper than the DLC's position). Joins to HR_ORG_UNIT and FCLT_ORGANIZATION via DLC_KEY; used to report or filter the master-hierarchy placement (school/area path) of a DLC, and as a DLC scope filter when only DLCs present in the standard hierarchy should be included.\"}, {\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\"}, {\"id\": \"MASTER_DEPT_HIERARCHY_LINKS\", \"desc\": \"Master department hierarchy link table: one row per association between a department/lab/center (DLC) and a linked administrative object, classified by link type (Standard Funds Center, PCMIT-0 Profit Center, New/Old Org. Unit, Facilities Org., Student Systems Unit, NIMBUS B.A.G.). A DLC may hold many links of several types. Joins to MASTER_DEPT_HIERARCHY via DLC_KEY; used to map DLCs to their fund centers, profit centers, facilities organizations, and other linked object codes.\"}, {\"id\": \"FCLT_BUILDING\", \"desc\": \"Facilities building inventory table: one row per physical building with building number/name, type (e.g. ACADEMIC), ownership, use, occupancy class, gross/assignable/non-assignable areas, number of rooms, key dates (built/acquired/occupied), site and geographic coordinates. Parent of FCLT_ROOMS via FCLT_BUILDING_KEY.\"}, {\"id\": \"STUDENT_DEPARTMENT\", \"desc\": \"Student-facing department lookup table with department code, name, full name, and school attribution (code and name). Similar in content to SIS_DEPARTMENT but oriented to student information systems reporting; joins to offering tables via DEPARTMENT_CODE.\"}, {\"id\": \"ZPM_ROOMS_LOAD\", \"desc\": \"Space-planning room load table: one row per room record from the space planning feed, with the building-room identifier, building component, floor (numeric or label such as 'G9'), space usage text (e.g. 'DSGN STUDIO', 'CONF RM'), space unit code, HR organization unit id, and room access level. Links rooms to SPACE_UNIT via SPACE_UNIT_CODE and to FCLT_ORGANIZATION/HR_ORG_UNIT via HR_ORG_UNIT_ID; used for floor/access-level/space-usage room analysis from the space-planning perspective, without the area and use-key columns carried by FCLT_ROOMS.\"}, {\"id\": \"FAC_ORGANIZATION\", \"desc\": \"Facilities organization snapshot table with the same hierarchical organization structure as FCLT_ORGANIZATION (organization identifiers, parent/major organization, level, assignable flag, course number, description, HR cross-references) but keyed by ORGANIZATION_KEY and carrying D_CODE instead of DLC_KEY/DLC_NAME. Contains fewer organizations than FCLT_ORGANIZATION; used as an alternative organization dimension in FAC_* family queries.\"}, {\"id\": \"FCLT_BUILDING_HIST\", \"desc\": \"Historical facilities building snapshot table: one row per building per fiscal period (FISCAL_PERIOD in YYYYMM format, covering 201505-201906, 48 periods, ~255 buildings), preserving each building's attributes over time: identifiers and names, gross/assignable/non-assignable areas, site, campus sector, access level, building type, ownership type, use, occupancy class, height, cost center/collector references, coordinates, and number of rooms. Used for fiscal-period building history analysis (area/room-count trends, dispersion statistics across historical records); use FCLT_BUILDING for the current snapshot. Date columns (DATE_BUILT/DATE_ACQUIRED/DATE_OCCUPIED) are stored in MM/DD/YYYY format; FCLT_BUILDING_HIST_1 is the variant storing them in DD-MON-YY format.\"}, {\"id\": \"SUBJECT_OFFERED\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\"}, {\"id\": \"SIS_ADMIN_DEPARTMENT\", \"desc\": \"SIS administrative department table with administrative department code/name, phone area code and phone number, and clearing cost collector. Joins to SIS_DEPARTMENT via SIS_ADMIN_DEPARTMENT_CODE = DEPARTMENT_CODE for department contact information.\"}, {\"id\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\"}, {\"id\": \"SUBJECT_GROUPING\", \"desc\": \"7 columns in total\"}, {\"id\": \"FCLT_FLOOR\", \"desc\": \"Facilities floor inventory table: one row per floor of a building (floor key formatted '<building key>-<floor>'), with floor number/label, gross, assignable and non-assignable areas of the floor, sort sequence, level identifier, building wing, and access level. Child of FCLT_BUILDING via FCLT_BUILDING_KEY and parent of FCLT_ROOMS via FCLT_FLOOR_KEY; used for per-floor area aggregation and floor-level filtering (e.g. floors with assignable area above a threshold).\"}], \"metric\": [{\"id\": \"dw_4061\", \"desc\": \"For each department and academic year, show the department name, academic year, academic year description, and the geometric mean of the total units for all subjects offered by the department in regular terms with total units greater than zero, along with, for each academic building where these subjects are held and which has rooms larger than 40 square meters, the building name, the average, range, and variance of the room areas, as well as the total assignable area of the building and the year the building was built. The results are ordered by department name, academic year (descending), and room area range (descending). Do not return any rounded answers.\"}, {\"id\": \"dw_2597\", \"desc\": \"For each academic year, what is the description of the academic year, the department name, the average total units for all subjects offered by that department in terms that match that academic year and have a term status indicator of 'P', and the deviation of each department's average total units from the overall average total units for that academic year? Do not return any rounded answers.\"}, {\"id\": \"dw_1833\", \"desc\": \"For each department and subject grade type where the subject is offered in the current academic year, is letter graded, and the department is Mathematics (Course 18), provide the number of subjects, the minimum total units, the school name, the department phone number, the organization name, the standard deviation (using STDDEV only and never STDDEV_POP) of the areas of its rooms, and the department's DLC name, including subtotals for each department (the corresponding department field is 'SUBTOTAL') and a grand total across all departments (the corresponding department field is 'TOTAL'). Do not repeat the department if it is the same as the previous row. Only include organizations that have more than 5 rooms, are associated with a non-null DLC key, and are not the 'ADMISSIONS' department or the 'Political Science' department. Sort the table by department, grade type, and descending standard deviation (using STDDEV only and never STDDEV_POP) of room areas. Do not return any rounded answers.\"}, {\"id\": \"dw_3890\", \"desc\": \"For each major use description, list the building-room identifier, area, major use description, and assign row numbers within a window of 2 preceding and 1 following rows ordered by the major use description, as well as the organization name, department name, department code, department long name, department level, and the average organization number in a window of 2 preceding and 2 following rows grouped by the organization parent, ordered by the organization name, but only include those organizations whose organization number is greater than the average organization number of their parent group. For each major use description, include a grand total row for all rooms in the format of (null, null, major use description, total rooms) and only include rooms whose organization matches the filtered organizations. Do not return any rounded answers.\"}, {\"id\": \"dw_1335\", \"desc\": \"List, for each department, either (a) the department's full name, the range and variance of the total units for degree-granting Mathematics department courses offered in the 2008 academic year along with the long course description for each course (with the reason 'Math 2008 Stats'), or (b) the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units) where the average total units is greater than the overall average across all departments (with the reason 'High Avg Units'). Show the columns in the following order: department name, total units range, total units variance, average total units, standard deviation (using STDDEV only and never STDDEV_POP) of total units, long course description, and reason for inclusion. Do not return any rounded answers.\"}, {\"id\": \"dw_4387\", \"desc\": \"For each department in the School of Engineering with total student enrollment in its courses greater than the average total enrollment across all Engineering departments (and with total enrollment greater than 50), display the department name, the total number of students enrolled in its courses, and the highest average total units for subjects it has ever offered in a regular academic term, listing the results in descending order of total enrollment. Do not return any rounded answers.\"}, {\"id\": \"dw_1393\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_2272\", \"desc\": \"For the Mathematics department, what is the department name, the average of the total units, the range of the total units, the variance of the total units for courses with total units greater than 0, and for each course level, what is the number of unique students and the minimum CIP program code among their courses, considering only degree-granting departments? Additionally, for each course level, what is the average number of lecture units and the maximum number of lab units for Mathematics courses? Do not return any rounded answers.\"}, {\"id\": \"dw_4701\", \"desc\": \"For each academic year, what is the academic year, academic year description, the geometric mean of the number of library reserve material details per subject offered (considering only records where the material status is 'U' and the academic term is a regular term), the average total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the average number of design units for subjects that are offered in the fall term and have a material status of 'U' in the library reserve? List the results ordered by the geometric mean of materials per subject in descending order, then by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_1350\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\"}, {\"id\": \"dw_3235\", \"desc\": \"For each department name and its corresponding facility organization key where the department is in the Provost Area, provide the number of organizations, the minimum department hierarchy level 3 code, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the number of HR organization units per facility organization (considering only those with a non-null DLC key and where the hierarchy type is 'Standard Hierarchy'), listing the results in order by department name and facility organization key. Do not return any rounded answers.\"}, {\"id\": \"dw_41\", \"desc\": \"For each academic year, provide the academic year description and calculate the average and variance of the total units for subjects offered in terms that are not the current term, have a term status indicator of 'P', are offered by the Mathematics department, and are full term subjects. Do not return any rounded answers.\"}, {\"id\": \"dw_2616\", \"desc\": \"For each space unit with a room square footage greater than 100, what is the building room, building room name, space usage, the number of distinct floors it appears on, and the total room counter, but only include those where the total room counter is greater than the average room counter across all space units with room square footage greater than 100? Do not return any rounded answers.\"}, {\"id\": \"dw_4612\", \"desc\": \"For each organization whose parent is 'S H&SS' and that is associated with a space unit with space unit code 97500, list the organization name, description, HR org unit title, row number within a window of 2 preceding and 1 following rows ordered by the organization name, the space unit name, space unit code, department count, number of supervisees, the average department count within each department count group ordered by number of supervisees, and the total square footage for each organization. Include subtotals for each organization (the corresponding organization name field is 'SUBTOTAL') and a grand total across all organizations (the corresponding organization name field is 'TOTAL'). Do not repeat the organization name if it is the same as the previous row. Sort the table by organization name and space unit name. Do not return any rounded answers.\"}, {\"id\": \"dw_3867\", \"desc\": \"For each subject in a department where the school code and subject title are not null, and for each subject offered in the 2022FA term with total units greater than the average for that term, display the subject code, subject code description, department name, subject title, the number of subjects in the same department, the subject ID, the term description, and the running sum of total units for that academic year, ordered by subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_12\", \"desc\": \"For each building type, show the building type name, the ownership type, and calculate the average, range, and variance of the number of rooms in building history records for buildings of that type and ownership type that are located on the MIT site, but exclude buildings that are classified as residential. For each building type, include a grand total for all ownership types in the format of (building type, null, total statistics). Do not return any rounded answers.\"}, {\"id\": \"dw_3410\", \"desc\": \"For rooms with an area greater than 300 and located in buildings with more than 100 rooms, show the building's long name, the room's full name, the room's area, and the row number within a window of 2 preceding and 1 following rows ordered by the building's long name, along with the name of the space unit, the associated organization name, and both the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the organization numbers for all organizations linked to that space unit (considering only space units with a non-null DLC key and organizations with assignable status), where the room and the space unit share the same organization key. List the columns in the following order: building's long name, room's full name, room's area, window row number, space unit name, organization name, organization number variance, and organization number standard deviation (using STDDEV only and never STDDEV_POP). Do not return any rounded answers.\"}, {\"id\": \"dw_3078\", \"desc\": \"For each subject title and department name where the total units are greater than 3, give the number of offered sections, the minimum number of enrolled students, and the average lab units for those subjects. Do not return any rounded answers.\"}, {\"id\": \"dw_2224\", \"desc\": \"For each subject code where the department is degree granting and the department is Mathematics, and for each department that is degree granting and is not the Mathematics department (Course 18), show the subject code, subject code description, mathematics department name, school name, the average department budget code within each school, the administrative department name, the average clearing cost collector, the variance of the clearing cost collector, the standard deviation (using STDDEV only and never STDDEV_POP) of the clearing cost collector, and the most recent activity date for the administrative department. Do not return any rounded answers.\"}, {\"id\": \"dw_3342\", \"desc\": \"For each space unit with a space unit key greater than 100000 that is associated with a department in the \\\"Provost Area\\\", show the space unit code, the organization name, the HR department name, the sum of space unit keys within each warehouse load date group, the HR department code, the school area name, and the rank of the department within its school area based on department code. Present the results ordered by school area name, department rank within school area, and space unit code. Do not return any rounded answers.\"}], \"concept\": [{\"id\": \"concept_department_dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\"}, {\"id\": \"concept_room_space_inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\"}, {\"id\": \"concept_dept_hr_org_hierarchy\", \"desc\": \"Tables describing the institute's department/lab/center (DLC) and HR organization hierarchies: the HR organization unit dimension in two feed variants (HR_ORG_UNIT, HR_ORG_UNIT_NEW), the master department standard hierarchy path (MASTER_DEPT_HIERARCHY), its DLC-to-administrative-object link table (MASTER_DEPT_HIERARCHY_LINKS), and the direct-parent department lookup (MASTER_DEPT_DCODE_PARENT). They jointly answer questions about which HR department/area a DLC or organization belongs to, the hierarchy path or parent of a department, and HR department names/codes/levels, and are joined to FCLT_ORGANIZATION via DLC_KEY for facilities/space attribution. They differ in hierarchy representation (full path vs direct parent vs HR unit attributes), unit coverage, and companion columns.\"}, {\"id\": \"concept_facility_organization_dimension\", \"desc\": \"Organization dimension tables describing the institute's hierarchical organization tree used for facilities/space attribution: FCLT_ORGANIZATION (keyed by FCLT_ORGANIZATION_KEY, with DLC_KEY/DLC_NAME) and FAC_ORGANIZATION (keyed by ORGANIZATION_KEY, with D_CODE). They answer the same questions about organization names, hierarchy levels, parent/major organizations, assignable flags, and HR cross-references, but belong to different table families and coverage.\"}, {\"id\": \"concept_space_unit_dimension\", \"desc\": \"Space unit lookup tables identifying the organizational units that receive space allocation: SPACE_UNIT (with FCLT_ORGANIZATION_KEY organization attribution) and SPACE_UNIT2 (identity/name only). They answer the same space-unit identity questions but differ in organization linkage and coverage.\"}, {\"id\": \"concept_building_inventory\", \"desc\": \"Tables recording the physical building inventory and its attributes (number/name, type, ownership, site, campus sector, access level, gross/assignable/non-assignable areas, number of rooms, key dates): the current FCLT_* family snapshot, its fiscal-period history (in two date-format variants), the FAC_* family snapshot, and the lightweight space-domain building lookup. They jointly answer questions about building characteristics, areas, and room counts, but differ in time coverage, table family, attribute richness, and area units.\"}, {\"id\": \"concept_subject_offering_facts\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\"}, {\"id\": \"concept_room_major_use_classification\", \"desc\": \"Lookup tables classifying rooms by major use (classrooms, offices, laboratories, residential, circulation, etc.) with a short code, description, and assignable-space flag. They cover the current classification in the FCLT and FAC table families and the fiscal-period historical classification in the FCLT family, jointly answering questions about what a room is primarily used for and whether that use counts as assignable space.\"}, {\"id\": \"concept_time_dimension\", \"desc\": \"Time dimension tables of the warehouse at three granularities: TIME_DAY (one row per calendar date, with fiscal/calendar year and period, academic year, financial aid year, day of week, and the academic term code/description of the day), TIME_MONTH (one row per fiscal period in YYYYMM format, covering fiscal years 1996-2035, with fiscal quarter, calendar month, academic term, and financial aid year mappings), and TIME_QUARTER (one row per fiscal quarter, covering fiscal years 2000-2035, with quarter dates, payroll certification deadlines, and quarter status flags). They jointly answer questions about when fiscal periods/quarters/days run, which fiscal/calendar/academic year a date or month belongs to, and how day-level records roll up to months and quarters. They link to each other via FISCAL_PERIOD (day-month), FY_QUARTER_CODE (month-quarter), and FISCAL_YEAR (month-quarter association within the same fiscal year, fanning out months across all quarters of the year), and to the academic term tables via TIME_DAY.ACADEMIC_TERM_CODE or TIME_MONTH.ACADEMIC_TERM = TERM_CODE.\"}, {\"id\": \"concept_floor_inventory\", \"desc\": \"Tables recording the floor level of buildings: the current FCLT_* family floor inventory with floor areas, the FAC_* family floor snapshot with the same structure, the fiscal-period historical floor table, and the lightweight space-domain floor lookup. They jointly answer questions about floor numbers and per-floor assignable/non-assignable areas, but differ in time coverage, table family, and attribute richness.\"}, {\"id\": \"concept_academic_term_dimension\", \"desc\": \"Tables describing academic terms and their calendar/status attributes. They jointly answer questions about when terms run, which academic/financial-aid/degree year a term belongs to, and whether a term is current, previous, future, or regular. Coverage differs: the full historical term list, the status-tracked term subset, and the three-row relative term parameter reference.\"}, {\"id\": \"concept_person_directory\", \"desc\": \"Tables describing people of the institute keyed by MIT_ID: the primary employee directory (contact details, titles, HR department), the Drupal-sourced employee feed (employee group/type, appointment flags, HR org unit), the person master table (payroll rank, position title, active flag), the HR faculty roster (appointment type, terminal degree, emeritus status), the OPA current-person snapshot (HR job/appointment attributes, faculty flag, sabbatical), and the student directory (students with department attribution and student year). They jointly answer questions about who a person is, their contact details, job/appointment attributes, and whether they are employee, faculty, or student; responsible faculty in subject offering tables resolve to these tables via RESPONSIBLE_FACULTY_MIT_ID = MIT_ID.\"}, {\"id\": \"concept_course_catalog_sources\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\"}, {\"id\": \"concept_building_address\", \"desc\": \"Tables recording the postal/street addresses of buildings: the current FCLT_* family address table (multiple purpose-typed address rows per building), its fiscal-period historical counterpart, the FAC_* family address snapshot, and the single-text address fields of the space-domain BUILDINGS lookup. They jointly answer questions about where a building is located (street number/name, city, state, postal code), but differ in time coverage, address decomposition, and table family.\"}, {\"id\": \"concept_iap_activities\", \"desc\": \"Tables describing Independent Activities Period (IAP) activities offered in January terms: activity details (title, enrollment type, max enrollment, fee, cancellation flags), sessions (location, date, times), sponsors (name, type), categories, and persons. They jointly answer questions about IAP activity counts, enrollment capacity, fees, session scheduling, and sponsorship.\"}, {\"id\": \"concept_cip_program_classification\", \"desc\": \"Lookup tables of the Classification of Instructional Programs (CIP) used to classify courses/instructional programs into two-digit categories, four-digit series, and six-digit program codes, with revision version years (1990/2000/2010/2020). CIP holds the current single-version classification (one row per program code, with a change NOTE), while CIP_WITH_VERSION preserves every revision of each program code across versions. Both join to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE to attribute courses to CIP programs and categories.\"}, {\"id\": \"concept_course_material_programs\", \"desc\": \"Tables covering course material provisioning: the Textbook Information Program (TIP) tracking textbook adoption status per subject offering, and library reserve processing tracking catalog items placed on reserve for subjects. They jointly answer questions about which subjects have course materials/textbooks, material status (TIP statuses such as 'RQ' Required, 'EO' Electronic options; library statuses such as 'U' Unknown, 'Y' Required Course Material), ISBNs, record counts, and reserve catalog item attributes. The two programs are linked by SUBJECT_ID + TERM_CODE.\"}, {\"id\": \"concept_moira_mailing_lists\", \"desc\": \"Tables of the Moira mailing-list/group domain: the list master (one row per list with name, description, active flag, and type flags such as mailing list, group, NFS group, public, hidden), the membership detail (one row per list member with member login, full name, MIT ID, and last update date), and the owner lookup (one row per owner entity with owner name and owner type LIST/USER/KERBEROS). They jointly answer questions about which lists exist and their properties, who belongs to a list, and who owns a list; MOIRA_LIST is the parent of MOIRA_LIST_DETAIL via MOIRA_LIST_KEY, and MOIRA_LIST_OWNER is referenced by MOIRA_LIST_DETAIL via MOIRA_LIST_OWNER_KEY.\"}], \"column_concept\": [{\"id\": \"column_concept_num_of_rooms\", \"desc\": \"NUM_OF_ROOMS columns recording how many rooms a building contains, replicated across the current and historical building tables of both families. The building-table columns hold the current room count (one value per building); the history-table columns hold the room count at each fiscal period, used for room-count statistics (average, range, variance, minimum) across a building's history records.\"}, {\"id\": \"column_concept_enrollment_measures\", \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\"}, {\"id\": \"column_concept_assignable_area\", \"desc\": \"Assignable-area measure columns at different granularity levels and time semantics: building-level current and per-fiscal-period assignable area, floor-level assignable area, and the space-domain assignable square footage. All FCLT_*/FAC_* columns are in square meters; BUILDINGS.BLDG_ASSIGNABLE_SQUARE_FOOTAGE is in square feet. Choosing the right column determines whether the measure is a building total, a floor total, a historical value, or a space-assignment figure.\"}, {\"id\": \"column_concept_space_unit_key\", \"desc\": \"Space unit key columns identifying the organizational space-assignment unit across the space dimension and fact tables. SPACE_UNIT_KEY is the join key linking SPACE_DETAIL room rows to space unit identity (name/code) and, through SPACE_UNIT, to the owning facilities organization.\"}, {\"id\": \"column_concept_total_units\", \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\"}, {\"id\": \"column_concept_dlc_key\", \"desc\": \"Department/Lab/Center key columns (values like 'D_AEROASTRO', 'D_IDSS', 'D_BIOLOGY') identifying a DLC across the facilities, HR, space, and academic-department domains. They are the universal cross-domain join key linking facilities organizations and space units to HR organization units, the master department hierarchy, and academic departments. Naming and completeness vary: DLC_KEY in most tables, D_CODE in MASTER_DEPT_DCODE_PARENT, DLC_CODE in the master hierarchy tables; some columns carry composite values ('D_DSL:HQ') or nulls.\"}, {\"id\": \"column_concept_department_name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\"}, {\"id\": \"column_concept_facility_organization_key\", \"desc\": \"Facility organization key columns attributing space units and rooms to organizations in the hierarchical organization tree. Two naming conventions exist across table families (FCLT_ORGANIZATION_KEY in FCLT_*/SPACE_* tables vs ORGANIZATION_KEY in FAC_* tables) with the same value domain.\"}, {\"id\": \"column_concept_building_room\", \"desc\": \"Combined building-room identifier columns (e.g. '1-080') appearing in both the space assignment fact table and the facilities room inventory. They identify the same physical room concept but come from different business processes with different coverage and companion measures.\"}, {\"id\": \"column_concept_building_type_site\", \"desc\": \"Building classification columns replicated across the current and historical building tables of both table families: BUILDING_TYPE ('ACADEMIC', 'SERVICE', 'RESIDENT') and SITE ('MIT', 'BATES', 'LINC', 'BOS', etc.). They carry the same value domain but differ in time semantics: the building-table columns are the current classification, while the history-table columns are the classification recorded at each fiscal period, so filtering by one versus the other can select different building sets.\"}, {\"id\": \"column_concept_year_columns\", \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\"}, {\"id\": \"column_concept_access_level\", \"desc\": \"Access level columns recorded at three granularity levels of the facilities domain plus the space-planning room feed: building-level ACCESS_LEVEL_CODE/ACCESS_LEVEL_NAME (current and per-fiscal-period history), floor-level ACCESS_LEVEL, and room-level ACCESS_LEVEL (FCLT_ROOMS, FAC_ROOMS, ZPM_ROOMS_LOAD). They share a numeric value domain (observed 0-3) but describe the access restriction of different physical objects or come from different feeds, so filters and joins must target the granularity and table family the question refers to.\"}, {\"id\": \"column_concept_term_code\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\"}, {\"id\": \"column_concept_fiscal_period\", \"desc\": \"Fiscal period code columns in YYYYMM format (e.g. '199602' = FY1996 period 2, '201505') appearing in two distinct roles: as the primary key of the month-grain time dimension (TIME_MONTH.FISCAL_PERIOD, also mirrored in TIME_DAY.FISCAL_PERIOD for day-to-month linkage), and as the snapshot-period stamp of the facilities historical tables (FCLT_BUILDING_HIST, FCLT_BUILDING_HIST_1, FCLT_BUILDING_ADDRESS_HIST, FCLT_FLOOR_HIST, FCLT_ROOMS_HIST, FCLT_MAJOR_USE_HIST). Both roles share the same YYYYMM value domain, but the time dimension uses it for calendar grouping while the history tables use it to mark when a facilities snapshot was taken.\"}, {\"id\": \"column_concept_office_location\", \"desc\": \"OFFICE_LOCATION columns recording where a person's office/desk is, replicated across the person-directory tables (SE_PERSON, MIT_STUDENT_DIRECTORY, EMPLOYEE_DIRECTORY, DRUPAL_EMPLOYEE_DIRECTORY). All hold a building or building-room text identifier in the same value domain as FCLT_ROOMS.BUILDING_ROOM, but they describe different populations (employee/person master vs student vs primary employee directory vs Drupal employee feed) and differ sharply in non-null coverage and in how many values are building-room ('BLDG-ROOM') versus building-only ('BLDG'). Choosing the right column determines whose office is reported and whether room-level joins to FCLT_ROOMS succeed.\"}, {\"id\": \"column_concept_subject_id\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\"}, {\"id\": \"column_concept_master_subject_id\", \"desc\": \"Master subject identifier columns (MASTER_SUBJECT_ID and its sortable variant MASTER_SUBJECT_ID_SORT) replicated across the registrar offering tables, the subject summary, the textbook program, the library reserve program, and the CIS course catalog. For clustered subjects (e.g. joint or cross-listed offerings), the master subject identifier points to the leading subject of the cluster, so joining on it matches offerings that share the same master subject even when their own SUBJECT_ID differs. SUBJECT_ID/SUBJECT_ID_SORT identify the subject itself, while MASTER_SUBJECT_ID/MASTER_SUBJECT_ID_SORT identify the cluster's master; the _SORT columns are the sortable forms of the same values used for cross-table joins.\"}, {\"id\": \"column_concept_hass_attribute\", \"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code and description columns. The code columns appear in the three course catalog feeds and in the CIS_HASS_ATTRIBUTE lookup; description columns exist in three variants: the catalog-embedded HASS_ATTRIBUTE_DESC, the lookup's DESCRIPTION_ON_FORM (registration-form wording), and DESCRIPTION_IN_BULLETIN (short bulletin wording). Selecting the right description variant depends on the wording requested by the question.\"}, {\"id\": \"column_concept_material_status_key\", \"desc\": \"Material status key columns of the textbook program (TIP) and library reserve program. Both are coded status references decoded by their own lookup tables (key value equals code value), with independent value domains: TIP statuses ('RQ' Required, 'EO' Electronic options, 'RC' Recommended, 'PC' Val-u option, 'BR' Bookstore recommends, 'CL' Go to class first, 'NM' Course has no materials, 'U' Unknown, plus NULL-description keys) vs library reserve statuses ('U' Unknown, 'R' null description, 'N' Non-Required Course Material, 'O' Reserve only, 'X' No Required Textbook, 'Y' Required Course Material).\"}]}}"
    },
    {
