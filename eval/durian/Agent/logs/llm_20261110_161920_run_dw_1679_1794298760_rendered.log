      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per Engineering degree-granting course\", \"desc\": \"For courses in the School of Engineering that are degree granting, show the course description, department name, the dense rank of each course considering the current and 2 preceding rows ordered by the department's budget code, the subject code description, and the row number of each course within a window of 2 preceding and 1 following rows ordered by course description. Do not return any rounded answers.\", \"id\": \"dw_3828\", \"name\": \"Engineering Degree-Granting Courses Budget Code Dense Ranks with Subject Code Description Row Numbers\", \"sql\": \"WITH Subquery1 AS ( SELECT t0.COURSE_DESCRIPTION, t1.DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t1.DEPT_BUDGET_CODE ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column, t0.COURSE FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE WHERE t1.SCHOOL_NAME = 'Engineering' AND t1.IS_DEGREE_GRANTING = 'Y' ), Subquery2 AS ( SELECT t1.COURSE_DESCRIPTION, t1.DEPARTMENT_NAME, t0.SUBJECT_CODE_DESC, ROW_NUMBER() OVER (ORDER BY t1.COURSE_DESCRIPTION ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t1.COURSE FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.SUBJECT_CODE = t1.COURSE WHERE t1.SCHOOL_NAME = 'Engineering' AND t1.IS_DEGREE_GRANTING = 'Y' ) SELECT s1.COURSE_DESCRIPTION, s1.DEPARTMENT_NAME, s1.window_column AS dense_rank_by_budget_code, s2.SUBJECT_CODE_DESC, s2.window_column AS row_number_by_course_description FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.COURSE = s2.COURSE ORDER BY s1.COURSE_DESCRIPTION\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject per Engineering course in same department\", \"desc\": \"For each department and each subject offered in the academic year 2024, show the department name, subject code, subject number, subject title, term code, term description, and the highest minimum total units (in a window of 3 preceding and 1 following row ordered by academic year) for that subject, along with the course description, subject code description, and the difference between the number of characters in the course description and the average number of characters in course descriptions for that department, for courses in the School of Engineering that are degree granting. Do not return any rounded answers.\", \"id\": \"dw_3989\", \"name\": \"2024 Subjects Windowed Min Units with Engineering Course Description Length Deviation\", \"sql\": \"WITH inner_cte1 AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.SUBJECT_TITLE, t0.TERM_CODE, t1.TERM_DESCRIPTION, t0.DEPARTMENT_NAME, MIN(t0.TOTAL_UNITS) OVER (ORDER BY t1.ACADEMIC_YEAR ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2024 ), cte1 AS ( SELECT DEPARTMENT_NAME, SUBJECT_CODE, SUBJECT_NUMBER, SUBJECT_TITLE, TERM_CODE, TERM_DESCRIPTION, MAX(window_column) AS highest_min_total_units FROM inner_cte1 GROUP BY DEPARTMENT_NAME, SUBJECT_CODE, SUBJECT_NUMBER, SUBJECT_TITLE, TERM_CODE, TERM_DESCRIPTION ), inner_cte2 AS ( SELECT t1.COURSE_DESCRIPTION, t1.DEPARTMENT_NAME, t0.SUBJECT_CODE_DESC, t1.COURSE FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.SUBJECT_CODE = t1.COURSE WHERE t1.SCHOOL_NAME = 'Engineering' AND t1.IS_DEGREE_GRANTING = 'Y' ), dept_avg AS ( SELECT DEPARTMENT_NAME, AVG(LENGTH(COURSE_DESCRIPTION)) AS avg_desc_length FROM inner_cte2 GROUP BY DEPARTMENT_NAME ), cte2 AS ( SELECT i.COURSE_DESCRIPTION, i.DEPARTMENT_NAME, i.SUBJECT_CODE_DESC, (LENGTH(i.COURSE_DESCRIPTION) - d.avg_desc_length) AS desc_length_deviation, i.COURSE FROM inner_cte2 i JOIN dept_avg d ON i.DEPARTMENT_NAME = d.DEPARTMENT_NAME ) SELECT cte1.DEPARTMENT_NAME, cte1.SUBJECT_CODE, cte1.SUBJECT_NUMBER, cte1.SUBJECT_TITLE, cte1.TERM_CODE, cte1.TERM_DESCRIPTION, cte1.highest_min_total_units, cte2.COURSE_DESCRIPTION, cte2.SUBJECT_CODE_DESC, cte2.desc_length_deviation FROM cte1 JOIN cte2 ON cte1.DEPARTMENT_NAME = cte2.DEPARTMENT_NAME AND cte1.SUBJECT_CODE = cte2.COURSE ORDER BY cte1.DEPARTMENT_NAME, cte1.SUBJECT_CODE, cte1.SUBJECT_NUMBER;\"}], \"not_found\": []}"
