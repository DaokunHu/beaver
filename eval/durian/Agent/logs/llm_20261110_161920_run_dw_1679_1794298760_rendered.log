    {
      "role": "tool",
      "tool_call_id": "call_148d17beedb54552bd050283",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department per subject code with fall-only offering enrollment average\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and the average number of enrolled students for each subject in the department, considering only subjects that are offered in the fall term and are not offered in the summer term. Do not return any rounded answers.\", \"id\": \"dw_2398\", \"name\": \"Department Course Counts with Fall-Only Non-Summer Subject Average TIP Enrollment\", \"sql\": \"WITH inner_cte AS ( SELECT sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL, COUNT(DISTINCT scd.COURSE) AS Total_Courses FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER GROUP BY sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL ) SELECT icte.DEPARTMENT_NAME, icte.SUBJECT_CODE, icte.SUBJECT_CODE_DESC, icte.GRADUATE_LEVEL, icte.Total_Courses, AVG(tso.NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM inner_cte icte JOIN TIP_SUBJECT_OFFERED tso ON icte.SUBJECT_CODE = tso.COURSE_NUMBER JOIN SIS_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE AND sd.DEPARTMENT_NAME = icte.DEPARTMENT_NAME JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON tso.SUBJECT_ID = ccso.SUBJECT_ID WHERE ccso.IS_OFFERED_FALL_TERM = 'Y' AND ccso.IS_OFFERED_SUMMER_TERM = 'N' GROUP BY icte.DEPARTMENT_NAME, icte.SUBJECT_CODE, icte.SUBJECT_CODE_DESC, icte.GRADUATE_LEVEL, icte.Total_Courses ORDER BY icte.DEPARTMENT_NAME, icte.SUBJECT_CODE;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department per subject code\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\", \"id\": \"dw_4756\", \"name\": \"Department Course Counts with 2022 12-Unit Subjects Having Textbooks\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_TITLE, t1.TERM_DESCRIPTION, t0.TOTAL_UNITS, AVG(t2.SUBJECT_ENROLLMENT_NUMBER) OVER ( PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2022 AND t0.TOTAL_UNITS = 12 ) SELECT sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL, Total_Courses.Total_Courses, COALESCE(SubjectsWithTextbooks.Subjects_With_Textbooks, 0) AS Subjects_With_Textbooks_2022_12units FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER JOIN ( SELECT sd.DEPARTMENT_NAME, COUNT(DISTINCT COURSE_NUMBER) AS Total_Courses FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER GROUP BY sd.DEPARTMENT_NAME ) AS Total_Courses ON sd.DEPARTMENT_NAME = Total_Courses.DEPARTMENT_NAME LEFT JOIN ( SELECT s1.DEPARTMENT_NAME, COUNT(DISTINCT s1.SUBJECT_CODE || '-' || s1.SUBJECT_NUMBER) AS Subjects_With_Textbooks FROM inner_cte s1 JOIN TIP_DETAIL t2 ON s1.TERM_CODE = t2.TERM_CODE AND s1.SUBJECT_ID = t2.SUBJECT_ID WHERE t2.TIP_MATERIAL_STATUS_KEY IN ('RQ', 'EO') GROUP BY s1.DEPARTMENT_NAME ) AS SubjectsWithTextbooks ON sd.DEPARTMENT_NAME = SubjectsWithTextbooks.DEPARTMENT_NAME ;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level, where the total number of enrolled students in offered subjects is greater than 10, and the department is Mathematics (Course 18), provide the number of unique courses, the minimum total units among those subjects that are degree-granting courses, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for Mathematics courses (considering only departments that offer more than five courses), and the number of unique subject codes for Mathematics in the SIS_SUBJECT_CODE table. List the department name, course level, number of unique courses, minimum total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the number of unique subject codes, in that order. Do not return any rounded answers.\", \"id\": \"dw_2335\", \"name\": \"Math Degree-Granting Course Level Counts with Catalog Unit Stddev and Unique Subject Codes\", \"sql\": \"WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, c.COURSE_LEVEL, COUNT(DISTINCT c.COURSE) AS course_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.NUM_ENROLLED_STUDENTS > 10 AND d.DEPARTMENT_NAME = 'Mathematics' AND c.IS_DEGREE_GRANTING = 'Y' GROUP BY d.DEPARTMENT_NAME, c.COURSE_LEVEL ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.COURSE_LEVEL, inner_cte.course_count, inner_cte.min_total_units, subq2.units_stddev, subq3.unique_subject_codes FROM inner_cte JOIN ( SELECT s.DEPARTMENT_NAME, STDDEV(c.TOTAL_UNITS) AS units_stddev FROM SIS_SUBJECT_CODE s JOIN CIS_COURSE_CATALOG c ON s.DEPARTMENT_CODE = c.DEPARTMENT_CODE WHERE c.TOTAL_UNITS IS NOT NULL AND s.DEPARTMENT_NAME = 'Mathematics' GROUP BY s.DEPARTMENT_NAME HAVING COUNT(*) > 5 ) subq2 ON inner_cte.DEPARTMENT_NAME = subq2.DEPARTMENT_NAME JOIN ( SELECT DEPARTMENT_NAME, COUNT(DISTINCT SUBJECT_CODE) AS unique_subject_codes FROM SIS_SUBJECT_CODE WHERE DEPARTMENT_NAME = 'Mathematics' GROUP BY DEPARTMENT_NAME ) subq3 ON inner_cte.DEPARTMENT_NAME = subq3.DEPARTMENT_NAME;\"}], \"not_found\": []}"
