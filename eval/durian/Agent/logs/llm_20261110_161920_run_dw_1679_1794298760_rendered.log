    {
      "role": "tool",
      "tool_call_id": "call_ff7837ac11244b84b17c3aa7",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entity\": {\"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per 2006FA subject matched with 2017JA subject of same department\", \"desc\": \"For each subject offered in the academic term with term code '2006FA' in departments that offer more than 5 subjects in that term, show the subject ID, subject title, department name, the sum of lecture units within each grade type group, and the total number of subjects per department for that term. Additionally, for each subject offered by the same department in the term '2017JA', show the number of enrolled students, offering department name, department full name, subject code, subject code description, and whether the number of enrolled students is 'HIGH_ENROLLMENT' (at least 10% greater than the average for that subject code), 'LOW_ENROLLMENT' (at least 10% less than the average for that subject code), or 'AVERAGE'. Present the results ordered by subject ID and subject code. Do not return any rounded answers.\", \"id\": \"dw_3985\", \"name\": \"2006FA Department Lecture Unit Sums with 2017JA Enrollment Classification per Subject Code\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.DEPARTMENT_CODE, SUM(t1.LECTURE_UNITS) OVER (PARTITION BY t1.GRADE_TYPE ORDER BY t1.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.EFFECTIVE_TERM_CODE WHERE t0.TERM_CODE = '2006FA' ), DeptCounts AS ( SELECT DEPARTMENT_NAME, DEPARTMENT_CODE, COUNT(*) AS SUBJECT_COUNT FROM COURSE_CATALOG_SUBJECT_OFFERED WHERE EFFECTIVE_TERM_CODE = '2006FA' GROUP BY DEPARTMENT_NAME, DEPARTMENT_CODE HAVING COUNT(*) > 5 ), inner_cte2 AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t0.OFFER_DEPT_CODE, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), subject_code_avg AS ( SELECT SUBJECT_CODE, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM inner_cte2 GROUP BY SUBJECT_CODE ) SELECT ic1.SUBJECT_ID, ic1.SUBJECT_TITLE, ic1.DEPARTMENT_NAME, ic1.window_column, dc.SUBJECT_COUNT, ic2.NUM_ENROLLED_STUDENTS, ic2.OFFER_DEPT_NAME, ic2.DEPARTMENT_FULL_NAME, ic2.SUBJECT_CODE, ic2.SUBJECT_CODE_DESC, CASE WHEN ic2.NUM_ENROLLED_STUDENTS > sca.avg_enrollment * 1.1 THEN 'HIGH_ENROLLMENT' WHEN ic2.NUM_ENROLLED_STUDENTS < sca.avg_enrollment * 0.9 THEN 'LOW_ENROLLMENT' ELSE 'AVERAGE' END AS enrollment_category FROM inner_cte1 ic1 JOIN DeptCounts dc ON ic1.DEPARTMENT_NAME = dc.DEPARTMENT_NAME AND ic1.DEPARTMENT_CODE = dc.DEPARTMENT_CODE JOIN SIS_DEPARTMENT sd ON ic1.DEPARTMENT_CODE = sd.DEPARTMENT_CODE JOIN inner_cte2 ic2 ON ic1.DEPARTMENT_CODE = ic2.OFFER_DEPT_CODE JOIN subject_code_avg sca ON ic2.SUBJECT_CODE = sca.SUBJECT_CODE ORDER BY ic1.SUBJECT_ID, ic2.SUBJECT_CODE;\"}}"
