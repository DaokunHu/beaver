    {
      "role": "tool",
      "tool_call_id": "call_80ea43e66284401aa0ddcc9e",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_12\", \"name\": \"Building Type Ownership Rollup of Historical Room Count Statistics for MIT Non-Residential Buildings\", \"desc\": \"For each building type, show the building type name, the ownership type, and calculate the average, range, and variance of the number of rooms in building history records for buildings of that type and ownership type that are located on the MIT site, but exclude buildings that are classified as residential. For each building type, include a grand total for all ownership types in the format of (building type, null, total statistics). Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT FCLT_BUILDING.BUILDING_TYPE, FCLT_BUILDING.OWNERSHIP_TYPE, FCLT_BUILDING_HIST.NUM_OF_ROOMS FROM FCLT_BUILDING JOIN FCLT_BUILDING_HIST ON FCLT_BUILDING.FCLT_BUILDING_KEY = FCLT_BUILDING_HIST.FCLT_BUILDING_KEY WHERE FCLT_BUILDING_HIST.SITE = 'MIT' AND FCLT_BUILDING.BUILDING_TYPE <> 'RESIDENT' ) SELECT BUILDING_TYPE, OWNERSHIP_TYPE, AVG(NUM_OF_ROOMS) AS avg_num_rooms, MAX(NUM_OF_ROOMS) - MIN(NUM_OF_ROOMS) AS num_rooms_range, VARIANCE(NUM_OF_ROOMS) AS num_rooms_variance FROM inner_cte GROUP BY BUILDING_TYPE, OWNERSHIP_TYPE WITH ROLLUP HAVING BUILDING_TYPE IS NOT NULL ORDER BY BUILDING_TYPE, OWNERSHIP_TYPE\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per building type and ownership type rollup combination\"}, {\"id\": \"dw_1302\", \"name\": \"Engineering Degree-Granting Department 2007 Course Rollup with Department Unit Totals and Latest-Year Course Counts\", \"desc\": \"For each course offered by a degree-granting department in the School of Engineering, except for the Electrical Engineering and Computer Science department, in the 2007 academic year, what is the course key, course name, department name, the number of catalog subjects, the total units for those subjects, and for each department, include a grand total for all courses in the format of (null, null, department name, total subjects, total units)? Additionally, for each such department, what is the total number of units for courses in the \\\"Engineering\\\" or \\\"Non-MIT\\\" schools (where the total units for the department is greater than 1000 and the department is not \\\"Political Science\\\"), and how many distinct courses did the department offer in the most recent academic year available? Present the results as: course key, course name, department name, number of catalog subjects, total units for those subjects, department total units, and number of distinct courses in the latest year, in that order. Do not return any rounded answers.\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT scd.SIS_COURSE_DESCRIPTION_KEY, scd.COURSE, sd.DEPARTMENT_NAME, COUNT(ccc.SUBJECT_ID) AS subject_count, SUM(ccc.TOTAL_UNITS) AS total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.SCHOOL_NAME = 'Engineering' AND ccc.ACADEMIC_YEAR = '2007' AND sd.DEPARTMENT_NAME != 'Electrical Eng & Computer Sci' GROUP BY scd.SIS_COURSE_DESCRIPTION_KEY, scd.COURSE, sd.DEPARTMENT_NAME ) SELECT CASE WHEN GROUPING(SIS_COURSE_DESCRIPTION_KEY) = 1 THEN NULL ELSE SIS_COURSE_DESCRIPTION_KEY END AS SIS_COURSE_DESCRIPTION_KEY, CASE WHEN GROUPING(COURSE) = 1 THEN NULL ELSE COURSE END AS COURSE, DEPARTMENT_NAME, SUM(subject_count) AS subject_count, SUM(total_units) AS total_units FROM inner_cte GROUP BY DEPARTMENT_NAME, SIS_COURSE_DESCRIPTION_KEY, COURSE WITH ROLLUP HAVING SUM(subject_count) > 0 ORDER BY DEPARTMENT_NAME, SIS_COURSE_DESCRIPTION_KEY ), subq2 AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, SUM(c.TOTAL_UNITS) AS total_units FROM SIS_SUBJECT_CODE s JOIN CIS_COURSE_CATALOG c ON s.SUBJECT_CODE = c.SUBJECT_CODE WHERE s.SCHOOL_NAME IN ('Engineering', 'Non-MIT') AND s.DEPARTMENT_NAME <> 'Political Science' GROUP BY s.DEPARTMENT_NAME HAVING SUM(c.TOTAL_UNITS) > 1000 ) SELECT ic.DEPARTMENT_NAME, ic.total_units, COUNT(DISTINCT c.SUBJECT_NUMBER) AS num_courses_latest_year FROM inner_cte ic JOIN SIS_SUBJECT_CODE s ON ic.DEPARTMENT_NAME = s.DEPARTMENT_NAME JOIN CIS_COURSE_CATALOG c ON s.SUBJECT_CODE = c.SUBJECT_CODE WHERE c.ACADEMIC_YEAR = ( SELECT MAX(ACADEMIC_YEAR) FROM CIS_COURSE_CATALOG ) GROUP BY ic.DEPARTMENT_NAME, ic.total_units ) SELECT s1.SIS_COURSE_DESCRIPTION_KEY, s1.COURSE, s1.DEPARTMENT_NAME, s1.subject_count, s1.total_units, s2.total_units AS department_total_units, s2.num_courses_latest_year FROM subq1 s1 JOIN subq2 s2 ON s1.DEPARTMENT_NAME = s2.DEPARTMENT_NAME ORDER BY s1.DEPARTMENT_NAME, s1.SIS_COURSE_DESCRIPTION_KEY ;\", \"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per course per Engineering degree-granting department plus rollup totals\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per graduate course plus rollup totals plus Spring 2021 letter-graded summary row\", \"desc\": \"For each course in the Mathematics department that is degree granting and has a course level of 'G', show the course description, department name, school name, the administrative department name, and the dense rank over the administrative department name ordered by the administrative department name. Additionally, for each administrative department name, include a grand total of the number of such courses in the format of (null, null, null, administrative department name, null, total courses). Also, show the minimum total units, the sum of lecture units, and the number of unique subjects for letter graded Mathematics department subjects offered in the Spring Term 2021, along with the department name and term description (with all other columns as null). Do not return any rounded answers.\", \"id\": \"dw_1427\", \"name\": \"Math Graduate Degree-Granting Courses Ranked by Admin Department with Spring 2021 Letter-Graded Unit Summary\", \"sql\": \"WITH inner_cte_1 AS ( SELECT scd.COURSE_DESCRIPTION, sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, sad.SIS_ADMIN_DEPARTMENT_NAME, DENSE_RANK() OVER (ORDER BY sad.SIS_ADMIN_DEPARTMENT_NAME) AS admin_dept_dense_rank FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT sad ON sd.DEPARTMENT_CODE = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND scd.COURSE_LEVEL = 'G' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' ), CourseTotals AS ( SELECT SIS_ADMIN_DEPARTMENT_NAME, COUNT(*) AS total_courses FROM inner_cte_1 GROUP BY SIS_ADMIN_DEPARTMENT_NAME ), inner_cte_2 AS ( SELECT MIN(c.TOTAL_UNITS) AS min_total_units, SUM(c.LECTURE_UNITS) AS sum_lecture_units FROM ACADEMIC_TERMS_ALL a JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON a.TERM_CODE = c.TERM_CODE WHERE a.TERM_CODE = '2021SP' AND c.GRADE_TYPE = 'L' AND c.DEPARTMENT_NAME = 'Mathematics' ) SELECT ic.COURSE_DESCRIPTION, ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, ic.admin_dept_dense_rank, NULL AS total_courses, NULL AS min_total_units, NULL AS sum_lecture_units, NULL AS num_unique_subjects, NULL AS term_description FROM inner_cte_1 ic UNION ALL SELECT NULL, NULL, NULL, ct.SIS_ADMIN_DEPARTMENT_NAME, NULL, ct.total_courses, NULL, NULL, NULL, NULL FROM CourseTotals ct UNION ALL SELECT NULL, a.DEPARTMENT_NAME, NULL, NULL, NULL, NULL, inner_cte_2.min_total_units, inner_cte_2.sum_lecture_units, COUNT(DISTINCT a.SUBJECT_ID) AS num_unique_subjects, b.TERM_DESCRIPTION FROM COURSE_CATALOG_SUBJECT_OFFERED a JOIN ACADEMIC_TERMS_ALL b ON a.TERM_CODE = b.TERM_CODE CROSS JOIN inner_cte_2 WHERE a.TERM_CODE = '2021SP' AND a.GRADE_TYPE = 'L' AND a.DEPARTMENT_NAME = 'Mathematics' GROUP BY a.DEPARTMENT_NAME, b.TERM_DESCRIPTION, inner_cte_2.min_total_units, inner_cte_2.sum_lecture_units ORDER BY SIS_ADMIN_DEPARTMENT_NAME, COURSE_DESCRIPTION\"}], \"not_found\": []}"
