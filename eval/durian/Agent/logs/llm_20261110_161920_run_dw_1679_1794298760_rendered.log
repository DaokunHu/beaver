    {
      "role": "tool",
      "tool_call_id": "call_0c0927600e5842ed8f7dbe1d",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per top-3 Mathematics course per effective term\", \"desc\": \"For the top 3 most frequently offered courses in the Mathematics department, for each course and each term it was offered, display the course number, course description, subject title, number of times offered, department name, number of unique course descriptions for that course and department, the minimum CIP program code for that course and department, the term code, the term description, the school name, and the department phone number. Do not repeat the course number if it is the same as the previous row. Sort the table by course number and term code. Do not return any rounded answers.\", \"id\": \"dw_2365\", \"name\": \"Top 3 Most Offered Math Courses per Term with Description Counts, Min CIP Code, and Department Phone\", \"sql\": \"WITH inner_cte AS ( WITH course_desc_stats AS ( SELECT scd.COURSE, sd.DEPARTMENT_NAME, COUNT(DISTINCT scd.COURSE_DESCRIPTION) AS course_description_count, MIN(scd.CIP_PROGRAM_CODE) AS min_cip_program_code FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT sad ON sd.DEPARTMENT_CODE = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY scd.COURSE, sd.DEPARTMENT_NAME ), top_math_courses AS ( SELECT ssc.COURSE_NUMBER, scd.COURSE_DESCRIPTION, ccc.SUBJECT_TITLE, COUNT(*) AS offer_count FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_SUBJECT_CODE ssc ON scd.COURSE = ssc.SUBJECT_CODE JOIN CIS_COURSE_CATALOG ccc ON ssc.SUBJECT_CODE = ccc.SUBJECT_CODE WHERE scd.DEPARTMENT_NAME = 'Mathematics' GROUP BY ssc.COURSE_NUMBER, scd.COURSE_DESCRIPTION, ccc.SUBJECT_TITLE ORDER BY offer_count DESC LIMIT 3 ) SELECT tmc.COURSE_NUMBER, tmc.COURSE_DESCRIPTION, tmc.SUBJECT_TITLE, tmc.offer_count, cds.DEPARTMENT_NAME, cds.course_description_count, cds.min_cip_program_code, scd.FROM_TERM, scd.FROM_TERM_DESCRIPTION, scd.SCHOOL_NAME, sad.DEPARTMENT_PHONE_NUMBER FROM top_math_courses tmc JOIN SIS_COURSE_DESCRIPTION scd ON tmc.COURSE_DESCRIPTION = scd.COURSE_DESCRIPTION JOIN course_desc_stats cds ON scd.COURSE = cds.COURSE AND cds.DEPARTMENT_NAME = 'Mathematics' JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT sad ON sd.DEPARTMENT_CODE = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY tmc.COURSE_NUMBER, tmc.COURSE_DESCRIPTION, tmc.SUBJECT_TITLE, tmc.offer_count, cds.DEPARTMENT_NAME, cds.course_description_count, cds.min_cip_program_code, scd.FROM_TERM, scd.FROM_TERM_DESCRIPTION, scd.SCHOOL_NAME, sad.DEPARTMENT_PHONE_NUMBER ORDER BY tmc.COURSE_NUMBER, scd.FROM_TERM ) SELECT CASE WHEN LAG(COURSE_NUMBER) OVER (ORDER BY COURSE_NUMBER, FROM_TERM) = COURSE_NUMBER THEN NULL ELSE COURSE_NUMBER END AS COURSE_NUMBER, COURSE_DESCRIPTION, SUBJECT_TITLE, offer_count, DEPARTMENT_NAME, course_description_count, min_cip_program_code, FROM_TERM, FROM_TERM_DESCRIPTION, SCHOOL_NAME, DEPARTMENT_PHONE_NUMBER FROM inner_cte ORDER BY COURSE_NUMBER, FROM_TERM;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per school per description status plus rollup totals matched with 2022SU subjects\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name (from subject code), school name, the number of subject codes per school name and whether the subject code description is present ('Has Description') or missing ('No Description'), and for each matching department in subjects offered in the term with code '2022SU', show the subject's ID, total units, department name (from subject offered), and their dense rank considering the current and 2 preceding rows ordered by the total number of units. For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes, null, null, null, null). Do not return any rounded answers.\", \"id\": \"dw_3904\", \"name\": \"Degree-Granting Subject Code Description Status Rollup by School with 2022SU Unit Dense Ranks\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' ), SubjectCodeVisibility AS ( SELECT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, CASE WHEN SUBJECT_CODE_DESC IS NOT NULL AND SUBJECT_CODE_DESC <> 'nan' THEN 'Has Description' ELSE 'No Description' END AS description_status FROM inner_cte1 ), RollupResults AS ( SELECT SCHOOL_NAME, description_status, COUNT(*) AS total_subject_codes FROM SubjectCodeVisibility GROUP BY SCHOOL_NAME, description_status WITH ROLLUP HAVING COUNT(*) > 0 ), inner_cte2 AS ( SELECT t1.SUBJECT_ID, t1.TOTAL_UNITS, t1.DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t1.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) SELECT scv.SUBJECT_CODE, scv.SUBJECT_CODE_DESC, scv.DEPARTMENT_NAME AS SCV_DEPARTMENT_NAME, rr.SCHOOL_NAME, rr.description_status, rr.total_subject_codes, ic2.SUBJECT_ID, ic2.TOTAL_UNITS, ic2.DEPARTMENT_NAME AS IC2_DEPARTMENT_NAME, ic2.window_column FROM RollupResults rr LEFT JOIN ( SELECT DISTINCT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, description_status FROM SubjectCodeVisibility ) scv ON rr.SCHOOL_NAME = scv.SCHOOL_NAME AND rr.description_status = scv.description_status LEFT JOIN inner_cte2 ic2 ON scv.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME ORDER BY rr.SCHOOL_NAME, rr.description_status, ic2.TOTAL_UNITS DESC\"}], \"not_found\": []}"
