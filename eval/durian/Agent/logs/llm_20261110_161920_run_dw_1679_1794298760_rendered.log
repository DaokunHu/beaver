    {
      "role": "tool",
      "tool_call_id": "call_e1c720adb7a14a67a33d6ecc",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_3273\", \"name\": \"Engineering 12-Unit Courses Row Numbers with Subject Dense Ranks by Total Units\", \"desc\": \"For courses in the School of Engineering with a total of 12 units, display the course number, course description, subject title, total units, offering department name, the row number of the course within its offering department ordered by course number, and the dense rank of the subject (considering the current and 2 preceding rows ordered by total units) if available. Do not return any rounded answers.\", \"sql\": \"WITH course_windowed AS ( SELECT t0.COURSE AS course_number, t0.COURSE_DESCRIPTION, t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t1.OFFER_DEPT_NAME, ROW_NUMBER() OVER (PARTITION BY t1.OFFER_DEPT_NAME ORDER BY t0.COURSE) AS window_column FROM SIS_COURSE_DESCRIPTION t0 JOIN SUBJECT_OFFERED_SUMMARY t1 ON t0.COURSE = t1.COURSE_NUMBER WHERE t0.SCHOOL_NAME = 'Engineering' AND t1.TOTAL_UNITS = 12 ), subject_dense_ranked AS ( SELECT t2.SUBJECT_TITLE, dense_rank() OVER (ORDER BY t2.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column, t2.OFFER_DEPT_CODE FROM SIS_SUBJECT_CODE t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t1.SCHOOL_NAME = 'Engineering' ) SELECT cw.course_number, cw.COURSE_DESCRIPTION, cw.SUBJECT_TITLE, cw.TOTAL_UNITS, cw.OFFER_DEPT_NAME, cw.window_column AS course_row_number, sdr.window_column AS subject_dense_rank FROM course_windowed cw LEFT JOIN subject_dense_ranked sdr ON cw.SUBJECT_TITLE = sdr.SUBJECT_TITLE ORDER BY cw.OFFER_DEPT_NAME, cw.course_number;\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering 12-unit course matched with dense-ranked Engineering subject offerings\"}, {\"id\": \"dw_2639\", \"name\": \"2016SP Engineering School Subjects Total Units Minus Lecture Units\", \"desc\": \"For subjects offered in the term '2016SP' with a school code of 'E', show the subject title, department name, course description, and the difference between the total units and lecture units for each subject. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT t2.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.COURSE_DESCRIPTION, t2.TOTAL_UNITS, t2.LECTURE_UNITS FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.COURSE_NUMBER = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.TERM_CODE = '2016SP' AND t0.SCHOOL_CODE = 'E' ) SELECT SUBJECT_TITLE, DEPARTMENT_NAME, COURSE_DESCRIPTION, (TOTAL_UNITS - LECTURE_UNITS) AS units_minus_lecture FROM inner_cte;\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per 2016SP Engineering-school subject offering\"}, {\"category\": \"Course Catalog and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per degree-granting subject code description status per school (with rollup totals) matched with 2016SP Engineering-school subject offerings\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name, school name, the number of subject codes per school name, and whether the subject code description is present ('Has Description') or missing ('No Description'). For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes). Additionally, for subjects offered in the term '2016SP' with a school code of 'E', show the subject title, course description, the offering department name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Present all columns in the following order: subject code, subject code description, department name, school name, description status, total subject codes, subject title, course description, offering department name, and window column. Do not return any rounded answers.\", \"id\": \"dw_4490\", \"name\": \"Degree-Granting Subject Code Description Status Rollup by School with 2016SP Engineering Subject Row Numbers\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' ), SubjectCodeVisibility AS ( SELECT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, CASE WHEN SUBJECT_CODE_DESC IS NOT NULL AND SUBJECT_CODE_DESC <> 'nan' THEN 'Has Description' ELSE 'No Description' END AS description_status FROM inner_cte1 ), RollupResults AS ( SELECT SCHOOL_NAME, description_status, COUNT(*) AS total_subject_codes FROM SubjectCodeVisibility GROUP BY SCHOOL_NAME, description_status WITH ROLLUP HAVING COUNT(*) > 0 ), SubjectCodeSummary AS ( SELECT scv.SUBJECT_CODE, scv.SUBJECT_CODE_DESC, scv.DEPARTMENT_NAME, rr.SCHOOL_NAME, rr.description_status, rr.total_subject_codes FROM RollupResults rr LEFT JOIN ( SELECT DISTINCT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, description_status FROM SubjectCodeVisibility ) scv ON rr.SCHOOL_NAME = scv.SCHOOL_NAME AND rr.description_status = scv.description_status ), inner_cte2 AS ( SELECT t2.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.COURSE_DESCRIPTION, ROW_NUMBER() OVER (ORDER BY t2.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t2.OFFER_DEPT_NAME FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.COURSE_NUMBER = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.TERM_CODE = '2016SP' AND t0.SCHOOL_CODE = 'E' ), SubjectOfferSummary AS ( SELECT inner_cte2.SUBJECT_TITLE, inner_cte2.DEPARTMENT_NAME, inner_cte2.COURSE_DESCRIPTION, inner_cte2.OFFER_DEPT_NAME, inner_cte2.window_column FROM inner_cte2 JOIN SUBJECT_OFFERED_SUMMARY t2 ON inner_cte2.SUBJECT_TITLE = t2.SUBJECT_TITLE WHERE t2.TERM_CODE = '2016SP' ) SELECT scs.SUBJECT_CODE, scs.SUBJECT_CODE_DESC, scs.DEPARTMENT_NAME, scs.SCHOOL_NAME, scs.description_status, scs.total_subject_codes, sos.SUBJECT_TITLE, sos.COURSE_DESCRIPTION, sos.OFFER_DEPT_NAME, sos.window_column FROM SubjectCodeSummary scs LEFT JOIN SIS_DEPARTMENT sd ON scs.DEPARTMENT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SUBJECT_OFFERED_SUMMARY so ON sd.DEPARTMENT_CODE = so.OFFER_DEPT_CODE LEFT JOIN SubjectOfferSummary sos ON so.SUBJECT_TITLE = sos.SUBJECT_TITLE ORDER BY scs.SCHOOL_NAME, scs.description_status, sos.SUBJECT_TITLE;\"}], \"not_found\": []}"
