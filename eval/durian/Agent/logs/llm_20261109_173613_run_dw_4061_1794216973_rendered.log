    {
      "role": "tool",
      "tool_call_id": "call_f3020942618241bdb212bed0",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Facility Space Comprehensive Analysis\", \"default_granularity\": \"one row per department-year matched with academic building\", \"desc\": \"For each department and academic year, show the department name, academic year, academic year description, and the geometric mean of the total units for all subjects offered by the department in regular terms with total units greater than zero, along with, for each academic building where these subjects are held and which has rooms larger than 40 square meters, the building name, the average, range, and variance of the room areas, as well as the total assignable area of the building and the year the building was built. The results are ordered by department name, academic year (descending), and room area range (descending). Do not return any rounded answers.\", \"id\": \"dw_4061\", \"name\": \"Department Geometric Mean Total Units with Academic Building Room Area Statistics\", \"sql\": \"WITH dept_units AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, EXP(AVG(LN(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS))) AS geometric_mean_total_units, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME FROM ACADEMIC_TERMS JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' AND COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS > 0 GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME ), building_stats AS ( SELECT b.BUILDING_NAME, AVG(r.AREA) AS avg_room_area, MAX(r.AREA) - MIN(r.AREA) AS room_area_range, VARIANCE(r.AREA) AS room_area_variance FROM FCLT_ROOMS r JOIN FCLT_BUILDING b ON r.FCLT_BUILDING_KEY = b.FCLT_BUILDING_KEY WHERE b.BUILDING_TYPE = 'ACADEMIC' AND r.AREA > 40 GROUP BY b.BUILDING_NAME ) SELECT ds.DEPARTMENT_NAME, ds.ACADEMIC_YEAR, ds.ACADEMIC_YEAR_DESC, ds.geometric_mean_total_units, bs.BUILDING_NAME, bs.avg_room_area, bs.room_area_range, bs.room_area_variance, fb.ASSIGNABLE_AREA, fb.DATE_BUILT FROM dept_units ds JOIN COURSE_CATALOG_SUBJECT_OFFERED cso ON ds.DEPARTMENT_NAME = cso.DEPARTMENT_NAME AND ds.ACADEMIC_YEAR = cso.ACADEMIC_YEAR JOIN FCLT_ROOMS fr ON cso.MEET_PLACE = fr.FCLT_ROOM_KEY JOIN FCLT_BUILDING fb ON fr.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY JOIN building_stats bs ON fb.BUILDING_NAME = bs.BUILDING_NAME ORDER BY ds.DEPARTMENT_NAME, ds.ACADEMIC_YEAR DESC, bs.room_area_range DESC;\"}, {\"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per academic year\", \"desc\": \"For each academic year, what is the academic year, academic year description, the geometric mean of the number of library reserve material details per subject offered (considering only records where the material status is 'U' and the academic term is a regular term), the average total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the average number of design units for subjects that are offered in the fall term and have a material status of 'U' in the library reserve? List the results ordered by the geometric mean of materials per subject in descending order, then by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\", \"id\": \"dw_4701\", \"name\": \"Yearly Geometric Mean Reserve Materials per Subject with Fall Term Unit Statistics\", \"sql\": \"WITH inner_cte AS ( WITH GeometricMeanMaterialsPerSubject AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, EXP(AVG(LN(material_count))) AS geometric_mean_materials_per_subject FROM ( SELECT LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY, COUNT(*) AS material_count, LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE FROM LIBRARY_RESERVE_MATRL_DETAIL WHERE LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY = 'U' GROUP BY LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY, LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE ) sub JOIN ACADEMIC_TERMS ON sub.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC ), AvgStddevTotalUnitsFallU AS ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, AVG(ccso.TOTAL_UNITS) AS avg_total_units, STDDEV(ccso.TOTAL_UNITS) AS stddev_total_units FROM LIBRARY_RESERVE_MATRL_DETAIL lrm JOIN ACADEMIC_TERMS at ON lrm.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE lrm.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ) SELECT gmmps.ACADEMIC_YEAR, gmmps.ACADEMIC_YEAR_DESC, gmmps.geometric_mean_materials_per_subject, astu.avg_total_units, astu.stddev_total_units FROM GeometricMeanMaterialsPerSubject gmmps JOIN AvgStddevTotalUnitsFallU astu ON gmmps.ACADEMIC_YEAR = astu.ACADEMIC_YEAR AND gmmps.ACADEMIC_YEAR_DESC = astu.ACADEMIC_YEAR_DESC ORDER BY gmmps.geometric_mean_materials_per_subject DESC, astu.stddev_total_units DESC ) SELECT icte.ACADEMIC_YEAR, icte.ACADEMIC_YEAR_DESC, icte.geometric_mean_materials_per_subject, icte.avg_total_units, icte.stddev_total_units, avg_design.avg_design_units FROM inner_cte icte JOIN ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, AVG(ccso.DESIGN_UNITS) AS avg_design_units FROM LIBRARY_RESERVE_MATRL_DETAIL lrm JOIN ACADEMIC_TERMS at ON lrm.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE lrm.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ) avg_design ON icte.ACADEMIC_YEAR = avg_design.ACADEMIC_YEAR AND icte.ACADEMIC_YEAR_DESC = avg_design.ACADEMIC_YEAR_DESC ORDER BY icte.geometric_mean_materials_per_subject DESC, icte.stddev_total_units DESC;\"}, {\"category\": \"Academic Term Analysis\", \"default_granularity\": \"one row per academic year\", \"desc\": \"For each academic year, provide the academic year description, the geometric mean of the degree year from all academic terms where the degree year is greater than 1900, and classify the academic year as 'RECENT' if the geometric mean is at least 2010, 'OLD' if it is less than 1980, or 'AVERAGE' otherwise. Do not return any rounded answers.\", \"id\": \"dw_2957\", \"name\": \"Geometric Mean Degree Year by Academic Year with Recency Classification\", \"sql\": \"WITH inner_cte AS ( SELECT ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, ACADEMIC_TERMS_ALL.ACADEMIC_YEAR_DESC, EXP(AVG(LN(ACADEMIC_TERMS.DEGREE_YEAR))) AS geometric_mean_degree_year FROM ACADEMIC_TERMS_ALL JOIN ACADEMIC_TERMS ON ACADEMIC_TERMS_ALL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE ACADEMIC_TERMS.DEGREE_YEAR > 1900 GROUP BY ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, ACADEMIC_TERMS_ALL.ACADEMIC_YEAR_DESC ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.ACADEMIC_YEAR_DESC, inner_cte.geometric_mean_degree_year, CASE WHEN inner_cte.geometric_mean_degree_year >= 2010 THEN 'RECENT' WHEN inner_cte.geometric_mean_degree_year < 1980 THEN 'OLD' ELSE 'AVERAGE' END AS year_category FROM inner_cte ORDER BY inner_cte.geometric_mean_degree_year DESC;\"}, {\"id\": \"dw_1488\", \"name\": \"MIT Academic Building Floor Room Area Statistics with Assignable Area Dispersion and Room Counts\", \"desc\": \"For each academic building at MIT and each of its floors with total assignable area greater than 5000 and at least one room with access level 1 or 2, provide the building's long name, the floor number, the range and variance of the area of rooms on that floor (considering only rooms with access level 1 or 2), the range and variance of the assignable area of its floors that have at least one room, and the total number of rooms in the building. Do not return any rounded answers.\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT fb.BUILDING_NAME_LONG, fr.FCLT_FLOOR_KEY, MAX(fr.AREA) - MIN(fr.AREA) AS area_range, VARIANCE(fr.AREA) AS area_variance FROM FCLT_ROOMS fr JOIN FCLT_BUILDING fb ON fr.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY WHERE fr.ACCESS_LEVEL IN (1, 2) AND fb.BUILDING_TYPE = 'ACADEMIC' GROUP BY fb.BUILDING_NAME_LONG, fr.FCLT_FLOOR_KEY ) SELECT ic.BUILDING_NAME_LONG, ff.FLOOR, ic.area_range, ic.area_variance, ff.FCLT_BUILDING_KEY FROM inner_cte ic JOIN FCLT_FLOOR ff ON ic.FCLT_FLOOR_KEY = ff.FCLT_FLOOR_KEY WHERE ff.ASSIGNABLE_AREA > 5000 ), subq2 AS ( WITH inner_cte AS ( WITH floors_with_rooms AS ( SELECT DISTINCT ff.FCLT_BUILDING_KEY, ff.FLOOR, ff.ASSIGNABLE_AREA FROM FCLT_FLOOR ff JOIN FCLT_ROOMS fr ON ff.FCLT_BUILDING_KEY = fr.FCLT_BUILDING_KEY AND ff.FLOOR = fr.FLOOR ), academic_buildings AS ( SELECT DISTINCT fbh.FCLT_BUILDING_KEY, fbh.BUILDING_NAME_LONG FROM FCLT_BUILDING_HIST fbh WHERE fbh.BUILDING_TYPE = 'ACADEMIC' AND fbh.SITE = 'MIT' ) SELECT ab.FCLT_BUILDING_KEY, ab.BUILDING_NAME_LONG, MAX(fwr.ASSIGNABLE_AREA) - MIN(fwr.ASSIGNABLE_AREA) AS assignable_area_range, VARIANCE(fwr.ASSIGNABLE_AREA) AS assignable_area_variance FROM academic_buildings ab JOIN floors_with_rooms fwr ON ab.FCLT_BUILDING_KEY = fwr.FCLT_BUILDING_KEY GROUP BY ab.FCLT_BUILDING_KEY, ab.BUILDING_NAME_LONG ) SELECT ic.BUILDING_NAME_LONG, ic.assignable_area_range, ic.assignable_area_variance, COUNT(fr.FCLT_ROOM_KEY) AS total_room_count, ic.FCLT_BUILDING_KEY FROM inner_cte ic LEFT JOIN FCLT_ROOMS fr ON ic.FCLT_BUILDING_KEY = fr.FCLT_BUILDING_KEY GROUP BY ic.BUILDING_NAME_LONG, ic.assignable_area_range, ic.assignable_area_variance, ic.FCLT_BUILDING_KEY ) SELECT s1.BUILDING_NAME_LONG, s1.FLOOR, s1.area_range, s1.area_variance, s2.assignable_area_range, s2.assignable_area_variance, s2.total_room_count FROM subq1 s1 JOIN subq2 s2 ON s1.BUILDING_NAME_LONG = s2.BUILDING_NAME_LONG AND s1.FCLT_BUILDING_KEY = s2.FCLT_BUILDING_KEY ORDER BY s1.BUILDING_NAME_LONG, s1.FLOOR\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per floor of each MIT academic building with high assignable area\"}, {\"id\": \"dw_1190\", \"name\": \"Academic Building Historical Assignable Area Stddev with Room Area Average and Variance\", \"desc\": \"For each building where the building type is 'ACADEMIC', the building is not the Brown Building, and the building has more than 3 historical records, give the building name, the standard deviation (using STDDEV only and never STDDEV_POP) of the assignable area across its historical records, the average area of its rooms, and the variance of the area of its rooms, including only buildings that are academic buildings or have building number '32'. List the results in descending order of the standard deviation (using STDDEV only and never STDDEV_POP) of the assignable area. Do not return any rounded answers.\", \"sql\": \"WITH BuildingAreaStddev AS ( SELECT FCLT_BUILDING.BUILDING_NAME, STDDEV(FCLT_BUILDING_HIST.ASSIGNABLE_AREA) AS assignable_area_stddev FROM FCLT_BUILDING JOIN FCLT_BUILDING_HIST ON FCLT_BUILDING.COST_CENTER_CODE = FCLT_BUILDING_HIST.COST_CENTER_CODE WHERE FCLT_BUILDING.BUILDING_TYPE = 'ACADEMIC' AND FCLT_BUILDING.BUILDING_NAME <> 'BROWN BUILDING' GROUP BY FCLT_BUILDING.BUILDING_NAME HAVING COUNT(*) > 3 ORDER BY assignable_area_stddev DESC ), BuildingRoomStats AS ( SELECT fbh.BUILDING_NAME, AVG(fr.AREA) AS avg_area, VARIANCE(fr.AREA) AS var_area FROM FCLT_BUILDING_HIST fbh JOIN FCLT_ROOMS fr ON fbh.FCLT_BUILDING_KEY = fr.FCLT_BUILDING_KEY WHERE fbh.BUILDING_TYPE = 'ACADEMIC' OR fbh.BUILDING_NUMBER = '32' GROUP BY fbh.BUILDING_NAME ) SELECT bas.BUILDING_NAME, bas.assignable_area_stddev, brs.avg_area, brs.var_area FROM BuildingAreaStddev bas JOIN BuildingRoomStats brs ON bas.BUILDING_NAME = brs.BUILDING_NAME ORDER BY bas.assignable_area_stddev DESC;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per building name\"}], \"not_found\": []}"
    },
