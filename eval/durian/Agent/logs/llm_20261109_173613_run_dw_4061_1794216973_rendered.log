            "name": "semantic_get",
            "arguments": "{\"entity_ids\": \n[\"COURSE_CATALOG_SUBJECT_OFFERED\", \"ACADEMIC_TERMS\", \"FCLT_BUILDING\", \"FCLT_ROOMS\", \"SIS_DEPARTMENT\"]\n\n}"
