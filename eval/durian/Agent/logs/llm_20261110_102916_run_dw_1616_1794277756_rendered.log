FER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE and STUDENT_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Chemistry', 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject; used for enrollment-based rankings and window statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in the textbook program\"}, {\"id\": \"IAP_SUBJECT_DETAIL\", \"name\": \"IAP_SUBJECT_DETAIL\", \"desc\": \"Independent Activities Period (IAP) subject detail table: one row per IAP activity offered in a January term, with activity title/description, enrollment type, maximum enrollment, fee, prerequisites, preregistration deadline, cancellation and multiple-session flags, and foreign keys to category, sponsor, session, and person tables.\", \"columns\": {\"IAP_SUBJECT_CATEGORY_KEY\": {\"desc\": \"Foreign key to IAP_SUBJECT_CATEGORY.IAP_SUBJECT_CATEGORY_KEY\"}, \"IAP_SUBJECT_SPONSOR_KEY\": {\"desc\": \"Foreign key to IAP_SUBJECT_SPONSOR.IAP_SUBJECT_SPONSOR_KEY; joins to sponsor information\"}, \"IAP_SUBJECT_SESSION_KEY\": {\"desc\": \"Foreign key to IAP_SUBJECT_SESSION.IAP_SUBJECT_SESSION_KEY; joins to session details\"}, \"IAP_SUBJECT_PERSON_KEY\": {\"desc\": \"Foreign key to IAP_SUBJECT_PERSON.IAP_SUBJECT_PERSON_KEY\"}, \"ACTIVITY_TITLE\": {\"desc\": \"Title of the IAP activity\"}, \"ACTIVITY_DESCRIPTION\": {\"desc\": \"Description text of the IAP activity\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format (IAP terms use 'JA' suffix, e.g. '2021JA'); joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL and TIME_DAY.ACADEMIC_TERM_CODE\"}, \"ENROLLMENT_TYPE\": {\"desc\": \"Enrollment type of the activity, e.g. 'Advance sign-up required'\"}, \"MAX_ENROLLMENT\": {\"desc\": \"Maximum enrollment allowed for the activity; used in enrollment-capacity statistics\"}, \"ATTENDANCE\": {\"desc\": \"Attendance information/requirement of the activity\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the activity\"}, \"FEE\": {\"desc\": \"Fee amount charged for the activity\"}, \"FEE_REASON\": {\"desc\": \"Reason for the fee\"}, \"PREREG_DEADLINE\": {\"desc\": \"Pre-registration deadline date of the activity\"}, \"CREATE_DATE\": {\"desc\": \"Date the activity record was created\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"IS_MULTIPLE_SESSION\": {\"desc\": \"'Y'/'N' flag whether the activity consists of multiple sessions\"}, \"IS_CANCELLED\": {\"desc\": \"'Y'/'N' flag whether the activity is cancelled\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per IAP activity per term\", \"entity\": {\"columns\": {\"MAX_ENROLLMENT\": {\"desc\": \"Maximum enrollment allowed for the activity; null for the majority of non-cancelled activities, so enrollment-capacity statistics (average/range/variance of max enrollment) typically filter MAX_ENROLLMENT IS NOT NULL together with IS_CANCELLED = 'N'.\"}}}, \"reason\": \"Data verification shows MAX_ENROLLMENT is null for most active IAP activities (322 of 463 non-cancelled rows); documenting this coverage fact helps downstream capacity analyses apply the correct filters, as required by the dw_2737 case.\"}, {\"id\": \"ACADEMIC_TERMS_ALL\", \"name\": \"ACADEMIC_TERMS_ALL\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2019FA'\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to; used to partition running sums by financial aid year\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term (all terms)\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}], \"not_found\": []}"
