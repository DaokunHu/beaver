    },
    {
      "role": "tool",
      "tool_call_id": "call_3f0eb3b1d56c4c3db9519f2c",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_1049\", \"name\": \"Mathematics Total Units Stddev for Regular Non-Current Terms vs 2022 Degree-Granting Departments\", \"category\": \"Subject Offering Analysis\", \"desc\": \"For the Mathematics department, what is the department name, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for its subjects in regular terms that are not the current term, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department in the 2022 academic year (considering only departments that have more than five subjects offered in 2022, are degree-granting, and are not the Chemistry department)? Show the department name, the standard deviation (using STDDEV only and never STDDEV_POP) for regular non-current terms, and the standard deviation (using STDDEV only and never STDDEV_POP) for 2022. Do not return any rounded answers.\", \"sql\": \"WITH MathDeptStddev AS ( SELECT ss.DEPARTMENT_NAME, STDDEV(ss.TOTAL_UNITS) AS stddev_total_units FROM SUBJECT_SUMMARY ss JOIN ACADEMIC_TERMS at ON ss.TERM_CODE = at.TERM_CODE WHERE ss.DEPARTMENT_NAME = 'Mathematics' AND at.IS_REGULAR_TERM = 'Y' AND at.IS_CURRENT_TERM = 'N' GROUP BY ss.DEPARTMENT_NAME ), DeptStddev2022 AS ( SELECT scd.DEPARTMENT_NAME, STDDEV(ccso.TOTAL_UNITS) AS total_units_stddev FROM SIS_SUBJECT_CODE ssc JOIN SIS_COURSE_DESCRIPTION scd ON ssc.SUBJECT_CODE = scd.COURSE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON scd.COURSE = ccso.SUBJECT_CODE WHERE ccso.ACADEMIC_YEAR = 2022 AND scd.IS_DEGREE_GRANTING = 'Y' AND scd.DEPARTMENT_NAME <> 'Chemistry' GROUP BY scd.DEPARTMENT_NAME HAVING COUNT(*) > 5 ORDER BY total_units_stddev DESC ) SELECT mds.DEPARTMENT_NAME, mds.stddev_total_units AS math_stddev_total_units, dsd.total_units_stddev AS dept_stddev_2022 FROM MathDeptStddev mds LEFT JOIN DeptStddev2022 dsd ON mds.DEPARTMENT_NAME = dsd.DEPARTMENT_NAME;\", \"default_granularity\": \"one row per department\"}, {\"id\": \"dw_359\", \"name\": \"Yearly Math Lecture Units Above One Stddev with Undergraduate Majority\", \"category\": \"Subject Offering Analysis\", \"desc\": \"For each academic year, what is the total number of lecture units for all subjects offered in regular terms by the Mathematics department (Course 18), where at least 60% of those subjects are undergraduate-level (HGN_DESC = 'Undergraduate'), considering only those academic years where the total lecture units are more than one standard deviation (using STDDEV only and never STDDEV_POP) above the mean total lecture units across all academic years? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT at_all.ACADEMIC_YEAR, ccso.SUBJECT_ID, ccso.HGN_DESC, ccso.LECTURE_UNITS FROM ACADEMIC_TERMS_ALL at_all JOIN ACADEMIC_TERMS at ON at_all.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE at.IS_REGULAR_TERM = 'Y' AND ccso.DEPARTMENT_NAME = 'Mathematics' ), YearlyTotals AS ( SELECT ACADEMIC_YEAR, SUM(LECTURE_UNITS) AS total_lecture_units FROM inner_cte GROUP BY ACADEMIC_YEAR ), YearlyUndergradCounts AS ( SELECT ACADEMIC_YEAR, COUNT(CASE WHEN HGN_DESC = 'Undergraduate' THEN 1 END) AS undergrad_count, COUNT(*) AS total_count FROM inner_cte GROUP BY ACADEMIC_YEAR ), FilteredYears AS ( SELECT yt.ACADEMIC_YEAR, yt.total_lecture_units, yuc.undergrad_count, yuc.total_count FROM YearlyTotals yt JOIN YearlyUndergradCounts yuc ON yt.ACADEMIC_YEAR = yuc.ACADEMIC_YEAR WHERE CASE WHEN yuc.total_count > 0 THEN (1.0 * yuc.undergrad_count / yuc.total_count) ELSE 0 END >= 0.6 ) SELECT fy.ACADEMIC_YEAR, fy.total_lecture_units FROM FilteredYears fy WHERE fy.total_lecture_units > ( SELECT AVG(total_lecture_units) + STDDEV(total_lecture_units) FROM YearlyTotals ) ;\", \"default_granularity\": \"one row per academic year\"}, {\"id\": \"dw_4640\", \"name\": \"2017JA Subject Enrollment Windows with Department Enrollment Coefficient of Variation and School Code\", \"desc\": \"For each subject offered in the term '2017JA', what is the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code, the coefficient of variation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in the subjects offered by that department (considering only subjects with at least one enrolled student), and the department's school code? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH DeptVariation AS ( SELECT sd.DEPARTMENT_NAME, STDDEV(tso.NUM_ENROLLED_STUDENTS) / NULLIF(AVG(tso.NUM_ENROLLED_STUDENTS), 0) AS coefficient_of_variation FROM TIP_SUBJECT_OFFERED tso JOIN STUDENT_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE WHERE tso.NUM_ENROLLED_STUDENTS > 0 GROUP BY sd.DEPARTMENT_NAME HAVING AVG(tso.NUM_ENROLLED_STUDENTS) > 0 ORDER BY coefficient_of_variation DESC ), Subjects2017JA AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, t1.DEPARTMENT_NAME, t1.DEPARTMENT_CODE, MIN(t0.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t1.DEPARTMENT_CODE ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ) SELECT s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, s.RESPONSIBLE_FACULTY_NAME, s.OFFER_DEPT_NAME, s.DEPARTMENT_FULL_NAME, s.SCHOOL_NAME, s.window_column, dv.coefficient_of_variation, sd.SCHOOL_CODE FROM Subjects2017JA s LEFT JOIN DeptVariation dv ON s.DEPARTMENT_NAME = dv.DEPARTMENT_NAME JOIN STUDENT_DEPARTMENT sd ON s.DEPARTMENT_CODE = sd.DEPARTMENT_CODE ) SELECT * FROM inner_cte;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA TIP subject offering enriched with department-level enrollment coefficient of variation and school code\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per academic year per department per graduate level\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\", \"entity_type_note\": \"\", \"id\": \"dw_1393\", \"name\": \"Math Current-Term Unit Dispersion with Degree-Granting Department Course Counts\", \"sql\": \"WITH inner_cte1 AS ( SELECT ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, SUBJECT_SUMMARY.TOTAL_UNITS, SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER FROM COURSE_CATALOG_SUBJECT_OFFERED JOIN ACADEMIC_TERMS_ALL ON COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE = ACADEMIC_TERMS_ALL.TERM_CODE JOIN SUBJECT_SUMMARY ON ACADEMIC_TERMS_ALL.TERM_CODE = SUBJECT_SUMMARY.TERM_CODE WHERE ACADEMIC_TERMS_ALL.IS_CURRENT_TERM = 'Y' AND SUBJECT_SUMMARY.TOTAL_UNITS > 0 AND COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME = 'Mathematics' ), avg_enrollment AS ( SELECT ACADEMIC_YEAR, DEPARTMENT_NAME, AVG(SUBJECT_ENROLLMENT_NUMBER) AS avg_enrollment FROM inner_cte1 GROUP BY ACADEMIC_YEAR, DEPARTMENT_NAME ), math_units_stats AS ( SELECT i.ACADEMIC_YEAR, i.DEPARTMENT_NAME, VARIANCE(i.TOTAL_UNITS) AS total_units_variance, STDDEV(i.TOTAL_UNITS) AS total_units_stddev FROM inner_cte1 i JOIN avg_enrollment a ON i.ACADEMIC_YEAR = a.ACADEMIC_YEAR AND i.DEPARTMENT_NAME = a.DEPARTMENT_NAME WHERE i.SUBJECT_ENROLLMENT_NUMBER > a.avg_enrollment GROUP BY i.ACADEMIC_YEAR, i.DEPARTMENT_NAME ), inner_cte2 AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, ad.SIS_ADMIN_DEPARTMENT_NAME, COUNT(DISTINCT c.COURSE) AS num_distinct_courses FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT ad ON d.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND UPPER(ad.SIS_ADMIN_DEPARTMENT_NAME) <> 'MANAGEMENT' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, ad.SIS_ADMIN_DEPARTMENT_NAME ), dept_courses AS ( SELECT ic.DEPARTMENT_CODE, ic.DEPARTMENT_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, scd.GRADUATE_LEVEL, ic.num_distinct_courses FROM inner_cte2 ic JOIN SIS_COURSE_DESCRIPTION scd ON ic.DEPARTMENT_CODE = scd.DEPARTMENT GROUP BY ic.DEPARTMENT_CODE, ic.DEPARTMENT_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, scd.GRADUATE_LEVEL, ic.num_distinct_courses ) SELECT mus.ACADEMIC_YEAR, mus.DEPARTMENT_NAME, mus.total_units_variance, mus.total_units_stddev, dc.DEPARTMENT_CODE, dc.SIS_ADMIN_DEPARTMENT_NAME, dc.GRADUATE_LEVEL, dc.num_distinct_courses FROM math_units_stats mus JOIN SIS_DEPARTMENT sd ON mus.DEPARTMENT_NAME = sd.DEPARTMENT_NAME JOIN dept_courses dc ON sd.DEPARTMENT_CODE = dc.DEPARTMENT_CODE ORDER BY mus.total_units_variance DESC, dc.DEPARTMENT_CODE, dc.GRADUATE_LEVEL;\"}], \"not_found\": []}"
    },
    {
