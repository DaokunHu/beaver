      "content": "{\"ok\": true, \"entities\": [{\"id\": \"concept_room_space_inventory\", \"name\": \"Room and Space Inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\", \"tables\": [\"SPACE_DETAIL\", \"FCLT_ROOMS\", \"FAC_ROOMS\", \"ZPM_ROOMS_LOAD\"], \"comparisons\": [{\"dimension\": \"Business perspective\", \"differences\": \"SPACE_DETAIL records rooms from the space-assignment perspective (which space unit each room is allocated to, with SPACE_USAGE_KEY usage code); FCLT_ROOMS and FAC_ROOMS record rooms from the facilities inventory perspective (major/minor use descriptions, primary and minor organization occupancy); ZPM_ROOMS_LOAD records rooms from the space-planning load perspective (space usage text, floor, access level, occupying HR org unit).\"}, {\"dimension\": \"Key family and join paths\", \"differences\": \"SPACE_DETAIL joins SPACE_UNIT/SPACE_FLOOR/SPACE_USAGE and FCLT_BUILDING via BUILDING_KEY; FCLT_ROOMS joins FCLT_BUILDING via FCLT_BUILDING_KEY and FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, and is referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE; FAC_ROOMS joins the FAC_* family (FAC_BUILDING, FAC_FLOOR, FAC_ORGANIZATION); ZPM_ROOMS_LOAD joins SPACE_UNIT via SPACE_UNIT_CODE and FCLT_ORGANIZATION/HR_ORG_UNIT via HR_ORG_UNIT_ID (no building/floor keys).\"}, {\"dimension\": \"Area measure and units\", \"differences\": \"SPACE_DETAIL.ROOM_SQUARE_FOOTAGE is in square feet; FCLT_ROOMS.AREA and FAC_ROOMS.AREA are in square meters; ZPM_ROOMS_LOAD carries no area measure at all. Unit choice matters for size thresholds and averages.\"}, {\"dimension\": \"Room counting semantics\", \"differences\": \"SPACE_DETAIL supports counting rooms per space unit or per building via BUILDING_ROOM rows (and ROOM_COUNTER=1 per row); FCLT_BUILDING also carries a precomputed NUM_OF_ROOMS attribute per building, while FCLT_ROOMS/FAC_ROOMS/ZPM_ROOMS_LOAD require COUNT over room rows.\"}, {\"dimension\": \"Usage classification detail\", \"differences\": \"SPACE_DETAIL uses a coded SPACE_USAGE_KEY decoded by SPACE_USAGE; FCLT_ROOMS/FAC_ROOMS carry denormalized MAJOR_USE_DESC/USE_DESC/MINOR_USE_DESC text classifications plus ACCESS_LEVEL and coordinates; ZPM_ROOMS_LOAD carries a free-text SPACE_USAGE (e.g. 'DSGN STUDIO', 'CONF RM') plus ACCESS_LEVEL and a text FLOOR that can hold labels such as 'G9'.\"}], \"decision_guide\": {\"Counting rooms per space unit or finding the building with the most rooms in a space unit\": \"Use SPACE_DETAIL: it is the only table keyed by SPACE_UNIT_KEY, so room counts can be grouped by space unit and by BUILDING_KEY directly.\", \"Room area statistics in square meters, use-classification filters (e.g. classrooms), or linking class meeting places to rooms\": \"Use FCLT_ROOMS: it carries AREA in square meters, denormalized use descriptions, and FCLT_ROOM_KEY referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE.\", \"Room analysis that must stay inside the FAC_* key family (FAC_BUILDING/FAC_FLOOR/FAC_ORGANIZATION)\": \"Use FAC_ROOMS: it mirrors FCLT_ROOMS structure but joins FAC_* family tables via FAC_ROOM_KEY/BUILDING_KEY/ORGANIZATION_KEY.\", \"Room occupancy by organization hierarchy (level, parent organization)\": \"Use FCLT_ROOMS joined to FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, SPACE_DETAIL joined via SPACE_UNIT to SPACE_UNIT.FCLT_ORGANIZATION_KEY when the space-assignment view is required, or ZPM_ROOMS_LOAD joined to FCLT_ORGANIZATION via HR_ORG_UNIT_ID for the space-planning view.\", \"Room analysis by floor, space usage text, or access level linked to space units or HR org units (no area needed)\": \"Use ZPM_ROOMS_LOAD: it links rooms to SPACE_UNIT via SPACE_UNIT_CODE and to organizations/HR units via HR_ORG_UNIT_ID.\"}}, {\"id\": \"concept_facility_organization_dimension\", \"name\": \"Facility Organization Dimension\", \"desc\": \"Organization dimension tables describing the institute's hierarchical organization tree used for facilities/space attribution: FCLT_ORGANIZATION (keyed by FCLT_ORGANIZATION_KEY, with DLC_KEY/DLC_NAME) and FAC_ORGANIZATION (keyed by ORGANIZATION_KEY, with D_CODE). They answer the same questions about organization names, hierarchy levels, parent/major organizations, assignable flags, and HR cross-references, but belong to different table families and coverage.\", \"tables\": [\"FCLT_ORGANIZATION\", \"FAC_ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Key family\", \"differences\": \"FCLT_ORGANIZATION uses FCLT_ORGANIZATION_KEY/FCLT_ORG_PARENT_KEY/FCLT_MAJOR_ORG_KEY and is referenced by SPACE_UNIT and FCLT_ROOMS; FAC_ORGANIZATION uses ORGANIZATION_KEY/ORG_PARENT_KEY/MAJOR_ORG_KEY and is referenced by FAC_ROOMS.\"}, {\"dimension\": \"Coverage\", \"differences\": \"FCLT_ORGANIZATION holds more organizations (180 rows) than FAC_ORGANIZATION (169 rows); key values overlap almost entirely, so FCLT_ORGANIZATION is the broader dimension.\"}, {\"dimension\": \"DLC attribution columns\", \"differences\": \"FCLT_ORGANIZATION carries both DLC_KEY and DLC_NAME plus an HR_DEPARTMENT_NAME; FAC_ORGANIZATION carries only D_CODE (no DLC name column).\"}, {\"dimension\": \"Shared structure\", \"differences\": \"Both share ORGANIZATION_ID/ORGANIZATION/ORGANIZATION_NAME, ORGANIZATION_LEVEL (1-6, level 5 = department/DLC), ORGANIZATION_NUMBER, ORGANIZATION_SORT, ASSIGNABLE, COURSE, DESCRIPTION, and HR cross-reference columns.\"}], \"decision_guide\": {\"Organization level, name, description, or hierarchy questions linked to space units or FCLT rooms\": \"Use FCLT_ORGANIZATION: it joins SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY and has the widest organization coverage.\", \"Organization questions inside the FAC_* family (FAC_ROOMS occupancy, FAC_BUILDING analysis)\": \"Use FAC_ORGANIZATION: FAC_ROOMS.ORGANIZATION_KEY references it directly.\", \"DLC name reporting for an organization\": \"Use FCLT_ORGANIZATION: it is the only one carrying DLC_NAME alongside DLC_KEY.\"}}, {\"columns\": [\"FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY\", \"SPACE_UNIT.FCLT_ORGANIZATION_KEY\", \"FCLT_ROOMS.FCLT_ORGANIZATION_KEY\", \"FCLT_ROOMS.FCLT_MINOR_ORGANIZATION_KEY\", \"FAC_ORGANIZATION.ORGANIZATION_KEY\", \"FAC_ROOMS.ORGANIZATION_KEY\"], \"comparisons\": [{\"dimension\": \"Key family\", \"differences\": \"FCLT_ORGANIZATION_KEY (FCLT_* family) and ORGANIZATION_KEY (FAC_* family) share the same value domain but must be joined within their own family: SPACE_UNIT/FCLT_ROOMS use FCLT_ORGANIZATION_KEY, FAC_ROOMS uses ORGANIZATION_KEY.\"}, {\"dimension\": \"Primary vs secondary occupancy\", \"differences\": \"FCLT_ROOMS.FCLT_ORGANIZATION_KEY is the primary occupying organization; FCLT_ROOMS.FCLT_MINOR_ORGANIZATION_KEY is the secondary organization, both referencing FCLT_ORGANIZATION.\"}, {\"dimension\": \"Dimension vs foreign key\", \"differences\": \"FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY and FAC_ORGANIZATION.ORGANIZATION_KEY are dimension identities; the others are foreign keys attributing space units or rooms to organizations.\"}], \"decision_guide\": {\"Attributing space units to organizations (e.g. filtering by organization level)\": \"Join SPACE_UNIT.FCLT_ORGANIZATION_KEY to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY.\", \"Attributing rooms to their occupying organization in the FCLT_* family\": \"Use FCLT_ROOMS.FCLT_ORGANIZATION_KEY (primary) or FCLT_MINOR_ORGANIZATION_KEY (secondary) against FCLT_ORGANIZATION.\", \"Room organization attribution inside the FAC_* family\": \"Use FAC_ROOMS.ORGANIZATION_KEY against FAC_ORGANIZATION.ORGANIZATION_KEY.\"}, \"desc\": \"Facility organization key columns attributing space units and rooms to organizations in the hierarchical organization tree. Two naming conventions exist across table families (FCLT_ORGANIZATION_KEY in FCLT_*/SPACE_* tables vs ORGANIZATION_KEY in FAC_* tables) with the same value domain.\", \"id\": \"column_concept_facility_organization_key\", \"name\": \"Facility Organization Key\"}], \"not_found\": []}"
