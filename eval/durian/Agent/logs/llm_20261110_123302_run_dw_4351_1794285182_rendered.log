      "role": "tool",
      "tool_call_id": "call_bb762879e4b14cfd80685d4d",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics library subject above yearly average enrollment\", \"desc\": \"For Mathematics department courses with at least 5 enrolled students, show the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, and the average calendar year within each calendar year group ordered by term start date, but only for academic terms where the term status is 'Previous', and only include results where the number of enrolled students is greater than the average number of enrolled students for that academic year. Do not return any rounded answers.\", \"id\": \"dw_4584\", \"name\": \"Mathematics Library Subjects Above Yearly Average Enrollment in Previous Terms\", \"sql\": \"WITH inner_cte AS ( SELECT t0.COURSE_NUMBER, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t0.TERM_CODE, ROW_NUMBER() OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t0.COURSE_NUMBER) AS window_column, t1.TERM_START_DATE FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t0.NUM_ENROLLED_STUDENTS >= 5 ), PreviousTerms AS ( SELECT t1.TERM_CODE, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t0.CALENDAR_DATE, t0.DAY_OF_WEEK, AVG(t0.CALENDAR_YEAR) OVER (PARTITION BY t0.CALENDAR_YEAR ORDER BY t1.TERM_START_DATE) AS window_column FROM TIME_DAY t0 JOIN ACADEMIC_TERMS t1 ON t0.CALENDAR_DATE = t1.TERM_START_DATE WHERE t1.TERM_STATUS = 'Previous' ), AvgEnrolled AS ( SELECT ACADEMIC_YEAR, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t0.NUM_ENROLLED_STUDENTS >= 5 GROUP BY ACADEMIC_YEAR ) SELECT i.COURSE_NUMBER, i.SUBJECT_TITLE, i.NUM_ENROLLED_STUDENTS, i.TERM_DESCRIPTION, i.ACADEMIC_YEAR, i.window_column AS math_window_column, p.TERM_START_DATE, p.CALENDAR_DATE, p.DAY_OF_WEEK, p.window_column AS previous_terms_window_column FROM inner_cte i JOIN PreviousTerms p ON i.TERM_CODE = p.TERM_CODE JOIN AvgEnrolled a ON i.ACADEMIC_YEAR = a.ACADEMIC_YEAR WHERE i.NUM_ENROLLED_STUDENTS > a.avg_enrolled ORDER BY i.COURSE_NUMBER, p.TERM_START_DATE;\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics library subject in previous terms\", \"desc\": \"Show the Mathematics department courses with at least 5 enrolled students, including the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, the average calendar year within each calendar year group ordered by term start date, and for each course, also display the responsible faculty name and the offer school name, but only for academic terms where the term status is 'Previous'. Do not return any rounded answers.\", \"id\": \"dw_4658\", \"name\": \"Mathematics Library Subjects 5+ Enrolled in Previous Terms with Faculty and Calendar Attributes\", \"sql\": \"WITH inner_cte AS ( SELECT t0.COURSE_NUMBER, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t0.TERM_CODE, ROW_NUMBER() OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t0.COURSE_NUMBER) AS window_column FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t0.NUM_ENROLLED_STUDENTS >= 5 ), PreviousTerms AS ( SELECT t1.TERM_CODE, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t0.CALENDAR_DATE, t0.DAY_OF_WEEK, AVG(t0.CALENDAR_YEAR) OVER (PARTITION BY t0.CALENDAR_YEAR ORDER BY t1.TERM_START_DATE) AS window_column FROM TIME_DAY t0 JOIN ACADEMIC_TERMS t1 ON t0.CALENDAR_DATE = t1.TERM_START_DATE WHERE t1.TERM_STATUS = 'Previous' ) SELECT ic.COURSE_NUMBER, ic.SUBJECT_TITLE, ic.NUM_ENROLLED_STUDENTS, ic.TERM_DESCRIPTION, ic.ACADEMIC_YEAR, ic.window_column AS math_window_column, pt.TERM_START_DATE, pt.CALENDAR_DATE, pt.DAY_OF_WEEK, pt.window_column AS previous_terms_window_column, lso.RESPONSIBLE_FACULTY_NAME, lso.OFFER_SCHOOL_NAME FROM inner_cte ic JOIN PreviousTerms pt ON ic.TERM_CODE = pt.TERM_CODE JOIN LIBRARY_SUBJECT_OFFERED lso ON ic.COURSE_NUMBER = lso.COURSE_NUMBER AND ic.TERM_CODE = lso.TERM_CODE ORDER BY ic.COURSE_NUMBER, pt.TERM_START_DATE;\"}, {\"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per subject\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units that are also offered in the library by the Mathematics department during regular terms, show the subject code, subject number, subject title, department name, term description, the rank of each subject within its department ordered by subject code, the number of enrolled students, offering department name, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Do not return any rounded answers.\", \"id\": \"dw_3248\", \"name\": \"2024 12-Unit Subjects Matched with Math Library Regular-Term Offerings and 3-Row Max Units\", \"sql\": \"WITH Subjects2024_12Units AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.SUBJECT_TITLE, t0.DEPARTMENT_NAME, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.EFFECTIVE_TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2024 AND t0.TOTAL_UNITS = 12 ), MathLibrarySubjects AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t2.SUBJECT_SHORT_TITLE, MAX(t2.TOTAL_UNITS) OVER (ORDER BY t0.SUBJECT_ID ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_total_units, t0.SUBJECT_ID FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t1.IS_REGULAR_TERM = 'Y' ) SELECT s.SUBJECT_CODE, s.SUBJECT_NUMBER, s.SUBJECT_TITLE, s.DEPARTMENT_NAME, s.TERM_DESCRIPTION, s.window_column, m.NUM_ENROLLED_STUDENTS, m.OFFER_DEPT_NAME, m.ACADEMIC_YEAR, m.SUBJECT_SHORT_TITLE, m.max_total_units FROM Subjects2024_12Units s JOIN MathLibrarySubjects m ON s.SUBJECT_ID = m.SUBJECT_ID ORDER BY s.DEPARTMENT_NAME, s.SUBJECT_CODE, m.NUM_ENROLLED_STUDENTS DESC\"}], \"not_found\": []}"
