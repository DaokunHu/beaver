= t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), subject_code_avg AS ( SELECT SUBJECT_CODE, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM inner_cte2 GROUP BY SUBJECT_CODE ) SELECT ic1.SUBJECT_ID, ic1.SUBJECT_TITLE, ic1.DEPARTMENT_NAME, ic1.window_column, dc.SUBJECT_COUNT, ic2.NUM_ENROLLED_STUDENTS, ic2.OFFER_DEPT_NAME, ic2.DEPARTMENT_FULL_NAME, ic2.SUBJECT_CODE, ic2.SUBJECT_CODE_DESC, CASE WHEN ic2.NUM_ENROLLED_STUDENTS > sca.avg_enrollment * 1.1 THEN 'HIGH_ENROLLMENT' WHEN ic2.NUM_ENROLLED_STUDENTS < sca.avg_enrollment * 0.9 THEN 'LOW_ENROLLMENT' ELSE 'AVERAGE' END AS enrollment_category FROM inner_cte1 ic1 JOIN DeptCounts dc ON ic1.DEPARTMENT_NAME = dc.DEPARTMENT_NAME AND ic1.DEPARTMENT_CODE = dc.DEPARTMENT_CODE JOIN SIS_DEPARTMENT sd ON ic1.DEPARTMENT_CODE = sd.DEPARTMENT_CODE JOIN inner_cte2 ic2 ON ic1.DEPARTMENT_CODE = ic2.OFFER_DEPT_CODE JOIN subject_code_avg sca ON ic2.SUBJECT_CODE = sca.SUBJECT_CODE ORDER BY ic1.SUBJECT_ID, ic2.SUBJECT_CODE;\"}}"
