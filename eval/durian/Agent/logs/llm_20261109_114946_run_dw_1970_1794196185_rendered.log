      "tool_call_id": "call_3da8f667a7a34e5ca2130816",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entity\": {\"id\": \"dw_1049\", \"name\": \"Mathematics Total Units Stddev for Regular Non-Current Terms vs 2022 Degree-Granting Departments\", \"category\": \"Subject Offering Analysis\", \"desc\": \"For the Mathematics department, what is the department name, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for its subjects in regular terms that are not the current term, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department in the 2022 academic year (considering only departments that have more than five subjects offered in 2022, are degree-granting, and are not the Chemistry department)? Show the department name, the standard deviation (using STDDEV only and never STDDEV_POP) for regular non-current terms, and the standard deviation (using STDDEV only and never STDDEV_POP) for 2022. Do not return any rounded answers.\", \"sql\": \"WITH MathDeptStddev AS ( SELECT ss.DEPARTMENT_NAME, STDDEV(ss.TOTAL_UNITS) AS stddev_total_units FROM SUBJECT_SUMMARY ss JOIN ACADEMIC_TERMS at ON ss.TERM_CODE = at.TERM_CODE WHERE ss.DEPARTMENT_NAME = 'Mathematics' AND at.IS_REGULAR_TERM = 'Y' AND at.IS_CURRENT_TERM = 'N' GROUP BY ss.DEPARTMENT_NAME ), DeptStddev2022 AS ( SELECT scd.DEPARTMENT_NAME, STDDEV(ccso.TOTAL_UNITS) AS total_units_stddev FROM SIS_SUBJECT_CODE ssc JOIN SIS_COURSE_DESCRIPTION scd ON ssc.SUBJECT_CODE = scd.COURSE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON scd.COURSE = ccso.SUBJECT_CODE WHERE ccso.ACADEMIC_YEAR = 2022 AND scd.IS_DEGREE_GRANTING = 'Y' AND scd.DEPARTMENT_NAME <> 'Chemistry' GROUP BY scd.DEPARTMENT_NAME HAVING COUNT(*) > 5 ORDER BY total_units_stddev DESC ) SELECT mds.DEPARTMENT_NAME, mds.stddev_total_units AS math_stddev_total_units, dsd.total_units_stddev AS dept_stddev_2022 FROM MathDeptStddev mds LEFT JOIN DeptStddev2022 dsd ON mds.DEPARTMENT_NAME = dsd.DEPARTMENT_NAME;\", \"default_granularity\": \"one row per department\"}}"
    },
