      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the TIP subject offered record; joins to TIP_DETAIL.TIP_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"IS_NO_COURSE_MATERIAL\": {\"desc\": \"'Y'/'N' flag whether the subject has no course material; 'N' means the subject has course materials\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '5.01'; joins to TIP_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE and STUDENT_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Chemistry', 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject; used for enrollment-based rankings and window statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in the textbook program\"}, {\"id\": \"TIP_DETAIL\", \"name\": \"TIP_DETAIL\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Foreign key to TIP_SUBJECT_OFFERED.TIP_SUBJECT_OFFERED_KEY\"}, \"TIP_MATERIAL_KEY\": {\"desc\": \"Foreign key to TIP_MATERIAL.TIP_MATERIAL_KEY identifying the specific textbook material\"}, \"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB'/blank keys with no description. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_SUBJECT_OFFERED.SUBJECT_ID, LIBRARY_SUBJECT_OFFERED.SUBJECT_ID, SUBJECT_SUMMARY.SUBJECT_ID\"}, \"ISBN\": {\"desc\": \"ISBN of the textbook material associated with the subject offering\"}, \"RECORD_COUNT\": {\"desc\": \"Number of material records for this subject/material combination; used in material-count statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject-material-status combination per term\", \"entity\": {\"columns\": {\"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB' = None variants. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}}}, \"reason\": \"Data verification of TIP_MATERIAL_STATUS shows 12 status values beyond the previously documented 'RQ'/'EO'; enriching the description supports material-status grouping questions such as case dw_2989 (per material status and publisher statistics).\"}, {\"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"columns\": {\"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject summary record\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, COURSE_CATALOG_SUBJECT_OFFERED subject IDs\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SUBJECT_OR_CLUSTER\": {\"desc\": \"Indicator whether the row represents a subject or a cluster\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"ULT_MASTER_SUBJECT_ID\": {\"desc\": \"Ultimate master subject identifier in cluster hierarchies\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics'\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name, e.g. 'Engineering'\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREP_UNITS\": {\"desc\": \"Preparation credit units (named PREP_UNITS here vs PREPARATION_UNITS in other tables)\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the subject\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the cluster\"}, \"SUBJECT_GROUP_ID\": {\"desc\": \"Subject group identifier used for grouping related subjects\"}, \"SUBJECT_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Subject enrollment in the first week\"}, \"CLUSTER_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Cluster enrollment in the first week\"}, \"SUBJECT_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Subject enrollment in the fifth week\"}, \"CLUSTER_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Cluster enrollment in the fifth week\"}, \"SUBJECT_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the subject for credit\"}, \"SUBJECT_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the subject\"}, \"CLUSTER_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the cluster for credit\"}, \"CLUSTER_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the cluster\"}, \"SUBJECT_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the cluster\"}, \"SUBJECT_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS_ALL.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2025FA' (FA=Fall, SP=Spring, JA=January/IAP, SU=Summer)\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description, e.g. 'Fall Term 2024-2025'\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date; can match TIME_DAY.CALENDAR_DATE for calendar-based joins\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to, e.g. 2025\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"IS_REGULAR_TERM\": {\"desc\": \"'Y'/'N' flag indicating a regular term (Fall/Spring) versus non-regular terms (Summer, January/IAP); only present in ACADEMIC_TERMS, not in ACADEMIC_TERMS_ALL\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"TERM_STATUS\": {\"desc\": \"Term status text: 'Previous', 'Current', 'Future', or 'Unspecified'\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to; used in degree-year statistics\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"ADD_DATE\": {\"desc\": \"Last day to add a subject in the term; only present in ACADEMIC_TERMS\"}, \"DROP_DATE\": {\"desc\": \"Last day to drop a subject in the term; only present in ACADEMIC_TERMS\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period for the term\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period for the term\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term\"}, {\"id\": \"ACADEMIC_TERMS_ALL\", \"name\": \"ACADEMIC_TERMS_ALL\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2019FA'\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to; used to partition running sums by financial aid year\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term (all terms)\"}, {\"id\": \"TIP_MATERIAL_STATUS\", \"name\": \"TIP_MATERIAL_STATUS\", \"desc\": \"TIP material status lookup table decoding material status keys/codes used in TIP_DETAIL. Holds 12 status rows where key and code are identical: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and four keys ('NL', 'NS', 'NB', and a blank/space key) that share a NULL description.\", \"columns\": {\"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Surrogate key of the material status; joins to TIP_DETAIL.TIP_MATERIAL_STATUS_KEY\"}, \"TIP_MATERIAL_STATUS_CODE\": {\"desc\": \"Material status code, identical in value to TIP_MATERIAL_STATUS_KEY: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, plus NULL-description keys 'NL', 'NS', 'NB' and a blank key.\"}, \"TIP_MATERIAL_STATUS\": {\"desc\": \"Material status description text. NULL for four of the twelve keys ('NL', 'NS', 'NB', blank), so grouping by this column merges those keys into one NULL group and yields fewer distinct statuses than grouping by key.\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per material status\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_0698d83e647843a28dd6411b",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering Analysis\", \"default_granularity\": \"one row per subject\", \"desc\": \"For each subject that is both offered in the academic term with term code '2006FA' and is in the \\\"Engineering\\\" school with total units equal to 1, show the subject ID, subject title, department name, the sum of lecture units within each grade type group ordered by subject ID, the name of the responsible faculty member for each subject, the academic year, the rank of each subject within its academic year group ordered by subject ID, the term description, and the term start date, in that order. Do not return any rounded answers.\", \"id\": \"dw_3944\", \"name\": \"2006FA Subjects and Engineering 1-Unit Subjects Lecture Unit Sums by Grade Type\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, SUM(t1.LECTURE_UNITS) OVER (PARTITION BY t1.GRADE_TYPE ORDER BY t1.SUBJECT_ID) AS window_column, t1.RESPONSIBLE_FACULTY_NAME FROM ACADEMIC_TERMS t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.EFFECTIVE_TERM_CODE WHERE t0.TERM_CODE = '2006FA' ) SELECT inner_cte.SUBJECT_ID, inner_cte.SUBJECT_TITLE, inner_cte.DEPARTMENT_NAME, inner_cte.window_column, inner_cte.RESPONSIBLE_FACULTY_NAME FROM inner_cte ORDER BY inner_cte.SUBJECT_ID ), subq2 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t2.ACADEMIC_YEAR, RANK() OVER (PARTITION BY t2.ACADEMIC_YEAR ORDER BY t1.SUBJECT_ID) AS window_column, t1.TERM_CODE FROM SUBJECT_SUMMARY t1 INNER JOIN ACADEMIC_TERMS_ALL t0 ON t0.TERM_CODE = t1.TERM_CODE INNER JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.SCHOOL_NAME = 'Engineering' AND t1.TOTAL_UNITS = 1 ) SELECT inner_cte.SUBJECT_ID, inner_cte.SUBJECT_TITLE, inner_cte.DEPARTMENT_NAME, inner_cte.ACADEMIC_YEAR, inner_cte.window_column, t3.TERM_DESCRIPTION, t3.TERM_START_DATE FROM inner_cte INNER JOIN ACADEMIC_TERMS_ALL t3 ON inner_cte.TERM_CODE = t3.TERM_CODE ORDER BY inner_cte.ACADEMIC_YEAR, inner_cte.SUBJECT_ID ) SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.DEPARTMENT_NAME, s1.window_column AS sum_lecture_units_by_grade_type, s1.RESPONSIBLE_FACULTY_NAME, s2.ACADEMIC_YEAR, s2.window_column AS subject_rank_within_academic_year, s2.TERM_DESCRIPTION, s2.TERM_START_DATE FROM subq1 s1 JOIN subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID AND s1.SUBJECT_TITLE = s2.SUBJECT_TITLE AND s1.DEPARTMENT_NAME = s2.DEPARTMENT_NAME ORDER BY s2.ACADEMIC_YEAR, s1.SUBJECT_ID;\"}, {\"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per IAP activity matched with Engineering subject by fiscal/academic year\", \"desc\": \"For IAP subject activities in the term \\\"2021JA\\\" that are not cancelled, show the activity title, enrollment type, calendar date, the fiscal year of the calendar date, and the row number within a window of 2 preceding and 1 following rows ordered by activity title, along with the department name, subject ID, subject title, academic year, the rank of each subject within its academic year group ordered by subject ID, and the total number of subjects per department for subjects in the \\\"Engineering\\\" school with total units equal to 1, where the fiscal year of the IAP activity matches the academic year of the subject. Present the columns in the following order: activity title, enrollment type, calendar date, fiscal year, IAP window number, department name, subject ID, subject title, academic year, subject rank, and total number of subjects per department. Do not return any rounded answers.\", \"id\": \"dw_4487\", \"name\": \"2021JA IAP Activities Fiscal Year Matched with Engineering 1-Unit Subject Ranks\", \"sql\": \"WITH iap_activities AS ( SELECT inner_cte.ACTIVITY_TITLE, inner_cte.ENROLLMENT_TYPE, inner_cte.CALENDAR_DATE, t1.FISCAL_YEAR, inner_cte.window_column FROM ( SELECT t0.ACTIVITY_TITLE, t0.ENROLLMENT_TYPE, t1.CALENDAR_DATE, ROW_NUMBER() OVER (ORDER BY t0.ACTIVITY_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column FROM IAP_SUBJECT_DETAIL t0 JOIN TIME_DAY t1 ON t0.TERM_CODE = t1.ACADEMIC_TERM_CODE WHERE t0.TERM_CODE = '2021JA' AND t0.IS_CANCELLED = 'N' ) inner_cte JOIN TIME_DAY t1 ON inner_cte.CALENDAR_DATE = t1.CALENDAR_DATE ), eng_subjects AS ( SELECT inner_cte.DEPARTMENT_NAME, inner_cte.SUBJECT_ID, inner_cte.SUBJECT_TITLE, inner_cte.ACADEMIC_YEAR, inner_cte.window_column, dept_counts.Total_Subjects FROM ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t2.ACADEMIC_YEAR, RANK() OVER (PARTITION BY t2.ACADEMIC_YEAR ORDER BY t1.SUBJECT_ID) AS window_column FROM SUBJECT_SUMMARY t1 INNER JOIN ACADEMIC_TERMS_ALL t0 ON t0.TERM_CODE = t1.TERM_CODE INNER JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.SCHOOL_NAME = 'Engineering' AND t1.TOTAL_UNITS = 1 ) inner_cte JOIN ( SELECT DEPARTMENT_NAME, COUNT(DISTINCT SUBJECT_ID) AS Total_Subjects FROM SUBJECT_SUMMARY WHERE SCHOOL_NAME = 'Engineering' AND TOTAL_UNITS = 1 GROUP BY DEPARTMENT_NAME ) AS dept_counts ON inner_cte.DEPARTMENT_NAME = dept_counts.DEPARTMENT_NAME ) SELECT iap_activities.ACTIVITY_TITLE, iap_activities.ENROLLMENT_TYPE, iap_activities.CALENDAR_DATE, iap_activities.FISCAL_YEAR, iap_activities.window_column AS IAP_WINDOW_NUMBER, eng_subjects.DEPARTMENT_NAME, eng_subjects.SUBJECT_ID, eng_subjects.SUBJECT_TITLE, eng_subjects.ACADEMIC_YEAR, eng_subjects.window_column AS SUBJECT_RANK, eng_subjects.Total_Subjects FROM iap_activities JOIN eng_subjects ON iap_activities.FISCAL_YEAR = eng_subjects.ACADEMIC_YEAR ORDER BY iap_activities.ACTIVITY_TITLE, eng_subjects.DEPARTMENT_NAME, eng_subjects.SUBJECT_ID\"}, {\"id\": \"dw_4527\", \"name\": \"2021 Engineering Degree-Granting Department Enrollment Dispersion with Above-Average Subject Details\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only subjects with a non-null subject code description), and, for each subject in 2021 offered by these departments in the School of Engineering, list the subject id, subject title, and the number of enrolled students, but only include subjects where the number of enrolled students exceeds the average enrollment for that department in 2021. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH eng_dept_2021_summary AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), dept_enrollment_stats AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, VARIANCE(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_variance, STDDEV(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_stddev FROM TIP_SUBJECT_OFFERED t JOIN SIS_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.SUBJECT_CODE_DESC IS NOT NULL GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME ) SELECT e.DEPARTMENT_CODE, e.DEPARTMENT_NAME, e.DEPARTMENT_FULL_NAME, e.subject_count, e.total_enrollment, d.enrolled_students_variance, d.enrolled_students_stddev FROM eng_dept_2021_summary e JOIN dept_enrollment_stats d ON e.DEPARTMENT_CODE = d.DEPARTMENT_CODE ), dept_avg_enrollment AS ( SELECT s.OFFER_DEPT_CODE, AVG(s.NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM SUBJECT_OFFERED_SUMMARY s JOIN SIS_DEPARTMENT d ON s.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY s.OFFER_DEPT_CODE ) SELECT i.DEPARTMENT_CODE, i.DEPARTMENT_NAME, i.DEPARTMENT_FULL_NAME, i.subject_count, i.total_enrollment, i.enrolled_students_variance, i.enrolled_students_stddev, s.SUBJECT_ID, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS FROM inner_cte i JOIN SUBJECT_OFFERED_SUMMARY s ON i.DEPARTMENT_CODE = s.OFFER_DEPT_CODE JOIN dept_avg_enrollment a ON s.OFFER_DEPT_CODE = a.OFFER_DEPT_CODE WHERE s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' AND s.NUM_ENROLLED_STUDENTS > a.avg_enrollment ORDER BY i.DEPARTMENT_CODE, s.NUM_ENROLLED_STUDENTS DESC;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2021 Engineering subject with above-department-average enrollment within its degree-granting department summary\"}, {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject matched between TIP material and master section scopes\", \"desc\": \"For each subject offered in the same term as a TIP detail record with material status 'RQ', show the subject key, subject title, offer department name, TIP material key, and the rank of each record within each offer department name group ordered by subject key, along with the subject title, subject ID, offer department name, offer school name, term description, academic year, and the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject key, where the subject, term, and offer department name match in both cases. List the columns in the following order: subject key, subject title, offer department name, TIP material key, rank, subject title (from the second subquery), subject ID, offer department name (from the second subquery), offer school name, term description, academic year, and the maximum number of enrolled students. Do not return any rounded answers.\", \"id\": \"dw_3398\", \"name\": \"Required-Textbook Subjects Ranked per Department Matched with Master Section 3-Row Max Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_KEY, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TIP_MATERIAL_KEY, RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.SUBJECT_KEY) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM SUBJECT_OFFERED t0 JOIN TIP_DETAIL t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TIP_MATERIAL_STATUS_KEY = 'RQ' ), Subq2 AS ( SELECT t1.SUBJECT_TITLE, t1.SUBJECT_ID, t1.OFFER_DEPT_NAME, t1.OFFER_SCHOOL_NAME, t0.TERM_DESCRIPTION, t0.ACADEMIC_YEAR, MAX(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.SUBJECT_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_enrolled_students, t1.TERM_CODE FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.IS_MASTER_SECTION = 'Y' AND t0.TERM_STATUS_INDICATOR = 'P' ) SELECT s1.SUBJECT_KEY, s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME, s1.TIP_MATERIAL_KEY, s1.window_column, s2.SUBJECT_TITLE AS s2_SUBJECT_TITLE, s2.SUBJECT_ID, s2.OFFER_DEPT_NAME AS s2_OFFER_DEPT_NAME, s2.OFFER_SCHOOL_NAME, s2.TERM_DESCRIPTION, s2.ACADEMIC_YEAR, s2.max_enrolled_students FROM Subq1 s1 JOIN Subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID AND s1.TERM_CODE = s2.TERM_CODE AND s1.OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME ORDER BY s1.OFFER_DEPT_NAME, s1.SUBJECT_KEY;\"}], \"not_found\": []}"
    },
