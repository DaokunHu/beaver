      "role": "tool",
      "tool_call_id": "call_acda52af5a1c4994adbf2c17",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entity\": {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics department combining subject unit statistics with graduate student counts\", \"desc\": \"For the Mathematics department (Course 18), provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student), the number of graduate students in the department, and the most recent warehouse load date for those students, considering only departments that are degree granting and students whose year is 'G'. Do not return any rounded answers.\", \"id\": \"dw_1212\", \"name\": \"Math Department Subject Unit Average-Stddev with Graduate Student Count and Latest Load Date\", \"sql\": \"WITH DeptUnits AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_total_units, STDDEV(s.TOTAL_UNITS) AS stddev_total_units FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.TOTAL_UNITS > 0 AND s.NUM_ENROLLED_STUDENTS >= 1 AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME ORDER BY stddev_total_units DESC ), DeptStudents AS ( SELECT sd.DEPARTMENT_NAME, COUNT(msd.FULL_NAME) AS student_count, MAX(msd.WAREHOUSE_LOAD_DATE) AS latest_student_load FROM SIS_DEPARTMENT sd JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT JOIN SIS_ADMIN_DEPARTMENT sad ON msd.DEPARTMENT = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND msd.STUDENT_YEAR = 'G' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_NAME ORDER BY student_count DESC LIMIT 10 ) SELECT du.DEPARTMENT_NAME, du.avg_total_units, du.stddev_total_units, ds.student_count, ds.latest_student_load FROM DeptUnits du JOIN DeptStudents ds ON du.DEPARTMENT_NAME = ds.DEPARTMENT_NAME;\"}}"
