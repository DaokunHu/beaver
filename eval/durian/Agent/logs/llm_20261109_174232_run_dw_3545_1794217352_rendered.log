    {
      "role": "tool",
      "tool_call_id": "call_4c6f474e321346dba403d0e4",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per library subject\", \"desc\": \"For subjects with at least 5 enrolled students that are offered by the library in the term with code '2014FA', show the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, row number within each material status group ordered by subject ID, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, ordered by offering department name, material status key, and subject ID. Do not return any rounded answers.\", \"id\": \"dw_3393\", \"name\": \"2014FA Library Subjects with 5+ Enrolled Students by Material Status and Department Min Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.TERM_CODE, t1.TIP_MATERIAL_STATUS_KEY, t1.ISBN, ROW_NUMBER() OVER (PARTITION BY t1.TIP_MATERIAL_STATUS_KEY ORDER BY t0.SUBJECT_ID) AS window_column FROM LIBRARY_SUBJECT_OFFERED t0 JOIN TIP_DETAIL t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.NUM_ENROLLED_STUDENTS >= 5 ), Subq2 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t1.TERM_END_DATE, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_per_dept FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2014FA' ) SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.TERM_CODE, s1.TIP_MATERIAL_STATUS_KEY, s1.ISBN, s1.window_column, s2.OFFER_DEPT_NAME, s2.TERM_DESCRIPTION, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.min_enrolled_per_dept FROM Subq1 s1 JOIN Subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID ORDER BY s2.OFFER_DEPT_NAME, s1.TIP_MATERIAL_STATUS_KEY, s1.SUBJECT_ID\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per library subject plus department rollup rows\", \"desc\": \"For each subject offered by the library in the term with code '2014FA', show the subject ID, subject title, total number of enrolled students, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, as well as the maximum windowed average record count from tip detail records with material status key 'RQ' (using a window of 2 preceding and 2 following rows grouped by financial aid year). Additionally, for each offering department, include a grand total row showing the total number of enrolled students across all its subjects (with nulls for subject ID and subject title), and the corresponding maximum windowed average record count if available. Order the results by offering department name and subject ID. Do not return any rounded answers.\", \"id\": \"dw_3911\", \"name\": \"2014FA Library Subjects Enrollment Rollup by Department with Required Textbook Windowed Record Counts\", \"sql\": \"WITH Subq1 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t0.TERM_DESCRIPTION, t0.TERM_START_DATE, t1.TIP_MATERIAL_KEY, AVG(t1.RECORD_COUNT) OVER ( PARTITION BY t0.FINANCIAL_AID_YEAR ORDER BY t1.SUBJECT_ID ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN TIP_DETAIL t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TIP_MATERIAL_STATUS_KEY = 'RQ' ) SELECT SUBJECT_ID, MAX(window_column) AS max_windowed_avg_record_count FROM inner_cte GROUP BY SUBJECT_ID ), Subq2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t1.TERM_END_DATE, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_per_dept FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2014FA' ) SELECT CASE WHEN GROUPING(SUBJECT_ID) = 1 THEN NULL ELSE SUBJECT_ID END AS SUBJECT_ID, CASE WHEN GROUPING(SUBJECT_TITLE) = 1 THEN NULL ELSE SUBJECT_TITLE END AS SUBJECT_TITLE, SUM(NUM_ENROLLED_STUDENTS) AS total_enrolled_students, OFFER_DEPT_NAME, MAX(TERM_DESCRIPTION) AS TERM_DESCRIPTION, MAX(TERM_START_DATE) AS TERM_START_DATE, MAX(TERM_END_DATE) AS TERM_END_DATE, MIN(min_enrolled_per_dept) AS min_enrolled_per_dept FROM inner_cte GROUP BY OFFER_DEPT_NAME, SUBJECT_ID, SUBJECT_TITLE WITH ROLLUP HAVING OFFER_DEPT_NAME IS NOT NULL ORDER BY OFFER_DEPT_NAME, SUBJECT_ID ) SELECT s2.SUBJECT_ID, s2.SUBJECT_TITLE, s2.total_enrolled_students, s2.OFFER_DEPT_NAME, s2.TERM_DESCRIPTION, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.min_enrolled_per_dept, s1.max_windowed_avg_record_count FROM Subq2 s2 LEFT JOIN Subq1 s1 ON s2.SUBJECT_ID = s1.SUBJECT_ID ORDER BY s2.OFFER_DEPT_NAME, s2.SUBJECT_ID\"}, {\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics library subject in regular terms\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\", \"id\": \"dw_4724\", \"name\": \"Mathematics Library Regular-Term Subjects 3-Row Max Units with Required Material Department Statistics\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t2.SUBJECT_SHORT_TITLE, MAX(t2.TOTAL_UNITS) OVER (ORDER BY t0.SUBJECT_ID ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS MAX_TOTAL_UNITS, t0.SUBJECT_ID, t0.OFFER_DEPT_NAME AS SUB1_OFFER_DEPT_NAME, t0.OFFER_SCHOOL_NAME AS SUB1_OFFER_SCHOOL_NAME, t0.RESPONSIBLE_FACULTY_NAME FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t1.IS_REGULAR_TERM = 'Y' ), Sub2 AS ( SELECT tso.OFFER_DEPT_NAME, tso.OFFER_SCHOOL_NAME, COUNT(DISTINCT tso.SUBJECT_ID) AS subject_count, MIN(sos.TOTAL_UNITS) AS min_total_units FROM TIP_SUBJECT_OFFERED tso JOIN TIP_DETAIL td ON tso.SUBJECT_ID = td.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY sos ON td.SUBJECT_ID = sos.SUBJECT_ID WHERE td.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY tso.OFFER_DEPT_NAME, tso.OFFER_SCHOOL_NAME ) SELECT icte.SUBJECT_TITLE, icte.NUM_ENROLLED_STUDENTS, icte.OFFER_DEPT_NAME, icte.TERM_DESCRIPTION, icte.ACADEMIC_YEAR, icte.SUBJECT_SHORT_TITLE, icte.MAX_TOTAL_UNITS, s2.subject_count, s2.min_total_units, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.SCHOOL_NAME AS school_name, icte.RESPONSIBLE_FACULTY_NAME FROM inner_cte icte LEFT JOIN Sub2 s2 ON icte.SUB1_OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME AND icte.SUB1_OFFER_SCHOOL_NAME = s2.OFFER_SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON icte.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE\"}], \"not_found\": []}"
