      "name": "semantic_get",
      "content": "{\"ok\": true, \"entity\": {\"category\": \"IAP Activity and Academic Term Comprehensive Analysis\", \"default_granularity\": \"one row per previous term matched with IAP subject category statistics\", \"desc\": \"For each previous academic term where the term start date matches the minimum academic term start date for a subject category and academic year with more than 10 maximum enrollment, show the term code, term description, term start date, calendar date, day of week, the average calendar year within each calendar year group ordered by term start date, the subject category key, academic year, number of unique subjects, minimum academic term start date, the normalized subjects per year rounded (number of unique subjects divided by the average calendar year), and for each such term, also list the number of unique subject IDs offered in that term and the earliest preregistration deadline among those subjects.\", \"id\": \"dw_5095\", \"name\": \"Previous Terms Matching IAP Category Min Start Dates with Normalized Subjects per Year\", \"sql\": \"WITH inner_cte AS ( SELECT t1.TERM_CODE, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t0.CALENDAR_DATE, t0.DAY_OF_WEEK, AVG(t0.CALENDAR_YEAR) OVER (PARTITION BY t0.CALENDAR_YEAR ORDER BY t1.TERM_START_DATE) AS window_column FROM TIME_DAY t0 JOIN ACADEMIC_TERMS t1 ON t0.CALENDAR_DATE = t1.TERM_START_DATE WHERE t1.TERM_STATUS = 'Previous' ), SubjectCategoryStats AS ( SELECT i.IAP_SUBJECT_CATEGORY_KEY, a.ACADEMIC_YEAR, COUNT(DISTINCT i.IAP_SUBJECT_SESSION_KEY) AS subject_count, MIN(a.TERM_START_DATE) AS min_term_start_date FROM IAP_SUBJECT_DETAIL i JOIN ACADEMIC_TERMS a ON i.TERM_CODE = a.TERM_CODE JOIN TIP_DETAIL t ON a.TERM_CODE = t.TERM_CODE WHERE i.MAX_ENROLLMENT > 10 GROUP BY i.IAP_SUBJECT_CATEGORY_KEY, a.ACADEMIC_YEAR ), TermSubjectInfo AS ( SELECT t.TERM_CODE, COUNT(DISTINCT td.SUBJECT_ID) AS unique_subject_ids, MIN(i.PREREG_DEADLINE) AS earliest_prereg_deadline FROM ACADEMIC_TERMS t JOIN TIP_DETAIL td ON t.TERM_CODE = td.TERM_CODE JOIN IAP_SUBJECT_DETAIL i ON t.TERM_CODE = i.TERM_CODE GROUP BY t.TERM_CODE ) SELECT icte.TERM_CODE, icte.TERM_DESCRIPTION, icte.TERM_START_DATE, icte.CALENDAR_DATE, icte.DAY_OF_WEEK, icte.window_column, scs.IAP_SUBJECT_CATEGORY_KEY, scs.ACADEMIC_YEAR, scs.subject_count, scs.min_term_start_date, ROUND(scs.subject_count / NULLIF(icte.window_column, 0), 2) AS Normalized_Subjects_Per_Year, tsi.unique_subject_ids, tsi.earliest_prereg_deadline FROM inner_cte icte JOIN SubjectCategoryStats scs ON icte.TERM_START_DATE = scs.min_term_start_date JOIN TermSubjectInfo tsi ON icte.TERM_CODE = tsi.TERM_CODE ORDER BY Normalized_Subjects_Per_Year DESC;\"}}"
