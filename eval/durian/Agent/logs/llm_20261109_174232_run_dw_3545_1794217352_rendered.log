      "role": "tool",
      "tool_call_id": "call_d77ffe994f43411eba3b3a24",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_1965\", \"name\": \"2017JA Chemistry TIP Subjects with Course Materials Enrollment Windows and Per-Faculty Max Enrollment\", \"desc\": \"For subjects offered in the term '2017JA' by the Chemistry department (Course 5) that have course materials, show the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code, the subject code, the subject code description, the minimum number of enrolled students over each subject code group ordered by subject code, and the maximum number of enrolled students for each responsible faculty across all their Chemistry subjects in that term. Do not return any rounded answers.\", \"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"sql\": \"WITH inner_cte AS ( WITH Subquery1 AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, t0.OFFER_DEPT_CODE, MIN(t0.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t1.DEPARTMENT_CODE ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' AND t0.OFFER_DEPT_NAME = 'Chemistry' AND t0.IS_NO_COURSE_MATERIAL = 'N' ), Subquery2 AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, t1.DEPARTMENT_CODE, min(t0.NUM_ENROLLED_STUDENTS) OVER ( PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE ) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' AND t0.OFFER_DEPT_NAME = 'Chemistry' AND t0.IS_NO_COURSE_MATERIAL = 'N' ORDER BY t2.SUBJECT_CODE ) SELECT s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.RESPONSIBLE_FACULTY_NAME, s1.OFFER_DEPT_NAME, s1.DEPARTMENT_FULL_NAME, s1.SCHOOL_NAME, s1.window_column AS min_enrolled_window, s2.SUBJECT_CODE, s2.SUBJECT_CODE_DESC, s2.window_column AS min_enrolled_by_code FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.SUBJECT_TITLE = s2.SUBJECT_TITLE AND s1.NUM_ENROLLED_STUDENTS = s2.NUM_ENROLLED_STUDENTS AND s1.OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME AND s1.DEPARTMENT_FULL_NAME = s2.DEPARTMENT_FULL_NAME AND s1.OFFER_DEPT_CODE = s2.DEPARTMENT_CODE ) SELECT icte.*, mf.max_enrolled_by_faculty FROM inner_cte icte JOIN ( SELECT RESPONSIBLE_FACULTY_NAME, MAX(NUM_ENROLLED_STUDENTS) AS max_enrolled_by_faculty FROM TIP_SUBJECT_OFFERED WHERE TERM_CODE = '2017JA' AND OFFER_DEPT_NAME = 'Chemistry' AND IS_NO_COURSE_MATERIAL = 'N' GROUP BY RESPONSIBLE_FACULTY_NAME ) mf ON icte.RESPONSIBLE_FACULTY_NAME = mf.RESPONSIBLE_FACULTY_NAME ;\", \"default_granularity\": \"one row per 2017JA Chemistry TIP subject with course materials, enriched with subject-code and faculty-level enrollment aggregates\"}, {\"id\": \"dw_4208\", \"name\": \"2016SP Engineering School Subject Row Numbers Matched with 2017JA TIP Subject Enrollment Windows\", \"desc\": \"For subjects offered in the term '2016SP' with a school code of 'E', and for subjects offered in the term '2017JA', show the subject title, department name, course description, the number of enrolled students in 2016SP, the row number within a window of 2 preceding and 1 following rows ordered by subject title, the number of enrolled students in 2017JA, the offering department name, department full name, subject code, subject code description, the minimum number of enrolled students over each subject code group in 2017JA, the school name, and the department phone number. Order the results by subject title and subject code. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte1 AS ( SELECT t2.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.COURSE_DESCRIPTION, ROW_NUMBER() OVER (ORDER BY t2.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.COURSE_NUMBER = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.TERM_CODE = '2016SP' AND t0.SCHOOL_CODE = 'E' ), cte1 AS ( SELECT inner_cte.SUBJECT_TITLE, inner_cte.DEPARTMENT_NAME, inner_cte.COURSE_DESCRIPTION, t2.NUM_ENROLLED_STUDENTS, inner_cte.window_column, t2.OFFER_DEPT_CODE FROM inner_cte1 inner_cte JOIN SUBJECT_OFFERED_SUMMARY t2 ON inner_cte.SUBJECT_TITLE = t2.SUBJECT_TITLE AND t2.TERM_CODE = '2016SP' ), inner_cte2 AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), cte2 AS ( SELECT inner_cte.SUBJECT_TITLE, inner_cte.NUM_ENROLLED_STUDENTS, inner_cte.OFFER_DEPT_NAME, inner_cte.DEPARTMENT_FULL_NAME, inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.window_column, sd.SCHOOL_NAME, ad.DEPARTMENT_PHONE_NUMBER, sd.DEPARTMENT_CODE FROM inner_cte2 inner_cte LEFT JOIN SIS_DEPARTMENT sd ON inner_cte.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ) SELECT cte1.SUBJECT_TITLE, cte1.DEPARTMENT_NAME, cte1.COURSE_DESCRIPTION, cte1.NUM_ENROLLED_STUDENTS AS NUM_ENROLLED_STUDENTS_2016SP, cte1.window_column AS WINDOW_COLUMN_2016SP, cte2.NUM_ENROLLED_STUDENTS AS NUM_ENROLLED_STUDENTS_2017JA, cte2.OFFER_DEPT_NAME, cte2.DEPARTMENT_FULL_NAME, cte2.SUBJECT_CODE, cte2.SUBJECT_CODE_DESC, cte2.window_column AS MIN_ENROLLED_STUDENTS_OVER_SUBJECT_CODE_2017JA, cte2.SCHOOL_NAME, cte2.DEPARTMENT_PHONE_NUMBER FROM cte1 JOIN cte2 ON cte1.OFFER_DEPT_CODE = cte2.DEPARTMENT_CODE ORDER BY cte1.SUBJECT_TITLE, cte2.SUBJECT_CODE;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2016SP Engineering-school subject matched with a 2017JA TIP subject of the same offer department\"}, {\"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA subject per school\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, and the minimum number of enrolled students over each subject code group, as well as the school code, school name, department code, school name from department, department phone number, and the highest running sum of total units for any subject within that school in the 2019FA term (where the subject has more than 1 total unit). Order the results by subject code. Do not return any rounded answers.\", \"id\": \"dw_4308\", \"name\": \"2017JA Subjects Enrollment per Subject Code with 2019FA School Running Unit Sums\", \"sql\": \"WITH inner_cte1 AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column, t1.SCHOOL_CODE, t1.SCHOOL_NAME, t1.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), cte1 AS ( SELECT inner_cte1.SUBJECT_TITLE, inner_cte1.NUM_ENROLLED_STUDENTS, inner_cte1.OFFER_DEPT_NAME, inner_cte1.DEPARTMENT_FULL_NAME, inner_cte1.SUBJECT_CODE, inner_cte1.SUBJECT_CODE_DESC, inner_cte1.window_column, inner_cte1.SCHOOL_CODE, inner_cte1.SCHOOL_NAME, inner_cte1.DEPARTMENT_CODE, sd.SCHOOL_NAME AS SCHOOL_NAME_DEPT, ad.DEPARTMENT_PHONE_NUMBER FROM inner_cte1 LEFT JOIN SIS_DEPARTMENT sd ON inner_cte1.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), inner_cte2 AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.SCHOOL_CODE, t1.SCHOOL_NAME, SUM(t1.TOTAL_UNITS) OVER (PARTITION BY t1.SCHOOL_CODE ORDER BY t1.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_CODE = '2019FA' AND t1.TOTAL_UNITS > 1 ), cte2 AS ( SELECT SCHOOL_CODE, SCHOOL_NAME, MAX(window_column) AS highest_running_sum_total_units FROM inner_cte2 GROUP BY SCHOOL_CODE, SCHOOL_NAME ) SELECT cte1.SUBJECT_TITLE, cte1.NUM_ENROLLED_STUDENTS, cte1.OFFER_DEPT_NAME, cte1.DEPARTMENT_FULL_NAME, cte1.SUBJECT_CODE, cte1.SUBJECT_CODE_DESC, cte1.window_column, cte1.SCHOOL_CODE, cte1.SCHOOL_NAME, cte1.DEPARTMENT_CODE, cte1.SCHOOL_NAME_DEPT, cte1.DEPARTMENT_PHONE_NUMBER, cte2.highest_running_sum_total_units FROM cte1 JOIN cte2 ON cte1.SCHOOL_CODE = cte2.SCHOOL_CODE ORDER BY cte1.SUBJECT_CODE;\"}], \"not_found\": []}"
