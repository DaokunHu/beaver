            "arguments": "{\"entity_ids\": \n[\"LIBRARY_SUBJECT_OFFERED\", \"SUBJECT_OFFERED_SUMMARY\", \"SIS_DEPARTMENT\", \"ACADEMIC_TERMS\"]\n\n}"
          }
