      "tool_call_id": "call_4d78e54c4c544cea878445b4",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per department per course number\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\", \"id\": \"dw_4683\", \"name\": \"Current Term Department Enrollments with Library Course Counts and Min Units\", \"sql\": \"WITH inner_cte AS ( SELECT de.DEPARTMENT_NAME, de.total_enrollments, lss.COURSE_NUMBER, lss.subject_count, lss.min_total_units FROM ( SELECT s.DEPARTMENT_NAME, SUM(s.SUBJECT_ENROLLMENT_NUMBER) AS total_enrollments FROM ACADEMIC_TERM_PARAMETER p JOIN ACADEMIC_TERMS t ON p.TERM_CODE = t.TERM_CODE JOIN SUBJECT_SUMMARY s ON t.TERM_CODE = s.TERM_CODE WHERE p.IS_CURRENT_TERM = 'Y' GROUP BY s.DEPARTMENT_NAME HAVING SUM(s.SUBJECT_ENROLLMENT_NUMBER) > 10 ) de JOIN ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, COUNT(DISTINCT l.LIBRARY_SUBJECT_OFFERED_KEY) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 GROUP BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ) lss ON de.DEPARTMENT_NAME = lss.OFFER_DEPT_NAME ) SELECT ic.DEPARTMENT_NAME, ic.total_enrollments, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sos.RESPONSIBLE_FACULTY_NAME FROM inner_cte ic JOIN LIBRARY_SUBJECT_OFFERED lso ON ic.DEPARTMENT_NAME = lso.OFFER_DEPT_NAME AND ic.COURSE_NUMBER = lso.COURSE_NUMBER JOIN SUBJECT_OFFERED_SUMMARY sos ON lso.SUBJECT_ID = sos.SUBJECT_ID WHERE sos.NUM_ENROLLED_STUDENTS > 2 GROUP BY ic.DEPARTMENT_NAME, ic.total_enrollments, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sos.RESPONSIBLE_FACULTY_NAME;\"}, {\"id\": \"dw_4812\", \"name\": \"Top 10 Degree-Granting Department Subject Code and Course Number Combinations by Unique Library Subject Count\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH DeptSubjectStats AS ( SELECT d.DEPARTMENT_NAME, s.SUBJECT_CODE, COUNT(s.SUBJECT_CODE) AS subject_code_count, MIN(d.DEPT_BUDGET_CODE) AS min_dept_budget_code FROM SIS_DEPARTMENT d JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' GROUP BY d.DEPARTMENT_NAME, s.SUBJECT_CODE ), DeptCourseStats AS ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, COUNT(DISTINCT l.LIBRARY_SUBJECT_OFFERED_KEY) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 GROUP BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ) SELECT dss.DEPARTMENT_NAME, dss.SUBJECT_CODE, dss.subject_code_count, dss.min_dept_budget_code, dcs.COURSE_NUMBER, dcs.subject_count, dcs.min_total_units FROM DeptSubjectStats dss JOIN SIS_SUBJECT_CODE ssc ON dss.SUBJECT_CODE = ssc.SUBJECT_CODE JOIN DeptCourseStats dcs ON dss.DEPARTMENT_NAME = dcs.OFFER_DEPT_NAME AND ssc.COURSE_NUMBER = dcs.COURSE_NUMBER ), SubjectMaxEnroll AS ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, ROW_NUMBER() OVER (PARTITION BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ORDER BY s.NUM_ENROLLED_STUDENTS DESC) AS rn FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 ) SELECT ic.DEPARTMENT_NAME, ic.SUBJECT_CODE, ic.subject_code_count, ic.min_dept_budget_code, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sme.SUBJECT_TITLE AS Top_Subject_Title, sme.NUM_ENROLLED_STUDENTS AS Top_Subject_Enrollment FROM inner_cte ic LEFT JOIN SubjectMaxEnroll sme ON ic.DEPARTMENT_NAME = sme.OFFER_DEPT_NAME AND ic.COURSE_NUMBER = sme.COURSE_NUMBER AND sme.rn = 1 ORDER BY ic.subject_count DESC LIMIT 10;\", \"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per top-10 department/subject-code/course-number combination with its highest-enrollment subject\"}, {\"id\": \"dw_1301\", \"name\": \"Math Yearly Max Total Units with Fall-Term Library Enrollment Stddev and Equivalent Subjects\", \"desc\": \"For each academic year, where the maximum number of total units for any Mathematics (Course 18) subject offered in that year is greater than 9 and there are more than 5 Mathematics subjects offered in the fall term, what are the academic year, the maximum total units, the corresponding term description, the subject title, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in library subjects offered during terms in that year, and the average number of equivalent subjects for those library subjects? List the results in order of academic year. Do not return any rounded answers.\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"sql\": \"WITH inner_cte1 AS ( SELECT c.ACADEMIC_YEAR, MAX(c.TOTAL_UNITS) AS max_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c WHERE c.DEPARTMENT_NAME = 'Mathematics' GROUP BY c.ACADEMIC_YEAR HAVING max_total_units > 9 ), MaxUnitsSubjects AS ( SELECT ic.ACADEMIC_YEAR, ic.max_total_units, ata.TERM_DESCRIPTION, c.SUBJECT_TITLE FROM inner_cte1 ic JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON c.ACADEMIC_YEAR = ic.ACADEMIC_YEAR AND c.TOTAL_UNITS = ic.max_total_units AND c.DEPARTMENT_NAME = 'Mathematics' JOIN ACADEMIC_TERMS_ALL ata ON ata.TERM_CODE = c.TERM_CODE ), inner_cte2 AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, STDDEV(lso.NUM_ENROLLED_STUDENTS) AS stddev_num_enrolled_students FROM LIBRARY_SUBJECT_OFFERED lso JOIN ACADEMIC_TERMS_ALL ata ON lso.TERM_CODE = ata.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON lso.TERM_CODE = ccso.TERM_CODE AND lso.SUBJECT_ID = ccso.SUBJECT_ID WHERE ccso.DEPARTMENT_NAME = 'Mathematics' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC HAVING COUNT(*) > 5 ), LibraryStats AS ( SELECT icte.ACADEMIC_YEAR, icte.ACADEMIC_YEAR_DESC, icte.stddev_num_enrolled_students, AVG( CASE WHEN ccso.EQUIVALENT_SUBJECTS IS NULL OR ccso.EQUIVALENT_SUBJECTS = '' THEN 0 ELSE 1 + LENGTH(ccso.EQUIVALENT_SUBJECTS) - LENGTH(REPLACE(ccso.EQUIVALENT_SUBJECTS, ',', '')) END ) AS avg_num_equivalent_subjects FROM inner_cte2 icte JOIN ACADEMIC_TERMS_ALL ata ON icte.ACADEMIC_YEAR = ata.ACADEMIC_YEAR JOIN LIBRARY_SUBJECT_OFFERED lso ON ata.TERM_CODE = lso.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON lso.TERM_CODE = ccso.TERM_CODE AND lso.SUBJECT_ID = ccso.SUBJECT_ID WHERE ccso.DEPARTMENT_NAME = 'Mathematics' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY icte.ACADEMIC_YEAR, icte.ACADEMIC_YEAR_DESC, icte.stddev_num_enrolled_students ) SELECT mus.ACADEMIC_YEAR, mus.max_total_units, mus.TERM_DESCRIPTION, mus.SUBJECT_TITLE, ls.ACADEMIC_YEAR_DESC, ls.stddev_num_enrolled_students, ls.avg_num_equivalent_subjects FROM MaxUnitsSubjects mus JOIN LibraryStats ls ON mus.ACADEMIC_YEAR = ls.ACADEMIC_YEAR ORDER BY mus.ACADEMIC_YEAR;\", \"default_granularity\": \"one row per academic year per max-unit subject\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_a0de135d1d684fcc906ee38d",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 15, \"items_by_type\": {\"metric\": [{\"id\": \"dw_5095\", \"desc\": \"For each previous academic term where the term start date matches the minimum academic term start date for a subject category and academic year with more than 10 maximum enrollment, show the term code, term description, term start date, calendar date, day of week, the average calendar year within each calendar year group ordered by term start date, the subject category key, academic year, number of unique subjects, minimum academic term start date, the normalized subjects per year rounded (number of unique subjects divided by the average calendar year), and for each such term, also list the number of unique subject IDs offered in that term and the earliest preregistration deadline among those subjects.\"}, {\"id\": \"dw_4683\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\"}, {\"id\": \"dw_3911\", \"desc\": \"For each subject offered by the library in the term with code '2014FA', show the subject ID, subject title, total number of enrolled students, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, as well as the maximum windowed average record count from tip detail records with material status key 'RQ' (using a window of 2 preceding and 2 following rows grouped by financial aid year). Additionally, for each offering department, include a grand total row showing the total number of enrolled students across all its subjects (with nulls for subject ID and subject title), and the corresponding maximum windowed average record count if available. Order the results by offering department name and subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_4812\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_3393\", \"desc\": \"For subjects with at least 5 enrolled students that are offered by the library in the term with code '2014FA', show the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, row number within each material status group ordered by subject ID, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, ordered by offering department name, material status key, and subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_4130\", \"desc\": \"For subjects offered in the academic year 2012 that also have a section ID of 0 and a cluster type of 'S', show the subject key, subject title, offer department name, academic year, term description, the total number of subjects offered by each department in that year, the row number within each offer department name group ordered by subject key, the department name from SUBJECT_SUMMARY, the term start date from ACADEMIC_TERMS, and the row number within a window of 2 preceding and 1 following rows ordered by the subject title from SUBJECT_OFFERED. List the results in order by offer department name and subject key. Do not return any rounded answers.\"}, {\"id\": \"dw_1301\", \"desc\": \"For each academic year, where the maximum number of total units for any Mathematics (Course 18) subject offered in that year is greater than 9 and there are more than 5 Mathematics subjects offered in the fall term, what are the academic year, the maximum total units, the corresponding term description, the subject title, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in library subjects offered during terms in that year, and the average number of equivalent subjects for those library subjects? List the results in order of academic year. Do not return any rounded answers.\"}, {\"id\": \"dw_2597\", \"desc\": \"For each academic year, what is the description of the academic year, the department name, the average total units for all subjects offered by that department in terms that match that academic year and have a term status indicator of 'P', and the deviation of each department's average total units from the overall average total units for that academic year? Do not return any rounded answers.\"}, {\"id\": \"dw_4724\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\"}, {\"id\": \"dw_3632\", \"desc\": \"For subjects offered in the term \\\"2012SU\\\", show the subject title, subject key, offer department name, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, subject ID, academic year, term description, and the minimum number of enrolled students in a window of 3 preceding and 1 following row, ordered by offer department name and academic year. Do not return any rounded answers.\"}, {\"id\": \"dw_4184\", \"desc\": \"For each department, show the offer department name, the number of distinct subjects offered by the department in the academic year 2012, and for each subject that was offered in the term \\\"2012SU\\\", display the subject key, subject title, academic year, term description, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, and the deviation of each subject's enrollment number from the average enrollment number for its subject key group, ordered by offer department name and subject key. Do not return any rounded answers.\"}, {\"id\": \"dw_4405\", \"desc\": \"For each combination of activity and department/academic year enrollment statistics, list the activity title, enrollment type, maximum enrollment, category name, category description, and the dense rank of each row partitioned by the category name and ordered by the category name, along with the department name, academic year, number of unique subjects offered (subject count), minimum number of total units for those subjects, and the average number of enrolled students per subject (for departments and academic years where the number of enrolled students in a subject is greater than 5). Do not return any rounded answers.\"}, {\"id\": \"dw_3248\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units that are also offered in the library by the Mathematics department during regular terms, show the subject code, subject number, subject title, department name, term description, the rank of each subject within its department ordered by subject code, the number of enrolled students, offering department name, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_4584\", \"desc\": \"For Mathematics department courses with at least 5 enrolled students, show the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, and the average calendar year within each calendar year group ordered by term start date, but only for academic terms where the term status is 'Previous', and only include results where the number of enrolled students is greater than the average number of enrolled students for that academic year. Do not return any rounded answers.\"}, {\"id\": \"dw_2580\", \"desc\": \"For each department and academic year, provide the department name, academic year, the number of subjects offered that are not repeatable for credit and are offered in the fall term, and classify the department as 'HIGH_ACTIVITY' if it offers at least 10% more such subjects than the average across all departments for that year, 'LOW_ACTIVITY' if it offers at least 10% fewer, or 'AVERAGE' otherwise. Do not return any rounded answers.\"}]}}"
