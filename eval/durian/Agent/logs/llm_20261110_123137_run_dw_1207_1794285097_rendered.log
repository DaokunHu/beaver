    {
      "role": "tool",
      "tool_call_id": "call_cb4c1eb1d2ba448fbe59496a",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per academic year\", \"desc\": \"For each academic year, what is the academic year, academic year description, the geometric mean of the number of library reserve material details per subject offered (considering only records where the material status is 'U' and the academic term is a regular term), the average total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the average number of design units for subjects that are offered in the fall term and have a material status of 'U' in the library reserve? List the results ordered by the geometric mean of materials per subject in descending order, then by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\", \"id\": \"dw_4701\", \"name\": \"Yearly Geometric Mean Reserve Materials per Subject with Fall Term Unit Statistics\", \"sql\": \"WITH inner_cte AS ( WITH GeometricMeanMaterialsPerSubject AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, EXP(AVG(LN(material_count))) AS geometric_mean_materials_per_subject FROM ( SELECT LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY, COUNT(*) AS material_count, LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE FROM LIBRARY_RESERVE_MATRL_DETAIL WHERE LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY = 'U' GROUP BY LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY, LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE ) sub JOIN ACADEMIC_TERMS ON sub.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC ), AvgStddevTotalUnitsFallU AS ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, AVG(ccso.TOTAL_UNITS) AS avg_total_units, STDDEV(ccso.TOTAL_UNITS) AS stddev_total_units FROM LIBRARY_RESERVE_MATRL_DETAIL lrm JOIN ACADEMIC_TERMS at ON lrm.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE lrm.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ) SELECT gmmps.ACADEMIC_YEAR, gmmps.ACADEMIC_YEAR_DESC, gmmps.geometric_mean_materials_per_subject, astu.avg_total_units, astu.stddev_total_units FROM GeometricMeanMaterialsPerSubject gmmps JOIN AvgStddevTotalUnitsFallU astu ON gmmps.ACADEMIC_YEAR = astu.ACADEMIC_YEAR AND gmmps.ACADEMIC_YEAR_DESC = astu.ACADEMIC_YEAR_DESC ORDER BY gmmps.geometric_mean_materials_per_subject DESC, astu.stddev_total_units DESC ) SELECT icte.ACADEMIC_YEAR, icte.ACADEMIC_YEAR_DESC, icte.geometric_mean_materials_per_subject, icte.avg_total_units, icte.stddev_total_units, avg_design.avg_design_units FROM inner_cte icte JOIN ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, AVG(ccso.DESIGN_UNITS) AS avg_design_units FROM LIBRARY_RESERVE_MATRL_DETAIL lrm JOIN ACADEMIC_TERMS at ON lrm.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE lrm.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ) avg_design ON icte.ACADEMIC_YEAR = avg_design.ACADEMIC_YEAR AND icte.ACADEMIC_YEAR_DESC = avg_design.ACADEMIC_YEAR_DESC ORDER BY icte.geometric_mean_materials_per_subject DESC, icte.stddev_total_units DESC;\"}, {\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2014FA Chemistry library subject per academic year per required-material count\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, and for each academic year, also show the academic year and academic year description and the coefficient of variation (using STDDEV only and never STDDEV_POP) of the total units for subjects in the Mathematics department (Course 18) that have more than 0 total units and are offered in terms with a term status indicator of 'P'. Additionally, for each Chemistry subject, include the number of required TIP materials (where TIP_MATERIAL_STATUS_KEY = 'RQ') for that subject in that term. Do not return any rounded answers.\", \"id\": \"dw_2180\", \"name\": \"2014FA Chemistry Library Subjects Windowed Enrollment with Math Unit Coefficient of Variation and Required Material Counts\", \"sql\": \"WITH inner_cte AS ( SELECT l.SUBJECT_TITLE, l.NUM_ENROLLED_STUDENTS, t.RESPONSIBLE_FACULTY_NAME, t.OFFER_DEPT_NAME, MIN(l.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t.RESPONSIBLE_FACULTY_MIT_ID ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column, l.TERM_CODE FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_SUBJECT_OFFERED t ON l.TERM_CODE = t.TERM_CODE WHERE l.TERM_CODE = '2014FA' AND t.OFFER_DEPT_NAME = 'Chemistry' ), math_units_variation AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, STDDEV_SAMP(ss.TOTAL_UNITS) / NULLIF(AVG(ss.TOTAL_UNITS), 0) AS coefficient_of_variation_total_units FROM SUBJECT_SUMMARY ss JOIN ACADEMIC_TERMS_ALL ata ON ss.TERM_CODE = ata.TERM_CODE WHERE ss.DEPARTMENT_NAME = 'Mathematics' AND ss.TOTAL_UNITS > 0 AND ata.TERM_STATUS_INDICATOR = 'P' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC ORDER BY ata.ACADEMIC_YEAR ), required_materials_count AS ( SELECT t.TERM_CODE, t.SUBJECT_ID, COUNT(*) AS num_required_materials FROM TIP_DETAIL t WHERE t.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY t.TERM_CODE, t.SUBJECT_ID ) SELECT c.SUBJECT_TITLE, c.NUM_ENROLLED_STUDENTS, c.RESPONSIBLE_FACULTY_NAME, c.OFFER_DEPT_NAME, c.window_column, m.ACADEMIC_YEAR, m.ACADEMIC_YEAR_DESC, m.coefficient_of_variation_total_units, COALESCE(r.num_required_materials, 0) AS num_required_materials FROM inner_cte c CROSS JOIN math_units_variation m LEFT JOIN TIP_SUBJECT_OFFERED t ON c.TERM_CODE = t.TERM_CODE AND c.SUBJECT_TITLE = t.SUBJECT_TITLE LEFT JOIN required_materials_count r ON t.TERM_CODE = r.TERM_CODE AND t.SUBJECT_ID = r.SUBJECT_ID\"}, {\"id\": \"dw_41\", \"name\": \"Yearly Average and Variance of Math Full-Term Subject Total Units in Previous Terms\", \"desc\": \"For each academic year, provide the academic year description and calculate the average and variance of the total units for subjects offered in terms that are not the current term, have a term status indicator of 'P', are offered by the Mathematics department, and are full term subjects. Do not return any rounded answers.\", \"category\": \"Subject Offering Analysis\", \"sql\": \"WITH inner_cte AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, AVG(ccso.TOTAL_UNITS) AS avg_total_units, VARIANCE(ccso.TOTAL_UNITS) AS total_units_variance FROM ACADEMIC_TERMS_ALL ata JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE ata.IS_CURRENT_TERM = 'N' AND ata.TERM_STATUS_INDICATOR = 'P' AND ccso.DEPARTMENT_NAME = 'Mathematics' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC ) SELECT ic.ACADEMIC_YEAR, ic.ACADEMIC_YEAR_DESC, ic.avg_total_units, ic.total_units_variance FROM inner_cte ic JOIN ACADEMIC_TERMS_ALL ata ON ic.ACADEMIC_YEAR = ata.ACADEMIC_YEAR JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE ccso.TERM_DURATION = 'Full Term Subject' GROUP BY ic.ACADEMIC_YEAR, ic.ACADEMIC_YEAR_DESC, ic.avg_total_units, ic.total_units_variance ORDER BY ic.total_units_variance DESC;\", \"default_granularity\": \"one row per academic year\"}], \"not_found\": []}"
    },
