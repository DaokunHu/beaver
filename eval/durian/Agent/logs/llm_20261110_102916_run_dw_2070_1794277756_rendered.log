      "tool_call_id": "call_694584ba7ad34c34b5844da7",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_2224\", \"name\": \"Math Subject Code School Budget Code Windows with Non-Math Admin Department Clearing Cost Statistics\", \"desc\": \"For each subject code where the department is degree granting and the department is Mathematics, and for each department that is degree granting and is not the Mathematics department (Course 18), show the subject code, subject code description, mathematics department name, school name, the average department budget code within each school, the administrative department name, the average clearing cost collector, the variance of the clearing cost collector, the standard deviation (using STDDEV only and never STDDEV_POP) of the clearing cost collector, and the most recent activity date for the administrative department. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT scm.SUBJECT_CODE, scm.SUBJECT_CODE_DESC, scm.DEPARTMENT_NAME AS mathematics_department_name, scm.SCHOOL_NAME, scm.avg_dept_budget_code, ads.DEPARTMENT_NAME AS admin_department_name, ads.avg_clearing_cost_collector, ads.clearing_cost_collector_variance, ads.clearing_cost_collector_stddev FROM ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME, AVG(t0.DEPT_BUDGET_CODE) OVER (PARTITION BY t1.SCHOOL_NAME ORDER BY t0.DEPARTMENT_NAME) AS avg_dept_budget_code FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' AND t0.DEPARTMENT_NAME = 'Mathematics' ORDER BY t0.DEPARTMENT_NAME ) scm CROSS JOIN ( SELECT d.DEPARTMENT_NAME, AVG(a.CLEARING_COST_COLLECTOR) AS avg_clearing_cost_collector, VARIANCE(a.CLEARING_COST_COLLECTOR) AS clearing_cost_collector_variance, STDDEV(a.CLEARING_COST_COLLECTOR) AS clearing_cost_collector_stddev, MAX(a.LAST_ACTIVITY_DATE) AS most_recent_activity_date FROM SIS_DEPARTMENT d JOIN SIS_ADMIN_DEPARTMENT a ON d.DEPARTMENT_CODE = a.SIS_ADMIN_DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_NAME != 'Mathematics' AND d.DEPARTMENT_CODE != '18' GROUP BY d.DEPARTMENT_NAME ORDER BY clearing_cost_collector_variance DESC ) ads ) SELECT inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.mathematics_department_name, inner_cte.SCHOOL_NAME, inner_cte.avg_dept_budget_code, inner_cte.admin_department_name, inner_cte.avg_clearing_cost_collector, inner_cte.clearing_cost_collector_variance, inner_cte.clearing_cost_collector_stddev, ads2.most_recent_activity_date FROM inner_cte JOIN ( SELECT d.DEPARTMENT_NAME, MAX(a.LAST_ACTIVITY_DATE) AS most_recent_activity_date FROM SIS_DEPARTMENT d JOIN SIS_ADMIN_DEPARTMENT a ON d.DEPARTMENT_CODE = a.SIS_ADMIN_DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_NAME != 'Mathematics' AND d.DEPARTMENT_CODE != '18' GROUP BY d.DEPARTMENT_NAME ) ads2 ON inner_cte.admin_department_name = ads2.DEPARTMENT_NAME;\", \"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per Mathematics subject code crossed with each non-Mathematics degree-granting administrative department\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject code matched with 2024 Mathematics catalog subject\", \"desc\": \"For each subject code in degree-granting departments where the department is Mathematics, and for subjects offered in the academic year 2024 that are also present in the CIS course catalog and are in the Mathematics department, show the subject code, subject code description, department name, school name, rank of the subject code within each school name group ordered by subject code, subject ID, subject number, subject short title, subject title, lecture units, lab units, total units, grade type, grade rule, the minimum total units value over each department code group, and the subject description from the CIS course catalog, ordered by school name, rank, and subject number. Do not return any rounded answers.\", \"id\": \"dw_2210\", \"name\": \"Math Subject Code School Ranks Matched with 2024 Catalog Offerings and Department Min Units\", \"sql\": \"WITH inner_cte AS ( WITH SubjectCodeRanks AS ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME, RANK() OVER (PARTITION BY t1.SCHOOL_NAME ORDER BY t1.SUBJECT_CODE) AS window_column FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' AND t0.DEPARTMENT_NAME = 'Mathematics' ), MathSubjects2024 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_SHORT_TITLE, t0.SUBJECT_TITLE, t0.LECTURE_UNITS, t0.LAB_UNITS, t0.TOTAL_UNITS, t0.GRADE_TYPE, t0.GRADE_RULE, min(t0.TOTAL_UNITS) OVER (PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.DEPARTMENT_CODE) AS min_total_units_by_dept FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN CIS_COURSE_CATALOG t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2024 AND t0.DEPARTMENT_NAME = 'Mathematics' ORDER BY t0.DEPARTMENT_CODE ) SELECT scr.SUBJECT_CODE, scr.SUBJECT_CODE_DESC, scr.DEPARTMENT_NAME, scr.SCHOOL_NAME, scr.window_column, ms.SUBJECT_ID, ms.SUBJECT_NUMBER, ms.SUBJECT_SHORT_TITLE, ms.SUBJECT_TITLE, ms.LECTURE_UNITS, ms.LAB_UNITS, ms.TOTAL_UNITS, ms.GRADE_TYPE, ms.GRADE_RULE, ms.min_total_units_by_dept FROM SubjectCodeRanks scr JOIN MathSubjects2024 ms ON scr.SUBJECT_CODE = ms.SUBJECT_CODE ) SELECT ic.SUBJECT_CODE, ic.SUBJECT_CODE_DESC, ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.window_column, ic.SUBJECT_ID, ic.SUBJECT_NUMBER, ic.SUBJECT_SHORT_TITLE, ic.SUBJECT_TITLE, ic.LECTURE_UNITS, ic.LAB_UNITS, ic.TOTAL_UNITS, ic.GRADE_TYPE, ic.GRADE_RULE, ic.min_total_units_by_dept, ccc.SUBJECT_DESCRIPTION FROM inner_cte ic JOIN CIS_COURSE_CATALOG ccc ON ic.SUBJECT_ID = ccc.SUBJECT_ID ORDER BY ic.SCHOOL_NAME, ic.window_column, ic.SUBJECT_NUMBER;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per school per description status plus rollup totals matched with 2022SU subjects\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name (from subject code), school name, the number of subject codes per school name and whether the subject code description is present ('Has Description') or missing ('No Description'), and for each matching department in subjects offered in the term with code '2022SU', show the subject's ID, total units, department name (from subject offered), and their dense rank considering the current and 2 preceding rows ordered by the total number of units. For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes, null, null, null, null). Do not return any rounded answers.\", \"id\": \"dw_3904\", \"name\": \"Degree-Granting Subject Code Description Status Rollup by School with 2022SU Unit Dense Ranks\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' ), SubjectCodeVisibility AS ( SELECT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, CASE WHEN SUBJECT_CODE_DESC IS NOT NULL AND SUBJECT_CODE_DESC <> 'nan' THEN 'Has Description' ELSE 'No Description' END AS description_status FROM inner_cte1 ), RollupResults AS ( SELECT SCHOOL_NAME, description_status, COUNT(*) AS total_subject_codes FROM SubjectCodeVisibility GROUP BY SCHOOL_NAME, description_status WITH ROLLUP HAVING COUNT(*) > 0 ), inner_cte2 AS ( SELECT t1.SUBJECT_ID, t1.TOTAL_UNITS, t1.DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t1.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) SELECT scv.SUBJECT_CODE, scv.SUBJECT_CODE_DESC, scv.DEPARTMENT_NAME AS SCV_DEPARTMENT_NAME, rr.SCHOOL_NAME, rr.description_status, rr.total_subject_codes, ic2.SUBJECT_ID, ic2.TOTAL_UNITS, ic2.DEPARTMENT_NAME AS IC2_DEPARTMENT_NAME, ic2.window_column FROM RollupResults rr LEFT JOIN ( SELECT DISTINCT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, description_status FROM SubjectCodeVisibility ) scv ON rr.SCHOOL_NAME = scv.SCHOOL_NAME AND rr.description_status = scv.description_status LEFT JOIN inner_cte2 ic2 ON scv.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME ORDER BY rr.SCHOOL_NAME, rr.description_status, ic2.TOTAL_UNITS DESC\"}], \"not_found\": []}"
    },
