    {
      "role": "tool",
      "tool_call_id": "call_1883601e48664d8a89be765f",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"default_granularity\": \"one row per Provost Area department rank matched with a space-unit-97500 supervisor usage statistics row of the same DLC\", \"desc\": \"For each department in the \\\"Provost Area\\\" that is associated with a space unit with space unit code 97500, show the department code, department name, school area name, the rank of each department within its school area based on department code, the corresponding DLC name, the space unit name, space unit code, associated organization name, department count, number of supervisees, and the highest research volume ever recorded for each department count group. Do not return any rounded answers.\", \"id\": \"dw_4452\", \"name\": \"Provost Area Department School-Area Ranks with Space Unit 97500 Supervisor Usage Statistics\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.HR_DEPARTMENT_CODE, t1.HR_DEPARTMENT_NAME, t1.ORG_HIER_SCHOOL_AREA_NAME, RANK() OVER (PARTITION BY t1.ORG_HIER_SCHOOL_AREA_NAME ORDER BY t1.HR_DEPARTMENT_CODE) AS window_column, t1.DLC_KEY FROM MASTER_DEPT_HIERARCHY t0 INNER JOIN HR_ORG_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' ), DeptRanked AS ( SELECT inner_cte1.HR_DEPARTMENT_CODE, inner_cte1.HR_DEPARTMENT_NAME, inner_cte1.ORG_HIER_SCHOOL_AREA_NAME, inner_cte1.window_column, t2.DLC_NAME, inner_cte1.DLC_KEY FROM inner_cte1 INNER JOIN HR_ORG_UNIT t2 ON inner_cte1.DLC_KEY = t2.DLC_KEY ), inner_cte2 AS ( SELECT t1.SPACE_UNIT AS space_unit_name, t1.SPACE_UNIT_CODE, t0.ORGANIZATION_NAME, t2.DEPT_COUNT, t2.NUM_OF_SUPERVISEES, t2.RESEARCH_VOLUME, t1.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN SPACE_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY JOIN SPACE_SUPERVISOR_USAGE t2 ON t1.DLC_KEY = t2.DEPT_NAMES WHERE t1.SPACE_UNIT_CODE = 97500 ), SpaceStats AS ( SELECT space_unit_name, SPACE_UNIT_CODE, ORGANIZATION_NAME, DEPT_COUNT, NUM_OF_SUPERVISEES, MAX(RESEARCH_VOLUME) AS highest_research_volume, DLC_KEY FROM inner_cte2 GROUP BY space_unit_name, SPACE_UNIT_CODE, ORGANIZATION_NAME, DEPT_COUNT, NUM_OF_SUPERVISEES, DLC_KEY ) SELECT d.HR_DEPARTMENT_CODE, d.HR_DEPARTMENT_NAME, d.ORG_HIER_SCHOOL_AREA_NAME, d.window_column, d.DLC_NAME, s.space_unit_name, s.SPACE_UNIT_CODE, s.ORGANIZATION_NAME, s.DEPT_COUNT, s.NUM_OF_SUPERVISEES, s.highest_research_volume FROM DeptRanked d JOIN SpaceStats s ON d.DLC_KEY = s.DLC_KEY ORDER BY d.HR_DEPARTMENT_CODE, s.space_unit_name;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\"}, {\"id\": \"dw_1864\", \"name\": \"Level-5 Assignable Organization Space Units with Provost Area HR Department Statistics\", \"desc\": \"For each organization whose organization level is 5 and is not 'ADMISSIONS', and for each organization and its corresponding HR department where the organization is assignable, the HR organization unit level is 'DEPARTMENTS', the organization is not 'Cambridge-MIT Institute', and the organization is in the 'Provost Area' top-level HR hierarchy, but excluding organizations with organization IDs '138' and '250', show the organization name, description, the corresponding space unit name, the total number of space units associated with each organization, the HR department name, the number of organizations, and the minimum organization number. Do not return any rounded answers.\", \"sql\": \"WITH org_space_units AS ( SELECT ORGANIZATION_NAME, DESCRIPTION, SPACE_UNIT, COUNT(SPACE_UNIT) OVER (PARTITION BY ORGANIZATION_NAME) AS total_space_units, DLC_KEY FROM ( SELECT t0.ORGANIZATION_NAME, t0.DESCRIPTION, t1.SPACE_UNIT, ROW_NUMBER() OVER (ORDER BY t1.SPACE_UNIT ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t0.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN SPACE_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.ORGANIZATION_LEVEL = 5 AND t0.ORGANIZATION_NAME <> 'ADMISSIONS' AND t0.ORGANIZATION_ID NOT IN ('138', '250') ) inner_cte ), org_hr_dept AS ( SELECT ic.ORGANIZATION, ic.HR_DEPARTMENT_NAME, ic.organization_count, ic.min_organization_number, f.DLC_KEY FROM ( SELECT f.ORGANIZATION, h.HR_DEPARTMENT_NAME, COUNT(f.FCLT_ORGANIZATION_KEY) AS organization_count, MIN(f.ORGANIZATION_NUMBER) AS min_organization_number FROM FCLT_ORGANIZATION f JOIN HR_ORG_UNIT h ON f.HR_DEPARTMENT_CODE_OLD = h.HR_DEPARTMENT_CODE_OLD WHERE f.ASSIGNABLE = 1 AND h.HR_ORG_UNIT_LEVEL = 'DEPARTMENTS' AND f.ORGANIZATION_NAME NOT IN ('CAMBRIDGE-MIT INST') AND f.ORGANIZATION_ID NOT IN ('138', '250') GROUP BY f.ORGANIZATION, h.HR_DEPARTMENT_NAME ) ic JOIN HR_ORG_UNIT h2 ON ic.HR_DEPARTMENT_NAME = h2.HR_DEPARTMENT_NAME JOIN FCLT_ORGANIZATION f ON ic.ORGANIZATION = f.ORGANIZATION WHERE h2.ORG_HIER_TOP_LEVEL_NAME = 'Provost Area' ) SELECT osu.ORGANIZATION_NAME, osu.DESCRIPTION, osu.SPACE_UNIT, osu.total_space_units, ohd.HR_DEPARTMENT_NAME, ohd.organization_count, ohd.min_organization_number FROM org_space_units osu JOIN org_hr_dept ohd ON osu.DLC_KEY = ohd.DLC_KEY;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per level-5 organization space unit matched with its Provost Area HR department statistics\"}, {\"id\": \"dw_2559\", \"name\": \"Office-Named DLCs with Assignable Organization Counts, Provost Area Department Max Organization Number, Space Unit, and Earliest Load Date\", \"desc\": \"For each DLC whose DLC name contains the word 'Office', is not the biology department, and has at least one assignable organization, what are the DLC key, DLC name, the number of unique organizations, the total number of assignable organizations, the department name, the maximum organization number, the name of the space unit associated with that department, and the earliest warehouse load date among its organizations, considering only departments in the \\\"Provost Area\\\" with a maximum organization number greater than 50000 and excluding the \\\"Political Science\\\" department (Course 17)? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT d.DLC_KEY, o.DLC_NAME, COUNT(DISTINCT o.FCLT_ORGANIZATION_KEY) AS organization_count, SUM(CASE WHEN o.ASSIGNABLE = 1 THEN 1 ELSE 0 END) AS assignable_organization_count FROM FCLT_ORG_DLC_KEY d JOIN FCLT_ORGANIZATION o ON d.DLC_KEY = o.DLC_KEY WHERE o.ASSIGNABLE = 1 AND o.DLC_NAME LIKE '%Office%' AND LOWER(o.DLC_NAME) != LOWER('Biology') GROUP BY d.DLC_KEY, o.DLC_NAME ), Dept_Max_Org_Space AS ( SELECT mdh.DLC_KEY, mdh.DLC_NAME AS department, MAX(fo.ORGANIZATION_NUMBER) AS max_organization_number, su.SPACE_UNIT AS space_unit_name FROM MASTER_DEPT_HIERARCHY mdh JOIN FCLT_ORGANIZATION fo ON mdh.DLC_KEY = fo.DLC_KEY LEFT JOIN SPACE_UNIT su ON fo.DLC_KEY = su.DLC_KEY WHERE mdh.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' AND fo.ORGANIZATION_NUMBER > 50000 AND mdh.DLC_NAME <> 'Political Science' GROUP BY mdh.DLC_KEY, mdh.DLC_NAME, su.SPACE_UNIT ), Org_Earliest_Load AS ( SELECT o.DLC_KEY, MIN(o.WAREHOUSE_LOAD_DATE) AS earliest_warehouse_load_date FROM FCLT_ORGANIZATION o GROUP BY o.DLC_KEY ) SELECT ic.DLC_KEY, ic.DLC_NAME, ic.organization_count, ic.assignable_organization_count, dmos.department, dmos.max_organization_number, dmos.space_unit_name, oel.earliest_warehouse_load_date FROM inner_cte ic JOIN Dept_Max_Org_Space dmos ON ic.DLC_KEY = dmos.DLC_KEY LEFT JOIN Org_Earliest_Load oel ON ic.DLC_KEY = oel.DLC_KEY;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per Office-named DLC matched with Provost Area department space unit and load date statistics\"}, {\"default_granularity\": \"one row per assignable organization with high HR department id matched with a space-unit-code-97500 space unit row of the same organization\", \"desc\": \"For each organization that is assignable and has a department code above 100000, and for which there exists a space unit with space unit code equal to 97500, show the organization key, organization name, department name, the number of HR org units, the total of their department IDs, the latest warehouse load date from HR_ORG_UNIT, the space unit name, the DLC name, the DLC key from the organization, the minimum space unit code in a window of 3 preceding and 1 following row ordered by the facility organization key, and the total number of space units per organization, in that order. Do not return any rounded answers.\", \"id\": \"dw_4330\", \"name\": \"Assignable Organizations with High HR Department IDs Matched with Space Unit 97500 Window Statistics\", \"sql\": \"WITH org_hr_stats AS ( WITH inner_cte AS ( SELECT f.FCLT_ORGANIZATION_KEY, f.ORGANIZATION_NAME, h.HR_DEPARTMENT_NAME, COUNT(h.HR_ORG_UNIT_KEY) AS hr_org_unit_count, SUM(h.HR_DEPARTMENT_ID) AS total_department_id FROM FCLT_ORGANIZATION f JOIN HR_ORG_UNIT h ON f.HR_DEPARTMENT_CODE_OLD = h.HR_DEPARTMENT_CODE_OLD WHERE f.ASSIGNABLE = 1 AND h.HR_DEPARTMENT_ID > 100000 GROUP BY f.FCLT_ORGANIZATION_KEY, f.ORGANIZATION_NAME, h.HR_DEPARTMENT_NAME ) SELECT i.FCLT_ORGANIZATION_KEY, i.ORGANIZATION_NAME, i.HR_DEPARTMENT_NAME, i.hr_org_unit_count, i.total_department_id, MAX(h.WAREHOUSE_LOAD_DATE) AS latest_hr_org_unit_load_date FROM inner_cte i JOIN HR_ORG_UNIT h ON i.HR_DEPARTMENT_NAME = h.HR_DEPARTMENT_NAME GROUP BY i.FCLT_ORGANIZATION_KEY, i.ORGANIZATION_NAME, i.HR_DEPARTMENT_NAME, i.hr_org_unit_count, i.total_department_id ), space_unit_stats AS ( WITH inner_cte AS ( SELECT t2.SPACE_UNIT AS space_unit_name, t1.ORGANIZATION_NAME AS organization_name, t1.DLC_NAME AS dlc_name, t1.DLC_KEY AS org_dlc_key, MIN(t2.SPACE_UNIT_CODE) OVER (ORDER BY t2.FCLT_ORGANIZATION_KEY ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_min_space_unit_code, t1.FCLT_ORGANIZATION_KEY FROM FCLT_ORG_DLC_KEY t0 JOIN FCLT_ORGANIZATION t1 ON t0.DLC_KEY = t1.DLC_KEY JOIN SPACE_UNIT t2 ON t1.DLC_KEY = t2.DLC_KEY WHERE t2.SPACE_UNIT_CODE = 97500 ) SELECT inner_cte.space_unit_name, inner_cte.organization_name, inner_cte.dlc_name, inner_cte.org_dlc_key, inner_cte.window_min_space_unit_code, org_unit_counts.total_space_units, inner_cte.FCLT_ORGANIZATION_KEY FROM inner_cte JOIN ( SELECT t1.ORGANIZATION_NAME, COUNT(DISTINCT t2.SPACE_UNIT_KEY) AS total_space_units FROM FCLT_ORG_DLC_KEY t0 JOIN FCLT_ORGANIZATION t1 ON t0.DLC_KEY = t1.DLC_KEY JOIN SPACE_UNIT t2 ON t1.DLC_KEY = t2.DLC_KEY GROUP BY t1.ORGANIZATION_NAME ) AS org_unit_counts ON inner_cte.organization_name = org_unit_counts.ORGANIZATION_NAME ) SELECT o.FCLT_ORGANIZATION_KEY, o.ORGANIZATION_NAME, o.HR_DEPARTMENT_NAME, o.hr_org_unit_count, o.total_department_id, o.latest_hr_org_unit_load_date, s.space_unit_name, s.dlc_name, s.org_dlc_key, s.window_min_space_unit_code, s.total_space_units FROM org_hr_stats o JOIN space_unit_stats s ON o.FCLT_ORGANIZATION_KEY = s.FCLT_ORGANIZATION_KEY\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\"}], \"not_found\": []}"
    },
