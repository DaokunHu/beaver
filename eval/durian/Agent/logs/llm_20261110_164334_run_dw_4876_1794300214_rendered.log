    {
      "role": "tool",
      "tool_call_id": "call_945886954c3d46c985135dda",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SPACE_UNIT\", \"name\": \"SPACE_UNIT\", \"desc\": \"Space unit dimension table: one row per space unit (an organizational space-assignment unit such as a department, program, or office that receives space allocation), with space unit key/code, space unit name, the facilities organization it belongs to, and DLC key. Bridges FCLT_ORGANIZATION (organization attribution) and SPACE_DETAIL (rooms assigned to the space unit); used to group room counts and space statistics by space unit.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Foreign key to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY; the organization that owns/occupies this space unit\"}, \"SPACE_UNIT_KEY\": {\"desc\": \"Surrogate key of the space unit; joins to SPACE_DETAIL.SPACE_UNIT_KEY and SPACE_UNIT2.SPACE_UNIT_KEY; used for partitioning/ordering in space analyses\"}, \"SPACE_UNIT_CODE\": {\"desc\": \"Business code of the space unit (same numeric value as the key in current data)\"}, \"SPACE_UNIT\": {\"desc\": \"Name of the space unit, e.g. 'Physics', 'Technology & Policy Program'\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_PHYSICS'; may contain composite values like 'D_DSL:HQ'\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per space unit\"}, {\"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Surrogate key of the facilities organization; joins to SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY\"}, \"ORGANIZATION_ID\": {\"desc\": \"Organization identifier (same value as the organization key in current data)\"}, \"ORGANIZATION\": {\"desc\": \"Short organization abbreviation, e.g. 'AERO', 'ADMISS'\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Display name of the organization, e.g. 'AERO & ASTRO'; used for organization-name reporting\"}, \"FCLT_ORG_PARENT_KEY\": {\"desc\": \"Key of the parent organization in the hierarchy tree; null for the top-level organization\"}, \"ORG_PARENT\": {\"desc\": \"Abbreviation of the parent organization, e.g. 'S ENG' (School of Engineering)\"}, \"FCLT_MAJOR_ORG_KEY\": {\"desc\": \"Key of the major (top-level grouping) organization this organization rolls up to\"}, \"MAJOR_ORG\": {\"desc\": \"Abbreviation of the major organization, e.g. 'PROVST', 'CHNCLR'\"}, \"ORGANIZATION_LEVEL\": {\"desc\": \"Level of the organization in the hierarchy tree (1 = institute-wide root, 2-4 = intermediate divisions/schools, 5 = department/DLC level, 6 = sub-organization); stored as string, filter with values like '5'\"}, \"ORGANIZATION_NUMBER\": {\"desc\": \"Official organization number used in administrative systems\"}, \"ORGANIZATION_SORT\": {\"desc\": \"Sortable hierarchical organization code reflecting the tree path\"}, \"ASSIGNABLE\": {\"desc\": \"Flag ('1'/'0') indicating whether the organization is an assignable-space organizational unit\"}, \"COURSE\": {\"desc\": \"Academic course (department) number for degree-granting academic departments, e.g. '16' for Aeronautics and Astronautics; null for non-academic organizations\"}, \"DESCRIPTION\": {\"desc\": \"Long description of the organization, e.g. 'Department of Aeronautics and Astronautics'; null for many non-academic organizations\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_AEROASTRO'; joins to FCLT_ORG_DLC_KEY.DLC_KEY, HR_ORG_UNIT.DLC_KEY (for HR org unit title/level and HR department attributes; may fan out when a DLC maps to multiple HR org units), and MASTER_DEPT_HIERARCHY.DLC_KEY (for the standard department hierarchy path)\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Aeronautics and Astronautics'\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code cross-reference\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"HR organization unit identifier cross-reference; links to HR_ORG_UNIT\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"Department name as recorded in HR systems\"}}, \"default_granularity\": \"one row per facilities organization\"}, {\"id\": \"MASTER_DEPT_HIERARCHY\", \"name\": \"MASTER_DEPT_HIERARCHY\", \"desc\": \"Master department hierarchy table: one row per department/lab/center (DLC) under the 'Standard Hierarchy' hierarchy type, recording the DLC key/code/name and its five-level hierarchy path from the institute root (level 1 'All Departments') through executive areas down to the DLC's placement, with each level's code and name (null for levels deeper than the DLC's position). Joins to HR_ORG_UNIT and FCLT_ORGANIZATION via DLC_KEY; used to report or filter the master-hierarchy placement (school/area path) of a DLC, and as a DLC scope filter when only DLCs present in the standard hierarchy should be included.\", \"columns\": {\"HIERARCHY_TYPE\": {\"desc\": \"Hierarchy classification of the row; only 'Standard Hierarchy' exists in current data\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_CAMPLAN'; joins to HR_ORG_UNIT.DLC_KEY and FCLT_ORGANIZATION.DLC_KEY\"}, \"DLC_CODE\": {\"desc\": \"Department/Lab/Center code (same value as DLC_KEY in current data); matches MASTER_DEPT_DCODE_PARENT.D_CODE\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Campus Planning'\"}, \"MASTER_DEPT_HIER_LEVEL_1_CODE\": {\"desc\": \"Code of the level-1 hierarchy node, 'D_ALL' for all rows\"}, \"MASTER_DEPT_HIER_LEVEL_1_NAME\": {\"desc\": \"Name of the level-1 hierarchy node, 'All Departments'\"}, \"MASTER_DEPT_HIER_LEVEL_2_CODE\": {\"desc\": \"Code of the level-2 hierarchy node, e.g. 'D_EXECVP_AREA'\"}, \"MASTER_DEPT_HIER_LEVEL_2_NAME\": {\"desc\": \"Name of the level-2 hierarchy node, e.g. \\\"Executive Vice President's Area\\\"\"}, \"MASTER_DEPT_HIER_LEVEL_3_CODE\": {\"desc\": \"Code of the level-3 hierarchy node; null when the DLC's path is shallower than 3 levels\"}, \"MASTER_DEPT_HIER_LEVEL_3_NAME\": {\"desc\": \"Name of the level-3 hierarchy node, e.g. 'VP Finance Area'; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_4_CODE\": {\"desc\": \"Code of the level-4 hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_4_NAME\": {\"desc\": \"Name of the level-4 hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_5_CODE\": {\"desc\": \"Code of the level-5 (deepest) hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_5_NAME\": {\"desc\": \"Name of the level-5 (deepest) hierarchy node; null for shallow paths\"}}, \"default_granularity\": \"one row per DLC under the standard hierarchy type\"}, {\"id\": \"HR_ORG_UNIT\", \"name\": \"HR_ORG_UNIT\", \"desc\": \"HR organization unit dimension table: one row per HR organization unit with unit key/ID/title, unit level classification (ALL MIT, TOP LEVEL, DEPARTMENTS, SUB DEPARTMENT, ORGANIZATION LEVEL, NON HIERARCHY ORG UNITS), HR department identifiers and name variants (short, long, alphabetical), organization hierarchy area names (school area, top level, root), the full HR hierarchy path levels 1-7 (each with ID, sort order, and name), and DLC_KEY/DLC_NAME cross-references to departments/labs/centers. Joined from FCLT_ORGANIZATION and MASTER_DEPT_HIERARCHY via DLC_KEY to attach HR department attributes (title, level, department name, long name, hierarchy path) to facilities organizations and DLCs; a single DLC_KEY can map to multiple HR org unit rows, so joins via DLC_KEY may fan out.\", \"columns\": {\"HR_ORG_UNIT_KEY\": {\"desc\": \"Surrogate key of the HR organization unit, formatted 'O' + numeric ID (e.g. 'O10000333'); joins to HR_ORG_UNIT_NEW.HR_ORG_UNIT_KEY\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"Numeric HR organization unit identifier (e.g. '10000333'); cross-referenced by FCLT_ORGANIZATION.HR_ORG_UNIT_ID\"}, \"HR_ORG_UNIT_TITLE\": {\"desc\": \"Title of the HR organization unit, e.g. 'Institute for Data, Systems, and Society'; reported as the HR org unit title of a facilities organization joined via DLC_KEY\"}, \"HR_ORG_UNIT_LEVEL\": {\"desc\": \"Level classification of the HR organization unit; observed values: 'ALL MIT', 'TOP LEVEL', 'DEPARTMENTS', 'SUB DEPARTMENT', 'ORGANIZATION LEVEL', 'NON HIERARCHY ORG UNITS', and null; distinct from the numeric ORGANIZATION_LEVEL of FCLT_ORGANIZATION\"}, \"HR_DEPARTMENT_ID\": {\"desc\": \"Numeric HR department identifier (same value as HR_ORG_UNIT_ID in current data); absent from HR_ORG_UNIT_NEW\"}, \"HR_DEPARTMENT_CODE\": {\"desc\": \"HR department code in 'HR-NNNNNN' format, e.g. 'HR-068100'\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code (numeric part of HR_DEPARTMENT_CODE), e.g. '68100'\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"HR department name, e.g. 'Institute for Data, Systems, and Society'; the HR-side counterpart of academic department names, used for grouping/partitioning organizations by HR department\"}, \"HR_DEPARTMENT_NAME_LONG\": {\"desc\": \"Long form of the HR department name (often identical to HR_DEPARTMENT_NAME)\"}, \"HR_DEPARTMENT_NAME_ALPHA\": {\"desc\": \"Alphabetical-sort variant of the HR department name\"}, \"ORG_HIER_SCHOOL_AREA_NAME\": {\"desc\": \"Name of the school/area the unit belongs to in the organization hierarchy, e.g. 'Schwarzman College of Computing Area', 'VP for Finance Area'\"}, \"ORG_HIER_TOP_LEVEL_NAME\": {\"desc\": \"Name of the top-level area of the unit in the organization hierarchy, e.g. 'Provost Area', 'Executive Vice President Area'\"}, \"ORG_HIER_ROOT_NAME\": {\"desc\": \"Root name of the organization hierarchy, 'MIT-All' for all rows\"}, \"HR_ORG_LEVEL1_ID\": {\"desc\": \"ID of the level-1 node (institute root, '10000000') in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL1_SORT\": {\"desc\": \"Sort order of the level-1 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL1_NAME\": {\"desc\": \"Name of the level-1 node, 'MIT-All'\"}, \"HR_ORG_LEVEL2_ID\": {\"desc\": \"ID of the level-2 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL2_SORT\": {\"desc\": \"Sort order of the level-2 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL2_NAME\": {\"desc\": \"Name of the level-2 node, e.g. 'Provost Area', 'Executive Vice President Area'\"}, \"HR_ORG_LEVEL3_ID\": {\"desc\": \"ID of the level-3 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL3_SORT\": {\"desc\": \"Sort order of the level-3 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL3_NAME\": {\"desc\": \"Name of the level-3 node, e.g. a school/VP area name\"}, \"HR_ORG_LEVEL4_ID\": {\"desc\": \"ID of the level-4 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL4_SORT\": {\"desc\": \"Sort order of the level-4 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL4_NAME\": {\"desc\": \"Name of the level-4 node, e.g. an area/office name\"}, \"HR_ORG_LEVEL5_ID\": {\"desc\": \"ID of the level-5 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL5_SORT\": {\"desc\": \"Sort order of the level-5 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL5_NAME\": {\"desc\": \"Name of the level-5 node, e.g. a department/unit name\"}, \"HR_ORG_LEVEL6_ID\": {\"desc\": \"ID of the level-6 node in the HR organization hierarchy path; null when the path is shallower; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL6_SORT\": {\"desc\": \"Sort order of the level-6 node; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL6_NAME\": {\"desc\": \"Name of the level-6 node; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL7_ID\": {\"desc\": \"ID of the level-7 (deepest) node in the HR organization hierarchy path; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL7_SORT\": {\"desc\": \"Sort order of the level-7 node; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL7_NAME\": {\"desc\": \"Name of the level-7 node; absent from HR_ORG_UNIT_NEW\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key cross-reference, e.g. 'D_IDSS', 'D_OTP'; joins to FCLT_ORGANIZATION.DLC_KEY and MASTER_DEPT_HIERARCHY.DLC_KEY; null for units without a DLC assignment, and one DLC_KEY may appear on multiple HR org unit rows\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name cross-reference, e.g. 'Office of Treasury and Planning'; may differ from the HR unit title; carried only by HR_ORG_UNIT (not HR_ORG_UNIT_NEW); can be used for name-based self-matching of units sharing a DLC\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per HR organization unit\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_4a9d3074f3894ac9849fbf14",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"default_granularity\": \"one row per large space unit matched with its Provost Area HR department rank\", \"desc\": \"For each space unit with a space unit key greater than 100000 that is associated with a department in the \\\"Provost Area\\\", show the space unit code, the organization name, the HR department name, the sum of space unit keys within each warehouse load date group, the HR department code, the school area name, and the rank of the department within its school area based on department code. Present the results ordered by school area name, department rank within school area, and space unit code. Do not return any rounded answers.\", \"id\": \"dw_3342\", \"name\": \"Large Space Units with Provost Area Department School-Area Ranks and Load-Date Key Sums\", \"sql\": \"WITH ProvostDepartments AS ( SELECT t1.HR_DEPARTMENT_CODE, t1.HR_DEPARTMENT_NAME, t1.ORG_HIER_SCHOOL_AREA_NAME, RANK() OVER (PARTITION BY t1.ORG_HIER_SCHOOL_AREA_NAME ORDER BY t1.HR_DEPARTMENT_CODE) AS window_column FROM MASTER_DEPT_HIERARCHY t0 INNER JOIN HR_ORG_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' ), LargeSpaceUnits AS ( SELECT t0.SPACE_UNIT_CODE, t1.ORGANIZATION_NAME, t2.HR_DEPARTMENT_NAME, SUM(t0.SPACE_UNIT_KEY) OVER (PARTITION BY t0.WAREHOUSE_LOAD_DATE ORDER BY t0.SPACE_UNIT_KEY) AS window_column, t2.HR_DEPARTMENT_CODE FROM SPACE_UNIT t0 JOIN FCLT_ORGANIZATION t1 ON t0.DLC_KEY = t1.DLC_KEY JOIN HR_ORG_UNIT t2 ON t1.DLC_KEY = t2.DLC_KEY WHERE t0.SPACE_UNIT_KEY > 100000 ) SELECT lsu.SPACE_UNIT_CODE, lsu.ORGANIZATION_NAME, lsu.HR_DEPARTMENT_NAME, lsu.window_column AS space_unit_sum_within_load_date, pd.HR_DEPARTMENT_CODE, pd.ORG_HIER_SCHOOL_AREA_NAME, pd.window_column AS department_rank_within_school_area FROM LargeSpaceUnits lsu JOIN ProvostDepartments pd ON lsu.HR_DEPARTMENT_CODE = pd.HR_DEPARTMENT_CODE ORDER BY pd.ORG_HIER_SCHOOL_AREA_NAME, pd.window_column, lsu.SPACE_UNIT_CODE;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\"}, {\"default_granularity\": \"one row per Provost Area department hierarchy row matched with a large space unit of the same DLC\", \"desc\": \"For each department in the \\\"Provost Area\\\" with a non-null department code, show the department name, the department's long name, the corresponding hierarchy level 3 name from the master department hierarchy, the row number within a window of 2 preceding and 1 following rows ordered by the department name, and for each matching space unit with a space unit key greater than 100000, show the space unit code, the organization name, the HR department name from the space unit, and the sum of space unit keys within each warehouse load date group ordered by space unit key. Present the results ordered by department name and space unit code. Do not return any rounded answers.\", \"id\": \"dw_3490\", \"name\": \"Provost Area Department Hierarchy Windows Matched with Large Space Unit Load-Date Key Sums\", \"sql\": \"WITH DeptWindowed AS ( SELECT t1.HR_DEPARTMENT_NAME, t1.HR_DEPARTMENT_NAME_LONG, t0.MASTER_DEPT_HIER_LEVEL_3_NAME, ROW_NUMBER() OVER (ORDER BY t1.HR_DEPARTMENT_NAME ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DLC_KEY FROM MASTER_DEPT_HIERARCHY t0 JOIN HR_ORG_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t1.ORG_HIER_TOP_LEVEL_NAME = 'Provost Area' AND t1.HR_DEPARTMENT_CODE IS NOT NULL ), SpaceUnitWindowed AS ( SELECT t0.SPACE_UNIT_CODE, t1.ORGANIZATION_NAME, t2.HR_DEPARTMENT_NAME, SUM(t0.SPACE_UNIT_KEY) OVER (PARTITION BY t0.WAREHOUSE_LOAD_DATE ORDER BY t0.SPACE_UNIT_KEY) AS window_column, t2.DLC_KEY FROM SPACE_UNIT t0 JOIN FCLT_ORGANIZATION t1 ON t0.DLC_KEY = t1.DLC_KEY JOIN HR_ORG_UNIT t2 ON t1.DLC_KEY = t2.DLC_KEY WHERE t0.SPACE_UNIT_KEY > 100000 ) SELECT d.HR_DEPARTMENT_NAME, d.HR_DEPARTMENT_NAME_LONG, d.MASTER_DEPT_HIER_LEVEL_3_NAME, d.window_column AS dept_window_column, s.SPACE_UNIT_CODE, s.ORGANIZATION_NAME, s.HR_DEPARTMENT_NAME AS spaceunit_hr_department_name, s.window_column AS spaceunit_window_column FROM DeptWindowed d JOIN SpaceUnitWindowed s ON d.DLC_KEY = s.DLC_KEY ORDER BY d.HR_DEPARTMENT_NAME, s.SPACE_UNIT_CODE\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\"}, {\"default_granularity\": \"one row per warehouse-load-date space unit rollup row matched with a floor-2 access-level-1 room of the same space unit\", \"desc\": \"For each warehouse load date, list the space unit code, organization name, HR department name, the HR org unit title, the sum of space unit keys within each warehouse load date group (including a grand total row with nulls and the total sum), and for each, show the building room, space usage, space unit name, and the total number of rooms in the same space unit on floor 2 with access level 1 (only including space units with more than 1 such room), for space units with a space unit key greater than 100000. Do not return any rounded answers.\", \"id\": \"dw_3916\", \"name\": \"Large Space Unit Load-Date Key Sum Rollup with Floor-2 Access-Level-1 Room Counts per Space Unit\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.SPACE_UNIT_CODE, t1.ORGANIZATION_NAME, t2.HR_DEPARTMENT_NAME, t0.WAREHOUSE_LOAD_DATE, t2.HR_ORG_UNIT_TITLE, t0.SPACE_UNIT_KEY FROM SPACE_UNIT t0 JOIN FCLT_ORGANIZATION t1 ON t0.DLC_KEY = t1.DLC_KEY JOIN HR_ORG_UNIT t2 ON t1.DLC_KEY = t2.DLC_KEY WHERE t0.SPACE_UNIT_KEY > 100000 ) SELECT inner_cte.WAREHOUSE_LOAD_DATE, inner_cte.SPACE_UNIT_CODE, inner_cte.ORGANIZATION_NAME, inner_cte.HR_DEPARTMENT_NAME, inner_cte.HR_ORG_UNIT_TITLE, SUM(inner_cte.SPACE_UNIT_KEY) AS total_space_unit_keys FROM inner_cte GROUP BY inner_cte.WAREHOUSE_LOAD_DATE, inner_cte.SPACE_UNIT_CODE, inner_cte.ORGANIZATION_NAME, inner_cte.HR_DEPARTMENT_NAME, inner_cte.HR_ORG_UNIT_TITLE WITH ROLLUP HAVING SUM(inner_cte.SPACE_UNIT_KEY) > 0 ORDER BY inner_cte.WAREHOUSE_LOAD_DATE, inner_cte.SPACE_UNIT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t1.BUILDING_ROOM, t1.SPACE_USAGE, t0.SPACE_UNIT, ROW_NUMBER() OVER (ORDER BY t1.BUILDING_ROOM ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column FROM SPACE_UNIT t0 JOIN ZPM_ROOMS_LOAD t1 ON t0.SPACE_UNIT_CODE = t1.SPACE_UNIT_CODE WHERE t1.FLOOR = 2 AND t1.ACCESS_LEVEL = 1 ) SELECT ic.BUILDING_ROOM, ic.SPACE_USAGE, ic.SPACE_UNIT, su_counts.ROOM_COUNT FROM inner_cte ic JOIN ( SELECT t0.SPACE_UNIT, COUNT(*) AS ROOM_COUNT FROM SPACE_UNIT t0 JOIN ZPM_ROOMS_LOAD t1 ON t0.SPACE_UNIT_CODE = t1.SPACE_UNIT_CODE WHERE t1.FLOOR = 2 AND t1.ACCESS_LEVEL = 1 GROUP BY t0.SPACE_UNIT HAVING COUNT(*) > 1 ) su_counts ON ic.SPACE_UNIT = su_counts.SPACE_UNIT ) SELECT s1.WAREHOUSE_LOAD_DATE, s1.SPACE_UNIT_CODE, s1.ORGANIZATION_NAME, s1.HR_DEPARTMENT_NAME, s1.HR_ORG_UNIT_TITLE, s1.total_space_unit_keys, s2.BUILDING_ROOM, s2.SPACE_USAGE, s2.SPACE_UNIT, s2.ROOM_COUNT FROM subq1 s1 JOIN SPACE_UNIT su ON s1.SPACE_UNIT_CODE = su.SPACE_UNIT_CODE JOIN subq2 s2 ON su.SPACE_UNIT = s2.SPACE_UNIT ORDER BY s1.WAREHOUSE_LOAD_DATE, s1.SPACE_UNIT_CODE, s2.BUILDING_ROOM\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\"}, {\"default_granularity\": \"one row per Sloan-area standard-hierarchy department matched with a large space unit of the same DLC\", \"desc\": \"For departments in the \\\"Sloan School of Management\\\" area with a hierarchy type of \\\"Standard Hierarchy\\\", show the department code, department name, the dense rank of each department considering the current and 2 preceding rows ordered by the department's long name, and the corresponding DLC name from the MASTER_DEPT_HIERARCHY table, along with, for each such department, the space unit code, organization name, HR department name from the space unit, the sum of space unit keys within each warehouse load date group, and the HR org unit title for space units with a space unit key greater than 100000, where the department and space unit share the same DLC key. Present the results in the order of department code and space unit code. Do not return any rounded answers.\", \"id\": \"dw_3919\", \"name\": \"Sloan Area Standard-Hierarchy Department Dense Ranks with Large Space Unit Load-Date Key Sums\", \"sql\": \"WITH DeptSloan AS ( WITH inner_cte AS ( SELECT t1.HR_DEPARTMENT_CODE, t1.HR_DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t1.HR_DEPARTMENT_NAME_LONG ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column, t1.DLC_KEY FROM MASTER_DEPT_HIERARCHY t0 JOIN HR_ORG_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.HIERARCHY_TYPE = 'Standard Hierarchy' AND t1.ORG_HIER_SCHOOL_AREA_NAME = 'Sloan School of Management Area' ) SELECT i.HR_DEPARTMENT_CODE, i.HR_DEPARTMENT_NAME, i.window_column, m.DLC_NAME, i.DLC_KEY FROM inner_cte i JOIN MASTER_DEPT_HIERARCHY m ON i.DLC_KEY = m.DLC_KEY ), SpaceUnitSum AS ( WITH inner_cte AS ( SELECT t0.SPACE_UNIT_CODE, t1.ORGANIZATION_NAME, t2.HR_DEPARTMENT_NAME, SUM(t0.SPACE_UNIT_KEY) OVER (PARTITION BY t0.WAREHOUSE_LOAD_DATE ORDER BY t0.SPACE_UNIT_KEY) AS window_column, t1.DLC_KEY FROM SPACE_UNIT t0 JOIN FCLT_ORGANIZATION t1 ON t0.DLC_KEY = t1.DLC_KEY JOIN HR_ORG_UNIT t2 ON t1.DLC_KEY = t2.DLC_KEY WHERE t0.SPACE_UNIT_KEY > 100000 ) SELECT inner_cte.SPACE_UNIT_CODE, inner_cte.ORGANIZATION_NAME, inner_cte.HR_DEPARTMENT_NAME, inner_cte.window_column, t3.HR_ORG_UNIT_TITLE, inner_cte.DLC_KEY FROM inner_cte JOIN HR_ORG_UNIT t3 ON inner_cte.DLC_KEY = t3.DLC_KEY ) SELECT d.HR_DEPARTMENT_CODE, d.HR_DEPARTMENT_NAME, d.window_column AS dept_dense_rank, d.DLC_NAME, s.SPACE_UNIT_CODE, s.ORGANIZATION_NAME, s.HR_DEPARTMENT_NAME AS space_hr_department_name, s.window_column AS space_sum, s.HR_ORG_UNIT_TITLE FROM DeptSloan d JOIN SpaceUnitSum s ON d.DLC_KEY = s.DLC_KEY ORDER BY d.HR_DEPARTMENT_CODE, s.SPACE_UNIT_CODE;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\"}], \"not_found\": []}"
    },
