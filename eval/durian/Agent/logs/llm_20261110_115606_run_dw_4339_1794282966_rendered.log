      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per status-U reserve material of an above-average-enrollment Engineering department\", \"desc\": \"For each department in the School of Engineering where the total number of students enrolled in courses offered by that department is greater than the average total enrollment across all Engineering departments (and the total enrollment is greater than 50), show the department name and total enrollment, and for each such department, show the library reserve material details with material status key equal to 'U', including the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students, as well as the responsible faculty name and the offer department name, for materials offered by that department. The columns should be: department name, total enrollment, library course instructor key, library reserve catalog key, term code, subject ID, tip material key, tip material status key, tip ISBN, subject title, windowed minimum tip material status key, responsible faculty name, and offer department name. Do not return any rounded answers.\", \"entity_type\": \"metric\", \"id\": \"dw_3868\", \"name\": \"Above-Average Engineering Department Enrollments with Status-U Reserve Material and Textbook Details\", \"sql\": \"WITH engineering_dept_enrollment AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) SELECT i.DEPARTMENT_NAME, i.total_enrollment FROM inner_cte i JOIN ( SELECT AVG(total_enrollment) AS avg_enrollment FROM ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) sub ) a ON i.total_enrollment > a.avg_enrollment ), library_reserve_materials AS ( WITH inner_cte AS ( SELECT l.LIBRARY_COURSE_INSTRUCTOR_KEY, l.LIBRARY_RESERVE_CATALOG_KEY, l.TERM_CODE, l.SUBJECT_ID, t.TIP_MATERIAL_KEY, t.TIP_MATERIAL_STATUS_KEY, t.ISBN, s.SUBJECT_TITLE, MIN(t.TIP_MATERIAL_STATUS_KEY) OVER ( ORDER BY s.NUM_ENROLLED_STUDENTS ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column, s.TIP_SUBJECT_OFFERED_KEY FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN TIP_SUBJECT_OFFERED s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE l.LIBRARY_MATERIAL_STATUS_KEY = 'U' ) SELECT inner_cte.LIBRARY_COURSE_INSTRUCTOR_KEY, inner_cte.LIBRARY_RESERVE_CATALOG_KEY, inner_cte.TERM_CODE, inner_cte.SUBJECT_ID, inner_cte.TIP_MATERIAL_KEY, inner_cte.TIP_MATERIAL_STATUS_KEY, inner_cte.ISBN, inner_cte.SUBJECT_TITLE, inner_cte.window_column, s.RESPONSIBLE_FACULTY_NAME, s.OFFER_DEPT_NAME, s.OFFER_DEPT_CODE FROM inner_cte JOIN TIP_SUBJECT_OFFERED s ON inner_cte.TIP_SUBJECT_OFFERED_KEY = s.TIP_SUBJECT_OFFERED_KEY ) SELECT ede.DEPARTMENT_NAME, ede.total_enrollment, lrm.LIBRARY_COURSE_INSTRUCTOR_KEY, lrm.LIBRARY_RESERVE_CATALOG_KEY, lrm.TERM_CODE, lrm.SUBJECT_ID, lrm.TIP_MATERIAL_KEY, lrm.TIP_MATERIAL_STATUS_KEY, lrm.ISBN, lrm.SUBJECT_TITLE, lrm.window_column, lrm.RESPONSIBLE_FACULTY_NAME, lrm.OFFER_DEPT_NAME FROM engineering_dept_enrollment ede JOIN library_reserve_materials lrm ON ede.DEPARTMENT_NAME = lrm.OFFER_DEPT_NAME\"}, {\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per status-U reserve material matched with 2025FA subject\", \"desc\": \"For each library reserve material detail with material status key equal to 'U' and for subjects offered in the term with code '2025FA', show the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title from the subject offered table, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students (only including those where the number of enrolled students is greater than the average across all subjects), the offering department name, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, the offering school name, and the responsible faculty name for each subject. Order the results by offering department and descending number of enrolled students. Do not return any rounded answers.\", \"id\": \"dw_4287\", \"name\": \"Status-U Reserve Materials Above-Average Enrollment Matched with 2025FA Subject Attributes\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT l.LIBRARY_COURSE_INSTRUCTOR_KEY, l.LIBRARY_RESERVE_CATALOG_KEY, l.TERM_CODE, l.SUBJECT_ID, t.TIP_MATERIAL_KEY, t.TIP_MATERIAL_STATUS_KEY, t.ISBN, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, MIN(t.TIP_MATERIAL_STATUS_KEY) OVER ( ORDER BY s.NUM_ENROLLED_STUDENTS ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN TIP_SUBJECT_OFFERED s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE l.LIBRARY_MATERIAL_STATUS_KEY = 'U' ) SELECT LIBRARY_COURSE_INSTRUCTOR_KEY, LIBRARY_RESERVE_CATALOG_KEY, TERM_CODE, SUBJECT_ID, TIP_MATERIAL_KEY, TIP_MATERIAL_STATUS_KEY, ISBN, SUBJECT_TITLE, window_column, NUM_ENROLLED_STUDENTS FROM inner_cte WHERE NUM_ENROLLED_STUDENTS > ( SELECT AVG(NUM_ENROLLED_STUDENTS) FROM TIP_SUBJECT_OFFERED ) ), subq2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TERM_START_DATE, t1.TERM_END_DATE, t2.TERM_PARAMETER, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_students_per_dept, t0.OFFER_SCHOOL_NAME, t0.RESPONSIBLE_FACULTY_NAME FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2025FA' ) SELECT SUBJECT_ID, SUBJECT_TITLE, OFFER_DEPT_NAME, NUM_ENROLLED_STUDENTS, TERM_DESCRIPTION, ACADEMIC_YEAR, TERM_START_DATE, TERM_END_DATE, TERM_PARAMETER, min_enrolled_students_per_dept, OFFER_SCHOOL_NAME, RESPONSIBLE_FACULTY_NAME FROM inner_cte ) SELECT s1.LIBRARY_COURSE_INSTRUCTOR_KEY, s1.LIBRARY_RESERVE_CATALOG_KEY, s1.TERM_CODE, s1.SUBJECT_ID, s1.TIP_MATERIAL_KEY, s1.TIP_MATERIAL_STATUS_KEY, s1.ISBN, s1.SUBJECT_TITLE, s1.window_column, s2.OFFER_DEPT_NAME, s2.TERM_DESCRIPTION, s2.ACADEMIC_YEAR, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.TERM_PARAMETER, s2.min_enrolled_students_per_dept, s2.OFFER_SCHOOL_NAME, s2.RESPONSIBLE_FACULTY_NAME FROM subq1 s1 JOIN subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID ORDER BY s2.OFFER_DEPT_NAME, s1.NUM_ENROLLED_STUDENTS DESC\"}, {\"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per library subject with status-U reserve materials matched with department unit statistics\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\", \"id\": \"dw_3311\", \"name\": \"Status-U Library Subjects with Enrollment Matched with Department Offered-This-Year Unit Dispersion\", \"sql\": \"WITH DeptStats AS ( SELECT scd.DEPARTMENT_NAME, MAX(ccc.total_units) - MIN(ccc.total_units) AS total_units_range, VARIANCE(ccc.total_units) AS total_units_variance, STDDEV(ccc.total_units) AS total_units_stddev FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_SUBJECT_CODE ssc ON scd.COURSE = ssc.SUBJECT_CODE JOIN CIS_COURSE_CATALOG ccc ON ssc.SUBJECT_CODE = ccc.SUBJECT_CODE WHERE ccc.IS_OFFERED_THIS_YEAR = 'Y' AND ccc.total_units IS NOT NULL GROUP BY scd.DEPARTMENT_NAME ORDER BY total_units_range DESC ), SubjectEnroll AS ( SELECT t1.COURSE_NUMBER, t1.COURSE_NUMBER_DESC, t1.NUM_ENROLLED_STUDENTS, t2.LIBRARY_RESERVE_CATALOG_KEY, DENSE_RANK() OVER (PARTITION BY t2.LIBRARY_MATERIAL_STATUS_KEY ORDER BY t2.LIBRARY_MATERIAL_STATUS_KEY) AS window_column, t1.OFFER_DEPT_NAME FROM LIBRARY_SUBJECT_OFFERED t1 JOIN LIBRARY_RESERVE_MATRL_DETAIL t2 ON t1.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.NUM_ENROLLED_STUDENTS > 0 AND t2.LIBRARY_MATERIAL_STATUS_KEY = 'U' ), CombinedResults AS ( SELECT s.COURSE_NUMBER, s.COURSE_NUMBER_DESC, s.NUM_ENROLLED_STUDENTS, s.LIBRARY_RESERVE_CATALOG_KEY, s.window_column, d.DEPARTMENT_NAME, d.total_units_range, d.total_units_variance, d.total_units_stddev FROM SubjectEnroll s JOIN DeptStats d ON s.OFFER_DEPT_NAME = d.DEPARTMENT_NAME ) SELECT * FROM CombinedResults ORDER BY COURSE_NUMBER, COURSE_NUMBER_DESC;\"}], \"not_found\": []}"
