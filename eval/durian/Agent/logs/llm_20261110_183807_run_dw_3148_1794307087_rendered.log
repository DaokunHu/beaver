    {
      "role": "tool",
      "tool_call_id": "call_db4c49fb6fcf4a2a94564216",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"table_id\": \"SIS_DEPARTMENT\", \"table_name\": \"SIS_DEPARTMENT\", \"count\": 68, \"items\": [{\"metric_id\": \"dw_3294\", \"name\": \"Engineering Degree-Granting Courses Dense Rank by Budget Code with Current Term Running Year Sum\", \"category\": \"Course Catalog and Academic Term Comprehensive Analysis\", \"desc\": \"For courses in the School of Engineering that are degree granting, and for academic term parameters where the term indicator is 'C', show the course description, department name, the dense rank of each course considering the current and 2 preceding rows ordered by the department's budget code, the term parameter, the term code, the academic year, and the running sum of academic years within each department ordered by academic year, for cases where the department matches in both sets. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3597\", \"name\": \"Cross-Term Subject Pairs 2019FA Enrollment Windows vs 2009SP Unit Row Numbers\", \"category\": \"Enrollment Analysis\", \"desc\": \"For all pairs of subjects where one is offered in the term '2019FA' with more than 0 enrolled students and the other is in the term '2009SP', show the 2019FA subject title, offer department name, department full name, number of enrolled students, and the average number of enrolled students in a window of 2 preceding and 2 following rows grouped by the school code, along with the 2009SP subject title, department name, total units, and the row number within a window of 2 preceding and 1 following rows ordered by subject title. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3635\", \"name\": \"2024 12-Unit Subjects Matched with Same-Department 2019FA Offerings and Enrollment\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units, and for subjects offered in the term 2019FA from the same department, show the subject code, subject number, subject title, department name, term description, the rank of each 2024 subject within its department ordered by subject code, the 2019FA subject ID, number of enrolled students in 2019FA, department full name, and the row number of each 2019FA subject within its department name group ordered by subject ID. Order the results by department name, subject code, and 2019FA subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3660\", \"name\": \"Engineering Degree-Granting Courses with Fall 2024-2025 Subject Offerings Ranked per Department\", \"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"desc\": \"For courses in the School of Engineering that are degree granting, and for each subject offered in the term with the description \\\"Fall Term 2024-2025\\\" by the same department, show the course description, department name, the dense rank of each course considering the current and 2 preceding rows ordered by the department's budget code, the subject offered key, subject title, offering department name, the term description, and the rank of each subject within its offering department ordered by subject offered key. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3727\", \"name\": \"Engineering Degree-Granting Departments 2021 Subject Counts and TIP Material Totals Union\", \"category\": \"Department Offering and Textbook Material Comprehensive Analysis\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, or for each department that offered more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of tip materials. List the department code, department name, department full name, number of subjects offered, total number of enrolled students, and total number of tip materials in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3985\", \"name\": \"2006FA Department Lecture Unit Sums with 2017JA Enrollment Classification per Subject Code\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"desc\": \"For each subject offered in the academic term with term code '2006FA' in departments that offer more than 5 subjects in that term, show the subject ID, subject title, department name, the sum of lecture units within each grade type group, and the total number of subjects per department for that term. Additionally, for each subject offered by the same department in the term '2017JA', show the number of enrolled students, offering department name, department full name, subject code, subject code description, and whether the number of enrolled students is 'HIGH_ENROLLMENT' (at least 10% greater than the average for that subject code), 'LOW_ENROLLMENT' (at least 10% less than the average for that subject code), or 'AVERAGE'. Present the results ordered by subject ID and subject code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4308\", \"name\": \"2017JA Subjects Enrollment per Subject Code with 2019FA School Running Unit Sums\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, and the minimum number of enrolled students over each subject code group, as well as the school code, school name, department code, school name from department, department phone number, and the highest running sum of total units for any subject within that school in the 2019FA term (where the subject has more than 1 total unit). Order the results by subject code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4387\", \"name\": \"Engineering Departments Above-Average Enrollment with Highest Regular-Term Average Units\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"desc\": \"For each department in the School of Engineering with total student enrollment in its courses greater than the average total enrollment across all Engineering departments (and with total enrollment greater than 50), display the department name, the total number of students enrolled in its courses, and the highest average total units for subjects it has ever offered in a regular academic term, listing the results in descending order of total enrollment. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4473\", \"name\": \"Engineering 6+ Unit Subjects Grade-Type Running Unit Sums with IAP Activity Rollup Counts\", \"category\": \"Subject Offering and IAP Activity Comprehensive Analysis\", \"desc\": \"For subjects offered by departments in the School of Engineering with a total of at least 6 units, show the subject code, subject title, department name, grade type, and the running sum of total units within each grade type, but only include those subjects where the running sum exceeds 12 units within their grade type. For each such subject, also show, for IAP subject activities with a maximum enrollment of at least 10 and that are not cancelled and are associated with the same subject code, the academic term description, activity title, enrollment type, and the total count of such activities (with a grand total row for all activities in each term, where activity title, enrollment type, and subject title are null and the total count is for all activities in that term). Order the results by subject code, academic term description, and activity title. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4650\", \"name\": \"Engineering Degree-Granting Departments 2021 Enrollment per Subject and per TIP Material Ratios\", \"category\": \"Department Offering and Textbook Material Comprehensive Analysis\", \"desc\": \"For each degree-granting department that offered at least one subject in the School of Engineering in 2021 and has more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the total number of tip materials, the average number of enrolled students per subject (rounded to two decimal places), and the ratio of total enrolled students to total tip materials (rounded to two decimal places), listing the results in descending order of the average number of enrolled students per subject.\"}, {\"metric_id\": \"dw_4724\", \"name\": \"Mathematics Library Regular-Term Subjects 3-Row Max Units with Required Material Department Statistics\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4756\", \"name\": \"Department Course Counts with 2022 12-Unit Subjects Having Textbooks\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1393\", \"name\": \"Math Current-Term Unit Dispersion with Degree-Granting Department Course Counts\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1427\", \"name\": \"Math Graduate Degree-Granting Courses Ranked by Admin Department with Spring 2021 Letter-Graded Unit Summary\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each course in the Mathematics department that is degree granting and has a course level of 'G', show the course description, department name, school name, the administrative department name, and the dense rank over the administrative department name ordered by the administrative department name. Additionally, for each administrative department name, include a grand total of the number of such courses in the format of (null, null, null, administrative department name, null, total courses). Also, show the minimum total units, the sum of lecture units, and the number of unique subjects for letter graded Mathematics department subjects offered in the Spring Term 2021, along with the department name and term description (with all other columns as null). Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1618\", \"name\": \"School CIP Categories with Yearly Math IAP Max Enrollment Stddev and Department Phone\", \"category\": \"IAP Activity and Course Catalog Comprehensive Analysis\", \"desc\": \"For each school, what is the school's name, the school's name in the commencement book, the maximum CIP program code among its degree-granting departments' courses (excluding the Mathematics department), the CIP category ('HIGH_CIP', 'LOW_CIP', or 'MEDIUM_CIP'), the academic year, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered by the Mathematics department in that year (considering only years with more than five activities), and the Mathematics department phone number, for schools where the maximum CIP program code is greater than 130000 and the standard deviation (using STDDEV only and never STDDEV_POP) of maximum enrollment is available? Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1692\", \"name\": \"Math Degree-Granting Course Levels Above Average Enrollment with Spring 2021 Letter-Graded Summary\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"desc\": \"For each department name and course level in the Mathematics department (Course 18) where the total number of enrolled students in offered subjects is greater than the average number of enrolled students for that department and the subjects are degree-granting, provide the number of unique courses and the minimum total units among those subjects, along with the term description, the minimum total units, the sum of lecture units, and the number of unique subjects for letter graded Mathematics subjects offered in the Spring Term 2021. List the columns in the following order: department name, course level, number of unique courses, minimum total units from the first set, term description, minimum total units from the second set, sum of lecture units, and number of unique subjects. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3268\", \"name\": \"Union of 2025FA Offered Subjects and Engineering 6+ Unit Subjects with Running Unit Sums\", \"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"desc\": \"List all subjects that are either offered in the term with code '2025FA' or are offered by departments in the School of Engineering with a total of at least 6 units. For each subject, show the subject ID, subject title, department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, the running sum of total units within each school, and the reason for inclusion ('2025FA Subjects' for subjects offered in the term '2025FA' and 'Engineering 6+ Units' for subjects offered by Engineering departments with at least 6 units), ordered by subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3498\", \"name\": \"Union of 2025FA Offered Subjects and 2016SP Degree-Granting Department Subjects with Unit Dense Ranks\", \"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"desc\": \"List all subject IDs that are either offered in the term with code '2025FA' or are offered in the term '2016SP' by departments that grant degrees, along with the subject title, offering department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, and the dense rank considering the current and 2 preceding rows ordered by the total number of units. For subjects from the term '2025FA', show the subject title, offering department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, and the minimum number of enrolled students over each offering department; for subjects from the term '2016SP' by degree-granting departments, show the dense rank as window_column. The results are ordered by subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3684\", \"name\": \"2025FA Engineering Subjects Enrollment Windows with Catalog Unit Row Numbers\", \"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"desc\": \"For subjects offered in the term with code '2025FA' by departments in the School of Engineering, show the subject ID, subject title, offering department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, total units, department full name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title, ordered by offering department name and subject title. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3904\", \"name\": \"Degree-Granting Subject Code Description Status Rollup by School with 2022SU Unit Dense Ranks\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name (from subject code), school name, the number of subject codes per school name and whether the subject code description is present ('Has Description') or missing ('No Description'), and for each matching department in subjects offered in the term with code '2022SU', show the subject's ID, total units, department name (from subject offered), and their dense rank considering the current and 2 preceding rows ordered by the total number of units. For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes, null, null, null, null). Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4229\", \"name\": \"Mathematics IAP Category Activities Matched with Fall-Term Department Enrollment Statistics\", \"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"desc\": \"For IAP subjects in the \\\"Mathematics\\\" category, show the activity title, enrollment type, maximum enrollment, category name, activity description, and the row number within each enrollment type group ordered by activity title, along with the academic year, department name, average enrollment, enrollment variance, department phone number, and school name for each academic year and department where the IAP subject's term matches a department's fall term subject offering with more than 0 enrolled students. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4231\", \"name\": \"Current SIS Term Department Subjects Matched with 2016SP Degree-Granting Department Unit Totals\", \"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"desc\": \"For each department that both offered subjects in the current SIS term and is a degree-granting department that offered subjects in the term '2016SP', list the department code, offering department name, subject title, responsible faculty name, term description, academic year description, total number of subjects offered per department in the current term, department name, number of subjects offered in 2016SP, and total units for those subjects in 2016SP. Include all columns in the order: department code, offering department name, subject title, responsible faculty name, term description, academic year description, total number of subjects offered per department in the current term, department name, number of subjects offered in 2016SP, and total units for those subjects in 2016SP. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4911\", \"name\": \"Top 10 Engineering Subjects by 3-Row Max Enrollment with Catalog Unit Row Numbers\", \"category\": \"Enrollment Analysis\", \"desc\": \"From the top 10 subjects offered by departments in the School of Engineering with the highest maximum enrolled students (considering the current and next 2 rows ordered by subject key), display each subject's title, total units, department full name, row number within a window of 2 preceding and 1 following rows ordered by subject title, subject ID, offer department name, offer school name, term description, academic year, and the department that offered the subject. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1302\", \"name\": \"Engineering Degree-Granting Department 2007 Course Rollup with Department Unit Totals and Latest-Year Course Counts\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each course offered by a degree-granting department in the School of Engineering, except for the Electrical Engineering and Computer Science department, in the 2007 academic year, what is the course key, course name, department name, the number of catalog subjects, the total units for those subjects, and for each department, include a grand total for all courses in the format of (null, null, department name, total subjects, total units)? Additionally, for each such department, what is the total number of units for courses in the \\\"Engineering\\\" or \\\"Non-MIT\\\" schools (where the total units for the department is greater than 1000 and the department is not \\\"Political Science\\\"), and how many distinct courses did the department offer in the most recent academic year available? Present the results as: course key, course name, department name, number of catalog subjects, total units for those subjects, department total units, and number of distinct courses in the latest year, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1335\", \"name\": \"Union of Math 2008 Unit Range-Variance with Long Descriptions and High Average Unit Department Stddev\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"List, for each department, either (a) the department's full name, the range and variance of the total units for degree-granting Mathematics department courses offered in the 2008 academic year along with the long course description for each course (with the reason 'Math 2008 Stats'), or (b) the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units) where the average total units is greater than the overall average across all departments (with the reason 'High Avg Units'). Show the columns in the following order: department name, total units range, total units variance, average total units, standard deviation (using STDDEV only and never STDDEV_POP) of total units, long course description, and reason for inclusion. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1766\", \"name\": \"Math Degree-Granting Course Level Counts with Min Units, Course Options, and Highest Term Average Library Enrollment\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each department name and course level where the course is degree granting, the total units are greater than 6, and the department is Mathematics (Course 18), provide the department name, course level, number of unique courses, minimum total units offered, school name, number of distinct course options available, and the highest average number of enrolled students in any term for courses offered by that department, considering only courses with more than 0 enrolled students and departments whose name is not null. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2210\", \"name\": \"Math Subject Code School Ranks Matched with 2024 Catalog Offerings and Department Min Units\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For each subject code in degree-granting departments where the department is Mathematics, and for subjects offered in the academic year 2024 that are also present in the CIS course catalog and are in the Mathematics department, show the subject code, subject code description, department name, school name, rank of the subject code within each school name group ordered by subject code, subject ID, subject number, subject short title, subject title, lecture units, lab units, total units, grade type, grade rule, the minimum total units value over each department code group, and the subject description from the CIS course catalog, ordered by school name, rank, and subject number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2272\", \"name\": \"Math Department Unit Statistics with Course Level Student Counts and Lecture-Lab Unit Averages\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For the Mathematics department, what is the department name, the average of the total units, the range of the total units, the variance of the total units for courses with total units greater than 0, and for each course level, what is the number of unique students and the minimum CIP program code among their courses, considering only degree-granting departments? Additionally, for each course level, what is the average number of lecture units and the maximum number of lab units for Mathematics courses? Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2335\", \"name\": \"Math Degree-Granting Course Level Counts with Catalog Unit Stddev and Unique Subject Codes\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each department name and course level, where the total number of enrolled students in offered subjects is greater than 10, and the department is Mathematics (Course 18), provide the number of unique courses, the minimum total units among those subjects that are degree-granting courses, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for Mathematics courses (considering only departments that offer more than five courses), and the number of unique subject codes for Mathematics in the SIS_SUBJECT_CODE table. List the department name, course level, number of unique courses, minimum total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the number of unique subject codes, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2365\", \"name\": \"Top 3 Most Offered Math Courses per Term with Description Counts, Min CIP Code, and Department Phone\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For the top 3 most frequently offered courses in the Mathematics department, for each course and each term it was offered, display the course number, course description, subject title, number of times offered, department name, number of unique course descriptions for that course and department, the minimum CIP program code for that course and department, the term code, the term description, the school name, and the department phone number. Do not repeat the course number if it is the same as the previous row. Sort the table by course number and term code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2377\", \"name\": \"Math 2022 Unit Range-Variance with Offered-This-Year Subjects and Responsible Faculty Contact Windows\", \"category\": \"Subject Offering and Faculty Directory Comprehensive Analysis\", \"desc\": \"For each department that is Mathematics (Course 18), provide the department's name, the range and variance of the total units for subjects offered by that department in the academic year 2022 and that are also listed in the CIS course catalog, and for all course subjects in the catalog where the department code is 18 (Mathematics), the department name is 'Mathematics', and the subject is offered this year, show the subject code, subject number, responsible faculty's full name, Moira list member, the average office phone number in a window of 2 preceding and 2 following rows grouped by the responsible faculty's last name and ordered by the subject code, and the email address of the responsible faculty. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3163\", \"name\": \"Degree-Granting Course Level Counts with Min Total Units and Design-Unit Course Counts\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each department name and course level where the course is degree granting and the total units are greater than 6, provide the number of unique courses, the minimum total units offered, and the number of courses where the design units are at least 3. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_104\", \"name\": \"Math 2022 Bulletin-Printed Subject Total Units Deviation from Department Average\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For subjects offered in the academic year 2022 that are printed in the bulletin and belong to the Mathematics department (Course 18), show the subject title, department name, total units, and the difference between the total units of each subject and the average total units for Mathematics subjects in 2022. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1471\", \"name\": \"Math 2024 12-Unit Subjects Ranked by School with Department Unit Dispersion and Communication Intensive Counts\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units in the Mathematics department (Course 18), show the subject code, subject title, department name, school name, and the rank within each school name group ordered by subject code, but only include those subjects whose total units exceed the average total units for their respective school. Additionally, for the Mathematics department, also show the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects that are offered this year, are letter graded, and are in the Mathematics department), as well as the number of subjects that are Communication Intensive (i.e., have a non-null COMM_REQ_ATTRIBUTE), with these statistics included for each subject in the result. Present the columns in the following order: subject code, subject title, department name, school name, rank within school, average total units, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), and number of Communication Intensive subjects. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1758\", \"name\": \"Math 2024 12-Unit Subjects Row Numbers and Unit Deviations Matched with 2019FA TIP Course-Material Offerings\", \"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"desc\": \"For subjects offered in the academic year 2024 with total units equal to 12 in the Mathematics department, show the department code, department name, subject code, subject number, subject title, total units, the row number within each department ordered by subject code, the deviation of each subject's total units from the average total units of all Mathematics subjects offered in 2024, the number of enrolled students, responsible faculty name, school name, and the dense rank over the department name ordered by department name for those subjects that also have course materials and were offered in the term '2019FA'. Sort the table by department name and subject title. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1833\", \"name\": \"Math Letter-Graded Subject Rollup by Grade Type with Organization Room Area Stddev and DLC Name\", \"category\": \"Course Catalog and Facility Space Comprehensive Analysis\", \"desc\": \"For each department and subject grade type where the subject is offered in the current academic year, is letter graded, and the department is Mathematics (Course 18), provide the number of subjects, the minimum total units, the school name, the department phone number, the organization name, the standard deviation (using STDDEV only and never STDDEV_POP) of the areas of its rooms, and the department's DLC name, including subtotals for each department (the corresponding department field is 'SUBTOTAL') and a grand total across all departments (the corresponding department field is 'TOTAL'). Do not repeat the department if it is the same as the previous row. Only include organizations that have more than 5 rooms, are associated with a non-null DLC key, and are not the 'ADMISSIONS' department or the 'Political Science' department. Sort the table by department, grade type, and descending standard deviation (using STDDEV only and never STDDEV_POP) of room areas. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2151\", \"name\": \"Degree-Granting Department 2022 Unit Average-Variance with Political Science HGN Lecture Unit Maximums\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each department that grants degrees (excluding the Biology department), provide the department name, the average and variance of the total units for subjects offered by that department in the 2022 academic year, and, if the department is Political Science, also include for each HGN code the maximum number of lecture units among all subjects in the course catalog and the subject title from the subject offered table for subjects offered in the year 2012 with more than 2 lecture units, as well as the number of enrolled students for those subjects. List the results ordered by the variance of total units in descending order, and for Political Science, by the maximum lecture units in descending order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2158\", \"name\": \"Math 2022 TIP Subjects with Joint-Subject Flag and Letter-Graded Unit Range-Variance\", \"category\": \"Textbook Material and Subject Offering Comprehensive Analysis\", \"desc\": \"For each subject offered in the 2022 academic year by a degree-granting department, specifically in the Department of Mathematics (Course 18) and excluding subjects offered by the Department of Physics, provide the subject ID, subject title, department name, the number of enrolled students, the total number of lecture units, and, for each subject, indicate whether it is also offered as a joint subject with another department. Additionally, show the range and variance of the total units for letter graded subjects offered this year in the Mathematics department. List the results in order of subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2398\", \"name\": \"Department Course Counts with Fall-Only Non-Summer Subject Average TIP Enrollment\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and the average number of enrolled students for each subject in the department, considering only subjects that are offered in the fall term and are not offered in the summer term. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3236\", \"name\": \"Engineering Catalog Subjects Row Numbers Matched with 2017JA TIP Enrollment Windows\", \"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"desc\": \"For subjects offered by departments in the School of Engineering that are also offered in the term '2017JA', show the subject title, total units, department full name, the row number within a window of 2 preceding and 1 following rows ordered by subject title, number of enrolled students, offering department name, department full name for the term, subject code, subject code description, and the minimum number of enrolled students over each subject code group, ordered by subject title and subject code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3668\", \"name\": \"Engineering Catalog Subjects Row Numbers Matched with TIP Material Detail Enrollment Windows\", \"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"desc\": \"For subjects offered by departments in the School of Engineering, show the subject title, total units, department full name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Additionally, for each matching course material detail, provide the material status key, term code, subject ID, ISBN, material key, the course number description, the offering department name, and the maximum number of enrolled students for each row considering the current row and the next 2 rows ordered by material key. The results should include the subject title, total units, department full name, window row number, material status key, term code, subject ID, ISBN, material key, course number description, offering department name, and the maximum number of enrolled students, in that order, for subjects and course materials where the subject title and department code match between the two datasets. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4602\", \"name\": \"Engineering Subjects with Unique Course Material Counts and TIP Material Detail Enrollment Windows\", \"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"desc\": \"Show the department full names, subject titles, total units, and the number of unique course materials per subject for subjects offered by departments in the School of Engineering. For each subject, also provide the material status key, term code, subject ID, ISBN, material key, course number description, offering department name, and the maximum number of enrolled students for each row considering the current row and the next 2 rows ordered by material key, where the subject title and department code match between the subject and course material datasets. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1965\", \"name\": \"2017JA Chemistry TIP Subjects with Course Materials Enrollment Windows and Per-Faculty Max Enrollment\", \"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2017JA' by the Chemistry department (Course 5) that have course materials, show the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code, the subject code, the subject code description, the minimum number of enrolled students over each subject code group ordered by subject code, and the maximum number of enrolled students for each responsible faculty across all their Chemistry subjects in that term. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3356\", \"name\": \"Top 10 Reserved-Material Subjects in 2009SP with Degree-Granting Department Enrollment Variance and Stddev\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', what are the subject title, the offering department name, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only departments that grant degrees and subjects with a non-null subject code description), and the count of reserved materials? Please provide the subject title, the offering department name, the variance, the standard deviation (using STDDEV only and never STDDEV_POP), and the count of reserved materials, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3868\", \"name\": \"Above-Average Engineering Department Enrollments with Status-U Reserve Material and Textbook Details\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For each department in the School of Engineering where the total number of students enrolled in courses offered by that department is greater than the average total enrollment across all Engineering departments (and the total enrollment is greater than 50), show the department name and total enrollment, and for each such department, show the library reserve material details with material status key equal to 'U', including the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students, as well as the responsible faculty name and the offer department name, for materials offered by that department. The columns should be: department name, total enrollment, library course instructor key, library reserve catalog key, term code, subject ID, tip material key, tip material status key, tip ISBN, subject title, windowed minimum tip material status key, responsible faculty name, and offer department name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4458\", \"name\": \"2009SP Status-U Reserve Materials Windowed Faculty Row Numbers with EECS Course Student Directory Details\", \"category\": \"Library Reserve and Student Directory Comprehensive Analysis\", \"desc\": \"For each library reserve material detail with material status key 'U' and term code '2009SP', show the course instructor key, reserve catalog key, subject offered key, the responsible faculty name, and the row number within a window of 2 preceding and 1 following rows ordered by the responsible faculty name from the associated subject offered, and for each matching course in the \\\"Electrical Eng & Computer Sci\\\" department, show the course description, course level, the full name and email address of students enrolled, and the row number within each course level group ordered by the student's last name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1165\", \"name\": \"Library-TIP Matched Subjects by Faculty or Enrollment with Degree-Granting Graduate Department Enrollment Dispersion\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each subject where the responsible faculty MIT ID in the library subject offered table is 928034000 or the number of enrolled students in the tip subject offered table is greater than 5, and where the offer department name in the tip subject offered table is either 'Chemistry' or 'Biology', show the subject title from the library subject offered table, the offer department name from the tip subject offered table, the term code from both tables, the number of enrolled students from both tables, and the minimum number of enrolled students in the tip subject offered table over each master subject ID group. Additionally, for the department offering the subject, show the department name, the range of enrolled students, and the variance of enrolled students in the subjects offered by that department, considering only departments that grant degrees, courses that are at the graduate level, and excluding the Biology department. Present the results ordered by subject title and department name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4812\", \"name\": \"Top 10 Degree-Granting Department Subject Code and Course Number Combinations by Unique Library Subject Count\", \"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_100\", \"name\": \"Top 5 Departments by Graduate Student Average Office Phone with Highest-Phone Student\", \"category\": \"Student Directory Analysis\", \"desc\": \"Among all departments, which are the top 5 departments with the highest average office phone number among graduate students (student year 'G') who have a non-null office phone number? For each of these departments, show the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of office phone numbers, and the full name and office phone number of the graduate student in that department with the highest office phone number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1033\", \"name\": \"Math Graduate Students School Dense Ranks Unioned with Department CIP Code Range-Variance\", \"category\": \"Course Catalog and Student Directory Comprehensive Analysis\", \"desc\": \"Show the department name, department full name, student full name, student email address, dense rank over the school code, CIP program code range, and CIP program code variance for all graduate students in degree-granting Mathematics departments, as well as for all Mathematics departments that are degree granting and have at least one course with a non-null CIP program code, including the CIP program code range and variance for those departments even if they have no such students. List the results ordered by department full name and student full name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1212\", \"name\": \"Math Department Subject Unit Average-Stddev with Graduate Student Count and Latest Load Date\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For the Mathematics department (Course 18), provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student), the number of graduate students in the department, and the most recent warehouse load date for those students, considering only departments that are degree granting and students whose year is 'G'. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1350\", \"name\": \"Degree-Granting Department TIP Enrollment Statistics with School Rollups and Math Peter Student Budget Code Windows\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1474\", \"name\": \"Top 10 Engineering Degree-Granting Department Subject Counts with Kevin EECS Student Course Windows\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For the top 10 degree-granting departments (excluding 'Political Science' and Course 17) that have offered at least one subject in the 'Engineering' school, list the department name, school name, subject code description, the total number of subjects they offered, and the average number of enrolled students per subject, and for each such department, show the full names, email addresses, student years, department full names, course descriptions, course levels, the minimum course level in a window of 3 preceding and 1 following row ordered by the student's last name, and the corresponding subject code and subject code description for each course taken by students named 'Kevin' in 'Electrical Eng & Computer Sci' (Course 6). Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1983\", \"name\": \"EECS Students Windowed Admin Department Phone Averages with Engineering Subject Load Categories\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For students whose department is '6' and whose department name is 'Electrical Eng & Computer Sci', show their first name, last name, department name, student year, the corresponding department's full name, the administrative department name, and the average department phone number in a window of 2 preceding and 2 following rows grouped by the administrative department name and ordered by the student's first name. Additionally, for each subject offered in the 'Engineering' school with total units greater than 0 and only for subjects in the 'Electrical Eng & Computer Sci' department (Course 6), where the student's department matches the subject's offer department code, show the subject title, total units, subject department name, course description, and the dense rank over the offer department code ordered by offer department code. Finally, for each such subject, include the corresponding department's school name and whether the total units are 'HIGH_LOAD' (at least 12), 'LOW_LOAD' (at most 6), or 'MEDIUM_LOAD' (otherwise). Present the columns in the following order: first name, last name, department name, student year, department full name, administrative department name, average department phone number (windowed), subject title, total units, subject department name, course description, dense rank (windowed), department school name, and subject load category. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2240\", \"name\": \"EECS Engineering Subject Max Units and Distinct Student Year Counts per Offer Department\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For each subject offered in the 'Engineering' school with total units greater than 0 and only for subjects in the 'Electrical Eng & Computer Sci' department (Course 6), show the subject title, total units, department name, course description, and dense rank over the offer department code ordered by offer department code, along with the first name, last name, department name, student year, corresponding department's full name, administrative department name, and the average department phone number in a window of 2 preceding and 2 following rows grouped by the administrative department name and ordered by the student's first name, for students whose department is '6' and whose department name is 'Electrical Eng & Computer Sci', where the subject's offer department code matches the student's department. Then, for each offer department code, provide the maximum total units among these subjects and the count of distinct student years among the matched students. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3237\", \"name\": \"2021 Engineering Degree-Granting Department Subject Counts with Active Graduate Student Office Totals\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of active graduate students with an office location assigned in that department. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3969\", \"name\": \"2017JA Subject Enrollment Windows Matched with Above-Average-Last-Name EECS Student Row Numbers\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2017JA', and for students in the \\\"Electrical Eng & Computer Sci\\\" department whose last name is alphabetically after the average last name (in terms of ASCII value) within their course level group, show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, the minimum number of enrolled students over each subject code group, the school name, department phone number, the student's full name, email address, department name, course description, course level, and the student's row number within their course level group ordered by last name. Order the results by subject code, course level, and student row number within course level. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1954\", \"name\": \"2019FA Chemistry TIP Subjects Windowed Min Enrollment with Department Subject Code Statistics\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2019FA' with more than 0 enrolled students, offered by the Chemistry department (Course 5), and only including courses that have course materials, show the subject title, offering department name, school name, department full name, and the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department name. Additionally, for the same department, provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the number of unique subject codes associated with its courses that are offered by degree-granting departments, but only include departments other than 'Mathematics' (Course 18). Also, for each of these departments, show the total number of courses offered by the department in the '2019FA' term that have at least one enrolled student and have course materials. Present the subject title, offering department name, school name, department full name, windowed minimum enrolled students, department name, average number of unique subject codes, standard deviation (using STDDEV only and never STDDEV_POP) of unique subject codes, and the total number of such courses, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2224\", \"name\": \"Math Subject Code School Budget Code Windows with Non-Math Admin Department Clearing Cost Statistics\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each subject code where the department is degree granting and the department is Mathematics, and for each department that is degree granting and is not the Mathematics department (Course 18), show the subject code, subject code description, mathematics department name, school name, the average department budget code within each school, the administrative department name, the average clearing cost collector, the variance of the clearing cost collector, the standard deviation (using STDDEV only and never STDDEV_POP) of the clearing cost collector, and the most recent activity date for the administrative department. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4208\", \"name\": \"2016SP Engineering School Subject Row Numbers Matched with 2017JA TIP Subject Enrollment Windows\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2016SP' with a school code of 'E', and for subjects offered in the term '2017JA', show the subject title, department name, course description, the number of enrolled students in 2016SP, the row number within a window of 2 preceding and 1 following rows ordered by subject title, the number of enrolled students in 2017JA, the offering department name, department full name, subject code, subject code description, the minimum number of enrolled students over each subject code group in 2017JA, the school name, and the department phone number. Order the results by subject title and subject code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3273\", \"name\": \"Engineering 12-Unit Courses Row Numbers with Subject Dense Ranks by Total Units\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For courses in the School of Engineering with a total of 12 units, display the course number, course description, subject title, total units, offering department name, the row number of the course within its offering department ordered by course number, and the dense rank of the subject (considering the current and 2 preceding rows ordered by total units) if available. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3794\", \"name\": \"2019FA TIP Subject Enrollment Windows Matched with Engineering 12-Unit Course Row Numbers\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2019FA' with more than 0 enrolled students, and for courses in the 'Engineering' school with a total of 12 units, show the subject title, offer department name, department full name, number of enrolled students, the average number of enrolled students in a window of 2 preceding and 2 following rows grouped by the school code, the course number, course description, course subject title, total units, course offering department name, and the row number of the course within each offering department ordered by course number, for cases where the subject and course are from the same offering department. Order the results by subject title and course number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3828\", \"name\": \"Engineering Degree-Granting Courses Budget Code Dense Ranks with Subject Code Description Row Numbers\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For courses in the School of Engineering that are degree granting, show the course description, department name, the dense rank of each course considering the current and 2 preceding rows ordered by the department's budget code, the subject code description, and the row number of each course within a window of 2 preceding and 1 following rows ordered by course description. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4234\", \"name\": \"2016SP Degree-Granting Department Subject Rollups Matched with Top-5 Engineering 12-Unit Course Departments\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For each department that grants degrees and offered subjects in the term '2016SP', and is also among the top 5 offering departments in the 'Engineering' school with the most 12-unit courses, list the department code, department name, the number of subjects offered, the total units for those subjects, the offering department name, the number of qualifying 12-unit courses, and the course number and description of the most recently added 12-unit course in each department. For each department, also include a grand total row for the number of subjects and total units in the format (department code, null, total subjects, total units, ...). Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4490\", \"name\": \"Degree-Granting Subject Code Description Status Rollup by School with 2016SP Engineering Subject Row Numbers\", \"category\": \"Course Catalog and Subject Offering Comprehensive Analysis\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name, school name, the number of subject codes per school name, and whether the subject code description is present ('Has Description') or missing ('No Description'). For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes). Additionally, for subjects offered in the term '2016SP' with a school code of 'E', show the subject title, course description, the offering department name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Present all columns in the following order: subject code, subject code description, department name, school name, description status, total subject codes, subject title, course description, offering department name, and window column. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1689\", \"name\": \"School Highest Department Average TIP Enrollment with 2019FA Chemistry Course-Material Subject Dense Ranks\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"desc\": \"For each school, what is the school name and the highest average number of enrolled students per department (among its degree-granting departments, excluding Chemistry, and only considering subjects with at least one enrolled student), and for each subject offered by the Chemistry department in the 2019FA term that has course materials, what is the subject title, the dense rank of the subject considering the current and 2 preceding rows ordered by the number of enrolled students descending, the full name of the offering department, and the school name of the Chemistry department? List the school name and highest average enrolled students per department first, followed by the Chemistry subject title, dense rank, department full name, and Chemistry school name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3644\", \"name\": \"2012SU 1-Unit Subject Row Numbers per Department with Department Offered Summary Unit Average-Stddev\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the 2012SU term with a total of 1 unit, show the subject title from the summary, the course number from the offered table, the subject title from the offered summary, the department name from the summary, the offer department name from the offered summary, the row number within each department name group ordered by subject title from the summary, and for each department, also provide the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student). List the results ordered by department name and row number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4527\", \"name\": \"2021 Engineering Degree-Granting Department Enrollment Dispersion with Above-Average Subject Details\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only subjects with a non-null subject code description), and, for each subject in 2021 offered by these departments in the School of Engineering, list the subject id, subject title, and the number of enrolled students, but only include subjects where the number of enrolled students exceeds the average enrollment for that department in 2021. Do not return any rounded answers.\"}]}"
