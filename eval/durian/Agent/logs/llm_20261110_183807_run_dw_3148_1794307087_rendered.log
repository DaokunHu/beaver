      "tool_call_id": "call_afeb4286526c4ce3a8f49738",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering catalog subject matched with TIP material detail\", \"desc\": \"For subjects offered by departments in the School of Engineering, show the subject title, total units, department full name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Additionally, for each matching course material detail, provide the material status key, term code, subject ID, ISBN, material key, the course number description, the offering department name, and the maximum number of enrolled students for each row considering the current row and the next 2 rows ordered by material key. The results should include the subject title, total units, department full name, window row number, material status key, term code, subject ID, ISBN, material key, course number description, offering department name, and the maximum number of enrolled students, in that order, for subjects and course materials where the subject title and department code match between the two datasets. Do not return any rounded answers.\", \"id\": \"dw_3668\", \"name\": \"Engineering Catalog Subjects Row Numbers Matched with TIP Material Detail Enrollment Windows\", \"sql\": \"WITH Subq1 AS ( SELECT t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t0.DEPARTMENT_FULL_NAME, ROW_NUMBER() OVER (ORDER BY t1.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DEPARTMENT_CODE FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_NAME = 'Engineering' ), Subq2 AS ( SELECT t0.TIP_MATERIAL_STATUS_KEY, t0.TERM_CODE, t0.SUBJECT_ID, t0.ISBN, t0.TIP_MATERIAL_KEY, t1.COURSE_NUMBER_DESC, t1.SUBJECT_TITLE, t1.OFFER_DEPT_NAME, MAX(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t0.TIP_MATERIAL_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_enrolled_students, t1.OFFER_DEPT_CODE FROM TIP_DETAIL t0 JOIN TIP_SUBJECT_OFFERED t1 ON t0.TIP_SUBJECT_OFFERED_KEY = t1.TIP_SUBJECT_OFFERED_KEY WHERE t0.TIP_MATERIAL_STATUS_KEY IS NOT NULL AND t1.NUM_ENROLLED_STUDENTS >= 0 ) SELECT s1.SUBJECT_TITLE, s1.TOTAL_UNITS, s1.DEPARTMENT_FULL_NAME, s1.window_column, s2.TIP_MATERIAL_STATUS_KEY, s2.TERM_CODE, s2.SUBJECT_ID, s2.ISBN, s2.TIP_MATERIAL_KEY, s2.COURSE_NUMBER_DESC, s2.OFFER_DEPT_NAME, s2.max_enrolled_students FROM Subq1 s1 JOIN Subq2 s2 ON s1.DEPARTMENT_CODE = s2.OFFER_DEPT_CODE AND s1.SUBJECT_TITLE = s2.SUBJECT_TITLE\"}, {\"category\": \"Department Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per department\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, or for each department that offered more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of tip materials. List the department code, department name, department full name, number of subjects offered, total number of enrolled students, and total number of tip materials in that order. Do not return any rounded answers.\", \"id\": \"dw_3727\", \"name\": \"Engineering Degree-Granting Departments 2021 Subject Counts and TIP Material Totals Union\", \"sql\": \"WITH DeptSubjects AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), DeptTipMaterials AS ( SELECT s.DEPARTMENT_NAME, SUM(t.RECORD_COUNT) AS total_tip_materials FROM TIP_DETAIL t JOIN ACADEMIC_TERMS a ON t.TERM_CODE = a.TERM_CODE JOIN SUBJECT_SUMMARY s ON a.TERM_CODE = s.TERM_CODE AND t.SUBJECT_ID = s.SUBJECT_ID WHERE s.SCHOOL_NAME = 'Engineering' AND a.IS_REGULAR_TERM = 'Y' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.RECORD_COUNT) > 10 ), CombinedDept AS ( SELECT ds.DEPARTMENT_CODE, ds.DEPARTMENT_NAME, ds.DEPARTMENT_FULL_NAME, ds.subject_count, ds.total_enrollment, dtm.total_tip_materials FROM DeptSubjects ds LEFT JOIN DeptTipMaterials dtm ON ds.DEPARTMENT_NAME = dtm.DEPARTMENT_NAME UNION ALL SELECT NULL AS DEPARTMENT_CODE, dtm.DEPARTMENT_NAME, NULL AS DEPARTMENT_FULL_NAME, NULL AS subject_count, NULL AS total_enrollment, dtm.total_tip_materials FROM DeptTipMaterials dtm LEFT JOIN DeptSubjects ds ON dtm.DEPARTMENT_NAME = ds.DEPARTMENT_NAME WHERE ds.DEPARTMENT_NAME IS NULL ) SELECT * FROM CombinedDept ORDER BY DEPARTMENT_NAME;\"}, {\"id\": \"dw_2591\", \"name\": \"2014FA Enrolled Library Subjects with TIP Material Status and 3-Row Min Total Units\", \"desc\": \"For all subjects in the 2014FA term with at least one enrolled student, show the subject title, offering department name, responsible faculty name, the TIP material status key, the total number of units, and the minimum total number of units in a window of 3 preceding and 1 following row ordered by the course number, along with the cluster type description and the HGN code description for each subject. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT lso.SUBJECT_TITLE, lso.OFFER_DEPT_NAME, lso.RESPONSIBLE_FACULTY_NAME, td.TIP_MATERIAL_STATUS_KEY, sos.TOTAL_UNITS, MIN(sos.TOTAL_UNITS) OVER ( ORDER BY sos.COURSE_NUMBER ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column, sos.SUBJECT_ID FROM LIBRARY_SUBJECT_OFFERED lso JOIN TIP_DETAIL td ON lso.SUBJECT_ID = td.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY sos ON td.SUBJECT_ID = sos.SUBJECT_ID WHERE lso.TERM_CODE = '2014FA' AND lso.NUM_ENROLLED_STUDENTS > 0 ) SELECT inner_cte.SUBJECT_TITLE, inner_cte.OFFER_DEPT_NAME, inner_cte.RESPONSIBLE_FACULTY_NAME, inner_cte.TIP_MATERIAL_STATUS_KEY, inner_cte.TOTAL_UNITS, inner_cte.window_column, sos.CLUSTER_TYPE_DESC, sos.HGN_CODE_DESC FROM inner_cte JOIN SUBJECT_OFFERED_SUMMARY sos ON inner_cte.SUBJECT_ID = sos.SUBJECT_ID AND sos.TERM_CODE = '2014FA'\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2014FA library subject with textbook material matched to its subject offering summary\"}], \"not_found\": []}"
    },
