    {
      "role": "tool",
      "tool_call_id": "call_6fdd34cafd014554bf1f49d6",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"concept_room_space_inventory\", \"name\": \"Room and Space Inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\", \"tables\": [\"SPACE_DETAIL\", \"FCLT_ROOMS\", \"FAC_ROOMS\", \"ZPM_ROOMS_LOAD\"], \"comparisons\": [{\"dimension\": \"Business perspective\", \"differences\": \"SPACE_DETAIL records rooms from the space-assignment perspective (which space unit each room is allocated to, with SPACE_USAGE_KEY usage code); FCLT_ROOMS and FAC_ROOMS record rooms from the facilities inventory perspective (major/minor use descriptions, primary and minor organization occupancy); ZPM_ROOMS_LOAD records rooms from the space-planning load perspective (space usage text, floor, access level, occupying HR org unit).\"}, {\"dimension\": \"Key family and join paths\", \"differences\": \"SPACE_DETAIL joins SPACE_UNIT/SPACE_FLOOR/SPACE_USAGE and FCLT_BUILDING via BUILDING_KEY; FCLT_ROOMS joins FCLT_BUILDING via FCLT_BUILDING_KEY and FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, and is referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE; FAC_ROOMS joins the FAC_* family (FAC_BUILDING, FAC_FLOOR, FAC_ORGANIZATION); ZPM_ROOMS_LOAD joins SPACE_UNIT via SPACE_UNIT_CODE and FCLT_ORGANIZATION/HR_ORG_UNIT via HR_ORG_UNIT_ID (no building/floor keys).\"}, {\"dimension\": \"Area measure and units\", \"differences\": \"SPACE_DETAIL.ROOM_SQUARE_FOOTAGE is in square feet; FCLT_ROOMS.AREA and FAC_ROOMS.AREA are in square meters; ZPM_ROOMS_LOAD carries no area measure at all. Unit choice matters for size thresholds and averages.\"}, {\"dimension\": \"Room counting semantics\", \"differences\": \"SPACE_DETAIL supports counting rooms per space unit or per building via BUILDING_ROOM rows (and ROOM_COUNTER=1 per row); FCLT_BUILDING also carries a precomputed NUM_OF_ROOMS attribute per building, while FCLT_ROOMS/FAC_ROOMS/ZPM_ROOMS_LOAD require COUNT over room rows.\"}, {\"dimension\": \"Usage classification detail\", \"differences\": \"SPACE_DETAIL uses a coded SPACE_USAGE_KEY decoded by SPACE_USAGE; FCLT_ROOMS/FAC_ROOMS carry denormalized MAJOR_USE_DESC/USE_DESC/MINOR_USE_DESC text classifications plus ACCESS_LEVEL and coordinates; ZPM_ROOMS_LOAD carries a free-text SPACE_USAGE (e.g. 'DSGN STUDIO', 'CONF RM') plus ACCESS_LEVEL and a text FLOOR that can hold labels such as 'G9'.\"}], \"decision_guide\": {\"Counting rooms per space unit or finding the building with the most rooms in a space unit\": \"Use SPACE_DETAIL: it is the only table keyed by SPACE_UNIT_KEY, so room counts can be grouped by space unit and by BUILDING_KEY directly.\", \"Room area statistics in square meters, use-classification filters (e.g. classrooms), or linking class meeting places to rooms\": \"Use FCLT_ROOMS: it carries AREA in square meters, denormalized use descriptions, and FCLT_ROOM_KEY referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE.\", \"Room analysis that must stay inside the FAC_* key family (FAC_BUILDING/FAC_FLOOR/FAC_ORGANIZATION)\": \"Use FAC_ROOMS: it mirrors FCLT_ROOMS structure but joins FAC_* family tables via FAC_ROOM_KEY/BUILDING_KEY/ORGANIZATION_KEY.\", \"Room occupancy by organization hierarchy (level, parent organization)\": \"Use FCLT_ROOMS joined to FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, SPACE_DETAIL joined via SPACE_UNIT to SPACE_UNIT.FCLT_ORGANIZATION_KEY when the space-assignment view is required, or ZPM_ROOMS_LOAD joined to FCLT_ORGANIZATION via HR_ORG_UNIT_ID for the space-planning view.\", \"Room analysis by floor, space usage text, or access level linked to space units or HR org units (no area needed)\": \"Use ZPM_ROOMS_LOAD: it links rooms to SPACE_UNIT via SPACE_UNIT_CODE and to organizations/HR units via HR_ORG_UNIT_ID.\"}}, {\"comparisons\": [{\"dimension\": \"Table family\", \"differences\": \"FCLT_MAJOR_USE and FCLT_MAJOR_USE_HIST use FCLT_MAJOR_USE_KEY and join FCLT_ROOMS; FAC_MAJOR_USE uses MAJOR_USE_KEY and joins FAC_ROOMS. The two families must not be mixed in one query.\"}, {\"dimension\": \"Time coverage\", \"differences\": \"FCLT_MAJOR_USE and FAC_MAJOR_USE hold the current classification snapshot (one row per code); FCLT_MAJOR_USE_HIST holds one row per code per fiscal period (FISCAL_PERIOD, e.g. 201505), preserving historical code/description/assignable values.\"}, {\"dimension\": \"Key structure\", \"differences\": \"FCLT_MAJOR_USE_HIST adds a composite FCLT_MAJOR_USE_HIST_KEY ('CODE-PERIOD') and the FISCAL_PERIOD column; the other two tables have only the plain major use key.\"}, {\"dimension\": \"Shared attributes\", \"differences\": \"All three carry MAJOR_USE (short code, e.g. 'CLASSRMS'), DESCRIPTION (e.g. 'CLASSROOMS'), and ASSIGNABLE (1/0 assignable-space flag) with the same value semantics.\"}], \"decision_guide\": {\"Decoding the major use of rooms in the facilities room inventory\": \"Use FCLT_MAJOR_USE joined to FCLT_ROOMS on FCLT_MAJOR_USE_KEY to obtain MAJOR_USE/DESCRIPTION/ASSIGNABLE.\", \"Decoding the major use of rooms in the FAC family room snapshot\": \"Use FAC_MAJOR_USE joined to FAC_ROOMS on MAJOR_USE_KEY.\", \"Analyzing how a room use classification changed over fiscal periods\": \"Use FCLT_MAJOR_USE_HIST filtered by FISCAL_PERIOD; join to FCLT_MAJOR_USE on FCLT_MAJOR_USE_KEY to compare against the current classification.\", \"Filtering rooms to assignable-space use categories\": \"Join the room table to its family's major use lookup and filter ASSIGNABLE = 1.\"}, \"desc\": \"Lookup tables classifying rooms by major use (classrooms, offices, laboratories, residential, circulation, etc.) with a short code, description, and assignable-space flag. They cover the current classification in the FCLT and FAC table families and the fiscal-period historical classification in the FCLT family, jointly answering questions about what a room is primarily used for and whether that use counts as assignable space.\", \"id\": \"concept_room_major_use_classification\", \"name\": \"Room Major Use Classification\", \"tables\": [\"FCLT_MAJOR_USE\", \"FAC_MAJOR_USE\", \"FCLT_MAJOR_USE_HIST\"]}, {\"id\": \"column_concept_num_of_rooms\", \"name\": \"Building Number of Rooms\", \"desc\": \"NUM_OF_ROOMS columns recording how many rooms a building contains, replicated across the current and historical building tables of both families. The building-table columns hold the current room count (one value per building); the history-table columns hold the room count at each fiscal period, used for room-count statistics (average, range, variance, minimum) across a building's history records.\", \"columns\": [\"FCLT_BUILDING.NUM_OF_ROOMS\", \"FCLT_BUILDING_HIST.NUM_OF_ROOMS\", \"FCLT_BUILDING_HIST_1.NUM_OF_ROOMS\", \"FAC_BUILDING.NUM_OF_ROOMS\"], \"comparisons\": [{\"dimension\": \"Time semantics\", \"differences\": \"FCLT_BUILDING/FAC_BUILDING NUM_OF_ROOMS is the current count; FCLT_BUILDING_HIST(_1) NUM_OF_ROOMS is the per-fiscal-period count, so aggregates over it (AVG/MIN/MAX/VARIANCE) describe the building's history records, not its current state.\"}, {\"dimension\": \"Aggregation behavior\", \"differences\": \"Grouping by building over the history column yields one value per fiscal period row; over the building column each building contributes exactly one value.\"}, {\"dimension\": \"Alternative room counting\", \"differences\": \"Instead of these precomputed attributes, room counts can also be derived by COUNT over FCLT_ROOMS rows per FCLT_BUILDING_KEY or over SPACE_DETAIL rows per BUILDING_KEY; the precomputed columns and the counted values may differ.\"}], \"decision_guide\": {\"Questions referencing 'the number of rooms in building history records' or statistics of room counts over history\": \"Use FCLT_BUILDING_HIST.NUM_OF_ROOMS.\", \"Questions about a building's current room count or size filters like 'buildings with more than 100 rooms'\": \"Use FCLT_BUILDING.NUM_OF_ROOMS.\", \"Exact room inventory counts (per use, per organization, per floor)\": \"Count FCLT_ROOMS rows instead of using the precomputed NUM_OF_ROOMS attribute.\"}}], \"not_found\": []}"
