      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"FCLT_BUILDING_HIST_1\", \"name\": \"FCLT_BUILDING_HIST_1\", \"desc\": \"Variant of the historical facilities building snapshot table with the same structure, keys, and coverage as FCLT_BUILDING_HIST (one row per building per fiscal period, FISCAL_PERIOD 201505-201906), differing only in date-column formatting: DATE_BUILT/DATE_ACQUIRED/DATE_OCCUPIED are stored as DD-MON-YY strings (e.g. '25-APR-03') instead of MM/DD/YYYY. Use FCLT_BUILDING_HIST for building history analysis unless the DD-MON-YY date representation is specifically required.\", \"columns\": {\"FCLT_BUILDING_HIST_KEY\": {\"desc\": \"Surrogate key of the historical building record, formatted as '<building key>-<fiscal period>'\"}, \"FISCAL_PERIOD\": {\"desc\": \"Fiscal period of the snapshot in YYYYMM format (201505-201906)\"}, \"FCLT_BUILDING_KEY\": {\"desc\": \"Building identifier key (building number/code); joins to FCLT_BUILDING.FCLT_BUILDING_KEY\"}, \"BUILDING_NUMBER\": {\"desc\": \"Building number as recorded in the fiscal period\"}, \"PARENT_BUILDING_NUMBER\": {\"desc\": \"Parent building number in the fiscal period\"}, \"PARENT_BUILDING_NAME\": {\"desc\": \"Parent building name in the fiscal period\"}, \"PARENT_BUILDING_NAME_LONG\": {\"desc\": \"Long parent building name in the fiscal period\"}, \"BUILDING_NAME_LONG\": {\"desc\": \"Long building name in the fiscal period\"}, \"EXT_GROSS_AREA\": {\"desc\": \"Extended gross area of the building in square meters at the fiscal period\"}, \"ASSIGNABLE_AREA\": {\"desc\": \"Assignable area of the building in square meters at the fiscal period\"}, \"NON_ASSIGNABLE_AREA\": {\"desc\": \"Non-assignable area of the building in square meters at the fiscal period\"}, \"SITE\": {\"desc\": \"Site of the building at the fiscal period, e.g. 'MIT'\"}, \"CAMPUS_SECTOR\": {\"desc\": \"Campus sector at the fiscal period, e.g. 'MAIN GROUP', 'EAST', 'OFFCAMPUS'\"}, \"ACCESS_LEVEL_CODE\": {\"desc\": \"Numeric access level code of the building at the fiscal period (0-2)\"}, \"ACCESS_LEVEL_NAME\": {\"desc\": \"Access level name at the fiscal period\"}, \"BUILDING_TYPE\": {\"desc\": \"Building type at the fiscal period: 'ACADEMIC', 'SERVICE', or 'RESIDENT'\"}, \"OWNERSHIP_TYPE\": {\"desc\": \"Ownership type at the fiscal period: 'OWNED' or 'LEASED'\"}, \"BUILDING_USE\": {\"desc\": \"Primary use of the building at the fiscal period\"}, \"OCCUPANCY_CLASS\": {\"desc\": \"Occupancy classification at the fiscal period\"}, \"BUILDING_HEIGHT\": {\"desc\": \"Building height at the fiscal period (stored as string)\"}, \"COST_CENTER_CODE\": {\"desc\": \"Cost center code at the fiscal period\"}, \"COST_COLLECTOR_KEY\": {\"desc\": \"Cost collector key at the fiscal period\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS) at the fiscal period\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS) at the fiscal period\"}, \"EASTING_X_SPCS\": {\"desc\": \"Easting coordinate (SPCS) at the fiscal period\"}, \"NORTHING_Y_SPCS\": {\"desc\": \"Northing coordinate (SPCS) at the fiscal period\"}, \"BUILDING_SORT\": {\"desc\": \"Sortable building name at the fiscal period\"}, \"BUILDING_NAMED_FOR\": {\"desc\": \"Person the building is named for, at the fiscal period\"}, \"BUILDING_NAME\": {\"desc\": \"Building name at the fiscal period\"}, \"DATE_BUILT\": {\"desc\": \"Date the building was built, stored in DD-MON-YY format (e.g. '25-APR-03'); differs from FCLT_BUILDING_HIST which uses MM/DD/YYYY\"}, \"DATE_ACQUIRED\": {\"desc\": \"Date the building was acquired, stored in DD-MON-YY format; often null\"}, \"DATE_OCCUPIED\": {\"desc\": \"Date the building was first occupied, stored in DD-MON-YY format\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_OF_ROOMS\": {\"desc\": \"Number of rooms in the building at the fiscal period\"}}, \"default_granularity\": \"one row per building per fiscal period\"}, {\"id\": \"FCLT_ROOMS_HIST\", \"name\": \"FCLT_ROOMS_HIST\", \"desc\": \"Historical facilities room table: one row per room per fiscal period (FISCAL_PERIOD in YYYYMM format; current data covers period 201505), preserving each room's identifiers, floor, use classifications, organization assignment, area, access level, and coordinates over time. Fiscal-period counterpart of FCLT_ROOMS; joins to current room records via FCLT_ROOM_KEY and to buildings via FCLT_BUILDING_KEY.\", \"columns\": {\"FCLT_ROOM_HIST_KEY\": {\"desc\": \"Surrogate key of the historical room record, formatted '<room key>-<fiscal period>'\"}, \"FISCAL_PERIOD\": {\"desc\": \"Fiscal period of the room snapshot in YYYYMM format\"}, \"FCLT_ROOM_KEY\": {\"desc\": \"Key of the corresponding current room record; joins to FCLT_ROOMS.FCLT_ROOM_KEY\"}, \"BUILDING_ROOM\": {\"desc\": \"Combined building-room identifier at the fiscal period, e.g. '1-108'\"}, \"FCLT_BUILDING_KEY\": {\"desc\": \"Building identifier key of the room at the fiscal period; joins to FCLT_BUILDING.FCLT_BUILDING_KEY\"}, \"FLOOR\": {\"desc\": \"Floor the room is on at the fiscal period\"}, \"FCLT_FLOOR_KEY\": {\"desc\": \"Floor key at the fiscal period; joins to FCLT_FLOOR.FCLT_FLOOR_KEY\"}, \"ROOM\": {\"desc\": \"Room number/name at the fiscal period\"}, \"SPACE_ID\": {\"desc\": \"Space identifier at the fiscal period\"}, \"FCLT_MAJOR_USE_KEY\": {\"desc\": \"Major use key at the fiscal period; joins to FCLT_MAJOR_USE_HIST for period-specific classification\"}, \"MAJOR_USE_DESC\": {\"desc\": \"Major use description at the fiscal period, e.g. 'OFFICES'\"}, \"FCLT_USE_KEY\": {\"desc\": \"Use key at the fiscal period\"}, \"USE_DESC\": {\"desc\": \"Use description at the fiscal period\"}, \"FCLT_MINOR_USE_KEY\": {\"desc\": \"Minor use key at the fiscal period\"}, \"MINOR_USE_DESC\": {\"desc\": \"Minor use description at the fiscal period\"}, \"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Occupying organization key at the fiscal period; joins to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Occupying organization name/abbreviation at the fiscal period\"}, \"FCLT_MINOR_ORGANIZATION_KEY\": {\"desc\": \"Secondary organization key at the fiscal period\"}, \"MINOR_ORGANIZATION\": {\"desc\": \"Secondary organization name at the fiscal period\"}, \"AREA\": {\"desc\": \"Room area in square meters at the fiscal period\"}, \"ROOM_FULL_NAME\": {\"desc\": \"Full room name at the fiscal period\"}, \"DEPT_CODE\": {\"desc\": \"Department code assigned to the room at the fiscal period\"}, \"ACCESS_LEVEL\": {\"desc\": \"Numeric access level of the room at the fiscal period\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS) at the fiscal period\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS) at the fiscal period\"}, \"NORTHING_SPCS\": {\"desc\": \"Northing coordinate (SPCS) at the fiscal period\"}, \"EASTING_SPCS\": {\"desc\": \"Easting coordinate (SPCS) at the fiscal period\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per room per fiscal period\"}, {\"id\": \"FCLT_MAJOR_USE_HIST\", \"name\": \"FCLT_MAJOR_USE_HIST\", \"desc\": \"Historical facilities major use classification table: one row per major use code per fiscal period (FISCAL_PERIOD, e.g. 201505), preserving the code/description/assignable values of each classification across fiscal periods. Superset of FCLT_MAJOR_USE along the time dimension; use FCLT_MAJOR_USE for the current classification and this table when a specific fiscal period's classification is required.\", \"columns\": {\"FCLT_MAJOR_USE_HIST_KEY\": {\"desc\": \"Composite historical key in 'MAJOR_USE_KEY-FISCAL_PERIOD' format, e.g. '101-201505'\"}, \"FISCAL_PERIOD\": {\"desc\": \"Fiscal period (YYYYMM) of the classification snapshot\"}, \"FCLT_MAJOR_USE_KEY\": {\"desc\": \"Major use key, matching FCLT_MAJOR_USE.FCLT_MAJOR_USE_KEY and FCLT_ROOMS.FCLT_MAJOR_USE_KEY\"}, \"MAJOR_USE\": {\"desc\": \"Short major use code as of the fiscal period\"}, \"DESCRIPTION\": {\"desc\": \"Major use description as of the fiscal period\"}, \"ASSIGNABLE\": {\"desc\": \"1/0 assignable-space flag as of the fiscal period\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per major use code per fiscal period\"}, {\"id\": \"FAC_BUILDING\", \"name\": \"FAC_BUILDING\", \"desc\": \"Facilities building snapshot table (FAC_* family): one row per physical building with the same building attribute structure as FCLT_BUILDING (number/name, type, ownership, use, occupancy class, gross/assignable/non-assignable areas, number of rooms, key dates, site, coordinates) but keyed by FAC_BUILDING_KEY and joining the FAC_* family (FAC_ROOMS, FAC_FLOOR, FAC_BUILDING_ADDRESS, FAC_ORGANIZATION). Used as the building dimension when FAC_* family keys are involved; FCLT_BUILDING is the counterpart in the FCLT_* family.\", \"columns\": {\"DATE_ACQUIRED\": {\"desc\": \"Date the building was acquired\"}, \"DATE_OCCUPIED\": {\"desc\": \"Date the building was first occupied\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_OF_ROOMS\": {\"desc\": \"Number of rooms in the building\"}, \"FAC_BUILDING_KEY\": {\"desc\": \"Surrogate key of the building in the FAC_* family; joins to FAC_ROOMS.BUILDING_KEY, FAC_FLOOR.BUILDING_KEY, FAC_BUILDING_ADDRESS.BUILDING_KEY; same value domain as FCLT_BUILDING.FCLT_BUILDING_KEY (building number)\"}, \"BUILDING_NUMBER\": {\"desc\": \"Building number/code, e.g. '39'\"}, \"PARENT_BUILDING_NUMBER\": {\"desc\": \"Parent building number\"}, \"PARENT_BUILDING_NAME\": {\"desc\": \"Parent building name\"}, \"PARENT_BUILDING_NAME_LONG\": {\"desc\": \"Long parent building name\"}, \"BUILDING_NAME_LONG\": {\"desc\": \"Long building name\"}, \"EXT_GROSS_AREA\": {\"desc\": \"Extended gross area of the building in square meters\"}, \"ASSIGNABLE_AREA\": {\"desc\": \"Total assignable area of the building in square meters\"}, \"NON_ASSIGNABLE_AREA\": {\"desc\": \"Non-assignable area of the building in square meters\"}, \"SITE\": {\"desc\": \"Site of the building, e.g. 'MIT'\"}, \"CAMPUS_SECTOR\": {\"desc\": \"Campus sector the building is in\"}, \"ACCESS_LEVEL_CODE\": {\"desc\": \"Numeric access level code of the building\"}, \"ACCESS_LEVEL_NAME\": {\"desc\": \"Access level name of the building\"}, \"BUILDING_TYPE\": {\"desc\": \"Building type: 'ACADEMIC', 'SERVICE', or 'RESIDENT'\"}, \"OWNERSHIP_TYPE\": {\"desc\": \"Ownership type: 'OWNED' or 'LEASED'\"}, \"BUILDING_USE\": {\"desc\": \"Primary use code of the building\"}, \"OCCUPANCY_CLASS\": {\"desc\": \"Occupancy classification code of the building\"}, \"BUILDING_HEIGHT\": {\"desc\": \"Height of the building\"}, \"COST_CENTER_CODE\": {\"desc\": \"Cost center code of the building\"}, \"COST_COLLECTOR_KEY\": {\"desc\": \"Cost collector key of the building\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS)\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS)\"}, \"EASTING_X_SPCS\": {\"desc\": \"Easting coordinate (SPCS)\"}, \"NORTHING_Y_SPCS\": {\"desc\": \"Northing coordinate (SPCS)\"}, \"BUILDING_SORT\": {\"desc\": \"Sortable building name\"}, \"BUILDING_NAMED_FOR\": {\"desc\": \"Person the building is named for\"}, \"BUILDING_NAME\": {\"desc\": \"Building name, e.g. 'BROWN BUILDING'\"}, \"DATE_BUILT\": {\"desc\": \"Date the building was built\"}}, \"default_granularity\": \"one row per building\"}, {\"id\": \"FAC_ROOMS\", \"name\": \"FAC_ROOMS\", \"desc\": \"Facilities room snapshot table with the same room inventory structure as FCLT_ROOMS (building/floor keys, room identifiers, major/minor use classifications, organization assignment, area, access level, coordinates) but keyed by FAC_ROOM_KEY and joining the FAC_* family (FAC_BUILDING, FAC_FLOOR, FAC_ORGANIZATION). Used as an alternative room source when FAC_* family keys are involved.\", \"columns\": {\"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"FAC_ROOM_KEY\": {\"desc\": \"Surrogate key of the room in the FAC_* family\"}, \"BUILDING_KEY\": {\"desc\": \"Foreign key to FAC_BUILDING.FAC_BUILDING_KEY\"}, \"FLOOR\": {\"desc\": \"Floor the room is on\"}, \"FLOOR_KEY\": {\"desc\": \"Foreign key to FAC_FLOOR.FLOOR_KEY\"}, \"ROOM\": {\"desc\": \"Room number/name\"}, \"SPACE_ID\": {\"desc\": \"Space identifier\"}, \"MAJOR_USE_KEY\": {\"desc\": \"Major use key of the room\"}, \"MAJOR_USE_DESC\": {\"desc\": \"Major use description, e.g. classroom\"}, \"USE_KEY\": {\"desc\": \"Use key of the room\"}, \"USE_DESC\": {\"desc\": \"Use description of the room\"}, \"MINOR_USE_KEY\": {\"desc\": \"Minor use key of the room\"}, \"MINOR_USE_DESC\": {\"desc\": \"Minor use description\"}, \"ORGANIZATION_KEY\": {\"desc\": \"Foreign key to FAC_ORGANIZATION.ORGANIZATION_KEY; organization occupying the room\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Organization name occupying the room\"}, \"MINOR_ORGANIZATION_KEY\": {\"desc\": \"Key of the secondary organization for the room\"}, \"MINOR_ORGANIZATION\": {\"desc\": \"Secondary organization name\"}, \"AREA\": {\"desc\": \"Room area in square meters\"}, \"ROOM_FULL_NAME\": {\"desc\": \"Full room name\"}, \"DEPT_CODE\": {\"desc\": \"Department code assigned to the room\"}, \"ACCESS_LEVEL\": {\"desc\": \"Access level of the room\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS)\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS)\"}, \"NORTHING_SPCS\": {\"desc\": \"Northing coordinate (SPCS)\"}, \"EASTING_SPCS\": {\"desc\": \"Easting coordinate (SPCS)\"}}, \"default_granularity\": \"one row per physical room\"}, {\"id\": \"BUILDINGS\", \"name\": \"BUILDINGS\", \"desc\": \"Space-domain building lookup table: one row per building with building key/number, building name, street and mailing addresses as single text fields, gross and assignable square footage (in square feet), and a building counter. Referenced by SPACE_DETAIL via BUILDING_KEY; a lightweight building reference for space-assignment reporting, without the type/ownership/site classification carried by FCLT_BUILDING or FAC_BUILDING.\", \"columns\": {\"BUILDING_KEY\": {\"desc\": \"Building key (same value as BUILDING_NUMBER, e.g. 'NW32'); joins to SPACE_DETAIL.BUILDING_KEY and matches FCLT_BUILDING.FCLT_BUILDING_KEY value domain\"}, \"BUILDING_NUMBER\": {\"desc\": \"Building number/code, e.g. 'NW35'\"}, \"BUILDING_NAME\": {\"desc\": \"Building name, e.g. 'Ashdown House'; may be a generic 'BUILDING <number>' placeholder\"}, \"BUILDING_STREET_ADDRESS\": {\"desc\": \"Full street address as a single text field, e.g. '235 ALBANY ST'\"}, \"BUILDING_MAILING_ADDRESS\": {\"desc\": \"Mailing address as a single text field; often null\"}, \"BLDG_GROSS_SQUARE_FOOTAGE\": {\"desc\": \"Gross square footage of the building in square feet (note: FCLT_BUILDING.EXT_GROSS_AREA is in square meters)\"}, \"BLDG_ASSIGNABLE_SQUARE_FOOTAGE\": {\"desc\": \"Assignable square footage of the building in square feet\"}, \"BUILDING_COUNTER\": {\"desc\": \"Record counter; equals 1 for every building row\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per building\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_740053b37887480c90af35d5",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_505\", \"name\": \"MIT Academic Building Historical Assignable Area Stddev and Average Non-Assignable Area\", \"desc\": \"For each building, what is the building name, the standard deviation (using STDDEV only and never STDDEV_POP) of the assignable area across its historical records, and the average non-assignable area across its historical records, considering only buildings with more than 3 historical records, with a nonzero assignable area, and that are academic buildings? Additionally, restrict the results to buildings at MIT. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT b.BUILDING_NAME, h.ASSIGNABLE_AREA, h.NON_ASSIGNABLE_AREA FROM FCLT_BUILDING b JOIN FCLT_BUILDING_HIST h ON b.FCLT_BUILDING_KEY = h.FCLT_BUILDING_KEY WHERE h.ASSIGNABLE_AREA > 0 AND b.BUILDING_TYPE = 'ACADEMIC' AND b.SITE = 'MIT' ) SELECT BUILDING_NAME, STDDEV(ASSIGNABLE_AREA) AS assignable_area_stddev, AVG(NON_ASSIGNABLE_AREA) AS avg_non_assignable_area FROM inner_cte GROUP BY BUILDING_NAME HAVING COUNT(*) > 3 ORDER BY assignable_area_stddev DESC;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per building name\"}, {\"id\": \"dw_488\", \"name\": \"MIT Academic Building Use with Largest Room Area Variance and Largest Total Area Building\", \"desc\": \"Among all academic buildings at MIT, which building use type has the largest variance in room area, and what is the name of the building with the largest total room area for that use type? Show the building use, the area variance, and the building name with the largest total room area for that use type. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT b.BUILDING_USE, VARIANCE(r.AREA) AS area_variance, STDDEV(r.AREA) AS area_stddev FROM FCLT_ROOMS r JOIN FCLT_BUILDING_HIST b ON r.FCLT_BUILDING_KEY = b.FCLT_BUILDING_KEY WHERE r.AREA IS NOT NULL AND b.BUILDING_USE IS NOT NULL AND b.BUILDING_TYPE = 'ACADEMIC' AND b.SITE = 'MIT' GROUP BY b.BUILDING_USE ) SELECT ic.BUILDING_USE, ic.area_variance, bh.BUILDING_NAME_LONG AS building_with_largest_area FROM inner_cte ic JOIN ( SELECT b.BUILDING_USE, b.BUILDING_NAME_LONG, SUM(r.AREA) AS total_area, ROW_NUMBER() OVER (PARTITION BY b.BUILDING_USE ORDER BY SUM(r.AREA) DESC) AS rn FROM FCLT_ROOMS r JOIN FCLT_BUILDING_HIST b ON r.FCLT_BUILDING_KEY = b.FCLT_BUILDING_KEY WHERE r.AREA IS NOT NULL AND b.BUILDING_USE IS NOT NULL AND b.BUILDING_TYPE = 'ACADEMIC' AND b.SITE = 'MIT' GROUP BY b.BUILDING_USE, b.BUILDING_NAME_LONG ) bh ON ic.BUILDING_USE = bh.BUILDING_USE AND bh.rn = 1 ORDER BY ic.area_variance DESC LIMIT 1;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row for the building use type with the highest room area variance\"}, {\"id\": \"dw_1190\", \"name\": \"Academic Building Historical Assignable Area Stddev with Room Area Average and Variance\", \"desc\": \"For each building where the building type is 'ACADEMIC', the building is not the Brown Building, and the building has more than 3 historical records, give the building name, the standard deviation (using STDDEV only and never STDDEV_POP) of the assignable area across its historical records, the average area of its rooms, and the variance of the area of its rooms, including only buildings that are academic buildings or have building number '32'. List the results in descending order of the standard deviation (using STDDEV only and never STDDEV_POP) of the assignable area. Do not return any rounded answers.\", \"sql\": \"WITH BuildingAreaStddev AS ( SELECT FCLT_BUILDING.BUILDING_NAME, STDDEV(FCLT_BUILDING_HIST.ASSIGNABLE_AREA) AS assignable_area_stddev FROM FCLT_BUILDING JOIN FCLT_BUILDING_HIST ON FCLT_BUILDING.COST_CENTER_CODE = FCLT_BUILDING_HIST.COST_CENTER_CODE WHERE FCLT_BUILDING.BUILDING_TYPE = 'ACADEMIC' AND FCLT_BUILDING.BUILDING_NAME <> 'BROWN BUILDING' GROUP BY FCLT_BUILDING.BUILDING_NAME HAVING COUNT(*) > 3 ORDER BY assignable_area_stddev DESC ), BuildingRoomStats AS ( SELECT fbh.BUILDING_NAME, AVG(fr.AREA) AS avg_area, VARIANCE(fr.AREA) AS var_area FROM FCLT_BUILDING_HIST fbh JOIN FCLT_ROOMS fr ON fbh.FCLT_BUILDING_KEY = fr.FCLT_BUILDING_KEY WHERE fbh.BUILDING_TYPE = 'ACADEMIC' OR fbh.BUILDING_NUMBER = '32' GROUP BY fbh.BUILDING_NAME ) SELECT bas.BUILDING_NAME, bas.assignable_area_stddev, brs.avg_area, brs.var_area FROM BuildingAreaStddev bas JOIN BuildingRoomStats brs ON bas.BUILDING_NAME = brs.BUILDING_NAME ORDER BY bas.assignable_area_stddev DESC;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per building name\"}, {\"id\": \"dw_126\", \"name\": \"Cambridge Residential Buildings Above Average Gross Area with Address and Historical Room Statistics\", \"desc\": \"For building addresses in the city of CAMBRIDGE that are used as a residence, show the building number from the address, the address purpose, the city, the postal code, the building name, the building type, the building use, the building's gross area, the fiscal period from the building history, the number of rooms from the building history, and the minimum assignable area from the building history over each building key group, but only for those buildings whose gross area is greater than the average gross area of all resident buildings in CAMBRIDGE (excluding buildings named \\\"Ashdown\\\"), ordered by building key. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT fba.BUILDING_NUMBER, fba.ADDRESS_PURPOSE, fba.CITY, fba.POSTAL_CODE, fb.BUILDING_NAME, fb.BUILDING_TYPE, fb.BUILDING_USE, fb.EXT_GROSS_AREA, fbh.FISCAL_PERIOD, fbh.NUM_OF_ROOMS, MIN(fbh.ASSIGNABLE_AREA) OVER (PARTITION BY fb.FCLT_BUILDING_KEY) AS MIN_ASSIGNABLE_AREA, fb.FCLT_BUILDING_KEY FROM FCLT_BUILDING_ADDRESS fba JOIN FCLT_BUILDING fb ON fba.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY JOIN FCLT_BUILDING_HIST fbh ON fb.FCLT_BUILDING_KEY = fbh.FCLT_BUILDING_KEY WHERE fba.CITY = 'CAMBRIDGE' AND fb.BUILDING_TYPE = 'RESIDENT' AND fb.BUILDING_NAME <> 'ASHDOWN HOUSE' ) , avg_area_cte AS ( SELECT AVG(EXT_GROSS_AREA) AS avg_gross_area FROM FCLT_BUILDING fb JOIN FCLT_BUILDING_ADDRESS fba ON fb.FCLT_BUILDING_KEY = fba.FCLT_BUILDING_KEY WHERE fba.CITY = 'CAMBRIDGE' AND fb.BUILDING_TYPE = 'RESIDENT' AND fb.BUILDING_NAME <> 'ASHDOWN HOUSE' ) SELECT i.BUILDING_NUMBER, i.ADDRESS_PURPOSE, i.CITY, i.POSTAL_CODE, i.BUILDING_NAME, i.BUILDING_TYPE, i.BUILDING_USE, i.EXT_GROSS_AREA, i.FISCAL_PERIOD, i.NUM_OF_ROOMS, i.MIN_ASSIGNABLE_AREA FROM inner_cte i CROSS JOIN avg_area_cte a WHERE i.EXT_GROSS_AREA > a.avg_gross_area ORDER BY i.FCLT_BUILDING_KEY;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per building address record matched with each building history fiscal period\"}, {\"id\": \"dw_76\", \"name\": \"Stata Center Floor Assignable and Non-Assignable Area Totals for MIT Academic Buildings with 50+ Historical Rooms\", \"desc\": \"For all buildings on the MIT site that are academic buildings with more than 50 rooms (according to the building history) and are specifically the Ray and Maria Stata Center, list each floor's number, the total assignable area on that floor, and the total non-assignable area, ordered by floor number. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT COUNT(DISTINCT ff.FCLT_FLOOR_KEY) AS num_floors FROM FCLT_FLOOR ff JOIN FCLT_BUILDING fb ON ff.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY JOIN FCLT_BUILDING_HIST fbh ON fb.FCLT_BUILDING_KEY = fbh.FCLT_BUILDING_KEY WHERE fb.SITE = 'MIT' AND fbh.NUM_OF_ROOMS > 50 AND fbh.BUILDING_TYPE = 'ACADEMIC' AND (fb.BUILDING_NAME = 'Ray and Maria Stata Center' OR fb.FCLT_BUILDING_KEY = '32') ) SELECT ff.FLOOR, SUM(ff.ASSIGNABLE_AREA) AS total_assignable_area, SUM(ff.NON_ASSIGNABLE_AREA) AS total_non_assignable_area FROM FCLT_FLOOR ff JOIN FCLT_BUILDING fb ON ff.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY JOIN FCLT_BUILDING_HIST fbh ON fb.FCLT_BUILDING_KEY = fbh.FCLT_BUILDING_KEY WHERE fb.SITE = 'MIT' AND fbh.NUM_OF_ROOMS > 50 AND fbh.BUILDING_TYPE = 'ACADEMIC' AND (fb.BUILDING_NAME = 'Ray and Maria Stata Center' OR fb.FCLT_BUILDING_KEY = '32') GROUP BY ff.FLOOR ORDER BY ff.FLOOR;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per floor of the selected building\"}, {\"id\": \"dw_1357\", \"name\": \"Access Level Campus Sector Room Count Variance Rollup with Fairchild Floor Room Area Statistics\", \"desc\": \"For each access level code and campus sector, what is the access level code, access level name, campus sector, the variance of the number of rooms in the building history for buildings with a nonzero number of rooms, assignable area greater than 0, and that are residential buildings at MIT, as well as, for each floor in the Fairchild Building with access level 1 or 2 and in academic buildings, the floor number, the building's long name, the range and variance of the area of rooms on that floor? Only include buildings that are at MIT. Also, include subtotals for each access level code (the corresponding campus sector field is 'SUBTOTAL') and a grand total across all access level codes (the corresponding campus sector field is 'TOTAL'). Do not repeat the access level code if it is the same as the previous row. Sort the table by access level code, campus sector, and floor. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte1 AS ( SELECT fb.ACCESS_LEVEL_CODE, fb.ACCESS_LEVEL_NAME, fbh.CAMPUS_SECTOR, fbh.NUM_OF_ROOMS FROM FCLT_BUILDING fb JOIN FCLT_BUILDING_HIST fbh ON fb.ACCESS_LEVEL_CODE = fbh.ACCESS_LEVEL_CODE WHERE fbh.NUM_OF_ROOMS > 0 AND fbh.ASSIGNABLE_AREA > 0 AND fbh.BUILDING_TYPE = 'RESIDENT' AND fbh.SITE = 'MIT' ), access_level_variance AS ( SELECT CASE WHEN LAG(ACCESS_LEVEL_CODE) OVER (ORDER BY access_level_code_sort, campus_sector_sort) = ACCESS_LEVEL_CODE THEN NULL ELSE ACCESS_LEVEL_CODE END AS access_level_code, ACCESS_LEVEL_NAME, campus_sector, num_of_rooms_variance, ACCESS_LEVEL_CODE AS join_access_level_code FROM ( SELECT CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 1 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'zzz' ELSE ACCESS_LEVEL_CODE END AS access_level_code_sort, CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 0 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'SUBTOTAL' WHEN GROUPING(ACCESS_LEVEL_CODE) = 1 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'TOTAL' ELSE CAMPUS_SECTOR END AS campus_sector, CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 0 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'zzz' ELSE CAMPUS_SECTOR END AS campus_sector_sort, ACCESS_LEVEL_CODE, MAX(ACCESS_LEVEL_NAME) AS ACCESS_LEVEL_NAME, VARIANCE(NUM_OF_ROOMS) AS num_of_rooms_variance FROM inner_cte1 GROUP BY ACCESS_LEVEL_CODE, CAMPUS_SECTOR WITH ROLLUP ) tbl ORDER BY access_level_code_sort, campus_sector_sort ), inner_cte2 AS ( SELECT fb.BUILDING_NAME_LONG, fr.FCLT_FLOOR_KEY, fr.AREA FROM FCLT_ROOMS fr JOIN FCLT_BUILDING fb ON fr.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY WHERE fr.ACCESS_LEVEL IN (1, 2) AND fb.BUILDING_TYPE = 'ACADEMIC' AND fb.FCLT_BUILDING_KEY = '36' ), floor_area_stats AS ( SELECT f.FLOOR, i.BUILDING_NAME_LONG, MAX(i.AREA) - MIN(i.AREA) AS area_range, VARIANCE(i.AREA) AS area_variance, fb.ACCESS_LEVEL_CODE AS join_access_level_code FROM inner_cte2 i JOIN FCLT_FLOOR f ON i.FCLT_FLOOR_KEY = f.FCLT_FLOOR_KEY JOIN FCLT_BUILDING fb ON fb.BUILDING_NAME_LONG = i.BUILDING_NAME_LONG GROUP BY f.FLOOR, i.BUILDING_NAME_LONG, fb.ACCESS_LEVEL_CODE ) SELECT alv.access_level_code, alv.ACCESS_LEVEL_NAME, alv.campus_sector, alv.num_of_rooms_variance, fas.FLOOR, fas.BUILDING_NAME_LONG, fas.area_range, fas.area_variance FROM access_level_variance alv JOIN floor_area_stats fas ON alv.join_access_level_code = fas.join_access_level_code ORDER BY alv.access_level_code, alv.campus_sector, fas.FLOOR\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per access-level/campus-sector rollup row matched with a floor of the selected academic building\"}, {\"id\": \"dw_12\", \"name\": \"Building Type Ownership Rollup of Historical Room Count Statistics for MIT Non-Residential Buildings\", \"desc\": \"For each building type, show the building type name, the ownership type, and calculate the average, range, and variance of the number of rooms in building history records for buildings of that type and ownership type that are located on the MIT site, but exclude buildings that are classified as residential. For each building type, include a grand total for all ownership types in the format of (building type, null, total statistics). Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT FCLT_BUILDING.BUILDING_TYPE, FCLT_BUILDING.OWNERSHIP_TYPE, FCLT_BUILDING_HIST.NUM_OF_ROOMS FROM FCLT_BUILDING JOIN FCLT_BUILDING_HIST ON FCLT_BUILDING.FCLT_BUILDING_KEY = FCLT_BUILDING_HIST.FCLT_BUILDING_KEY WHERE FCLT_BUILDING_HIST.SITE = 'MIT' AND FCLT_BUILDING.BUILDING_TYPE <> 'RESIDENT' ) SELECT BUILDING_TYPE, OWNERSHIP_TYPE, AVG(NUM_OF_ROOMS) AS avg_num_rooms, MAX(NUM_OF_ROOMS) - MIN(NUM_OF_ROOMS) AS num_rooms_range, VARIANCE(NUM_OF_ROOMS) AS num_rooms_variance FROM inner_cte GROUP BY BUILDING_TYPE, OWNERSHIP_TYPE WITH ROLLUP HAVING BUILDING_TYPE IS NOT NULL ORDER BY BUILDING_TYPE, OWNERSHIP_TYPE\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per building type and ownership type rollup combination\"}, {\"id\": \"dw_2596\", \"name\": \"Top 10 Buildings by Historical Record Count with Building Type and Campus Sector\", \"desc\": \"For the top 10 building names with the highest number of historical records, list the building name, the number of historical records, the building type, and the campus sector. Do not repeat the building name if it is the same as the previous row. Sort the table by the number of historical records in descending order. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT f.BUILDING_NAME, COUNT(h.FCLT_BUILDING_HIST_KEY) AS hist_count FROM FCLT_BUILDING f JOIN FCLT_BUILDING_HIST h ON f.COST_COLLECTOR_KEY = h.COST_COLLECTOR_KEY GROUP BY f.BUILDING_NAME ORDER BY hist_count DESC LIMIT 10 ) SELECT CASE WHEN LAG(inner_cte.BUILDING_NAME) OVER (ORDER BY inner_cte.hist_count DESC, inner_cte.BUILDING_NAME) = inner_cte.BUILDING_NAME THEN NULL ELSE inner_cte.BUILDING_NAME END AS building_name, inner_cte.hist_count, f.BUILDING_TYPE, f.CAMPUS_SECTOR FROM inner_cte LEFT JOIN FCLT_BUILDING f ON inner_cte.BUILDING_NAME = f.BUILDING_NAME ORDER BY inner_cte.hist_count DESC, inner_cte.BUILDING_NAME;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per top-10 building name by history record count\"}], \"not_found\": []}"
