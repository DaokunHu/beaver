            "name": "mysql_query",
            "arguments": "{\"sql\": \"SELECT FCLT_BUILDING_KEY, BUILDING_NAME, BUILDING_TYPE, OWNERSHIP_TYPE, SITE, CAMPUS_SECTOR FROM FCLT_BUILDING WHERE BUILDING_NAME LIKE '%Stata%' OR FCLT_BUILDING_KEY = '32'\"}"
