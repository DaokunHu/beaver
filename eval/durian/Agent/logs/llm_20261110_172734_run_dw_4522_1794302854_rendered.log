      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics library subject in regular terms\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\", \"id\": \"dw_4724\", \"name\": \"Mathematics Library Regular-Term Subjects 3-Row Max Units with Required Material Department Statistics\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t2.SUBJECT_SHORT_TITLE, MAX(t2.TOTAL_UNITS) OVER (ORDER BY t0.SUBJECT_ID ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS MAX_TOTAL_UNITS, t0.SUBJECT_ID, t0.OFFER_DEPT_NAME AS SUB1_OFFER_DEPT_NAME, t0.OFFER_SCHOOL_NAME AS SUB1_OFFER_SCHOOL_NAME, t0.RESPONSIBLE_FACULTY_NAME FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t1.IS_REGULAR_TERM = 'Y' ), Sub2 AS ( SELECT tso.OFFER_DEPT_NAME, tso.OFFER_SCHOOL_NAME, COUNT(DISTINCT tso.SUBJECT_ID) AS subject_count, MIN(sos.TOTAL_UNITS) AS min_total_units FROM TIP_SUBJECT_OFFERED tso JOIN TIP_DETAIL td ON tso.SUBJECT_ID = td.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY sos ON td.SUBJECT_ID = sos.SUBJECT_ID WHERE td.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY tso.OFFER_DEPT_NAME, tso.OFFER_SCHOOL_NAME ) SELECT icte.SUBJECT_TITLE, icte.NUM_ENROLLED_STUDENTS, icte.OFFER_DEPT_NAME, icte.TERM_DESCRIPTION, icte.ACADEMIC_YEAR, icte.SUBJECT_SHORT_TITLE, icte.MAX_TOTAL_UNITS, s2.subject_count, s2.min_total_units, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.SCHOOL_NAME AS school_name, icte.RESPONSIBLE_FACULTY_NAME FROM inner_cte icte LEFT JOIN Sub2 s2 ON icte.SUB1_OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME AND icte.SUB1_OFFER_SCHOOL_NAME = s2.OFFER_SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON icte.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE\"}, {\"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA subject per school\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, and the minimum number of enrolled students over each subject code group, as well as the school code, school name, department code, school name from department, department phone number, and the highest running sum of total units for any subject within that school in the 2019FA term (where the subject has more than 1 total unit). Order the results by subject code. Do not return any rounded answers.\", \"id\": \"dw_4308\", \"name\": \"2017JA Subjects Enrollment per Subject Code with 2019FA School Running Unit Sums\", \"sql\": \"WITH inner_cte1 AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column, t1.SCHOOL_CODE, t1.SCHOOL_NAME, t1.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), cte1 AS ( SELECT inner_cte1.SUBJECT_TITLE, inner_cte1.NUM_ENROLLED_STUDENTS, inner_cte1.OFFER_DEPT_NAME, inner_cte1.DEPARTMENT_FULL_NAME, inner_cte1.SUBJECT_CODE, inner_cte1.SUBJECT_CODE_DESC, inner_cte1.window_column, inner_cte1.SCHOOL_CODE, inner_cte1.SCHOOL_NAME, inner_cte1.DEPARTMENT_CODE, sd.SCHOOL_NAME AS SCHOOL_NAME_DEPT, ad.DEPARTMENT_PHONE_NUMBER FROM inner_cte1 LEFT JOIN SIS_DEPARTMENT sd ON inner_cte1.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), inner_cte2 AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.SCHOOL_CODE, t1.SCHOOL_NAME, SUM(t1.TOTAL_UNITS) OVER (PARTITION BY t1.SCHOOL_CODE ORDER BY t1.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_CODE = '2019FA' AND t1.TOTAL_UNITS > 1 ), cte2 AS ( SELECT SCHOOL_CODE, SCHOOL_NAME, MAX(window_column) AS highest_running_sum_total_units FROM inner_cte2 GROUP BY SCHOOL_CODE, SCHOOL_NAME ) SELECT cte1.SUBJECT_TITLE, cte1.NUM_ENROLLED_STUDENTS, cte1.OFFER_DEPT_NAME, cte1.DEPARTMENT_FULL_NAME, cte1.SUBJECT_CODE, cte1.SUBJECT_CODE_DESC, cte1.window_column, cte1.SCHOOL_CODE, cte1.SCHOOL_NAME, cte1.DEPARTMENT_CODE, cte1.SCHOOL_NAME_DEPT, cte1.DEPARTMENT_PHONE_NUMBER, cte2.highest_running_sum_total_units FROM cte1 JOIN cte2 ON cte1.SCHOOL_CODE = cte2.SCHOOL_CODE ORDER BY cte1.SUBJECT_CODE;\"}], \"not_found\": []}"
