    {
      "role": "tool",
      "tool_call_id": "call_217795e2a5a34bf7b55656ef",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject per source subquery\", \"desc\": \"List all subject titles that are either (a) offered in the term '2022FA' with a total of 12 units, showing the subject title, department name from the course description, and the dense rank of each subject considering the current and 2 preceding rows ordered by the subject code from the course catalog, or (b) for each subject offered, show the subject title, subject ID, offer department name, offer school name, term description, academic year, and the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject key. The results should include all these columns in the following order: subject title, department name, window column, offer department name, offer school name, term description, academic year, and maximum number of enrolled students, with NULLs for columns not relevant to each case. Do not return any rounded answers.\", \"id\": \"dw_3277\", \"name\": \"Union of 2022FA 12-Unit Subjects Dense Rank and Master Section 3-Row Max Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_TITLE, t1.DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t2.SUBJECT_CODE ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column, t2.SUBJECT_ID FROM SUBJECT_OFFERED_SUMMARY t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.COURSE_NUMBER = t1.COURSE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.COURSE = t2.SUBJECT_CODE WHERE t2.TERM_CODE = '2022FA' AND t0.TOTAL_UNITS = 12 ), Subq2 AS ( SELECT t1.SUBJECT_TITLE, t1.SUBJECT_ID, t1.OFFER_DEPT_NAME, t1.OFFER_SCHOOL_NAME, t0.TERM_DESCRIPTION, t0.ACADEMIC_YEAR, MAX(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.SUBJECT_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_enrolled_students FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.IS_MASTER_SECTION = 'Y' AND t0.TERM_STATUS_INDICATOR = 'P' ), CombinedSubjects AS ( SELECT s1.SUBJECT_TITLE, s1.DEPARTMENT_NAME, s1.window_column, NULL AS OFFER_DEPT_NAME, NULL AS OFFER_SCHOOL_NAME, NULL AS TERM_DESCRIPTION, NULL AS ACADEMIC_YEAR, NULL AS max_enrolled_students FROM Subq1 s1 UNION ALL SELECT s2.SUBJECT_TITLE, NULL AS DEPARTMENT_NAME, NULL AS window_column, s2.OFFER_DEPT_NAME, s2.OFFER_SCHOOL_NAME, s2.TERM_DESCRIPTION, s2.ACADEMIC_YEAR, s2.max_enrolled_students FROM Subq2 s2 ) SELECT SUBJECT_TITLE, DEPARTMENT_NAME, window_column, OFFER_DEPT_NAME, OFFER_SCHOOL_NAME, TERM_DESCRIPTION, ACADEMIC_YEAR, max_enrolled_students FROM CombinedSubjects ORDER BY SUBJECT_TITLE;\"}, {\"category\": \"IAP Activity and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per school per academic year\", \"desc\": \"For each school, what is the school's name, the school's name in the commencement book, the maximum CIP program code among its degree-granting departments' courses (excluding the Mathematics department), the CIP category ('HIGH_CIP', 'LOW_CIP', or 'MEDIUM_CIP'), the academic year, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered by the Mathematics department in that year (considering only years with more than five activities), and the Mathematics department phone number, for schools where the maximum CIP program code is greater than 130000 and the standard deviation (using STDDEV only and never STDDEV_POP) of maximum enrollment is available? Do not return any rounded answers.\", \"id\": \"dw_1618\", \"name\": \"School CIP Categories with Yearly Math IAP Max Enrollment Stddev and Department Phone\", \"sql\": \"WITH school_cip AS ( WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, MAX(c.CIP_PROGRAM_CODE) AS max_cip_code, d.DEPARTMENT_FULL_NAME, d.SCHOOL_NAME, d.SCHOOL_CODE FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_CODE <> '18' GROUP BY d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, d.SCHOOL_NAME, d.SCHOOL_CODE HAVING MAX(c.CIP_PROGRAM_CODE) > 120000 ) SELECT i.SCHOOL_NAME, s.SCHOOL_NAME_IN_COMMENCEMENT_BK, MAX(i.max_cip_code) AS school_max_cip_code, CASE WHEN MAX(i.max_cip_code) > 150000 THEN 'HIGH_CIP' WHEN MAX(i.max_cip_code) < 130000 THEN 'LOW_CIP' ELSE 'MEDIUM_CIP' END AS cip_category FROM inner_cte i JOIN SIS_DEPARTMENT s ON i.SCHOOL_CODE = s.SCHOOL_CODE GROUP BY i.SCHOOL_NAME, s.SCHOOL_NAME_IN_COMMENCEMENT_BK ), math_iap_enroll AS ( WITH inner_cte AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, STDDEV_SAMP(isd.MAX_ENROLLMENT) AS stddev_max_enrollment FROM IAP_SUBJECT_DETAIL isd JOIN ACADEMIC_TERMS_ALL ata ON isd.TERM_CODE = ata.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON isd.TERM_CODE = ccso.TERM_CODE WHERE ccso.DEPARTMENT_NAME = 'Mathematics' AND isd.MAX_ENROLLMENT IS NOT NULL GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC HAVING COUNT(isd.MAX_ENROLLMENT) > 5 ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.ACADEMIC_YEAR_DESC, inner_cte.stddev_max_enrollment, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.SCHOOL_NAME AS school_name FROM inner_cte LEFT JOIN SIS_DEPARTMENT sd ON sd.DEPARTMENT_NAME = 'Mathematics' LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ORDER BY inner_cte.ACADEMIC_YEAR ) SELECT sc.SCHOOL_NAME, sc.SCHOOL_NAME_IN_COMMENCEMENT_BK, sc.school_max_cip_code, sc.cip_category, mie.ACADEMIC_YEAR, mie.ACADEMIC_YEAR_DESC, mie.stddev_max_enrollment, mie.department_phone FROM school_cip sc JOIN math_iap_enroll mie ON sc.SCHOOL_NAME = mie.school_name WHERE sc.school_max_cip_code > 130000 AND mie.stddev_max_enrollment IS NOT NULL ORDER BY sc.SCHOOL_NAME, mie.ACADEMIC_YEAR;\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject code row or per 2012SU cluster-S subject row\", \"desc\": \"Show, for each subject, the subject code, subject code description, department name, subject title, and the dense rank of each row partitioned by the school code and ordered by school code for subjects where the school code is not null and the subject title is not null; and for subjects offered in the 2012SU term with a cluster type of 'S', show the subject title from SUBJECT_OFFERED, the offer department name, the total units from SUBJECT_SUMMARY, and assign row numbers within a window of 2 preceding and 1 following rows ordered by the subject title. Indicate the source of each row as either 'Subq1' or 'Subq2'. List all results together, showing the columns: subject code, subject code description, department name, subject title, dense rank by school, offer department name, total units, row number window, and source, in that order, ordered by subject title. Do not return any rounded answers.\", \"id\": \"dw_3590\", \"name\": \"Union of Subject Code School Dense Ranks and 2012SU Cluster-S Subject Unit Row Numbers\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SUBJECT_TITLE, DENSE_RANK() OVER (PARTITION BY t0.SCHOOL_CODE ORDER BY t0.SCHOOL_CODE) AS window_column, t1.SUBJECT_ID FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL ), Subq2 AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TOTAL_UNITS, ROW_NUMBER() OVER (ORDER BY t0.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t0.SUBJECT_ID FROM SUBJECT_OFFERED t0 JOIN SUBJECT_SUMMARY t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.TERM_CODE = '2012SU' AND t1.CLUSTER_TYPE = 'S' ), CombinedSubjects AS ( SELECT s1.SUBJECT_CODE, s1.SUBJECT_CODE_DESC, s1.DEPARTMENT_NAME, s1.SUBJECT_TITLE, s1.window_column AS dense_rank_by_school, NULL AS OFFER_DEPT_NAME, NULL AS TOTAL_UNITS, NULL AS row_number_window, 'Subq1' AS Source FROM Subq1 s1 UNION ALL SELECT NULL AS SUBJECT_CODE, NULL AS SUBJECT_CODE_DESC, NULL AS DEPARTMENT_NAME, s2.SUBJECT_TITLE, NULL AS dense_rank_by_school, s2.OFFER_DEPT_NAME, s2.TOTAL_UNITS, s2.window_column AS row_number_window, 'Subq2' AS Source FROM Subq2 s2 ) SELECT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SUBJECT_TITLE, dense_rank_by_school, OFFER_DEPT_NAME, TOTAL_UNITS, row_number_window, Source FROM CombinedSubjects ORDER BY SUBJECT_TITLE;\"}], \"not_found\": []}"
