    {
      "role": "tool",
      "tool_call_id": "call_34cacf28b90f4bd1af088714",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"table_id\": \"SIS_ADMIN_DEPARTMENT\", \"table_name\": \"SIS_ADMIN_DEPARTMENT\", \"count\": 16, \"items\": [{\"metric_id\": \"dw_4308\", \"name\": \"2017JA Subjects Enrollment per Subject Code with 2019FA School Running Unit Sums\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, and the minimum number of enrolled students over each subject code group, as well as the school code, school name, department code, school name from department, department phone number, and the highest running sum of total units for any subject within that school in the 2019FA term (where the subject has more than 1 total unit). Order the results by subject code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4724\", \"name\": \"Mathematics Library Regular-Term Subjects 3-Row Max Units with Required Material Department Statistics\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1393\", \"name\": \"Math Current-Term Unit Dispersion with Degree-Granting Department Course Counts\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1427\", \"name\": \"Math Graduate Degree-Granting Courses Ranked by Admin Department with Spring 2021 Letter-Graded Unit Summary\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each course in the Mathematics department that is degree granting and has a course level of 'G', show the course description, department name, school name, the administrative department name, and the dense rank over the administrative department name ordered by the administrative department name. Additionally, for each administrative department name, include a grand total of the number of such courses in the format of (null, null, null, administrative department name, null, total courses). Also, show the minimum total units, the sum of lecture units, and the number of unique subjects for letter graded Mathematics department subjects offered in the Spring Term 2021, along with the department name and term description (with all other columns as null). Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1618\", \"name\": \"School CIP Categories with Yearly Math IAP Max Enrollment Stddev and Department Phone\", \"category\": \"IAP Activity and Course Catalog Comprehensive Analysis\", \"desc\": \"For each school, what is the school's name, the school's name in the commencement book, the maximum CIP program code among its degree-granting departments' courses (excluding the Mathematics department), the CIP category ('HIGH_CIP', 'LOW_CIP', or 'MEDIUM_CIP'), the academic year, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered by the Mathematics department in that year (considering only years with more than five activities), and the Mathematics department phone number, for schools where the maximum CIP program code is greater than 130000 and the standard deviation (using STDDEV only and never STDDEV_POP) of maximum enrollment is available? Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4229\", \"name\": \"Mathematics IAP Category Activities Matched with Fall-Term Department Enrollment Statistics\", \"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"desc\": \"For IAP subjects in the \\\"Mathematics\\\" category, show the activity title, enrollment type, maximum enrollment, category name, activity description, and the row number within each enrollment type group ordered by activity title, along with the academic year, department name, average enrollment, enrollment variance, department phone number, and school name for each academic year and department where the IAP subject's term matches a department's fall term subject offering with more than 0 enrolled students. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2365\", \"name\": \"Top 3 Most Offered Math Courses per Term with Description Counts, Min CIP Code, and Department Phone\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For the top 3 most frequently offered courses in the Mathematics department, for each course and each term it was offered, display the course number, course description, subject title, number of times offered, department name, number of unique course descriptions for that course and department, the minimum CIP program code for that course and department, the term code, the term description, the school name, and the department phone number. Do not repeat the course number if it is the same as the previous row. Sort the table by course number and term code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1833\", \"name\": \"Math Letter-Graded Subject Rollup by Grade Type with Organization Room Area Stddev and DLC Name\", \"category\": \"Course Catalog and Facility Space Comprehensive Analysis\", \"desc\": \"For each department and subject grade type where the subject is offered in the current academic year, is letter graded, and the department is Mathematics (Course 18), provide the number of subjects, the minimum total units, the school name, the department phone number, the organization name, the standard deviation (using STDDEV only and never STDDEV_POP) of the areas of its rooms, and the department's DLC name, including subtotals for each department (the corresponding department field is 'SUBTOTAL') and a grand total across all departments (the corresponding department field is 'TOTAL'). Do not repeat the department if it is the same as the previous row. Only include organizations that have more than 5 rooms, are associated with a non-null DLC key, and are not the 'ADMISSIONS' department or the 'Political Science' department. Sort the table by department, grade type, and descending standard deviation (using STDDEV only and never STDDEV_POP) of room areas. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_100\", \"name\": \"Top 5 Departments by Graduate Student Average Office Phone with Highest-Phone Student\", \"category\": \"Student Directory Analysis\", \"desc\": \"Among all departments, which are the top 5 departments with the highest average office phone number among graduate students (student year 'G') who have a non-null office phone number? For each of these departments, show the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of office phone numbers, and the full name and office phone number of the graduate student in that department with the highest office phone number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1212\", \"name\": \"Math Department Subject Unit Average-Stddev with Graduate Student Count and Latest Load Date\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For the Mathematics department (Course 18), provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student), the number of graduate students in the department, and the most recent warehouse load date for those students, considering only departments that are degree granting and students whose year is 'G'. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1983\", \"name\": \"EECS Students Windowed Admin Department Phone Averages with Engineering Subject Load Categories\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For students whose department is '6' and whose department name is 'Electrical Eng & Computer Sci', show their first name, last name, department name, student year, the corresponding department's full name, the administrative department name, and the average department phone number in a window of 2 preceding and 2 following rows grouped by the administrative department name and ordered by the student's first name. Additionally, for each subject offered in the 'Engineering' school with total units greater than 0 and only for subjects in the 'Electrical Eng & Computer Sci' department (Course 6), where the student's department matches the subject's offer department code, show the subject title, total units, subject department name, course description, and the dense rank over the offer department code ordered by offer department code. Finally, for each such subject, include the corresponding department's school name and whether the total units are 'HIGH_LOAD' (at least 12), 'LOW_LOAD' (at most 6), or 'MEDIUM_LOAD' (otherwise). Present the columns in the following order: first name, last name, department name, student year, department full name, administrative department name, average department phone number (windowed), subject title, total units, subject department name, course description, dense rank (windowed), department school name, and subject load category. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2240\", \"name\": \"EECS Engineering Subject Max Units and Distinct Student Year Counts per Offer Department\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For each subject offered in the 'Engineering' school with total units greater than 0 and only for subjects in the 'Electrical Eng & Computer Sci' department (Course 6), show the subject title, total units, department name, course description, and dense rank over the offer department code ordered by offer department code, along with the first name, last name, department name, student year, corresponding department's full name, administrative department name, and the average department phone number in a window of 2 preceding and 2 following rows grouped by the administrative department name and ordered by the student's first name, for students whose department is '6' and whose department name is 'Electrical Eng & Computer Sci', where the subject's offer department code matches the student's department. Then, for each offer department code, provide the maximum total units among these subjects and the count of distinct student years among the matched students. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3969\", \"name\": \"2017JA Subject Enrollment Windows Matched with Above-Average-Last-Name EECS Student Row Numbers\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2017JA', and for students in the \\\"Electrical Eng & Computer Sci\\\" department whose last name is alphabetically after the average last name (in terms of ASCII value) within their course level group, show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, the minimum number of enrolled students over each subject code group, the school name, department phone number, the student's full name, email address, department name, course description, course level, and the student's row number within their course level group ordered by last name. Order the results by subject code, course level, and student row number within course level. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1954\", \"name\": \"2019FA Chemistry TIP Subjects Windowed Min Enrollment with Department Subject Code Statistics\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2019FA' with more than 0 enrolled students, offered by the Chemistry department (Course 5), and only including courses that have course materials, show the subject title, offering department name, school name, department full name, and the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department name. Additionally, for the same department, provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the number of unique subject codes associated with its courses that are offered by degree-granting departments, but only include departments other than 'Mathematics' (Course 18). Also, for each of these departments, show the total number of courses offered by the department in the '2019FA' term that have at least one enrolled student and have course materials. Present the subject title, offering department name, school name, department full name, windowed minimum enrolled students, department name, average number of unique subject codes, standard deviation (using STDDEV only and never STDDEV_POP) of unique subject codes, and the total number of such courses, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2224\", \"name\": \"Math Subject Code School Budget Code Windows with Non-Math Admin Department Clearing Cost Statistics\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each subject code where the department is degree granting and the department is Mathematics, and for each department that is degree granting and is not the Mathematics department (Course 18), show the subject code, subject code description, mathematics department name, school name, the average department budget code within each school, the administrative department name, the average clearing cost collector, the variance of the clearing cost collector, the standard deviation (using STDDEV only and never STDDEV_POP) of the clearing cost collector, and the most recent activity date for the administrative department. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4208\", \"name\": \"2016SP Engineering School Subject Row Numbers Matched with 2017JA TIP Subject Enrollment Windows\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2016SP' with a school code of 'E', and for subjects offered in the term '2017JA', show the subject title, department name, course description, the number of enrolled students in 2016SP, the row number within a window of 2 preceding and 1 following rows ordered by subject title, the number of enrolled students in 2017JA, the offering department name, department full name, subject code, subject code description, the minimum number of enrolled students over each subject code group in 2017JA, the school name, and the department phone number. Order the results by subject title and subject code. Do not return any rounded answers.\"}]}"
