          "function": {
            "name": "submit_SQL",
            "arguments": "{\"sql\": \"WITH TopSubjects_base AS (\\n    SELECT s.SUBJECT_TITLE,\\n           s.DEPARTMENT_NAME,\\n           COUNT(t.TIP_MATERIAL_KEY) AS MATERIAL_COUNT\\n    FROM TIP_DETAIL t\\n    JOIN ACADEMIC_TERMS a ON t.TERM_CODE = a.TERM_CODE\\n    JOIN SUBJECT_SUMMARY s ON a.TERM_CODE = s.TERM_CODE AND t.SUBJECT_ID = s.SUBJECT_ID\\n    WHERE a.IS_REGULAR_TERM = 'Y'\\n    GROUP BY s.SUBJECT_TITLE, s.DEPARTMENT_NAME\\n    ORDER BY MATERIAL_COUNT DESC\\n    LIMIT 10\\n),\\nTopSubjects AS (\\n    SELECT b.SUBJECT_TITLE,\\n           b.DEPARTMENT_NAME,\\n           b.MATERIAL_COUNT,\\n           sd.SCHOOL_NAME,\\n           ad.DEPARTMENT_PHONE_NUMBER\\n    FROM TopSubjects_base b\\n    LEFT JOIN SIS_DEPARTMENT sd ON b.DEPARTMENT_NAME = sd.DEPARTMENT_NAME\\n    LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE\\n),\\nSubjects2014FA_inner AS (\\n    SELECT lso.SUBJECT_TITLE,\\n           lso.OFFER_DEPT_NAME,\\n           lso.RESPONSIBLE_FACULTY_NAME,\\n           td.TIP_MATERIAL_STATUS_KEY,\\n           sos.TOTAL_UNITS,\\n           MIN(sos.TOTAL_UNITS) OVER (\\n               ORDER BY sos.COURSE_NUMBER\\n               ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING\\n           ) AS window_column\\n    FROM LIBRARY_SUBJECT_OFFERED lso\\n    JOIN TIP_DETAIL td ON lso.SUBJECT_ID = td.SUBJECT_ID\\n    JOIN SUBJECT_OFFERED_SUMMARY sos ON td.SUBJECT_ID = sos.SUBJECT_ID\\n    WHERE lso.TERM_CODE = '2014FA'\\n      AND lso.NUM_ENROLLED_STUDENTS > 0\\n),\\nSubjects2014FA AS (\\n    SELECT i.SUBJECT_TITLE,\\n           i.OFFER_DEPT_NAME,\\n           i.RESPONSIBLE_FACULTY_NAME,\\n           i.TIP_MATERIAL_STATUS_KEY,\\n           i.TOTAL_UNITS,\\n           i.window_column,\\n           sd.SCHOOL_NAME,\\n           ad.DEPARTMENT_PHONE_NUMBER\\n    FROM Subjects2014FA_inner i\\n    LEFT JOIN SIS_DEPARTMENT sd ON i.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME\\n    LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE\\n)\\nSELECT ts.SUBJECT_TITLE,\\n       ts.DEPARTMENT_NAME,\\n       ts.MATERIAL_COUNT,\\n       NULL AS OFFER_DEPT_NAME,\\n       NULL AS RESPONSIBLE_FACULTY_NAME,\\n       NULL AS TIP_MATERIAL_STATUS_KEY,\\n       NULL AS TOTAL_UNITS,\\n       NULL AS window_column,\\n       ts.SCHOOL_NAME,\\n       ts.DEPARTMENT_PHONE_NUMBER,\\n       'TopSubjects' AS reason\\nFROM TopSubjects ts\\nUNION ALL\\nSELECT s.SUBJECT_TITLE,\\n       NULL AS DEPARTMENT_NAME,\\n       NULL AS MATERIAL_COUNT,\\n       s.OFFER_DEPT_NAME,\\n       s.RESPONSIBLE_FACULTY_NAME,\\n       s.TIP_MATERIAL_STATUS_KEY,\\n       s.TOTAL_UNITS,\\n       s.window_column,\\n       s.SCHOOL_NAME,\\n       s.DEPARTMENT_PHONE_NUMBER,\\n       'Subjects2014FA' AS reason\\nFROM Subjects2014FA s\\nORDER BY reason, SUBJECT_TITLE;\"}"
