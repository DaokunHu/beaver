    {
      "role": "tool",
      "tool_call_id": "call_fd333244562e43cda8405f33",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 60, \"items_by_type\": {\"table\": [{\"id\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\"}, {\"id\": \"LIBRARY_SUBJECT_OFFERED\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\"}, {\"id\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\"}, {\"id\": \"SUBJECT_OFFERED\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\"}, {\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\"}, {\"id\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"desc\": \"Library reserve material detail bridge table linking reserve catalog items, library subject offerings, course instructors, and material status per term. Used to count reserved materials per subject and to filter by library material status (e.g. 'U').\"}, {\"id\": \"TIP_DETAIL\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\"}, {\"id\": \"SUBJECT_ENROLLABLE\", \"desc\": \"11 columns in total\"}, {\"id\": \"DRUPAL_COURSE_CATALOG\", \"desc\": \"Drupal-sourced course catalog table: an alternative catalog feed with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags, section flags, meeting time/place), plus subject-offering reference columns (SO_SUBJECT_ID, SO_TERM_CODE, SO_TERM_DESCRIPTION, SO_CLUSTER_TYPE) linking catalog records to registrar subject offerings.\"}, {\"id\": \"CIS_COURSE_CATALOG\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\"}, {\"id\": \"STUDENT_DEGREE_PROGRAM\", \"desc\": \"19 columns in total\"}, {\"id\": \"IAP_SUBJECT_CATEGORY\", \"desc\": \"IAP subject category lookup table with category name and description. Referenced by IAP_SUBJECT_DETAIL via IAP_SUBJECT_CATEGORY_KEY.\"}, {\"id\": \"SIS_SUBJECT_CODE\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\"}, {\"id\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\"}], \"metric\": [{\"id\": \"dw_3224\", \"desc\": \"List all subjects from the term \\\"2010FA\\\" and all subjects offered in the term with code \\\"2025FA\\\", showing for each row: subject ID, term description, material status key, academic year, rank of the subject within each academic year group ordered by subject ID, subject title, offering department name, number of enrolled students, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, and the source term (\\\"2010FA\\\" or \\\"2025FA\\\"). The columns should appear in the following order: subject ID, term description, material status key, academic year, rank, subject title, offering department name, number of enrolled students, term start date, term end date, term parameter, minimum enrolled students per department, and source term. Order the results by subject ID and source term. Do not return any rounded answers.\"}, {\"id\": \"dw_3393\", \"desc\": \"For subjects with at least 5 enrolled students that are offered by the library in the term with code '2014FA', show the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, row number within each material status group ordered by subject ID, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, ordered by offering department name, material status key, and subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_3911\", \"desc\": \"For each subject offered by the library in the term with code '2014FA', show the subject ID, subject title, total number of enrolled students, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, as well as the maximum windowed average record count from tip detail records with material status key 'RQ' (using a window of 2 preceding and 2 following rows grouped by financial aid year). Additionally, for each offering department, include a grand total row showing the total number of enrolled students across all its subjects (with nulls for subject ID and subject title), and the corresponding maximum windowed average record count if available. Order the results by offering department name and subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_3436\", \"desc\": \"List all subjects with at least 5 enrolled students, showing the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, and the row number within each material status group ordered by subject ID, as well as all IAP subject activities with a maximum enrollment of 12, showing the subject ID, activity title, enrollment type, term description, and the rank of each record within each term description group ordered by activity title. Indicate the source of each record as either 'LibrarySubject' or 'IAPActivity'. The columns should be: subject ID, subject title, number of enrolled students, term code, material status key, ISBN, window column, activity title, enrollment type, term description, and source. Do not return any rounded answers.\"}, {\"id\": \"dw_4738\", \"desc\": \"For each subject offered in the term with the description \\\"Fall Term 2024-2025\\\", show the subject ID, subject title, offering department name, term description, and the rank of the subject within its offering department. For each tip detail record where the material status key is 'RQ', show the subject ID, term description, term start date, tip material key, and the average record count in a window of 2 preceding and 2 following rows grouped by the financial aid year. Additionally, for each subject offered in \\\"Fall Term 2024-2025\\\", include the academic year description from the academic terms table. Indicate the source of each row as either 'SubjectOffered' or 'TipDetail'. The results should be ordered by subject ID and source. Do not return any rounded answers.\"}, {\"id\": \"dw_2591\", \"desc\": \"For all subjects in the 2014FA term with at least one enrolled student, show the subject title, offering department name, responsible faculty name, the TIP material status key, the total number of units, and the minimum total number of units in a window of 3 preceding and 1 following row ordered by the course number, along with the cluster type description and the HGN code description for each subject. Do not return any rounded answers.\"}, {\"id\": \"dw_4566\", \"desc\": \"For each subject offered in the term with the description \\\"Fall Term 2024-2025\\\" that also has more than 0 enrolled students and a material status key of 'U', show the subject offered key, subject title, offering department name, the term description, the rank of each subject within its offering department, the course number, course number description, number of enrolled students, the reserve catalog key, the dense rank over the material status key, and the academic year description, ordered by subject offered key and course number. Do not return any rounded answers.\"}, {\"id\": \"dw_3727\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, or for each department that offered more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of tip materials. List the department code, department name, department full name, number of subjects offered, total number of enrolled students, and total number of tip materials in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_1221\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, and the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, as well as the average and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in courses with at least one reserved library material and a material status of 'U' offered by either the Chemistry or Biology department, and calculate the normalized enrollment ratio (the number of enrolled students in the library subject divided by the average enrollment for the department, rounded to two decimal places). List the results in descending order of normalized enrollment ratio.\"}, {\"id\": \"dw_4305\", \"desc\": \"For the top 10 subjects offered in the term with the description \\\"Fall Term 2024-2025\\\" that have the highest number of enrolled students, display each subject's offered key, subject title, offering department name, the term description, the number of enrolled students, and the rank of each subject within its offering department (ordered by subject offered key), but only include subjects where the offering department is among those that, in the term with code '2022SU', had an average total units for their subjects greater than the average total units for all subjects offered in that term. List the subject offered key, subject title, offering department name, term description, number of enrolled students, and the rank within the department, in that order, and order the results by department name and number of enrolled students descending. Do not return any rounded answers.\"}, {\"id\": \"dw_1689\", \"desc\": \"For each school, what is the school name and the highest average number of enrolled students per department (among its degree-granting departments, excluding Chemistry, and only considering subjects with at least one enrolled student), and for each subject offered by the Chemistry department in the 2019FA term that has course materials, what is the subject title, the dense rank of the subject considering the current and 2 preceding rows ordered by the number of enrolled students descending, the full name of the offering department, and the school name of the Chemistry department? List the school name and highest average enrolled students per department first, followed by the Chemistry subject title, dense rank, department full name, and Chemistry school name. Do not return any rounded answers.\"}, {\"id\": \"dw_4812\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_4650\", \"desc\": \"For each degree-granting department that offered at least one subject in the School of Engineering in 2021 and has more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the total number of tip materials, the average number of enrolled students per subject (rounded to two decimal places), and the ratio of total enrolled students to total tip materials (rounded to two decimal places), listing the results in descending order of the average number of enrolled students per subject.\"}, {\"id\": \"dw_4287\", \"desc\": \"For each library reserve material detail with material status key equal to 'U' and for subjects offered in the term with code '2025FA', show the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title from the subject offered table, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students (only including those where the number of enrolled students is greater than the average across all subjects), the offering department name, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, the offering school name, and the responsible faculty name for each subject. Order the results by offering department and descending number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_3311\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\"}], \"concept\": [{\"id\": \"concept_subject_offering_facts\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\"}, {\"id\": \"concept_course_material_programs\", \"desc\": \"Tables covering course material provisioning: the Textbook Information Program (TIP) tracking textbook adoption status per subject offering, and library reserve processing tracking catalog items placed on reserve for subjects. They jointly answer questions about which subjects have course materials/textbooks, material status (TIP statuses such as 'RQ' Required, 'EO' Electronic options; library statuses such as 'U' Unknown, 'Y' Required Course Material), ISBNs, record counts, and reserve catalog item attributes. The two programs are linked by SUBJECT_ID + TERM_CODE.\"}, {\"id\": \"concept_course_catalog_sources\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\"}, {\"id\": \"concept_person_directory\", \"desc\": \"Tables describing people of the institute keyed by MIT_ID: the primary employee directory (contact details, titles, HR department), the Drupal-sourced employee feed (employee group/type, appointment flags, HR org unit), the person master table (payroll rank, position title, active flag), the HR faculty roster (appointment type, terminal degree, emeritus status), the OPA current-person snapshot (HR job/appointment attributes, faculty flag, sabbatical), and the student directory (students with department attribution and student year). They jointly answer questions about who a person is, their contact details, job/appointment attributes, and whether they are employee, faculty, or student; responsible faculty in subject offering tables resolve to these tables via RESPONSIBLE_FACULTY_MIT_ID = MIT_ID.\"}, {\"id\": \"concept_academic_term_dimension\", \"desc\": \"Tables describing academic terms and their calendar/status attributes. They jointly answer questions about when terms run, which academic/financial-aid/degree year a term belongs to, and whether a term is current, previous, future, or regular. Coverage differs: the full historical term list, the status-tracked term subset, and the three-row relative term parameter reference.\"}, {\"id\": \"concept_iap_activities\", \"desc\": \"Tables describing Independent Activities Period (IAP) activities offered in January terms: activity details (title, enrollment type, max enrollment, fee, cancellation flags), sessions (location, date, times), sponsors (name, type), categories, and persons. They jointly answer questions about IAP activity counts, enrollment capacity, fees, session scheduling, and sponsorship.\"}, {\"id\": \"concept_room_major_use_classification\", \"desc\": \"Lookup tables classifying rooms by major use (classrooms, offices, laboratories, residential, circulation, etc.) with a short code, description, and assignable-space flag. They cover the current classification in the FCLT and FAC table families and the fiscal-period historical classification in the FCLT family, jointly answering questions about what a room is primarily used for and whether that use counts as assignable space.\"}, {\"id\": \"concept_cip_program_classification\", \"desc\": \"Lookup tables of the Classification of Instructional Programs (CIP) used to classify courses/instructional programs into two-digit categories, four-digit series, and six-digit program codes, with revision version years (1990/2000/2010/2020). CIP holds the current single-version classification (one row per program code, with a change NOTE), while CIP_WITH_VERSION preserves every revision of each program code across versions. Both join to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE to attribute courses to CIP programs and categories.\"}, {\"id\": \"concept_department_dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\"}, {\"id\": \"concept_dept_hr_org_hierarchy\", \"desc\": \"Tables describing the institute's department/lab/center (DLC) and HR organization hierarchies: the HR organization unit dimension in two feed variants (HR_ORG_UNIT, HR_ORG_UNIT_NEW), the master department standard hierarchy path (MASTER_DEPT_HIERARCHY), its DLC-to-administrative-object link table (MASTER_DEPT_HIERARCHY_LINKS), and the direct-parent department lookup (MASTER_DEPT_DCODE_PARENT). They jointly answer questions about which HR department/area a DLC or organization belongs to, the hierarchy path or parent of a department, and HR department names/codes/levels, and are joined to FCLT_ORGANIZATION via DLC_KEY for facilities/space attribution. They differ in hierarchy representation (full path vs direct parent vs HR unit attributes), unit coverage, and companion columns.\"}, {\"id\": \"concept_time_dimension\", \"desc\": \"Time dimension tables of the warehouse at three granularities: TIME_DAY (one row per calendar date, with fiscal/calendar year and period, academic year, financial aid year, day of week, and the academic term code/description of the day), TIME_MONTH (one row per fiscal period in YYYYMM format, covering fiscal years 1996-2035, with fiscal quarter, calendar month, academic term, and financial aid year mappings), and TIME_QUARTER (one row per fiscal quarter, covering fiscal years 2000-2035, with quarter dates, payroll certification deadlines, and quarter status flags). They jointly answer questions about when fiscal periods/quarters/days run, which fiscal/calendar/academic year a date or month belongs to, and how day-level records roll up to months and quarters. They link to each other via FISCAL_PERIOD (day-month), FY_QUARTER_CODE (month-quarter), and FISCAL_YEAR (month-quarter association within the same fiscal year, fanning out months across all quarters of the year), and to the academic term tables via TIME_DAY.ACADEMIC_TERM_CODE or TIME_MONTH.ACADEMIC_TERM = TERM_CODE.\"}, {\"id\": \"concept_moira_mailing_lists\", \"desc\": \"Tables of the Moira mailing-list/group domain: the list master (one row per list with name, description, active flag, and type flags such as mailing list, group, NFS group, public, hidden), the membership detail (one row per list member with member login, full name, MIT ID, and last update date), and the owner lookup (one row per owner entity with owner name and owner type LIST/USER/KERBEROS). They jointly answer questions about which lists exist and their properties, who belongs to a list, and who owns a list; MOIRA_LIST is the parent of MOIRA_LIST_DETAIL via MOIRA_LIST_KEY, and MOIRA_LIST_OWNER is referenced by MOIRA_LIST_DETAIL via MOIRA_LIST_OWNER_KEY.\"}, {\"id\": \"concept_room_space_inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\"}, {\"id\": \"concept_building_inventory\", \"desc\": \"Tables recording the physical building inventory and its attributes (number/name, type, ownership, site, campus sector, access level, gross/assignable/non-assignable areas, number of rooms, key dates): the current FCLT_* family snapshot, its fiscal-period history (in two date-format variants), the FAC_* family snapshot, and the lightweight space-domain building lookup. They jointly answer questions about building characteristics, areas, and room counts, but differ in time coverage, table family, attribute richness, and area units.\"}, {\"id\": \"concept_facility_organization_dimension\", \"desc\": \"Organization dimension tables describing the institute's hierarchical organization tree used for facilities/space attribution: FCLT_ORGANIZATION (keyed by FCLT_ORGANIZATION_KEY, with DLC_KEY/DLC_NAME) and FAC_ORGANIZATION (keyed by ORGANIZATION_KEY, with D_CODE). They answer the same questions about organization names, hierarchy levels, parent/major organizations, assignable flags, and HR cross-references, but belong to different table families and coverage.\"}], \"column_concept\": [{\"id\": \"column_concept_enrollment_measures\", \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\"}, {\"id\": \"column_concept_master_subject_id\", \"desc\": \"Master subject identifier columns (MASTER_SUBJECT_ID and its sortable variant MASTER_SUBJECT_ID_SORT) replicated across the registrar offering tables, the subject summary, the textbook program, the library reserve program, and the CIS course catalog. For clustered subjects (e.g. joint or cross-listed offerings), the master subject identifier points to the leading subject of the cluster, so joining on it matches offerings that share the same master subject even when their own SUBJECT_ID differs. SUBJECT_ID/SUBJECT_ID_SORT identify the subject itself, while MASTER_SUBJECT_ID/MASTER_SUBJECT_ID_SORT identify the cluster's master; the _SORT columns are the sortable forms of the same values used for cross-table joins.\"}, {\"id\": \"column_concept_subject_id\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\"}, {\"id\": \"column_concept_term_code\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\"}, {\"id\": \"column_concept_total_units\", \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\"}, {\"id\": \"column_concept_department_name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\"}, {\"id\": \"column_concept_material_status_key\", \"desc\": \"Material status key columns of the textbook program (TIP) and library reserve program. Both are coded status references decoded by their own lookup tables (key value equals code value), with independent value domains: TIP statuses ('RQ' Required, 'EO' Electronic options, 'RC' Recommended, 'PC' Val-u option, 'BR' Bookstore recommends, 'CL' Go to class first, 'NM' Course has no materials, 'U' Unknown, plus NULL-description keys) vs library reserve statuses ('U' Unknown, 'R' null description, 'N' Non-Required Course Material, 'O' Reserve only, 'X' No Required Textbook, 'Y' Required Course Material).\"}, {\"id\": \"column_concept_dlc_key\", \"desc\": \"Department/Lab/Center key columns (values like 'D_AEROASTRO', 'D_IDSS', 'D_BIOLOGY') identifying a DLC across the facilities, HR, space, and academic-department domains. They are the universal cross-domain join key linking facilities organizations and space units to HR organization units, the master department hierarchy, and academic departments. Naming and completeness vary: DLC_KEY in most tables, D_CODE in MASTER_DEPT_DCODE_PARENT, DLC_CODE in the master hierarchy tables; some columns carry composite values ('D_DSL:HQ') or nulls.\"}, {\"id\": \"column_concept_hass_attribute\", \"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code and description columns. The code columns appear in the three course catalog feeds and in the CIS_HASS_ATTRIBUTE lookup; description columns exist in three variants: the catalog-embedded HASS_ATTRIBUTE_DESC, the lookup's DESCRIPTION_ON_FORM (registration-form wording), and DESCRIPTION_IN_BULLETIN (short bulletin wording). Selecting the right description variant depends on the wording requested by the question.\"}, {\"id\": \"column_concept_year_columns\", \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\"}, {\"id\": \"column_concept_office_location\", \"desc\": \"OFFICE_LOCATION columns recording where a person's office/desk is, replicated across the person-directory tables (SE_PERSON, MIT_STUDENT_DIRECTORY, EMPLOYEE_DIRECTORY, DRUPAL_EMPLOYEE_DIRECTORY). All hold a building or building-room text identifier in the same value domain as FCLT_ROOMS.BUILDING_ROOM, but they describe different populations (employee/person master vs student vs primary employee directory vs Drupal employee feed) and differ sharply in non-null coverage and in how many values are building-room ('BLDG-ROOM') versus building-only ('BLDG'). Choosing the right column determines whose office is reported and whether room-level joins to FCLT_ROOMS succeed.\"}, {\"id\": \"column_concept_building_type_site\", \"desc\": \"Building classification columns replicated across the current and historical building tables of both table families: BUILDING_TYPE ('ACADEMIC', 'SERVICE', 'RESIDENT') and SITE ('MIT', 'BATES', 'LINC', 'BOS', etc.). They carry the same value domain but differ in time semantics: the building-table columns are the current classification, while the history-table columns are the classification recorded at each fiscal period, so filtering by one versus the other can select different building sets.\"}, {\"id\": \"column_concept_space_unit_key\", \"desc\": \"Space unit key columns identifying the organizational space-assignment unit across the space dimension and fact tables. SPACE_UNIT_KEY is the join key linking SPACE_DETAIL room rows to space unit identity (name/code) and, through SPACE_UNIT, to the owning facilities organization.\"}, {\"id\": \"column_concept_num_of_rooms\", \"desc\": \"NUM_OF_ROOMS columns recording how many rooms a building contains, replicated across the current and historical building tables of both families. The building-table columns hold the current room count (one value per building); the history-table columns hold the room count at each fiscal period, used for room-count statistics (average, range, variance, minimum) across a building's history records.\"}, {\"id\": \"column_concept_building_room\", \"desc\": \"Combined building-room identifier columns (e.g. '1-080') appearing in both the space assignment fact table and the facilities room inventory. They identify the same physical room concept but come from different business processes with different coverage and companion measures.\"}]}}"
    },
    {
      "role": "assistant",
      "content": "Let me examine precedent union-style metrics to understand the pattern used in this benchmark family.\n\n",
      "tool_calls": [
        {
          "id": "call_95d4ffcdb632493fa409bfbd",
          "type": "function",
          "function": {
            "name": "semantic_get",
            "arguments": "{\"entity_ids\": \n[\"dw_3224\", \"dw_3436\", \"dw_4738\", \"dw_3727\"]\n\n}"
          }
        }
      ]
    },
    {
      "role": "tool",
      "tool_call_id": "call_95d4ffcdb632493fa409bfbd",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject per source term\", \"desc\": \"List all subjects from the term \\\"2010FA\\\" and all subjects offered in the term with code \\\"2025FA\\\", showing for each row: subject ID, term description, material status key, academic year, rank of the subject within each academic year group ordered by subject ID, subject title, offering department name, number of enrolled students, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, and the source term (\\\"2010FA\\\" or \\\"2025FA\\\"). The columns should appear in the following order: subject ID, term description, material status key, academic year, rank, subject title, offering department name, number of enrolled students, term start date, term end date, term parameter, minimum enrolled students per department, and source term. Order the results by subject ID and source term. Do not return any rounded answers.\", \"id\": \"dw_3224\", \"name\": \"Union of 2010FA TIP Material Subjects and 2025FA Offered Subjects with Department Min Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t2.SUBJECT_ID, t0.TERM_DESCRIPTION, t2.TIP_MATERIAL_STATUS_KEY, t1.ACADEMIC_YEAR, RANK() OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t2.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t2.TERM_CODE = '2010FA' ), Subq2 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TERM_START_DATE, t1.TERM_END_DATE, t2.TERM_PARAMETER, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_students_per_dept FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2025FA' ), CombinedSubjects AS ( SELECT s1.SUBJECT_ID, s1.TERM_DESCRIPTION, s1.TIP_MATERIAL_STATUS_KEY, s1.ACADEMIC_YEAR, s1.window_column, NULL AS SUBJECT_TITLE, NULL AS OFFER_DEPT_NAME, NULL AS NUM_ENROLLED_STUDENTS, NULL AS TERM_START_DATE, NULL AS TERM_END_DATE, NULL AS TERM_PARAMETER, NULL AS min_enrolled_students_per_dept, '2010FA' AS SOURCE_TERM FROM Subq1 s1 UNION ALL SELECT s2.SUBJECT_ID, s2.TERM_DESCRIPTION, NULL AS TIP_MATERIAL_STATUS_KEY, s2.ACADEMIC_YEAR, NULL AS window_column, s2.SUBJECT_TITLE, s2.OFFER_DEPT_NAME, s2.NUM_ENROLLED_STUDENTS, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.TERM_PARAMETER, s2.min_enrolled_students_per_dept, '2025FA' AS SOURCE_TERM FROM Subq2 s2 ) SELECT * FROM CombinedSubjects ORDER BY SUBJECT_ID, SOURCE_TERM;\"}, {\"category\": \"Library Reserve and IAP Activity Comprehensive Analysis\", \"default_granularity\": \"one row per record from either library subject or IAP activity scope\", \"desc\": \"List all subjects with at least 5 enrolled students, showing the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, and the row number within each material status group ordered by subject ID, as well as all IAP subject activities with a maximum enrollment of 12, showing the subject ID, activity title, enrollment type, term description, and the rank of each record within each term description group ordered by activity title. Indicate the source of each record as either 'LibrarySubject' or 'IAPActivity'. The columns should be: subject ID, subject title, number of enrolled students, term code, material status key, ISBN, window column, activity title, enrollment type, term description, and source. Do not return any rounded answers.\", \"id\": \"dw_3436\", \"name\": \"Union of Library Subjects 5+ Enrolled and IAP Activities Max Enrollment 12\", \"sql\": \"WITH Subquery1 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.TERM_CODE, t1.TIP_MATERIAL_STATUS_KEY, t1.ISBN, ROW_NUMBER() OVER (PARTITION BY t1.TIP_MATERIAL_STATUS_KEY ORDER BY t0.SUBJECT_ID) AS window_column FROM LIBRARY_SUBJECT_OFFERED t0 JOIN TIP_DETAIL t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.NUM_ENROLLED_STUDENTS >= 5 ), Subquery2 AS ( SELECT t0.ACTIVITY_TITLE, t0.ENROLLMENT_TYPE, t1.TERM_DESCRIPTION, t2.SUBJECT_ID, RANK() OVER (PARTITION BY t1.TERM_DESCRIPTION ORDER BY t0.ACTIVITY_TITLE) AS window_column FROM IAP_SUBJECT_DETAIL t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.MAX_ENROLLMENT = 12 ), CombinedResults AS ( SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.TERM_CODE, s1.TIP_MATERIAL_STATUS_KEY, s1.ISBN, s1.window_column, NULL AS ACTIVITY_TITLE, NULL AS ENROLLMENT_TYPE, NULL AS TERM_DESCRIPTION, 'LibrarySubject' AS Source FROM Subquery1 s1 UNION ALL SELECT s2.SUBJECT_ID, NULL AS SUBJECT_TITLE, NULL AS NUM_ENROLLED_STUDENTS, NULL AS TERM_CODE, NULL AS TIP_MATERIAL_STATUS_KEY, NULL AS ISBN, s2.window_column, s2.ACTIVITY_TITLE, s2.ENROLLMENT_TYPE, s2.TERM_DESCRIPTION, 'IAPActivity' AS Source FROM Subquery2 s2 ) SELECT * FROM CombinedResults ORDER BY SUBJECT_ID, Source;\"}, {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per record from either Fall 2024-2025 subject offering or required textbook detail scope\", \"desc\": \"For each subject offered in the term with the description \\\"Fall Term 2024-2025\\\", show the subject ID, subject title, offering department name, term description, and the rank of the subject within its offering department. For each tip detail record where the material status key is 'RQ', show the subject ID, term description, term start date, tip material key, and the average record count in a window of 2 preceding and 2 following rows grouped by the financial aid year. Additionally, for each subject offered in \\\"Fall Term 2024-2025\\\", include the academic year description from the academic terms table. Indicate the source of each row as either 'SubjectOffered' or 'TipDetail'. The results should be ordered by subject ID and source. Do not return any rounded answers.\", \"id\": \"dw_4738\", \"name\": \"Union of Fall 2024-2025 Offered Subjects Ranked per Department and Required Textbook Record Count Windows\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.SUBJECT_ID) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_DESCRIPTION = 'Fall Term 2024-2025' ) , Subquery2 AS ( SELECT t1.SUBJECT_ID, t0.TERM_DESCRIPTION, t0.TERM_START_DATE, t1.TIP_MATERIAL_KEY, AVG(t1.RECORD_COUNT) OVER ( PARTITION BY t0.FINANCIAL_AID_YEAR ORDER BY t1.SUBJECT_ID ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN TIP_DETAIL t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TIP_MATERIAL_STATUS_KEY = 'RQ' ) , SubjectOfferedWithYear AS ( SELECT i.SUBJECT_ID, i.SUBJECT_TITLE, i.OFFER_DEPT_NAME, i.TERM_DESCRIPTION, i.window_column AS subject_rank, t1.ACADEMIC_YEAR_DESC FROM inner_cte i JOIN ACADEMIC_TERMS_ALL t1 ON i.TERM_DESCRIPTION = t1.TERM_DESCRIPTION ) , CombinedResults AS ( SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME, s1.TERM_DESCRIPTION, s1.subject_rank, s1.ACADEMIC_YEAR_DESC, NULL AS TERM_START_DATE, NULL AS TIP_MATERIAL_KEY, NULL AS avg_record_count, 'SubjectOffered' AS Source FROM SubjectOfferedWithYear s1 UNION ALL SELECT s2.SUBJECT_ID, NULL AS SUBJECT_TITLE, NULL AS OFFER_DEPT_NAME, s2.TERM_DESCRIPTION, NULL AS subject_rank, NULL AS ACADEMIC_YEAR_DESC, s2.TERM_START_DATE, s2.TIP_MATERIAL_KEY, s2.window_column AS avg_record_count, 'TipDetail' AS Source FROM Subquery2 s2 ) SELECT * FROM CombinedResults ORDER BY SUBJECT_ID, Source;\"}, {\"category\": \"Department Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per department\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, or for each department that offered more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of tip materials. List the department code, department name, department full name, number of subjects offered, total number of enrolled students, and total number of tip materials in that order. Do not return any rounded answers.\", \"id\": \"dw_3727\", \"name\": \"Engineering Degree-Granting Departments 2021 Subject Counts and TIP Material Totals Union\", \"sql\": \"WITH DeptSubjects AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), DeptTipMaterials AS ( SELECT s.DEPARTMENT_NAME, SUM(t.RECORD_COUNT) AS total_tip_materials FROM TIP_DETAIL t JOIN ACADEMIC_TERMS a ON t.TERM_CODE = a.TERM_CODE JOIN SUBJECT_SUMMARY s ON a.TERM_CODE = s.TERM_CODE AND t.SUBJECT_ID = s.SUBJECT_ID WHERE s.SCHOOL_NAME = 'Engineering' AND a.IS_REGULAR_TERM = 'Y' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.RECORD_COUNT) > 10 ), CombinedDept AS ( SELECT ds.DEPARTMENT_CODE, ds.DEPARTMENT_NAME, ds.DEPARTMENT_FULL_NAME, ds.subject_count, ds.total_enrollment, dtm.total_tip_materials FROM DeptSubjects ds LEFT JOIN DeptTipMaterials dtm ON ds.DEPARTMENT_NAME = dtm.DEPARTMENT_NAME UNION ALL SELECT NULL AS DEPARTMENT_CODE, dtm.DEPARTMENT_NAME, NULL AS DEPARTMENT_FULL_NAME, NULL AS subject_count, NULL AS total_enrollment, dtm.total_tip_materials FROM DeptTipMaterials dtm LEFT JOIN DeptSubjects ds ON dtm.DEPARTMENT_NAME = ds.DEPARTMENT_NAME WHERE ds.DEPARTMENT_NAME IS NULL ) SELECT * FROM CombinedDept ORDER BY DEPARTMENT_NAME;\"}], \"not_found\": []}"
    },
