      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the TIP subject offered record; joins to TIP_DETAIL.TIP_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"IS_NO_COURSE_MATERIAL\": {\"desc\": \"'Y'/'N' flag whether the subject has no course material; 'N' means the subject has course materials\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '5.01'; joins to TIP_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE and STUDENT_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Chemistry', 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject; used for enrollment-based rankings and window statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in the textbook program\"}, {\"id\": \"LIBRARY_COURSE_INSTRUCTOR\", \"name\": \"LIBRARY_COURSE_INSTRUCTOR\", \"desc\": \"Library course instructor table recording instructors of courses with library reserve materials, including course name, instructor name, department (in 'COURSE_NUMBER - Department Name' format), assignment date range, and library organizational unit/branch. Referenced by LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_COURSE_INSTRUCTOR_KEY; instructor names resolve to person records via INSTRUCTOR_NAME = SE_PERSON.FULL_NAME.\", \"columns\": {\"LIBRARY_COURSE_INSTRUCTOR_KEY\": {\"desc\": \"Surrogate key; joins to LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_COURSE_INSTRUCTOR_KEY\"}, \"COURSE_NAME\": {\"desc\": \"Name of the course taught by the instructor\"}, \"INSTRUCTOR_NAME\": {\"desc\": \"Full name of the course instructor as recorded by the library; matches SE_PERSON.FULL_NAME for name-based person resolution (e.g. to obtain MIT_ID). No surrogate person key exists in this table.\"}, \"DEPARTMENT\": {\"desc\": \"Academic department of the course in 'COURSE_NUMBER - Department Name' format (e.g. '18 - Mathematics', '06 - Electrical Eng & Computer Sci', '5 - Chemistry'); some values carry no course-number prefix (e.g. 'Architecture', 'Engineering Systems Division'). Different value format from the plain department-name columns (DEPARTMENT_NAME / OFFER_DEPT_NAME) in subject offering and lookup tables, so filters must use the prefixed form.\"}, \"DATE_FROM\": {\"desc\": \"Start date of the instructor assignment\"}, \"DATE_TO\": {\"desc\": \"End date of the instructor assignment\"}, \"UNIT_CODE\": {\"desc\": \"Code of the library unit (e.g. 'Hayden', 'ENG', 'DEW', 'RTC', 'MUS'); values are inconsistent and may hold combined multi-unit strings such as 'Hayden & ENG', 'DEW & Hayden', '10Hayden', or 'DEW + Hayden'. For clean single-unit filtering prefer the UNIT column.\"}, \"UNIT\": {\"desc\": \"Library branch/unit responsible for the reserve material (e.g. 'Hayden', 'Barker', 'Dewey', 'Rotch', 'Lewis Music'); may be null when the assignment spans multiple units, in which case UNIT_CODE may hold a combined value.\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per course instructor assignment\"}, {\"id\": \"LIBRARY_RESERVE_CATALOG\", \"name\": \"LIBRARY_RESERVE_CATALOG\", \"desc\": \"Library reserve catalog table describing catalog items placed on reserve: title, author, publication year, publisher, call number, ISBN, system number, record create/update dates, and a record counter. Referenced by LIBRARY_RESERVE_MATRL_DETAIL.\", \"columns\": {\"LIBRARY_RESERVE_CATALOG_KEY\": {\"desc\": \"Surrogate key of the reserve catalog record; joins to LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_RESERVE_CATALOG_KEY\"}, \"CATALOG_TITLE\": {\"desc\": \"Title of the catalog item\"}, \"CATALOG_AUTHOR_NAME\": {\"desc\": \"Author name of the catalog item\"}, \"CATALOG_YEAR\": {\"desc\": \"Publication year of the catalog item; used for year-based filtering (e.g. > 2000)\"}, \"CATALOG_PUBLISHER\": {\"desc\": \"Publisher of the catalog item\"}, \"CATALOG_CALL_NUMBER\": {\"desc\": \"Library call number of the catalog item\"}, \"CATALOG_ISBN\": {\"desc\": \"ISBN of the catalog item\"}, \"CATALOG_SYSTEM_NUMBER\": {\"desc\": \"Library system number of the catalog record\"}, \"CATALOG_RECORD_CREATE_DATE\": {\"desc\": \"Date the catalog record was created\"}, \"CATALOG_RECORD_UPDATE_DATE\": {\"desc\": \"Date the catalog record was last updated\"}, \"RECORD_COUNTER\": {\"desc\": \"Record counter value of the catalog item; used in average/variance statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per reserve catalog item\"}], \"not_found\": []}"
    },
