      "tool_call_id": "call_b7caf48dbf36437bb077aa90",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering Analysis\", \"default_granularity\": \"one row per department per academic year\", \"desc\": \"For each department and academic year, provide the department name, academic year, the number of subjects offered that are not repeatable for credit and are offered in the fall term, and classify the department as 'HIGH_ACTIVITY' if it offers at least 10% more such subjects than the average across all departments for that year, 'LOW_ACTIVITY' if it offers at least 10% fewer, or 'AVERAGE' otherwise. Do not return any rounded answers.\", \"id\": \"dw_2580\", \"name\": \"Department Fall Non-Repeatable Subject Count Activity Classification by Year\", \"sql\": \"WITH inner_cte AS ( SELECT ccso.DEPARTMENT_NAME, at.ACADEMIC_YEAR, COUNT(so.SUBJECT_KEY) AS subject_count FROM SUBJECT_OFFERED so JOIN ACADEMIC_TERMS at ON so.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE ccso.GRADE_RULE_DESC = 'Not repeatable for credit' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY ccso.DEPARTMENT_NAME, at.ACADEMIC_YEAR ) , dept_avg AS ( SELECT ACADEMIC_YEAR, AVG(subject_count) AS avg_subject_count FROM inner_cte GROUP BY ACADEMIC_YEAR ) SELECT i.DEPARTMENT_NAME, i.ACADEMIC_YEAR, i.subject_count, d.avg_subject_count, CASE WHEN i.subject_count > d.avg_subject_count * 1.1 THEN 'HIGH_ACTIVITY' WHEN i.subject_count < d.avg_subject_count * 0.9 THEN 'LOW_ACTIVITY' ELSE 'AVERAGE' END AS activity_level FROM inner_cte i JOIN dept_avg d ON i.ACADEMIC_YEAR = d.ACADEMIC_YEAR;\"}, {\"id\": \"dw_2913\", \"name\": \"Material Info Source Record Totals and Average New Shelf Price with High/Low Records Classification\", \"desc\": \"For each material information source, provide the material information source, the total number of records for materials published after 2010 and with a new shelf price greater than 10, the average new shelf price for those materials as a benchmark, and categorize the total records as 'HIGH_RECORDS' if at least 20% greater than the benchmark record count across all sources, 'LOW_RECORDS' if at least 20% less, or 'AVERAGE' otherwise. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT m.MATERIAL_INFO_SOURCE, SUM(d.RECORD_COUNT) AS total_records FROM TIP_DETAIL d JOIN TIP_MATERIAL m ON d.TIP_MATERIAL_KEY = m.TIP_MATERIAL_KEY WHERE m.YEAR > 2010 AND m.NEW_SHELF_PRICE > 10 GROUP BY m.MATERIAL_INFO_SOURCE HAVING SUM(d.RECORD_COUNT) > 0 ), benchmark_cte AS ( SELECT m.MATERIAL_INFO_SOURCE, AVG(m.NEW_SHELF_PRICE) AS avg_new_shelf_price FROM TIP_DETAIL d JOIN TIP_MATERIAL m ON d.TIP_MATERIAL_KEY = m.TIP_MATERIAL_KEY WHERE m.YEAR > 2010 AND m.NEW_SHELF_PRICE > 10 GROUP BY m.MATERIAL_INFO_SOURCE ), overall_benchmark AS ( SELECT AVG(total_records) AS avg_total_records FROM inner_cte ) SELECT i.MATERIAL_INFO_SOURCE, i.total_records, b.avg_new_shelf_price, CASE WHEN i.total_records > ob.avg_total_records * 1.2 THEN 'HIGH_RECORDS' WHEN i.total_records < ob.avg_total_records * 0.8 THEN 'LOW_RECORDS' ELSE 'AVERAGE' END AS records_category FROM inner_cte i JOIN benchmark_cte b ON i.MATERIAL_INFO_SOURCE = b.MATERIAL_INFO_SOURCE CROSS JOIN overall_benchmark ob;\", \"category\": \"Textbook Material Analysis\", \"default_granularity\": \"one row per material information source\"}, {\"id\": \"dw_3131\", \"name\": \"Fiscal Period Calendar Year Variance with High/Low/Average Classification\", \"desc\": \"For each fiscal period, what is the fiscal period description, the variance of the calendar year for all days in that period where the academic year is not null, and whether the variance is 'HIGH_VARIANCE' (at least 20% greater than the average variance across all periods), 'LOW_VARIANCE' (at least 20% less than the average), or 'AVERAGE'? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT TIME_MONTH.FISCAL_PERIOD, TIME_MONTH.FISCAL_PERIOD_DESCRIPTION, VARIANCE(TIME_DAY.CALENDAR_YEAR) AS calendar_year_variance FROM TIME_MONTH JOIN TIME_DAY ON TIME_MONTH.FISCAL_PERIOD = TIME_DAY.FISCAL_PERIOD WHERE TIME_DAY.ACADEMIC_YEAR IS NOT NULL GROUP BY TIME_MONTH.FISCAL_PERIOD, TIME_MONTH.FISCAL_PERIOD_DESCRIPTION ) SELECT inner_cte.FISCAL_PERIOD, inner_cte.FISCAL_PERIOD_DESCRIPTION, inner_cte.calendar_year_variance, CASE WHEN inner_cte.calendar_year_variance > avg_stats.avg_variance * 1.2 THEN 'HIGH_VARIANCE' WHEN inner_cte.calendar_year_variance < avg_stats.avg_variance * 0.8 THEN 'LOW_VARIANCE' ELSE 'AVERAGE' END AS variance_category FROM inner_cte CROSS JOIN ( SELECT AVG(calendar_year_variance) AS avg_variance FROM inner_cte ) avg_stats ORDER BY inner_cte.calendar_year_variance DESC;\", \"category\": \"Fiscal Calendar Analysis\", \"default_granularity\": \"one row per fiscal period with days having a non-null academic year\"}, {\"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per 2006FA subject matched with 2017JA subject of same department\", \"desc\": \"For each subject offered in the academic term with term code '2006FA' in departments that offer more than 5 subjects in that term, show the subject ID, subject title, department name, the sum of lecture units within each grade type group, and the total number of subjects per department for that term. Additionally, for each subject offered by the same department in the term '2017JA', show the number of enrolled students, offering department name, department full name, subject code, subject code description, and whether the number of enrolled students is 'HIGH_ENROLLMENT' (at least 10% greater than the average for that subject code), 'LOW_ENROLLMENT' (at least 10% less than the average for that subject code), or 'AVERAGE'. Present the results ordered by subject ID and subject code. Do not return any rounded answers.\", \"id\": \"dw_3985\", \"name\": \"2006FA Department Lecture Unit Sums with 2017JA Enrollment Classification per Subject Code\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.DEPARTMENT_CODE, SUM(t1.LECTURE_UNITS) OVER (PARTITION BY t1.GRADE_TYPE ORDER BY t1.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.EFFECTIVE_TERM_CODE WHERE t0.TERM_CODE = '2006FA' ), DeptCounts AS ( SELECT DEPARTMENT_NAME, DEPARTMENT_CODE, COUNT(*) AS SUBJECT_COUNT FROM COURSE_CATALOG_SUBJECT_OFFERED WHERE EFFECTIVE_TERM_CODE = '2006FA' GROUP BY DEPARTMENT_NAME, DEPARTMENT_CODE HAVING COUNT(*) > 5 ), inner_cte2 AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t0.OFFER_DEPT_CODE, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), subject_code_avg AS ( SELECT SUBJECT_CODE, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM inner_cte2 GROUP BY SUBJECT_CODE ) SELECT ic1.SUBJECT_ID, ic1.SUBJECT_TITLE, ic1.DEPARTMENT_NAME, ic1.window_column, dc.SUBJECT_COUNT, ic2.NUM_ENROLLED_STUDENTS, ic2.OFFER_DEPT_NAME, ic2.DEPARTMENT_FULL_NAME, ic2.SUBJECT_CODE, ic2.SUBJECT_CODE_DESC, CASE WHEN ic2.NUM_ENROLLED_STUDENTS > sca.avg_enrollment * 1.1 THEN 'HIGH_ENROLLMENT' WHEN ic2.NUM_ENROLLED_STUDENTS < sca.avg_enrollment * 0.9 THEN 'LOW_ENROLLMENT' ELSE 'AVERAGE' END AS enrollment_category FROM inner_cte1 ic1 JOIN DeptCounts dc ON ic1.DEPARTMENT_NAME = dc.DEPARTMENT_NAME AND ic1.DEPARTMENT_CODE = dc.DEPARTMENT_CODE JOIN SIS_DEPARTMENT sd ON ic1.DEPARTMENT_CODE = sd.DEPARTMENT_CODE JOIN inner_cte2 ic2 ON ic1.DEPARTMENT_CODE = ic2.OFFER_DEPT_CODE JOIN subject_code_avg sca ON ic2.SUBJECT_CODE = sca.SUBJECT_CODE ORDER BY ic1.SUBJECT_ID, ic2.SUBJECT_CODE;\"}], \"not_found\": []}"
    },
