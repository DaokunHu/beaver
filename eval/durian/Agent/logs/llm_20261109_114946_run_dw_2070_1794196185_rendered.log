    {
      "role": "tool",
      "tool_call_id": "call_4167956e0e4d43ce93ef2f97",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per graduate course plus rollup totals plus Spring 2021 letter-graded summary row\", \"desc\": \"For each course in the Mathematics department that is degree granting and has a course level of 'G', show the course description, department name, school name, the administrative department name, and the dense rank over the administrative department name ordered by the administrative department name. Additionally, for each administrative department name, include a grand total of the number of such courses in the format of (null, null, null, administrative department name, null, total courses). Also, show the minimum total units, the sum of lecture units, and the number of unique subjects for letter graded Mathematics department subjects offered in the Spring Term 2021, along with the department name and term description (with all other columns as null). Do not return any rounded answers.\", \"id\": \"dw_1427\", \"name\": \"Math Graduate Degree-Granting Courses Ranked by Admin Department with Spring 2021 Letter-Graded Unit Summary\", \"sql\": \"WITH inner_cte_1 AS ( SELECT scd.COURSE_DESCRIPTION, sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, sad.SIS_ADMIN_DEPARTMENT_NAME, DENSE_RANK() OVER (ORDER BY sad.SIS_ADMIN_DEPARTMENT_NAME) AS admin_dept_dense_rank FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT sad ON sd.DEPARTMENT_CODE = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND scd.COURSE_LEVEL = 'G' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' ), CourseTotals AS ( SELECT SIS_ADMIN_DEPARTMENT_NAME, COUNT(*) AS total_courses FROM inner_cte_1 GROUP BY SIS_ADMIN_DEPARTMENT_NAME ), inner_cte_2 AS ( SELECT MIN(c.TOTAL_UNITS) AS min_total_units, SUM(c.LECTURE_UNITS) AS sum_lecture_units FROM ACADEMIC_TERMS_ALL a JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON a.TERM_CODE = c.TERM_CODE WHERE a.TERM_CODE = '2021SP' AND c.GRADE_TYPE = 'L' AND c.DEPARTMENT_NAME = 'Mathematics' ) SELECT ic.COURSE_DESCRIPTION, ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, ic.admin_dept_dense_rank, NULL AS total_courses, NULL AS min_total_units, NULL AS sum_lecture_units, NULL AS num_unique_subjects, NULL AS term_description FROM inner_cte_1 ic UNION ALL SELECT NULL, NULL, NULL, ct.SIS_ADMIN_DEPARTMENT_NAME, NULL, ct.total_courses, NULL, NULL, NULL, NULL FROM CourseTotals ct UNION ALL SELECT NULL, a.DEPARTMENT_NAME, NULL, NULL, NULL, NULL, inner_cte_2.min_total_units, inner_cte_2.sum_lecture_units, COUNT(DISTINCT a.SUBJECT_ID) AS num_unique_subjects, b.TERM_DESCRIPTION FROM COURSE_CATALOG_SUBJECT_OFFERED a JOIN ACADEMIC_TERMS_ALL b ON a.TERM_CODE = b.TERM_CODE CROSS JOIN inner_cte_2 WHERE a.TERM_CODE = '2021SP' AND a.GRADE_TYPE = 'L' AND a.DEPARTMENT_NAME = 'Mathematics' GROUP BY a.DEPARTMENT_NAME, b.TERM_DESCRIPTION, inner_cte_2.min_total_units, inner_cte_2.sum_lecture_units ORDER BY SIS_ADMIN_DEPARTMENT_NAME, COURSE_DESCRIPTION\"}, {\"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2024 Mathematics 12-unit subject matched with 2019FA TIP offering\", \"desc\": \"For subjects offered in the academic year 2024 with total units equal to 12 in the Mathematics department, show the department code, department name, subject code, subject number, subject title, total units, the row number within each department ordered by subject code, the deviation of each subject's total units from the average total units of all Mathematics subjects offered in 2024, the number of enrolled students, responsible faculty name, school name, and the dense rank over the department name ordered by department name for those subjects that also have course materials and were offered in the term '2019FA'. Sort the table by department name and subject title. Do not return any rounded answers.\", \"id\": \"dw_1758\", \"name\": \"Math 2024 12-Unit Subjects Row Numbers and Unit Deviations Matched with 2019FA TIP Course-Material Offerings\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.DEPARTMENT_CODE, t0.DEPARTMENT_NAME, t1.SUBJECT_CODE, t1.SUBJECT_NUMBER, t1.SUBJECT_TITLE, t1.TOTAL_UNITS, ROW_NUMBER() OVER (PARTITION BY t0.DEPARTMENT_CODE ORDER BY t1.SUBJECT_CODE) AS window_column FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t1.ACADEMIC_YEAR = 2024 AND t1.TOTAL_UNITS = 12 AND t0.DEPARTMENT_NAME = 'Mathematics' ), math_avg AS ( SELECT t0.DEPARTMENT_CODE, AVG(t1.TOTAL_UNITS) AS avg_total_units FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t1.ACADEMIC_YEAR = 2024 AND t0.DEPARTMENT_NAME = 'Mathematics' GROUP BY t0.DEPARTMENT_CODE ) SELECT i.DEPARTMENT_CODE, i.DEPARTMENT_NAME, i.SUBJECT_CODE, i.SUBJECT_NUMBER, i.SUBJECT_TITLE, i.TOTAL_UNITS, i.window_column, (i.TOTAL_UNITS - m.avg_total_units) AS deviation_from_avg FROM inner_cte i JOIN math_avg m ON i.DEPARTMENT_CODE = m.DEPARTMENT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t1.DEPARTMENT_NAME, t1.SCHOOL_NAME, DENSE_RANK() OVER (PARTITION BY t1.DEPARTMENT_NAME ORDER BY t1.DEPARTMENT_NAME) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_COURSE_DESCRIPTION t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT WHERE t0.TERM_CODE = '2019FA' AND t1.DEPARTMENT_NAME = 'Mathematics' AND t0.IS_NO_COURSE_MATERIAL = 'N' ) SELECT CASE WHEN LAG(DEPARTMENT_NAME) OVER (ORDER BY DEPARTMENT_NAME, SUBJECT_TITLE) = DEPARTMENT_NAME THEN NULL ELSE DEPARTMENT_NAME END AS department_name, SUBJECT_TITLE, NUM_ENROLLED_STUDENTS, RESPONSIBLE_FACULTY_NAME, SCHOOL_NAME, window_column FROM inner_cte ORDER BY DEPARTMENT_NAME, SUBJECT_TITLE ) SELECT s1.DEPARTMENT_CODE, s1.DEPARTMENT_NAME, s1.SUBJECT_CODE, s1.SUBJECT_NUMBER, s1.SUBJECT_TITLE, s1.TOTAL_UNITS, s1.window_column AS subject_row_number, s1.deviation_from_avg, s2.NUM_ENROLLED_STUDENTS, s2.RESPONSIBLE_FACULTY_NAME, s2.SCHOOL_NAME, s2.window_column AS department_dense_rank FROM subq1 s1 LEFT JOIN subq2 s2 ON s1.DEPARTMENT_NAME = s2.department_name AND s1.SUBJECT_TITLE = s2.SUBJECT_TITLE ORDER BY s1.DEPARTMENT_NAME, s1.SUBJECT_TITLE;\"}], \"not_found\": []}"
    },
