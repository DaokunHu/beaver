    {
      "role": "tool",
      "tool_call_id": "call_d807930f8d484759a8b6b4b1",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and CIP Program Classification Comprehensive Analysis\", \"default_granularity\": \"one row per 2012SU subject offering detail plus rollup rows per department and per school\", \"desc\": \"For each offer department code in the 2012SU term with total units greater than 0, list the subject title, course number, department name, the dense rank over the offer department code, the course, course description, school name, program code, program title, category code, category title, four digit code, four digit title, and the minimum warehouse load date from the CIP table over each category code group for courses in department 6, and include a grand total of subjects per offer department code and a grand total for all courses in each school in the format (nulls for subject-specific fields, department name, total subjects, course-specific fields, school name, and total courses). Do not return any rounded answers.\", \"id\": \"dw_3901\", \"name\": \"2012SU Subject Offerings Dense Rank Matched with Department-6 CIP Course Classification and School Rollups\", \"sql\": \"WITH inner_cte1 AS ( SELECT t2.SUBJECT_TITLE, t0.COURSE_NUMBER, t2.DEPARTMENT_NAME, DENSE_RANK() OVER (PARTITION BY t1.OFFER_DEPT_CODE ORDER BY t1.OFFER_DEPT_CODE) AS window_column FROM SUBJECT_OFFERED_SUMMARY t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2012SU' AND t2.TOTAL_UNITS > 0 ), dept_counts1 AS ( SELECT DEPARTMENT_NAME, COUNT(*) AS total_subjects FROM SUBJECT_SUMMARY WHERE TERM_CODE = '2012SU' AND TOTAL_UNITS > 0 GROUP BY DEPARTMENT_NAME ), inner_cte2 AS ( SELECT s.COURSE, s.COURSE_DESCRIPTION, s.DEPARTMENT_NAME, s.SCHOOL_NAME, c.PROGRAM_CODE, c.PROGRAM_TITLE, c.CATEGORY_CODE, c.CATEGORY_TITLE, c.FOUR_DIGIT_CODE, c.FOUR_DIGIT_TITLE, MIN(c.WAREHOUSE_LOAD_DATE) OVER (PARTITION BY c.CATEGORY_CODE ORDER BY c.CATEGORY_CODE) AS min_warehouse_load_date FROM SIS_COURSE_DESCRIPTION s JOIN CIP c ON c.PROGRAM_CODE = s.CIP_PROGRAM_CODE WHERE s.DEPARTMENT = 6 ), SchoolTotals2 AS ( SELECT NULL AS COURSE, NULL AS COURSE_DESCRIPTION, NULL AS DEPARTMENT_NAME, SCHOOL_NAME, NULL AS PROGRAM_CODE, NULL AS PROGRAM_TITLE, NULL AS CATEGORY_CODE, NULL AS CATEGORY_TITLE, NULL AS FOUR_DIGIT_CODE, NULL AS FOUR_DIGIT_TITLE, NULL AS min_warehouse_load_date, COUNT(*) AS total_courses FROM inner_cte2 GROUP BY SCHOOL_NAME ) SELECT ic1.SUBJECT_TITLE, ic1.COURSE_NUMBER, ic1.DEPARTMENT_NAME, ic1.window_column, NULL AS total_subjects, ic2.COURSE, ic2.COURSE_DESCRIPTION, ic2.SCHOOL_NAME, ic2.PROGRAM_CODE, ic2.PROGRAM_TITLE, ic2.CATEGORY_CODE, ic2.CATEGORY_TITLE, ic2.FOUR_DIGIT_CODE, ic2.FOUR_DIGIT_TITLE, ic2.min_warehouse_load_date, NULL AS total_courses FROM inner_cte1 ic1 LEFT JOIN SIS_COURSE_DESCRIPTION scd ON ic1.COURSE_NUMBER = scd.COURSE LEFT JOIN inner_cte2 ic2 ON scd.COURSE = ic2.COURSE UNION ALL SELECT NULL, NULL, dc1.DEPARTMENT_NAME, NULL, dc1.total_subjects, s2.COURSE, s2.COURSE_DESCRIPTION, s2.SCHOOL_NAME, s2.PROGRAM_CODE, s2.PROGRAM_TITLE, s2.CATEGORY_CODE, s2.CATEGORY_TITLE, s2.FOUR_DIGIT_CODE, s2.FOUR_DIGIT_TITLE, s2.min_warehouse_load_date, s2.total_courses FROM dept_counts1 dc1 LEFT JOIN SIS_COURSE_DESCRIPTION scd2 ON dc1.DEPARTMENT_NAME = scd2.DEPARTMENT_NAME LEFT JOIN SchoolTotals2 s2 ON scd2.SCHOOL_NAME = s2.SCHOOL_NAME ORDER BY DEPARTMENT_NAME, SCHOOL_NAME, CATEGORY_CODE, SUBJECT_TITLE, COURSE\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject code matched with 2022FA subject\", \"desc\": \"For each subject in a department where the school code and subject title are not null, and for each subject offered in the 2022FA term with total units greater than the average for that term, display the subject code, subject code description, department name, subject title, the number of subjects in the same department, the subject ID, the term description, and the running sum of total units for that academic year, ordered by subject ID. Do not return any rounded answers.\", \"id\": \"dw_3867\", \"name\": \"Subject Code Department Counts Matched with 2022FA Above-Average Unit Running Sums\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SUBJECT_TITLE, t0.DEPARTMENT_CODE FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL ) SELECT inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.DEPARTMENT_NAME, inner_cte.SUBJECT_TITLE, dept_counts.subjects_in_department, inner_cte.DEPARTMENT_CODE FROM inner_cte JOIN ( SELECT t0.DEPARTMENT_CODE, COUNT(*) AS subjects_in_department FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL GROUP BY t0.DEPARTMENT_CODE ) dept_counts ON inner_cte.DEPARTMENT_CODE = dept_counts.DEPARTMENT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t1.DEPARTMENT_NAME, t0.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TOTAL_UNITS FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TERM_CODE = '2022FA' ) SELECT SUBJECT_ID, DEPARTMENT_NAME, TERM_DESCRIPTION, SUM(TOTAL_UNITS) OVER (PARTITION BY ACADEMIC_YEAR ORDER BY SUBJECT_ID) AS window_column, ACADEMIC_YEAR, TOTAL_UNITS FROM inner_cte WHERE TOTAL_UNITS > ( SELECT AVG(TOTAL_UNITS) FROM COURSE_CATALOG_SUBJECT_OFFERED WHERE TERM_CODE = '2022FA' ) ORDER BY SUBJECT_ID ) SELECT subq1.SUBJECT_CODE, subq1.SUBJECT_CODE_DESC, subq1.DEPARTMENT_NAME, subq1.SUBJECT_TITLE, subq1.subjects_in_department, subq2.SUBJECT_ID, subq2.TERM_DESCRIPTION, subq2.window_column FROM subq1 JOIN CIS_COURSE_CATALOG ccc ON subq1.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE JOIN subq2 ON ccc.SUBJECT_ID = subq2.SUBJECT_ID ORDER BY subq2.SUBJECT_ID;\"}, {\"id\": \"dw_4812\", \"name\": \"Top 10 Degree-Granting Department Subject Code and Course Number Combinations by Unique Library Subject Count\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH DeptSubjectStats AS ( SELECT d.DEPARTMENT_NAME, s.SUBJECT_CODE, COUNT(s.SUBJECT_CODE) AS subject_code_count, MIN(d.DEPT_BUDGET_CODE) AS min_dept_budget_code FROM SIS_DEPARTMENT d JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' GROUP BY d.DEPARTMENT_NAME, s.SUBJECT_CODE ), DeptCourseStats AS ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, COUNT(DISTINCT l.LIBRARY_SUBJECT_OFFERED_KEY) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 GROUP BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ) SELECT dss.DEPARTMENT_NAME, dss.SUBJECT_CODE, dss.subject_code_count, dss.min_dept_budget_code, dcs.COURSE_NUMBER, dcs.subject_count, dcs.min_total_units FROM DeptSubjectStats dss JOIN SIS_SUBJECT_CODE ssc ON dss.SUBJECT_CODE = ssc.SUBJECT_CODE JOIN DeptCourseStats dcs ON dss.DEPARTMENT_NAME = dcs.OFFER_DEPT_NAME AND ssc.COURSE_NUMBER = dcs.COURSE_NUMBER ), SubjectMaxEnroll AS ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, ROW_NUMBER() OVER (PARTITION BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ORDER BY s.NUM_ENROLLED_STUDENTS DESC) AS rn FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 ) SELECT ic.DEPARTMENT_NAME, ic.SUBJECT_CODE, ic.subject_code_count, ic.min_dept_budget_code, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sme.SUBJECT_TITLE AS Top_Subject_Title, sme.NUM_ENROLLED_STUDENTS AS Top_Subject_Enrollment FROM inner_cte ic LEFT JOIN SubjectMaxEnroll sme ON ic.DEPARTMENT_NAME = sme.OFFER_DEPT_NAME AND ic.COURSE_NUMBER = sme.COURSE_NUMBER AND sme.rn = 1 ORDER BY ic.subject_count DESC LIMIT 10;\", \"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per top-10 department/subject-code/course-number combination with its highest-enrollment subject\"}], \"not_found\": []}"
    },
    {
