      "role": "tool",
      "tool_call_id": "call_69c5deec169140f391ed5cfa",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per current-term subject matched with 2016SP degree-granting department summary\", \"desc\": \"For each department that both offered subjects in the current SIS term and is a degree-granting department that offered subjects in the term '2016SP', list the department code, offering department name, subject title, responsible faculty name, term description, academic year description, total number of subjects offered per department in the current term, department name, number of subjects offered in 2016SP, and total units for those subjects in 2016SP. Include all columns in the order: department code, offering department name, subject title, responsible faculty name, term description, academic year description, total number of subjects offered per department in the current term, department name, number of subjects offered in 2016SP, and total units for those subjects in 2016SP. Do not return any rounded answers.\", \"id\": \"dw_4231\", \"name\": \"Current SIS Term Department Subjects Matched with 2016SP Degree-Granting Department Unit Totals\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.RESPONSIBLE_FACULTY_NAME, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR_DESC, t0.OFFER_DEPT_CODE, MIN(t0.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.ACADEMIC_YEAR ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t2.TERM_PARAMETER = 'SIS_CURRENT_TERM' ) SELECT inner_cte.OFFER_DEPT_NAME, inner_cte.SUBJECT_TITLE, inner_cte.RESPONSIBLE_FACULTY_NAME, inner_cte.TERM_DESCRIPTION, inner_cte.ACADEMIC_YEAR_DESC, dept_counts.Total_Subjects, inner_cte.OFFER_DEPT_CODE FROM inner_cte JOIN ( SELECT t0.OFFER_DEPT_NAME, t0.OFFER_DEPT_CODE, COUNT(DISTINCT t0.SUBJECT_TITLE) AS Total_Subjects FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t2.TERM_PARAMETER = 'SIS_CURRENT_TERM' GROUP BY t0.OFFER_DEPT_NAME, t0.OFFER_DEPT_CODE ) dept_counts ON inner_cte.OFFER_DEPT_NAME = dept_counts.OFFER_DEPT_NAME AND inner_cte.OFFER_DEPT_CODE = dept_counts.OFFER_DEPT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t2.SUBJECT_ID, dense_rank() OVER (ORDER BY t2.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) window_column FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t2.TERM_CODE = '2016SP' AND t1.IS_DEGREE_GRANTING = 'Y' ), DeptSubjectSummary AS ( SELECT t1.DEPARTMENT_CODE, t1.DEPARTMENT_NAME, COUNT(DISTINCT t2.SUBJECT_ID) AS num_subjects, SUM(t2.TOTAL_UNITS) AS total_units FROM SIS_DEPARTMENT t1 JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t1.IS_DEGREE_GRANTING = 'Y' AND t2.TERM_CODE = '2016SP' GROUP BY t1.DEPARTMENT_CODE, t1.DEPARTMENT_NAME ) SELECT dss.DEPARTMENT_CODE, dss.DEPARTMENT_NAME, dss.num_subjects, dss.total_units FROM DeptSubjectSummary dss UNION ALL SELECT dss.DEPARTMENT_CODE, NULL AS DEPARTMENT_NAME, SUM(dss.num_subjects) AS num_subjects, SUM(dss.total_units) AS total_units FROM DeptSubjectSummary dss GROUP BY dss.DEPARTMENT_CODE ) SELECT s1.OFFER_DEPT_CODE, s1.OFFER_DEPT_NAME, s1.SUBJECT_TITLE, s1.RESPONSIBLE_FACULTY_NAME, s1.TERM_DESCRIPTION, s1.ACADEMIC_YEAR_DESC, s1.Total_Subjects, s2.DEPARTMENT_NAME, s2.num_subjects, s2.total_units FROM subq1 s1 JOIN subq2 s2 ON s1.OFFER_DEPT_CODE = s2.DEPARTMENT_CODE ORDER BY s1.OFFER_DEPT_CODE, s1.SUBJECT_TITLE, s2.DEPARTMENT_NAME\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per degree-granting department that offered Engineering-school subjects in 2021\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of active graduate students with an office location assigned in that department. Do not return any rounded answers.\", \"id\": \"dw_3237\", \"name\": \"2021 Engineering Degree-Granting Department Subject Counts with Active Graduate Student Office Totals\", \"sql\": \"WITH DeptSubjects AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), DeptActiveGradStudents AS ( SELECT m.DEPARTMENT_NAME, m.DEPARTMENT, COUNT(*) AS total_active_grad_students FROM SE_PERSON s JOIN MIT_STUDENT_DIRECTORY m ON s.FULL_NAME = m.FULL_NAME WHERE s.IS_ACTIVE = 'Y' AND m.STUDENT_YEAR = 'G' AND m.OFFICE_LOCATION IS NOT NULL GROUP BY m.DEPARTMENT_NAME, m.DEPARTMENT HAVING COUNT(*) > 0 ) SELECT ds.DEPARTMENT_CODE, ds.DEPARTMENT_NAME, ds.DEPARTMENT_FULL_NAME, ds.subject_count, ds.total_enrollment, dag.total_active_grad_students FROM DeptSubjects ds LEFT JOIN SIS_DEPARTMENT d ON ds.DEPARTMENT_CODE = d.DEPARTMENT_CODE LEFT JOIN DeptActiveGradStudents dag ON d.DEPARTMENT_CODE = dag.DEPARTMENT ORDER BY ds.DEPARTMENT_NAME;\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per 2017FA subject matched with 2022SU subject\", \"desc\": \"For subject offerings in the term '2017FA' with a total number of units greater than 10, display the subject title, department name, school name, and their dense rank considering the current and 2 preceding rows ordered by the department code from the subject code table, along with any matching subject IDs from subjects offered in the term with code '2022SU', their department names, and their dense rank considering the current and 2 preceding rows ordered by the total number of units. Show the subject title, department name, school name, subq1 dense rank, subject ID, subq2 department name, and subq2 dense rank, in that order. Do not return any rounded answers.\", \"id\": \"dw_3861\", \"name\": \"2017FA High-Unit Subjects Dense Rank Matched with 2022SU Unit Dense Ranks\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t2.SUBJECT_TITLE, t1.DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t0.DEPARTMENT_CODE ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column, t2.COURSE_NUMBER FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.SUBJECT_CODE = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.TERM_CODE = '2017FA' AND t2.TOTAL_UNITS > 10 ) SELECT inner_cte.SUBJECT_TITLE, inner_cte.DEPARTMENT_NAME, t0.SCHOOL_NAME, inner_cte.window_column, inner_cte.COURSE_NUMBER FROM inner_cte JOIN SIS_SUBJECT_CODE t0 ON inner_cte.COURSE_NUMBER = t0.COURSE_NUMBER ), subq2 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t1.DEPARTMENT_NAME, t1.TOTAL_UNITS, dense_rank() OVER (ORDER BY t1.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) SELECT inner_cte.SUBJECT_ID, inner_cte.DEPARTMENT_NAME, inner_cte.window_column FROM inner_cte ORDER BY inner_cte.window_column, inner_cte.SUBJECT_ID ) SELECT subq1.SUBJECT_TITLE, subq1.DEPARTMENT_NAME, subq1.SCHOOL_NAME, subq1.window_column AS subq1_dense_rank, subq2.SUBJECT_ID, subq2.DEPARTMENT_NAME AS subq2_DEPARTMENT_NAME, subq2.window_column AS subq2_dense_rank FROM subq1 LEFT JOIN COURSE_CATALOG_SUBJECT_OFFERED cso ON subq1.COURSE_NUMBER = cso.SUBJECT_CODE LEFT JOIN subq2 ON cso.SUBJECT_ID = subq2.SUBJECT_ID ORDER BY subq1.window_column DESC, subq1.SUBJECT_TITLE, subq2.window_column, subq2.SUBJECT_ID;\"}], \"not_found\": []}"
