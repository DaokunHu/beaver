          "id": "call_fd4a87aa04fd46b8b570bf07",
          "type": "function",
          "function": {
            "name": "submit_SQL",
            "arguments": "{\"sql\": \"WITH filtered_buildings AS (\\n    SELECT fb.FCLT_BUILDING_KEY,\\n           fb.BUILDING_NAME,\\n           fb.CAMPUS_SECTOR,\\n           fb.EXT_GROSS_AREA,\\n           SUM(fr.AREA) AS total_room_area\\n    FROM FCLT_ROOMS fr\\n    JOIN FCLT_BUILDING fb ON fr.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY\\n    WHERE fr.MAJOR_USE_DESC IN ('RESIDENT', 'LABS')\\n      AND fb.BUILDING_TYPE = 'ACADEMIC'\\n      AND fb.SITE = 'MIT'\\n      AND fb.OWNERSHIP_TYPE = 'OWNED'\\n      AND fb.FCLT_BUILDING_KEY <> '32'\\n    GROUP BY fb.FCLT_BUILDING_KEY, fb.BUILDING_NAME, fb.CAMPUS_SECTOR, fb.EXT_GROSS_AREA\\n    HAVING SUM(fr.AREA) > 1000\\n)\\nSELECT fb2.BUILDING_NAME,\\n       fbh.FISCAL_PERIOD,\\n       fb2.total_room_area,\\n       SUM(fbh.ASSIGNABLE_AREA) OVER (\\n           PARTITION BY fb2.CAMPUS_SECTOR\\n           ORDER BY fb2.FCLT_BUILDING_KEY, fbh.FISCAL_PERIOD\\n           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\\n       ) AS running_assignable_area,\\n       fb2.EXT_GROSS_AREA\\nFROM filtered_buildings fb2\\nJOIN FCLT_BUILDING_HIST fbh ON fb2.FCLT_BUILDING_KEY = fbh.FCLT_BUILDING_KEY\\nORDER BY fbh.FISCAL_PERIOD, fb2.BUILDING_NAME\"}"
          }
        }
