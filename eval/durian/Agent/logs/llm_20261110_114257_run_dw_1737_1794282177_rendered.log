    {
      "role": "tool",
      "tool_call_id": "call_ca7100f1ec814f8da6729589",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"table_id\": \"LIBRARY_SUBJECT_OFFERED\", \"table_name\": \"LIBRARY_SUBJECT_OFFERED\", \"count\": 28, \"items\": [{\"metric_id\": \"dw_2628\", \"name\": \"Subject Group Max Enrollment and Average Total Units in Term 2019SP\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For each subject group in the term \\\"2019SP\\\", show the subject group ID and the highest number of enrolled students among all subjects in that group, along with the average total units for the group. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3248\", \"name\": \"2024 12-Unit Subjects Matched with Math Library Regular-Term Offerings and 3-Row Max Units\", \"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units that are also offered in the library by the Mathematics department during regular terms, show the subject code, subject number, subject title, department name, term description, the rank of each subject within its department ordered by subject code, the number of enrolled students, offering department name, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3357\", \"name\": \"Reserve Materials Status U Matched with Required Textbooks by Material Key and Year\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each library reserve material detail with material status key 'U', show the reserve catalog key, subject offered key, term code, academic year, term description, tip material key, tip material status key, and the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, along with the corresponding textbook material in the TIP_DETAIL table with material status key 'RQ' that matches on tip material key and academic year, showing the textbook subject offered key, textbook material key, subject ID, textbook academic year, textbook term description, and the row number within each textbook academic year group ordered by term code. Present the results in the order of reserve material academic year descending and textbook row number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3393\", \"name\": \"2014FA Library Subjects with 5+ Enrolled Students by Material Status and Department Min Enrollment\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For subjects with at least 5 enrolled students that are offered by the library in the term with code '2014FA', show the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, row number within each material status group ordered by subject ID, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, ordered by offering department name, material status key, and subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3736\", \"name\": \"Subjects with Required Textbooks and Advance Sign-Up IAP Activities Max Enrollment 12\", \"category\": \"Library Reserve and IAP Activity Comprehensive Analysis\", \"desc\": \"For each subject that both has a material status key of 'RQ' and also has an activity with enrollment type \\\"Advance sign-up required\\\" and a maximum enrollment of 12, show the subject title, the number of enrolled students from the RQ group, the term code from the library reserve material detail, the offer department name, the responsible faculty name, the tip material key, the row number within each tip material status key group ordered by subject title, the activity title, the term code from the IAP subject detail, the maximum enrollment, the term description, the term start date, the number of enrolled students from the IAP group, and the row number within each subject title group ordered by activity title. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3911\", \"name\": \"2014FA Library Subjects Enrollment Rollup by Department with Required Textbook Windowed Record Counts\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For each subject offered by the library in the term with code '2014FA', show the subject ID, subject title, total number of enrolled students, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, as well as the maximum windowed average record count from tip detail records with material status key 'RQ' (using a window of 2 preceding and 2 following rows grouped by financial aid year). Additionally, for each offering department, include a grand total row showing the total number of enrolled students across all its subjects (with nulls for subject ID and subject title), and the corresponding maximum windowed average record count if available. Order the results by offering department name and subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3959\", \"name\": \"2022FA Subjects Running Unit Sums Matched with Advance Sign-Up IAP Activities\", \"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the term with code '2022FA' that also have at least one activity with an enrollment type of \\\"Advance sign-up required\\\" and a maximum enrollment of 12 (where the number of enrolled students is at least 10), show the subject ID, department name, subject term description, the running sum of total units within each academic year, subject title, whether the subject is offered in the fall term, the activity title, activity term code, activity maximum enrollment, activity term description, activity term start date, number of enrolled students in the activity, the offer department name for the activity, the responsible faculty name for the activity, and the row number of the activity within each subject title group, ordered by subject ID and activity title. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4069\", \"name\": \"Advance Sign-Up IAP Activities Max Enrollment 12 Matched with Library Subjects 5+ Enrolled\", \"category\": \"IAP Activity and Library Reserve Comprehensive Analysis\", \"desc\": \"For subjects with an enrollment type of \\\"Advance sign-up required\\\" and a maximum enrollment of 12, and with at least 5 enrolled students, show the subject's activity title, term code, maximum enrollment, term description, term start date, subject title, number of enrolled students, the responsible faculty name, the row number within each subject title group ordered by activity title, the TIP material status key, the ISBN, and the row number within each material status group ordered by subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4566\", \"name\": \"Fall 2024-2025 Subjects with Status-U Library Reserve Materials Ranked per Department\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For each subject offered in the term with the description \\\"Fall Term 2024-2025\\\" that also has more than 0 enrolled students and a material status key of 'U', show the subject offered key, subject title, offering department name, the term description, the rank of each subject within its offering department, the course number, course number description, number of enrolled students, the reserve catalog key, the dense rank over the material status key, and the academic year description, ordered by subject offered key and course number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4583\", \"name\": \"Status-U Reserve Materials Record Count Windows with Catalog Record Counter Statistics\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each library reserve material detail with material status key 'U', show the reserve catalog key, subject offered key, term code, the academic year, the term description, the tip material key, the tip material status key, and the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, along with the average and variance of the record counter for reserve catalog items associated with that material status key where the catalog year is greater than 2000. Additionally, for each result, include the catalog title and catalog author name from the reserve catalog. Present the results ordered by academic year descending and record counter variance descending. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4584\", \"name\": \"Mathematics Library Subjects Above Yearly Average Enrollment in Previous Terms\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For Mathematics department courses with at least 5 enrolled students, show the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, and the average calendar year within each calendar year group ordered by term start date, but only for academic terms where the term status is 'Previous', and only include results where the number of enrolled students is greater than the average number of enrolled students for that academic year. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4658\", \"name\": \"Mathematics Library Subjects 5+ Enrolled in Previous Terms with Faculty and Calendar Attributes\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"Show the Mathematics department courses with at least 5 enrolled students, including the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, the average calendar year within each calendar year group ordered by term start date, and for each course, also display the responsible faculty name and the offer school name, but only for academic terms where the term status is 'Previous'. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4683\", \"name\": \"Current Term Department Enrollments with Library Course Counts and Min Units\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4701\", \"name\": \"Yearly Geometric Mean Reserve Materials per Subject with Fall Term Unit Statistics\", \"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"desc\": \"For each academic year, what is the academic year, academic year description, the geometric mean of the number of library reserve material details per subject offered (considering only records where the material status is 'U' and the academic term is a regular term), the average total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the average number of design units for subjects that are offered in the fall term and have a material status of 'U' in the library reserve? List the results ordered by the geometric mean of materials per subject in descending order, then by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4724\", \"name\": \"Mathematics Library Regular-Term Subjects 3-Row Max Units with Required Material Department Statistics\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4826\", \"name\": \"Status-U Reserve Materials Windowed Year and Record Count Statistics with Normalized Ratio\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each library reserve material with material status key 'U', list the subject ID, library course instructor key, term description, academic year, term start date, the minimum academic year in a window of 3 preceding and 1 following row ordered by library reserve catalog key, the library subject offered key, the tip material key, the tip material status key, the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, and for each, include the academic year description and the last day of final exam from the ACADEMIC_TERMS_ALL table, and calculate the normalized year to average record count ratio (academic year divided by average record count in the window), ordered by the normalized year to average record count ratio descending.\"}, {\"metric_id\": \"dw_4978\", \"name\": \"Status-U Reserve Materials Matched with Required Textbooks Including Term Start and End Dates\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each library reserve material detail with material status key 'U', show the reserve catalog key, subject offered key, term code, academic year, term description, tip material key, tip material status key, and the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, along with the corresponding textbook material in the TIP_DETAIL table with material status key 'RQ' that matches on tip material key and academic year, showing the textbook subject offered key, textbook material key, subject ID, textbook academic year, textbook term description, and the row number within each textbook academic year group ordered by term code. Additionally, for each matching textbook material, include the term start date and term end date from the ACADEMIC_TERMS_ALL table. Present the results in the order of reserve material academic year descending and textbook row number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1288\", \"name\": \"Math IAP Max Enrollment Variance Rollup with Library and TIP Department Enrollment Totals\", \"category\": \"Library Reserve and IAP Activity Comprehensive Analysis\", \"desc\": \"For each academic year, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered in that year by the Mathematics department, considering only activities that require advance sign-up and are not cancelled, and also provide the academic year description? For each department, include a grand total for all activities in the format of (department name, null, total variance and stddev). Additionally, for each such department, provide the department code, the department name, and the total number of enrolled students in both the library and tip subject offerings, but only for those departments where the total number of enrolled students is more than one standard deviation (using STDDEV only and never STDDEV_POP) above the mean total enrolled students across all departments, and restrict your answer to departments whose name is 'Mathematics' (Course 18). Also, for each such department, list the names of the responsible faculty members from both the library and tip subject offerings. The columns to display, in order, are: department name, academic year description, total variance, total standard deviation (using STDDEV only and never STDDEV_POP), department code, department name, total enrolled, library faculty, and tip faculty. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1301\", \"name\": \"Math Yearly Max Total Units with Fall-Term Library Enrollment Stddev and Equivalent Subjects\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"desc\": \"For each academic year, where the maximum number of total units for any Mathematics (Course 18) subject offered in that year is greater than 9 and there are more than 5 Mathematics subjects offered in the fall term, what are the academic year, the maximum total units, the corresponding term description, the subject title, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in library subjects offered during terms in that year, and the average number of equivalent subjects for those library subjects? List the results in order of academic year. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2180\", \"name\": \"2014FA Chemistry Library Subjects Windowed Enrollment with Math Unit Coefficient of Variation and Required Material Counts\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, and for each academic year, also show the academic year and academic year description and the coefficient of variation (using STDDEV only and never STDDEV_POP) of the total units for subjects in the Mathematics department (Course 18) that have more than 0 total units and are offered in terms with a term status indicator of 'P'. Additionally, for each Chemistry subject, include the number of required TIP materials (where TIP_MATERIAL_STATUS_KEY = 'RQ') for that subject in that term. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3436\", \"name\": \"Union of Library Subjects 5+ Enrolled and IAP Activities Max Enrollment 12\", \"category\": \"Library Reserve and IAP Activity Comprehensive Analysis\", \"desc\": \"List all subjects with at least 5 enrolled students, showing the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, and the row number within each material status group ordered by subject ID, as 