            "arguments": "{\"sql\": \"WITH Subjects2024_12Units AS (\\n  SELECT t0.SUBJECT_CODE,\\n         t0.SUBJECT_NUMBER,\\n         t0.SUBJECT_TITLE,\\n         t0.DEPARTMENT_NAME,\\n         t1.TERM_DESCRIPTION,\\n         RANK() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column\\n  FROM COURSE_CATALOG_SUBJECT_OFFERED t0\\n  JOIN ACADEMIC_TERMS t1 ON t0.EFFECTIVE_TERM_CODE = t1.TERM_CODE\\n  JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE\\n  WHERE t0.ACADEMIC_YEAR = 2024\\n    AND t0.TOTAL_UNITS = 12\\n),\\nDeptStats AS (\\n  SELECT tso.OFFER_DEPT_NAME,\\n         AVG(sos.TOTAL_UNITS) AS avg_total_units,\\n         MAX(sos.TOTAL_UNITS) - MIN(sos.TOTAL_UNITS) AS range_total_units,\\n         VARIANCE(sos.TOTAL_UNITS) AS variance_total_units\\n  FROM TIP_SUBJECT_OFFERED tso\\n  JOIN TIP_DETAIL td ON tso.SUBJECT_ID = td.SUBJECT_ID\\n  JOIN SUBJECT_OFFERED_SUMMARY sos ON td.SUBJECT_ID = sos.SUBJECT_ID\\n  WHERE td.TIP_MATERIAL_STATUS_KEY = 'RQ'\\n    AND tso.NUM_ENROLLED_STUDENTS >= 1\\n  GROUP BY tso.OFFER_DEPT_NAME\\n)\\nSELECT s.SUBJECT_CODE,\\n       s.SUBJECT_NUMBER,\\n       s.SUBJECT_TITLE,\\n       s.DEPARTMENT_NAME,\\n       s.TERM_DESCRIPTION,\\n       s.window_column,\\n       d.avg_total_units,\\n       d.range_total_units,\\n       d.variance_total_units\\nFROM Subjects2024_12Units s\\nLEFT JOIN DeptStats d ON s.DEPARTMENT_NAME = d.OFFER_DEPT_NAME\\nORDER BY s.DEPARTMENT_NAME, s.SUBJECT_CODE\"}"
          }
