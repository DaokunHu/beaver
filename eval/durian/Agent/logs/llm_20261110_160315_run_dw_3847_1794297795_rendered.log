    {
      "role": "tool",
      "tool_call_id": "call_9014cc3153bc4dfea1fbe1c7",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 20, \"items_by_type\": {\"metric\": [{\"id\": \"dw_2958\", \"desc\": \"For each academic year, among subjects that are not repeatable, what is the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by each department? List the academic year, department name, average enrollment, variance, and standard deviation (using STDDEV only and never STDDEV_POP), ordered by variance descending. Do not return any rounded answers.\"}, {\"id\": \"dw_3311\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\"}, {\"id\": \"dw_1393\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_1335\", \"desc\": \"List, for each department, either (a) the department's full name, the range and variance of the total units for degree-granting Mathematics department courses offered in the 2008 academic year along with the long course description for each course (with the reason 'Math 2008 Stats'), or (b) the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units) where the average total units is greater than the overall average across all departments (with the reason 'High Avg Units'). Show the columns in the following order: department name, total units range, total units variance, average total units, standard deviation (using STDDEV only and never STDDEV_POP) of total units, long course description, and reason for inclusion. Do not return any rounded answers.\"}, {\"id\": \"dw_2151\", \"desc\": \"For each department that grants degrees (excluding the Biology department), provide the department name, the average and variance of the total units for subjects offered by that department in the 2022 academic year, and, if the department is Political Science, also include for each HGN code the maximum number of lecture units among all subjects in the course catalog and the subject title from the subject offered table for subjects offered in the year 2012 with more than 2 lecture units, as well as the number of enrolled students for those subjects. List the results ordered by the variance of total units in descending order, and for Political Science, by the maximum lecture units in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_3356\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', what are the subject title, the offering department name, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only departments that grant degrees and subjects with a non-null subject code description), and the count of reserved materials? Please provide the subject title, the offering department name, the variance, the standard deviation (using STDDEV only and never STDDEV_POP), and the count of reserved materials, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_2597\", \"desc\": \"For each academic year, what is the description of the academic year, the department name, the average total units for all subjects offered by that department in terms that match that academic year and have a term status indicator of 'P', and the deviation of each department's average total units from the overall average total units for that academic year? Do not return any rounded answers.\"}, {\"id\": \"dw_2272\", \"desc\": \"For the Mathematics department, what is the department name, the average of the total units, the range of the total units, the variance of the total units for courses with total units greater than 0, and for each course level, what is the number of unique students and the minimum CIP program code among their courses, considering only degree-granting departments? Additionally, for each course level, what is the average number of lecture units and the maximum number of lab units for Mathematics courses? Do not return any rounded answers.\"}, {\"id\": \"dw_1023\", \"desc\": \"For each academic year where the Mathematics department has at least one unique subject with subject enrollment number greater than 10, what are the academic year, academic year description, department name, number of unique subjects, minimum total units offered, variance of total units, and standard deviation (using STDDEV only and never STDDEV_POP) of total units for subjects offered in the fall term that are not variable units and are offered by the Mathematics department? Do not return any rounded answers.\"}, {\"id\": \"dw_4640\", \"desc\": \"For each subject offered in the term '2017JA', what is the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code, the coefficient of variation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in the subjects offered by that department (considering only subjects with at least one enrolled student), and the department's school code? Do not return any rounded answers.\"}, {\"id\": \"dw_3078\", \"desc\": \"For each subject title and department name where the total units are greater than 3, give the number of offered sections, the minimum number of enrolled students, and the average lab units for those subjects. Do not return any rounded answers.\"}, {\"id\": \"dw_4184\", \"desc\": \"For each department, show the offer department name, the number of distinct subjects offered by the department in the academic year 2012, and for each subject that was offered in the term \\\"2012SU\\\", display the subject key, subject title, academic year, term description, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, and the deviation of each subject's enrollment number from the average enrollment number for its subject key group, ordered by offer department name and subject key. Do not return any rounded answers.\"}, {\"id\": \"dw_4527\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only subjects with a non-null subject code description), and, for each subject in 2021 offered by these departments in the School of Engineering, list the subject id, subject title, and the number of enrolled students, but only include subjects where the number of enrolled students exceeds the average enrollment for that department in 2021. Do not return any rounded answers.\"}, {\"id\": \"dw_4724\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\"}, {\"id\": \"dw_1350\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\"}, {\"id\": \"dw_1288\", \"desc\": \"For each academic year, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered in that year by the Mathematics department, considering only activities that require advance sign-up and are not cancelled, and also provide the academic year description? For each department, include a grand total for all activities in the format of (department name, null, total variance and stddev). Additionally, for each such department, provide the department code, the department name, and the total number of enrolled students in both the library and tip subject offerings, but only for those departments where the total number of enrolled students is more than one standard deviation (using STDDEV only and never STDDEV_POP) above the mean total enrolled students across all departments, and restrict your answer to departments whose name is 'Mathematics' (Course 18). Also, for each such department, list the names of the responsible faculty members from both the library and tip subject offerings. The columns to display, in order, are: department name, academic year description, total variance, total standard deviation (using STDDEV only and never STDDEV_POP), department code, department name, total enrolled, library faculty, and tip faculty. Do not return any rounded answers.\"}, {\"id\": \"dw_2850\", \"desc\": \"For each term and department, what is the term, department, and the variance of the reserve catalog keys for courses in that department and term where the material status is 'U'? Include subtotals for each term (the corresponding term field is 'SUBTOTAL') and a grand total across all terms (the corresponding term field is 'TOTAL'). Do not repeat the term if it is the same as the previous row. Sort the table by term and department. Do not return any rounded answers.\"}, {\"id\": \"dw_41\", \"desc\": \"For each academic year, provide the academic year description and calculate the average and variance of the total units for subjects offered in terms that are not the current term, have a term status indicator of 'P', are offered by the Mathematics department, and are full term subjects. Do not return any rounded answers.\"}, {\"id\": \"dw_3644\", \"desc\": \"For subjects offered in the 2012SU term with a total of 1 unit, show the subject title from the summary, the course number from the offered table, the subject title from the offered summary, the department name from the summary, the offer department name from the offered summary, the row number within each department name group ordered by subject title from the summary, and for each department, also provide the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student). List the results ordered by department name and row number. Do not return any rounded answers.\"}, {\"id\": \"dw_4061\", \"desc\": \"For each department and academic year, show the department name, academic year, academic year description, and the geometric mean of the total units for all subjects offered by the department in regular terms with total units greater than zero, along with, for each academic building where these subjects are held and which has rooms larger than 40 square meters, the building name, the average, range, and variance of the room areas, as well as the total assignable area of the building and the year the building was built. The results are ordered by department name, academic year (descending), and room area range (descending). Do not return any rounded answers.\"}]}}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_13fb7020a59f49f4acf64b8b",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entity\": {\"id\": \"dw_1954\", \"name\": \"2019FA Chemistry TIP Subjects Windowed Min Enrollment with Department Subject Code Statistics\", \"desc\": \"For subjects offered in the term '2019FA' with more than 0 enrolled students, offered by the Chemistry department (Course 5), and only including courses that have course materials, show the subject title, offering department name, school name, department full name, and the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department name. Additionally, for the same department, provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the number of unique subject codes associated with its courses that are offered by degree-granting departments, but only include departments other than 'Mathematics' (Course 18). Also, for each of these departments, show the total number of courses offered by the department in the '2019FA' term that have at least one enrolled student and have course materials. Present the subject title, offering department name, school name, department full name, windowed minimum enrolled students, department name, average number of unique subject codes, standard deviation (using STDDEV only and never STDDEV_POP) of unique subject codes, and the total number of such courses, in that order. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.OFFER_SCHOOL_NAME, t1.DEPARTMENT_FULL_NAME, MIN(t0.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.DEPARTMENT_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT t2 ON t1.DEPARTMENT_CODE = t2.SIS_ADMIN_DEPARTMENT_CODE WHERE t0.TERM_CODE = '2019FA' AND t0.NUM_ENROLLED_STUDENTS > 0 AND t0.OFFER_DEPT_NAME = 'Chemistry' AND t0.IS_NO_COURSE_MATERIAL = 'N' ), course_counts AS ( SELECT t1.DEPARTMENT_CODE, COUNT(DISTINCT t0.MASTER_COURSE_NUMBER) AS total_courses FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2019FA' AND t0.NUM_ENROLLED_STUDENTS > 0 AND t0.IS_NO_COURSE_MATERIAL = 'N' GROUP BY t1.DEPARTMENT_CODE ), subject_code_stats AS ( SELECT d.DEPARTMENT_NAME, AVG(subj_count) AS avg_subject_codes, STDDEV(subj_count) AS stddev_subject_codes, d.DEPARTMENT_CODE FROM ( SELECT cd.DEPARTMENT, COUNT(DISTINCT sc.SUBJECT_CODE) AS subj_count FROM SIS_COURSE_DESCRIPTION cd JOIN SIS_DEPARTMENT d ON cd.DEPARTMENT = d.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE sc ON d.DEPARTMENT_CODE = sc.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_NAME != 'Mathematics' GROUP BY cd.COURSE, cd.DEPARTMENT ) course_subjects JOIN SIS_DEPARTMENT d ON course_subjects.DEPARTMENT = d.DEPARTMENT_CODE WHERE d.DEPARTMENT_CODE != '18' GROUP BY d.DEPARTMENT_NAME, d.DEPARTMENT_CODE ) SELECT icte.SUBJECT_TITLE, icte.OFFER_DEPT_NAME, icte.OFFER_SCHOOL_NAME, icte.DEPARTMENT_FULL_NAME, icte.window_column, scs.DEPARTMENT_NAME, scs.avg_subject_codes, scs.stddev_subject_codes, cc.total_courses FROM inner_cte icte JOIN subject_code_stats scs ON icte.DEPARTMENT_CODE = scs.DEPARTMENT_CODE JOIN course_counts cc ON icte.DEPARTMENT_CODE = cc.DEPARTMENT_CODE ORDER BY icte.SUBJECT_TITLE, scs.avg_subject_codes DESC\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per 2019FA Chemistry TIP subject with course materials matched with department-level subject code statistics\"}}"
    },
