    {
      "role": "tool",
      "tool_call_id": "call_5f13aa9b20c14f578a4056aa",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject offering\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units in the Mathematics department, show the subject code, subject number, subject title, department name, term description, and the rank of each subject within its department ordered by subject code, along with the department name, school name, the highest number of degree-granting undergraduate courses in the Mathematics department (Course 18), and the subject short title and subject description for each subject. Do not return any rounded answers.\", \"id\": \"dw_2090\", \"name\": \"Math 2024 12-Unit Subjects Ranked with Degree-Granting Undergraduate Course Count\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.SUBJECT_TITLE, t0.DEPARTMENT_NAME, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column, t0.SUBJECT_CODE AS join_subject_code FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.EFFECTIVE_TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2024 AND t0.TOTAL_UNITS = 12 AND t0.DEPARTMENT_NAME = 'Mathematics' ), math_dept_course_count AS ( SELECT DEPARTMENT_NAME, SCHOOL_NAME, COUNT(*) AS num_courses, 'Mathematics' AS join_department_name FROM SIS_COURSE_DESCRIPTION WHERE IS_DEGREE_GRANTING = 'Y' AND COURSE_LEVEL = 'U' AND DEPARTMENT_NAME = 'Mathematics' GROUP BY DEPARTMENT_NAME, SCHOOL_NAME ORDER BY num_courses DESC LIMIT 1 ) SELECT ic.SUBJECT_CODE, ic.SUBJECT_NUMBER, ic.SUBJECT_TITLE, ic.DEPARTMENT_NAME, ic.TERM_DESCRIPTION, ic.window_column, mdc.DEPARTMENT_NAME, mdc.SCHOOL_NAME, mdc.num_courses, cso.SUBJECT_SHORT_TITLE, cso.SUBJECT_DESCRIPTION FROM inner_cte ic CROSS JOIN math_dept_course_count mdc JOIN COURSE_CATALOG_SUBJECT_OFFERED cso ON ic.SUBJECT_CODE = cso.SUBJECT_CODE AND ic.SUBJECT_NUMBER = cso.SUBJECT_NUMBER AND cso.ACADEMIC_YEAR = 2024 AND cso.DEPARTMENT_NAME = 'Mathematics'\"}, {\"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2024 Mathematics 12-unit subject matched with 2019FA TIP offering\", \"desc\": \"For subjects offered in the academic year 2024 with total units equal to 12 in the Mathematics department, show the department code, department name, subject code, subject number, subject title, total units, the row number within each department ordered by subject code, the deviation of each subject's total units from the average total units of all Mathematics subjects offered in 2024, the number of enrolled students, responsible faculty name, school name, and the dense rank over the department name ordered by department name for those subjects that also have course materials and were offered in the term '2019FA'. Sort the table by department name and subject title. Do not return any rounded answers.\", \"id\": \"dw_1758\", \"name\": \"Math 2024 12-Unit Subjects Row Numbers and Unit Deviations Matched with 2019FA TIP Course-Material Offerings\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.DEPARTMENT_CODE, t0.DEPARTMENT_NAME, t1.SUBJECT_CODE, t1.SUBJECT_NUMBER, t1.SUBJECT_TITLE, t1.TOTAL_UNITS, ROW_NUMBER() OVER (PARTITION BY t0.DEPARTMENT_CODE ORDER BY t1.SUBJECT_CODE) AS window_column FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t1.ACADEMIC_YEAR = 2024 AND t1.TOTAL_UNITS = 12 AND t0.DEPARTMENT_NAME = 'Mathematics' ), math_avg AS ( SELECT t0.DEPARTMENT_CODE, AVG(t1.TOTAL_UNITS) AS avg_total_units FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t1.ACADEMIC_YEAR = 2024 AND t0.DEPARTMENT_NAME = 'Mathematics' GROUP BY t0.DEPARTMENT_CODE ) SELECT i.DEPARTMENT_CODE, i.DEPARTMENT_NAME, i.SUBJECT_CODE, i.SUBJECT_NUMBER, i.SUBJECT_TITLE, i.TOTAL_UNITS, i.window_column, (i.TOTAL_UNITS - m.avg_total_units) AS deviation_from_avg FROM inner_cte i JOIN math_avg m ON i.DEPARTMENT_CODE = m.DEPARTMENT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t1.DEPARTMENT_NAME, t1.SCHOOL_NAME, DENSE_RANK() OVER (PARTITION BY t1.DEPARTMENT_NAME ORDER BY t1.DEPARTMENT_NAME) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_COURSE_DESCRIPTION t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT WHERE t0.TERM_CODE = '2019FA' AND t1.DEPARTMENT_NAME = 'Mathematics' AND t0.IS_NO_COURSE_MATERIAL = 'N' ) SELECT CASE WHEN LAG(DEPARTMENT_NAME) OVER (ORDER BY DEPARTMENT_NAME, SUBJECT_TITLE) = DEPARTMENT_NAME THEN NULL ELSE DEPARTMENT_NAME END AS department_name, SUBJECT_TITLE, NUM_ENROLLED_STUDENTS, RESPONSIBLE_FACULTY_NAME, SCHOOL_NAME, window_column FROM inner_cte ORDER BY DEPARTMENT_NAME, SUBJECT_TITLE ) SELECT s1.DEPARTMENT_CODE, s1.DEPARTMENT_NAME, s1.SUBJECT_CODE, s1.SUBJECT_NUMBER, s1.SUBJECT_TITLE, s1.TOTAL_UNITS, s1.window_column AS subject_row_number, s1.deviation_from_avg, s2.NUM_ENROLLED_STUDENTS, s2.RESPONSIBLE_FACULTY_NAME, s2.SCHOOL_NAME, s2.window_column AS department_dense_rank FROM subq1 s1 LEFT JOIN subq2 s2 ON s1.DEPARTMENT_NAME = s2.department_name AND s1.SUBJECT_TITLE = s2.SUBJECT_TITLE ORDER BY s1.DEPARTMENT_NAME, s1.SUBJECT_TITLE;\"}], \"not_found\": []}"
    },
