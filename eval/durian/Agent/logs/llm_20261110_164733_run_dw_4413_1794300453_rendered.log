          "function": {
            "name": "mysql_query",
            "arguments": "{\"sql\": \"SELECT t0.ACTIVITY_TITLE, t0.TERM_CODE, t0.MAX_ENROLLMENT, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t2.SUBJECT_TITLE, t2.NUM_ENROLLED_STUDENTS, t2.OFFER_DEPT_NAME, t2.RESPONSIBLE_FACULTY_NAME, ROW_NUMBER() OVER (PARTITION BY t2.SUBJECT_TITLE ORDER BY t0.ACTIVITY_TITLE) AS window_column, MAX(t3.TIP_MATERIAL_KEY) OVER (PARTITION BY t0.ACTIVITY_TITLE) AS max_course_materials FROM IAP_SUBJECT_DETAIL t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN LIBRARY_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.TERM_CODE JOIN TIP_DETAIL t3 ON t1.TERM_CODE = t3.TERM_CODE WHERE t0.ENROLLMENT_TYPE = 'Advance sign-up required' AND t0.MAX_ENROLLMENT = 12 AND t2.NUM_ENROLLED_STUDENTS >= 10 ORDER BY t2.SUBJECT_TITLE, t0.ACTIVITY_TITLE\"}"
