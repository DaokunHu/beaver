      "content": "{\"ok\": true, \"entity\": {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per course level of the Mathematics department\", \"desc\": \"For the Mathematics department, what is the department name, the average of the total units, the range of the total units, the variance of the total units for courses with total units greater than 0, and for each course level, what is the number of unique students and the minimum CIP program code among their courses, considering only degree-granting departments? Additionally, for each course level, what is the average number of lecture units and the maximum number of lab units for Mathematics courses? Do not return any rounded answers.\", \"id\": \"dw_2272\", \"name\": \"Math Department Unit Statistics with Course Level Student Counts and Lecture-Lab Unit Averages\", \"sql\": \"WITH inner_cte AS ( WITH department_units_stats AS ( SELECT SIS_DEPARTMENT.DEPARTMENT_NAME, AVG(CIS_COURSE_CATALOG.TOTAL_UNITS) AS avg_total_units, MAX(CIS_COURSE_CATALOG.TOTAL_UNITS) - MIN(CIS_COURSE_CATALOG.TOTAL_UNITS) AS total_units_range, VARIANCE(CIS_COURSE_CATALOG.TOTAL_UNITS) AS total_units_variance FROM SIS_DEPARTMENT JOIN CIS_COURSE_CATALOG ON SIS_DEPARTMENT.DEPARTMENT_CODE = CIS_COURSE_CATALOG.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE ON CIS_COURSE_CATALOG.DEPARTMENT_CODE = SIS_SUBJECT_CODE.DEPARTMENT_CODE WHERE CIS_COURSE_CATALOG.TOTAL_UNITS > 0 AND SIS_DEPARTMENT.IS_DEGREE_GRANTING = 'Y' AND SIS_DEPARTMENT.DEPARTMENT_NAME = 'Mathematics' AND SIS_DEPARTMENT.DEPARTMENT_CODE = '18' GROUP BY SIS_DEPARTMENT.DEPARTMENT_NAME ORDER BY total_units_range DESC ), department_student_cip_stats AS ( SELECT sd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT msd.FULL_NAME) AS student_count, MIN(scd.CIP_PROGRAM_CODE) AS min_cip_code FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY sd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT dus.DEPARTMENT_NAME, dus.avg_total_units, dus.total_units_range, dus.total_units_variance, dscs.COURSE_LEVEL, dscs.student_count, dscs.min_cip_code FROM department_units_stats dus JOIN department_student_cip_stats dscs ON dus.DEPARTMENT_NAME = dscs.DEPARTMENT_NAME ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.avg_total_units, inner_cte.total_units_range, inner_cte.total_units_variance, inner_cte.COURSE_LEVEL, inner_cte.student_count, inner_cte.min_cip_code, stats.avg_lecture_units, stats.max_lab_units FROM inner_cte JOIN ( SELECT scd.COURSE_LEVEL, AVG(ccc.LECTURE_UNITS) AS avg_lecture_units, MAX(ccc.LAB_UNITS) AS max_lab_units FROM SIS_COURSE_DESCRIPTION scd JOIN CIS_COURSE_CATALOG ccc ON scd.DEPARTMENT = ccc.DEPARTMENT_CODE WHERE scd.DEPARTMENT_NAME = 'Mathematics' AND ccc.DEPARTMENT_CODE = '18' AND ccc.TOTAL_UNITS > 0 GROUP BY scd.COURSE_LEVEL ) stats ON inner_cte.COURSE_LEVEL = stats.COURSE_LEVEL;\"}}"
