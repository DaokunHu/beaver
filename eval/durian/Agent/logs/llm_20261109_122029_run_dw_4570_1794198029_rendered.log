      "content": "{\"ok\": true, \"entity\": {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per degree-granting department matched with Political Science HGN statistics\", \"desc\": \"For each department that grants degrees (excluding the Biology department), provide the department name, the average and variance of the total units for subjects offered by that department in the 2022 academic year, and, if the department is Political Science, also include for each HGN code the maximum number of lecture units among all subjects in the course catalog and the subject title from the subject offered table for subjects offered in the year 2012 with more than 2 lecture units, as well as the number of enrolled students for those subjects. List the results ordered by the variance of total units in descending order, and for Political Science, by the maximum lecture units in descending order. Do not return any rounded answers.\", \"id\": \"dw_2151\", \"name\": \"Degree-Granting Department 2022 Unit Average-Variance with Political Science HGN Lecture Unit Maximums\", \"sql\": \"WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_units, VARIANCE(s.TOTAL_UNITS) AS units_variance FROM SIS_DEPARTMENT d JOIN COURSE_CATALOG_SUBJECT_OFFERED s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE s.ACADEMIC_YEAR = 2022 AND d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_CODE <> '7' GROUP BY d.DEPARTMENT_NAME ORDER BY units_variance DESC ) , PoliSciHGNStats AS ( SELECT c.HGN_CODE, c.DEPARTMENT_NAME, MAX(c.LECTURE_UNITS) AS max_lecture_units, s.SUBJECT_TITLE, so.NUM_ENROLLED_STUDENTS FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN SUBJECT_OFFERED s ON c.HGN_CODE = s.HGN_CODE JOIN SUBJECT_OFFERED so ON s.SUBJECT_KEY = so.SUBJECT_KEY WHERE c.ACADEMIC_YEAR = 2012 AND c.LECTURE_UNITS > 2 AND c.DEPARTMENT_NAME = 'Political Science' GROUP BY c.HGN_CODE, c.DEPARTMENT_NAME, s.SUBJECT_TITLE, so.NUM_ENROLLED_STUDENTS HAVING MAX(c.LECTURE_UNITS) > 2 ) SELECT d.DEPARTMENT_NAME, d.avg_units, d.units_variance, p.HGN_CODE, p.max_lecture_units, p.SUBJECT_TITLE, p.NUM_ENROLLED_STUDENTS FROM inner_cte d LEFT JOIN PoliSciHGNStats p ON d.DEPARTMENT_NAME = p.DEPARTMENT_NAME ORDER BY d.units_variance DESC, p.max_lecture_units DESC\"}}"
