    {
      "role": "tool",
      "tool_call_id": "call_b7b9c15414264b1b8e9e64c6",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"columns\": {\"SIS_COURSE_DESCRIPTION_KEY\": {\"desc\": \"Surrogate key of the course description record\"}, \"COURSE\": {\"desc\": \"Course/subject code, e.g. '18'; joins to SIS_SUBJECT_CODE.SUBJECT_CODE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"COURSE_DESCRIPTION\": {\"desc\": \"Short course description text; its character length is used in description-length statistics\"}, \"COURSE_DESCRIPTION_LONG\": {\"desc\": \"Long-form course description text\"}, \"DEPARTMENT\": {\"desc\": \"Department code offering the course; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name offering the course\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME\": {\"desc\": \"School name offering the course, e.g. 'Engineering'\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"FROM_TERM\": {\"desc\": \"First term the course description is effective from\"}, \"FROM_TERM_DESCRIPTION\": {\"desc\": \"Description of the from-term\"}, \"THRU_TERM\": {\"desc\": \"Last term the course description is effective through\"}, \"THRU_TERM_DESCRIPTION\": {\"desc\": \"Description of the thru-term\"}, \"COURSE_OPTION\": {\"desc\": \"Course option designation\"}, \"COURSE_LEVEL\": {\"desc\": \"Course level code, e.g. 'U' = undergraduate, 'G' = graduate\"}, \"CIP_PROGRAM_CODE\": {\"desc\": \"Six-digit CIP (Classification of Instructional Programs) program code of the course; joins to CIP.PROGRAM_CODE (current classification, one row per code) and CIP_WITH_VERSION.PROGRAM_CODE (all revision versions)\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the course counts toward a degree\"}, \"DEFAULT_ULTIMATE_DEGREE\": {\"desc\": \"Default ultimate degree awarded for the course\"}, \"GRADAUTE_LEVEL\": {\"desc\": \"Legacy misspelled graduate level column (kept for compatibility)\"}, \"GRADUATE_LEVEL\": {\"desc\": \"Graduate level designation of the course\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per course description\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}, {\"id\": \"MIT_STUDENT_DIRECTORY\", \"name\": \"MIT_STUDENT_DIRECTORY\", \"desc\": \"Student directory table: one row per student with name components, full name, office location and phone, email address, department code and department name, and student year. The DEPARTMENT column stores the academic department code and joins to SIS_DEPARTMENT.DEPARTMENT_CODE, enabling per-department student counts.\", \"columns\": {\"FIRST_NAME\": {\"desc\": \"Student first name\"}, \"MIDDLE_NAME\": {\"desc\": \"Student middle name\"}, \"LAST_NAME\": {\"desc\": \"Student last name\"}, \"FULL_NAME\": {\"desc\": \"Full name in 'Last, First M.' format; counted distinctly for per-department student counts\"}, \"OFFICE_LOCATION\": {\"desc\": \"Building-room office/desk location of the student; same building-room identifier format as EMPLOYEE_DIRECTORY.OFFICE_LOCATION and FCLT_ROOMS.BUILDING_ROOM\"}, \"OFFICE_PHONE\": {\"desc\": \"Student office phone number stored as a numeric value; used in per-department phone average/stddev statistics, typically filtered with OFFICE_PHONE IS NOT NULL since many students have no office phone\"}, \"EMAIL_ADDRESS\": {\"desc\": \"Student email address\"}, \"DEPARTMENT\": {\"desc\": \"Academic department code the student belongs to; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Academic department name of the student, e.g. 'Materials Science and Eng', 'Electrical Eng & Computer Sci'; shares the academic name domain with SIS_DEPARTMENT.DEPARTMENT_NAME, but SE_PERSON.ORGANIZATION may use a different naming variant (e.g. 'Electrical Engineering-Computer Science') for the same unit\"}, \"STUDENT_YEAR\": {\"desc\": \"Student year/level code, e.g. 'G' for graduate\"}, \"FULL_NAME_UPPERCASE\": {\"desc\": \"Uppercase full name\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per student\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}, {\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject offered summary record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject; joins to SIS_SUBJECT_CODE.COURSE_NUMBER and SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'; used for school-level filtering\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"STUDENT_DEPARTMENT\", \"name\": \"STUDENT_DEPARTMENT\", \"desc\": \"Student-facing department lookup table with department code, name, full name, and school attribution (code and name). Similar in content to SIS_DEPARTMENT but oriented to student information systems reporting; joins to offering tables via DEPARTMENT_CODE.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' OFFER_DEPT_CODE and SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to\"}}, \"default_granularity\": \"one row per department\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_f060a481e6e7480aa2675b37",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA subject offering matched with an above-average-last-name EECS student\", \"desc\": \"For subjects offered in the term '2017JA', and for students in the \\\"Electrical Eng & Computer Sci\\\" department whose last name is alphabetically after the average last name (in terms of ASCII value) within their course level group, show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, the minimum number of enrolled students over each subject code group, the school name, department phone number, the student's full name, email address, department name, course description, course level, and the student's row number within their course level group ordered by last name. Order the results by subject code, course level, and student row number within course level. Do not return any rounded answers.\", \"id\": \"dw_3969\", \"name\": \"2017JA Subject Enrollment Windows Matched with Above-Average-Last-Name EECS Student Row Numbers\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column, t1.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ) SELECT inner_cte.SUBJECT_TITLE, inner_cte.NUM_ENROLLED_STUDENTS, inner_cte.OFFER_DEPT_NAME, inner_cte.DEPARTMENT_FULL_NAME, inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.window_column, sd.SCHOOL_NAME, ad.DEPARTMENT_PHONE_NUMBER, inner_cte.DEPARTMENT_CODE FROM inner_cte LEFT JOIN SIS_DEPARTMENT sd ON inner_cte.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t2.FULL_NAME, t2.EMAIL_ADDRESS, t1.DEPARTMENT_NAME, t0.COURSE_DESCRIPTION, t0.COURSE_LEVEL, t2.LAST_NAME, t1.DEPARTMENT_CODE FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT WHERE t1.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' ), avg_lastname_cte AS ( SELECT COURSE_LEVEL, AVG(ASCII(SUBSTR(LAST_NAME, 1, 1))) AS avg_ascii FROM inner_cte GROUP BY COURSE_LEVEL ) SELECT i.FULL_NAME, i.EMAIL_ADDRESS, i.DEPARTMENT_NAME, i.COURSE_DESCRIPTION, i.COURSE_LEVEL, ROW_NUMBER() OVER (PARTITION BY i.COURSE_LEVEL ORDER BY i.LAST_NAME) AS window_column, i.DEPARTMENT_CODE FROM inner_cte i JOIN avg_lastname_cte a ON i.COURSE_LEVEL = a.COURSE_LEVEL WHERE ASCII(SUBSTR(i.LAST_NAME, 1, 1)) > a.avg_ascii ) SELECT s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.OFFER_DEPT_NAME, s1.DEPARTMENT_FULL_NAME, s1.SUBJECT_CODE, s1.SUBJECT_CODE_DESC, s1.window_column AS MIN_NUM_ENROLLED_STUDENTS_OVER_SUBJECT_CODE, s1.SCHOOL_NAME, s1.DEPARTMENT_PHONE_NUMBER, s2.FULL_NAME, s2.EMAIL_ADDRESS, s2.DEPARTMENT_NAME, s2.COURSE_DESCRIPTION, s2.COURSE_LEVEL, s2.window_column AS STUDENT_ROW_NUMBER_WITHIN_COURSE_LEVEL FROM subq1 s1 JOIN subq2 s2 ON s1.DEPARTMENT_CODE = s2.DEPARTMENT_CODE ORDER BY s1.SUBJECT_CODE, s2.COURSE_LEVEL, s2.window_column;\"}, {\"category\": \"Library Reserve and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per 2009SP status-U reserve material matched with an Electrical Eng & Computer Sci course and enrolled student\", \"desc\": \"For each library reserve material detail with material status key 'U' and term code '2009SP', show the course instructor key, reserve catalog key, subject offered key, the responsible faculty name, and the row number within a window of 2 preceding and 1 following rows ordered by the responsible faculty name from the associated subject offered, and for each matching course in the \\\"Electrical Eng & Computer Sci\\\" department, show the course description, course level, the full name and email address of students enrolled, and the row number within each course level group ordered by the student's last name. Do not return any rounded answers.\", \"entity_type\": \"metric\", \"id\": \"dw_4458\", \"name\": \"2009SP Status-U Reserve Materials Windowed Faculty Row Numbers with EECS Course Student Directory Details\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.LIBRARY_COURSE_INSTRUCTOR_KEY, t0.LIBRARY_RESERVE_CATALOG_KEY, t0.LIBRARY_SUBJECT_OFFERED_KEY, t1.RESPONSIBLE_FACULTY_NAME, t0.SUBJECT_ID FROM LIBRARY_RESERVE_MATRL_DETAIL t0 JOIN TIP_SUBJECT_OFFERED t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND t0.TERM_CODE = '2009SP' ) SELECT inner_cte.LIBRARY_COURSE_INSTRUCTOR_KEY, inner_cte.LIBRARY_RESERVE_CATALOG_KEY, inner_cte.LIBRARY_SUBJECT_OFFERED_KEY, inner_cte.RESPONSIBLE_FACULTY_NAME, inner_cte.SUBJECT_ID, ROW_NUMBER() OVER (ORDER BY inner_cte.RESPONSIBLE_FACULTY_NAME ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column FROM inner_cte ), subq2 AS ( WITH inner_cte AS ( SELECT t2.FULL_NAME, t2.EMAIL_ADDRESS, t1.DEPARTMENT_NAME, t0.COURSE_DESCRIPTION, t0.COURSE_LEVEL, t2.DEPARTMENT, ROW_NUMBER() OVER (PARTITION BY t0.COURSE_LEVEL ORDER BY t2.LAST_NAME) AS window_column FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT WHERE t1.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' ) SELECT inner_cte.COURSE_DESCRIPTION, inner_cte.COURSE_LEVEL, inner_cte.FULL_NAME, inner_cte.EMAIL_ADDRESS, inner_cte.DEPARTMENT, inner_cte.window_column FROM inner_cte ORDER BY inner_cte.COURSE_DESCRIPTION, inner_cte.COURSE_LEVEL, inner_cte.window_column ) SELECT s1.LIBRARY_COURSE_INSTRUCTOR_KEY, s1.LIBRARY_RESERVE_CATALOG_KEY, s1.LIBRARY_SUBJECT_OFFERED_KEY, s1.RESPONSIBLE_FACULTY_NAME, s1.window_column AS faculty_window_column, s2.COURSE_DESCRIPTION, s2.COURSE_LEVEL, s2.FULL_NAME, s2.EMAIL_ADDRESS, s2.window_column AS student_window_column FROM subq1 s1 JOIN TIP_SUBJECT_OFFERED tso ON s1.SUBJECT_ID = tso.SUBJECT_ID JOIN SIS_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE JOIN subq2 s2 ON sd.DEPARTMENT_CODE = s2.DEPARTMENT\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per top-10 department subject-code group matched with a Kevin-named Course-6 student course\", \"desc\": \"For the top 10 degree-granting departments (excluding 'Political Science' and Course 17) that have offered at least one subject in the 'Engineering' school, list the department name, school name, subject code description, the total number of subjects they offered, and the average number of enrolled students per subject, and for each such department, show the full names, email addresses, student years, department full names, course descriptions, course levels, the minimum course level in a window of 3 preceding and 1 following row ordered by the student's last name, and the corresponding subject code and subject code description for each course taken by students named 'Kevin' in 'Electrical Eng & Computer Sci' (Course 6). Do not return any rounded answers.\", \"id\": \"dw_1474\", \"name\": \"Top 10 Engineering Degree-Granting Department Subject Counts with Kevin EECS Student Course Windows\", \"sql\": \"WITH TopDepartments AS ( WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, d.SCHOOL_NAME, s.SUBJECT_CODE_DESC, COUNT(sos.SUBJECT_OFFERED_SUMMARY_KEY) AS num_subjects FROM SIS_SUBJECT_CODE s JOIN SIS_DEPARTMENT d ON s.DEPARTMENT_CODE = d.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY sos ON d.DEPARTMENT_CODE = sos.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND sos.OFFER_SCHOOL_NAME = 'Engineering' AND d.DEPARTMENT_NAME <> 'Political Science' AND d.DEPARTMENT_CODE <> '17' GROUP BY d.DEPARTMENT_NAME, d.SCHOOL_NAME, s.SUBJECT_CODE_DESC ) SELECT ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SUBJECT_CODE_DESC, ic.num_subjects, AVG(sos.NUM_ENROLLED_STUDENTS) AS avg_enrollment, d.DEPARTMENT_CODE FROM inner_cte ic JOIN SIS_DEPARTMENT d ON ic.DEPARTMENT_NAME = d.DEPARTMENT_NAME AND ic.SCHOOL_NAME = d.SCHOOL_NAME JOIN SUBJECT_OFFERED_SUMMARY sos ON d.DEPARTMENT_CODE = sos.OFFER_DEPT_CODE GROUP BY ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SUBJECT_CODE_DESC, ic.num_subjects, d.DEPARTMENT_CODE ORDER BY ic.num_subjects DESC LIMIT 10 ), KevinStudents AS ( WITH inner_cte AS ( SELECT t2.FULL_NAME, t2.EMAIL_ADDRESS, t2.STUDENT_YEAR, t1.DEPARTMENT_FULL_NAME, t0.COURSE_DESCRIPTION, t0.COURSE_LEVEL, MIN(t0.COURSE_LEVEL) OVER (ORDER BY t2.LAST_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t0.COURSE, t1.DEPARTMENT_CODE FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT WHERE t2.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' AND t2.FIRST_NAME = 'Kevin' AND t2.DEPARTMENT = '6' ) SELECT inner_cte.FULL_NAME, inner_cte.EMAIL_ADDRESS, inner_cte.STUDENT_YEAR, inner_cte.DEPARTMENT_FULL_NAME, inner_cte.COURSE_DESCRIPTION, inner_cte.COURSE_LEVEL, inner_cte.window_column, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, inner_cte.DEPARTMENT_CODE FROM inner_cte JOIN SIS_SUBJECT_CODE sc ON inner_cte.COURSE = sc.COURSE_NUMBER ) SELECT td.DEPARTMENT_NAME, td.SCHOOL_NAME, td.SUBJECT_CODE_DESC, td.num_subjects, td.avg_enrollment, ks.FULL_NAME, ks.EMAIL_ADDRESS, ks.STUDENT_YEAR, ks.DEPARTMENT_FULL_NAME, ks.COURSE_DESCRIPTION, ks.COURSE_LEVEL, ks.window_column, ks.SUBJECT_CODE, ks.SUBJECT_CODE_DESC FROM TopDepartments td JOIN KevinStudents ks ON td.DEPARTMENT_CODE = ks.DEPARTMENT_CODE ORDER BY td.DEPARTMENT_NAME, ks.FULL_NAME;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level where the course is degree granting and the total units are greater than 6, provide the number of unique courses, the minimum total units offered, and the number of courses where the design units are at least 3. Do not return any rounded answers.\", \"id\": \"dw_3163\", \"name\": \"Degree-Granting Course Level Counts with Min Total Units and Design-Unit Course Counts\", \"sql\": \"WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT scd.COURSE) AS course_count, MIN(ccc.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units, COUNT(DISTINCT CASE WHEN ccc.DESIGN_UNITS >= 3 THEN scd.COURSE END) AS courses_with_design_units_3_or_more FROM inner_cte ic JOIN SIS_COURSE_DESCRIPTION scd ON ic.DEPARTMENT_NAME = scd.DEPARTMENT_NAME AND ic.COURSE_LEVEL = scd.COURSE_LEVEL JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level where the course is degree granting, the total units are greater than 6, and the department is Mathematics (Course 18), provide the department name, course level, number of unique courses, minimum total units offered, school name, number of distinct course options available, and the highest average number of enrolled students in any term for courses offered by that department, considering only courses with more than 0 enrolled students and departments whose name is not null. Do not return any rounded answers.\", \"id\": \"dw_1766\", \"name\": \"Math Degree-Granting Course Level Counts with Min Units, Course Options, and Highest Term Average Library Enrollment\", \"sql\": \"WITH highest_avg_enrollment AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, l.TERM_CODE, AVG(l.NUM_ENROLLED_STUDENTS) AS avg_enrollment_per_term FROM SIS_SUBJECT_CODE s JOIN LIBRARY_SUBJECT_OFFERED l ON s.COURSE_NUMBER = l.COURSE_NUMBER WHERE l.NUM_ENROLLED_STUDENTS > 0 AND s.DEPARTMENT_NAME IS NOT NULL AND s.DEPARTMENT_NAME = 'Mathematics' GROUP BY s.DEPARTMENT_NAME, l.TERM_CODE ) SELECT DEPARTMENT_NAME, MAX(avg_enrollment_per_term) AS highest_avg_enrollment_per_term FROM inner_cte GROUP BY DEPARTMENT_NAME ), course_stats AS ( WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT scd.COURSE) AS course_count, MIN(ccc.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 AND scd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT icte.DEPARTMENT_NAME, icte.COURSE_LEVEL, icte.course_count, icte.min_total_units, scd.SCHOOL_NAME, COUNT(DISTINCT scd.COURSE_OPTION) AS distinct_course_options FROM inner_cte icte JOIN SIS_COURSE_DESCRIPTION scd ON icte.DEPARTMENT_NAME = scd.DEPARTMENT_NAME AND icte.COURSE_LEVEL = scd.COURSE_LEVEL GROUP BY icte.DEPARTMENT_NAME, icte.COURSE_LEVEL, icte.course_count, icte.min_total_units, scd.SCHOOL_NAME ) SELECT cs.DEPARTMENT_NAME, cs.COURSE_LEVEL, cs.course_count, cs.min_total_units, cs.SCHOOL_NAME, cs.distinct_course_options, hae.highest_avg_enrollment_per_term FROM course_stats cs JOIN highest_avg_enrollment hae ON cs.DEPARTMENT_NAME = hae.DEPARTMENT_NAME ORDER BY cs.DEPARTMENT_NAME, cs.COURSE_LEVEL;\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per offer department code of the matched EECS subjects and students\", \"desc\": \"For each subject offered in the 'Engineering' school with total units greater than 0 and only for subjects in the 'Electrical Eng & Computer Sci' department (Course 6), show the subject title, total units, department name, course description, and dense rank over the offer department code ordered by offer department code, along with the first name, last name, department name, student year, corresponding department's full name, administrative department name, and the average department phone number in a window of 2 preceding and 2 following rows grouped by the administrative department name and ordered by the student's first name, for students whose department is '6' and whose department name is 'Electrical Eng & Computer Sci', where the subject's offer department code matches the student's department. Then, for each offer department code, provide the maximum total units among these subjects and the count of distinct student years among the matched students. Do not return any rounded answers.\", \"id\": \"dw_2240\", \"name\": \"EECS Engineering Subject Max Units and Distinct Student Year Counts per Offer Department\", \"sql\": \"WITH inner_cte AS ( WITH subject_summary AS ( SELECT t2.SUBJECT_TITLE, t2.TOTAL_UNITS, t1.DEPARTMENT_NAME, t1.COURSE_DESCRIPTION, DENSE_RANK() OVER (PARTITION BY t2.OFFER_DEPT_CODE ORDER BY t2.OFFER_DEPT_CODE) AS window_column, t2.OFFER_DEPT_CODE FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.SUBJECT_CODE = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.OFFER_SCHOOL_NAME = 'Engineering' AND t2.TOTAL_UNITS > 0 AND t1.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' ), student_summary AS ( SELECT t1.FIRST_NAME, t1.LAST_NAME, t1.DEPARTMENT_NAME, t1.STUDENT_YEAR, t0.DEPARTMENT_FULL_NAME, t2.SIS_ADMIN_DEPARTMENT_NAME, AVG(t2.DEPARTMENT_PHONE_NUMBER) OVER ( PARTITION BY t2.SIS_ADMIN_DEPARTMENT_NAME ORDER BY t1.FIRST_NAME ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t1.DEPARTMENT FROM SIS_DEPARTMENT t0 JOIN MIT_STUDENT_DIRECTORY t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT JOIN SIS_ADMIN_DEPARTMENT t2 ON t1.DEPARTMENT = t2.SIS_ADMIN_DEPARTMENT_CODE WHERE t1.DEPARTMENT = '6' AND t1.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' ) SELECT ss.SUBJECT_TITLE, ss.TOTAL_UNITS, ss.DEPARTMENT_NAME, ss.COURSE_DESCRIPTION, ss.window_column AS subject_window_rank, ss.OFFER_DEPT_CODE, st.FIRST_NAME, st.LAST_NAME, st.DEPARTMENT_NAME AS student_department_name, st.STUDENT_YEAR, st.DEPARTMENT_FULL_NAME, st.SIS_ADMIN_DEPARTMENT_NAME, st.window_column AS student_window_avg_phone FROM subject_summary ss JOIN student_summary st ON ss.OFFER_DEPT_CODE = st.DEPARTMENT ) SELECT OFFER_DEPT_CODE, MAX(TOTAL_UNITS) AS max_total_units, COUNT(DISTINCT student_year) AS distinct_student_years FROM inner_cte GROUP BY OFFER_DEPT_CODE;\"}], \"not_found\": []}"
