            "arguments": "{\"sql\": \"WITH SubjectOfferings AS (\\n    SELECT t0.TIP_SUBJECT_OFFERED_KEY,\\n           t0.SUBJECT_TITLE,\\n           t0.OFFER_DEPT_NAME,\\n           t1.TERM_DESCRIPTION,\\n           RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.TIP_SUBJECT_OFFERED_KEY) AS window_column,\\n           t0.SUBJECT_ID,\\n           t1.TERM_START_DATE,\\n           t1.TERM_END_DATE\\n    FROM TIP_SUBJECT_OFFERED t0\\n    JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE\\n    JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE\\n    WHERE t1.TERM_DESCRIPTION = 'Fall Term 2024-2025'\\n),\\nLibrarySubjectStats AS (\\n    SELECT t1.COURSE_NUMBER,\\n           t1.COURSE_NUMBER_DESC,\\n           t1.NUM_ENROLLED_STUDENTS,\\n           t2.LIBRARY_RESERVE_CATALOG_KEY,\\n           DENSE_RANK() OVER (PARTITION BY t2.LIBRARY_MATERIAL_STATUS_KEY ORDER BY t2.LIBRARY_MATERIAL_STATUS_KEY) AS window_column,\\n           t1.SUBJECT_ID\\n    FROM LIBRARY_SUBJECT_OFFERED t1\\n    JOIN LIBRARY_RESERVE_MATRL_DETAIL t2 ON t1.SUBJECT_ID = t2.SUBJECT_ID\\n    WHERE t1.NUM_ENROLLED_STUDENTS > 0\\n      AND t2.LIBRARY_MATERIAL_STATUS_KEY = 'U'\\n)\\nSELECT so.TIP_SUBJECT_OFFERED_KEY,\\n       so.SUBJECT_TITLE,\\n       so.OFFER_DEPT_NAME,\\n       so.TERM_DESCRIPTION,\\n       so.window_column AS subject_rank_in_dept,\\n       lss.COURSE_NUMBER,\\n       lss.COURSE_NUMBER_DESC,\\n       lss.NUM_ENROLLED_STUDENTS,\\n       lss.LIBRARY_RESERVE_CATALOG_KEY,\\n       lss.window_column AS dense_rank_material_status,\\n       so.TERM_START_DATE,\\n       so.TERM_END_DATE\\nFROM SubjectOfferings so\\nJOIN LibrarySubjectStats lss ON so.SUBJECT_ID = lss.SUBJECT_ID\\nORDER BY so.TIP_SUBJECT_OFFERED_KEY, lss.COURSE_NUMBER\"}"
