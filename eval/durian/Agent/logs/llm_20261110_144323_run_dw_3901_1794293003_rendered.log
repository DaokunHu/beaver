          "function": {
            "name": "submit_SQL",
            "arguments": "{\"sql\": \"WITH inner_cte1 AS (\\n  SELECT t2.SUBJECT_TITLE, t0.COURSE_NUMBER, t2.DEPARTMENT_NAME,\\n         DENSE_RANK() OVER (PARTITION BY t1.OFFER_DEPT_CODE ORDER BY t1.OFFER_DEPT_CODE) AS window_column\\n  FROM SUBJECT_OFFERED_SUMMARY t0\\n  JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE\\n  JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE\\n  WHERE t0.TERM_CODE = '2012SU' AND t2.TOTAL_UNITS > 0\\n),\\ndept_counts1 AS (\\n  SELECT DEPARTMENT_NAME, COUNT(*) AS total_subjects\\n  FROM SUBJECT_SUMMARY\\n  WHERE TERM_CODE = '2012SU' AND TOTAL_UNITS > 0\\n  GROUP BY DEPARTMENT_NAME\\n),\\ninner_cte2 AS (\\n  SELECT s.COURSE, s.COURSE_DESCRIPTION, s.DEPARTMENT_NAME, s.SCHOOL_NAME,\\n         c.PROGRAM_CODE, c.PROGRAM_TITLE, c.CATEGORY_CODE, c.CATEGORY_TITLE,\\n         c.FOUR_DIGIT_CODE, c.FOUR_DIGIT_TITLE,\\n         MIN(c.WAREHOUSE_LOAD_DATE) OVER (PARTITION BY c.CATEGORY_CODE ORDER BY c.CATEGORY_CODE) AS min_warehouse_load_date\\n  FROM SIS_COURSE_DESCRIPTION s\\n  JOIN CIP c ON c.PROGRAM_CODE = s.CIP_PROGRAM_CODE\\n  WHERE s.DEPARTMENT = 6\\n),\\nSchoolTotals2 AS (\\n  SELECT NULL AS COURSE, NULL AS COURSE_DESCRIPTION, NULL AS DEPARTMENT_NAME, SCHOOL_NAME,\\n         NULL AS PROGRAM_CODE, NULL AS PROGRAM_TITLE, NULL AS CATEGORY_CODE, NULL AS CATEGORY_TITLE,\\n         NULL AS FOUR_DIGIT_CODE, NULL AS FOUR_DIGIT_TITLE, NULL AS min_warehouse_load_date,\\n         COUNT(*) AS total_courses\\n  FROM inner_cte2\\n  GROUP BY SCHOOL_NAME\\n)\\nSELECT ic1.SUBJECT_TITLE, ic1.COURSE_NUMBER, ic1.DEPARTMENT_NAME, ic1.window_column,\\n       NULL AS total_subjects, ic2.COURSE, ic2.COURSE_DESCRIPTION, ic2.SCHOOL_NAME,\\n       ic2.PROGRAM_CODE, ic2.PROGRAM_TITLE, ic2.CATEGORY_CODE, ic2.CATEGORY_TITLE,\\n       ic2.FOUR_DIGIT_CODE, ic2.FOUR_DIGIT_TITLE, ic2.min_warehouse_load_date,\\n       NULL AS total_courses\\nFROM inner_cte1 ic1\\nLEFT JOIN SIS_COURSE_DESCRIPTION scd ON ic1.COURSE_NUMBER = scd.COURSE\\nLEFT JOIN inner_cte2 ic2 ON scd.COURSE = ic2.COURSE\\nUNION ALL\\nSELECT NULL, NULL, dc1.DEPARTMENT_NAME, NULL, dc1.total_subjects,\\n       s2.COURSE, s2.COURSE_DESCRIPTION, s2.SCHOOL_NAME, s2.PROGRAM_CODE, s2.PROGRAM_TITLE,\\n       s2.CATEGORY_CODE, s2.CATEGORY_TITLE, s2.FOUR_DIGIT_CODE, s2.FOUR_DIGIT_TITLE,\\n       s2.min_warehouse_load_date, s2.total_courses\\nFROM dept_counts1 dc1\\nLEFT JOIN SIS_COURSE_DESCRIPTION scd2 ON dc1.DEPARTMENT_NAME = scd2.DEPARTMENT_NAME\\nLEFT JOIN SchoolTotals2 s2 ON scd2.SCHOOL_NAME = s2.SCHOOL_NAME\\nORDER BY DEPARTMENT_NAME, SCHOOL_NAME, CATEGORY_CODE, SUBJECT_TITLE, COURSE\"}"
          }
        }
