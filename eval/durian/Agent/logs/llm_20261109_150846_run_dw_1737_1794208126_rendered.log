      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject code matched with 2022FA subject\", \"desc\": \"For each subject in a department where the school code and subject title are not null, and for each subject offered in the 2022FA term with total units greater than the average for that term, display the subject code, subject code description, department name, subject title, the number of subjects in the same department, the subject ID, the term description, and the running sum of total units for that academic year, ordered by subject ID. Do not return any rounded answers.\", \"id\": \"dw_3867\", \"name\": \"Subject Code Department Counts Matched with 2022FA Above-Average Unit Running Sums\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SUBJECT_TITLE, t0.DEPARTMENT_CODE FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL ) SELECT inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.DEPARTMENT_NAME, inner_cte.SUBJECT_TITLE, dept_counts.subjects_in_department, inner_cte.DEPARTMENT_CODE FROM inner_cte JOIN ( SELECT t0.DEPARTMENT_CODE, COUNT(*) AS subjects_in_department FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL GROUP BY t0.DEPARTMENT_CODE ) dept_counts ON inner_cte.DEPARTMENT_CODE = dept_counts.DEPARTMENT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t1.DEPARTMENT_NAME, t0.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TOTAL_UNITS FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TERM_CODE = '2022FA' ) SELECT SUBJECT_ID, DEPARTMENT_NAME, TERM_DESCRIPTION, SUM(TOTAL_UNITS) OVER (PARTITION BY ACADEMIC_YEAR ORDER BY SUBJECT_ID) AS window_column, ACADEMIC_YEAR, TOTAL_UNITS FROM inner_cte WHERE TOTAL_UNITS > ( SELECT AVG(TOTAL_UNITS) FROM COURSE_CATALOG_SUBJECT_OFFERED WHERE TERM_CODE = '2022FA' ) ORDER BY SUBJECT_ID ) SELECT subq1.SUBJECT_CODE, subq1.SUBJECT_CODE_DESC, subq1.DEPARTMENT_NAME, subq1.SUBJECT_TITLE, subq1.subjects_in_department, subq2.SUBJECT_ID, subq2.TERM_DESCRIPTION, subq2.window_column FROM subq1 JOIN CIS_COURSE_CATALOG ccc ON subq1.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE JOIN subq2 ON ccc.SUBJECT_ID = subq2.SUBJECT_ID ORDER BY subq2.SUBJECT_ID;\"}, {\"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA subject per school\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, and the minimum number of enrolled students over each subject code group, as well as the school code, school name, department code, school name from department, department phone number, and the highest running sum of total units for any subject within that school in the 2019FA term (where the subject has more than 1 total unit). Order the results by subject code. Do not return any rounded answers.\", \"id\": \"dw_4308\", \"name\": \"2017JA Subjects Enrollment per Subject Code with 2019FA School Running Unit Sums\", \"sql\": \"WITH inner_cte1 AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column, t1.SCHOOL_CODE, t1.SCHOOL_NAME, t1.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), cte1 AS ( SELECT inner_cte1.SUBJECT_TITLE, inner_cte1.NUM_ENROLLED_STUDENTS, inner_cte1.OFFER_DEPT_NAME, inner_cte1.DEPARTMENT_FULL_NAME, inner_cte1.SUBJECT_CODE, inner_cte1.SUBJECT_CODE_DESC, inner_cte1.window_column, inner_cte1.SCHOOL_CODE, inner_cte1.SCHOOL_NAME, inner_cte1.DEPARTMENT_CODE, sd.SCHOOL_NAME AS SCHOOL_NAME_DEPT, ad.DEPARTMENT_PHONE_NUMBER FROM inner_cte1 LEFT JOIN SIS_DEPARTMENT sd ON inner_cte1.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), inner_cte2 AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.SCHOOL_CODE, t1.SCHOOL_NAME, SUM(t1.TOTAL_UNITS) OVER (PARTITION BY t1.SCHOOL_CODE ORDER BY t1.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_CODE = '2019FA' AND t1.TOTAL_UNITS > 1 ), cte2 AS ( SELECT SCHOOL_CODE, SCHOOL_NAME, MAX(window_column) AS highest_running_sum_total_units FROM inner_cte2 GROUP BY SCHOOL_CODE, SCHOOL_NAME ) SELECT cte1.SUBJECT_TITLE, cte1.NUM_ENROLLED_STUDENTS, cte1.OFFER_DEPT_NAME, cte1.DEPARTMENT_FULL_NAME, cte1.SUBJECT_CODE, cte1.SUBJECT_CODE_DESC, cte1.window_column, cte1.SCHOOL_CODE, cte1.SCHOOL_NAME, cte1.DEPARTMENT_CODE, cte1.SCHOOL_NAME_DEPT, cte1.DEPARTMENT_PHONE_NUMBER, cte2.highest_running_sum_total_units FROM cte1 JOIN cte2 ON cte1.SCHOOL_CODE = cte2.SCHOOL_CODE ORDER BY cte1.SUBJECT_CODE;\"}, {\"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per 2024 subject paired with same-department 2019FA subject\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units, and for subjects offered in the term 2019FA from the same department, show the subject code, subject number, subject title, department name, term description, the rank of each 2024 subject within its department ordered by subject code, the 2019FA subject ID, number of enrolled students in 2019FA, department full name, and the row number of each 2019FA subject within its department name group ordered by subject ID. Order the results by department name, subject code, and 2019FA subject ID. Do not return any rounded answers.\", \"id\": \"dw_3635\", \"name\": \"2024 12-Unit Subjects Matched with Same-Department 2019FA Offerings and Enrollment\", \"sql\": \"WITH Subjects2024_12Units AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.SUBJECT_TITLE, t0.DEPARTMENT_NAME, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.EFFECTIVE_TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2024 AND t0.TOTAL_UNITS = 12 ), Subjects2019FA AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t1.DEPARTMENT_NAME, t1.DEPARTMENT_FULL_NAME, ROW_NUMBER() OVER (PARTITION BY t1.DEPARTMENT_NAME ORDER BY t0.SUBJECT_ID) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2019FA' ) SELECT s24.SUBJECT_CODE, s24.SUBJECT_NUMBER, s24.SUBJECT_TITLE, s24.DEPARTMENT_NAME, s24.TERM_DESCRIPTION, s24.window_column AS department_rank_2024, s19.SUBJECT_ID, s19.NUM_ENROLLED_STUDENTS, s19.DEPARTMENT_FULL_NAME, s19.window_column AS department_rownum_2019 FROM Subjects2024_12Units s24 JOIN Subjects2019FA s19 ON s24.DEPARTMENT_NAME = s19.DEPARTMENT_NAME ORDER BY s24.DEPARTMENT_NAME, s24.SUBJECT_CODE, s19.SUBJECT_ID;\"}], \"not_found\": []}"
