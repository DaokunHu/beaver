      "tool_call_id": "call_c9acb738116842cfa9286809",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per current-term subject matched with 2016SP degree-granting department summary\", \"desc\": \"For each department that both offered subjects in the current SIS term and is a degree-granting department that offered subjects in the term '2016SP', list the department code, offering department name, subject title, responsible faculty name, term description, academic year description, total number of subjects offered per department in the current term, department name, number of subjects offered in 2016SP, and total units for those subjects in 2016SP. Include all columns in the order: department code, offering department name, subject title, responsible faculty name, term description, academic year description, total number of subjects offered per department in the current term, department name, number of subjects offered in 2016SP, and total units for those subjects in 2016SP. Do not return any rounded answers.\", \"id\": \"dw_4231\", \"name\": \"Current SIS Term Department Subjects Matched with 2016SP Degree-Granting Department Unit Totals\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.RESPONSIBLE_FACULTY_NAME, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR_DESC, t0.OFFER_DEPT_CODE, MIN(t0.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.ACADEMIC_YEAR ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t2.TERM_PARAMETER = 'SIS_CURRENT_TERM' ) SELECT inner_cte.OFFER_DEPT_NAME, inner_cte.SUBJECT_TITLE, inner_cte.RESPONSIBLE_FACULTY_NAME, inner_cte.TERM_DESCRIPTION, inner_cte.ACADEMIC_YEAR_DESC, dept_counts.Total_Subjects, inner_cte.OFFER_DEPT_CODE FROM inner_cte JOIN ( SELECT t0.OFFER_DEPT_NAME, t0.OFFER_DEPT_CODE, COUNT(DISTINCT t0.SUBJECT_TITLE) AS Total_Subjects FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS_ALL t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t2.TERM_PARAMETER = 'SIS_CURRENT_TERM' GROUP BY t0.OFFER_DEPT_NAME, t0.OFFER_DEPT_CODE ) dept_counts ON inner_cte.OFFER_DEPT_NAME = dept_counts.OFFER_DEPT_NAME AND inner_cte.OFFER_DEPT_CODE = dept_counts.OFFER_DEPT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t2.SUBJECT_ID, dense_rank() OVER (ORDER BY t2.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) window_column FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t2.TERM_CODE = '2016SP' AND t1.IS_DEGREE_GRANTING = 'Y' ), DeptSubjectSummary AS ( SELECT t1.DEPARTMENT_CODE, t1.DEPARTMENT_NAME, COUNT(DISTINCT t2.SUBJECT_ID) AS num_subjects, SUM(t2.TOTAL_UNITS) AS total_units FROM SIS_DEPARTMENT t1 JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t1.IS_DEGREE_GRANTING = 'Y' AND t2.TERM_CODE = '2016SP' GROUP BY t1.DEPARTMENT_CODE, t1.DEPARTMENT_NAME ) SELECT dss.DEPARTMENT_CODE, dss.DEPARTMENT_NAME, dss.num_subjects, dss.total_units FROM DeptSubjectSummary dss UNION ALL SELECT dss.DEPARTMENT_CODE, NULL AS DEPARTMENT_NAME, SUM(dss.num_subjects) AS num_subjects, SUM(dss.total_units) AS total_units FROM DeptSubjectSummary dss GROUP BY dss.DEPARTMENT_CODE ) SELECT s1.OFFER_DEPT_CODE, s1.OFFER_DEPT_NAME, s1.SUBJECT_TITLE, s1.RESPONSIBLE_FACULTY_NAME, s1.TERM_DESCRIPTION, s1.ACADEMIC_YEAR_DESC, s1.Total_Subjects, s2.DEPARTMENT_NAME, s2.num_subjects, s2.total_units FROM subq1 s1 JOIN subq2 s2 ON s1.OFFER_DEPT_CODE = s2.DEPARTMENT_CODE ORDER BY s1.OFFER_DEPT_CODE, s1.SUBJECT_TITLE, s2.DEPARTMENT_NAME\"}, {\"category\": \"Subject Offering Analysis\", \"default_granularity\": \"one row per subject in academic year 2012 with section 0 and cluster type S\", \"desc\": \"For subjects offered in the academic year 2012 that also have a section ID of 0 and a cluster type of 'S', show the subject key, subject title, offer department name, academic year, term description, the total number of subjects offered by each department in that year, the row number within each offer department name group ordered by subject key, the department name from SUBJECT_SUMMARY, the term start date from ACADEMIC_TERMS, and the row number within a window of 2 preceding and 1 following rows ordered by the subject title from SUBJECT_OFFERED. List the results in order by offer department name and subject key. Do not return any rounded answers.\", \"id\": \"dw_4130\", \"name\": \"2012 Section-0 Cluster-S Subjects with Department Counts and Windowed Row Numbers\", \"sql\": \"WITH Subquery1 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_KEY, t1.SUBJECT_TITLE, t1.OFFER_DEPT_NAME, t0.ACADEMIC_YEAR, t0.TERM_DESCRIPTION, ROW_NUMBER() OVER (PARTITION BY t1.OFFER_DEPT_NAME ORDER BY t1.SUBJECT_KEY) AS window_column, t1.TERM_CODE FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2012 ) SELECT i.SUBJECT_KEY, i.SUBJECT_TITLE, i.OFFER_DEPT_NAME, i.ACADEMIC_YEAR, i.TERM_DESCRIPTION, d.dept_subject_count, i.window_column, i.TERM_CODE FROM inner_cte i JOIN ( SELECT OFFER_DEPT_NAME, COUNT(*) AS dept_subject_count FROM SUBJECT_OFFERED so JOIN ACADEMIC_TERMS_ALL at ON so.TERM_CODE = at.TERM_CODE WHERE at.ACADEMIC_YEAR = 2012 GROUP BY OFFER_DEPT_NAME ) d ON i.OFFER_DEPT_NAME = d.OFFER_DEPT_NAME ), Subquery2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t2.TERM_DESCRIPTION, ROW_NUMBER() OVER (ORDER BY t0.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t0.TERM_CODE FROM SUBJECT_OFFERED t0 JOIN SUBJECT_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.SECTION_ID = 0 AND t0.CLUSTER_TYPE = 'S' ) SELECT inner_cte.SUBJECT_TITLE, inner_cte.DEPARTMENT_NAME, inner_cte.TERM_DESCRIPTION, t3.TERM_START_DATE, inner_cte.window_column, inner_cte.TERM_CODE FROM inner_cte JOIN ACADEMIC_TERMS t3 ON inner_cte.TERM_CODE = t3.TERM_CODE ) SELECT s1.SUBJECT_KEY, s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME, s1.ACADEMIC_YEAR, s1.TERM_DESCRIPTION, s1.dept_subject_count, s1.window_column AS dept_window_number, s2.DEPARTMENT_NAME, s2.TERM_START_DATE, s2.window_column AS cluster_window_number FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.SUBJECT_TITLE = s2.SUBJECT_TITLE AND s1.TERM_CODE = s2.TERM_CODE ORDER BY s1.OFFER_DEPT_NAME, s1.SUBJECT_KEY;\"}], \"not_found\": []}"
