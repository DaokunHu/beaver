    {
      "role": "tool",
      "tool_call_id": "call_68466dfa778f48099913f0c7",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entity\": {\"id\": \"dw_1302\", \"name\": \"Engineering Degree-Granting Department 2007 Course Rollup with Department Unit Totals and Latest-Year Course Counts\", \"desc\": \"For each course offered by a degree-granting department in the School of Engineering, except for the Electrical Engineering and Computer Science department, in the 2007 academic year, what is the course key, course name, department name, the number of catalog subjects, the total units for those subjects, and for each department, include a grand total for all courses in the format of (null, null, department name, total subjects, total units)? Additionally, for each such department, what is the total number of units for courses in the \\\"Engineering\\\" or \\\"Non-MIT\\\" schools (where the total units for the department is greater than 1000 and the department is not \\\"Political Science\\\"), and how many distinct courses did the department offer in the most recent academic year available? Present the results as: course key, course name, department name, number of catalog subjects, total units for those subjects, department total units, and number of distinct courses in the latest year, in that order. Do not return any rounded answers.\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT scd.SIS_COURSE_DESCRIPTION_KEY, scd.COURSE, sd.DEPARTMENT_NAME, COUNT(ccc.SUBJECT_ID) AS subject_count, SUM(ccc.TOTAL_UNITS) AS total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.SCHOOL_NAME = 'Engineering' AND ccc.ACADEMIC_YEAR = '2007' AND sd.DEPARTMENT_NAME != 'Electrical Eng & Computer Sci' GROUP BY scd.SIS_COURSE_DESCRIPTION_KEY, scd.COURSE, sd.DEPARTMENT_NAME ) SELECT CASE WHEN GROUPING(SIS_COURSE_DESCRIPTION_KEY) = 1 THEN NULL ELSE SIS_COURSE_DESCRIPTION_KEY END AS SIS_COURSE_DESCRIPTION_KEY, CASE WHEN GROUPING(COURSE) = 1 THEN NULL ELSE COURSE END AS COURSE, DEPARTMENT_NAME, SUM(subject_count) AS subject_count, SUM(total_units) AS total_units FROM inner_cte GROUP BY DEPARTMENT_NAME, SIS_COURSE_DESCRIPTION_KEY, COURSE WITH ROLLUP HAVING SUM(subject_count) > 0 ORDER BY DEPARTMENT_NAME, SIS_COURSE_DESCRIPTION_KEY ), subq2 AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, SUM(c.TOTAL_UNITS) AS total_units FROM SIS_SUBJECT_CODE s JOIN CIS_COURSE_CATALOG c ON s.SUBJECT_CODE = c.SUBJECT_CODE WHERE s.SCHOOL_NAME IN ('Engineering', 'Non-MIT') AND s.DEPARTMENT_NAME <> 'Political Science' GROUP BY s.DEPARTMENT_NAME HAVING SUM(c.TOTAL_UNITS) > 1000 ) SELECT ic.DEPARTMENT_NAME, ic.total_units, COUNT(DISTINCT c.SUBJECT_NUMBER) AS num_courses_latest_year FROM inner_cte ic JOIN SIS_SUBJECT_CODE s ON ic.DEPARTMENT_NAME = s.DEPARTMENT_NAME JOIN CIS_COURSE_CATALOG c ON s.SUBJECT_CODE = c.SUBJECT_CODE WHERE c.ACADEMIC_YEAR = ( SELECT MAX(ACADEMIC_YEAR) FROM CIS_COURSE_CATALOG ) GROUP BY ic.DEPARTMENT_NAME, ic.total_units ) SELECT s1.SIS_COURSE_DESCRIPTION_KEY, s1.COURSE, s1.DEPARTMENT_NAME, s1.subject_count, s1.total_units, s2.total_units AS department_total_units, s2.num_courses_latest_year FROM subq1 s1 JOIN subq2 s2 ON s1.DEPARTMENT_NAME = s2.DEPARTMENT_NAME ORDER BY s1.DEPARTMENT_NAME, s1.SIS_COURSE_DESCRIPTION_KEY ;\", \"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per course per Engineering degree-granting department plus rollup totals\"}}"
