      "tool_call_id": "call_faad248e9ec34c2caeba93fe",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per top-enrolled Fall 2024-2025 subject in high-average-unit departments\", \"desc\": \"For the top 10 subjects offered in the term with the description \\\"Fall Term 2024-2025\\\" that have the highest number of enrolled students, display each subject's offered key, subject title, offering department name, the term description, the number of enrolled students, and the rank of each subject within its offering department (ordered by subject offered key), but only include subjects where the offering department is among those that, in the term with code '2022SU', had an average total units for their subjects greater than the average total units for all subjects offered in that term. List the subject offered key, subject title, offering department name, term description, number of enrolled students, and the rank within the department, in that order, and order the results by department name and number of enrolled students descending. Do not return any rounded answers.\", \"id\": \"dw_4305\", \"name\": \"Top 10 Fall 2024-2025 Enrolled Subjects in Departments with Above-Average 2022SU Units\", \"sql\": \"WITH TopSubjects AS ( WITH inner_cte AS ( SELECT t0.TIP_SUBJECT_OFFERED_KEY, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t0.NUM_ENROLLED_STUDENTS, RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.TIP_SUBJECT_OFFERED_KEY) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_DESCRIPTION = 'Fall Term 2024-2025' ) SELECT icte.TIP_SUBJECT_OFFERED_KEY, icte.SUBJECT_TITLE, icte.OFFER_DEPT_NAME, icte.TERM_DESCRIPTION, icte.NUM_ENROLLED_STUDENTS, icte.window_column FROM inner_cte icte ORDER BY icte.NUM_ENROLLED_STUDENTS DESC LIMIT 10 ), HighAvgUnitDepartments AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, dense_rank() OVER (ORDER BY t1.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) SELECT t2.DEPARTMENT_NAME, AVG(t2.TOTAL_UNITS) AS avg_total_units FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t0.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2022SU' GROUP BY t2.DEPARTMENT_NAME HAVING AVG(t2.TOTAL_UNITS) > ( SELECT AVG(t3.TOTAL_UNITS) FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t3 ON t0.TERM_CODE = t3.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) ) SELECT ts.TIP_SUBJECT_OFFERED_KEY, ts.SUBJECT_TITLE, ts.OFFER_DEPT_NAME, ts.TERM_DESCRIPTION, ts.NUM_ENROLLED_STUDENTS, ts.window_column FROM TopSubjects ts WHERE ts.OFFER_DEPT_NAME IN (SELECT had.DEPARTMENT_NAME FROM HighAvgUnitDepartments had) ORDER BY ts.OFFER_DEPT_NAME, ts.NUM_ENROLLED_STUDENTS DESC;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per school per description status plus rollup totals matched with 2022SU subjects\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name (from subject code), school name, the number of subject codes per school name and whether the subject code description is present ('Has Description') or missing ('No Description'), and for each matching department in subjects offered in the term with code '2022SU', show the subject's ID, total units, department name (from subject offered), and their dense rank considering the current and 2 preceding rows ordered by the total number of units. For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes, null, null, null, null). Do not return any rounded answers.\", \"id\": \"dw_3904\", \"name\": \"Degree-Granting Subject Code Description Status Rollup by School with 2022SU Unit Dense Ranks\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' ), SubjectCodeVisibility AS ( SELECT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, CASE WHEN SUBJECT_CODE_DESC IS NOT NULL AND SUBJECT_CODE_DESC <> 'nan' THEN 'Has Description' ELSE 'No Description' END AS description_status FROM inner_cte1 ), RollupResults AS ( SELECT SCHOOL_NAME, description_status, COUNT(*) AS total_subject_codes FROM SubjectCodeVisibility GROUP BY SCHOOL_NAME, description_status WITH ROLLUP HAVING COUNT(*) > 0 ), inner_cte2 AS ( SELECT t1.SUBJECT_ID, t1.TOTAL_UNITS, t1.DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t1.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) SELECT scv.SUBJECT_CODE, scv.SUBJECT_CODE_DESC, scv.DEPARTMENT_NAME AS SCV_DEPARTMENT_NAME, rr.SCHOOL_NAME, rr.description_status, rr.total_subject_codes, ic2.SUBJECT_ID, ic2.TOTAL_UNITS, ic2.DEPARTMENT_NAME AS IC2_DEPARTMENT_NAME, ic2.window_column FROM RollupResults rr LEFT JOIN ( SELECT DISTINCT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, description_status FROM SubjectCodeVisibility ) scv ON rr.SCHOOL_NAME = scv.SCHOOL_NAME AND rr.description_status = scv.description_status LEFT JOIN inner_cte2 ic2 ON scv.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME ORDER BY rr.SCHOOL_NAME, rr.description_status, ic2.TOTAL_UNITS DESC\"}, {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject\", \"desc\": \"For subjects offered in the 2019FA term that have total units greater than 1, show the subject title, the dense rank of each subject considering the current and 2 preceding rows ordered by the academic year, the subject ID, the department name, and the running sum of total units within each school ordered by subject ID. Do not return any rounded answers.\", \"id\": \"dw_3280\", \"name\": \"2019FA Subjects Dense Rank by Academic Year and School Running Sum of Total Units\", \"sql\": \"WITH subq1 AS ( SELECT t0.SUBJECT_TITLE, t0.SUBJECT_ID, dense_rank() OVER (ORDER BY t1.ACADEMIC_YEAR ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2019FA' ), subq2 AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, SUM(t1.TOTAL_UNITS) OVER (PARTITION BY t1.SCHOOL_CODE ORDER BY t1.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_CODE = '2019FA' AND t1.TOTAL_UNITS > 1 ) SELECT s1.SUBJECT_TITLE, s1.window_column AS subject_dense_rank, s2.SUBJECT_ID, s2.DEPARTMENT_NAME, s2.window_column AS running_sum_total_units FROM subq1 s1 JOIN subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID ORDER BY s2.SUBJECT_ID;\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_878fb7b60de9432fb653a9e1",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 15, \"items_by_type\": {\"metric\": [{\"id\": \"dw_2597\", \"desc\": \"For each academic year, what is the description of the academic year, the department name, the average total units for all subjects offered by that department in terms that match that academic year and have a term status indicator of 'P', and the deviation of each department's average total units from the overall average total units for that academic year? Do not return any rounded answers.\"}, {\"id\": \"dw_3867\", \"desc\": \"For each subject in a department where the school code and subject title are not null, and for each subject offered in the 2022FA term with total units greater than the average for that term, display the subject code, subject code description, department name, subject title, the number of subjects in the same department, the subject ID, the term description, and the running sum of total units for that academic year, ordered by subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_1393\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\"}, {\"id\": \"dw_3493\", \"desc\": \"For subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook, show the subject code, subject number, department name, subject title, term description, total units, the average subject enrollment number in a window of 2 preceding and 2 following rows grouped by department code and ordered by total units, the textbook material key, the textbook material status key, and the row number of the course within each department ordered by subject code. List the results in order by department name, subject code, and subject number. Do not return any rounded answers.\"}, {\"id\": \"dw_41\", \"desc\": \"For each academic year, provide the academic year description and calculate the average and variance of the total units for subjects offered in terms that are not the current term, have a term status indicator of 'P', are offered by the Mathematics department, and are full term subjects. Do not return any rounded answers.\"}, {\"id\": \"dw_4812\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_3644\", \"desc\": \"For subjects offered in the 2012SU term with a total of 1 unit, show the subject title from the summary, the course number from the offered table, the subject title from the offered summary, the department name from the summary, the offer department name from the offered summary, the row number within each department name group ordered by subject title from the summary, and for each department, also provide the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student). List the results ordered by department name and row number. Do not return any rounded answers.\"}, {\"id\": \"dw_3417\", \"desc\": \"For each academic term where the term status indicator is 'P', show the term code, the term parameter, the term description, the academic year, the term start date, and the average academic year in a window of 2 preceding and 2 following rows grouped by the term indicator and ordered by the term start date. Additionally, for the academic year of each such term, give the academic year description, the average total units, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in regular terms, with the results ordered by term code and by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\"}, {\"id\": \"dw_4061\", \"desc\": \"For each department and academic year, show the department name, academic year, academic year description, and the geometric mean of the total units for all subjects offered by the department in regular terms with total units greater than zero, along with, for each academic building where these subjects are held and which has rooms larger than 40 square meters, the building name, the average, range, and variance of the room areas, as well as the total assignable area of the building and the year the building was built. The results are ordered by department name, academic year (descending), and room area range (descending). Do not return any rounded answers.\"}, {\"id\": \"dw_3904\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name (from subject code), school name, the number of subject codes per school name and whether the subject code description is present ('Has Description') or missing ('No Description'), and for each matching department in subjects offered in the term with code '2022SU', show the subject's ID, total units, department name (from subject offered), and their dense rank considering the current and 2 preceding rows ordered by the total number of units. For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes, null, null, null, null). Do not return any rounded answers.\"}, {\"id\": \"dw_4683\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\"}, {\"id\": \"dw_4387\", \"desc\": \"For each department in the School of Engineering with total student enrollment in its courses greater than the average total enrollment across all Engineering departments (and with total enrollment greater than 50), display the department name, the total number of students enrolled in its courses, and the highest average total units for subjects it has ever offered in a regular academic term, listing the results in descending order of total enrollment. Do not return any rounded answers.\"}, {\"id\": \"dw_3989\", \"desc\": \"For each department and each subject offered in the academic year 2024, show the department name, subject code, subject number, subject title, term code, term description, and the highest minimum total units (in a window of 3 preceding and 1 following row ordered by academic year) for that subject, along with the course description, subject code description, and the difference between the number of characters in the course description and the average number of characters in course descriptions for that department, for courses in the School of Engineering that are degree granting. Do not return any rounded answers.\"}, {\"id\": \"dw_3078\", \"desc\": \"For each subject title and department name where the total units are greater than 3, give the number of offered sections, the minimum number of enrolled students, and the average lab units for those subjects. Do not return any rounded answers.\"}, {\"id\": \"dw_4184\", \"desc\": \"For each department, show the offer department name, the number of distinct subjects offered by the department in the academic year 2012, and for each subject that was offered in the term \\\"2012SU\\\", display the subject key, subject title, academic year, term description, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, and the deviation of each subject's enrollment number from the average enrollment number for its subject key group, ordered by offer department name and subject key. Do not return any rounded answers.\"}]}}"
    },
