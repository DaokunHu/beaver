    {
      "role": "tool",
      "tool_call_id": "call_b672bd2338fc4f1fa02755be",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA subject matched with 2022FA catalog subject in same department\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, and the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code. Additionally, for subjects offered in the term with code '2022FA' in the same department, provide the subject ID, department name, term description, the running sum of total units within each academic year ordered by subject ID, and the subject's short title and responsible faculty name from the course catalog. Do not return any rounded answers.\", \"id\": \"dw_5103\", \"name\": \"2017JA TIP Subjects Enrollment Windows Matched with 2022FA Catalog Running Unit Sums per Department\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, MIN(t0.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.DEPARTMENT_CODE ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), Subq2 AS ( SELECT t1.SUBJECT_ID, t1.DEPARTMENT_NAME, t0.TERM_DESCRIPTION, SUM(t1.TOTAL_UNITS) OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t1.SUBJECT_ID) AS running_sum_total_units, t1.DEPARTMENT_CODE, t1.SUBJECT_SHORT_TITLE, t1.RESPONSIBLE_FACULTY_NAME AS CATALOG_RESPONSIBLE_FACULTY_NAME FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TERM_CODE = '2022FA' ) SELECT s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.RESPONSIBLE_FACULTY_NAME, s1.OFFER_DEPT_NAME, s1.DEPARTMENT_FULL_NAME, s1.SCHOOL_NAME, s1.window_column AS min_enrolled_window, s2.SUBJECT_ID, s2.DEPARTMENT_NAME, s2.TERM_DESCRIPTION, s2.running_sum_total_units, s2.SUBJECT_SHORT_TITLE, s2.CATALOG_RESPONSIBLE_FACULTY_NAME FROM inner_cte s1 JOIN Subq2 s2 ON s1.OFFER_DEPT_CODE = s2.DEPARTMENT_CODE ORDER BY s1.OFFER_DEPT_NAME, s2.SUBJECT_ID\"}, {\"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2024 Mathematics 12-unit subject matched with 2019FA TIP offering\", \"desc\": \"For subjects offered in the academic year 2024 with total units equal to 12 in the Mathematics department, show the department code, department name, subject code, subject number, subject title, total units, the row number within each department ordered by subject code, the deviation of each subject's total units from the average total units of all Mathematics subjects offered in 2024, the number of enrolled students, responsible faculty name, school name, and the dense rank over the department name ordered by department name for those subjects that also have course materials and were offered in the term '2019FA'. Sort the table by department name and subject title. Do not return any rounded answers.\", \"id\": \"dw_1758\", \"name\": \"Math 2024 12-Unit Subjects Row Numbers and Unit Deviations Matched with 2019FA TIP Course-Material Offerings\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.DEPARTMENT_CODE, t0.DEPARTMENT_NAME, t1.SUBJECT_CODE, t1.SUBJECT_NUMBER, t1.SUBJECT_TITLE, t1.TOTAL_UNITS, ROW_NUMBER() OVER (PARTITION BY t0.DEPARTMENT_CODE ORDER BY t1.SUBJECT_CODE) AS window_column FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t1.ACADEMIC_YEAR = 2024 AND t1.TOTAL_UNITS = 12 AND t0.DEPARTMENT_NAME = 'Mathematics' ), math_avg AS ( SELECT t0.DEPARTMENT_CODE, AVG(t1.TOTAL_UNITS) AS avg_total_units FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t1.ACADEMIC_YEAR = 2024 AND t0.DEPARTMENT_NAME = 'Mathematics' GROUP BY t0.DEPARTMENT_CODE ) SELECT i.DEPARTMENT_CODE, i.DEPARTMENT_NAME, i.SUBJECT_CODE, i.SUBJECT_NUMBER, i.SUBJECT_TITLE, i.TOTAL_UNITS, i.window_column, (i.TOTAL_UNITS - m.avg_total_units) AS deviation_from_avg FROM inner_cte i JOIN math_avg m ON i.DEPARTMENT_CODE = m.DEPARTMENT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t1.DEPARTMENT_NAME, t1.SCHOOL_NAME, DENSE_RANK() OVER (PARTITION BY t1.DEPARTMENT_NAME ORDER BY t1.DEPARTMENT_NAME) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_COURSE_DESCRIPTION t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT WHERE t0.TERM_CODE = '2019FA' AND t1.DEPARTMENT_NAME = 'Mathematics' AND t0.IS_NO_COURSE_MATERIAL = 'N' ) SELECT CASE WHEN LAG(DEPARTMENT_NAME) OVER (ORDER BY DEPARTMENT_NAME, SUBJECT_TITLE) = DEPARTMENT_NAME THEN NULL ELSE DEPARTMENT_NAME END AS department_name, SUBJECT_TITLE, NUM_ENROLLED_STUDENTS, RESPONSIBLE_FACULTY_NAME, SCHOOL_NAME, window_column FROM inner_cte ORDER BY DEPARTMENT_NAME, SUBJECT_TITLE ) SELECT s1.DEPARTMENT_CODE, s1.DEPARTMENT_NAME, s1.SUBJECT_CODE, s1.SUBJECT_NUMBER, s1.SUBJECT_TITLE, s1.TOTAL_UNITS, s1.window_column AS subject_row_number, s1.deviation_from_avg, s2.NUM_ENROLLED_STUDENTS, s2.RESPONSIBLE_FACULTY_NAME, s2.SCHOOL_NAME, s2.window_column AS department_dense_rank FROM subq1 s1 LEFT JOIN subq2 s2 ON s1.DEPARTMENT_NAME = s2.department_name AND s1.SUBJECT_TITLE = s2.SUBJECT_TITLE ORDER BY s1.DEPARTMENT_NAME, s1.SUBJECT_TITLE;\"}, {\"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per 2019FA TIP subject matched with an Engineering 12-unit course of the same offer department\", \"desc\": \"For subjects offered in the term '2019FA' with more than 0 enrolled students, and for courses in the 'Engineering' school with a total of 12 units, show the subject title, offer department name, department full name, number of enrolled students, the average number of enrolled students in a window of 2 preceding and 2 following rows grouped by the school code, the course number, course description, course subject title, total units, course offering department name, and the row number of the course within each offering department ordered by course number, for cases where the subject and course are from the same offering department. Order the results by subject title and course number. Do not return any rounded answers.\", \"id\": \"dw_3794\", \"name\": \"2019FA TIP Subject Enrollment Windows Matched with Engineering 12-Unit Course Row Numbers\", \"sql\": \"WITH SubjectStats AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t0.NUM_ENROLLED_STUDENTS, AVG(t0.NUM_ENROLLED_STUDENTS) OVER ( PARTITION BY t1.SCHOOL_CODE ORDER BY t0.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2019FA' AND t0.NUM_ENROLLED_STUDENTS > 0 ), EngineeringCourses AS ( SELECT t0.COURSE AS course_number, t0.COURSE_DESCRIPTION, t1.SUBJECT_TITLE AS course_subject_title, t1.TOTAL_UNITS, t1.OFFER_DEPT_NAME, ROW_NUMBER() OVER (PARTITION BY t1.OFFER_DEPT_NAME ORDER BY t0.COURSE) AS window_column, t1.OFFER_DEPT_CODE FROM SIS_COURSE_DESCRIPTION t0 JOIN SUBJECT_OFFERED_SUMMARY t1 ON t0.COURSE = t1.COURSE_NUMBER WHERE t0.SCHOOL_NAME = 'Engineering' AND t1.TOTAL_UNITS = 12 ) SELECT s.SUBJECT_TITLE, s.OFFER_DEPT_NAME, s.DEPARTMENT_FULL_NAME, s.NUM_ENROLLED_STUDENTS, s.window_column AS avg_enrolled_window, e.course_number, e.COURSE_DESCRIPTION, e.course_subject_title, e.TOTAL_UNITS, e.OFFER_DEPT_NAME AS course_offer_dept_name, e.window_column AS course_row_number FROM SubjectStats s JOIN EngineeringCourses e ON s.OFFER_DEPT_CODE = e.OFFER_DEPT_CODE ORDER BY s.SUBJECT_TITLE, e.course_number\"}, {\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per subject pair across the two terms\", \"desc\": \"For all pairs of subjects where one is offered in the term '2019FA' with more than 0 enrolled students and the other is in the term '2009SP', show the 2019FA subject title, offer department name, department full name, number of enrolled students, and the average number of enrolled students in a window of 2 preceding and 2 following rows grouped by the school code, along with the 2009SP subject title, department name, total units, and the row number within a window of 2 preceding and 1 following rows ordered by subject title. Do not return any rounded answers.\", \"id\": \"dw_3597\", \"name\": \"Cross-Term Subject Pairs 2019FA Enrollment Windows vs 2009SP Unit Row Numbers\", \"sql\": \"WITH subq1 AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t0.NUM_ENROLLED_STUDENTS, AVG(t0.NUM_ENROLLED_STUDENTS) OVER ( PARTITION BY t1.SCHOOL_CODE ORDER BY t0.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column, t0.TERM_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2019FA' AND t0.NUM_ENROLLED_STUDENTS > 0 ), subq2 AS ( SELECT t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.TOTAL_UNITS, ROW_NUMBER() OVER ( ORDER BY t1.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING ) AS window_column, t1.TERM_CODE FROM ACADEMIC_TERMS t0 JOIN SUBJECT_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2009SP' ) SELECT s1.SUBJECT_TITLE AS subject_title_2019fa, s1.OFFER_DEPT_NAME, s1.DEPARTMENT_FULL_NAME, s1.NUM_ENROLLED_STUDENTS, s1.window_column AS avg_enrolled_window, s2.SUBJECT_TITLE AS subject_title_2009sp, s2.DEPARTMENT_NAME, s2.TOTAL_UNITS, s2.window_column AS row_number_window FROM subq1 s1 CROSS JOIN subq2 s2;\"}], \"not_found\": []}"
