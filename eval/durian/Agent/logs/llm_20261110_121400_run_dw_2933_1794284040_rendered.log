    {
      "role": "tool",
      "tool_call_id": "call_e2f0ae95cd524897865bf5db",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SPACE_UNIT\", \"name\": \"SPACE_UNIT\", \"desc\": \"Space unit dimension table: one row per space unit (an organizational space-assignment unit such as a department, program, or office that receives space allocation), with space unit key/code, space unit name, the facilities organization it belongs to, and DLC key. Bridges FCLT_ORGANIZATION (organization attribution) and SPACE_DETAIL (rooms assigned to the space unit); used to group room counts and space statistics by space unit.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Foreign key to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY; the organization that owns/occupies this space unit\"}, \"SPACE_UNIT_KEY\": {\"desc\": \"Surrogate key of the space unit; joins to SPACE_DETAIL.SPACE_UNIT_KEY and SPACE_UNIT2.SPACE_UNIT_KEY; used for partitioning/ordering in space analyses\"}, \"SPACE_UNIT_CODE\": {\"desc\": \"Business code of the space unit (same numeric value as the key in current data)\"}, \"SPACE_UNIT\": {\"desc\": \"Name of the space unit, e.g. 'Physics', 'Technology & Policy Program'\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_PHYSICS'; may contain composite values like 'D_DSL:HQ'\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per space unit\"}, {\"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Surrogate key of the facilities organization; joins to SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY\"}, \"ORGANIZATION_ID\": {\"desc\": \"Organization identifier (same value as the organization key in current data)\"}, \"ORGANIZATION\": {\"desc\": \"Short organization abbreviation, e.g. 'AERO', 'ADMISS'\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Display name of the organization, e.g. 'AERO & ASTRO'; used for organization-name reporting\"}, \"FCLT_ORG_PARENT_KEY\": {\"desc\": \"Key of the parent organization in the hierarchy tree; null for the top-level organization\"}, \"ORG_PARENT\": {\"desc\": \"Abbreviation of the parent organization, e.g. 'S ENG' (School of Engineering)\"}, \"FCLT_MAJOR_ORG_KEY\": {\"desc\": \"Key of the major (top-level grouping) organization this organization rolls up to\"}, \"MAJOR_ORG\": {\"desc\": \"Abbreviation of the major organization, e.g. 'PROVST', 'CHNCLR'\"}, \"ORGANIZATION_LEVEL\": {\"desc\": \"Level of the organization in the hierarchy tree (1 = institute-wide root, 2-4 = intermediate divisions/schools, 5 = department/DLC level, 6 = sub-organization); stored as string, filter with values like '5'\"}, \"ORGANIZATION_NUMBER\": {\"desc\": \"Official organization number used in administrative systems\"}, \"ORGANIZATION_SORT\": {\"desc\": \"Sortable hierarchical organization code reflecting the tree path\"}, \"ASSIGNABLE\": {\"desc\": \"Flag ('1'/'0') indicating whether the organization is an assignable-space organizational unit\"}, \"COURSE\": {\"desc\": \"Academic course (department) number for degree-granting academic departments, e.g. '16' for Aeronautics and Astronautics; null for non-academic organizations\"}, \"DESCRIPTION\": {\"desc\": \"Long description of the organization, e.g. 'Department of Aeronautics and Astronautics'; null for many non-academic organizations\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_AEROASTRO'; joins to FCLT_ORG_DLC_KEY.DLC_KEY, HR_ORG_UNIT.DLC_KEY (for HR org unit title/level and HR department attributes; may fan out when a DLC maps to multiple HR org units), and MASTER_DEPT_HIERARCHY.DLC_KEY (for the standard department hierarchy path)\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Aeronautics and Astronautics'\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code cross-reference\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"HR organization unit identifier cross-reference; links to HR_ORG_UNIT\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"Department name as recorded in HR systems\"}}, \"default_granularity\": \"one row per facilities organization\"}, {\"id\": \"FCLT_ORG_DLC_KEY\", \"name\": \"FCLT_ORG_DLC_KEY\", \"desc\": \"Bridge table mapping facilities organizations to their department/lab/center (DLC) keys: one row per organization-DLC key assignment. Used to filter organizations that have a non-null DLC key assignment before joining FCLT_ORGANIZATION (via FCLT_ORGANIZATION_KEY or DLC_KEY) for DLC-level facility and room statistics.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Foreign key to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY identifying the organization in the DLC assignment\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_AEROASTRO'; joins to FCLT_ORGANIZATION.DLC_KEY; non-null values identify organizations with a DLC assignment\"}}}, {\"id\": \"SPACE_UNIT2\", \"name\": \"SPACE_UNIT2\", \"desc\": \"Alternative space unit lookup table containing space unit key, code, name, and DLC key, but without the FCLT_ORGANIZATION_KEY organization attribution present in SPACE_UNIT. Holds fewer space units than SPACE_UNIT; used when only space unit identity/name is needed without organization linkage.\", \"columns\": {\"SPACE_UNIT_KEY\": {\"desc\": \"Surrogate key of the space unit; same value domain as SPACE_UNIT.SPACE_UNIT_KEY and referenced by SPACE_DETAIL.SPACE_UNIT_KEY\"}, \"SPACE_UNIT_CODE\": {\"desc\": \"Business code of the space unit\"}, \"SPACE_UNIT\": {\"desc\": \"Name of the space unit\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key of the space unit\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per space unit\"}, {\"id\": \"concept_space_unit_dimension\", \"name\": \"Space Unit Dimension\", \"desc\": \"Space unit lookup tables identifying the organizational units that receive space allocation: SPACE_UNIT (with FCLT_ORGANIZATION_KEY organization attribution) and SPACE_UNIT2 (identity/name only). They answer the same space-unit identity questions but differ in organization linkage and coverage.\", \"tables\": [\"SPACE_UNIT\", \"SPACE_UNIT2\"], \"comparisons\": [{\"dimension\": \"Organization attribution\", \"differences\": \"SPACE_UNIT carries FCLT_ORGANIZATION_KEY linking each space unit to its owning organization in FCLT_ORGANIZATION; SPACE_UNIT2 has no organization key, only space unit identity and DLC_KEY.\"}, {\"dimension\": \"Coverage\", \"differences\": \"SPACE_UNIT holds more space units (150 rows) than SPACE_UNIT2 (139 rows); every SPACE_UNIT2 key also exists in SPACE_UNIT, so SPACE_UNIT2 is a subset.\"}, {\"dimension\": \"Join role\", \"differences\": \"Both join SPACE_DETAIL via SPACE_UNIT_KEY; only SPACE_UNIT can bridge SPACE_DETAIL rooms to organization attributes (level, parent, description).\"}], \"decision_guide\": {\"Space unit analysis that needs organization attributes (organization level, name, description)\": \"Use SPACE_UNIT: it is the only space unit table carrying FCLT_ORGANIZATION_KEY for the organization join.\", \"Space unit name/code lookup only, or queries restricted to the SPACE_UNIT2 subset\": \"Use SPACE_UNIT2: it provides SPACE_UNIT_KEY/CODE/NAME and DLC_KEY without organization linkage.\", \"Counting rooms per space unit or ranking space units by room count\": \"Join SPACE_DETAIL to SPACE_UNIT on SPACE_UNIT_KEY (preferred for full coverage and organization attribution).\"}}, {\"id\": \"concept_facility_organization_dimension\", \"name\": \"Facility Organization Dimension\", \"desc\": \"Organization dimension tables describing the institute's hierarchical organization tree used for facilities/space attribution: FCLT_ORGANIZATION (keyed by FCLT_ORGANIZATION_KEY, with DLC_KEY/DLC_NAME) and FAC_ORGANIZATION (keyed by ORGANIZATION_KEY, with D_CODE). They answer the same questions about organization names, hierarchy levels, parent/major organizations, assignable flags, and HR cross-references, but belong to different table families and coverage.\", \"tables\": [\"FCLT_ORGANIZATION\", \"FAC_ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Key family\", \"differences\": \"FCLT_ORGANIZATION uses FCLT_ORGANIZATION_KEY/FCLT_ORG_PARENT_KEY/FCLT_MAJOR_ORG_KEY and is referenced by SPACE_UNIT and FCLT_ROOMS; FAC_ORGANIZATION uses ORGANIZATION_KEY/ORG_PARENT_KEY/MAJOR_ORG_KEY and is referenced by FAC_ROOMS.\"}, {\"dimension\": \"Coverage\", \"differences\": \"FCLT_ORGANIZATION holds more organizations (180 rows) than FAC_ORGANIZATION (169 rows); key values overlap almost entirely, so FCLT_ORGANIZATION is the broader dimension.\"}, {\"dimension\": \"DLC attribution columns\", \"differences\": \"FCLT_ORGANIZATION carries both DLC_KEY and DLC_NAME plus an HR_DEPARTMENT_NAME; FAC_ORGANIZATION carries only D_CODE (no DLC name column).\"}, {\"dimension\": \"Shared structure\", \"differences\": \"Both share ORGANIZATION_ID/ORGANIZATION/ORGANIZATION_NAME, ORGANIZATION_LEVEL (1-6, level 5 = department/DLC), ORGANIZATION_NUMBER, ORGANIZATION_SORT, ASSIGNABLE, COURSE, DESCRIPTION, and HR cross-reference columns.\"}], \"decision_guide\": {\"Organization level, name, description, or hierarchy questions linked to space units or FCLT rooms\": \"Use FCLT_ORGANIZATION: it joins SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY and has the widest organization coverage.\", \"Organization questions inside the FAC_* family (FAC_ROOMS occupancy, FAC_BUILDING analysis)\": \"Use FAC_ORGANIZATION: FAC_ROOMS.ORGANIZATION_KEY references it directly.\", \"DLC name reporting for an organization\": \"Use FCLT_ORGANIZATION: it is the only one carrying DLC_NAME alongside DLC_KEY.\"}}, {\"id\": \"column_concept_dlc_key\", \"name\": \"DLC Key (Department/Lab/Center)\", \"desc\": \"Department/Lab/Center key columns (values like 'D_AEROASTRO', 'D_IDSS', 'D_BIOLOGY') identifying a DLC across the facilities, HR, space, and academic-department domains. They are the universal cross-domain join key linking facilities organizations and space units to HR organization units, the master department hierarchy, and academic departments. Naming and completeness vary: DLC_KEY in most tables, D_CODE in MASTER_DEPT_DCODE_PARENT, DLC_CODE in the master hierarchy tables; some columns carry composite values ('D_DSL:HQ') or nulls.\", \"columns\": [\"FCLT_ORGANIZATION.DLC_KEY\", \"FCLT_ORG_DLC_KEY.DLC_KEY\", \"HR_ORG_UNIT.DLC_KEY\", \"HR_ORG_UNIT_NEW.DLC_KEY\", \"MASTER_DEPT_HIERARCHY.DLC_KEY\", \"MASTER_DEPT_HIERARCHY_LINKS.DLC_KEY\", \"MASTER_DEPT_DCODE_PARENT.D_CODE\", \"SPACE_UNIT.DLC_KEY\", \"SPACE_UNIT2.DLC_KEY\", \"SIS_DEPARTMENT.DLC_KEY\", \"SPACE_SUPERVISOR_USAGE.DEPT_NAMES\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DLC_KEY is used by FCLT_ORGANIZATION, FCLT_ORG_DLC_KEY, HR_ORG_UNIT, HR_ORG_UNIT_NEW, MASTER_DEPT_HIERARCHY, MASTER_DEPT_HIERARCHY_LINKS, SPACE_UNIT, SPACE_UNIT2, and SIS_DEPARTMENT; MASTER_DEPT_DCODE_PARENT names the same value domain D_CODE (with PARENT_D_CODE for the parent); MASTER_DEPT_HIERARCHY/LINKS additionally carry DLC_CODE holding the same value as DLC_KEY; SPACE_SUPERVISOR_USAGE names it DEPT_NAMES despite holding DLC key values, not department names.\"}, {\"dimension\": \"Uniqueness and fan-out behavior\", \"detail\": \"In MASTER_DEPT_HIERARCHY the DLC_KEY is unique per DLC (one row per DLC); in HR_ORG_UNIT one DLC_KEY may appear on multiple HR org unit rows (join fans out); in FCLT_ORGANIZATION multiple organizations can share a DLC_KEY; in FCLT_ORG_DLC_KEY it is an assignment bridge where non-null values mark organizations with a DLC assignment; in SPACE_SUPERVISOR_USAGE multiple supervisors can share the same DEPT_NAMES value, so joining DEPT_NAMES = DLC_KEY fans out on both sides.\"}, {\"dimension\": \"Nullability and value format\", \"detail\": \"HR_ORG_UNIT.DLC_KEY is null for units without a DLC assignment (133 of 641 rows); HR_ORG_UNIT_NEW.DLC_KEY and SPACE_UNIT.DLC_KEY may contain composite values like 'D_DSL:HQ' that do not match plain DLC keys; SPACE_SUPERVISOR_USAGE.DEPT_NAMES holds a comma-separated list of DLC keys when DEPT_COUNT > 1 (e.g. 'D_IDSS,D_LIDS'), so only single-department rows match a plain DLC key join; SIS_DEPARTMENT.DLC_KEY is populated for all 122 department rows.\"}, {\"dimension\": \"Companion name column\", \"detail\": \"FCLT_ORGANIZATION, HR_ORG_UNIT, and MASTER_DEPT_HIERARCHY carry a DLC_NAME alongside the key; SPACE_UNIT/SPACE_UNIT2, FCLT_ORG_DLC_KEY, HR_ORG_UNIT_NEW, SIS_DEPARTMENT, and SPACE_SUPERVISOR_USAGE carry only the key, so DLC name reporting requires joining one of the name-carrying tables.\"}], \"decision_guide\": {\"Attaching HR department attributes (unit title, department name/code, level) to a facilities organization\": \"Join FCLT_ORGANIZATION.DLC_KEY = HR_ORG_UNIT.DLC_KEY; expect possible row fan-out when a DLC maps to multiple HR org units.\", \"Reporting the DLC name of an organization or space unit\": \"Use FCLT_ORGANIZATION.DLC_KEY (carries DLC_NAME) or join HR_ORG_UNIT/MASTER_DEPT_HIERARCHY for DLC_NAME; SPACE_UNIT/SPACE_UNIT2 keys alone have no name column.\", \"Restricting analysis to DLCs placed in the standard department hierarchy or reporting their hierarchy path\": \"Join on MASTER_DEPT_HIERARCHY.DLC_KEY; use MASTER_DEPT_DCODE_PARENT.D_CODE for the same value domain when only the direct parent is needed.\", \"Filtering organizations that have a DLC assignment before DLC-level room statistics\": \"Use FCLT_ORG_DLC_KEY.DLC_KEY IS NOT NULL as the assignment filter, then join FCLT_ORGANIZATION.\", \"Linking an academic department to its facilities organization or HR unit\": \"Use SIS_DEPARTMENT.DLC_KEY = FCLT_ORGANIZATION.DLC_KEY (or HR_ORG_UNIT.DLC_KEY); all SIS_DEPARTMENT rows carry a DLC key.\", \"Attributing supervisor space-usage statistics (supervisees, square footage, research volume) to a DLC or space unit\": \"Join SPACE_SUPERVISOR_USAGE.DEPT_NAMES = SPACE_UNIT.DLC_KEY (or another DLC_KEY column); despite its name, DEPT_NAMES holds DLC key values, and only single-department rows (DEPT_COUNT = 1) match a plain DLC key.\"}}, {\"columns\": [\"SPACE_UNIT.SPACE_UNIT_KEY\", \"SPACE_UNIT2.SPACE_UNIT_KEY\", \"SPACE_DETAIL.SPACE_UNIT_KEY\"], \"comparisons\": [{\"dimension\": \"Role\", \"differences\": \"In SPACE_UNIT and SPACE_UNIT2 it is the primary identity of the space unit dimension; in SPACE_DETAIL it is a foreign key assigning each room to a space unit.\"}, {\"dimension\": \"Organization linkage\", \"differences\": \"Only SPACE_UNIT.SPACE_UNIT_KEY rows carry FCLT_ORGANIZATION_KEY, so joining SPACE_DETAIL through SPACE_UNIT (not SPACE_UNIT2) reaches organization attributes.\"}, {\"dimension\": \"Coverage\", \"differences\": \"SPACE_DETAIL references 66 distinct space unit keys; SPACE_UNIT covers all of them plus unused units, SPACE_UNIT2 is a subset of SPACE_UNIT.\"}], \"decision_guide\": {\"Grouping room counts by space unit with organization attributes\": \"Join SPACE_DETAIL.SPACE_UNIT_KEY to SPACE_UNIT.SPACE_UNIT_KEY, then to FCLT_ORGANIZATION via SPACE_UNIT.FCLT_ORGANIZATION_KEY.\", \"Space unit name lookup without organization context\": \"Either SPACE_UNIT or SPACE_UNIT2 resolves SPACE_DETAIL.SPACE_UNIT_KEY to a name; prefer SPACE_UNIT for full coverage.\"}, \"desc\": \"Space unit key columns identifying the organizational space-assignment unit across the space dimension and fact tables. SPACE_UNIT_KEY is the join key linking SPACE_DETAIL room rows to space unit identity (name/code) and, through SPACE_UNIT, to the owning facilities organization.\", \"id\": \"column_concept_space_unit_key\", \"name\": \"Space Unit Key\"}], \"not_found\": []}"
    },
