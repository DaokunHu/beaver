        "name": "semantic_search",
        "description": "Perform semantic similarity retrieval in the semantic network vector store, searching for table, metric, concept, or column_concept entities.\nWhen entity_type is provided, only that type is searched; when omitted, all types are searched by default, each returning an independent topk.\nReturns results grouped by type (items_by_type), each entity only returns id and desc; full details are obtained via semantic_get.\n- table search: does not return column-level info or concept.\n- metric search: does not return sql, category.\n- concept search: does not return tables/comparisons/decision_guide.\n\nUsage strategy:\n- Candidates with score > 0.8 should be prioritized\n- 0.5-0.8 need verification via semantic_get\n- < 0.5 are usually not relevant\n\nApplicable scenario: when the user describes their needs in natural language, but keywords cannot precisely match table/metric names.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Natural language query description, e.g. 'student course selection records', 'department cost summary'."
            },
            "entity_type": {
              "type": "string",
              "description": "Entity type to search. When omitted, all entity types are searched by default, each returning an independent topk.",
              "enum": [
                "table",
                "metric",
                "concept",
                "column_concept"
              ]
            },
            "topk": {
              "type": "integer",
              "description": "Number of results to return, default 10.",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "semantic_get",
        "description": "Get the full definition of one or more entities in the semantic network by ID.\n\nSupports batch retrieval: pass multiple IDs via entity_ids (preferred when fetching 2+ entities, saves tool calls), or a single ID via entity_id.\nBatch results are returned in the 'entities' list (same order as input); missing IDs are listed in 'not_found'.\n\nApplicable scenarios:\n- After semantic_search finds candidate IDs, get the full SQL and field definitions\n- Get the full column definitions (columns) of a table\n- Get the full SQL and category of a metric\n- Get the full details of a concept (tables, comparisons, decision_guide)\n- Get the full details of a column_concept (columns, comparisons, decision_guide)",
        "parameters": {
          "type": "object",
          "properties": {
            "entity_id": {
              "type": "string",
              "description": "Single entity ID (for fetching one entity)."
            },
            "entity_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Multiple entity IDs (for batch fetching; preferred over entity_id when fetching 2+ entities)."
