    {
      "role": "tool",
      "tool_call_id": "call_d2980ec9dc8740879c407a95",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entity\": {\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per top-enrolled Chemistry subject\", \"desc\": \"From the top 10 subjects offered by the Chemistry department (Course 5) with the highest number of enrolled students, display each subject's title, offering department name, responsible faculty name, term code, material status key, the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject ID, and the department most represented among the responsible faculty for these subjects along with the count of subjects from that department. For each such subject, also provide the corresponding academic term parameter, the term description, the average total units, and the variance of total units of all subjects offered in the corresponding effective term, considering only subjects that are offered this year and are in the Mathematics department. The columns should be: subject title, offering department name, responsible faculty name, term code, material status key, maximum number of enrolled students, most prominent responsible faculty department, count of subjects from that department, academic term parameter, term description, average total units, and variance of total units. Do not return any rounded answers.\", \"id\": \"dw_2461\", \"name\": \"Top 10 Chemistry Subjects by Enrollment with Prominent Faculty Department and Math Term Unit Statistics\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.RESPONSIBLE_FACULTY_NAME, t1.TERM_CODE, t1.TIP_MATERIAL_STATUS_KEY, MAX(t0.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t0.SUBJECT_ID ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) as max_enrolled_students, t0.SUBJECT_ID, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN TIP_DETAIL t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.NUM_ENROLLED_STUDENTS >= 0 AND t1.TIP_MATERIAL_STATUS_KEY IS NOT NULL AND t0.OFFER_DEPT_NAME = 'Chemistry' ), faculty_dept_counts AS ( SELECT icte.SUBJECT_TITLE, icte.OFFER_DEPT_NAME, icte.RESPONSIBLE_FACULTY_NAME, icte.TERM_CODE, icte.TIP_MATERIAL_STATUS_KEY, icte.max_enrolled_students, ccso.DEPARTMENT_NAME AS Most_Prominent_Responsible_Faculty_Department, COUNT(*) AS Subject_Count FROM inner_cte icte JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON icte.SUBJECT_ID = ccso.SUBJECT_ID GROUP BY icte.SUBJECT_TITLE, icte.OFFER_DEPT_NAME, icte.RESPONSIBLE_FACULTY_NAME, icte.TERM_CODE, icte.TIP_MATERIAL_STATUS_KEY, icte.max_enrolled_students, ccso.DEPARTMENT_NAME ), ranked_faculty_dept AS ( SELECT fdc.*, @rank := IF(@current_subject = fdc.SUBJECT_TITLE, @rank + 1, 1) AS `Rank`, @current_subject := fdc.SUBJECT_TITLE FROM (SELECT * FROM faculty_dept_counts ORDER BY SUBJECT_TITLE, Subject_Count DESC) fdc CROSS JOIN (SELECT @rank := 0, @current_subject := '') vars ), AcademicTermStats AS ( SELECT atp.TERM_CODE AS academic_term_parameter, atp.TERM_DESCRIPTION, AVG(ccso.TOTAL_UNITS) AS avg_total_units, VARIANCE(ccso.TOTAL_UNITS) AS var_total_units FROM ACADEMIC_TERM_PARAMETER atp JOIN ACADEMIC_TERMS at ON atp.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE ccso.IS_OFFERED_THIS_YEAR = 'Y' AND ccso.DEPARTMENT_NAME = 'Mathematics' GROUP BY atp.TERM_CODE, atp.TERM_DESCRIPTION ORDER BY atp.TERM_CODE ) SELECT rfd.SUBJECT_TITLE, rfd.OFFER_DEPT_NAME, rfd.RESPONSIBLE_FACULTY_NAME, rfd.TERM_CODE, rfd.TIP_MATERIAL_STATUS_KEY, rfd.max_enrolled_students, rfd.Most_Prominent_Responsible_Faculty_Department, rfd.Subject_Count, ats.academic_term_parameter, ats.TERM_DESCRIPTION, ats.avg_total_units, ats.var_total_units FROM ranked_faculty_dept rfd JOIN AcademicTermStats ats ON rfd.TERM_CODE = ats.academic_term_parameter WHERE rfd.`Rank` = 1 ORDER BY rfd.max_enrolled_students DESC LIMIT 10;\"}}"
    },
