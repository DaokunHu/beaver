    {
      "role": "tool",
      "tool_call_id": "call_6d0b16e8c5164798872c81d6",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"columns\": {\"SIS_COURSE_DESCRIPTION_KEY\": {\"desc\": \"Surrogate key of the course description record\"}, \"COURSE\": {\"desc\": \"Course/subject code, e.g. '18'; joins to SIS_SUBJECT_CODE.SUBJECT_CODE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"COURSE_DESCRIPTION\": {\"desc\": \"Short course description text; its character length is used in description-length statistics\"}, \"COURSE_DESCRIPTION_LONG\": {\"desc\": \"Long-form course description text\"}, \"DEPARTMENT\": {\"desc\": \"Department code offering the course; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name offering the course\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME\": {\"desc\": \"School name offering the course, e.g. 'Engineering'\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"FROM_TERM\": {\"desc\": \"First term the course description is effective from\"}, \"FROM_TERM_DESCRIPTION\": {\"desc\": \"Description of the from-term\"}, \"THRU_TERM\": {\"desc\": \"Last term the course description is effective through\"}, \"THRU_TERM_DESCRIPTION\": {\"desc\": \"Description of the thru-term\"}, \"COURSE_OPTION\": {\"desc\": \"Course option designation\"}, \"COURSE_LEVEL\": {\"desc\": \"Course level code, e.g. 'U' = undergraduate, 'G' = graduate\"}, \"CIP_PROGRAM_CODE\": {\"desc\": \"Six-digit CIP (Classification of Instructional Programs) program code of the course; joins to CIP.PROGRAM_CODE (current classification, one row per code) and CIP_WITH_VERSION.PROGRAM_CODE (all revision versions)\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the course counts toward a degree\"}, \"DEFAULT_ULTIMATE_DEGREE\": {\"desc\": \"Default ultimate degree awarded for the course\"}, \"GRADAUTE_LEVEL\": {\"desc\": \"Legacy misspelled graduate level column (kept for compatibility)\"}, \"GRADUATE_LEVEL\": {\"desc\": \"Graduate level designation of the course\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per course description\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}, {\"id\": \"SIS_ADMIN_DEPARTMENT\", \"name\": \"SIS_ADMIN_DEPARTMENT\", \"desc\": \"SIS administrative department table with administrative department code/name, phone area code and phone number, and clearing cost collector. Joins to SIS_DEPARTMENT via SIS_ADMIN_DEPARTMENT_CODE = DEPARTMENT_CODE for department contact information.\", \"columns\": {\"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"SIS_ADMIN_DEPARTMENT_CODE\": {\"desc\": \"Administrative department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"SIS_ADMIN_DEPARTMENT_NAME\": {\"desc\": \"Administrative department name\"}, \"DEPARTMENT_PHONE_AREA_CODE\": {\"desc\": \"Area code of the department phone number\"}, \"DEPARTMENT_PHONE_NUMBER\": {\"desc\": \"Phone number of the administrative department\"}, \"CLEARING_COST_COLLECTOR\": {\"desc\": \"Clearing cost collector of the administrative department\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}}, \"default_granularity\": \"one row per administrative department\"}, {\"id\": \"CIP\", \"name\": \"CIP\", \"desc\": \"Classification of Instructional Programs (CIP) lookup table: one row per six-digit CIP program code, classifying instructional programs into a two-digit category and a four-digit series, with program/category/four-digit titles, a change note, the CIP revision version year (1990/2000/2010/2020), and the warehouse load date. Joins to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE to attribute courses to CIP programs, categories, and schools/departments; CIP_WITH_VERSION is the multi-version variant keeping every revision of each program code.\", \"columns\": {\"PROGRAM_CODE\": {\"desc\": \"Six-digit CIP program code (indexed); joins to SIS_COURSE_DESCRIPTION.CIP_PROGRAM_CODE and CIP_WITH_VERSION.PROGRAM_CODE\"}, \"PROGRAM_TITLE\": {\"desc\": \"Title of the instructional program, e.g. 'Agricultural Economics'\"}, \"CATEGORY_CODE\": {\"desc\": \"Two-digit CIP category code grouping related programs, e.g. '13' for EDUCATION\"}, \"CATEGORY_TITLE\": {\"desc\": \"Title of the two-digit CIP category, e.g. 'EDUCATION'; used as a grouping dimension for program-category statistics\"}, \"FOUR_DIGIT_CODE\": {\"desc\": \"Four-digit CIP series code between category and program, e.g. '1313'\"}, \"FOUR_DIGIT_TITLE\": {\"desc\": \"Title of the four-digit CIP series, e.g. 'Teacher Education and Professional Development, Specific Subject Areas'\"}, \"NOTE\": {\"desc\": \"Change note of the program code in its CIP version, e.g. '(2020) No substantive changes' or 'None'; only present in CIP, not in CIP_WITH_VERSION\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record in DD-MON-YY format\"}, \"VERSION\": {\"desc\": \"CIP revision version year of the program code (1990, 2000, 2010, or 2020); each program code appears once with the version it belongs to, so version filters like VERSION > 2000 select programs classified in later CIP revisions\"}}, \"default_granularity\": \"one row per CIP program code\"}, {\"id\": \"concept_department_dimension\", \"name\": \"Department and School Dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\", \"tables\": [\"SIS_DEPARTMENT\", \"STUDENT_DEPARTMENT\", \"SIS_ADMIN_DEPARTMENT\"], \"comparisons\": [{\"dimension\": \"Attribute coverage\", \"SIS_DEPARTMENT\": \"Richest: DEPARTMENT_FULL_NAME, SCHOOL_CODE/SCHOOL_NAME, DEPT_BUDGET_CODE, IS_DEGREE_GRANTING, commencement-book names, DLC key\", \"STUDENT_DEPARTMENT\": \"Minimal: code, name, full name, school code/name only\", \"SIS_ADMIN_DEPARTMENT\": \"Administrative contact: department phone area code/number, clearing cost collector\"}, {\"dimension\": \"Degree-granting and school filtering\", \"SIS_DEPARTMENT\": \"Supports IS_DEGREE_GRANTING and SCHOOL_NAME filters directly\", \"STUDENT_DEPARTMENT\": \"Only school code/name attribution, no degree-granting flag\", \"SIS_ADMIN_DEPARTMENT\": \"No school or degree-granting attributes\"}, {\"dimension\": \"Typical join path\", \"SIS_DEPARTMENT\": \"DEPARTMENT_CODE = offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE; also joins SIS_COURSE_DESCRIPTION.DEPARTMENT and SIS_ADMIN_DEPARTMENT.SIS_ADMIN_DEPARTMENT_CODE\", \"STUDENT_DEPARTMENT\": \"DEPARTMENT_CODE = TIP_SUBJECT_OFFERED.OFFER_DEPT_CODE and other offering department codes\", \"SIS_ADMIN_DEPARTMENT\": \"SIS_ADMIN_DEPARTMENT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE\"}, {\"dimension\": \"Budget/finance attributes\", \"SIS_DEPARTMENT\": \"DEPT_BUDGET_CODE available for budget-based ranking\", \"STUDENT_DEPARTMENT\": \"None\", \"SIS_ADMIN_DEPARTMENT\": \"CLEARING_COST_COLLECTOR\"}], \"decision_guide\": {\"Questions filtering departments by school (e.g. 'School of Engineering') or degree-granting status\": \"Use SIS_DEPARTMENT; it carries SCHOOL_NAME and IS_DEGREE_GRANTING.\", \"Questions needing only department full name and school name for offering departments (e.g. TIP subject offerings)\": \"STUDENT_DEPARTMENT suffices and is the lighter lookup; SIS_DEPARTMENT also works.\", \"Questions needing department phone numbers or administrative contact details\": \"Join SIS_ADMIN_DEPARTMENT via SIS_DEPARTMENT.DEPARTMENT_CODE = SIS_ADMIN_DEPARTMENT_CODE.\", \"Questions ranking or grouping departments by budget code\": \"Use SIS_DEPARTMENT.DEPT_BUDGET_CODE.\"}}, {\"id\": \"concept_cip_program_classification\", \"name\": \"CIP Program Classification\", \"desc\": \"Lookup tables of the Classification of Instructional Programs (CIP) used to classify courses/instructional programs into two-digit categories, four-digit series, and six-digit program codes, with revision version years (1990/2000/2010/2020). CIP holds the current single-version classification (one row per program code, with a change NOTE), while CIP_WITH_VERSION preserves every revision of each program code across versions. Both join to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE to attribute courses to CIP programs and categories.\", \"tables\": [\"CIP\", \"CIP_WITH_VERSION\"], \"comparisons\": [{\"dimension\": \"Granularity\", \"CIP\": \"One row per six-digit program code (3,059 rows / 3,059 distinct codes); each code carries exactly one VERSION value\", \"CIP_WITH_VERSION\": \"One row per program code per revision version year (6,350 rows / 2,759 distinct codes); the same code appears under multiple versions\"}, {\"dimension\": \"Version semantics\", \"CIP\": \"VERSION is the single CIP revision the code belongs to; filters like VERSION > 2000 select codes classified in later revisions without row duplication\", \"CIP_WITH_VERSION\": \"VERSION enumerates all revisions a code existed in; joining without a version filter multiplies rows per code\"}, {\"dimension\": \"Unique columns\", \"CIP\": \"Has NOTE (change note per code, e.g. '(2020) No substantive changes'); no surrogate key\", \"CIP_WITH_VERSION\": \"Has CIP_WITH_VERSION_KEY surrogate key (code + version); no NOTE column\"}, {\"dimension\": \"Join fan-out with SIS_COURSE_DESCRIPTION\", \"CIP\": \"PROGRAM_CODE = CIP_PROGRAM_CODE matches ~597 course rows (one match per course)\", \"CIP_WITH_VERSION\": \"Same key matches ~2,474 course rows because a course's program code can match several version rows\"}], \"decision_guide\": {\"Questions about program categories, program titles, four-digit codes, version filters (e.g. version after 2000), or counting courses per CIP category\": \"Use CIP: one row per program code, so joins to SIS_COURSE_DESCRIPTION do not duplicate course rows and version filters are unambiguous\", \"Questions about how a program's classification changed across CIP revisions, or needing historical category/four-digit titles of a program code in a specific version year\": \"Use CIP_WITH_VERSION filtered on the target VERSION, since it preserves every revision of each program code\", \"Questions needing the change note of a program code (e.g. whether a code had substantive changes in the 2020 revision)\": \"Use CIP, the only table carrying the NOTE column\"}}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_5c7bf165bb0f496fb082bb6b",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per course level of the Mathematics department\", \"desc\": \"For the Mathematics department, what is the department name, the average of the total units, the range of the total units, the variance of the total units for courses with total units greater than 0, and for each course level, what is the number of unique students and the minimum CIP program code among their courses, considering only degree-granting departments? Additionally, for each course level, what is the average number of lecture units and the maximum number of lab units for Mathematics courses? Do not return any rounded answers.\", \"id\": \"dw_2272\", \"name\": \"Math Department Unit Statistics with Course Level Student Counts and Lecture-Lab Unit Averages\", \"sql\": \"WITH inner_cte AS ( WITH department_units_stats AS ( SELECT SIS_DEPARTMENT.DEPARTMENT_NAME, AVG(CIS_COURSE_CATALOG.TOTAL_UNITS) AS avg_total_units, MAX(CIS_COURSE_CATALOG.TOTAL_UNITS) - MIN(CIS_COURSE_CATALOG.TOTAL_UNITS) AS total_units_range, VARIANCE(CIS_COURSE_CATALOG.TOTAL_UNITS) AS total_units_variance FROM SIS_DEPARTMENT JOIN CIS_COURSE_CATALOG ON SIS_DEPARTMENT.DEPARTMENT_CODE = CIS_COURSE_CATALOG.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE ON CIS_COURSE_CATALOG.DEPARTMENT_CODE = SIS_SUBJECT_CODE.DEPARTMENT_CODE WHERE CIS_COURSE_CATALOG.TOTAL_UNITS > 0 AND SIS_DEPARTMENT.IS_DEGREE_GRANTING = 'Y' AND SIS_DEPARTMENT.DEPARTMENT_NAME = 'Mathematics' AND SIS_DEPARTMENT.DEPARTMENT_CODE = '18' GROUP BY SIS_DEPARTMENT.DEPARTMENT_NAME ORDER BY total_units_range DESC ), department_student_cip_stats AS ( SELECT sd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT msd.FULL_NAME) AS student_count, MIN(scd.CIP_PROGRAM_CODE) AS min_cip_code FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY sd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT dus.DEPARTMENT_NAME, dus.avg_total_units, dus.total_units_range, dus.total_units_variance, dscs.COURSE_LEVEL, dscs.student_count, dscs.min_cip_code FROM department_units_stats dus JOIN department_student_cip_stats dscs ON dus.DEPARTMENT_NAME = dscs.DEPARTMENT_NAME ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.avg_total_units, inner_cte.total_units_range, inner_cte.total_units_variance, inner_cte.COURSE_LEVEL, inner_cte.student_count, inner_cte.min_cip_code, stats.avg_lecture_units, stats.max_lab_units FROM inner_cte JOIN ( SELECT scd.COURSE_LEVEL, AVG(ccc.LECTURE_UNITS) AS avg_lecture_units, MAX(ccc.LAB_UNITS) AS max_lab_units FROM SIS_COURSE_DESCRIPTION scd JOIN CIS_COURSE_CATALOG ccc ON scd.DEPARTMENT = ccc.DEPARTMENT_CODE WHERE scd.DEPARTMENT_NAME = 'Mathematics' AND ccc.DEPARTMENT_CODE = '18' AND ccc.TOTAL_UNITS > 0 GROUP BY scd.COURSE_LEVEL ) stats ON inner_cte.COURSE_LEVEL = stats.COURSE_LEVEL;\"}, {\"category\": \"IAP Activity and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per school per academic year\", \"desc\": \"For each school, what is the school's name, the school's name in the commencement book, the maximum CIP program code among its degree-granting departments' courses (excluding the Mathematics department), the CIP category ('HIGH_CIP', 'LOW_CIP', or 'MEDIUM_CIP'), the academic year, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered by the Mathematics department in that year (considering only years with more than five activities), and the Mathematics department phone number, for schools where the maximum CIP program code is greater than 130000 and the standard deviation (using STDDEV only and never STDDEV_POP) of maximum enrollment is available? Do not return any rounded answers.\", \"id\": \"dw_1618\", \"name\": \"School CIP Categories with Yearly Math IAP Max Enrollment Stddev and Department Phone\", \"sql\": \"WITH school_cip AS ( WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, MAX(c.CIP_PROGRAM_CODE) AS max_cip_code, d.DEPARTMENT_FULL_NAME, d.SCHOOL_NAME, d.SCHOOL_CODE FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_CODE <> '18' GROUP BY d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, d.SCHOOL_NAME, d.SCHOOL_CODE HAVING MAX(c.CIP_PROGRAM_CODE) > 120000 ) SELECT i.SCHOOL_NAME, s.SCHOOL_NAME_IN_COMMENCEMENT_BK, MAX(i.max_cip_code) AS school_max_cip_code, CASE WHEN MAX(i.max_cip_code) > 150000 THEN 'HIGH_CIP' WHEN MAX(i.max_cip_code) < 130000 THEN 'LOW_CIP' ELSE 'MEDIUM_CIP' END AS cip_category FROM inner_cte i JOIN SIS_DEPARTMENT s ON i.SCHOOL_CODE = s.SCHOOL_CODE GROUP BY i.SCHOOL_NAME, s.SCHOOL_NAME_IN_COMMENCEMENT_BK ), math_iap_enroll AS ( WITH inner_cte AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, STDDEV_SAMP(isd.MAX_ENROLLMENT) AS stddev_max_enrollment FROM IAP_SUBJECT_DETAIL isd JOIN ACADEMIC_TERMS_ALL ata ON isd.TERM_CODE = ata.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON isd.TERM_CODE = ccso.TERM_CODE WHERE ccso.DEPARTMENT_NAME = 'Mathematics' AND isd.MAX_ENROLLMENT IS NOT NULL GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC HAVING COUNT(isd.MAX_ENROLLMENT) > 5 ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.ACADEMIC_YEAR_DESC, inner_cte.stddev_max_enrollment, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.SCHOOL_NAME AS school_name FROM inner_cte LEFT JOIN SIS_DEPARTMENT sd ON sd.DEPARTMENT_NAME = 'Mathematics' LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ORDER BY inner_cte.ACADEMIC_YEAR ) SELECT sc.SCHOOL_NAME, sc.SCHOOL_NAME_IN_COMMENCEMENT_BK, sc.school_max_cip_code, sc.cip_category, mie.ACADEMIC_YEAR, mie.ACADEMIC_YEAR_DESC, mie.stddev_max_enrollment, mie.department_phone FROM school_cip sc JOIN math_iap_enroll mie ON sc.SCHOOL_NAME = mie.school_name WHERE sc.school_max_cip_code > 130000 AND mie.stddev_max_enrollment IS NOT NULL ORDER BY sc.SCHOOL_NAME, mie.ACADEMIC_YEAR;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per graduate course plus rollup totals plus Spring 2021 letter-graded summary row\", \"desc\": \"For each course in the Mathematics department that is degree granting and has a course level of 'G', show the course description, department name, school name, the administrative department name, and the dense rank over the administrative department name ordered by the administrative department name. Additionally, for each administrative department name, include a grand total of the number of such courses in the format of (null, null, null, administrative department name, null, total courses). Also, show the minimum total units, the sum of lecture units, and the number of unique subjects for letter graded Mathematics department subjects offered in the Spring Term 2021, along with the department name and term description (with all other columns as null). Do not return any rounded answers.\", \"id\": \"dw_1427\", \"name\": \"Math Graduate Degree-Granting Courses Ranked by Admin Department with Spring 2021 Letter-Graded Unit Summary\", \"sql\": \"WITH inner_cte_1 AS ( SELECT scd.COURSE_DESCRIPTION, sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, sad.SIS_ADMIN_DEPARTMENT_NAME, DENSE_RANK() OVER (ORDER BY sad.SIS_ADMIN_DEPARTMENT_NAME) AS admin_dept_dense_rank FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT sad ON sd.DEPARTMENT_CODE = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND scd.COURSE_LEVEL = 'G' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' ), CourseTotals AS ( SELECT SIS_ADMIN_DEPARTMENT_NAME, COUNT(*) AS total_courses FROM inner_cte_1 GROUP BY SIS_ADMIN_DEPARTMENT_NAME ), inner_cte_2 AS ( SELECT MIN(c.TOTAL_UNITS) AS min_total_units, SUM(c.LECTURE_UNITS) AS sum_lecture_units FROM ACADEMIC_TERMS_ALL a JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON a.TERM_CODE = c.TERM_CODE WHERE a.TERM_CODE = '2021SP' AND c.GRADE_TYPE = 'L' AND c.DEPARTMENT_NAME = 'Mathematics' ) SELECT ic.COURSE_DESCRIPTION, ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, ic.admin_dept_dense_rank, NULL AS total_courses, NULL AS min_total_units, NULL AS sum_lecture_units, NULL AS num_unique_subjects, NULL AS term_description FROM inner_cte_1 ic UNION ALL SELECT NULL, NULL, NULL, ct.SIS_ADMIN_DEPARTMENT_NAME, NULL, ct.total_courses, NULL, NULL, NULL, NULL FROM CourseTotals ct UNION ALL SELECT NULL, a.DEPARTMENT_NAME, NULL, NULL, NULL, NULL, inner_cte_2.min_total_units, inner_cte_2.sum_lecture_units, COUNT(DISTINCT a.SUBJECT_ID) AS num_unique_subjects, b.TERM_DESCRIPTION FROM COURSE_CATALOG_SUBJECT_OFFERED a JOIN ACADEMIC_TERMS_ALL b ON a.TERM_CODE = b.TERM_CODE CROSS JOIN inner_cte_2 WHERE a.TERM_CODE = '2021SP' AND a.GRADE_TYPE = 'L' AND a.DEPARTMENT_NAME = 'Mathematics' GROUP BY a.DEPARTMENT_NAME, b.TERM_DESCRIPTION, inner_cte_2.min_total_units, inner_cte_2.sum_lecture_units ORDER BY SIS_ADMIN_DEPARTMENT_NAME, COURSE_DESCRIPTION\"}, {\"id\": \"dw_2224\", \"name\": \"Math Subject Code School Budget Code Windows with Non-Math Admin Department Clearing Cost Statistics\", \"desc\": \"For each subject code where the department is degree granting and the department is Mathematics, and for each department that is degree granting and is not the Mathematics department (Course 18), show the subject code, subject code description, mathematics department name, school name, the average department budget code within each school, the administrative department name, the average clearing cost collector, the variance of the clearing cost collector, the standard deviation (using STDDEV only and never STDDEV_POP) of the clearing cost collector, and the most recent activity date for the administrative department. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT scm.SUBJECT_CODE, scm.SUBJECT_CODE_DESC, scm.DEPARTMENT_NAME AS mathematics_department_name, scm.SCHOOL_NAME, scm.avg_dept_budget_code, ads.DEPARTMENT_NAME AS admin_department_name, ads.avg_clearing_cost_collector, ads.clearing_cost_collector_variance, ads.clearing_cost_collector_stddev FROM ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME, AVG(t0.DEPT_BUDGET_CODE) OVER (PARTITION BY t1.SCHOOL_NAME ORDER BY t0.DEPARTMENT_NAME) AS avg_dept_budget_code FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' AND t0.DEPARTMENT_NAME = 'Mathematics' ORDER BY t0.DEPARTMENT_NAME ) scm CROSS JOIN ( SELECT d.DEPARTMENT_NAME, AVG(a.CLEARING_COST_COLLECTOR) AS avg_clearing_cost_collector, VARIANCE(a.CLEARING_COST_COLLECTOR) AS clearing_cost_collector_variance, STDDEV(a.CLEARING_COST_COLLECTOR) AS clearing_cost_collector_stddev, MAX(a.LAST_ACTIVITY_DATE) AS most_recent_activity_date FROM SIS_DEPARTMENT d JOIN SIS_ADMIN_DEPARTMENT a ON d.DEPARTMENT_CODE = a.SIS_ADMIN_DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_NAME != 'Mathematics' AND d.DEPARTMENT_CODE != '18' GROUP BY d.DEPARTMENT_NAME ORDER BY clearing_cost_collector_variance DESC ) ads ) SELECT inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.mathematics_department_name, inner_cte.SCHOOL_NAME, inner_cte.avg_dept_budget_code, inner_cte.admin_department_name, inner_cte.avg_clearing_cost_collector, inner_cte.clearing_cost_collector_variance, inner_cte.clearing_cost_collector_stddev, ads2.most_recent_activity_date FROM inner_cte JOIN ( SELECT d.DEPARTMENT_NAME, MAX(a.LAST_ACTIVITY_DATE) AS most_recent_activity_date FROM SIS_DEPARTMENT d JOIN SIS_ADMIN_DEPARTMENT a ON d.DEPARTMENT_CODE = a.SIS_ADMIN_DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_NAME != 'Mathematics' AND d.DEPARTMENT_CODE != '18' GROUP BY d.DEPARTMENT_NAME ) ads2 ON inner_cte.admin_department_name = ads2.DEPARTMENT_NAME;\", \"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per Mathematics subject code crossed with each non-Mathematics degree-granting administrative department\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per top-3 Mathematics course per effective term\", \"desc\": \"For the top 3 most frequently offered courses in the Mathematics department, for each course and each term it was offered, display the course number, course description, subject title, number of times offered, department name, number of unique course descriptions for that course and department, the minimum CIP program code for that course and department, the term code, the term description, the school name, and the department phone number. Do not repeat the course number if it is the same as the previous row. Sort the table by course number and term code. Do not return any rounded answers.\", \"id\": \"dw_2365\", \"name\": \"Top 3 Most Offered Math Courses per Term with Description Counts, Min CIP Code, and Department Phone\", \"sql\": \"WITH inner_cte AS ( WITH course_desc_stats AS ( SELECT scd.COURSE, sd.DEPARTMENT_NAME, COUNT(DISTINCT scd.COURSE_DESCRIPTION) AS course_description_count, MIN(scd.CIP_PROGRAM_CODE) AS min_cip_program_code FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT sad ON sd.DEPARTMENT_CODE = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY scd.COURSE, sd.DEPARTMENT_NAME ), top_math_courses AS ( SELECT ssc.COURSE_NUMBER, scd.COURSE_DESCRIPTION, ccc.SUBJECT_TITLE, COUNT(*) AS offer_count FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_SUBJECT_CODE ssc ON scd.COURSE = ssc.SUBJECT_CODE JOIN CIS_COURSE_CATALOG ccc ON ssc.SUBJECT_CODE = ccc.SUBJECT_CODE WHERE scd.DEPARTMENT_NAME = 'Mathematics' GROUP BY ssc.COURSE_NUMBER, scd.COURSE_DESCRIPTION, ccc.SUBJECT_TITLE ORDER BY offer_count DESC LIMIT 3 ) SELECT tmc.COURSE_NUMBER, tmc.COURSE_DESCRIPTION, tmc.SUBJECT_TITLE, tmc.offer_count, cds.DEPARTMENT_NAME, cds.course_description_count, cds.min_cip_program_code, scd.FROM_TERM, scd.FROM_TERM_DESCRIPTION, scd.SCHOOL_NAME, sad.DEPARTMENT_PHONE_NUMBER FROM top_math_courses tmc JOIN SIS_COURSE_DESCRIPTION scd ON tmc.COURSE_DESCRIPTION = scd.COURSE_DESCRIPTION JOIN course_desc_stats cds ON scd.COURSE = cds.COURSE AND cds.DEPARTMENT_NAME = 'Mathematics' JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT sad ON sd.DEPARTMENT_CODE = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY tmc.COURSE_NUMBER, tmc.COURSE_DESCRIPTION, tmc.SUBJECT_TITLE, tmc.offer_count, cds.DEPARTMENT_NAME, cds.course_description_count, cds.min_cip_program_code, scd.FROM_TERM, scd.FROM_TERM_DESCRIPTION, scd.SCHOOL_NAME, sad.DEPARTMENT_PHONE_NUMBER ORDER BY tmc.COURSE_NUMBER, scd.FROM_TERM ) SELECT CASE WHEN LAG(COURSE_NUMBER) OVER (ORDER BY COURSE_NUMBER, FROM_TERM) = COURSE_NUMBER THEN NULL ELSE COURSE_NUMBER END AS COURSE_NUMBER, COURSE_DESCRIPTION, SUBJECT_TITLE, offer_count, DEPARTMENT_NAME, course_description_count, min_cip_program_code, FROM_TERM, FROM_TERM_DESCRIPTION, SCHOOL_NAME, DEPARTMENT_PHONE_NUMBER FROM inner_cte ORDER BY COURSE_NUMBER, FROM_TERM;\"}], \"not_found\": []}"
    },
