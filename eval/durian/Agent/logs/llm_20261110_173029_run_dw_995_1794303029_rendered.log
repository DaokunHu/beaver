    {
      "role": "tool",
      "tool_call_id": "call_2d7a2550101c4652934b8aa5",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics IAP activity per academic year per department\", \"desc\": \"For IAP subjects in the \\\"Mathematics\\\" category, show the activity title, enrollment type, maximum enrollment, category name, activity description, and the row number within each enrollment type group ordered by activity title, along with the academic year, department name, average enrollment, enrollment variance, department phone number, and school name for each academic year and department where the IAP subject's term matches a department's fall term subject offering with more than 0 enrolled students. Do not return any rounded answers.\", \"id\": \"dw_4229\", \"name\": \"Mathematics IAP Category Activities Matched with Fall-Term Department Enrollment Statistics\", \"sql\": \"WITH inner_cte1 AS ( SELECT d.ACTIVITY_TITLE, d.ENROLLMENT_TYPE, d.MAX_ENROLLMENT, c.IAP_CATEGORY_NAME, ROW_NUMBER() OVER (PARTITION BY d.ENROLLMENT_TYPE ORDER BY d.ACTIVITY_TITLE) AS window_column, d.TERM_CODE FROM IAP_SUBJECT_DETAIL d JOIN IAP_SUBJECT_CATEGORY c ON d.IAP_SUBJECT_CATEGORY_KEY = c.IAP_SUBJECT_CATEGORY_KEY WHERE c.IAP_CATEGORY_NAME = 'Mathematics' ), subq1 AS ( SELECT inner_cte1.ACTIVITY_TITLE, inner_cte1.ENROLLMENT_TYPE, inner_cte1.MAX_ENROLLMENT, inner_cte1.IAP_CATEGORY_NAME, d.ACTIVITY_DESCRIPTION, inner_cte1.window_column, inner_cte1.TERM_CODE FROM inner_cte1 JOIN IAP_SUBJECT_DETAIL d ON inner_cte1.ACTIVITY_TITLE = d.ACTIVITY_TITLE AND inner_cte1.ENROLLMENT_TYPE = d.ENROLLMENT_TYPE ), inner_cte2 AS ( SELECT ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS, COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE FROM COURSE_CATALOG_SUBJECT_OFFERED JOIN ACADEMIC_TERMS_ALL ON COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE = ACADEMIC_TERMS_ALL.TERM_CODE JOIN TIP_SUBJECT_OFFERED ON ACADEMIC_TERMS_ALL.TERM_CODE = TIP_SUBJECT_OFFERED.TERM_CODE WHERE COURSE_CATALOG_SUBJECT_OFFERED.IS_OFFERED_FALL_TERM = 'Y' AND TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS > 0 ), subq2 AS ( SELECT inner_cte2.ACADEMIC_YEAR, inner_cte2.DEPARTMENT_NAME, AVG(inner_cte2.NUM_ENROLLED_STUDENTS) AS avg_enrollment, VARIANCE(inner_cte2.NUM_ENROLLED_STUDENTS) AS enrollment_variance, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.SCHOOL_NAME AS school_name, inner_cte2.TERM_CODE FROM inner_cte2 LEFT JOIN SIS_DEPARTMENT sd ON inner_cte2.DEPARTMENT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE GROUP BY inner_cte2.ACADEMIC_YEAR, inner_cte2.DEPARTMENT_NAME, ad.DEPARTMENT_PHONE_NUMBER, sd.SCHOOL_NAME, inner_cte2.TERM_CODE ) SELECT s1.ACTIVITY_TITLE, s1.ENROLLMENT_TYPE, s1.MAX_ENROLLMENT, s1.IAP_CATEGORY_NAME, s1.ACTIVITY_DESCRIPTION, s1.window_column, s2.ACADEMIC_YEAR, s2.DEPARTMENT_NAME, s2.avg_enrollment, s2.enrollment_variance, s2.department_phone, s2.school_name FROM subq1 s1 JOIN subq2 s2 ON s1.TERM_CODE = s2.TERM_CODE ORDER BY s1.ACTIVITY_TITLE, s2.ACADEMIC_YEAR, s2.DEPARTMENT_NAME\"}, {\"id\": \"dw_1689\", \"name\": \"School Highest Department Average TIP Enrollment with 2019FA Chemistry Course-Material Subject Dense Ranks\", \"desc\": \"For each school, what is the school name and the highest average number of enrolled students per department (among its degree-granting departments, excluding Chemistry, and only considering subjects with at least one enrolled student), and for each subject offered by the Chemistry department in the 2019FA term that has course materials, what is the subject title, the dense rank of the subject considering the current and 2 preceding rows ordered by the number of enrolled students descending, the full name of the offering department, and the school name of the Chemistry department? List the school name and highest average enrolled students per department first, followed by the Chemistry subject title, dense rank, department full name, and Chemistry school name. Do not return any rounded answers.\", \"sql\": \"WITH dept_enrollment_stats AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, AVG(tso.NUM_ENROLLED_STUDENTS) AS avg_enrolled, MAX(tso.NUM_ENROLLED_STUDENTS) - MIN(tso.NUM_ENROLLED_STUDENTS) AS range_enrolled, VARIANCE(tso.NUM_ENROLLED_STUDENTS) AS var_enrolled FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 AND tso.OFFER_DEPT_NAME <> 'Chemistry' GROUP BY sd.DEPARTMENT_NAME, sd.SCHOOL_NAME ), school_max_avg_enrollment AS ( SELECT SCHOOL_NAME, MAX(avg_enrolled) AS highest_avg_enrolled_per_dept FROM dept_enrollment_stats GROUP BY SCHOOL_NAME ), chemistry_subjects_ranked AS ( SELECT inner_cte.SUBJECT_TITLE, inner_cte.dense_rank_num_enrolled, inner_cte.DEPARTMENT_FULL_NAME, sd.SCHOOL_NAME FROM ( SELECT tso.SUBJECT_TITLE, DENSE_RANK() OVER ( ORDER BY tso.NUM_ENROLLED_STUDENTS DESC ROWS BETWEEN 2 PRECEDING AND CURRENT ROW ) AS dense_rank_num_enrolled, sd.DEPARTMENT_FULL_NAME, tso.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED tso JOIN STUDENT_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE WHERE tso.TERM_CODE = '2019FA' AND tso.OFFER_DEPT_NAME = 'Chemistry' AND tso.IS_NO_COURSE_MATERIAL = 'N' ) inner_cte JOIN STUDENT_DEPARTMENT sd ON inner_cte.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE ) SELECT smax.SCHOOL_NAME, smax.highest_avg_enrolled_per_dept, csr.SUBJECT_TITLE, csr.dense_rank_num_enrolled, csr.DEPARTMENT_FULL_NAME, csr.SCHOOL_NAME AS chemistry_school_name FROM school_max_avg_enrollment smax CROSS JOIN chemistry_subjects_ranked csr;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per school-level highest department average enrollment cross joined with each 2019FA Chemistry TIP subject having course materials\"}], \"not_found\": []}"
    },
