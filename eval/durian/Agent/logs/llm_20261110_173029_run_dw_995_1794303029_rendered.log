      "tool_call_id": "call_3897b4d8bd5241eea4a419e9",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject per source term\", \"desc\": \"List all subjects from the term \\\"2010FA\\\" and all subjects offered in the term with code \\\"2025FA\\\", showing for each row: subject ID, term description, material status key, academic year, rank of the subject within each academic year group ordered by subject ID, subject title, offering department name, number of enrolled students, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, and the source term (\\\"2010FA\\\" or \\\"2025FA\\\"). The columns should appear in the following order: subject ID, term description, material status key, academic year, rank, subject title, offering department name, number of enrolled students, term start date, term end date, term parameter, minimum enrolled students per department, and source term. Order the results by subject ID and source term. Do not return any rounded answers.\", \"id\": \"dw_3224\", \"name\": \"Union of 2010FA TIP Material Subjects and 2025FA Offered Subjects with Department Min Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t2.SUBJECT_ID, t0.TERM_DESCRIPTION, t2.TIP_MATERIAL_STATUS_KEY, t1.ACADEMIC_YEAR, RANK() OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t2.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN TIP_DETAIL t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t2.TERM_CODE = '2010FA' ), Subq2 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TERM_START_DATE, t1.TERM_END_DATE, t2.TERM_PARAMETER, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_students_per_dept FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2025FA' ), CombinedSubjects AS ( SELECT s1.SUBJECT_ID, s1.TERM_DESCRIPTION, s1.TIP_MATERIAL_STATUS_KEY, s1.ACADEMIC_YEAR, s1.window_column, NULL AS SUBJECT_TITLE, NULL AS OFFER_DEPT_NAME, NULL AS NUM_ENROLLED_STUDENTS, NULL AS TERM_START_DATE, NULL AS TERM_END_DATE, NULL AS TERM_PARAMETER, NULL AS min_enrolled_students_per_dept, '2010FA' AS SOURCE_TERM FROM Subq1 s1 UNION ALL SELECT s2.SUBJECT_ID, s2.TERM_DESCRIPTION, NULL AS TIP_MATERIAL_STATUS_KEY, s2.ACADEMIC_YEAR, NULL AS window_column, s2.SUBJECT_TITLE, s2.OFFER_DEPT_NAME, s2.NUM_ENROLLED_STUDENTS, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.TERM_PARAMETER, s2.min_enrolled_students_per_dept, '2025FA' AS SOURCE_TERM FROM Subq2 s2 ) SELECT * FROM CombinedSubjects ORDER BY SUBJECT_ID, SOURCE_TERM;\"}, {\"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per department-year-activity-sponsor combination\", \"desc\": \"For each department, academic year, activity title, and sponsor name where the subject enrollment number is greater than 10 and the maximum enrollment for the activity is greater than 10, provide the department name, academic year, number of unique subjects, minimum total units offered, activity title, sponsor name, number of unique activities, minimum fee, and the sponsor type. Do not return any rounded answers.\", \"id\": \"dw_4515\", \"name\": \"Department Year Subject Statistics Matched with IAP Activity Sponsor Statistics\", \"sql\": \"WITH inner_cte AS ( WITH DeptSubjectStats AS ( SELECT c.DEPARTMENT_NAME, t.ACADEMIC_YEAR, COUNT(DISTINCT c.SUBJECT_ID) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS t ON c.TERM_CODE = t.TERM_CODE JOIN SUBJECT_SUMMARY s ON t.TERM_CODE = s.TERM_CODE AND c.SUBJECT_ID = s.SUBJECT_ID WHERE s.SUBJECT_ENROLLMENT_NUMBER > 10 GROUP BY c.DEPARTMENT_NAME, t.ACADEMIC_YEAR ), ActivitySponsorStats AS ( SELECT d.ACTIVITY_TITLE, s.SPONSOR_NAME, COUNT(DISTINCT d.IAP_SUBJECT_SESSION_KEY) AS activity_count, MIN(d.FEE) AS min_fee FROM IAP_SUBJECT_DETAIL d JOIN IAP_SUBJECT_SPONSOR s ON d.IAP_SUBJECT_SPONSOR_KEY = s.IAP_SUBJECT_SPONSOR_KEY WHERE d.MAX_ENROLLMENT > 10 GROUP BY d.ACTIVITY_TITLE, s.SPONSOR_NAME ), TermJoin AS ( SELECT t.ACADEMIC_YEAR, d.TERM_CODE, d.ACTIVITY_TITLE, s.SPONSOR_NAME FROM IAP_SUBJECT_DETAIL d JOIN ACADEMIC_TERMS t ON d.TERM_CODE = t.TERM_CODE JOIN IAP_SUBJECT_SPONSOR s ON d.IAP_SUBJECT_SPONSOR_KEY = s.IAP_SUBJECT_SPONSOR_KEY GROUP BY t.ACADEMIC_YEAR, d.TERM_CODE, d.ACTIVITY_TITLE, s.SPONSOR_NAME ) SELECT dss.DEPARTMENT_NAME, dss.ACADEMIC_YEAR, dss.subject_count, dss.min_total_units, ass.ACTIVITY_TITLE, ass.SPONSOR_NAME, ass.activity_count, ass.min_fee FROM DeptSubjectStats dss JOIN TermJoin tj ON dss.ACADEMIC_YEAR = tj.ACADEMIC_YEAR JOIN ActivitySponsorStats ass ON tj.ACTIVITY_TITLE = ass.ACTIVITY_TITLE AND tj.SPONSOR_NAME = ass.SPONSOR_NAME ORDER BY dss.DEPARTMENT_NAME, dss.ACADEMIC_YEAR, ass.ACTIVITY_TITLE, ass.SPONSOR_NAME ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.ACADEMIC_YEAR, inner_cte.subject_count, inner_cte.min_total_units, inner_cte.ACTIVITY_TITLE, inner_cte.SPONSOR_NAME, inner_cte.activity_count, inner_cte.min_fee, s.SPONSOR_TYPE FROM inner_cte JOIN IAP_SUBJECT_SPONSOR s ON inner_cte.SPONSOR_NAME = s.SPONSOR_NAME ORDER BY inner_cte.DEPARTMENT_NAME, inner_cte.ACADEMIC_YEAR, inner_cte.ACTIVITY_TITLE, inner_cte.SPONSOR_NAME;\"}, {\"category\": \"IAP Activity and Academic Term Comprehensive Analysis\", \"default_granularity\": \"one row per previous term matched with IAP subject category statistics\", \"desc\": \"For each previous academic term where the term start date matches the minimum academic term start date for a subject category and academic year with more than 10 maximum enrollment, show the term code, term description, term start date, calendar date, day of week, the average calendar year within each calendar year group ordered by term start date, the subject category key, academic year, number of unique subjects, minimum academic term start date, the normalized subjects per year rounded (number of unique subjects divided by the average calendar year), and for each such term, also list the number of unique subject IDs offered in that term and the earliest preregistration deadline among those subjects.\", \"id\": \"dw_5095\", \"name\": \"Previous Terms Matching IAP Category Min Start Dates with Normalized Subjects per Year\", \"sql\": \"WITH inner_cte AS ( SELECT t1.TERM_CODE, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t0.CALENDAR_DATE, t0.DAY_OF_WEEK, AVG(t0.CALENDAR_YEAR) OVER (PARTITION BY t0.CALENDAR_YEAR ORDER BY t1.TERM_START_DATE) AS window_column FROM TIME_DAY t0 JOIN ACADEMIC_TERMS t1 ON t0.CALENDAR_DATE = t1.TERM_START_DATE WHERE t1.TERM_STATUS = 'Previous' ), SubjectCategoryStats AS ( SELECT i.IAP_SUBJECT_CATEGORY_KEY, a.ACADEMIC_YEAR, COUNT(DISTINCT i.IAP_SUBJECT_SESSION_KEY) AS subject_count, MIN(a.TERM_START_DATE) AS min_term_start_date FROM IAP_SUBJECT_DETAIL i JOIN ACADEMIC_TERMS a ON i.TERM_CODE = a.TERM_CODE JOIN TIP_DETAIL t ON a.TERM_CODE = t.TERM_CODE WHERE i.MAX_ENROLLMENT > 10 GROUP BY i.IAP_SUBJECT_CATEGORY_KEY, a.ACADEMIC_YEAR ), TermSubjectInfo AS ( SELECT t.TERM_CODE, COUNT(DISTINCT td.SUBJECT_ID) AS unique_subject_ids, MIN(i.PREREG_DEADLINE) AS earliest_prereg_deadline FROM ACADEMIC_TERMS t JOIN TIP_DETAIL td ON t.TERM_CODE = td.TERM_CODE JOIN IAP_SUBJECT_DETAIL i ON t.TERM_CODE = i.TERM_CODE GROUP BY t.TERM_CODE ) SELECT icte.TERM_CODE, icte.TERM_DESCRIPTION, icte.TERM_START_DATE, icte.CALENDAR_DATE, icte.DAY_OF_WEEK, icte.window_column, scs.IAP_SUBJECT_CATEGORY_KEY, scs.ACADEMIC_YEAR, scs.subject_count, scs.min_term_start_date, ROUND(scs.subject_count / NULLIF(icte.window_column, 0), 2) AS Normalized_Subjects_Per_Year, tsi.unique_subject_ids, tsi.earliest_prereg_deadline FROM inner_cte icte JOIN SubjectCategoryStats scs ON icte.TERM_START_DATE = scs.min_term_start_date JOIN TermSubjectInfo tsi ON icte.TERM_CODE = tsi.TERM_CODE ORDER BY Normalized_Subjects_Per_Year DESC;\"}], \"not_found\": []}"
