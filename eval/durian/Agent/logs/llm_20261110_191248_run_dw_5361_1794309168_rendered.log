            "arguments": "{\"sql\": \"SELECT COUNT(*) AS total_orgs,\\n       SUM(CASE WHEN ORGANIZATION_NAME = 'ADMISSIONS' THEN 1 ELSE 0 END) AS admissions_cnt,\\n       SUM(CASE WHEN ORGANIZATION_ID IN ('138','250') THEN 1 ELSE 0 END) AS excluded_ids,\\n       SUM(CASE WHEN ASSIGNABLE = '1' THEN 1 ELSE 0 END) AS assignable_cnt\\nFROM FCLT_ORGANIZATION\"}"
