            "arguments": "{\"sql\": \"SELECT\\n  b.BUILDING_NAME,\\n  b.FISCAL_PERIOD,\\n  SUM(r.AREA) AS total_resident_labs_room_area,\\n  SUM(b.ASSIGNABLE_AREA) OVER (PARTITION BY b.CAMPUS_SECTOR ORDER BY b.FISCAL_PERIOD, b.BUILDING_NAME) AS running_sum_assignable_area,\\n  b.EXT_GROSS_AREA\\nFROM FCLT_BUILDING_HIST b\\nJOIN FCLT_ROOMS r ON b.FCLT_BUILDING_KEY = r.FCLT_BUILDING_KEY\\nJOIN FCLT_MAJOR_USE mu ON r.FCLT_MAJOR_USE_KEY = mu.FCLT_MAJOR_USE_KEY\\nWHERE b.BUILDING_TYPE = 'ACADEMIC'\\n  AND b.SITE = 'MIT'\\n  AND b.OWNERSHIP_TYPE = 'OWNED'\\n  AND b.FCLT_BUILDING_KEY <> '32'\\n  AND mu.MAJOR_USE IN ('RESIDENT', 'LABS')\\nGROUP BY b.BUILDING_NAME, b.FISCAL_PERIOD, b.CAMPUS_SECTOR, b.ASSIGNABLE_AREA, b.EXT_GROSS_AREA\\nHAVING SUM(r.AREA) > 1000\\nORDER BY b.FISCAL_PERIOD, b.BUILDING_NAME\"}"
          }
        }
      ]
