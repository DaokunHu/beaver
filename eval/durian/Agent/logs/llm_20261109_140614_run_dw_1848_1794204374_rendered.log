      "tool_call_id": "call_e3bf369a600b4781a5fa707f",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject\", \"desc\": \"For subjects offered in the 2019FA term that have total units greater than 1, show the subject title, the dense rank of each subject considering the current and 2 preceding rows ordered by the academic year, the subject ID, the department name, and the running sum of total units within each school ordered by subject ID. Do not return any rounded answers.\", \"id\": \"dw_3280\", \"name\": \"2019FA Subjects Dense Rank by Academic Year and School Running Sum of Total Units\", \"sql\": \"WITH subq1 AS ( SELECT t0.SUBJECT_TITLE, t0.SUBJECT_ID, dense_rank() OVER (ORDER BY t1.ACADEMIC_YEAR ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2019FA' ), subq2 AS ( SELECT t1.SUBJECT_ID, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, SUM(t1.TOTAL_UNITS) OVER (PARTITION BY t1.SCHOOL_CODE ORDER BY t1.SUBJECT_ID) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_CODE = '2019FA' AND t1.TOTAL_UNITS > 1 ) SELECT s1.SUBJECT_TITLE, s1.window_column AS subject_dense_rank, s2.SUBJECT_ID, s2.DEPARTMENT_NAME, s2.window_column AS running_sum_total_units FROM subq1 s1 JOIN subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID ORDER BY s2.SUBJECT_ID;\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject code matched with 2022FA subject\", \"desc\": \"For each subject in a department where the school code and subject title are not null, and for each subject offered in the 2022FA term with total units greater than the average for that term, display the subject code, subject code description, department name, subject title, the number of subjects in the same department, the subject ID, the term description, and the running sum of total units for that academic year, ordered by subject ID. Do not return any rounded answers.\", \"id\": \"dw_3867\", \"name\": \"Subject Code Department Counts Matched with 2022FA Above-Average Unit Running Sums\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SUBJECT_TITLE, t0.DEPARTMENT_CODE FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL ) SELECT inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.DEPARTMENT_NAME, inner_cte.SUBJECT_TITLE, dept_counts.subjects_in_department, inner_cte.DEPARTMENT_CODE FROM inner_cte JOIN ( SELECT t0.DEPARTMENT_CODE, COUNT(*) AS subjects_in_department FROM SIS_SUBJECT_CODE t0 JOIN CIS_COURSE_CATALOG t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_CODE IS NOT NULL AND t1.SUBJECT_TITLE IS NOT NULL GROUP BY t0.DEPARTMENT_CODE ) dept_counts ON inner_cte.DEPARTMENT_CODE = dept_counts.DEPARTMENT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_ID, t1.DEPARTMENT_NAME, t0.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t1.TOTAL_UNITS FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TERM_CODE = '2022FA' ) SELECT SUBJECT_ID, DEPARTMENT_NAME, TERM_DESCRIPTION, SUM(TOTAL_UNITS) OVER (PARTITION BY ACADEMIC_YEAR ORDER BY SUBJECT_ID) AS window_column, ACADEMIC_YEAR, TOTAL_UNITS FROM inner_cte WHERE TOTAL_UNITS > ( SELECT AVG(TOTAL_UNITS) FROM COURSE_CATALOG_SUBJECT_OFFERED WHERE TERM_CODE = '2022FA' ) ORDER BY SUBJECT_ID ) SELECT subq1.SUBJECT_CODE, subq1.SUBJECT_CODE_DESC, subq1.DEPARTMENT_NAME, subq1.SUBJECT_TITLE, subq1.subjects_in_department, subq2.SUBJECT_ID, subq2.TERM_DESCRIPTION, subq2.window_column FROM subq1 JOIN CIS_COURSE_CATALOG ccc ON subq1.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE JOIN subq2 ON ccc.SUBJECT_ID = subq2.SUBJECT_ID ORDER BY subq2.SUBJECT_ID;\"}, {\"id\": \"dw_1357\", \"name\": \"Access Level Campus Sector Room Count Variance Rollup with Fairchild Floor Room Area Statistics\", \"desc\": \"For each access level code and campus sector, what is the access level code, access level name, campus sector, the variance of the number of rooms in the building history for buildings with a nonzero number of rooms, assignable area greater than 0, and that are residential buildings at MIT, as well as, for each floor in the Fairchild Building with access level 1 or 2 and in academic buildings, the floor number, the building's long name, the range and variance of the area of rooms on that floor? Only include buildings that are at MIT. Also, include subtotals for each access level code (the corresponding campus sector field is 'SUBTOTAL') and a grand total across all access level codes (the corresponding campus sector field is 'TOTAL'). Do not repeat the access level code if it is the same as the previous row. Sort the table by access level code, campus sector, and floor. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte1 AS ( SELECT fb.ACCESS_LEVEL_CODE, fb.ACCESS_LEVEL_NAME, fbh.CAMPUS_SECTOR, fbh.NUM_OF_ROOMS FROM FCLT_BUILDING fb JOIN FCLT_BUILDING_HIST fbh ON fb.ACCESS_LEVEL_CODE = fbh.ACCESS_LEVEL_CODE WHERE fbh.NUM_OF_ROOMS > 0 AND fbh.ASSIGNABLE_AREA > 0 AND fbh.BUILDING_TYPE = 'RESIDENT' AND fbh.SITE = 'MIT' ), access_level_variance AS ( SELECT CASE WHEN LAG(ACCESS_LEVEL_CODE) OVER (ORDER BY access_level_code_sort, campus_sector_sort) = ACCESS_LEVEL_CODE THEN NULL ELSE ACCESS_LEVEL_CODE END AS access_level_code, ACCESS_LEVEL_NAME, campus_sector, num_of_rooms_variance, ACCESS_LEVEL_CODE AS join_access_level_code FROM ( SELECT CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 1 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'zzz' ELSE ACCESS_LEVEL_CODE END AS access_level_code_sort, CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 0 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'SUBTOTAL' WHEN GROUPING(ACCESS_LEVEL_CODE) = 1 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'TOTAL' ELSE CAMPUS_SECTOR END AS campus_sector, CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 0 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'zzz' ELSE CAMPUS_SECTOR END AS campus_sector_sort, ACCESS_LEVEL_CODE, MAX(ACCESS_LEVEL_NAME) AS ACCESS_LEVEL_NAME, VARIANCE(NUM_OF_ROOMS) AS num_of_rooms_variance FROM inner_cte1 GROUP BY ACCESS_LEVEL_CODE, CAMPUS_SECTOR WITH ROLLUP ) tbl ORDER BY access_level_code_sort, campus_sector_sort ), inner_cte2 AS ( SELECT fb.BUILDING_NAME_LONG, fr.FCLT_FLOOR_KEY, fr.AREA FROM FCLT_ROOMS fr JOIN FCLT_BUILDING fb ON fr.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY WHERE fr.ACCESS_LEVEL IN (1, 2) AND fb.BUILDING_TYPE = 'ACADEMIC' AND fb.FCLT_BUILDING_KEY = '36' ), floor_area_stats AS ( SELECT f.FLOOR, i.BUILDING_NAME_LONG, MAX(i.AREA) - MIN(i.AREA) AS area_range, VARIANCE(i.AREA) AS area_variance, fb.ACCESS_LEVEL_CODE AS join_access_level_code FROM inner_cte2 i JOIN FCLT_FLOOR f ON i.FCLT_FLOOR_KEY = f.FCLT_FLOOR_KEY JOIN FCLT_BUILDING fb ON fb.BUILDING_NAME_LONG = i.BUILDING_NAME_LONG GROUP BY f.FLOOR, i.BUILDING_NAME_LONG, fb.ACCESS_LEVEL_CODE ) SELECT alv.access_level_code, alv.ACCESS_LEVEL_NAME, alv.campus_sector, alv.num_of_rooms_variance, fas.FLOOR, fas.BUILDING_NAME_LONG, fas.area_range, fas.area_variance FROM access_level_variance alv JOIN floor_area_stats fas ON alv.join_access_level_code = fas.join_access_level_code ORDER BY alv.access_level_code, alv.campus_sector, fas.FLOOR\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per access-level/campus-sector rollup row matched with a floor of the selected academic building\"}], \"not_found\": []}"
