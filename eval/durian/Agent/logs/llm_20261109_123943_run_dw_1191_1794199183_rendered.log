            "name": "semantic_get",
            "arguments": "{\"entity_ids\": \n[\"concept_course_catalog_sources\", \"concept_department_dimension\", \"column_concept_total_units\", \"column_concept_subject_id\", \"column_concept_department_name\", \"column_concept_year_columns\"]\n\n}"
          }
