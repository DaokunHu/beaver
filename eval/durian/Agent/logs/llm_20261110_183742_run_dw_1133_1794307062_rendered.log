            "name": "mysql_query",
            "arguments": "{\"sql\": \"SELECT GRADE_TYPE, COUNT(*) AS cnt_all, COUNT(DISTINCT SUBJECT_ID) AS cnt_dist FROM COURSE_CATALOG_SUBJECT_OFFERED WHERE IS_OFFERED_THIS_YEAR='Y' AND GRADE_TYPE='L' AND DEPARTMENT_CODE='18' GROUP BY GRADE_TYPE\"}"
