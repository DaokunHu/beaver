      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_3131\", \"name\": \"Fiscal Period Calendar Year Variance with High/Low/Average Classification\", \"desc\": \"For each fiscal period, what is the fiscal period description, the variance of the calendar year for all days in that period where the academic year is not null, and whether the variance is 'HIGH_VARIANCE' (at least 20% greater than the average variance across all periods), 'LOW_VARIANCE' (at least 20% less than the average), or 'AVERAGE'? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT TIME_MONTH.FISCAL_PERIOD, TIME_MONTH.FISCAL_PERIOD_DESCRIPTION, VARIANCE(TIME_DAY.CALENDAR_YEAR) AS calendar_year_variance FROM TIME_MONTH JOIN TIME_DAY ON TIME_MONTH.FISCAL_PERIOD = TIME_DAY.FISCAL_PERIOD WHERE TIME_DAY.ACADEMIC_YEAR IS NOT NULL GROUP BY TIME_MONTH.FISCAL_PERIOD, TIME_MONTH.FISCAL_PERIOD_DESCRIPTION ) SELECT inner_cte.FISCAL_PERIOD, inner_cte.FISCAL_PERIOD_DESCRIPTION, inner_cte.calendar_year_variance, CASE WHEN inner_cte.calendar_year_variance > avg_stats.avg_variance * 1.2 THEN 'HIGH_VARIANCE' WHEN inner_cte.calendar_year_variance < avg_stats.avg_variance * 0.8 THEN 'LOW_VARIANCE' ELSE 'AVERAGE' END AS variance_category FROM inner_cte CROSS JOIN ( SELECT AVG(calendar_year_variance) AS avg_variance FROM inner_cte ) avg_stats ORDER BY inner_cte.calendar_year_variance DESC;\", \"category\": \"Fiscal Calendar Analysis\", \"default_granularity\": \"one row per fiscal period with days having a non-null academic year\"}, {\"id\": \"dw_2737\", \"name\": \"IAP Max Enrollment Statistics per Person Role with Capacity Classification\", \"desc\": \"For each person role, provide the person role name, the average, range, and variance of the maximum enrollment values for the activities they lead (considering only activities that are not cancelled and have a specified maximum enrollment), and indicate whether the average maximum enrollment for that role is 'HIGH_CAPACITY' (at least 20% greater than the overall average), 'LOW_CAPACITY' (at least 20% less than the overall average), or 'AVERAGE'. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT p.PERSON_ROLE, AVG(d.MAX_ENROLLMENT) AS avg_max_enrollment, MAX(d.MAX_ENROLLMENT) - MIN(d.MAX_ENROLLMENT) AS max_enrollment_range, VARIANCE(d.MAX_ENROLLMENT) AS max_enrollment_variance FROM IAP_SUBJECT_PERSON p JOIN IAP_SUBJECT_DETAIL d ON p.IAP_SUBJECT_PERSON_KEY = d.IAP_SUBJECT_PERSON_KEY WHERE d.IS_CANCELLED = 'N' AND d.MAX_ENROLLMENT IS NOT NULL GROUP BY p.PERSON_ROLE ) SELECT cte.PERSON_ROLE, cte.avg_max_enrollment, cte.max_enrollment_range, cte.max_enrollment_variance, CASE WHEN cte.avg_max_enrollment > overall.avg_enrollment * 1.2 THEN 'HIGH_CAPACITY' WHEN cte.avg_max_enrollment < overall.avg_enrollment * 0.8 THEN 'LOW_CAPACITY' ELSE 'AVERAGE' END AS capacity_category FROM inner_cte cte CROSS JOIN ( SELECT AVG(d.MAX_ENROLLMENT) AS avg_enrollment FROM IAP_SUBJECT_DETAIL d WHERE d.IS_CANCELLED = 'N' AND d.MAX_ENROLLMENT IS NOT NULL ) overall ORDER BY cte.max_enrollment_range DESC;\", \"category\": \"IAP Activity Analysis\", \"default_granularity\": \"one row per IAP person role\"}], \"not_found\": []}"
