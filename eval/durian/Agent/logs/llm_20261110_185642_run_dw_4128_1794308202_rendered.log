    {
      "role": "tool",
      "tool_call_id": "call_f6fadf724f1c4fd596ec36e4",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Academic Term Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering course per current term parameter\", \"desc\": \"For courses in the School of Engineering that are degree granting, and for academic term parameters where the term indicator is 'C', show the course description, department name, the dense rank of each course considering the current and 2 preceding rows ordered by the department's budget code, the term parameter, the term code, the academic year, and the running sum of academic years within each department ordered by academic year, for cases where the department matches in both sets. Do not return any rounded answers.\", \"id\": \"dw_3294\", \"name\": \"Engineering Degree-Granting Courses Dense Rank by Budget Code with Current Term Running Year Sum\", \"sql\": \"WITH EngCourses AS ( SELECT t0.COURSE_DESCRIPTION, t1.DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t1.DEPT_BUDGET_CODE ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column, t1.DEPARTMENT_CODE FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE WHERE t1.SCHOOL_NAME = 'Engineering' AND t1.IS_DEGREE_GRANTING = 'Y' ), TermParams AS ( SELECT t0.TERM_PARAMETER, t0.TERM_CODE, t1.ACADEMIC_YEAR, t2.DEPARTMENT_NAME, SUM(t1.ACADEMIC_YEAR) OVER (PARTITION BY t2.DEPARTMENT_NAME ORDER BY t1.ACADEMIC_YEAR) AS window_column, t2.DEPARTMENT_CODE FROM ACADEMIC_TERM_PARAMETER t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.EFFECTIVE_TERM_CODE WHERE t0.TERM_INDICATOR = 'C' ) SELECT ec.COURSE_DESCRIPTION, ec.DEPARTMENT_NAME, ec.window_column AS eng_course_dense_rank, tp.TERM_PARAMETER, tp.TERM_CODE, tp.ACADEMIC_YEAR, tp.window_column AS term_param_running_sum FROM EngCourses ec JOIN TermParams tp ON ec.DEPARTMENT_CODE = tp.DEPARTMENT_CODE\"}, {\"id\": \"dw_3644\", \"name\": \"2012SU 1-Unit Subject Row Numbers per Department with Department Offered Summary Unit Average-Stddev\", \"desc\": \"For subjects offered in the 2012SU term with a total of 1 unit, show the subject title from the summary, the course number from the offered table, the subject title from the offered summary, the department name from the summary, the offer department name from the offered summary, the row number within each department name group ordered by subject title from the summary, and for each department, also provide the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student). List the results ordered by department name and row number. Do not return any rounded answers.\", \"sql\": \"WITH subq1 AS ( SELECT t2.SUBJECT_TITLE AS summary_subject_title, t1.COURSE_NUMBER, t0.SUBJECT_TITLE AS offered_summary_subject_title, t2.DEPARTMENT_NAME, t0.OFFER_DEPT_NAME, ROW_NUMBER() OVER (PARTITION BY t2.DEPARTMENT_NAME ORDER BY t2.SUBJECT_TITLE) AS window_column FROM SUBJECT_OFFERED_SUMMARY t0 JOIN SUBJECT_OFFERED t1 ON t0.SUBJECT_ID_SORT = t1.SUBJECT_ID_SORT JOIN SUBJECT_SUMMARY t2 ON t1.SUBJECT_ID_SORT = t2.SUBJECT_ID_SORT WHERE t1.TERM_CODE = '2012SU' AND t2.TOTAL_UNITS = 1 ), subq2 AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_total_units, STDDEV(s.TOTAL_UNITS) AS stddev_total_units FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.TOTAL_UNITS > 0 AND s.NUM_ENROLLED_STUDENTS >= 1 GROUP BY d.DEPARTMENT_NAME ORDER BY stddev_total_units DESC ) SELECT subq1.summary_subject_title, subq1.COURSE_NUMBER, subq1.offered_summary_subject_title, subq1.DEPARTMENT_NAME, subq1.OFFER_DEPT_NAME, subq1.window_column, subq2.avg_total_units, subq2.stddev_total_units FROM subq1 LEFT JOIN subq2 ON subq1.DEPARTMENT_NAME = subq2.DEPARTMENT_NAME ORDER BY subq1.DEPARTMENT_NAME, subq1.window_column;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2012SU 1-unit subject (via SUBJECT_ID_SORT chain across offering tables) left joined with its department's total-units average and standard deviation\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per 2016SP subject in school E per department\", \"desc\": \"For subjects offered in the term '2016SP' with a school code of 'E', show the subject title, department name, course description, the number of enrolled students, the row number within a window of 2 preceding and 1 following rows ordered by subject title, and the highest running sum of academic years (within that department) for academic term parameters where the term indicator is 'C'. Do not return any rounded answers.\", \"id\": \"dw_4019\", \"name\": \"2016SP Engineering School Subjects with Current Term Parameter Running Year Sums\", \"sql\": \"WITH inner_cte1 AS ( SELECT t2.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.COURSE_DESCRIPTION, ROW_NUMBER() OVER (ORDER BY t2.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.COURSE_NUMBER = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.TERM_CODE = '2016SP' AND t0.SCHOOL_CODE = 'E' ), subq1 AS ( SELECT inner_cte1.SUBJECT_TITLE, inner_cte1.DEPARTMENT_NAME, inner_cte1.COURSE_DESCRIPTION, t2.NUM_ENROLLED_STUDENTS, inner_cte1.window_column FROM inner_cte1 JOIN SUBJECT_OFFERED_SUMMARY t2 ON inner_cte1.SUBJECT_TITLE = t2.SUBJECT_TITLE AND t2.TERM_CODE = '2016SP' ), inner_cte2 AS ( SELECT t0.TERM_PARAMETER, t0.TERM_CODE, t1.ACADEMIC_YEAR, t2.DEPARTMENT_NAME, SUM(t1.ACADEMIC_YEAR) OVER (PARTITION BY t2.DEPARTMENT_NAME ORDER BY t1.ACADEMIC_YEAR) AS window_column FROM ACADEMIC_TERM_PARAMETER t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.EFFECTIVE_TERM_CODE WHERE t0.TERM_INDICATOR = 'C' ), subq2 AS ( SELECT DEPARTMENT_NAME, MAX(window_column) AS highest_running_sum FROM inner_cte2 GROUP BY DEPARTMENT_NAME ) SELECT s1.SUBJECT_TITLE, s1.DEPARTMENT_NAME, s1.COURSE_DESCRIPTION, s1.NUM_ENROLLED_STUDENTS, s1.window_column, s2.highest_running_sum FROM subq1 s1 JOIN subq2 s2 ON s1.DEPARTMENT_NAME = s2.DEPARTMENT_NAME ORDER BY s1.SUBJECT_TITLE;\"}], \"not_found\": []}"
    },
