      "content": "{\"ok\": true, \"entities\": [{\"id\": \"FCLT_ROOMS\", \"name\": \"FCLT_ROOMS\", \"desc\": \"Facilities room inventory table: one row per physical room with building/floor keys, room identifiers, use classifications (major/minor use), organization assignment, area in square meters, access level, and geographic coordinates. Joins to FCLT_BUILDING via FCLT_BUILDING_KEY; referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE via FCLT_ROOM_KEY.\", \"columns\": {\"FCLT_ROOM_KEY\": {\"desc\": \"Surrogate key of the room; joins to COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE for class-meeting location analysis\"}, \"BUILDING_ROOM\": {\"desc\": \"Combined building-room identifier\"}, \"FCLT_BUILDING_KEY\": {\"desc\": \"Building identifier key of the room, storing the building number/code itself (e.g. 'E38', '14N'); can be filtered directly for a building or joined to FCLT_BUILDING.FCLT_BUILDING_KEY for building attributes\"}, \"FLOOR\": {\"desc\": \"Floor the room is on\"}, \"FCLT_FLOOR_KEY\": {\"desc\": \"Foreign key to FCLT_FLOOR\"}, \"ROOM\": {\"desc\": \"Room number/name\"}, \"SPACE_ID\": {\"desc\": \"Space identifier\"}, \"FCLT_MAJOR_USE_KEY\": {\"desc\": \"Major use key of the room; joins to FCLT_MAJOR_USE.FCLT_MAJOR_USE_KEY to decode the major use code/description and assignable flag\"}, \"MAJOR_USE_DESC\": {\"desc\": \"Major use description, e.g. classroom\"}, \"FCLT_USE_KEY\": {\"desc\": \"\"}, \"USE_DESC\": {\"desc\": \"Use description of the room\"}, \"FCLT_MINOR_USE_KEY\": {\"desc\": \"Minor use key of the room\"}, \"MINOR_USE_DESC\": {\"desc\": \"Minor use description\"}, \"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Organization key of the room\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Organization name occupying the room\"}, \"FCLT_MINOR_ORGANIZATION_KEY\": {\"desc\": \"Minor organization key of the room\"}, \"MINOR_ORGANIZATION\": {\"desc\": \"Minor organization name\"}, \"AREA\": {\"desc\": \"Room area in square meters; used in area statistics (average, range, variance)\"}, \"ROOM_FULL_NAME\": {\"desc\": \"Full room name\"}, \"DEPT_CODE\": {\"desc\": \"Department code assigned to the room\"}, \"ACCESS_LEVEL\": {\"desc\": \"Numeric access level code of the room (observed values 0-3); used to filter rooms by access restriction level, e.g. ACCESS_LEVEL = 1\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS)\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS)\"}, \"NORTHING_SPCS\": {\"desc\": \"Northing coordinate (SPCS)\"}, \"EASTING_SPCS\": {\"desc\": \"Easting coordinate (SPCS)\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per room\"}, {\"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Surrogate key of the facilities organization; joins to SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY\"}, \"ORGANIZATION_ID\": {\"desc\": \"Organization identifier (same value as the organization key in current data)\"}, \"ORGANIZATION\": {\"desc\": \"Short organization abbreviation, e.g. 'AERO', 'ADMISS'\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Display name of the organization, e.g. 'AERO & ASTRO'; used for organization-name reporting\"}, \"FCLT_ORG_PARENT_KEY\": {\"desc\": \"Key of the parent organization in the hierarchy tree; null for the top-level organization\"}, \"ORG_PARENT\": {\"desc\": \"Abbreviation of the parent organization, e.g. 'S ENG' (School of Engineering)\"}, \"FCLT_MAJOR_ORG_KEY\": {\"desc\": \"Key of the major (top-level grouping) organization this organization rolls up to\"}, \"MAJOR_ORG\": {\"desc\": \"Abbreviation of the major organization, e.g. 'PROVST', 'CHNCLR'\"}, \"ORGANIZATION_LEVEL\": {\"desc\": \"Level of the organization in the hierarchy tree (1 = institute-wide root, 2-4 = intermediate divisions/schools, 5 = department/DLC level, 6 = sub-organization); stored as string, filter with values like '5'\"}, \"ORGANIZATION_NUMBER\": {\"desc\": \"Official organization number used in administrative systems\"}, \"ORGANIZATION_SORT\": {\"desc\": \"Sortable hierarchical organization code reflecting the tree path\"}, \"ASSIGNABLE\": {\"desc\": \"Flag ('1'/'0') indicating whether the organization is an assignable-space organizational unit\"}, \"COURSE\": {\"desc\": \"Academic course (department) number for degree-granting academic departments, e.g. '16' for Aeronautics and Astronautics; null for non-academic organizations\"}, \"DESCRIPTION\": {\"desc\": \"Long description of the organization, e.g. 'Department of Aeronautics and Astronautics'; null for many non-academic organizations\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_AEROASTRO'; joins to FCLT_ORG_DLC_KEY.DLC_KEY, HR_ORG_UNIT.DLC_KEY (for HR org unit title/level and HR department attributes; may fan out when a DLC maps to multiple HR org units), and MASTER_DEPT_HIERARCHY.DLC_KEY (for the standard department hierarchy path)\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Aeronautics and Astronautics'\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code cross-reference\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"HR organization unit identifier cross-reference; links to HR_ORG_UNIT\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"Department name as recorded in HR systems\"}}, \"default_granularity\": \"one row per facilities organization\"}, {\"id\": \"dw_1465\", \"name\": \"Provost Area School of Science Department Organizations with Max Average Organization Number and Room Area Stddev\", \"desc\": \"For each department in the Provost Area at the School of Science level, excluding the Biology department, and for each organization within those departments (excluding organizations with IDs '138' and '250'), show the department name, department code, organization name, organization ID, the maximum average organization number within each department code group, and the standard deviation (using STDDEV only and never STDDEV_POP) of the area of rooms assigned to the organization (considering only organizations with more than 5 rooms and excluding organizations named 'ADMISSIONS'), ordered by department name and organization name. Do not return any rounded answers.\", \"sql\": \"WITH dept_max_avg_org AS ( WITH inner_cte AS ( SELECT t0.DLC_NAME, t0.DLC_CODE, t1.ORGANIZATION_NAME, t1.ORGANIZATION_ID, AVG(t1.ORGANIZATION_NUMBER) OVER (PARTITION BY t0.DLC_CODE ORDER BY t1.ORGANIZATION_SORT) AS avg_org_number FROM MASTER_DEPT_HIERARCHY t0 JOIN FCLT_ORGANIZATION t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' AND t0.MASTER_DEPT_HIER_LEVEL_3_NAME = 'School of Science' AND LOWER(t0.DLC_NAME) <> LOWER('Biology') AND t1.ORGANIZATION_ID NOT IN ('138', '250') ) SELECT DLC_NAME, DLC_CODE, ORGANIZATION_NAME, ORGANIZATION_ID, MAX(avg_org_number) AS max_avg_org_number FROM inner_cte GROUP BY DLC_NAME, DLC_CODE, ORGANIZATION_NAME, ORGANIZATION_ID ), org_area_stddev AS ( WITH inner_cte AS ( SELECT fo.ORGANIZATION_NAME, STDDEV(fr.AREA) AS area_stddev, fo.FCLT_ORGANIZATION_KEY FROM FCLT_ROOMS fr JOIN FCLT_ORGANIZATION fo ON fr.FCLT_ORGANIZATION_KEY = fo.FCLT_ORGANIZATION_KEY WHERE fo.ORGANIZATION_NAME <> 'ADMISSIONS' GROUP BY fo.ORGANIZATION_NAME, fo.FCLT_ORGANIZATION_KEY HAVING COUNT(fr.FCLT_ROOM_KEY) > 5 ) SELECT i.ORGANIZATION_NAME, fo.ORGANIZATION_NUMBER AS dept_code, i.area_stddev, fo.FCLT_ORGANIZATION_KEY FROM inner_cte i JOIN FCLT_ORGANIZATION fo ON i.FCLT_ORGANIZATION_KEY = fo.FCLT_ORGANIZATION_KEY ) SELECT d.DLC_NAME, d.DLC_CODE, d.ORGANIZATION_NAME, d.ORGANIZATION_ID, d.max_avg_org_number, o.area_stddev FROM dept_max_avg_org d JOIN FCLT_ORGANIZATION fo ON d.ORGANIZATION_ID = fo.ORGANIZATION_ID JOIN org_area_stddev o ON fo.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY ORDER BY d.DLC_NAME, d.ORGANIZATION_NAME\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per School-of-Science department organization matched with its room area standard deviation\"}, {\"category\": \"Course Catalog and Facility Space Comprehensive Analysis\", \"default_granularity\": \"one row per department-grade-type rollup row matched with organization room area statistics\", \"desc\": \"For each department and subject grade type where the subject is offered in the current academic year, is letter graded, and the department is Mathematics (Course 18), provide the number of subjects, the minimum total units, the school name, the department phone number, the organization name, the standard deviation (using STDDEV only and never STDDEV_POP) of the areas of its rooms, and the department's DLC name, including subtotals for each department (the corresponding department field is 'SUBTOTAL') and a grand total across all departments (the corresponding department field is 'TOTAL'). Do not repeat the department if it is the same as the previous row. Only include organizations that have more than 5 rooms, are associated with a non-null DLC key, and are not the 'ADMISSIONS' department or the 'Political Science' department. Sort the table by department, grade type, and descending standard deviation (using STDDEV only and never STDDEV_POP) of room areas. Do not return any rounded answers.\", \"id\": \"dw_1833\", \"name\": \"Math Letter-Graded Subject Rollup by Grade Type with Organization Room Area Stddev and DLC Name\", \"sql\": \"WITH inner_cte1 AS ( SELECT d.DEPARTMENT_NAME, c.GRADE_TYPE, COUNT(c.SUBJECT_ID) AS subject_count, MIN(c.TOTAL_UNITS) AS min_total_units FROM SIS_DEPARTMENT d JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON d.DEPARTMENT_CODE = c.DEPARTMENT_CODE WHERE c.IS_OFFERED_THIS_YEAR = 'Y' AND c.GRADE_TYPE = 'L' AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME, c.GRADE_TYPE ), cte1 AS ( SELECT CASE WHEN LAG(dept) OVER (ORDER BY dept_sort, grade_type) = dept THEN NULL ELSE dept END AS department, grade_type, subject_count, min_total_units, sd.SCHOOL_NAME AS school_name, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.DLC_KEY AS dlc_key FROM ( SELECT CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'zzz' ELSE DEPARTMENT_NAME END AS dept_sort, CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'TOTAL' ELSE DEPARTMENT_NAME END AS dept, GRADE_TYPE AS grade_type, COUNT(SUBJECT_COUNT) AS subject_count, MIN(min_total_units) AS min_total_units FROM inner_cte1 GROUP BY DEPARTMENT_NAME, GRADE_TYPE WITH ROLLUP ) tbltmp LEFT JOIN SIS_DEPARTMENT sd ON tbltmp.dept = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), inner_cte2 AS ( SELECT o.ORGANIZATION_NAME, STDDEV(r.AREA) AS area_stddev, o.DLC_KEY FROM FCLT_ORG_DLC_KEY d JOIN FCLT_ORGANIZATION o ON d.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY JOIN FCLT_ROOMS r ON o.FCLT_ORGANIZATION_KEY = r.FCLT_ORGANIZATION_KEY WHERE d.DLC_KEY IS NOT NULL AND o.ORGANIZATION_NAME NOT IN ('ADMISSIONS') AND o.ORGANIZATION_NAME <> 'Political Science' GROUP BY o.ORGANIZATION_NAME, o.DLC_KEY HAVING COUNT(*) > 5 ), cte2 AS ( SELECT inner_cte2.ORGANIZATION_NAME, inner_cte2.area_stddev, o2.DLC_NAME, inner_cte2.DLC_KEY FROM inner_cte2 JOIN FCLT_ORGANIZATION o2 ON inner_cte2.DLC_KEY = o2.DLC_KEY ) SELECT cte1.department, cte1.grade_type, cte1.subject_count, cte1.min_total_units, cte1.school_name, cte1.department_phone, cte2.ORGANIZATION_NAME, cte2.area_stddev, cte2.DLC_NAME FROM cte1 LEFT JOIN cte2 ON cte1.dlc_key = cte2.DLC_KEY ORDER BY cte1.department, cte1.grade_type, cte2.area_stddev DESC;\"}], \"not_found\": []}"
