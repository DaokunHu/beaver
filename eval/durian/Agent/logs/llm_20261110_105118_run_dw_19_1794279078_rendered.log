      "role": "tool",
      "tool_call_id": "call_da9673196a074fdf9f9056d8",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SIS_SUBJECT_CODE\", \"name\": \"SIS_SUBJECT_CODE\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\", \"columns\": {\"COURSE_NUMBER\": {\"desc\": \"Course number; joins to SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject code, e.g. '18'; joins to SIS_COURSE_DESCRIPTION.COURSE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"SUBJECT_CODE_DESC\": {\"desc\": \"Description of the subject code, typically the department/program name for that code\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering; used for school-level filtering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject code / course number\"}, {\"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"columns\": {\"SIS_COURSE_DESCRIPTION_KEY\": {\"desc\": \"Surrogate key of the course description record\"}, \"COURSE\": {\"desc\": \"Course/subject code, e.g. '18'; joins to SIS_SUBJECT_CODE.SUBJECT_CODE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"COURSE_DESCRIPTION\": {\"desc\": \"Short course description text; its character length is used in description-length statistics\"}, \"COURSE_DESCRIPTION_LONG\": {\"desc\": \"Long-form course description text\"}, \"DEPARTMENT\": {\"desc\": \"Department code offering the course; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name offering the course\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME\": {\"desc\": \"School name offering the course, e.g. 'Engineering'\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"FROM_TERM\": {\"desc\": \"First term the course description is effective from\"}, \"FROM_TERM_DESCRIPTION\": {\"desc\": \"Description of the from-term\"}, \"THRU_TERM\": {\"desc\": \"Last term the course description is effective through\"}, \"THRU_TERM_DESCRIPTION\": {\"desc\": \"Description of the thru-term\"}, \"COURSE_OPTION\": {\"desc\": \"Course option designation\"}, \"COURSE_LEVEL\": {\"desc\": \"Course level code, e.g. 'U' = undergraduate, 'G' = graduate\"}, \"CIP_PROGRAM_CODE\": {\"desc\": \"Six-digit CIP (Classification of Instructional Programs) program code of the course; joins to CIP.PROGRAM_CODE (current classification, one row per code) and CIP_WITH_VERSION.PROGRAM_CODE (all revision versions)\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the course counts toward a degree\"}, \"DEFAULT_ULTIMATE_DEGREE\": {\"desc\": \"Default ultimate degree awarded for the course\"}, \"GRADAUTE_LEVEL\": {\"desc\": \"Legacy misspelled graduate level column (kept for compatibility)\"}, \"GRADUATE_LEVEL\": {\"desc\": \"Graduate level designation of the course\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per course description\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}, {\"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS\", \"SUBJECT_SUMMARY.TOTAL_UNITS\", \"SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS\", \"CIS_COURSE_CATALOG.TOTAL_UNITS\", \"DRUPAL_COURSE_CATALOG.TOTAL_UNITS\"], \"comparisons\": [{\"dimension\": \"Source process\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS is the catalog-declared unit value per offering; SUBJECT_SUMMARY.TOTAL_UNITS and SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS are registrar subject-level values; CIS/DRUPAL catalog feeds carry their own copies\"}, {\"dimension\": \"Companion unit columns\", \"detail\": \"All these tables also expose LECTURE_UNITS, LAB_UNITS, and preparation units (PREPARATION_UNITS except SUBJECT_SUMMARY which uses PREP_UNITS); DESIGN_UNITS exists in COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY, CIS and DRUPAL catalogs but not in SUBJECT_OFFERED_SUMMARY\"}, {\"dimension\": \"Variability flag\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS marks subjects whose units vary; analyses of fixed-unit statistics typically filter IS_VARIABLE_UNITS='N'\"}], \"decision_guide\": {\"Unit statistics (avg/stddev/variance/geometric mean) over catalog offerings, optionally split by lecture/lab/design or filtered by variable-units flag\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS with its companion unit columns.\", \"Unit statistics tied to actual enrollment records or subject groups per term\": \"Use SUBJECT_SUMMARY.TOTAL_UNITS.\", \"Unit statistics at subject-offering rollup level with offering department/school\": \"Use SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS.\", \"Fixed-unit analyses excluding variable-unit subjects\": \"Filter COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS = 'N'.\"}, \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\", \"id\": \"column_concept_total_units\", \"name\": \"Total Credit Units\"}, {\"id\": \"column_concept_department_name\", \"name\": \"Department Name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME\", \"SUBJECT_SUMMARY.DEPARTMENT_NAME\", \"SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY.OFFER_DEPT_NAME\", \"TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SIS_DEPARTMENT.DEPARTMENT_NAME\", \"STUDENT_DEPARTMENT.DEPARTMENT_NAME\", \"SIS_COURSE_DESCRIPTION.DEPARTMENT_NAME\", \"SIS_SUBJECT_CODE.DEPARTMENT_NAME\", \"EMPLOYEE_DIRECTORY.DEPARTMENT_NAME\", \"LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT\", \"MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME\", \"SE_PERSON.ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DEPARTMENT_NAME is used by catalog/summary tables (COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY), department/course lookup tables, and the student directory (MIT_STUDENT_DIRECTORY); OFFER_DEPT_NAME is used by offering/program tables (SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY, TIP_SUBJECT_OFFERED, LIBRARY_SUBJECT_OFFERED) and denotes the department that actually offers the subject; LIBRARY_COURSE_INSTRUCTOR uses the plain column name DEPARTMENT for the course's academic department; SE_PERSON uses ORGANIZATION for the person's organizational unit\"}, {\"dimension\": \"Value format\", \"detail\": \"Catalog, summary, offering, student-directory, and lookup tables store plain department names (e.g. 'Mathematics', 'Chemistry', 'Electrical Eng & Computer Sci'); LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT stores a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics', '06 - Electrical Eng & Computer Sci'), with some unprefixed values (e.g. 'Architecture'), so it is not directly comparable to plain-name columns without stripping the prefix\"}, {\"dimension\": \"Academic vs HR/organization value domain\", \"detail\": \"Catalog, summary, offering, library, student-directory, and lookup tables share the academic department domain; EMPLOYEE_DIRECTORY.DEPARTMENT_NAME is the HR organizational unit name and has a different domain (e.g. 'Lincoln Laboratory', 'Department of Physics'), where some values coincide with academic names but many do not, and some carry a 'Department of ...' prefix; SE_PERSON.ORGANIZATION holds organizational unit names that may use different naming variants than the academic domain for the same unit (e.g. 'Electrical Engineering-Computer Science' vs the academic 'Electrical Eng & Computer Sci'), so equality filters across the two conventions must use each table's own variant\"}, {\"dimension\": \"Companion code column\", \"detail\": \"Catalog/summary tables carry DEPARTMENT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE; offering/program tables carry OFFER_DEPT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE or STUDENT_DEPARTMENT.DEPARTMENT_CODE; MIT_STUDENT_DIRECTORY carries DEPARTMENT (the academic department code) joining SIS_DEPARTMENT.DEPARTMENT_CODE, which is the reliable join key instead of the name; LIBRARY_COURSE_INSTRUCTOR has no department code column, only the prefixed name text; EMPLOYEE_DIRECTORY carries DEPARTMENT_NUMBER (HR department number) and SE_PERSON carries no department code, neither joining to SIS_DEPARTMENT.DEPARTMENT_CODE\"}], \"decision_guide\": {\"Filtering subjects by department in catalog or summary analysis\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME or SUBJECT_SUMMARY.DEPARTMENT_NAME.\", \"Filtering by department in section-level, textbook-program, or library analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Joining fact tables to department dimension attributes (school, full name, degree-granting)\": \"Prefer code joins: DEPARTMENT_CODE / OFFER_DEPT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE; name equality joins are used when codes are unavailable.\", \"Matching departments across a DEPARTMENT_NAME table and an OFFER_DEPT_NAME table\": \"The values are directly comparable (same academic name domain), e.g. joining SUBJECT_SUMMARY.DEPARTMENT_NAME to TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME.\", \"Filtering employees by their HR organizational unit (e.g. names containing 'Department', or HR units like 'Political Science')\": \"Use EMPLOYEE_DIRECTORY.DEPARTMENT_NAME; do not join it to SIS_DEPARTMENT.DEPARTMENT_CODE, and pair it with DEPARTMENT_NUMBER for HR grouping.\", \"Filtering by department in section-level, textbook-program, or library subject analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Filtering library reserve course instructors by academic department or library unit\": \"Use LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT with the prefixed value format (e.g. '18 - Mathematics'); do not compare it directly to plain department-name columns.\", \"Filtering students by their academic department\": \"Use MIT_STUDENT_DIRECTORY.DEPARTMENT (code) joined to SIS_DEPARTMENT.DEPARTMENT_CODE for reliable matching, or MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME for direct name filters; the name shares the academic domain with SIS_DEPARTMENT.DEPARTMENT_NAME.\", \"Filtering a person master (SE_PERSON) record by organizational unit such as an academic department\": \"Use SE_PERSON.ORGANIZATION with its own naming variant (e.g. 'Electrical Engineering-Computer Science'); do not equate it directly to MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME or SIS_DEPARTMENT.DEPARTMENT_NAME, which use the academic variant (e.g. 'Electrical Eng & Computer Sci').\"}}, {\"columns\": [\"ACADEMIC_TERMS.ACADEMIC_YEAR\", \"ACADEMIC_TERMS_ALL.ACADEMIC_YEAR\", \"COURSE_CATALOG_SUBJECT_OFFERED.ACADEMIC_YEAR\", \"TIME_DAY.ACADEMIC_YEAR\", \"TIME_DAY.FISCAL_YEAR\", \"TIME_DAY.CALENDAR_YEAR\", \"TIME_MONTH.ACADEMIC_YEAR\", \"TIME_MONTH.FISCAL_YEAR\", \"TIME_MONTH.CALENDAR_YEAR\", \"TIME_MONTH.FINANCIAL_AID_YEAR\", \"TIME_QUARTER.FISCAL_YEAR\", \"TIME_QUARTER.CALENDAR_YEAR\", \"ACADEMIC_TERMS.FINANCIAL_AID_YEAR\", \"ACADEMIC_TERMS_ALL.FINANCIAL_AID_YEAR\", \"ACADEMIC_TERMS.DEGREE_YEAR\"], \"comparisons\": [{\"dimension\": \"Year system\", \"detail\": \"ACADEMIC_YEAR is the academic year a term/offering/date belongs to; FISCAL_YEAR is the institute fiscal year (MIT fiscal year starts in July, so a fiscal year spans two calendar years); CALENDAR_YEAR is the natural calendar year; FINANCIAL_AID_YEAR is the aid year a term/month maps to; DEGREE_YEAR is the degree-conferral year a term maps to. These year systems do not always coincide for the same term or date.\"}, {\"dimension\": \"Location\", \"detail\": \"Term tables (ACADEMIC_TERMS/ACADEMIC_TERMS_ALL) carry academic/financial-aid/degree years per term; COURSE_CATALOG_SUBJECT_OFFERED carries its own ACADEMIC_YEAR per catalog record; the time dimension tables carry year systems at their own granularity: TIME_DAY (fiscal/calendar/academic year per day), TIME_MONTH (fiscal/calendar/academic/aid year per month), TIME_QUARTER (fiscal/calendar year per quarter, no academic year).\"}, {\"dimension\": \"Grouping behavior\", \"detail\": \"Grouping offerings by catalog ACADEMIC_YEAR vs joining to term tables' ACADEMIC_YEAR can yield different groupings when a catalog record's TERM_CODE and ACADEMIC_YEAR disagree; grouping time-dimension rows by FISCAL_YEAR vs CALENDAR_YEAR yields different period assignments for dates between January and June.\"}], \"decision_guide\": {\"Yearly statistics over subject offerings\": \"Group by COURSE_CATALOG_SUBJECT_OFFERED.ACADEMIC_YEAR when the question says 'academic year YYYY' for offerings; join term tables for term-status filters.\", \"Yearly statistics over terms themselves (e.g. degree year geometric means, financial aid year partitions)\": \"Use ACADEMIC_TERMS / ACADEMIC_TERMS_ALL year columns (DEGREE_YEAR, FINANCIAL_AID_YEAR).\", \"Matching IAP activity dates to academic years via calendar\": \"Use TIME_DAY.FISCAL_YEAR or TIME_DAY.ACADEMIC_YEAR through TERM_CODE = ACADEMIC_TERM_CODE.\", \"Windowed running sums partitioned by aid year\": \"Use ACADEMIC_TERMS_ALL.FINANCIAL_AID_YEAR as the partition key.\", \"Fiscal-year or calendar-month statistics over months/days\": \"Use TIME_MONTH.FISCAL_YEAR / TIME_MONTH.CALENDAR_YEAR (month grain) or TIME_DAY.CALENDAR_YEAR (day grain), joined on FISCAL_PERIOD when both grains are needed.\"}, \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\", \"id\": \"column_concept_year_columns\", \"name\": \"Academic and Fiscal Year Columns\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_e55358e7b5fd40d7aed6793b",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"count\": 27, \"items\": [{\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"entity_type\": \"table\", \"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\", \"entity_type\": \"table\", \"id\": \"ACADEMIC_TERMS_ALL\", \"name\": \"ACADEMIC_TERMS_ALL\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\", \"entity_type\": \"table\", \"id\": \"TIP_DETAIL\", \"name\": \"TIP_DETAIL\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\", \"entity_type\": \"table\", \"id\": \"LIBRARY_SUBJECT_OFFERED\", \"name\": \"LIBRARY_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Independent Activities Period (IAP) subject detail table: one row per IAP activity offered in a January term, with activity title/description, enrollment type, maximum enrollment, fee, prerequisites, preregistration deadline, cancellation and multiple-session flags, and foreign keys to category, sponsor, session, and person tables.\", \"entity_type\": \"table\", \"id\": \"IAP_SUBJECT_DETAIL\", \"name\": \"IAP_SUBJECT_DETAIL\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\", \"entity_type\": \"table\", \"id\": \"SIS_SUBJECT_CODE\", \"name\": \"SIS_SUBJECT_CODE\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"entity_type\": \"table\", \"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"entity_type\": \"table\", \"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Facilities room inventory table: one row per physical room with building/floor keys, room identifiers, use classifications (major/minor use), organization assignment, area in square meters, access level, and geographic coordinates. Joins to FCLT_BUILDING via FCLT_BUILDING_KEY; referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE via FCLT_ROOM_KEY.\", \"entity_type\": \"table\", \"id\": \"FCLT_ROOMS\", \"name\": \"FCLT_ROOMS\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"entity_type\": \"table\", \"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_OFFERED\", \"name\": \"SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"entity_type\": \"table\", \"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"entity_type\": \"table\", \"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\", \"entity_type\": \"table\", \"id\": \"CIS_COURSE_CATALOG\", \"name\": \"CIS_COURSE_CATALOG\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Employee directory table: one row per institute employee with MIT ID, legal and preferred name components, directory/primary titles, HR department number and name, office location and office phone, email address, personal URL, and Kerberos name. Used to resolve responsible faculty contact details (full name, email, office phone) for subject offerings via RESPONSIBLE_FACULTY_MIT_ID = MIT_ID, and to link employees to Moira mailing list membership via MIT_ID = MOIRA_LIST_MEMBER_MIT_ID.\", \"entity_type\": \"table\", \"id\": \"EMPLOYEE_DIRECTORY\", \"name\": \"EMPLOYEE_DIRECTORY\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"CIS lookup table decoding HASS (Humanities, Arts, and Social Sciences) attribute codes used in course catalog subject records. Each code (e.g. 'HA', 'HH', 'HS', 'HE', 'HD1'-'HD5', 'HDL', and combined codes like 'HA,HH') maps to two description variants: the description shown on the registration form and the shorter description printed in the bulletin, plus the CIS attribute group ('H' = HASS_ATTRIBUTE for students entering Fall 2010 or later, 'G' = GIR_ATTRIBUTE for students entering prior to Fall 2010) with a group note, and icon display attributes. Catalog tables (COURSE_CATALOG_SUBJECT_OFFERED, CIS_COURSE_CATALOG, DRUPAL_COURSE_CATALOG) join to this lookup via HASS_ATTRIBUTE. Note: a code can appear once per attribute group (e.g. 'HE' exists in both group H and group G), so joins on HASS_ATTRIBUTE alone may produce multiple matching rows.\", \"entity_type\": \"table\", \"id\": \"CIS_HASS_ATTRIBUTE\", \"name\": \"CIS_HASS_ATTRIBUTE\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Subject attribute lookup table decoding attribute codes attached to subjects: academic attributes (type 'A') such as calculus/science prerequisites and HASS-D/HASS category codes, and non-academic program flags (type 'N') such as ROTC, ESG, Concourse, co-op, and listener rules. Provides short, full, and reporting descriptions per code. Overlaps with CIS_HASS_ATTRIBUTE on HASS-family codes (HD1-HD5, HDL, HE, HA, HH, HS) but differs in scope: SUBJECT_ATTRIBUTE covers all subject attribute types with one description variant per code, while CIS_HASS_ATTRIBUTE covers only HASS attribute codes with separate registration-form and bulletin descriptions plus attribute-group (H/G) classification. Catalog subject records' GIR_ATTRIBUTE codes all resolve against SUBJECT_ATTRIBUTE_CODE.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_ATTRIBUTE\", \"name\": \"SUBJECT_ATTRIBUTE\"}, {\"relation_type\": \"concept\", \"direction\": \"incoming\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\", \"entity_type\": \"concept\", \"id\": \"concept_subject_offering_facts\", \"name\": \"Subject Offering Fact Tables\"}, {\"relation_type\": \"concept\", \"direction\": \"incoming\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\", \"entity_type\": \"concept\", \"id\": \"concept_course_catalog_sources\", \"name\": \"Course Catalog Sources\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_term_code\", \"name\": \"Term Code\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_subject_id\", \"name\": \"Subject Identifier\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_department_name\", \"name\": \"Department Name\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_total_units\", \"name\": \"Total Credit Units\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_year_columns\", \"name\": \"Academic and Fiscal Year Columns\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code and description columns. The code columns appear in the three course catalog feeds and in the CIS_HASS_ATTRIBUTE lookup; description columns exist in three variants: the catalog-embedded HASS_ATTRIBUTE_DESC, the lookup's DESCRIPTION_ON_FORM (registration-form wording), and DESCRIPTION_IN_BULLETIN (short bulletin wording). Selecting the right description variant depends on the wording requested by the question.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_hass_attribute\", \"name\": \"HASS Attribute Code and Descriptions\"}]}"
    },
