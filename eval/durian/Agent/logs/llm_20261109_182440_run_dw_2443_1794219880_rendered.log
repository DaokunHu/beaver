    {
      "role": "tool",
      "tool_call_id": "call_c16a2278088b4db2bcaad924",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Academic Term and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per previous-status term\", \"desc\": \"For each academic term where the term status indicator is 'P', show the term code, the term parameter, the term description, the academic year, the term start date, and the average academic year in a window of 2 preceding and 2 following rows grouped by the term indicator and ordered by the term start date. Additionally, for the academic year of each such term, give the academic year description, the average total units, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in regular terms, with the results ordered by term code and by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\", \"id\": \"dw_3417\", \"name\": \"Previous Terms Windowed Academic Year Average with Regular-Term Unit Stddev by Year\", \"sql\": \"WITH AcademicYearStats AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS avg_total_units, STDDEV(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS stddev_total_units FROM ACADEMIC_TERMS JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC ORDER BY stddev_total_units DESC ), PreviousTerms AS ( SELECT t0.TERM_CODE, t1.TERM_PARAMETER, t2.TERM_DESCRIPTION, t0.ACADEMIC_YEAR, t1.TERM_START_DATE, AVG(t0.ACADEMIC_YEAR) OVER ( PARTITION BY t1.TERM_INDICATOR ORDER BY t0.TERM_START_DATE ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN ACADEMIC_TERM_PARAMETER t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_INDICATOR = 'P' ) SELECT pts.TERM_CODE, pts.TERM_PARAMETER, pts.TERM_DESCRIPTION, pts.ACADEMIC_YEAR, pts.TERM_START_DATE, pts.window_column, ays.ACADEMIC_YEAR_DESC, ays.avg_total_units, ays.stddev_total_units FROM PreviousTerms pts JOIN AcademicYearStats ays ON pts.ACADEMIC_YEAR = ays.ACADEMIC_YEAR ORDER BY pts.TERM_CODE, ays.stddev_total_units DESC;\"}, {\"category\": \"Subject Offering Analysis\", \"default_granularity\": \"one row per department per academic year\", \"desc\": \"For each academic year, what is the description of the academic year, the department name, the average total units for all subjects offered by that department in terms that match that academic year and have a term status indicator of 'P', and the deviation of each department's average total units from the overall average total units for that academic year? Do not return any rounded answers.\", \"id\": \"dw_2597\", \"name\": \"Department Average Total Units Deviation from Yearly Overall Average in Previous Terms\", \"sql\": \"WITH inner_cte AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS dept_avg_total_units FROM ACADEMIC_TERMS_ALL JOIN ACADEMIC_TERMS ON ACADEMIC_TERMS_ALL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.TERM_STATUS_INDICATOR = 'P' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.ACADEMIC_YEAR_DESC, inner_cte.DEPARTMENT_NAME, inner_cte.dept_avg_total_units, (inner_cte.dept_avg_total_units - overall.avg_total_units) AS deviation_from_overall_avg FROM inner_cte JOIN ( SELECT ACADEMIC_YEAR, AVG(dept_avg_total_units) AS avg_total_units FROM ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS dept_avg_total_units FROM ACADEMIC_TERMS_ALL JOIN ACADEMIC_TERMS ON ACADEMIC_TERMS_ALL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.TERM_STATUS_INDICATOR = 'P' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME ) dept_avgs GROUP BY ACADEMIC_YEAR ) overall ON inner_cte.ACADEMIC_YEAR = overall.ACADEMIC_YEAR ORDER BY inner_cte.ACADEMIC_YEAR, deviation_from_overall_avg DESC;\"}, {\"id\": \"dw_41\", \"name\": \"Yearly Average and Variance of Math Full-Term Subject Total Units in Previous Terms\", \"desc\": \"For each academic year, provide the academic year description and calculate the average and variance of the total units for subjects offered in terms that are not the current term, have a term status indicator of 'P', are offered by the Mathematics department, and are full term subjects. Do not return any rounded answers.\", \"category\": \"Subject Offering Analysis\", \"sql\": \"WITH inner_cte AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, AVG(ccso.TOTAL_UNITS) AS avg_total_units, VARIANCE(ccso.TOTAL_UNITS) AS total_units_variance FROM ACADEMIC_TERMS_ALL ata JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE ata.IS_CURRENT_TERM = 'N' AND ata.TERM_STATUS_INDICATOR = 'P' AND ccso.DEPARTMENT_NAME = 'Mathematics' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC ) SELECT ic.ACADEMIC_YEAR, ic.ACADEMIC_YEAR_DESC, ic.avg_total_units, ic.total_units_variance FROM inner_cte ic JOIN ACADEMIC_TERMS_ALL ata ON ic.ACADEMIC_YEAR = ata.ACADEMIC_YEAR JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE ccso.TERM_DURATION = 'Full Term Subject' GROUP BY ic.ACADEMIC_YEAR, ic.ACADEMIC_YEAR_DESC, ic.avg_total_units, ic.total_units_variance ORDER BY ic.total_units_variance DESC;\", \"default_granularity\": \"one row per academic year\"}, {\"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per top reserved subject\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', display each subject title, the offering department name, the count of reserved materials, the academic year, the department name, the average of the total units, and the variance of the total units for subjects offered in regular terms, with the columns shown in that order. Do not return any rounded answers.\", \"id\": \"dw_3664\", \"name\": \"Top 10 Reserved-Material Subjects in 2009SP with Regular-Term Unit Average and Variance\", \"sql\": \"WITH avg_var_units AS ( SELECT c.ACADEMIC_YEAR, c.DEPARTMENT_NAME, AVG(c.TOTAL_UNITS) AS avg_total_units, VARIANCE(c.TOTAL_UNITS) AS var_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS t ON c.TERM_CODE = t.TERM_CODE WHERE t.IS_REGULAR_TERM = 'Y' GROUP BY c.ACADEMIC_YEAR, c.DEPARTMENT_NAME ORDER BY var_total_units DESC ), top_reserved_subjects AS ( SELECT s.SUBJECT_TITLE, s.OFFER_DEPT_NAME, COUNT(l.LIBRARY_RESERVE_CATALOG_KEY) AS reserved_materials FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE l.TERM_CODE = '2009SP' GROUP BY s.SUBJECT_TITLE, s.OFFER_DEPT_NAME ORDER BY reserved_materials DESC LIMIT 10 ) SELECT trs.SUBJECT_TITLE, trs.OFFER_DEPT_NAME, trs.reserved_materials, avu.ACADEMIC_YEAR, avu.DEPARTMENT_NAME, avu.avg_total_units, avu.var_total_units FROM top_reserved_subjects trs LEFT JOIN avg_var_units avu ON trs.OFFER_DEPT_NAME = avu.DEPARTMENT_NAME ORDER BY trs.reserved_materials DESC, avu.var_total_units DESC;\"}], \"not_found\": []}"
    },
