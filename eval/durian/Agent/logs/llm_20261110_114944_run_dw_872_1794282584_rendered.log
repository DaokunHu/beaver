            "arguments": "{\"sql\": \"SELECT COUNT(*) AS n, COUNT(DISTINCT t0.SUBJECT_ID) AS n_subj FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN CIS_COURSE_CATALOG t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2024 AND t0.DEPARTMENT_NAME = 'Mathematics'\"}"
