    {
      "role": "tool",
      "tool_call_id": "call_13e58311539243a6bd57b671",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level where the course is degree granting and the total units are greater than 6, provide the number of unique courses, the minimum total units offered, and the number of courses where the design units are at least 3. Do not return any rounded answers.\", \"id\": \"dw_3163\", \"name\": \"Degree-Granting Course Level Counts with Min Total Units and Design-Unit Course Counts\", \"sql\": \"WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT scd.COURSE) AS course_count, MIN(ccc.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units, COUNT(DISTINCT CASE WHEN ccc.DESIGN_UNITS >= 3 THEN scd.COURSE END) AS courses_with_design_units_3_or_more FROM inner_cte ic JOIN SIS_COURSE_DESCRIPTION scd ON ic.DEPARTMENT_NAME = scd.DEPARTMENT_NAME AND ic.COURSE_LEVEL = scd.COURSE_LEVEL JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units;\"}, {\"category\": \"Academic Term and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per previous-status term\", \"desc\": \"For each academic term where the term status indicator is 'P', show the term code, the term parameter, the term description, the academic year, the term start date, and the average academic year in a window of 2 preceding and 2 following rows grouped by the term indicator and ordered by the term start date. Additionally, for the academic year of each such term, give the academic year description, the average total units, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in regular terms, with the results ordered by term code and by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\", \"id\": \"dw_3417\", \"name\": \"Previous Terms Windowed Academic Year Average with Regular-Term Unit Stddev by Year\", \"sql\": \"WITH AcademicYearStats AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS avg_total_units, STDDEV(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS stddev_total_units FROM ACADEMIC_TERMS JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC ORDER BY stddev_total_units DESC ), PreviousTerms AS ( SELECT t0.TERM_CODE, t1.TERM_PARAMETER, t2.TERM_DESCRIPTION, t0.ACADEMIC_YEAR, t1.TERM_START_DATE, AVG(t0.ACADEMIC_YEAR) OVER ( PARTITION BY t1.TERM_INDICATOR ORDER BY t0.TERM_START_DATE ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN ACADEMIC_TERM_PARAMETER t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_INDICATOR = 'P' ) SELECT pts.TERM_CODE, pts.TERM_PARAMETER, pts.TERM_DESCRIPTION, pts.ACADEMIC_YEAR, pts.TERM_START_DATE, pts.window_column, ays.ACADEMIC_YEAR_DESC, ays.avg_total_units, ays.stddev_total_units FROM PreviousTerms pts JOIN AcademicYearStats ays ON pts.ACADEMIC_YEAR = ays.ACADEMIC_YEAR ORDER BY pts.TERM_CODE, ays.stddev_total_units DESC;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level where the course is degree granting, the total units are greater than 6, and the department is Mathematics (Course 18), provide the department name, course level, number of unique courses, minimum total units offered, school name, number of distinct course options available, and the highest average number of enrolled students in any term for courses offered by that department, considering only courses with more than 0 enrolled students and departments whose name is not null. Do not return any rounded answers.\", \"id\": \"dw_1766\", \"name\": \"Math Degree-Granting Course Level Counts with Min Units, Course Options, and Highest Term Average Library Enrollment\", \"sql\": \"WITH highest_avg_enrollment AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, l.TERM_CODE, AVG(l.NUM_ENROLLED_STUDENTS) AS avg_enrollment_per_term FROM SIS_SUBJECT_CODE s JOIN LIBRARY_SUBJECT_OFFERED l ON s.COURSE_NUMBER = l.COURSE_NUMBER WHERE l.NUM_ENROLLED_STUDENTS > 0 AND s.DEPARTMENT_NAME IS NOT NULL AND s.DEPARTMENT_NAME = 'Mathematics' GROUP BY s.DEPARTMENT_NAME, l.TERM_CODE ) SELECT DEPARTMENT_NAME, MAX(avg_enrollment_per_term) AS highest_avg_enrollment_per_term FROM inner_cte GROUP BY DEPARTMENT_NAME ), course_stats AS ( WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT scd.COURSE) AS course_count, MIN(ccc.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 AND scd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT icte.DEPARTMENT_NAME, icte.COURSE_LEVEL, icte.course_count, icte.min_total_units, scd.SCHOOL_NAME, COUNT(DISTINCT scd.COURSE_OPTION) AS distinct_course_options FROM inner_cte icte JOIN SIS_COURSE_DESCRIPTION scd ON icte.DEPARTMENT_NAME = scd.DEPARTMENT_NAME AND icte.COURSE_LEVEL = scd.COURSE_LEVEL GROUP BY icte.DEPARTMENT_NAME, icte.COURSE_LEVEL, icte.course_count, icte.min_total_units, scd.SCHOOL_NAME ) SELECT cs.DEPARTMENT_NAME, cs.COURSE_LEVEL, cs.course_count, cs.min_total_units, cs.SCHOOL_NAME, cs.distinct_course_options, hae.highest_avg_enrollment_per_term FROM course_stats cs JOIN highest_avg_enrollment hae ON cs.DEPARTMENT_NAME = hae.DEPARTMENT_NAME ORDER BY cs.DEPARTMENT_NAME, cs.COURSE_LEVEL;\"}, {\"category\": \"Subject Offering Analysis\", \"default_granularity\": \"one row per department per academic year\", \"desc\": \"For each academic year, what is the description of the academic year, the department name, the average total units for all subjects offered by that department in terms that match that academic year and have a term status indicator of 'P', and the deviation of each department's average total units from the overall average total units for that academic year? Do not return any rounded answers.\", \"id\": \"dw_2597\", \"name\": \"Department Average Total Units Deviation from Yearly Overall Average in Previous Terms\", \"sql\": \"WITH inner_cte AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS dept_avg_total_units FROM ACADEMIC_TERMS_ALL JOIN ACADEMIC_TERMS ON ACADEMIC_TERMS_ALL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.TERM_STATUS_INDICATOR = 'P' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.ACADEMIC_YEAR_DESC, inner_cte.DEPARTMENT_NAME, inner_cte.dept_avg_total_units, (inner_cte.dept_avg_total_units - overall.avg_total_units) AS deviation_from_overall_avg FROM inner_cte JOIN ( SELECT ACADEMIC_YEAR, AVG(dept_avg_total_units) AS avg_total_units FROM ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS dept_avg_total_units FROM ACADEMIC_TERMS_ALL JOIN ACADEMIC_TERMS ON ACADEMIC_TERMS_ALL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.TERM_STATUS_INDICATOR = 'P' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME ) dept_avgs GROUP BY ACADEMIC_YEAR ) overall ON inner_cte.ACADEMIC_YEAR = overall.ACADEMIC_YEAR ORDER BY inner_cte.ACADEMIC_YEAR, deviation_from_overall_avg DESC;\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_f68a14a8ac0d4cb7ae4b5f43",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"columns\": {\"SIS_COURSE_DESCRIPTION_KEY\": {\"desc\": \"Surrogate key of the course description record\"}, \"COURSE\": {\"desc\": \"Course/subject code, e.g. '18'; joins to SIS_SUBJECT_CODE.SUBJECT_CODE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"COURSE_DESCRIPTION\": {\"desc\": \"Short course description text; its character length is used in description-length statistics\"}, \"COURSE_DESCRIPTION_LONG\": {\"desc\": \"Long-form course description text\"}, \"DEPARTMENT\": {\"desc\": \"Department code offering the course; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name offering the course\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME\": {\"desc\": \"School name offering the course, e.g. 'Engineering'\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"FROM_TERM\": {\"desc\": \"First term the course description is effective from\"}, \"FROM_TERM_DESCRIPTION\": {\"desc\": \"Description of the from-term\"}, \"THRU_TERM\": {\"desc\": \"Last term the course description is effective through\"}, \"THRU_TERM_DESCRIPTION\": {\"desc\": \"Description of the thru-term\"}, \"COURSE_OPTION\": {\"desc\": \"Course option designation\"}, \"COURSE_LEVEL\": {\"desc\": \"Course level code, e.g. 'U' = undergraduate, 'G' = graduate\"}, \"CIP_PROGRAM_CODE\": {\"desc\": \"Six-digit CIP (Classification of Instructional Programs) program code of the course; joins to CIP.PROGRAM_CODE (current classification, one row per code) and CIP_WITH_VERSION.PROGRAM_CODE (all revision versions)\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the course counts toward a degree\"}, \"DEFAULT_ULTIMATE_DEGREE\": {\"desc\": \"Default ultimate degree awarded for the course\"}, \"GRADAUTE_LEVEL\": {\"desc\": \"Legacy misspelled graduate level column (kept for compatibility)\"}, \"GRADUATE_LEVEL\": {\"desc\": \"Graduate level designation of the course\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per course description\"}, {\"id\": \"CIS_COURSE_CATALOG\", \"name\": \"CIS_COURSE_CATALOG\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\", \"columns\": {\"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether offered during IAP\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog record\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, SUBJECT_CODE.SUBJECT_NUMBER\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject code, e.g. '18'\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_SUBJECT_CODE.DEPARTMENT_CODE and SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which catalog attributes take effect\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject; joins to CIS_COURSE_CATALOG-based subject title matching\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description\"}, \"HGN_CODE\": {\"desc\": \"HGN level code\"}, \"HGN_DESC\": {\"desc\": \"HGN 