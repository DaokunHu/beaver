            "arguments": "{\"entity_ids\": \n[\"SIS_COURSE_DESCRIPTION\", \"CIS_COURSE_CATALOG\", \"COURSE_CATALOG_SUBJECT_OFFERED\", \"ACADEMIC_TERMS\", \"SIS_DEPARTMENT\"]\n\n}"
