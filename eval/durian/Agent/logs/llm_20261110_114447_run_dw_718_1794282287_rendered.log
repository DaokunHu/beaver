      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject offered summary record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject; joins to SIS_SUBJECT_CODE.COURSE_NUMBER and SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'; used for school-level filtering\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"columns\": {\"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject summary record\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, COURSE_CATALOG_SUBJECT_OFFERED subject IDs\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SUBJECT_OR_CLUSTER\": {\"desc\": \"Indicator whether the row represents a subject or a cluster\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"ULT_MASTER_SUBJECT_ID\": {\"desc\": \"Ultimate master subject identifier in cluster hierarchies\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics'\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name, e.g. 'Engineering'\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREP_UNITS\": {\"desc\": \"Preparation credit units (named PREP_UNITS here vs PREPARATION_UNITS in other tables)\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the subject\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the cluster\"}, \"SUBJECT_GROUP_ID\": {\"desc\": \"Subject group identifier used for grouping related subjects\"}, \"SUBJECT_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Subject enrollment in the first week\"}, \"CLUSTER_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Cluster enrollment in the first week\"}, \"SUBJECT_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Subject enrollment in the fifth week\"}, \"CLUSTER_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Cluster enrollment in the fifth week\"}, \"SUBJECT_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the subject for credit\"}, \"SUBJECT_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the subject\"}, \"CLUSTER_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the cluster for credit\"}, \"CLUSTER_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the cluster\"}, \"SUBJECT_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the cluster\"}, \"SUBJECT_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"LIBRARY_SUBJECT_OFFERED\", \"name\": \"LIBRARY_SUBJECT_OFFERED\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\", \"columns\": {\"LIBRARY_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the library subject offered record; joins to LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject as used by the library\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_RESERVE_MATRL_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject per library records\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in library reserve scope\"}, {\"id\": \"CIS_COURSE_CATALOG\", \"name\": \"CIS_COURSE_CATALOG\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\", \"columns\": {\"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether offered during IAP\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog record\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, SUBJECT_CODE.SUBJECT_NUMBER\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject code, e.g. '18'\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_SUBJECT_CODE.DEPARTMENT_CODE and SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which catalog attributes take effect\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject; joins to CIS_COURSE_CATALOG-based subject title matching\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description\"}, \"HGN_CODE\": {\"desc\": \"HGN level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text\"}, \"JOINT_SUBJECTS\": {\"desc\": \"Joint subjects list\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether offered this academic year\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"SECTION_ID\": {\"desc\": \"Section identifier\"}, \"TERM_CODE\": {\"desc\": \"Term code of the catalog record\"}}, \"default_granularity\": \"one row per subject per term in the CIS course catalog\"}, {\"id\": \"DRUPAL_COURSE_CATALOG\", \"name\": \"DRUPAL_COURSE_CATALOG\", \"desc\": \"Drupal-sourced course catalog table: an alternative catalog feed with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags, section flags, meeting time/place), plus subject-offering reference columns (SO_SUBJECT_ID, SO_TERM_CODE, SO_TERM_DESCRIPTION, SO_CLUSTER_TYPE) linking catalog records to registrar subject offerings.\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, SUBJECT_CODE.SUBJECT_NUMBER\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject code, e.g. '18'\"}, \"SUBJECT_NUMBER\": {\"desc\": \"\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"\"}, \"DEPARTMENT_CODE\": {\"desc\": \"\"}, \"DEPARTMENT_NAME\": {\"desc\": \"\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"\"}, \"SUBJECT_TITLE\": {\"desc\": \"\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"\"}, \"LECTURE_UNITS\": {\"desc\": \"\"}, \"LAB_UNITS\": {\"desc\": \"\"}, \"PREPARATION_UNITS\": {\"desc\": \"\"}, \"TOTAL_UNITS\": {\"desc\": \"\"}, \"DESIGN_UNITS\": {\"desc\": \"\"}, \"GRADE_TYPE\": {\"desc\": \"\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"\"}, \"GRADE_RULE\": {\"desc\": \"\"}, \"GRADE_RULE_DESC\": {\"desc\": \"\"}, \"HGN_CODE\": {\"desc\": \"\"}, \"HGN_DESC\": {\"desc\": \"\"}, \"HGN_EXCEPT\": {\"desc\": \"\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"PREREQUISITES\": {\"desc\": \"\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"\"}, \"JOINT_SUBJECTS\": {\"desc\": \"\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"\"}, \"IS_OFFERED_IAP\": {\"desc\": \"\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"\"}, \"STATUS_CHANGE\": {\"desc\": \"\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"\"}, \"TERM_DURATION\": {\"desc\": \"\"}, \"GLOBAL_REGIONS\": {\"desc\": \"\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"\"}, \"SO_SUBJECT_ID\": {\"desc\": \"Subject ID of the linked registrar subject offering record\"}, \"SO_TERM_CODE\": {\"desc\": \"Term code of the linked subject offering record\"}, \"SO_TERM_DESCRIPTION\": {\"desc\": \"Term description of the linked subject offering record\"}, \"SO_CLUSTER_TYPE\": {\"desc\": \"Cluster type of the linked subject offering record\"}, \"SECTION_ID\": {\"desc\": \"\"}, \"IS_MASTER_SECTION\": {\"desc\": \"\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"\"}, \"IS_LAB_SECTION\": {\"desc\": \"\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"\"}, \"MEET_TIME\": {\"desc\": \"\"}, \"MEET_PLACE\": {\"desc\": \"\"}, \"TERM_CODE\": {\"desc\": \"Term code of the catalog record (column missing from this feed's list but implied by structure)\"}}, \"default_granularity\": \"one row per subject per term in the Drupal catalog feed\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}, {\"id\": \"TIP_DETAIL\", \"name\": \"TIP_DETAIL\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Foreign key to TIP_SUBJECT_OFFERED.TIP_SUBJECT_OFFERED_KEY\"}, \"TIP_MATERIAL_KEY\": {\"desc\": \"Foreign key to TIP_MATERIAL.TIP_MATERIAL_KEY identifying the specific textbook material\"}, \"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB'/blank keys with no description. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_SUBJECT_OFFERED.SUBJECT_ID, LIBRARY_SUBJECT_OFFERED.SUBJECT_ID, SUBJECT_SUMMARY.SUBJECT_ID\"}, \"ISBN\": {\"desc\": \"ISBN of the textbook material associated with the subject offering\"}, \"RECORD_COUNT\": {\"desc\": \"Number of material records for this subject/material combination; used in material-count statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject-material-status combination per term\", \"entity\": {\"columns\": {\"TIP_MATERIAL_STATUS_KEY\": {\"desc\": \"Material status key; joins to TIP_MATERIAL_STATUS.TIP_MATERIAL_STATUS_KEY for decoding. Value domain includes 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, and 'NL'/'NS'/'NB' = None variants. Distinct from LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY, which belongs to the library reserve domain.\"}}}, \"reason\": \"Data verification of TIP_MATERIAL_STATUS shows 12 status values beyond the previously documented 'RQ'/'EO'; enriching the description supports material-status grouping questions such as case dw_2989 (per material status and publisher statistics).\"}, {\"id\": \"concept_subject_offering_facts\", \"name\": \"Subject Offering Fact Tables\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\", \"tables\": [\"COURSE_CATALOG_SUBJECT_OFFERED\", \"SUBJECT_OFFERED\", \"SUBJECT_OFFERED_SUMMARY\", \"SUBJECT_SUMMARY\", \"TIP_SUBJECT_OFFERED\", \"LIBRARY_SUBJECT_OFFERED\"], \"comparisons\": [{\"dimension\": \"Granularity\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Subject offering per term/academic year (catalog record, includes section flags)\", \"SUBJECT_OFFERED\": \"Subject section per term (finest grain, SECTION_ID)\", \"SUBJECT_OFFERED_SUMMARY\": \"Subject per term (rollup of sections)\", \"SUBJECT_SUMMARY\": \"Subject or cluster per term\", \"TIP_SUBJECT_OFFERED\": \"Subject per term within textbook program scope\", \"LIBRARY_SUBJECT_OFFERED\": \"Subject per term within library reserve scope\"}, {\"dimension\": \"Enrollment measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"None (catalog attributes only)\", \"SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, SECTION_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_OFFERED_SUMMARY\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_SUMMARY\": \"SUBJECT_ENROLLMENT_NUMBER plus first-week/fifth-week and credit/listener enrollment splits\", \"TIP_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\", \"LIBRARY_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\"}, {\"dimension\": \"Unit measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS, DESIGN_UNITS, TOTAL_UNITS, IS_VARIABLE_UNITS\", \"SUBJECT_OFFERED\": \"None\", \"SUBJECT_OFFERED_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS\", \"SUBJECT_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREP_UNITS, DESIGN_UNITS\", \"TIP_SUBJECT_OFFERED\": \"None\", \"LIBRARY_SUBJECT_OFFERED\": \"None\"}, {\"dimension\": \"Distinctive attributes\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"HGN_DESC level, GRADE_TYPE/GRADE_RULE, HASS/GIR attributes, IS_OFFERED_* flags, MEET_PLACE (room key), ACADEMIC_YEAR, EFFECTIVE_TERM_CODE\", \"SUBJECT_OFFERED\": \"IS_REPEATABLE_SUBJECT, CLUSTER_TYPE, section flags, FORM_TYPE, EVALUATE_THIS_SUBJECT\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_SCHOOL_NAME, COURSE_NUMBER, cluster info at subject level\", \"SUBJECT_SUMMARY\": \"SCHOOL_CODE/SCHOOL_NAME, SUBJECT_GROUP_ID, SUBJECT_OR_CLUSTER, detailed weekly enrollment\", \"TIP_SUBJECT_OFFERED\": \"IS_NO_COURSE_MATERIAL flag; parent of TIP_DETAIL materials\", \"LIBRARY_SUBJECT_OFFERED\": \"COURSE_NUMBER/COURSE_NUMBER_DESC; parent of LIBRARY_RESERVE_MATRL_DETAIL\"}, {\"dimension\": \"Department column naming\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_SUMMARY\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"TIP_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\"}], \"decision_guide\": {\"Questions about credit units, grading type/rules, HGN level (undergraduate/graduate), HASS/GIR attributes, or term offering flags (fall/spring/IAP/summer)\": \"Use COURSE_CATALOG_SUBJECT_OFFERED; it is the only offering table carrying full catalog attributes.\", \"Questions about actual section-level offerings, repeatability, cluster type, or section flags\": \"Use SUBJECT_OFFERED (section grain); roll up via SUBJECT_OFFERED_SUMMARY when subject-level totals are needed.\", \"Questions about final enrollment statistics, weekly enrollment snapshots, credit vs listener counts, subject groups, or school-level unit statistics\": \"Use SUBJECT_SUMMARY.\", \"Questions about textbooks/course materials per subject (required/optional status, ISBN, record counts)\": \"Start from TIP_SUBJECT_OFFERED (subject scope, IS_NO_COURSE_MATERIAL) joined to TIP_DETAIL (material rows).\", \"Questions about library reserve materials, reserve counts per subject, or library course numbers\": \"Start from LIBRARY_SUBJECT_OFFERED joined to LIBRARY_RESERVE_MATRL_DETAIL.\", \"Questions about subject-level units with offering department/school (e.g. Engineering school enrollment totals by department)\": \"Use SUBJECT_OFFERED_SUMMARY, which carries both TOTAL_UNITS and OFFER_SCHOOL_NAME.\"}}, {\"id\": \"concept_course_catalog_sources\", \"name\": \"Course Catalog Sources\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\", \"tables\": [\"COURSE_CATALOG_SUBJECT_OFFERED\", \"CIS_COURSE_CATALOG\", \"DRUPAL_COURSE_CATALOG\"], \"comparisons\": [{\"dimension\": \"Source system\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Warehouse course catalog fact table\", \"CIS_COURSE_CATALOG\": \"CIS (course information system) catalog feed\", \"DRUPAL_COURSE_CATALOG\": \"Drupal publishing-system catalog feed\"}, {\"dimension\": \"Distinctive columns\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"TERM_CODE plus EFFECTIVE_TERM_CODE, MEET_PLACE room key, RESPONSIBLE_FACULTY columns\", \"CIS_COURSE_CATALOG\": \"Same catalog attribute set keyed by ACADEMIC_YEAR/TERM_CODE; no MEET_PLACE/MEET_TIME\", \"DRUPAL_COURSE_CATALOG\": \"Adds SO_SUBJECT_ID, SO_TERM_CODE, SO_TERM_DESCRIPTION, SO_CLUSTER_TYPE linking to registrar subject offerings\"}, {\"dimension\": \"Typical join paths\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"TERM_CODE/EFFECTIVE_TERM_CODE to term tables; SUBJECT_CODE to SIS_SUBJECT_CODE/SIS_COURSE_DESCRIPTION; DEPARTMENT_CODE to SIS_DEPARTMENT; MEET_PLACE to FCLT_ROOMS\", \"CIS_COURSE_CATALOG\": \"DEPARTMENT_CODE to SIS_SUBJECT_CODE for subject-code/department resolution\", \"DRUPAL_COURSE_CATALOG\": \"SO_* columns to subject offering tables; catalog attributes used directly\"}, {\"dimension\": \"Usage in queries\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Default choice for unit statistics, HGN level, grade rules, offering flags\", \"CIS_COURSE_CATALOG\": \"Used when subject titles must be resolved through SIS_SUBJECT_CODE department groupings\", \"DRUPAL_COURSE_CATALOG\": \"Used when catalog data must be tied back to registrar offering records via SO_* keys\"}], \"decision_guide\": {\"Questions about units, grade type/rule, HGN level, HASS/GIR attributes, or IS_OFFERED_* flags of subjects\": \"Use COURSE_CATALOG_SUBJECT_OFFERED as the default catalog source; it also carries MEET_PLACE for location analysis.\", \"Questions that resolve subjects through SIS subject codes by department (e.g. counting subjects per department from the CIS feed)\": \"Use CIS_COURSE_CATALOG joined to SIS_SUBJECT_CODE on DEPARTMENT_CODE.\", \"Questions that need catalog attributes tied to registrar subject offering records (cluster type, offering term description)\": \"Use DRUPAL_COURSE_CATALOG via its SO_SUBJECT_ID / SO_TERM_CODE columns.\"}}, {\"id\": \"concept_course_material_programs\", \"name\": \"Course Material and Library Reserve Domain\", \"desc\": \"Tables covering course material provisioning: the Textbook Information Program (TIP) tracking textbook adoption status per subject offering, and library reserve processing tracking catalog items placed on reserve for subjects. They jointly answer questions about which subjects have course materials/textbooks, material status (TIP statuses such as 'RQ' Required, 'EO' Electronic options; library statuses such as 'U' Unknown, 'Y' Required Course Material), ISBNs, record counts, and reserve catalog item attributes. The two programs are linked by SUBJECT_ID + TERM_CODE.\", \"tables\": [\"TIP_SUBJECT_OFFERED\", \"TIP_DETAIL\", \"TIP_MATERIAL\", \"TIP_MATERIAL_STATUS\", \"LIBRARY_SUBJECT_OFFERED\", \"LIBRARY_RESERVE_MATRL_DETAIL\", \"LIBRARY_RESERVE_CATALOG\", \"LIBRARY_MATERIAL_STATUS\", \"LIBRARY_COURSE_INSTRUCTOR\"], \"comparisons\": [{\"dimension\": \"Business process\", \"TIP_SUBJECT_OFFERED / TIP_DETAIL / TIP_MATERIAL / TIP_MATERIAL_STATUS\": \"Textbook program: subjects tracked for textbook adoption, material rows with status and ISBN, material bibliographic details, status decoding\", \"LIBRARY_SUBJECT_OFFERED / LIBRARY_RESERVE_MATRL_DETAIL / LIBRARY_RESERVE_CATALOG / LIBRARY_MATERIAL_STATUS / LIBRARY_COURSE_INSTRUCTOR\": \"Library reserve: subjects in reserve processing, reserve material detail rows, catalog item bibliographic records, status decoding, instructor assignments\"}, {\"dimension\": \"Status semantics\", \"TIP_MATERIAL_STATUS_KEY\": \"12 statuses decoded by TIP_MATERIAL_STATUS: 'RQ' = Required, 'EO' = Electronic options, 'RC' = Recommended, 'PC' = Val-u option, 'BR' = Bookstore recommends, 'CL' = Go to class first, 'NM' = Course has no materials, 'U' = Unknown, plus NULL-description keys 'NL'/'NS'/'NB'/blank\", \"LIBRARY_MATERIAL_STATUS_KEY\": \"6 statuses decoded by LIBRARY_MATERIAL_STATUS: 'U' = Unknown, 'R' = NULL description, 'N' = Non-Required Course Material, 'O' = Reserve only, 'X' = No Required Textbook, 'Y' = Required Course Material\"}, {\"dimension\": \"Count measures\", \"TIP_DETAIL\": \"COUNT(TIP_MATERIAL_KEY) or RECORD_COUNT for material-count statistics per status/subject\", \"LIBRARY_RESERVE_MATRL_DETAIL\": \"COUNT(LIBRARY_RESERVE_CATALOG_KEY) for reserve catalog item counts per status/subject; LIBRARY_RESERVE_CATALOG.RECORD_COUNTER is a catalog record counter\"}, {\"dimension\": \"Parent-child structure\", \"TIP_SUBJECT_OFFERED → TIP_DETAIL\": \"TIP_SUBJECT_OFFERED_KEY / SUBJECT_ID links subject rows to material rows\", \"LIBRARY_SUBJECT_OFFERED → LIBRARY_RESERVE_MATRL_DETAIL → LIBRARY_RESERVE_CATALOG\": \"LIBRARY_SUBJECT_OFFERED_KEY and LIBRARY_RESERVE_CATALOG_KEY chain subjects to reserve items\"}], \"decision_guide\": {\"Questions about required/optional textbooks, ISBNs, or whether subjects have course materials\": \"Use TIP_SUBJECT_OFFERED (IS_NO_COURSE_MATERIAL flag) with TIP_DETAIL (TIP_MATERIAL_STATUS_KEY 'RQ'/'EO').\", \"Questions about library reserve items, reserve counts per subject, or catalog titles/authors\": \"Use LIBRARY_RESERVE_MATRL_DETAIL joined to LIBRARY_RESERVE_CATALOG, scoped by LIBRARY_SUBJECT_OFFERED.\", \"Questions about enrollment of subjects within the textbook program or library reserve scope\": \"Use TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS or LIBRARY_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS respectively; these are program-specific snapshots, not the official SUBJECT_SUMMARY enrollment.\", \"Questions about textbook prices, editions, or publishers\": \"Use TIP_MATERIAL via TIP_DETAIL.TIP_MATERIAL_KEY.\", \"Questions about instructors of courses with reserve materials\": \"Use LIBRARY_COURSE_INSTRUCTOR via LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_COURSE_INSTRUCTOR_KEY.\", \"Questions about required textbooks, ISBNs, or whether subjects have course materials\": \"Use TIP_SUBJECT_OFFERED (IS_NO_COURSE_MATERIAL flag) with TIP_DETAIL (TIP_MATERIAL_STATUS_KEY, e.g. 'RQ' Required).\", \"Questions combining textbook material statuses with library reserve statuses\": \"Join TIP_DETAIL and LIBRARY_RESERVE_MATRL_DETAIL on SUBJECT_ID + TERM_CODE, decode each status via its own lookup table, and aggregate each side separately; never equate the two status key columns.\"}}, {\"id\": \"concept_department_dimension\", \"name\": \"Department and School Dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\", \"tables\": [\"SIS_DEPARTMENT\", \"STUDENT_DEPARTMENT\", \"SIS_ADMIN_DEPARTMENT\"], \"comparisons\": [{\"dimension\": \"Attribute coverage\", \"SIS_DEPARTMENT\": \"Richest: DEPARTMENT_FULL_NAME, SCHOOL_CODE/SCHOOL_NAME, DEPT_BUDGET_CODE, IS_DEGREE_GRANTING, commencement-book names, DLC key\", \"STUDENT_DEPARTMENT\": \"Minimal: code, name, full name, school code/name only\", \"SIS_ADMIN_DEPARTMENT\": \"Administrative contact: department phone area code/number, clearing cost collector\"}, {\"dimension\": \"Degree-granting and school filtering\", \"SIS_DEPARTMENT\": \"Supports IS_DEGREE_GRANTING and SCHOOL_NAME filters directly\", \"STUDENT_DEPARTMENT\": \"Only school code/name attribution, no degree-granting flag\", \"SIS_ADMIN_DEPARTMENT\": \"No school or degree-granting attributes\"}, {\"dimension\": \"Typical join path\", \"SIS_DEPARTMENT\": \"DEPARTMENT_CODE = offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE; also joins SIS_COURSE_DESCRIPTION.DEPARTMENT and SIS_ADMIN_DEPARTMENT.SIS_ADMIN_DEPARTMENT_CODE\", \"STUDENT_DEPARTMENT\": \"DEPARTMENT_CODE = TIP_SUBJECT_OFFERED.OFFER_DEPT_CODE and other offering department codes\", \"SIS_ADMIN_DEPARTMENT\": \"SIS_ADMIN_DEPARTMENT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE\"}, {\"dimension\": \"Budget/finance attributes\", \"SIS_DEPARTMENT\": \"DEPT_BUDGET_CODE available for budget-based ranking\", \"STUDENT_DEPARTMENT\": \"None\", \"SIS_ADMIN_DEPARTMENT\": \"CLEARING_COST_COLLECTOR\"}], \"decision_guide\": {\"Questions filtering departments by school (e.g. 'School of Engineering') or degree-granting status\": \"Use SIS_DEPARTMENT; it carries SCHOOL_NAME and IS_DEGREE_GRANTING.\", \"Questions needing only department full name and school name for offering departments (e.g. TIP subject offerings)\": \"STUDENT_DEPARTMENT suffices and is the lighter lookup; SIS_DEPARTMENT also works.\", \"Questions needing department phone numbers or administrative contact details\": \"Join SIS_ADMIN_DEPARTMENT via SIS_DEPARTMENT.DEPARTMENT_CODE = SIS_ADMIN_DEPARTMENT_CODE.\", \"Questions ranking or grouping departments by budget code\": \"Use SIS_DEPARTMENT.DEPT_BUDGET_CODE.\"}}, {\"id\": \"column_concept_term_code\", \"name\": \"Term Code\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\", \"columns\": [\"ACADEMIC_TERMS.TERM_CODE\", \"ACADEMIC_TERMS_ALL.TERM_CODE\", \"ACADEMIC_TERM_PARAMETER.TERM_CODE\", \"COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE\", \"COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE\", \"SUBJECT_OFFERED.TERM_CODE\", \"SUBJECT_OFFERED_SUMMARY.TERM_CODE\", \"SUBJECT_SUMMARY.TERM_CODE\", \"TIP_DETAIL.TERM_CODE\", \"TIP_SUBJECT_OFFERED.TERM_CODE\", \"LIBRARY_SUBJECT_OFFERED.TERM_CODE\", \"LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE\", \"IAP_SUBJECT_DETAIL.TERM_CODE\", \"TIME_DAY.ACADEMIC_TERM_CODE\"], \"comparisons\": [{\"dimension\": \"Semantics\", \"TERM_CODE (fact tables)\": \"The term in which the offering/material/activity record exists\", \"EFFECTIVE_TERM_CODE (COURSE_CATALOG_SUBJECT_OFFERED)\": \"The term from which the catalog attributes take effect; may differ from the record's TERM_CODE\", \"TIME_DAY.ACADEMIC_TERM_CODE\": \"The academic term a calendar day belongs to\"}, {\"dimension\": \"Join behavior\", \"TERM_CODE\": \"Direct equality join between fact tables and ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\", \"EFFECTIVE_TERM_CODE\": \"Joined to ACADEMIC_TERMS.TERM_CODE when catalog attributes must be evaluated as of the term they became effective\", \"ACADEMIC_TERM_CODE\": \"Joined to term tables' TERM_CODE or to fact tables' TERM_CODE for calendar attributes\"}], \"decision_guide\": {\"Filtering subject offerings by the term they are offered in\": \"Use the fact table's TERM_CODE.\", \"Filtering catalog attributes by when they took effect (e.g. regular-term status of the effective term)\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE joined to ACADEMIC_TERMS.TERM_CODE.\", \"Attaching calendar day attributes (day of week, fiscal year) to terms or IAP activities\": \"Use TIME_DAY.ACADEMIC_TERM_CODE or TIME_DAY.CALENDAR_DATE = TERM_START_DATE.\", \"Resolving 'current/previous/upcoming term' references\": \"Use ACADEMIC_TERM_PARAMETER.TERM_CODE with TERM_INDICATOR.\"}}, {\"id\": \"column_concept_department_name\", \"name\": \"Department Name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME\", \"SUBJECT_SUMMARY.DEPARTMENT_NAME\", \"SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY.OFFER_DEPT_NAME\", \"TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SIS_DEPARTMENT.DEPARTMENT_NAME\", \"STUDENT_DEPARTMENT.DEPARTMENT_NAME\", \"SIS_COURSE_DESCRIPTION.DEPARTMENT_NAME\", \"SIS_SUBJECT_CODE.DEPARTMENT_NAME\", \"EMPLOYEE_DIRECTORY.DEPARTMENT_NAME\", \"LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT\", \"MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME\", \"SE_PERSON.ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DEPARTMENT_NAME is used by catalog/summary tables (COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY), department/course lookup tables, and the student directory (MIT_STUDENT_DIRECTORY); OFFER_DEPT_NAME is used by offering/program tables (SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY, TIP_SUBJECT_OFFERED, LIBRARY_SUBJECT_OFFERED) and denotes the department that actually offers the subject; LIBRARY_COURSE_INSTRUCTOR uses the plain column name DEPARTMENT for the course's academic department; SE_PERSON uses ORGANIZATION for the person's organizational unit\"}, {\"dimension\": \"Value format\", \"detail\": \"Catalog, summary, offering, student-directory, and lookup tables store plain department names (e.g. 'Mathematics', 'Chemistry', 'Electrical Eng & Computer Sci'); LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT stores a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics', '06 - Electrical Eng & Computer Sci'), with some unprefixed values (e.g. 'Architecture'), so it is not directly comparable to plain-name columns without stripping the prefix\"}, {\"dimension\": \"Academic vs HR/organization value domain\", \"detail\": \"Catalog, summary, offering, library, student-directory, and lookup tables share the academic department domain; EMPLOYEE_DIRECTORY.DEPARTMENT_NAME is the HR organizational unit name and has a different domain (e.g. 'Lincoln Laboratory', 'Department of Physics'), where some values coincide with academic names but many do not, and some carry a 'Department of ...' prefix; SE_PERSON.ORGANIZATION holds organizational unit names that may use different naming variants than the academic domain for the same unit (e.g. 'Electrical Engineering-Computer Science' vs the academic 'Electrical Eng & Computer Sci'), so equality filters across the two conventions must use each table's own variant\"}, {\"dimension\": \"Companion code column\", \"detail\": \"Catalog/summary tables carry DEPARTMENT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE; offering/program tables carry OFFER_DEPT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE or STUDENT_DEPARTMENT.DEPARTMENT_CODE; MIT_STUDENT_DIRECTORY carries DEPARTMENT (the academic department code) joining SIS_DEPARTMENT.DEPARTMENT_CODE, which is the reliable join key instead of the name; LIBRARY_COURSE_INSTRUCTOR has no department code column, only the prefixed name text; EMPLOYEE_DIRECTORY carries DEPARTMENT_NUMBER (HR department number) and SE_PERSON carries no department code, neither joining to SIS_DEPARTMENT.DEPARTMENT_CODE\"}], \"decision_guide\": {\"Filtering subjects by department in catalog or summary analysis\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME or SUBJECT_SUMMARY.DEPARTMENT_NAME.\", \"Filtering by department in section-level, textbook-program, or library analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Joining fact tables to department dimension attributes (school, full name, degree-granting)\": \"Prefer code joins: DEPARTMENT_CODE / OFFER_DEPT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE; name equality joins are used when codes are unavailable.\", \"Matching departments across a DEPARTMENT_NAME table and an OFFER_DEPT_NAME table\": \"The values are directly comparable (same academic name domain), e.g. joining SUBJECT_SUMMARY.DEPARTMENT_NAME to TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME.\", \"Filtering employees by their HR organizational unit (e.g. names containing 'Department', or HR units like 'Political Science')\": \"Use EMPLOYEE_DIRECTORY.DEPARTMENT_NAME; do not join it to SIS_DEPARTMENT.DEPARTMENT_CODE, and pair it with DEPARTMENT_NUMBER for HR grouping.\", \"Filtering by department in section-level, textbook-program, or library subject analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Filtering library reserve course instructors by academic department or library unit\": \"Use LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT with the prefixed value format (e.g. '18 - Mathematics'); do not compare it directly to plain department-name columns.\", \"Filtering students by their academic department\": \"Use MIT_STUDENT_DIRECTORY.DEPARTMENT (code) joined to SIS_DEPARTMENT.DEPARTMENT_CODE for reliable matching, or MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME for direct name filters; the name shares the academic domain with SIS_DEPARTMENT.DEPARTMENT_NAME.\", \"Filtering a person master (SE_PERSON) record by organizational unit such as an academic department\": \"Use SE_PERSON.ORGANIZATION with its own naming variant (e.g. 'Electrical Engineering-Computer Science'); do not equate it directly to MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME or SIS_DEPARTMENT.DEPARTMENT_NAME, which use the academic variant (e.g. 'Electrical Eng & Computer Sci').\"}}, {\"id\": \"column_concept_subject_id\", \"name\": \"Subject Identifier\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_ID\", \"SUBJECT_OFFERED.SUBJECT_ID\", \"SUBJECT_OFFERED_SUMMARY.SUBJECT_ID\", \"SUBJECT_SUMMARY.SUBJECT_ID\", \"TIP_DETAIL.SUBJECT_ID\", \"TIP_SUBJECT_OFFERED.SUBJECT_ID\", \"LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\", \"LIBRARY_RESERVE_MATRL_DETAIL.SUBJECT_ID\"], \"comparisons\": [{\"dimension\": \"Format\", \"detail\": \"SUBJECT_CODE + '.' + SUBJECT_NUMBER in all tables, e.g. '18.01'; can be reconstructed via CONCAT(SUBJECT_CODE, '.', SUBJECT_NUMBER)\"}, {\"dimension\": \"Grain difference\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED: catalog offering scope, one SUBJECT_ID may repeat across terms/academic years; SUBJECT_OFFERED: section scope, same SUBJECT_ID appears once per section; SUBJECT_SUMMARY / SUBJECT_OFFERED_SUMMARY: subject scope per term, one row per SUBJECT_ID per term; TIP and LIBRARY tables: program scope, SUBJECT_ID present only if the subject is tracked by that program\"}], \"decision_guide\": {\"Joining textbook materials or library reserves to catalog/summary subject attributes\": \"Match on SUBJECT_ID (plus TERM_CODE when term scope matters).\", \"Joining catalog offerings that only expose SUBJECT_CODE/SUBJECT_NUMBER to SUBJECT_ID-based tables\": \"Reconstruct SUBJECT_ID as CONCAT(SUBJECT_CODE, '.', SUBJECT_NUMBER).\", \"Counting distinct subjects per term/department\": \"Use COUNT(DISTINCT SUBJECT_ID) on a subject-grain table (SUBJECT_SUMMARY or SUBJECT_OFFERED_SUMMARY) to avoid section/program duplication.\"}}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_4ac33ad5d70148a997af2e83",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_41\", \"name\": \"Yearly Average and Variance of Math Full-Term Subject Total Units in Previous Terms\", \"desc\": \"For each academic year, provide the academic year description and calculate the average and variance of the total units for subjects offered in terms that are not the current term, have a term status indicator of 'P', are offered by the Mathematics department, and are full term subjects. Do not return any rounded answers.\", \"category\": \"Subject Offering Analysis\", \"sql\": \"WITH inner_cte AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, AVG(ccso.TOTAL_UNITS) AS avg_total_units, VARIANCE(ccso.TOTAL_UNITS) AS total_units_variance FROM ACADEMIC_TERMS_ALL ata JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE ata.IS_CURRENT_TERM = 'N' AND ata.TERM_STATUS_INDICATOR = 'P' AND ccso.DEPARTMENT_NAME = 'Mathematics' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC ) SELECT ic.ACADEMIC_YEAR, ic.ACADEMIC_YEAR_DESC, ic.avg_total_units, ic.total_units_variance FROM inner_cte ic JOIN ACADEMIC_TERMS_ALL ata ON ic.ACADEMIC_YEAR = ata.ACADEMIC_YEAR JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE ccso.TERM_DURATION = 'Full Term Subject' GROUP BY ic.ACADEMIC_YEAR, ic.ACADEMIC_YEAR_DESC, ic.avg_total_units, ic.total_units_variance ORDER BY ic.total_units_variance DESC;\", \"default_granularity\": \"one row per academic year\"}, {\"category\": \"Academic Term and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per previous-status term\", \"desc\": \"For each academic term where the term status indicator is 'P', show the term code, the term parameter, the term description, the academic year, the term start date, and the average academic year in a window of 2 preceding and 2 following rows grouped by the term indicator and ordered by the term start date. Additionally, for the academic year of each such term, give the academic year description, the average total units, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in regular terms, with the results ordered by term code and by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\", \"id\": \"dw_3417\", \"name\": \"Previous Terms Windowed Academic Year Average with Regular-Term Unit Stddev by Year\", \"sql\": \"WITH AcademicYearStats AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, AVG(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS avg_total_units, STDDEV(COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS) AS stddev_total_units FROM ACADEMIC_TERMS JOIN COURSE_CATALOG_SUBJECT_OFFERED ON ACADEMIC_TERMS.TERM_CODE = COURSE_CATALOG_SUBJECT_OFFERED.EFFECTIVE_TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC ORDER BY stddev_total_units DESC ), PreviousTerms AS ( SELECT t0.TERM_CODE, t1.TERM_PARAMETER, t2.TERM_DESCRIPTION, t0.ACADEMIC_YEAR, t1.TERM_START_DATE, AVG(t0.ACADEMIC_YEAR) OVER ( PARTITION BY t1.TERM_INDICATOR ORDER BY t0.TERM_START_DATE ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN ACADEMIC_TERM_PARAMETER t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERMS t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_INDICATOR = 'P' ) SELECT pts.TERM_CODE, pts.TERM_PARAMETER, pts.TERM_DESCRIPTION, pts.ACADEMIC_YEAR, pts.TERM_START_DATE, pts.window_column, ays.ACADEMIC_YEAR_DESC, ays.avg_total_units, ays.stddev_total_units FROM PreviousTerms pts JOIN AcademicYearStats ays ON pts.ACADEMIC_YEAR = ays.ACADEMIC_YEAR ORDER BY pts.TERM_CODE, ays.stddev_total_units DESC;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department from either the Math 2008 stats branch or the high-average-units branch\", \"desc\": \"List, for each department, either (a) the department's full name, the range and variance of the total units for degree-granting Mathematics department courses offered in the 2008 academic year along with the long course description for each course (with the reason 'Math 2008 Stats'), or (b) the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units) where the average total units is greater than the overall average across all departments (with the reason 'High Avg Units'). Show the columns in the following order: department name, total units range, total units variance, average total units, standard deviation (using STDDEV only and never STDDEV_POP) of total units, long course description, and reason for inclusion. Do not return any rounded answers.\", \"id\": \"dw_1335\", \"name\": \"Union of Math 2008 Unit Range-Variance with Long Descriptions and High Average Unit Department Stddev\", \"sql\": \"WITH Subquery1 AS ( WITH inner_cte AS ( SELECT sd.DEPARTMENT_FULL_NAME, MAX(ccc.TOTAL_UNITS) - MIN(ccc.TOTAL_UNITS) AS total_units_range, VARIANCE(ccc.TOTAL_UNITS) AS total_units_variance FROM CIS_COURSE_CATALOG ccc JOIN SIS_DEPARTMENT sd ON ccc.DEPARTMENT_CODE = sd.DEPARTMENT_CODE WHERE ccc.ACADEMIC_YEAR = '2008' AND sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' AND ccc.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_FULL_NAME ) SELECT i.DEPARTMENT_FULL_NAME, i.total_units_range, i.total_units_variance, scd.COURSE_DESCRIPTION_LONG FROM inner_cte i JOIN SIS_COURSE_DESCRIPTION scd ON scd.DEPARTMENT = 18 AND scd.DEPARTMENT_NAME = 'Mathematics' ), Subquery2 AS ( WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, AVG(sos.TOTAL_UNITS) AS avg_total_units, STDDEV(sos.TOTAL_UNITS) AS stddev_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SUBJECT_OFFERED_SUMMARY sos ON scd.COURSE = sos.COURSE_NUMBER WHERE sos.TOTAL_UNITS > 0 GROUP BY scd.DEPARTMENT_NAME ) SELECT DEPARTMENT_NAME, avg_total_units, stddev_total_units FROM inner_cte WHERE avg_total_units > ( SELECT AVG(TOTAL_UNITS) FROM SUBJECT_OFFERED_SUMMARY WHERE TOTAL_UNITS > 0 ) ORDER BY stddev_total_units DESC ), CombinedResults AS ( SELECT s1.DEPARTMENT_FULL_NAME AS DEPARTMENT_NAME, s1.total_units_range, s1.total_units_variance, NULL AS avg_total_units, NULL AS stddev_total_units, s1.COURSE_DESCRIPTION_LONG, 'Math 2008 Stats' AS Reason FROM Subquery1 s1 UNION ALL SELECT s2.DEPARTMENT_NAME, NULL AS total_units_range, NULL AS total_units_variance, s2.avg_total_units, s2.stddev_total_units, NULL AS COURSE_DESCRIPTION_LONG, 'High Avg Units' AS Reason FROM Subquery2 s2 ) SELECT * FROM CombinedResults ORDER BY DEPARTMENT_NAME;\"}, {\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per department per academic year\", \"desc\": \"For each academic year, among subjects that are not repeatable, what is the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by each department? List the academic year, department name, average enrollment, variance, and standard deviation (using STDDEV only and never STDDEV_POP), ordered by variance descending. Do not return any rounded answers.\", \"id\": \"dw_2958\", \"name\": \"Non-Repeatable Subject Enrollment Average Variance Stddev by Department and Year\", \"sql\": \"WITH inner_cte AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, SUBJECT_OFFERED.OFFER_DEPT_NAME, SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS FROM SUBJECT_OFFERED JOIN ACADEMIC_TERMS ON SUBJECT_OFFERED.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE SUBJECT_OFFERED.IS_REPEATABLE_SUBJECT = 'N' ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.OFFER_DEPT_NAME, AVG(inner_cte.NUM_ENROLLED_STUDENTS) AS avg_enrollment, VARIANCE(inner_cte.NUM_ENROLLED_STUDENTS) AS enrollment_variance, STDDEV(inner_cte.NUM_ENROLLED_STUDENTS) AS enrollment_stddev FROM inner_cte GROUP BY inner_cte.ACADEMIC_YEAR, inner_cte.OFFER_DEPT_NAME ORDER BY enrollment_variance DESC;\"}, {\"id\": \"dw_1288\", \"name\": \"Math IAP Max Enrollment Variance Rollup with Library and TIP Department Enrollment Totals\", \"desc\": \"For each academic year, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered in that year by the Mathematics department, considering only activities that require advance sign-up and are not cancelled, and also provide the academic year description? For each department, include a grand total for all activities in the format of (department name, null, total variance and stddev). Additionally, for each such department, provide the department code, the department name, and the total number of enrolled students in both the library and tip subject offerings, but only for those departments where the total number of enrolled students is more than one standard deviation (using STDDEV only and never STDDEV_POP) above the mean total enrolled students across all departments, and restrict your answer to departments whose name is 'Mathematics' (Course 18). Also, for each such department, list the names of the responsible faculty members from both the library and tip subject offerings. The columns to display, in order, are: department name, academic year description, total variance, total standard deviation (using STDDEV only and never STDDEV_POP), department code, department name, total enrolled, library faculty, and tip faculty. Do not return any rounded answers.\", \"category\": \"Library Reserve and IAP Activity Comprehensive Analysis\", \"sql\": \"WITH inner_cte1 AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, VARIANCE(isd.MAX_ENROLLMENT) AS max_enrollment_variance, STDDEV(isd.MAX_ENROLLMENT) AS max_enrollment_stddev, ccso.DEPARTMENT_NAME FROM IAP_SUBJECT_DETAIL isd JOIN ACADEMIC_TERMS_ALL ata ON isd.TERM_CODE = ata.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ata.TERM_CODE = ccso.TERM_CODE WHERE isd.ENROLLMENT_TYPE = 'Advance sign-up required' AND isd.IS_CANCELLED = 'N' AND isd.MAX_ENROLLMENT IS NOT NULL AND ccso.DEPARTMENT_NAME = 'Mathematics' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, ccso.DEPARTMENT_NAME ), RollupResults AS ( SELECT DEPARTMENT_NAME, ACADEMIC_YEAR_DESC, SUM(max_enrollment_variance) AS total_variance, SUM(max_enrollment_stddev) AS total_stddev FROM inner_cte1 GROUP BY DEPARTMENT_NAME, ACADEMIC_YEAR_DESC WITH ROLLUP HAVING SUM(max_enrollment_variance) IS NOT NULL ), inner_cte2 AS ( SELECT l.OFFER_DEPT_CODE, l.OFFER_DEPT_NAME, SUM(l.NUM_ENROLLED_STUDENTS + t.NUM_ENROLLED_STUDENTS) AS total_enrolled FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_SUBJECT_OFFERED t ON l.MASTER_SUBJECT_ID_SORT = t.MASTER_SUBJECT_ID_SORT WHERE l.OFFER_DEPT_NAME = 'Mathematics' GROUP BY l.OFFER_DEPT_CODE, l.OFFER_DEPT_NAME HAVING SUM(l.NUM_ENROLLED_STUDENTS + t.NUM_ENROLLED_STUDENTS) > ( SELECT AVG(total_sum) + STDDEV(total_sum) FROM ( SELECT SUM(l2.NUM_ENROLLED_STUDENTS + t2.NUM_ENROLLED_STUDENTS) AS total_sum FROM LIBRARY_SUBJECT_OFFERED l2 JOIN TIP_SUBJECT_OFFERED t2 ON l2.MASTER_SUBJECT_ID_SORT = t2.MASTER_SUBJECT_ID_SORT GROUP BY l2.OFFER_DEPT_CODE ) dept_totals ) AND l.OFFER_DEPT_CODE = '18' ) SELECT rr.DEPARTMENT_NAME, rr.ACADEMIC_YEAR_DESC, rr.total_variance, rr.total_stddev, c.OFFER_DEPT_CODE, c.OFFER_DEPT_NAME, c.total_enrolled, l.RESPONSIBLE_FACULTY_NAME AS library_faculty, t.RESPONSIBLE_FACULTY_NAME AS tip_faculty FROM RollupResults rr JOIN inner_cte2 c ON rr.DEPARTMENT_NAME = c.OFFER_DEPT_NAME JOIN LIBRARY_SUBJECT_OFFERED l ON c.OFFER_DEPT_CODE = l.OFFER_DEPT_CODE AND l.OFFER_DEPT_NAME = c.OFFER_DEPT_NAME JOIN TIP_SUBJECT_OFFERED t ON l.MASTER_SUBJECT_ID_SORT = t.MASTER_SUBJECT_ID_SORT WHERE l.OFFER_DEPT_NAME = 'Mathematics' ORDER BY rr.DEPARTMENT_NAME, rr.ACADEMIC_YEAR_DESC, c.OFFER_DEPT_CODE, c.OFFER_DEPT_NAME, c.total_enrolled, l.RESPONSIBLE_FACULTY_NAME, t.RESPONSIBLE_FACULTY_NAME;\", \"default_granularity\": \"one row per department per academic year description plus rollup totals\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per department/school enrollment statistic (plus per-school rollup rows), left joined with Mathematics students named Peter\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\", \"id\": \"dw_1350\", \"name\": \"Degree-Granting Department TIP Enrollment Statistics with School Rollups and Math Peter Student Budget Code Windows\", \"sql\": \"WITH inner_cte1 AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, tso.NUM_ENROLLED_STUDENTS FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 ), DepartmentStats AS ( SELECT DEPARTMENT_NAME, SCHOOL_NAME, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled_students, MAX(NUM_ENROLLED_STUDENTS) - MIN(NUM_ENROLLED_STUDENTS) AS range_enrolled_students, VARIANCE(NUM_ENROLLED_STUDENTS) AS var_enrolled_students, SUM(NUM_ENROLLED_STUDENTS) AS total_enrolled_students FROM inner_cte1 GROUP BY DEPARTMENT_NAME, SCHOOL_NAME ), SchoolRollup AS ( SELECT NULL AS DEPARTMENT_NAME, SCHOOL_NAME, NULL AS avg_enrolled_students, NULL AS range_enrolled_students, NULL AS var_enrolled_students, SUM(total_enrolled_students) AS total_enrolled_students FROM DepartmentStats GROUP BY SCHOOL_NAME ), inner_cte2 AS ( SELECT t1.LAST_NAME, t1.EMAIL_ADDRESS, t1.STUDENT_YEAR, t1.DEPARTMENT_NAME, t0.SCHOOL_NAME, MIN(t0.DEPT_BUDGET_CODE) OVER (ORDER BY t1.FULL_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_DEPARTMENT t0 JOIN MIT_STUDENT_DIRECTORY t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT WHERE t1.FIRST_NAME = 'Peter' AND t0.DEPARTMENT_NAME = 'Mathematics' ) SELECT ds.DEPARTMENT_NAME, ds.SCHOOL_NAME, ds.avg_enrolled_students, ds.range_enrolled_students, ds.var_enrolled_students, ds.total_enrolled_students, ic2.LAST_NAME, ic2.EMAIL_ADDRESS, ic2.STUDENT_YEAR, ic2.window_column, sd.DEPARTMENT_FULL_NAME, sd.DEPARTMENT_LAST_ACTIVITY_DATE FROM (SELECT * FROM DepartmentStats UNION ALL SELECT * FROM SchoolRollup) ds LEFT JOIN inner_cte2 ic2 ON ds.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME AND ds.SCHOOL_NAME = ic2.SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON ds.DEPARTMENT_NAME = sd.DEPARTMENT_NAME ORDER BY ds.SCHOOL_NAME, ds.DEPARTMENT_NAME, ic2.LAST_NAME ;\"}, {\"id\": \"dw_1165\", \"name\": \"Library-TIP Matched Subjects by Faculty or Enrollment with Degree-Granting Graduate Department Enrollment Dispersion\", \"desc\": \"For each subject where the responsible faculty MIT ID in the library subject offered table is 928034000 or the number of enrolled students in the tip subject offered table is greater than 5, and where the offer department name in the tip subject offered table is either 'Chemistry' or 'Biology', show the subject title from the library subject offered table, the offer department name from the tip subject offered table, the term code from both tables, the number of enrolled students from both tables, and the minimum number of enrolled students in the tip subject offered table over each master subject ID group. Additionally, for the department offering the subject, show the department name, the range of enrolled students, and the variance of enrolled students in the subjects offered by that department, considering only departments that grant degrees, courses that are at the graduate level, and excluding the Biology department. Present the results ordered by subject title and department name. Do not return any rounded answers.\", \"sql\": \"WITH Subquery1 AS ( SELECT lso.SUBJECT_TITLE, tso.OFFER_DEPT_NAME, lso.TERM_CODE AS LIBRARY_TERM_CODE, tso.TERM_CODE AS TIP_TERM_CODE, lso.NUM_ENROLLED_STUDENTS AS LIBRARY_NUM_ENROLLED, tso.NUM_ENROLLED_STUDENTS AS TIP_NUM_ENROLLED, MIN(tso.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY tso.MASTER_SUBJECT_ID) AS MIN_TIP_NUM_ENROLLED, tso.OFFER_DEPT_CODE FROM LIBRARY_SUBJECT_OFFERED lso JOIN TIP_SUBJECT_OFFERED tso ON lso.MASTER_SUBJECT_ID = tso.MASTER_SUBJECT_ID WHERE ( lso.RESPONSIBLE_FACULTY_MIT_ID = 928034000 OR tso.NUM_ENROLLED_STUDENTS > 5 ) AND tso.OFFER_DEPT_NAME IN ('Chemistry', 'Biology') ), Subquery2 AS ( SELECT sd.DEPARTMENT_NAME, MAX(tso.NUM_ENROLLED_STUDENTS) - MIN(tso.NUM_ENROLLED_STUDENTS) AS enrolled_range, VARIANCE(tso.NUM_ENROLLED_STUDENTS) AS enrolled_variance, sd.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED tso JOIN SIS_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT WHERE sd.IS_DEGREE_GRANTING = 'Y' AND scd.COURSE_LEVEL = 'G' AND sd.DEPARTMENT_CODE <> '7' GROUP BY sd.DEPARTMENT_NAME, sd.DEPARTMENT_CODE ), CombinedResults AS ( SELECT s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME, s1.LIBRARY_TERM_CODE, s1.TIP_TERM_CODE, s1.LIBRARY_NUM_ENROLLED, s1.TIP_NUM_ENROLLED, s1.MIN_TIP_NUM_ENROLLED, s2.DEPARTMENT_NAME, s2.enrolled_range, s2.enrolled_variance FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.OFFER_DEPT_CODE = s2.DEPARTMENT_CODE ) SELECT SUBJECT_TITLE, OFFER_DEPT_NAME, LIBRARY_TERM_CODE, TIP_TERM_CODE, LIBRARY_NUM_ENROLLED, TIP_NUM_ENROLLED, MIN_TIP_NUM_ENROLLED, DEPARTMENT_NAME, enrolled_range, enrolled_variance FROM CombinedResults ORDER BY SUBJECT_TITLE, DEPARTMENT_NAME;\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per library-TIP matched subject offering per degree-granting graduate department\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per course level of the Mathematics department\", \"desc\": \"For the Mathematics department, what is the department name, the average of the total units, the range of the total units, the variance of the total units for courses with total units greater than 0, and for each course level, what is the number of unique students and the minimum CIP program code among their courses, considering only degree-granting departments? Additionally, for each course level, what is the average number of lecture units and the maximum number of lab units for Mathematics courses? Do not return any rounded answers.\", \"id\": \"dw_2272\", \"name\": \"Math Department Unit Statistics with Course Level Student Counts and Lecture-Lab Unit Averages\", \"sql\": \"WITH inner_cte AS ( WITH department_units_stats AS ( SELECT SIS_DEPARTMENT.DEPARTMENT_NAME, AVG(CIS_COURSE_CATALOG.TOTAL_UNITS) AS avg_total_units, MAX(CIS_COURSE_CATALOG.TOTAL_UNITS) - MIN(CIS_COURSE_CATALOG.TOTAL_UNITS) AS total_units_range, VARIANCE(CIS_COURSE_CATALOG.TOTAL_UNITS) AS total_units_variance FROM SIS_DEPARTMENT JOIN CIS_COURSE_CATALOG ON SIS_DEPARTMENT.DEPARTMENT_CODE = CIS_COURSE_CATALOG.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE ON CIS_COURSE_CATALOG.DEPARTMENT_CODE = SIS_SUBJECT_CODE.DEPARTMENT_CODE WHERE CIS_COURSE_CATALOG.TOTAL_UNITS > 0 AND SIS_DEPARTMENT.IS_DEGREE_GRANTING = 'Y' AND SIS_DEPARTMENT.DEPARTMENT_NAME = 'Mathematics' AND SIS_DEPARTMENT.DEPARTMENT_CODE = '18' GROUP BY SIS_DEPARTMENT.DEPARTMENT_NAME ORDER BY total_units_range DESC ), department_student_cip_stats AS ( SELECT sd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT msd.FULL_NAME) AS student_count, MIN(scd.CIP_PROGRAM_CODE) AS min_cip_code FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' GROUP BY sd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT dus.DEPARTMENT_NAME, dus.avg_total_units, dus.total_units_range, dus.total_units_variance, dscs.COURSE_LEVEL, dscs.student_count, dscs.min_cip_code FROM department_units_stats dus JOIN department_student_cip_stats dscs ON dus.DEPARTMENT_NAME = dscs.DEPARTMENT_NAME ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.avg_total_units, inner_cte.total_units_range, inner_cte.total_units_variance, inner_cte.COURSE_LEVEL, inner_cte.student_count, inner_cte.min_cip_code, stats.avg_lecture_units, stats.max_lab_units FROM inner_cte JOIN ( SELECT scd.COURSE_LEVEL, AVG(ccc.LECTURE_UNITS) AS avg_lecture_units, MAX(ccc.LAB_UNITS) AS max_lab_units FROM SIS_COURSE_DESCRIPTION scd JOIN CIS_COURSE_CATALOG ccc ON scd.DEPARTMENT = ccc.DEPARTMENT_CODE WHERE scd.DEPARTMENT_NAME = 'Mathematics' AND ccc.DEPARTMENT_CODE = '18' AND ccc.TOTAL_UNITS > 0 GROUP BY scd.COURSE_LEVEL ) stats ON inner_cte.COURSE_LEVEL = stats.COURSE_LEVEL;\"}, {\"category\": \"Textbook Material and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2022 Mathematics TIP subject offering with department unit statistics\", \"desc\": \"For each subject offered in the 2022 academic year by a degree-granting department, specifically in the Department of Mathematics (Course 18) and excluding subjects offered by the Department of Physics, provide the subject ID, subject title, department name, the number of enrolled students, the total number of lecture units, and, for each subject, indicate whether it is also offered as a joint subject with another department. Additionally, show the range and variance of the total units for letter graded subjects offered this year in the Mathematics department. List the results in order of subject ID. Do not return any rounded answers.\", \"id\": \"dw_2158\", \"name\": \"Math 2022 TIP Subjects with Joint-Subject Flag and Letter-Graded Unit Range-Variance\", \"sql\": \"WITH inner_cte AS ( SELECT tso.SUBJECT_ID, ccso.SUBJECT_TITLE, sd.DEPARTMENT_NAME, tso.NUM_ENROLLED_STUDENTS, ccso.LECTURE_UNITS, sd.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED tso JOIN SIS_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON tso.SUBJECT_ID = ccso.SUBJECT_ID AND ccso.ACADEMIC_YEAR = 2022 AND ccso.DEPARTMENT_CODE = sd.DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_NAME <> 'Physics' ), MathDeptUnitStats AS ( SELECT DEPARTMENT_NAME, DEPARTMENT_CODE, MAX(TOTAL_UNITS) - MIN(TOTAL_UNITS) AS total_units_range, VARIANCE(TOTAL_UNITS) AS total_units_variance FROM COURSE_CATALOG_SUBJECT_OFFERED WHERE IS_OFFERED_THIS_YEAR = 'Y' AND GRADE_TYPE = 'L' AND DEPARTMENT_NAME = 'Mathematics' AND DEPARTMENT_CODE = '18' AND TOTAL_UNITS IS NOT NULL GROUP BY DEPARTMENT_NAME, DEPARTMENT_CODE ) SELECT ic.SUBJECT_ID, ic.SUBJECT_TITLE, ic.DEPARTMENT_NAME, ic.NUM_ENROLLED_STUDENTS, ic.LECTURE_UNITS, CASE WHEN ccs.JOINT_SUBJECTS IS NOT NULL AND TRIM(ccs.JOINT_SUBJECTS) <> '' THEN 'Y' ELSE 'N' END AS IS_JOINT_SUBJECT, mds.total_units_range, mds.total_units_variance FROM inner_cte ic JOIN COURSE_CATALOG_SUBJECT_OFFERED ccs ON ic.SUBJECT_ID = ccs.SUBJECT_ID AND ccs.ACADEMIC_YEAR = 2022 AND ccs.DEPARTMENT_CODE = ic.DEPARTMENT_CODE JOIN MathDeptUnitStats mds ON ic.DEPARTMENT_NAME = mds.DEPARTMENT_NAME AND ic.DEPARTMENT_CODE = mds.DEPARTMENT_CODE ORDER BY ic.SUBJECT_ID;\"}, {\"category\": \"Subject Offering and Faculty Directory Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics subject offered this year with responsible faculty contact details\", \"desc\": \"For each department that is Mathematics (Course 18), provide the department's name, the range and variance of the total units for subjects offered by that department in the academic year 2022 and that are also listed in the CIS course catalog, and for all course subjects in the catalog where the department code is 18 (Mathematics), the department name is 'Mathematics', and the subject is offered this year, show the subject code, subject number, responsible faculty's full name, Moira list member, the average office phone number in a window of 2 preceding and 2 following rows grouped by the responsible faculty's last name and ordered by the subject code, and the email address of the responsible faculty. Do not return any rounded answers.\", \"id\": \"dw_2377\", \"name\": \"Math 2022 Unit Range-Variance with Offered-This-Year Subjects and Responsible Faculty Contact Windows\", \"sql\": \"WITH inner_cte AS ( SELECT sd.DEPARTMENT_NAME, MAX(ccso.TOTAL_UNITS) - MIN(ccso.TOTAL_UNITS) AS units_range, VARIANCE(ccso.TOTAL_UNITS) AS units_variance FROM COURSE_CATALOG_SUBJECT_OFFERED ccso JOIN SIS_DEPARTMENT sd ON ccso.DEPARTMENT_CODE = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE ccso.ACADEMIC_YEAR = 2022 AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_NAME ORDER BY units_range DESC ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.units_range, inner_cte.units_variance, c.SUBJECT_CODE, c.SUBJECT_NUMBER, c.DEPARTMENT_NAME AS SUBJECT_DEPARTMENT_NAME, ed.FULL_NAME AS RESPONSIBLE_FACULTY_FULL_NAME, mld.MOIRA_LIST_MEMBER, AVG(ed.OFFICE_PHONE) OVER ( PARTITION BY ed.LAST_NAME ORDER BY c.SUBJECT_CODE ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS AVG_OFFICE_PHONE_WINDOW, ed.EMAIL_ADDRESS AS RESPONSIBLE_FACULTY_EMAIL FROM inner_cte JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON inner_cte.DEPARTMENT_NAME = c.DEPARTMENT_NAME JOIN EMPLOYEE_DIRECTORY ed ON c.RESPONSIBLE_FACULTY_MIT_ID = ed.MIT_ID LEFT JOIN MOIRA_LIST_DETAIL mld ON ed.MIT_ID = mld.MOIRA_LIST_MEMBER_MIT_ID WHERE c.DEPARTMENT_CODE = 18 AND c.DEPARTMENT_NAME = 'Mathematics' AND c.IS_OFFERED_THIS_YEAR = 'Y' ORDER BY c.SUBJECT_CODE;\"}, {\"id\": \"dw_1301\", \"name\": \"Math Yearly Max Total Units with Fall-Term Library Enrollment Stddev and Equivalent Subjects\", \"desc\": \"For each academic year, where the maximum number of total units for any Mathematics (Course 18) subject offered in that year is greater than 9 and there are more than 5 Mathematics subjects offered in the fall term, what are the academic year, the maximum total units, the corresponding term description, the subject title, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in library subjects offered during terms in that year, and the average number of equivalent subjects for those library subjects? List the results in order of academic year. Do not return any rounded answers.\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"sql\": \"WITH inner_cte1 AS ( SELECT c.ACADEMIC_YEAR, MAX(c.TOTAL_UNITS) AS max_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c WHERE c.DEPARTMENT_NAME = 'Mathematics' GROUP BY c.ACADEMIC_YEAR HAVING max_total_units > 9 ), MaxUnitsSubjects AS ( SELECT ic.ACADEMIC_YEAR, ic.max_total_units, ata.TERM_DESCRIPTION, c.SUBJECT_TITLE FROM inner_cte1 ic JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON c.ACADEMIC_YEAR = ic.ACADEMIC_YEAR AND c.TOTAL_UNITS = ic.max_total_units AND c.DEPARTMENT_NAME = 'Mathematics' JOIN ACADEMIC_TERMS_ALL ata ON ata.TERM_CODE = c.TERM_CODE ), inner_cte2 AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, STDDEV(lso.NUM_ENROLLED_STUDENTS) AS stddev_num_enrolled_students FROM LIBRARY_SUBJECT_OFFERED lso JOIN ACADEMIC_TERMS_ALL ata ON lso.TERM_CODE = ata.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON lso.TERM_CODE = ccso.TERM_CODE AND lso.SUBJECT_ID = ccso.SUBJECT_ID WHERE ccso.DEPARTMENT_NAME = 'Mathematics' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC HAVING COUNT(*) > 5 ), LibraryStats AS ( SELECT icte.ACADEMIC_YEAR, icte.ACADEMIC_YEAR_DESC, icte.stddev_num_enrolled_students, AVG( CASE WHEN ccso.EQUIVALENT_SUBJECTS IS NULL OR ccso.EQUIVALENT_SUBJECTS = '' THEN 0 ELSE 1 + LENGTH(ccso.EQUIVALENT_SUBJECTS) - LENGTH(REPLACE(ccso.EQUIVALENT_SUBJECTS, ',', '')) END ) AS avg_num_equivalent_subjects FROM inner_cte2 icte JOIN ACADEMIC_TERMS_ALL ata ON icte.ACADEMIC_YEAR = ata.ACADEMIC_YEAR JOIN LIBRARY_SUBJECT_OFFERED lso ON ata.TERM_CODE = lso.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON lso.TERM_CODE = ccso.TERM_CODE AND lso.SUBJECT_ID = ccso.SUBJECT_ID WHERE ccso.DEPARTMENT_NAME = 'Mathematics' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY icte.ACADEMIC_YEAR, icte.ACADEMIC_YEAR_DESC, icte.stddev_num_enrolled_students ) SELECT mus.ACADEMIC_YEAR, mus.max_total_units, mus.TERM_DESCRIPTION, mus.SUBJECT_TITLE, ls.ACADEMIC_YEAR_DESC, ls.stddev_num_enrolled_students, ls.avg_num_equivalent_subjects FROM MaxUnitsSubjects mus JOIN LibraryStats ls ON mus.ACADEMIC_YEAR = ls.ACADEMIC_YEAR ORDER BY mus.ACADEMIC_YEAR;\", \"default_granularity\": \"one row per academic year per max-unit subject\"}, {\"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics IAP activity per academic year per department\", \"desc\": \"For IAP subjects in the \\\"Mathematics\\\" category, show the activity title, enrollment type, maximum enrollment, category name, activity description, and the row number within each enrollment type group ordered by activity title, along with the academic year, department name, average enrollment, enrollment variance, department phone number, and school name for each academic year and department where the IAP subject's term matches a department's fall term subject offering with more than 0 enrolled students. Do not return any rounded answers.\", \"id\": \"dw_4229\", \"name\": \"Mathematics IAP Category Activities Matched with Fall-Term Department Enrollment Statistics\", \"sql\": \"WITH inner_cte1 AS ( SELECT d.ACTIVITY_TITLE, d.ENROLLMENT_TYPE, d.MAX_ENROLLMENT, c.IAP_CATEGORY_NAME, ROW_NUMBER() OVER (PARTITION BY d.ENROLLMENT_TYPE ORDER BY d.ACTIVITY_TITLE) AS window_column, d.TERM_CODE FROM IAP_SUBJECT_DETAIL d JOIN IAP_SUBJECT_CATEGORY c ON d.IAP_SUBJECT_CATEGORY_KEY = c.IAP_SUBJECT_CATEGORY_KEY WHERE c.IAP_CATEGORY_NAME = 'Mathematics' ), subq1 AS ( SELECT inner_cte1.ACTIVITY_TITLE, inner_cte1.ENROLLMENT_TYPE, inner_cte1.MAX_ENROLLMENT, inner_cte1.IAP_CATEGORY_NAME, d.ACTIVITY_DESCRIPTION, inner_cte1.window_column, inner_cte1.TERM_CODE FROM inner_cte1 JOIN IAP_SUBJECT_DETAIL d ON inner_cte1.ACTIVITY_TITLE = d.ACTIVITY_TITLE AND inner_cte1.ENROLLMENT_TYPE = d.ENROLLMENT_TYPE ), inner_cte2 AS ( SELECT ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS, COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE FROM COURSE_CATALOG_SUBJECT_OFFERED JOIN ACADEMIC_TERMS_ALL ON COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE = ACADEMIC_TERMS_ALL.TERM_CODE JOIN TIP_SUBJECT_OFFERED ON ACADEMIC_TERMS_ALL.TERM_CODE = TIP_SUBJECT_OFFERED.TERM_CODE WHERE COURSE_CATALOG_SUBJECT_OFFERED.IS_OFFERED_FALL_TERM = 'Y' AND TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS > 0 ), subq2 AS ( SELECT inner_cte2.ACADEMIC_YEAR, inner_cte2.DEPARTMENT_NAME, AVG(inner_cte2.NUM_ENROLLED_STUDENTS) AS avg_enrollment, VARIANCE(inner_cte2.NUM_ENROLLED_STUDENTS) AS enrollment_variance, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.SCHOOL_NAME AS school_name, inner_cte2.TERM_CODE FROM inner_cte2 LEFT JOIN SIS_DEPARTMENT sd ON inner_cte2.DEPARTMENT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE GROUP BY inner_cte2.ACADEMIC_YEAR, inner_cte2.DEPARTMENT_NAME, ad.DEPARTMENT_PHONE_NUMBER, sd.SCHOOL_NAME, inner_cte2.TERM_CODE ) SELECT s1.ACTIVITY_TITLE, s1.ENROLLMENT_TYPE, s1.MAX_ENROLLMENT, s1.IAP_CATEGORY_NAME, s1.ACTIVITY_DESCRIPTION, s1.window_column, s2.ACADEMIC_YEAR, s2.DEPARTMENT_NAME, s2.avg_enrollment, s2.enrollment_variance, s2.department_phone, s2.school_name FROM subq1 s1 JOIN subq2 s2 ON s1.TERM_CODE = s2.TERM_CODE ORDER BY s1.ACTIVITY_TITLE, s2.ACADEMIC_YEAR, s2.DEPARTMENT_NAME\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics department combining subject unit statistics with graduate student counts\", \"desc\": \"For the Mathematics department (Course 18), provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student), the number of graduate students in the department, and the most recent warehouse load date for those students, considering only departments that are degree granting and students whose year is 'G'. Do not return any rounded answers.\", \"id\": \"dw_1212\", \"name\": \"Math Department Subject Unit Average-Stddev with Graduate Student Count and Latest Load Date\", \"sql\": \"WITH DeptUnits AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_total_units, STDDEV(s.TOTAL_UNITS) AS stddev_total_units FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.TOTAL_UNITS > 0 AND s.NUM_ENROLLED_STUDENTS >= 1 AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME ORDER BY stddev_total_units DESC ), DeptStudents AS ( SELECT sd.DEPARTMENT_NAME, COUNT(msd.FULL_NAME) AS student_count, MAX(msd.WAREHOUSE_LOAD_DATE) AS latest_student_load FROM SIS_DEPARTMENT sd JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT JOIN SIS_ADMIN_DEPARTMENT sad ON msd.DEPARTMENT = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND msd.STUDENT_YEAR = 'G' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_NAME ORDER BY student_count DESC LIMIT 10 ) SELECT du.DEPARTMENT_NAME, du.avg_total_units, du.stddev_total_units, ds.student_count, ds.latest_student_load FROM DeptUnits du JOIN DeptStudents ds ON du.DEPARTMENT_NAME = ds.DEPARTMENT_NAME;\"}, {\"id\": \"dw_1049\", \"name\": \"Mathematics Total Units Stddev for Regular Non-Current Terms vs 2022 Degree-Granting Departments\", \"category\": \"Subject Offering Analysis\", \"desc\": \"For the Mathematics department, what is the department name, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for its subjects in regular terms that are not the current term, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department in the 2022 academic year (considering only departments that have more than five subjects offered in 2022, are degree-granting, and are not the Chemistry department)? Show the department name, the standard deviation (using STDDEV only and never STDDEV_POP) for regular non-current terms, and the standard deviation (using STDDEV only and never STDDEV_POP) for 2022. Do not return any rounded answers.\", \"sql\": \"WITH MathDeptStddev AS ( SELECT ss.DEPARTMENT_NAME, STDDEV(ss.TOTAL_UNITS) AS stddev_total_units FROM SUBJECT_SUMMARY ss JOIN ACADEMIC_TERMS at ON ss.TERM_CODE = at.TERM_CODE WHERE ss.DEPARTMENT_NAME = 'Mathematics' AND at.IS_REGULAR_TERM = 'Y' AND at.IS_CURRENT_TERM = 'N' GROUP BY ss.DEPARTMENT_NAME ), DeptStddev2022 AS ( SELECT scd.DEPARTMENT_NAME, STDDEV(ccso.TOTAL_UNITS) AS total_units_stddev FROM SIS_SUBJECT_CODE ssc JOIN SIS_COURSE_DESCRIPTION scd ON ssc.SUBJECT_CODE = scd.COURSE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON scd.COURSE = ccso.SUBJECT_CODE WHERE ccso.ACADEMIC_YEAR = 2022 AND scd.IS_DEGREE_GRANTING = 'Y' AND scd.DEPARTMENT_NAME <> 'Chemistry' GROUP BY scd.DEPARTMENT_NAME HAVING COUNT(*) > 5 ORDER BY total_units_stddev DESC ) SELECT mds.DEPARTMENT_NAME, mds.stddev_total_units AS math_stddev_total_units, dsd.total_units_stddev AS dept_stddev_2022 FROM MathDeptStddev mds LEFT JOIN DeptStddev2022 dsd ON mds.DEPARTMENT_NAME = dsd.DEPARTMENT_NAME;\", \"default_granularity\": \"one row per department\"}], \"not_found\": []}"
    },
