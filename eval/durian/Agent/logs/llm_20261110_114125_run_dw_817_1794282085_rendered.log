      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SPACE_DETAIL\", \"name\": \"SPACE_DETAIL\", \"desc\": \"Space assignment detail fact table: one row per physical room assigned to a space unit, with building/floor/space-unit/space-usage keys, room identifiers (building-room number and name, room number), room square footage, room counter, and building component. Used to count rooms per space unit or per building, and to analyze room size and usage distribution. Joins to SPACE_UNIT via SPACE_UNIT_KEY, FCLT_BUILDING via BUILDING_KEY, SPACE_FLOOR via FLOOR_KEY, and SPACE_USAGE via SPACE_USAGE_KEY.\", \"columns\": {\"BUILDING_KEY\": {\"desc\": \"Foreign key to FCLT_BUILDING.FCLT_BUILDING_KEY; the building containing the room; used to find the building with the most rooms within a space unit\"}, \"FLOOR_KEY\": {\"desc\": \"Foreign key to SPACE_FLOOR.FLOOR_KEY; the floor the room is on\"}, \"SPACE_UNIT_KEY\": {\"desc\": \"Foreign key to SPACE_UNIT.SPACE_UNIT_KEY; the space unit the room is assigned to\"}, \"SPACE_USAGE_KEY\": {\"desc\": \"Foreign key to SPACE_USAGE.SPACE_USAGE_KEY; the usage classification of the room (e.g. classroom, office, lab)\"}, \"BUILDING_ROOM\": {\"desc\": \"Combined building-room identifier, e.g. '1-080'; counting rows of this column gives the number of rooms per space unit/building\"}, \"BUILDING_ROOM_NAME\": {\"desc\": \"Room name (usually identical to BUILDING_ROOM)\"}, \"ROOM_NUMBER\": {\"desc\": \"Room number within the building, e.g. '80', '82F'\"}, \"ROOM_SQUARE_FOOTAGE\": {\"desc\": \"Room area in square feet (note: FCLT_ROOMS.AREA is in square meters)\"}, \"ROOM_COUNTER\": {\"desc\": \"Room count indicator; equals 1 for every room row, so SUM(ROOM_COUNTER) also yields room counts\"}, \"BUILDING_COMPONENT\": {\"desc\": \"Building component identifier the room belongs to\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per room assigned to a space unit\", \"entity\": {\"columns\": {\"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the room assignment record, stored as DD-MON-YY text (e.g. '19-DEC-24'); all current rows carry '19-DEC-24'. This is the room-side load date used to filter which room snapshot to analyze; it is distinct from SPACE_FLOOR.WAREHOUSE_LOAD_DATE (the floor lookup record's load date), which is the column to report when a question asks for the floor's warehouse load date.\"}}}, \"reason\": \"Case dw_2528 filters rooms on SPACE_DETAIL.WAREHOUSE_LOAD_DATE='19-DEC-24' while reporting the floor's warehouse load date from SPACE_FLOOR; the two same-named columns are confusing and their difference (room snapshot load date vs floor lookup load date, DD-MON-YY text format) must be documented per column description rules.\"}, {\"id\": \"SPACE_FLOOR\", \"name\": \"SPACE_FLOOR\", \"desc\": \"Space-domain floor lookup table: one row per floor key with the floor number/label and floor name. Referenced by SPACE_DETAIL via FLOOR_KEY to attach floor identity to assigned rooms; a lightweight floor reference without the area measures carried by FCLT_FLOOR or FAC_FLOOR.\", \"columns\": {\"FLOOR_KEY\": {\"desc\": \"Surrogate key of the floor; joins to SPACE_DETAIL.FLOOR_KEY\"}, \"FLOOR\": {\"desc\": \"Floor number/label within the building\"}, \"FLOOR_NAME\": {\"desc\": \"Display name of the floor\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per floor key\", \"entity\": {\"columns\": {\"FLOOR_NAME\": {\"desc\": \"Display name of the floor; unique across floor keys in current data (49 distinct names for 49 rows), so it is safe as a join/group key when combining per-floor derived results (e.g. matching each floor's largest room back to floor-level attributes).\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the floor lookup record, stored as DD-MON-YY text (e.g. '19-DEC-24'); all current rows carry '19-DEC-24'. This is the column to report when a question asks for the floor's warehouse load date; it is distinct from SPACE_DETAIL.WAREHOUSE_LOAD_DATE, which is the room-side load date used to filter room assignment snapshots.\"}}}, \"reason\": \"Case dw_2528 reports SPACE_FLOOR.WAREHOUSE_LOAD_DATE as the floor's warehouse load date and joins derived per-floor results on FLOOR_NAME; documenting the load-date column distinction from SPACE_DETAIL and the verified uniqueness of FLOOR_NAME prevents wrong-column selection and unfounded fan-out concerns.\"}, {\"id\": \"dw_2528\", \"name\": \"Stata Building Per-Floor Largest Room with Room-Level Square Footage and Floor Average\", \"desc\": \"For each floor in the Stata building (building 32), what is the largest room square footage and the name of the building room with that largest square footage for rooms loaded into the warehouse on 19-DEC-24 with a largest room square footage greater than 100, and for each space unit on that floor with a room square footage greater than 10, what are the building room name, room number, room square footage, the average room square footage within the floor, and the floor's warehouse load date? List the results showing floor name, largest room name, largest room square footage, building room name, room number, room square footage, average room square footage per floor, and floor warehouse load date, ordered by floor name and room square footage. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH largest_room_per_floor AS ( SELECT sf.FLOOR_NAME, sd.BUILDING_ROOM_NAME, sd.ROOM_SQUARE_FOOTAGE, sd.FLOOR_KEY FROM SPACE_DETAIL sd JOIN SPACE_FLOOR sf ON sd.FLOOR_KEY = sf.FLOOR_KEY WHERE sd.BUILDING_KEY = 32 AND sd.WAREHOUSE_LOAD_DATE = '19-DEC-24' AND sd.ROOM_SQUARE_FOOTAGE > 100 AND sd.ROOM_SQUARE_FOOTAGE = ( SELECT MAX(sd2.ROOM_SQUARE_FOOTAGE) FROM SPACE_DETAIL sd2 WHERE sd2.BUILDING_KEY = 32 AND sd2.FLOOR_KEY = sd.FLOOR_KEY AND sd2.WAREHOUSE_LOAD_DATE = '19-DEC-24' ) ORDER BY sf.FLOOR_NAME ), room_and_avg_per_floor AS ( SELECT sd.BUILDING_ROOM_NAME, sd.ROOM_NUMBER, sd.ROOM_SQUARE_FOOTAGE, sf.FLOOR_NAME, AVG(sd2.ROOM_SQUARE_FOOTAGE) AS AVG_ROOM_SQUARE_FOOTAGE_PER_FLOOR, sd.FLOOR_KEY FROM SPACE_DETAIL sd JOIN SPACE_FLOOR sf ON sd.FLOOR_KEY = sf.FLOOR_KEY JOIN SPACE_DETAIL sd2 ON sd2.FLOOR_KEY = sd.FLOOR_KEY WHERE sd.BUILDING_KEY = 32 AND sd.ROOM_SQUARE_FOOTAGE > 10 GROUP BY sd.BUILDING_ROOM_NAME, sd.ROOM_NUMBER, sd.ROOM_SQUARE_FOOTAGE, sf.FLOOR_NAME, sd.FLOOR_KEY ORDER BY sd.ROOM_SQUARE_FOOTAGE ) SELECT lrf.FLOOR_NAME, lrf.BUILDING_ROOM_NAME AS LARGEST_ROOM_NAME, lrf.ROOM_SQUARE_FOOTAGE AS LARGEST_ROOM_SQUARE_FOOTAGE, raf.BUILDING_ROOM_NAME, raf.ROOM_NUMBER, raf.ROOM_SQUARE_FOOTAGE, raf.AVG_ROOM_SQUARE_FOOTAGE_PER_FLOOR, sf.WAREHOUSE_LOAD_DATE AS FLOOR_WAREHOUSE_LOAD_DATE FROM largest_room_per_floor lrf JOIN room_and_avg_per_floor raf ON lrf.FLOOR_NAME = raf.FLOOR_NAME JOIN SPACE_FLOOR sf ON lrf.FLOOR_NAME = sf.FLOOR_NAME ORDER BY lrf.FLOOR_NAME, raf.ROOM_SQUARE_FOOTAGE ) SELECT * FROM inner_cte;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per room (square footage > 10) matched to its floor's largest room (square footage > 100, loaded 19-DEC-24) in building 32\"}], \"not_found\": []}"
