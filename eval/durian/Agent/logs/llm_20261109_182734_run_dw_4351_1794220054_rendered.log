      "tool_call_id": "call_7b45e848d457461ca19f4ae7",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA subject offering matched with an above-average-last-name EECS student\", \"desc\": \"For subjects offered in the term '2017JA', and for students in the \\\"Electrical Eng & Computer Sci\\\" department whose last name is alphabetically after the average last name (in terms of ASCII value) within their course level group, show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, the minimum number of enrolled students over each subject code group, the school name, department phone number, the student's full name, email address, department name, course description, course level, and the student's row number within their course level group ordered by last name. Order the results by subject code, course level, and student row number within course level. Do not return any rounded answers.\", \"id\": \"dw_3969\", \"name\": \"2017JA Subject Enrollment Windows Matched with Above-Average-Last-Name EECS Student Row Numbers\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t2.SUBJECT_CODE, t2.SUBJECT_CODE_DESC, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t2.SUBJECT_CODE ORDER BY t2.SUBJECT_CODE) AS window_column, t1.DEPARTMENT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN SIS_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ) SELECT inner_cte.SUBJECT_TITLE, inner_cte.NUM_ENROLLED_STUDENTS, inner_cte.OFFER_DEPT_NAME, inner_cte.DEPARTMENT_FULL_NAME, inner_cte.SUBJECT_CODE, inner_cte.SUBJECT_CODE_DESC, inner_cte.window_column, sd.SCHOOL_NAME, ad.DEPARTMENT_PHONE_NUMBER, inner_cte.DEPARTMENT_CODE FROM inner_cte LEFT JOIN SIS_DEPARTMENT sd ON inner_cte.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), subq2 AS ( WITH inner_cte AS ( SELECT t2.FULL_NAME, t2.EMAIL_ADDRESS, t1.DEPARTMENT_NAME, t0.COURSE_DESCRIPTION, t0.COURSE_LEVEL, t2.LAST_NAME, t1.DEPARTMENT_CODE FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT WHERE t1.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' ), avg_lastname_cte AS ( SELECT COURSE_LEVEL, AVG(ASCII(SUBSTR(LAST_NAME, 1, 1))) AS avg_ascii FROM inner_cte GROUP BY COURSE_LEVEL ) SELECT i.FULL_NAME, i.EMAIL_ADDRESS, i.DEPARTMENT_NAME, i.COURSE_DESCRIPTION, i.COURSE_LEVEL, ROW_NUMBER() OVER (PARTITION BY i.COURSE_LEVEL ORDER BY i.LAST_NAME) AS window_column, i.DEPARTMENT_CODE FROM inner_cte i JOIN avg_lastname_cte a ON i.COURSE_LEVEL = a.COURSE_LEVEL WHERE ASCII(SUBSTR(i.LAST_NAME, 1, 1)) > a.avg_ascii ) SELECT s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.OFFER_DEPT_NAME, s1.DEPARTMENT_FULL_NAME, s1.SUBJECT_CODE, s1.SUBJECT_CODE_DESC, s1.window_column AS MIN_NUM_ENROLLED_STUDENTS_OVER_SUBJECT_CODE, s1.SCHOOL_NAME, s1.DEPARTMENT_PHONE_NUMBER, s2.FULL_NAME, s2.EMAIL_ADDRESS, s2.DEPARTMENT_NAME, s2.COURSE_DESCRIPTION, s2.COURSE_LEVEL, s2.window_column AS STUDENT_ROW_NUMBER_WITHIN_COURSE_LEVEL FROM subq1 s1 JOIN subq2 s2 ON s1.DEPARTMENT_CODE = s2.DEPARTMENT_CODE ORDER BY s1.SUBJECT_CODE, s2.COURSE_LEVEL, s2.window_column;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department per subject code with fall-only offering enrollment average\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and the average number of enrolled students for each subject in the department, considering only subjects that are offered in the fall term and are not offered in the summer term. Do not return any rounded answers.\", \"id\": \"dw_2398\", \"name\": \"Department Course Counts with Fall-Only Non-Summer Subject Average TIP Enrollment\", \"sql\": \"WITH inner_cte AS ( SELECT sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL, COUNT(DISTINCT scd.COURSE) AS Total_Courses FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER GROUP BY sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL ) SELECT icte.DEPARTMENT_NAME, icte.SUBJECT_CODE, icte.SUBJECT_CODE_DESC, icte.GRADUATE_LEVEL, icte.Total_Courses, AVG(tso.NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM inner_cte icte JOIN TIP_SUBJECT_OFFERED tso ON icte.SUBJECT_CODE = tso.COURSE_NUMBER JOIN SIS_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE AND sd.DEPARTMENT_NAME = icte.DEPARTMENT_NAME JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON tso.SUBJECT_ID = ccso.SUBJECT_ID WHERE ccso.IS_OFFERED_FALL_TERM = 'Y' AND ccso.IS_OFFERED_SUMMER_TERM = 'N' GROUP BY icte.DEPARTMENT_NAME, icte.SUBJECT_CODE, icte.SUBJECT_CODE_DESC, icte.GRADUATE_LEVEL, icte.Total_Courses ORDER BY icte.DEPARTMENT_NAME, icte.SUBJECT_CODE;\"}], \"not_found\": []}"
