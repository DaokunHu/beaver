    {
      "role": "tool",
      "tool_call_id": "call_28967e2faf8c4ab4a227baf5",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"table_id\": \"SIS_SUBJECT_CODE\", \"table_name\": \"SIS_SUBJECT_CODE\", \"count\": 37, \"items\": [{\"metric_id\": \"dw_1049\", \"name\": \"Mathematics Total Units Stddev for Regular Non-Current Terms vs 2022 Degree-Granting Departments\", \"category\": \"Subject Offering Analysis\", \"desc\": \"For the Mathematics department, what is the department name, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for its subjects in regular terms that are not the current term, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department in the 2022 academic year (considering only departments that have more than five subjects offered in 2022, are degree-granting, and are not the Chemistry department)? Show the department name, the standard deviation (using STDDEV only and never STDDEV_POP) for regular non-current terms, and the standard deviation (using STDDEV only and never STDDEV_POP) for 2022. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3887\", \"name\": \"IAP Max Enrollment 12 Activities with Enrollment-Unit Difference and Department Subject Counts\", \"category\": \"IAP Activity and Course Catalog Comprehensive Analysis\", \"desc\": \"For IAP subjects with a maximum enrollment of 12, show the activity title, enrollment type, academic year, term description, subject title, the difference between the maximum enrollment and the total units, the subject code, subject code description, department name, and the number of subjects in the same department, for each subject offered in the same term and where the school code and subject title are not null. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3985\", \"name\": \"2006FA Department Lecture Unit Sums with 2017JA Enrollment Classification per Subject Code\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"desc\": \"For each subject offered in the academic term with term code '2006FA' in departments that offer more than 5 subjects in that term, show the subject ID, subject title, department name, the sum of lecture units within each grade type group, and the total number of subjects per department for that term. Additionally, for each subject offered by the same department in the term '2017JA', show the number of enrolled students, offering department name, department full name, subject code, subject code description, and whether the number of enrolled students is 'HIGH_ENROLLMENT' (at least 10% greater than the average for that subject code), 'LOW_ENROLLMENT' (at least 10% less than the average for that subject code), or 'AVERAGE'. Present the results ordered by subject ID and subject code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3989\", \"name\": \"2024 Subjects Windowed Min Units with Engineering Course Description Length Deviation\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For each department and each subject offered in the academic year 2024, show the department name, subject code, subject number, subject title, term code, term description, and the highest minimum total units (in a window of 3 preceding and 1 following row ordered by academic year) for that subject, along with the course description, subject code description, and the difference between the number of characters in the course description and the average number of characters in course descriptions for that department, for courses in the School of Engineering that are degree granting. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4019\", \"name\": \"2016SP Engineering School Subjects with Current Term Parameter Running Year Sums\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2016SP' with a school code of 'E', show the subject title, department name, course description, the number of enrolled students, the row number within a window of 2 preceding and 1 following rows ordered by subject title, and the highest running sum of academic years (within that department) for academic term parameters where the term indicator is 'C'. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4308\", \"name\": \"2017JA Subjects Enrollment per Subject Code with 2019FA School Running Unit Sums\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, and the minimum number of enrolled students over each subject code group, as well as the school code, school name, department code, school name from department, department phone number, and the highest running sum of total units for any subject within that school in the 2019FA term (where the subject has more than 1 total unit). Order the results by subject code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4756\", \"name\": \"Department Course Counts with 2022 12-Unit Subjects Having Textbooks\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and for each department, the number of subjects offered in the academic year 2022 with a total of 12 units that also have at least one required or optional textbook. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3215\", \"name\": \"2012 Subjects Department Row Numbers with Subject Code School Dense Ranks\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For subjects offered in the academic year 2012, show the subject key, subject title, offer department name, academic year, term description, the row number within each offer department name group ordered by subject key, the subject code, subject code description, department name, and the dense rank of each row partitioned by the school code and ordered by school code, for subjects where the school code is not null and the subject title is not null. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3861\", \"name\": \"2017FA High-Unit Subjects Dense Rank Matched with 2022SU Unit Dense Ranks\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For subject offerings in the term '2017FA' with a total number of units greater than 10, display the subject title, department name, school name, and their dense rank considering the current and 2 preceding rows ordered by the department code from the subject code table, along with any matching subject IDs from subjects offered in the term with code '2022SU', their department names, and their dense rank considering the current and 2 preceding rows ordered by the total number of units. Show the subject title, department name, school name, subq1 dense rank, subject ID, subq2 department name, and subq2 dense rank, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3867\", \"name\": \"Subject Code Department Counts Matched with 2022FA Above-Average Unit Running Sums\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For each subject in a department where the school code and subject title are not null, and for each subject offered in the 2022FA term with total units greater than the average for that term, display the subject code, subject code description, department name, subject title, the number of subjects in the same department, the subject ID, the term description, and the running sum of total units for that academic year, ordered by subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3904\", \"name\": \"Degree-Granting Subject Code Description Status Rollup by School with 2022SU Unit Dense Ranks\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name (from subject code), school name, the number of subject codes per school name and whether the subject code description is present ('Has Description') or missing ('No Description'), and for each matching department in subjects offered in the term with code '2022SU', show the subject's ID, total units, department name (from subject offered), and their dense rank considering the current and 2 preceding rows ordered by the total number of units. For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes, null, null, null, null). Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1302\", \"name\": \"Engineering Degree-Granting Department 2007 Course Rollup with Department Unit Totals and Latest-Year Course Counts\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each course offered by a degree-granting department in the School of Engineering, except for the Electrical Engineering and Computer Science department, in the 2007 academic year, what is the course key, course name, department name, the number of catalog subjects, the total units for those subjects, and for each department, include a grand total for all courses in the format of (null, null, department name, total subjects, total units)? Additionally, for each such department, what is the total number of units for courses in the \\\"Engineering\\\" or \\\"Non-MIT\\\" schools (where the total units for the department is greater than 1000 and the department is not \\\"Political Science\\\"), and how many distinct courses did the department offer in the most recent academic year available? Present the results as: course key, course name, department name, number of catalog subjects, total units for those subjects, department total units, and number of distinct courses in the latest year, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1766\", \"name\": \"Math Degree-Granting Course Level Counts with Min Units, Course Options, and Highest Term Average Library Enrollment\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each department name and course level where the course is degree granting, the total units are greater than 6, and the department is Mathematics (Course 18), provide the department name, course level, number of unique courses, minimum total units offered, school name, number of distinct course options available, and the highest average number of enrolled students in any term for courses offered by that department, considering only courses with more than 0 enrolled students and departments whose name is not null. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2210\", \"name\": \"Math Subject Code School Ranks Matched with 2024 Catalog Offerings and Department Min Units\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For each subject code in degree-granting departments where the department is Mathematics, and for subjects offered in the academic year 2024 that are also present in the CIS course catalog and are in the Mathematics department, show the subject code, subject code description, department name, school name, rank of the subject code within each school name group ordered by subject code, subject ID, subject number, subject short title, subject title, lecture units, lab units, total units, grade type, grade rule, the minimum total units value over each department code group, and the subject description from the CIS course catalog, ordered by school name, rank, and subject number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2272\", \"name\": \"Math Department Unit Statistics with Course Level Student Counts and Lecture-Lab Unit Averages\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For the Mathematics department, what is the department name, the average of the total units, the range of the total units, the variance of the total units for courses with total units greater than 0, and for each course level, what is the number of unique students and the minimum CIP program code among their courses, considering only degree-granting departments? Additionally, for each course level, what is the average number of lecture units and the maximum number of lab units for Mathematics courses? Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2335\", \"name\": \"Math Degree-Granting Course Level Counts with Catalog Unit Stddev and Unique Subject Codes\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each department name and course level, where the total number of enrolled students in offered subjects is greater than 10, and the department is Mathematics (Course 18), provide the number of unique courses, the minimum total units among those subjects that are degree-granting courses, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for Mathematics courses (considering only departments that offer more than five courses), and the number of unique subject codes for Mathematics in the SIS_SUBJECT_CODE table. List the department name, course level, number of unique courses, minimum total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the number of unique subject codes, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2365\", \"name\": \"Top 3 Most Offered Math Courses per Term with Description Counts, Min CIP Code, and Department Phone\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For the top 3 most frequently offered courses in the Mathematics department, for each course and each term it was offered, display the course number, course description, subject title, number of times offered, department name, number of unique course descriptions for that course and department, the minimum CIP program code for that course and department, the term code, the term description, the school name, and the department phone number. Do not repeat the course number if it is the same as the previous row. Sort the table by course number and term code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3311\", \"name\": \"Status-U Library Subjects with Enrollment Matched with Department Offered-This-Year Unit Dispersion\", \"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3590\", \"name\": \"Union of Subject Code School Dense Ranks and 2012SU Cluster-S Subject Unit Row Numbers\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"Show, for each subject, the subject code, subject code description, department name, subject title, and the dense rank of each row partitioned by the school code and ordered by school code for subjects where the school code is not null and the subject title is not null; and for subjects offered in the 2012SU term with a cluster type of 'S', show the subject title from SUBJECT_OFFERED, the offer department name, the total units from SUBJECT_SUMMARY, and assign row numbers within a window of 2 preceding and 1 following rows ordered by the subject title. Indicate the source of each row as either 'Subq1' or 'Subq2'. List all results together, showing the columns: subject code, subject code description, department name, subject title, dense rank by school, offer department name, total units, row number window, and source, in that order, ordered by subject title. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1471\", \"name\": \"Math 2024 12-Unit Subjects Ranked by School with Department Unit Dispersion and Communication Intensive Counts\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units in the Mathematics department (Course 18), show the subject code, subject title, department name, school name, and the rank within each school name group ordered by subject code, but only include those subjects whose total units exceed the average total units for their respective school. Additionally, for the Mathematics department, also show the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects that are offered this year, are letter graded, and are in the Mathematics department), as well as the number of subjects that are Communication Intensive (i.e., have a non-null COMM_REQ_ATTRIBUTE), with these statistics included for each subject in the result. Present the columns in the following order: subject code, subject title, department name, school name, rank within school, average total units, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), and number of Communication Intensive subjects. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2398\", \"name\": \"Department Course Counts with Fall-Only Non-Summer Subject Average TIP Enrollment\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and the average number of enrolled students for each subject in the department, considering only subjects that are offered in the fall term and are not offered in the summer term. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3236\", \"name\": \"Engineering Catalog Subjects Row Numbers Matched with 2017JA TIP Enrollment Windows\", \"category\": \"Course Catalog and Textbook Material Comprehensive Analysis\", \"desc\": \"For subjects offered by departments in the School of Engineering that are also offered in the term '2017JA', show the subject title, total units, department full name, the row number within a window of 2 preceding and 1 following rows ordered by subject title, number of enrolled students, offering department name, department full name for the term, subject code, subject code description, and the minimum number of enrolled students over each subject code group, ordered by subject title and subject code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1965\", \"name\": \"2017JA Chemistry TIP Subjects with Course Materials Enrollment Windows and Per-Faculty Max Enrollment\", \"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2017JA' by the Chemistry department (Course 5) that have course materials, show the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code, the subject code, the subject code description, the minimum number of enrolled students over each subject code group ordered by subject code, and the maximum number of enrolled students for each responsible faculty across all their Chemistry subjects in that term. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3356\", \"name\": \"Top 10 Reserved-Material Subjects in 2009SP with Degree-Granting Department Enrollment Variance and Stddev\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', what are the subject title, the offering department name, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only departments that grant degrees and subjects with a non-null subject code description), and the count of reserved materials? Please provide the subject title, the offering department name, the variance, the standard deviation (using STDDEV only and never STDDEV_POP), and the count of reserved materials, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4812\", \"name\": \"Top 10 Degree-Granting Department Subject Code and Course Number Combinations by Unique Library Subject Count\", \"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1474\", \"name\": \"Top 10 Engineering Degree-Granting Department Subject Counts with Kevin EECS Student Course Windows\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For the top 10 degree-granting departments (excluding 'Political Science' and Course 17) that have offered at least one subject in the 'Engineering' school, list the department name, school name, subject code description, the total number of subjects they offered, and the average number of enrolled students per subject, and for each such department, show the full names, email addresses, student years, department full names, course descriptions, course levels, the minimum course level in a window of 3 preceding and 1 following row ordered by the student's last name, and the corresponding subject code and subject code description for each course taken by students named 'Kevin' in 'Electrical Eng & Computer Sci' (Course 6). Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1983\", \"name\": \"EECS Students Windowed Admin Department Phone Averages with Engineering Subject Load Categories\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For students whose department is '6' and whose department name is 'Electrical Eng & Computer Sci', show their first name, last name, department name, student year, the corresponding department's full name, the administrative department name, and the average department phone number in a window of 2 preceding and 2 following rows grouped by the administrative department name and ordered by the student's first name. Additionally, for each subject offered in the 'Engineering' school with total units greater than 0 and only for subjects in the 'Electrical Eng & Computer Sci' department (Course 6), where the student's department matches the subject's offer department code, show the subject title, total units, subject department name, course description, and the dense rank over the offer department code ordered by offer department code. Finally, for each such subject, include the corresponding department's school name and whether the total units are 'HIGH_LOAD' (at least 12), 'LOW_LOAD' (at most 6), or 'MEDIUM_LOAD' (otherwise). Present the columns in the following order: first name, last name, department name, student year, department full name, administrative department name, average department phone number (windowed), subject title, total units, subject department name, course description, dense rank (windowed), department school name, and subject load category. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2240\", \"name\": \"EECS Engineering Subject Max Units and Distinct Student Year Counts per Offer Department\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For each subject offered in the 'Engineering' school with total units greater than 0 and only for subjects in the 'Electrical Eng & Computer Sci' department (Course 6), show the subject title, total units, department name, course description, and dense rank over the offer department code ordered by offer department code, along with the first name, last name, department name, student year, corresponding department's full name, administrative department name, and the average department phone number in a window of 2 preceding and 2 following rows grouped by the administrative department name and ordered by the student's first name, for students whose department is '6' and whose department name is 'Electrical Eng & Computer Sci', where the subject's offer department code matches the student's department. Then, for each offer department code, provide the maximum total units among these subjects and the count of distinct student years among the matched students. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3969\", \"name\": \"2017JA Subject Enrollment Windows Matched with Above-Average-Last-Name EECS Student Row Numbers\", \"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2017JA', and for students in the \\\"Electrical Eng & Computer Sci\\\" department whose last name is alphabetically after the average last name (in terms of ASCII value) within their course level group, show the subject title, number of enrolled students, offering department name, department full name, subject code, subject code description, the minimum number of enrolled students over each subject code group, the school name, department phone number, the student's full name, email address, department name, course description, course level, and the student's row number within their course level group ordered by last name. Order the results by subject code, course level, and student row number within course level. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1954\", \"name\": \"2019FA Chemistry TIP Subjects Windowed Min Enrollment with Department Subject Code Statistics\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2019FA' with more than 0 enrolled students, offered by the Chemistry department (Course 5), and only including courses that have course materials, show the subject title, offering department name, school name, department full name, and the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department name. Additionally, for the same department, provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the number of unique subject codes associated with its courses that are offered by degree-granting departments, but only include departments other than 'Mathematics' (Course 18). Also, for each of these departments, show the total number of courses offered by the department in the '2019FA' term that have at least one enrolled student and have course materials. Present the subject title, offering department name, school name, department full name, windowed minimum enrolled students, department name, average number of unique subject codes, standard deviation (using STDDEV only and never STDDEV_POP) of unique subject codes, and the total number of such courses, in that order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2224\", \"name\": \"Math Subject Code School Budget Code Windows with Non-Math Admin Department Clearing Cost Statistics\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each subject code where the department is degree granting and the department is Mathematics, and for each department that is degree granting and is not the Mathematics department (Course 18), show the subject code, subject code description, mathematics department name, school name, the average department budget code within each school, the administrative department name, the average clearing cost collector, the variance of the clearing cost collector, the standard deviation (using STDDEV only and never STDDEV_POP) of the clearing cost collector, and the most recent activity date for the administrative department. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4208\", \"name\": \"2016SP Engineering School Subject Row Numbers Matched with 2017JA TIP Subject Enrollment Windows\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2016SP' with a school code of 'E', and for subjects offered in the term '2017JA', show the subject title, department name, course description, the number of enrolled students in 2016SP, the row number within a window of 2 preceding and 1 following rows ordered by subject title, the number of enrolled students in 2017JA, the offering department name, department full name, subject code, subject code description, the minimum number of enrolled students over each subject code group in 2017JA, the school name, and the department phone number. Order the results by subject title and subject code. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2639\", \"name\": \"2016SP Engineering School Subjects Total Units Minus Lecture Units\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2016SP' with a school code of 'E', show the subject title, department name, course description, and the difference between the total units and lecture units for each subject. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3273\", \"name\": \"Engineering 12-Unit Courses Row Numbers with Subject Dense Ranks by Total Units\", \"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"desc\": \"For courses in the School of Engineering with a total of 12 units, display the course number, course description, subject title, total units, offering department name, the row number of the course within its offering department ordered by course number, and the dense rank of the subject (considering the current and 2 preceding rows ordered by total units) if available. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3828\", \"name\": \"Engineering Degree-Granting Courses Budget Code Dense Ranks with Subject Code Description Row Numbers\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For courses in the School of Engineering that are degree granting, show the course description, department name, the dense rank of each course considering the current and 2 preceding rows ordered by the department's budget code, the subject code description, and the row number of each course within a window of 2 preceding and 1 following rows ordered by course description. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4490\", \"name\": \"Degree-Granting Subject Code Description Status Rollup by School with 2016SP Engineering Subject Row Numbers\", \"category\": \"Course Catalog and Subject Offering Comprehensive Analysis\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name, school name, the number of subject codes per school name, and whether the subject code description is present ('Has Description') or missing ('No Description'). For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes). Additionally, for subjects offered in the term '2016SP' with a school code of 'E', show the subject title, course description, the offering department name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Present all columns in the following order: subject code, subject code description, department name, school name, description status, total subject codes, subject title, course description, offering department name, and window column. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4527\", \"name\": \"2021 Engineering Degree-Granting Department Enrollment Dispersion with Above-Average Subject Details\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only subjects with a non-null subject code description), and, for each subject in 2021 offered by these departments in the School of Engineering, list the subject id, subject title, and the number of enrolled students, but only include subjects where the number of enrolled students exceeds the average enrollment for that department in 2021. Do not return any rounded answers.\"}]}"
