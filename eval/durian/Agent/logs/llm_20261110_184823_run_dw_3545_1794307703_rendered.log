    {
      "role": "tool",
      "tool_call_id": "call_8f30fb4043b1409699acfa9f",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per department-year-activity-sponsor combination\", \"desc\": \"For each department, academic year, activity title, and sponsor name where the subject enrollment number is greater than 10 and the maximum enrollment for the activity is greater than 10, provide the department name, academic year, number of unique subjects, minimum total units offered, activity title, sponsor name, number of unique activities, minimum fee, and the sponsor type. Do not return any rounded answers.\", \"id\": \"dw_4515\", \"name\": \"Department Year Subject Statistics Matched with IAP Activity Sponsor Statistics\", \"sql\": \"WITH inner_cte AS ( WITH DeptSubjectStats AS ( SELECT c.DEPARTMENT_NAME, t.ACADEMIC_YEAR, COUNT(DISTINCT c.SUBJECT_ID) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS t ON c.TERM_CODE = t.TERM_CODE JOIN SUBJECT_SUMMARY s ON t.TERM_CODE = s.TERM_CODE AND c.SUBJECT_ID = s.SUBJECT_ID WHERE s.SUBJECT_ENROLLMENT_NUMBER > 10 GROUP BY c.DEPARTMENT_NAME, t.ACADEMIC_YEAR ), ActivitySponsorStats AS ( SELECT d.ACTIVITY_TITLE, s.SPONSOR_NAME, COUNT(DISTINCT d.IAP_SUBJECT_SESSION_KEY) AS activity_count, MIN(d.FEE) AS min_fee FROM IAP_SUBJECT_DETAIL d JOIN IAP_SUBJECT_SPONSOR s ON d.IAP_SUBJECT_SPONSOR_KEY = s.IAP_SUBJECT_SPONSOR_KEY WHERE d.MAX_ENROLLMENT > 10 GROUP BY d.ACTIVITY_TITLE, s.SPONSOR_NAME ), TermJoin AS ( SELECT t.ACADEMIC_YEAR, d.TERM_CODE, d.ACTIVITY_TITLE, s.SPONSOR_NAME FROM IAP_SUBJECT_DETAIL d JOIN ACADEMIC_TERMS t ON d.TERM_CODE = t.TERM_CODE JOIN IAP_SUBJECT_SPONSOR s ON d.IAP_SUBJECT_SPONSOR_KEY = s.IAP_SUBJECT_SPONSOR_KEY GROUP BY t.ACADEMIC_YEAR, d.TERM_CODE, d.ACTIVITY_TITLE, s.SPONSOR_NAME ) SELECT dss.DEPARTMENT_NAME, dss.ACADEMIC_YEAR, dss.subject_count, dss.min_total_units, ass.ACTIVITY_TITLE, ass.SPONSOR_NAME, ass.activity_count, ass.min_fee FROM DeptSubjectStats dss JOIN TermJoin tj ON dss.ACADEMIC_YEAR = tj.ACADEMIC_YEAR JOIN ActivitySponsorStats ass ON tj.ACTIVITY_TITLE = ass.ACTIVITY_TITLE AND tj.SPONSOR_NAME = ass.SPONSOR_NAME ORDER BY dss.DEPARTMENT_NAME, dss.ACADEMIC_YEAR, ass.ACTIVITY_TITLE, ass.SPONSOR_NAME ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.ACADEMIC_YEAR, inner_cte.subject_count, inner_cte.min_total_units, inner_cte.ACTIVITY_TITLE, inner_cte.SPONSOR_NAME, inner_cte.activity_count, inner_cte.min_fee, s.SPONSOR_TYPE FROM inner_cte JOIN IAP_SUBJECT_SPONSOR s ON inner_cte.SPONSOR_NAME = s.SPONSOR_NAME ORDER BY inner_cte.DEPARTMENT_NAME, inner_cte.ACADEMIC_YEAR, inner_cte.ACTIVITY_TITLE, inner_cte.SPONSOR_NAME;\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per department per course number\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\", \"id\": \"dw_4683\", \"name\": \"Current Term Department Enrollments with Library Course Counts and Min Units\", \"sql\": \"WITH inner_cte AS ( SELECT de.DEPARTMENT_NAME, de.total_enrollments, lss.COURSE_NUMBER, lss.subject_count, lss.min_total_units FROM ( SELECT s.DEPARTMENT_NAME, SUM(s.SUBJECT_ENROLLMENT_NUMBER) AS total_enrollments FROM ACADEMIC_TERM_PARAMETER p JOIN ACADEMIC_TERMS t ON p.TERM_CODE = t.TERM_CODE JOIN SUBJECT_SUMMARY s ON t.TERM_CODE = s.TERM_CODE WHERE p.IS_CURRENT_TERM = 'Y' GROUP BY s.DEPARTMENT_NAME HAVING SUM(s.SUBJECT_ENROLLMENT_NUMBER) > 10 ) de JOIN ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, COUNT(DISTINCT l.LIBRARY_SUBJECT_OFFERED_KEY) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 GROUP BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ) lss ON de.DEPARTMENT_NAME = lss.OFFER_DEPT_NAME ) SELECT ic.DEPARTMENT_NAME, ic.total_enrollments, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sos.RESPONSIBLE_FACULTY_NAME FROM inner_cte ic JOIN LIBRARY_SUBJECT_OFFERED lso ON ic.DEPARTMENT_NAME = lso.OFFER_DEPT_NAME AND ic.COURSE_NUMBER = lso.COURSE_NUMBER JOIN SUBJECT_OFFERED_SUMMARY sos ON lso.SUBJECT_ID = sos.SUBJECT_ID WHERE sos.NUM_ENROLLED_STUDENTS > 2 GROUP BY ic.DEPARTMENT_NAME, ic.total_enrollments, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sos.RESPONSIBLE_FACULTY_NAME;\"}, {\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per subject in term 2012SU\", \"desc\": \"For subjects offered in the term \\\"2012SU\\\", show the subject title, subject key, offer department name, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, subject ID, academic year, term description, and the minimum number of enrolled students in a window of 3 preceding and 1 following row, ordered by offer department name and academic year. Do not return any rounded answers.\", \"id\": \"dw_3632\", \"name\": \"2012SU Subject Enrollment Averages per Subject Key with Windowed Min Enrolled Students\", \"sql\": \"WITH Subquery1 AS ( SELECT t0.SUBJECT_TITLE, t0.SUBJECT_KEY, t0.OFFER_DEPT_NAME, t0.SUBJECT_ENROLLMENT_NUMBER, t0.SUBJECT_OFFERED_SUMMARY_KEY, AVG(t0.SUBJECT_ENROLLMENT_NUMBER) OVER (PARTITION BY t0.SUBJECT_KEY ORDER BY t0.OFFER_DEPT_NAME) AS window_column FROM SUBJECT_OFFERED t0 JOIN SUBJECT_OFFERED_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2012SU' ), Subquery2 AS ( SELECT t1.SUBJECT_TITLE, t1.SUBJECT_ID, t1.OFFER_DEPT_NAME, t0.ACADEMIC_YEAR, t0.TERM_DESCRIPTION, MIN(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t0.ACADEMIC_YEAR ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM ACADEMIC_TERMS t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_CODE = '2012SU' ) SELECT s1.SUBJECT_TITLE, s1.SUBJECT_KEY, s1.OFFER_DEPT_NAME, s1.SUBJECT_ENROLLMENT_NUMBER, s1.SUBJECT_OFFERED_SUMMARY_KEY, s1.window_column AS avg_subject_enrollment_number, s2.SUBJECT_ID, s2.ACADEMIC_YEAR, s2.TERM_DESCRIPTION, s2.window_column AS min_num_enrolled_students_window FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.SUBJECT_TITLE = s2.SUBJECT_TITLE AND s1.OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME ORDER BY s1.OFFER_DEPT_NAME, s2.ACADEMIC_YEAR\"}], \"not_found\": []}"
