      "tool_call_id": "call_2faf5cb6679e48f18ec5daa4",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entity\": {\"category\": \"Subject Offering Analysis\", \"default_granularity\": \"one row per 2012SU 1-unit subject matched with its cluster-S offering row\", \"desc\": \"For subjects offered in the 2012SU term that have a total of 1 unit and also have a cluster type of 'S', show the subject title from the summary, the course number from the offered table, the subject title from the offered summary, the department name from the summary, the offer department name from the offered summary, the row number within each department name group ordered by subject title from the summary, the subject title from SUBJECT_OFFERED, the offer department name from SUBJECT_OFFERED, the total units from SUBJECT_SUMMARY, and the row number within a window of 2 preceding and 1 following rows ordered by the subject title from SUBJECT_OFFERED. Do not return any rounded answers.\", \"id\": \"dw_3482\", \"name\": \"2012SU 1-Unit Cluster-S Subjects Department Row Numbers with Windowed Subject Title Row Numbers\", \"sql\": \"WITH Subq1 AS ( SELECT t2.SUBJECT_TITLE AS summary_subject_title, t1.COURSE_NUMBER, t0.SUBJECT_TITLE AS offered_summary_subject_title, t2.DEPARTMENT_NAME, t0.OFFER_DEPT_NAME, ROW_NUMBER() OVER (PARTITION BY t2.DEPARTMENT_NAME ORDER BY t2.SUBJECT_TITLE) AS window_column, t1.SUBJECT_ID FROM SUBJECT_OFFERED_SUMMARY t0 JOIN SUBJECT_OFFERED t1 ON t0.SUBJECT_ID_SORT = t1.SUBJECT_ID_SORT JOIN SUBJECT_SUMMARY t2 ON t1.SUBJECT_ID_SORT = t2.SUBJECT_ID_SORT WHERE t1.TERM_CODE = '2012SU' AND t2.TOTAL_UNITS = 1 ), Subq2 AS ( SELECT t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TOTAL_UNITS, ROW_NUMBER() OVER (ORDER BY t0.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t0.SUBJECT_ID FROM SUBJECT_OFFERED t0 JOIN SUBJECT_SUMMARY t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.TERM_CODE = '2012SU' AND t1.CLUSTER_TYPE = 'S' ) SELECT s1.summary_subject_title, s1.COURSE_NUMBER, s1.offered_summary_subject_title, s1.DEPARTMENT_NAME, s1.OFFER_DEPT_NAME, s1.window_column AS summary_window_column, s2.SUBJECT_TITLE AS offered_subject_title, s2.OFFER_DEPT_NAME AS offered_offer_dept_name, s2.TOTAL_UNITS AS offered_total_units, s2.window_column AS offered_window_column FROM Subq1 s1 JOIN Subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID\"}}"
