          "function": {
            "name": "semantic_get",
            "arguments": "{\"entity_ids\": \n[\"dw_2528\", \"SPACE_DETAIL\", \"SPACE_FLOOR\", \"SPACE_UNIT\", \"BUILDINGS\", \"FCLT_BUILDING\", \"concept_room_space_inventory\", \"concept_floor_inventory\", \"column_concept_building_room\"]\n\n}"
          }
