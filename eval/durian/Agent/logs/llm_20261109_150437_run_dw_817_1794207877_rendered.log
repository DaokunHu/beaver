    {
      "role": "tool",
      "tool_call_id": "call_f001d3b0406f4c4e8db455fa",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_2528\", \"name\": \"Stata Building Per-Floor Largest Room with Room-Level Square Footage and Floor Average\", \"desc\": \"For each floor in the Stata building (building 32), what is the largest room square footage and the name of the building room with that largest square footage for rooms loaded into the warehouse on 19-DEC-24 with a largest room square footage greater than 100, and for each space unit on that floor with a room square footage greater than 10, what are the building room name, room number, room square footage, the average room square footage within the floor, and the floor's warehouse load date? List the results showing floor name, largest room name, largest room square footage, building room name, room number, room square footage, average room square footage per floor, and floor warehouse load date, ordered by floor name and room square footage. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH largest_room_per_floor AS ( SELECT sf.FLOOR_NAME, sd.BUILDING_ROOM_NAME, sd.ROOM_SQUARE_FOOTAGE, sd.FLOOR_KEY FROM SPACE_DETAIL sd JOIN SPACE_FLOOR sf ON sd.FLOOR_KEY = sf.FLOOR_KEY WHERE sd.BUILDING_KEY = 32 AND sd.WAREHOUSE_LOAD_DATE = '19-DEC-24' AND sd.ROOM_SQUARE_FOOTAGE > 100 AND sd.ROOM_SQUARE_FOOTAGE = ( SELECT MAX(sd2.ROOM_SQUARE_FOOTAGE) FROM SPACE_DETAIL sd2 WHERE sd2.BUILDING_KEY = 32 AND sd2.FLOOR_KEY = sd.FLOOR_KEY AND sd2.WAREHOUSE_LOAD_DATE = '19-DEC-24' ) ORDER BY sf.FLOOR_NAME ), room_and_avg_per_floor AS ( SELECT sd.BUILDING_ROOM_NAME, sd.ROOM_NUMBER, sd.ROOM_SQUARE_FOOTAGE, sf.FLOOR_NAME, AVG(sd2.ROOM_SQUARE_FOOTAGE) AS AVG_ROOM_SQUARE_FOOTAGE_PER_FLOOR, sd.FLOOR_KEY FROM SPACE_DETAIL sd JOIN SPACE_FLOOR sf ON sd.FLOOR_KEY = sf.FLOOR_KEY JOIN SPACE_DETAIL sd2 ON sd2.FLOOR_KEY = sd.FLOOR_KEY WHERE sd.BUILDING_KEY = 32 AND sd.ROOM_SQUARE_FOOTAGE > 10 GROUP BY sd.BUILDING_ROOM_NAME, sd.ROOM_NUMBER, sd.ROOM_SQUARE_FOOTAGE, sf.FLOOR_NAME, sd.FLOOR_KEY ORDER BY sd.ROOM_SQUARE_FOOTAGE ) SELECT lrf.FLOOR_NAME, lrf.BUILDING_ROOM_NAME AS LARGEST_ROOM_NAME, lrf.ROOM_SQUARE_FOOTAGE AS LARGEST_ROOM_SQUARE_FOOTAGE, raf.BUILDING_ROOM_NAME, raf.ROOM_NUMBER, raf.ROOM_SQUARE_FOOTAGE, raf.AVG_ROOM_SQUARE_FOOTAGE_PER_FLOOR, sf.WAREHOUSE_LOAD_DATE AS FLOOR_WAREHOUSE_LOAD_DATE FROM largest_room_per_floor lrf JOIN room_and_avg_per_floor raf ON lrf.FLOOR_NAME = raf.FLOOR_NAME JOIN SPACE_FLOOR sf ON lrf.FLOOR_NAME = sf.FLOOR_NAME ORDER BY lrf.FLOOR_NAME, raf.ROOM_SQUARE_FOOTAGE ) SELECT * FROM inner_cte;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per room (square footage > 10) matched to its floor's largest room (square footage > 100, loaded 19-DEC-24) in building 32\"}, {\"id\": \"SPACE_DETAIL\", \"name\": \"SPACE_DETAIL\", \"desc\": \"Space assignment detail fact table: one row per physical room assigned to a space unit, with building/floor/space-unit/space-usage keys, room identifiers (building-room number and name, room number), room square footage, room counter, and building component. Used to count rooms per space unit or per building, and to analyze room size and usage distribution. Joins to SPACE_UNIT via SPACE_UNIT_KEY, FCLT_BUILDING via BUILDING_KEY, SPACE_FLOOR via FLOOR_KEY, and SPACE_USAGE via SPACE_USAGE_KEY.\", \"columns\": {\"BUILDING_KEY\": {\"desc\": \"Foreign key to FCLT_BUILDING.FCLT_BUILDING_KEY; the building containing the room; used to find the building with the most rooms within a space unit\"}, \"FLOOR_KEY\": {\"desc\": \"Foreign key to SPACE_FLOOR.FLOOR_KEY; the floor the room is on\"}, \"SPACE_UNIT_KEY\": {\"desc\": \"Foreign key to SPACE_UNIT.SPACE_UNIT_KEY; the space unit the room is assigned to\"}, \"SPACE_USAGE_KEY\": {\"desc\": \"Foreign key to SPACE_USAGE.SPACE_USAGE_KEY; the usage classification of the room (e.g. classroom, office, lab)\"}, \"BUILDING_ROOM\": {\"desc\": \"Combined building-room identifier, e.g. '1-080'; counting rows of this column gives the number of rooms per space unit/building\"}, \"BUILDING_ROOM_NAME\": {\"desc\": \"Room name (usually identical to BUILDING_ROOM)\"}, \"ROOM_NUMBER\": {\"desc\": \"Room number within the building, e.g. '80', '82F'\"}, \"ROOM_SQUARE_FOOTAGE\": {\"desc\": \"Room area in square feet (note: FCLT_ROOMS.AREA is in square meters)\"}, \"ROOM_COUNTER\": {\"desc\": \"Room count indicator; equals 1 for every room row, so SUM(ROOM_COUNTER) also yields room counts\"}, \"BUILDING_COMPONENT\": {\"desc\": \"Building component identifier the room belongs to\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per room assigned to a space unit\", \"entity\": {\"columns\": {\"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the room assignment record, stored as DD-MON-YY text (e.g. '19-DEC-24'); all current rows carry '19-DEC-24'. This is the room-side load date used to filter which room snapshot to analyze; it is distinct from SPACE_FLOOR.WAREHOUSE_LOAD_DATE (the floor lookup record's load date), which is the column to report when a question asks for the floor's warehouse load date.\"}}}, \"reason\": \"Case dw_2528 filters rooms on SPACE_DETAIL.WAREHOUSE_LOAD_DATE='19-DEC-24' while reporting the floor's warehouse load date from SPACE_FLOOR; the two same-named columns are confusing and their difference (room snapshot load date vs floor lookup load date, DD-MON-YY text format) must be documented per column description rules.\"}, {\"id\": \"SPACE_FLOOR\", \"name\": \"SPACE_FLOOR\", \"desc\": \"Space-domain floor lookup table: one row per floor key with the floor number/label and floor name. Referenced by SPACE_DETAIL via FLOOR_KEY to attach floor identity to assigned rooms; a lightweight floor reference without the area measures carried by FCLT_FLOOR or FAC_FLOOR.\", \"columns\": {\"FLOOR_KEY\": {\"desc\": \"Surrogate key of the floor; joins to SPACE_DETAIL.FLOOR_KEY\"}, \"FLOOR\": {\"desc\": \"Floor number/label within the building\"}, \"FLOOR_NAME\": {\"desc\": \"Display name of the floor\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per floor key\", \"entity\": {\"columns\": {\"FLOOR_NAME\": {\"desc\": \"Display name of the floor; unique across floor keys in current data (49 distinct names for 49 rows), so it is safe as a join/group key when combining per-floor derived results (e.g. matching each floor's largest room back to floor-level attributes).\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the floor lookup record, stored as DD-MON-YY text (e.g. '19-DEC-24'); all current rows carry '19-DEC-24'. This is the column to report when a question asks for the floor's warehouse load date; it is distinct from SPACE_DETAIL.WAREHOUSE_LOAD_DATE, which is the room-side load date used to filter room assignment snapshots.\"}}}, \"reason\": \"Case dw_2528 reports SPACE_FLOOR.WAREHOUSE_LOAD_DATE as the floor's warehouse load date and joins derived per-floor results on FLOOR_NAME; documenting the load-date column distinction from SPACE_DETAIL and the verified uniqueness of FLOOR_NAME prevents wrong-column selection and unfounded fan-out concerns.\"}, {\"id\": \"SPACE_UNIT\", \"name\": \"SPACE_UNIT\", \"desc\": \"Space unit dimension table: one row per space unit (an organizational space-assignment unit such as a department, program, or office that receives space allocation), with space unit key/code, space unit name, the facilities organization it belongs to, and DLC key. Bridges FCLT_ORGANIZATION (organization attribution) and SPACE_DETAIL (rooms assigned to the space unit); used to group room counts and space statistics by space unit.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Foreign key to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY; the organization that owns/occupies this space unit\"}, \"SPACE_UNIT_KEY\": {\"desc\": \"Surrogate key of the space unit; joins to SPACE_DETAIL.SPACE_UNIT_KEY and SPACE_UNIT2.SPACE_UNIT_KEY; used for partitioning/ordering in space analyses\"}, \"SPACE_UNIT_CODE\": {\"desc\": \"Business code of the space unit (same numeric value as the key in current data)\"}, \"SPACE_UNIT\": {\"desc\": \"Name of the space unit, e.g. 'Physics', 'Technology & Policy Program'\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_PHYSICS'; may contain composite values like 'D_DSL:HQ'\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per space unit\"}, {\"id\": \"BUILDINGS\", \"name\": \"BUILDINGS\", \"desc\": \"Space-domain building lookup table: one row per building with building key/number, building name, street and mailing addresses as single text fields, gross and assignable square footage (in square feet), and a building counter. Referenced by SPACE_DETAIL via BUILDING_KEY; a lightweight building reference for space-assignment reporting, without the type/ownership/site classification carried by FCLT_BUILDING or FAC_BUILDING.\", \"columns\": {\"BUILDING_KEY\": {\"desc\": \"Building key (same value as BUILDING_NUMBER, e.g. 'NW32'); joins to SPACE_DETAIL.BUILDING_KEY and matches FCLT_BUILDING.FCLT_BUILDING_KEY value domain\"}, \"BUILDING_NUMBER\": {\"desc\": \"Building number/code, e.g. 'NW35'\"}, \"BUILDING_NAME\": {\"desc\": \"Building name, e.g. 'Ashdown House'; may be a generic 'BUILDING <number>' placeholder\"}, \"BUILDING_STREET_ADDRESS\": {\"desc\": \"Full street address as a single text field, e.g. '235 ALBANY ST'\"}, \"BUILDING_MAILING_ADDRESS\": {\"desc\": \"Mailing address as a single text field; often null\"}, \"BLDG_GROSS_SQUARE_FOOTAGE\": {\"desc\": \"Gross square footage of the building in square feet (note: FCLT_BUILDING.EXT_GROSS_AREA is in square meters)\"}, \"BLDG_ASSIGNABLE_SQUARE_FOOTAGE\": {\"desc\": \"Assignable square footage of the building in square feet\"}, \"BUILDING_COUNTER\": {\"desc\": \"Record counter; equals 1 for every building row\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per building\"}, {\"id\": \"FCLT_BUILDING\", \"name\": \"FCLT_BUILDING\", \"desc\": \"Facilities building inventory table: one row per physical building with building number/name, type (e.g. ACADEMIC), ownership, use, occupancy class, gross/assignable/non-assignable areas, number of rooms, key dates (built/acquired/occupied), site and geographic coordinates. Parent of FCLT_ROOMS via FCLT_BUILDING_KEY.\", \"columns\": {\"FCLT_BUILDING_KEY\": {\"desc\": \"Surrogate key of the building; joins to FCLT_ROOMS.FCLT_BUILDING_KEY\"}, \"BUILDING_NUMBER\": {\"desc\": \"Building number/code, e.g. '32', 'E38'; same value as FCLT_BUILDING_KEY in current data; can be matched to FCLT_BUILDING_ADDRESS.BUILDING_NUMBER\"}, \"PARENT_BUILDING_NUMBER\": {\"desc\": \"Parent building number\"}, \"PARENT_BUILDING_NAME\": {\"desc\": \"Parent building name\"}, \"PARENT_BUILDING_NAME_LONG\": {\"desc\": \"Long parent building name\"}, \"BUILDING_NAME_LONG\": {\"desc\": \"Long building name, e.g. 'Stanley Gordon Brown Building'; fuller naming variant of BUILDING_NAME\"}, \"EXT_GROSS_AREA\": {\"desc\": \"Extended gross area of the building in square meters\"}, \"ASSIGNABLE_AREA\": {\"desc\": \"Total assignable area of the building in square meters\"}, \"NON_ASSIGNABLE_AREA\": {\"desc\": \"Non-assignable area of the building in square meters\"}, \"SITE\": {\"desc\": \"Site/campus the building belongs to, e.g. 'MIT', 'BATES', 'LINC', 'BOS'; 'MIT' filters buildings on the MIT campus\"}, \"CAMPUS_SECTOR\": {\"desc\": \"Campus sector the building is in, e.g. 'MAIN GROUP', 'EAST', 'NORTHWEST', 'WEST', 'OFFCAMPUS'\"}, \"ACCESS_LEVEL_CODE\": {\"desc\": \"Numeric access level code of the building (observed values 0-2); distinct from FCLT_ROOMS.ACCESS_LEVEL (per-room) and FCLT_FLOOR.ACCESS_LEVEL (per-floor)\"}, \"ACCESS_LEVEL_NAME\": {\"desc\": \"Access level name of the building (same numeric value as ACCESS_LEVEL_CODE in current data)\"}, \"BUILDING_TYPE\": {\"desc\": \"Building type classification: 'ACADEMIC' (academic buildings), 'SERVICE', or 'RESIDENT' (residential buildings); used to filter academic/residential buildings\"}, \"OWNERSHIP_TYPE\": {\"desc\": \"Ownership type: 'OWNED' or 'LEASED'\"}, \"BUILDING_USE\": {\"desc\": \"Primary use code of the building, e.g. 'AER', 'DHOA', 'STAC', 'GAR', 'OTH'; may be null\"}, \"OCCUPANCY_CLASS\": {\"desc\": \"Occupancy classification code of the building (e.g. 'UGB', 'UGA3', 'UGR2'); coded combinations of use/grade/occupancy attributes\"}, \"BUILDING_HEIGHT\": {\"desc\": \"Height of the building (numeric, in feet); used in height filters and averages\"}, \"COST_CENTER_CODE\": {\"desc\": \"Cost center code of the building, e.g. '1810200'; alternative join key to FCLT_BUILDING_HIST.COST_CENTER_CODE; null for some buildings\"}, \"COST_COLLECTOR_KEY\": {\"desc\": \"Cost collector key of the building (same value as COST_CENTER_CODE in current data); alternative join key to FCLT_BUILDING_HIST.COST_COLLECTOR_KEY used to count historical records per building\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS)\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS)\"}, \"EASTING_X_SPCS\": {\"desc\": \"Easting coordinate (SPCS)\"}, \"NORTHING_Y_SPCS\": {\"desc\": \"Northing coordinate (SPCS)\"}, \"BUILDING_SORT\": {\"desc\": \"Sortable building name\"}, \"BUILDING_NAMED_FOR\": {\"desc\": \"Person the building is named for\"}, \"BUILDING_NAME\": {\"desc\": \"Building name, e.g. 'Ray and Maria Stata Center', 'BROWN BUILDING'; used for building-level grouping and name filters (values are uppercase for some buildings)\"}, \"DATE_BUILT\": {\"desc\": \"Date the building was built, stored in MM/DD/YYYY format (FCLT_BUILDING_HIST_1 variant uses DD-MON-YY); the year built is derived from this column\"}, \"DATE_ACQUIRED\": {\"desc\": \"Date the building was acquired, MM/DD/YYYY format; often null\"}, \"DATE_OCCUPIED\": {\"desc\": \"Date the building was first occupied, MM/DD/YYYY format\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_OF_ROOMS\": {\"desc\": \"Current number of rooms in the building; distinct from FCLT_BUILDING_HIST.NUM_OF_ROOMS which is the per-fiscal-period historical value\"}}, \"default_granularity\": \"one row per building\"}, {\"id\": \"concept_room_space_inventory\", \"name\": \"Room and Space Inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\", \"tables\": [\"SPACE_DETAIL\", \"FCLT_ROOMS\", \"FAC_ROOMS\", \"ZPM_ROOMS_LOAD\"], \"comparisons\": [{\"dimension\": \"Business perspective\", \"differences\": \"SPACE_DETAIL records rooms from the space-assignment perspective (which space unit each room is allocated to, with SPACE_USAGE_KEY usage code); FCLT_ROOMS and FAC_ROOMS record rooms from the facilities inventory perspective (major/minor use descriptions, primary and minor organization occupancy); ZPM_ROOMS_LOAD records rooms from the space-planning load perspective (space usage text, floor, access level, occupying HR org unit).\"}, {\"dimension\": \"Key family and join paths\", \"differences\": \"SPACE_DETAIL joins SPACE_UNIT/SPACE_FLOOR/SPACE_USAGE and FCLT_BUILDING via BUILDING_KEY; FCLT_ROOMS joins FCLT_BUILDING via FCLT_BUILDING_KEY and FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, and is referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE; FAC_ROOMS joins the FAC_* family (FAC_BUILDING, FAC_FLOOR, FAC_ORGANIZATION); ZPM_ROOMS_LOAD joins SPACE_UNIT via SPACE_UNIT_CODE and FCLT_ORGANIZATION/HR_ORG_UNIT via HR_ORG_UNIT_ID (no building/floor keys).\"}, {\"dimension\": \"Area measure and units\", \"differences\": \"SPACE_DETAIL.ROOM_SQUARE_FOOTAGE is in square feet; FCLT_ROOMS.AREA and FAC_ROOMS.AREA are in square meters; ZPM_ROOMS_LOAD carries no area measure at all. Unit choice matters for size thresholds and averages.\"}, {\"dimension\": \"Room counting semantics\", \"differences\": \"SPACE_DETAIL supports counting rooms per space unit or per building via BUILDING_ROOM rows (and ROOM_COUNTER=1 per row); FCLT_BUILDING also carries a precomputed NUM_OF_ROOMS attribute per building, while FCLT_ROOMS/FAC_ROOMS/ZPM_ROOMS_LOAD require COUNT over room rows.\"}, {\"dimension\": \"Usage classification detail\", \"differences\": \"SPACE_DETAIL uses a coded SPACE_USAGE_KEY decoded by SPACE_USAGE; FCLT_ROOMS/FAC_ROOMS carry denormalized MAJOR_USE_DESC/USE_DESC/MINOR_USE_DESC text classifications plus ACCESS_LEVEL and coordinates; ZPM_ROOMS_LOAD carries a free-text SPACE_USAGE (e.g. 'DSGN STUDIO', 'CONF RM') plus ACCESS_LEVEL and a text FLOOR that can hold labels such as 'G9'.\"}], \"decision_guide\": {\"Counting rooms per space unit or finding the building with the most rooms in a space unit\": \"Use SPACE_DETAIL: it is the only table keyed by SPACE_UNIT_KEY, so room counts can be grouped by space unit and by BUILDING_KEY directly.\", \"Room area statistics in square meters, use-classification filters (e.g. classrooms), or linking class meeting places to rooms\": \"Use FCLT_ROOMS: it carries AREA in square meters, denormalized use descriptions, and FCLT_ROOM_KEY referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE.\", \"Room analysis that must stay inside the FAC_* key family (FAC_BUILDING/FAC_FLOOR/FAC_ORGANIZATION)\": \"Use FAC_ROOMS: it mirrors FCLT_ROOMS structure but joins FAC_* family tables via FAC_ROOM_KEY/BUILDING_KEY/ORGANIZATION_KEY.\", \"Room occupancy by organization hierarchy (level, parent organization)\": \"Use FCLT_ROOMS joined to FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, SPACE_DETAIL joined via SPACE_UNIT to SPACE_UNIT.FCLT_ORGANIZATION_KEY when the space-assignment view is required, or ZPM_ROOMS_LOAD joined to FCLT_ORGANIZATION via HR_ORG_UNIT_ID for the space-planning view.\", \"Room analysis by floor, space usage text, or access level linked to space units or HR org units (no area needed)\": \"Use ZPM_ROOMS_LOAD: it links rooms to SPACE_UNIT via SPACE_UNIT_CODE and to organizations/HR units via HR_ORG_UNIT_ID.\"}}, {\"id\": \"concept_floor_inventory\", \"name\": \"Floor Inventory\", \"desc\": \"Tables recording the floor level of buildings: the current FCLT_* family floor inventory with floor areas, the FAC_* family floor snapshot with the same structure, the fiscal-period historical floor table, and the lightweight space-domain floor lookup. They jointly answer questions about floor numbers and per-floor assignable/non-assignable areas, but differ in time coverage, table family, and attribute richness.\", \"tables\": [\"FCLT_FLOOR\", \"FCLT_FLOOR_HIST\", \"FAC_FLOOR\", \"SPACE_FLOOR\"], \"comparisons\": [{\"dimension\": \"Time coverage\", \"differences\": \"FCLT_FLOOR, FAC_FLOOR, and SPACE_FLOOR are current snapshots; FCLT_FLOOR_HIST carries one row per floor per fiscal period (201505-201602), enabling historical floor-area comparison.\"}, {\"dimension\": \"Table family and join paths\", \"differences\": \"FCLT_FLOOR joins FCLT_BUILDING via FCLT_BUILDING_KEY and FCLT_ROOMS via FCLT_FLOOR_KEY; FAC_FLOOR joins FAC_BUILDING via BUILDING_KEY and FAC_ROOMS via FLOOR_KEY; SPACE_FLOOR joins SPACE_DETAIL via FLOOR_KEY; FCLT_FLOOR_HIST joins both FCLT_BUILDING (FCLT_BUILDING_KEY) and FCLT_FLOOR (FCLT_FLOOR_KEY).\"}, {\"dimension\": \"Attribute richness\", \"differences\": \"FCLT_FLOOR, FCLT_FLOOR_HIST, and FAC_FLOOR carry floor area measures (EXT_GROSS_AREA, ASSIGNABLE_AREA, NON_ASSIGNABLE_AREA in square meters), sort sequence, level, wing, and access level; SPACE_FLOOR only carries floor key, floor label, and floor name without any area measures.\"}, {\"dimension\": \"Floor identification\", \"differences\": \"FCLT_FLOOR.FCLT_FLOOR_KEY is formatted '<building key>-<floor>' (e.g. '14-4'); FCLT_ROOMS can match floors either via FCLT_FLOOR_KEY or via the composite (FCLT_BUILDING_KEY, FLOOR) pair; SPACE_FLOOR uses an independent FLOOR_KEY value domain tied to SPACE_DETAIL.\"}], \"decision_guide\": {\"Per-floor area aggregation (assignable/non-assignable totals, dispersion across floors) or floor-number filtering in the facilities domain\": \"Use FCLT_FLOOR joined to FCLT_BUILDING via FCLT_BUILDING_KEY; it carries square-meter floor areas and floor labels.\", \"Historical per-fiscal-period floor areas\": \"Use FCLT_FLOOR_HIST: the only floor table with a FISCAL_PERIOD time dimension.\", \"Floor analysis inside the FAC_* key family\": \"Use FAC_FLOOR: mirrors FCLT_FLOOR structure but joins FAC_BUILDING/FAC_ROOMS via BUILDING_KEY/FLOOR_KEY.\", \"Floor name/label for space-assignment reporting\": \"Use SPACE_FLOOR: the lightweight lookup referenced by SPACE_DETAIL; it has no area measures, so area questions must go to FCLT_FLOOR or FAC_FLOOR.\"}}, {\"columns\": [\"SPACE_DETAIL.BUILDING_ROOM\", \"FCLT_ROOMS.BUILDING_ROOM\", \"ZPM_ROOMS_LOAD.BUILDING_ROOM\"], \"comparisons\": [{\"dimension\": \"Table perspective\", \"differences\": \"In SPACE_DETAIL it identifies a room within a space-unit assignment row (counting rows gives rooms per space unit/building); in FCLT_ROOMS it identifies a room within the facilities inventory with use classifications and organization occupancy; in ZPM_ROOMS_LOAD it identifies a room within the space-planning load feed with floor, space usage text, and access level.\"}, {\"dimension\": \"Coverage\", \"differences\": \"FCLT_ROOMS has more distinct building-room values (9,872) than SPACE_DETAIL (9,332); only about 2,666 values match textually between the two tables, so cross-table room matching on BUILDING_ROOM is unreliable. ZPM_ROOMS_LOAD holds 10,000 room rows from the space-planning feed.\"}, {\"dimension\": \"Companion columns\", \"differences\": \"SPACE_DETAIL pairs it with ROOM_NUMBER, ROOM_SQUARE_FOOTAGE (sq ft), ROOM_COUNTER; FCLT_ROOMS pairs it with ROOM, ROOM_FULL_NAME, AREA (sq m), use descriptions; ZPM_ROOMS_LOAD pairs it with BUILDING_COMPONENT, FLOOR (text, can be labels like 'G9'), SPACE_USAGE, ACCESS_LEVEL.\"}], \"decision_guide\": {\"Counting rooms per space unit or per building\": \"Use SPACE_DETAIL.BUILDING_ROOM with COUNT, grouped by SPACE_UNIT_KEY/BUILDING_KEY.\", \"Room-level analysis with usage classification or square-meter area\": \"Use FCLT_ROOMS.BUILDING_ROOM alongside MAJOR_USE_DESC/AREA.\", \"Matching the same physical room across space assignment and facilities inventory\": \"Do not rely on BUILDING_ROOM text equality alone (low overlap); prefer key-based joins within each table family.\", \"Room-level analysis by floor, space usage text, or access level with space unit / HR org unit linkage\": \"Use ZPM_ROOMS_LOAD.BUILDING_ROOM alongside FLOOR/SPACE_USAGE/ACCESS_LEVEL.\"}, \"desc\": \"Combined building-room identifier columns (e.g. '1-080') appearing in both the space assignment fact table and the facilities room inventory. They identify the same physical room concept but come from different business processes with different coverage and companion measures.\", \"id\": \"column_concept_building_room\", \"name\": \"Building Room Identifier\"}], \"not_found\": []}"
    },
