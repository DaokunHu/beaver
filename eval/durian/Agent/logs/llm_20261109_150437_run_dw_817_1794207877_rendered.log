      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_2616\", \"name\": \"Large Rooms Above-Average Total Room Counter per Building Room with Floor Count and Space Usage\", \"desc\": \"For each space unit with a room square footage greater than 100, what is the building room, building room name, space usage, the number of distinct floors it appears on, and the total room counter, but only include those where the total room counter is greater than the average room counter across all space units with room square footage greater than 100? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT sd.BUILDING_ROOM, sd.BUILDING_ROOM_NAME, su.SPACE_USAGE, COUNT(DISTINCT sd.FLOOR_KEY) AS floor_count, SUM(sd.ROOM_COUNTER) AS total_room_counter FROM SPACE_DETAIL sd JOIN SPACE_USAGE su ON sd.SPACE_USAGE_KEY = su.SPACE_USAGE_KEY WHERE sd.ROOM_SQUARE_FOOTAGE > 100 GROUP BY sd.BUILDING_ROOM, sd.BUILDING_ROOM_NAME, su.SPACE_USAGE ) SELECT BUILDING_ROOM, BUILDING_ROOM_NAME, SPACE_USAGE, floor_count, total_room_counter FROM inner_cte WHERE total_room_counter > ( SELECT AVG(total_room_counter) FROM ( SELECT SUM(sd.ROOM_COUNTER) AS total_room_counter FROM SPACE_DETAIL sd WHERE sd.ROOM_SQUARE_FOOTAGE > 100 GROUP BY sd.BUILDING_ROOM, sd.BUILDING_ROOM_NAME, sd.SPACE_USAGE_KEY ) sub )\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per building room and space usage with room square footage > 100 and above-average total room counter\"}, {\"id\": \"dw_2780\", \"name\": \"Room 21E Windowed Minimum Square Footage with Dual Warehouse Load Dates\", \"desc\": \"For rooms with a room number of '21E', show the building room, room square footage, building component, space usage, and the minimum room square footage in a window of 3 preceding and 1 following row ordered by building key. Also, include the warehouse load date from both the SPACE_DETAIL and SPACE_USAGE tables. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT t0.BUILDING_ROOM, t0.ROOM_SQUARE_FOOTAGE, t0.BUILDING_COMPONENT, t1.SPACE_USAGE, MIN(t0.ROOM_SQUARE_FOOTAGE) OVER (ORDER BY t0.BUILDING_KEY ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t0.WAREHOUSE_LOAD_DATE AS space_detail_load_date, t1.WAREHOUSE_LOAD_DATE AS space_usage_load_date FROM SPACE_DETAIL t0 JOIN SPACE_USAGE t1 ON t0.SPACE_USAGE_KEY = t1.SPACE_USAGE_KEY WHERE t0.ROOM_NUMBER = '21E' ) SELECT * FROM inner_cte;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per room with room number '21E'\"}, {\"id\": \"dw_385\", \"name\": \"Stata Building Non-Storage Rooms Above Floor Average Area with Windowed Moving Average by Floor Sort Sequence\", \"desc\": \"For rooms in the Stata building (building 32) in buildings with an access level of 2, show the room key, building key, floor, major use description, area, and the average area over a window of 2 preceding and 2 following rows grouped by the floor's sort sequence and ordered by the room's area, but only include rooms whose area is greater than the average area for their floor. Exclude rooms whose major use description includes 'STORAGE'. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT fr.FCLT_ROOM_KEY, fr.FCLT_BUILDING_KEY, fr.FLOOR, fr.MAJOR_USE_DESC, fr.AREA, ff.FLOOR_SORT_SEQUENCE FROM FCLT_ROOMS fr JOIN FCLT_FLOOR ff ON fr.FCLT_BUILDING_KEY = ff.FCLT_BUILDING_KEY AND fr.FLOOR = ff.FLOOR WHERE fr.FCLT_BUILDING_KEY = '32' AND ff.ACCESS_LEVEL = 2 AND fr.MAJOR_USE_DESC NOT LIKE '%STORAGE%' ) SELECT i.FCLT_ROOM_KEY, i.FCLT_BUILDING_KEY, i.FLOOR, i.MAJOR_USE_DESC, i.AREA, AVG(i.AREA) OVER ( PARTITION BY i.FLOOR_SORT_SEQUENCE ORDER BY i.AREA ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING ) AS avg_area_window FROM inner_cte i JOIN ( SELECT FLOOR_SORT_SEQUENCE, AVG(AREA) AS avg_floor_area FROM inner_cte GROUP BY FLOOR_SORT_SEQUENCE ) favg ON i.FLOOR_SORT_SEQUENCE = favg.FLOOR_SORT_SEQUENCE WHERE i.AREA > favg.avg_floor_area ORDER BY i.FLOOR_SORT_SEQUENCE, i.AREA;\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per non-storage room in the selected building whose area exceeds its floor's average area\"}], \"not_found\": []}"
