            "name": "mysql_query",
            "arguments": "{\"sql\": \"SELECT sd.DEPARTMENT_NAME, sd.DEPARTMENT_CODE, AVG(ccc.TOTAL_UNITS) AS avg_tu, MAX(ccc.TOTAL_UNITS)-MIN(ccc.TOTAL_UNITS) AS rng, VARIANCE(ccc.TOTAL_UNITS) AS var_tu FROM SIS_DEPARTMENT sd JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING='Y' AND ccc.ACADEMIC_YEAR=2008 AND sd.DEPARTMENT_CODE <> '5' GROUP BY sd.DEPARTMENT_NAME, sd.DEPARTMENT_CODE ORDER BY avg_tu DESC LIMIT 5\"}"
          }
        }
