    {
      "role": "tool",
      "tool_call_id": "call_37877491bf5446d89661f8e7",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level where the course is degree granting, the total units are greater than 6, and the department is Mathematics (Course 18), provide the department name, course level, number of unique courses, minimum total units offered, school name, number of distinct course options available, and the highest average number of enrolled students in any term for courses offered by that department, considering only courses with more than 0 enrolled students and departments whose name is not null. Do not return any rounded answers.\", \"id\": \"dw_1766\", \"name\": \"Math Degree-Granting Course Level Counts with Min Units, Course Options, and Highest Term Average Library Enrollment\", \"sql\": \"WITH highest_avg_enrollment AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, l.TERM_CODE, AVG(l.NUM_ENROLLED_STUDENTS) AS avg_enrollment_per_term FROM SIS_SUBJECT_CODE s JOIN LIBRARY_SUBJECT_OFFERED l ON s.COURSE_NUMBER = l.COURSE_NUMBER WHERE l.NUM_ENROLLED_STUDENTS > 0 AND s.DEPARTMENT_NAME IS NOT NULL AND s.DEPARTMENT_NAME = 'Mathematics' GROUP BY s.DEPARTMENT_NAME, l.TERM_CODE ) SELECT DEPARTMENT_NAME, MAX(avg_enrollment_per_term) AS highest_avg_enrollment_per_term FROM inner_cte GROUP BY DEPARTMENT_NAME ), course_stats AS ( WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT scd.COURSE) AS course_count, MIN(ccc.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 AND scd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT icte.DEPARTMENT_NAME, icte.COURSE_LEVEL, icte.course_count, icte.min_total_units, scd.SCHOOL_NAME, COUNT(DISTINCT scd.COURSE_OPTION) AS distinct_course_options FROM inner_cte icte JOIN SIS_COURSE_DESCRIPTION scd ON icte.DEPARTMENT_NAME = scd.DEPARTMENT_NAME AND icte.COURSE_LEVEL = scd.COURSE_LEVEL GROUP BY icte.DEPARTMENT_NAME, icte.COURSE_LEVEL, icte.course_count, icte.min_total_units, scd.SCHOOL_NAME ) SELECT cs.DEPARTMENT_NAME, cs.COURSE_LEVEL, cs.course_count, cs.min_total_units, cs.SCHOOL_NAME, cs.distinct_course_options, hae.highest_avg_enrollment_per_term FROM course_stats cs JOIN highest_avg_enrollment hae ON cs.DEPARTMENT_NAME = hae.DEPARTMENT_NAME ORDER BY cs.DEPARTMENT_NAME, cs.COURSE_LEVEL;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per Engineering degree-granting course subject above its department average total units\", \"desc\": \"For degree-granting courses in the School of Engineering, show the course description, department name, subject title, and the subject's grade type description, but only include those courses where the total units for the subject exceed the average total units for that department. Do not return any rounded answers.\", \"id\": \"dw_2924\", \"name\": \"Engineering Degree-Granting Course Subjects Above Department Average Total Units\", \"sql\": \"WITH inner_cte AS ( SELECT t0.COURSE_DESCRIPTION, t0.DEPARTMENT_NAME, t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t1.GRADE_TYPE_DESC, t1.DEPARTMENT_NAME AS SUBJECT_DEPT FROM SIS_COURSE_DESCRIPTION t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.COURSE = t1.SUBJECT_CODE WHERE t0.SCHOOL_NAME = 'Engineering' AND t0.IS_DEGREE_GRANTING = 'Y' ) , dept_avg_units AS ( SELECT SUBJECT_DEPT, AVG(TOTAL_UNITS) AS avg_units FROM inner_cte GROUP BY SUBJECT_DEPT ) SELECT i.COURSE_DESCRIPTION, i.DEPARTMENT_NAME, i.SUBJECT_TITLE, i.GRADE_TYPE_DESC FROM inner_cte i JOIN dept_avg_units d ON i.SUBJECT_DEPT = d.SUBJECT_DEPT WHERE i.TOTAL_UNITS > d.avg_units;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level where the course is degree granting and the total units are greater than 6, provide the number of unique courses, the minimum total units offered, and the number of courses where the design units are at least 3. Do not return any rounded answers.\", \"id\": \"dw_3163\", \"name\": \"Degree-Granting Course Level Counts with Min Total Units and Design-Unit Course Counts\", \"sql\": \"WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, scd.COURSE_LEVEL, COUNT(DISTINCT scd.COURSE) AS course_count, MIN(ccc.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY scd.DEPARTMENT_NAME, scd.COURSE_LEVEL ) SELECT ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units, COUNT(DISTINCT CASE WHEN ccc.DESIGN_UNITS >= 3 THEN scd.COURSE END) AS courses_with_design_units_3_or_more FROM inner_cte ic JOIN SIS_COURSE_DESCRIPTION scd ON ic.DEPARTMENT_NAME = scd.DEPARTMENT_NAME AND ic.COURSE_LEVEL = scd.COURSE_LEVEL JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND ccc.TOTAL_UNITS > 6 GROUP BY ic.DEPARTMENT_NAME, ic.COURSE_LEVEL, ic.course_count, ic.min_total_units;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department name per course level\", \"desc\": \"For each department name and course level, where the total number of enrolled students in offered subjects is greater than 10, and the department is Mathematics (Course 18), provide the number of unique courses, the minimum total units among those subjects that are degree-granting courses, the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for Mathematics courses (considering only departments that offer more than five courses), and the number of unique subject codes for Mathematics in the SIS_SUBJECT_CODE table. List the department name, course level, number of unique courses, minimum total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the number of unique subject codes, in that order. Do not return any rounded answers.\", \"id\": \"dw_2335\", \"name\": \"Math Degree-Granting Course Level Counts with Catalog Unit Stddev and Unique Subject Codes\", \"sql\": \"WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, c.COURSE_LEVEL, COUNT(DISTINCT c.COURSE) AS course_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.NUM_ENROLLED_STUDENTS > 10 AND d.DEPARTMENT_NAME = 'Mathematics' AND c.IS_DEGREE_GRANTING = 'Y' GROUP BY d.DEPARTMENT_NAME, c.COURSE_LEVEL ) SELECT inner_cte.DEPARTMENT_NAME, inner_cte.COURSE_LEVEL, inner_cte.course_count, inner_cte.min_total_units, subq2.units_stddev, subq3.unique_subject_codes FROM inner_cte JOIN ( SELECT s.DEPARTMENT_NAME, STDDEV(c.TOTAL_UNITS) AS units_stddev FROM SIS_SUBJECT_CODE s JOIN CIS_COURSE_CATALOG c ON s.DEPARTMENT_CODE = c.DEPARTMENT_CODE WHERE c.TOTAL_UNITS IS NOT NULL AND s.DEPARTMENT_NAME = 'Mathematics' GROUP BY s.DEPARTMENT_NAME HAVING COUNT(*) > 5 ) subq2 ON inner_cte.DEPARTMENT_NAME = subq2.DEPARTMENT_NAME JOIN ( SELECT DEPARTMENT_NAME, COUNT(DISTINCT SUBJECT_CODE) AS unique_subject_codes FROM SIS_SUBJECT_CODE WHERE DEPARTMENT_NAME = 'Mathematics' GROUP BY DEPARTMENT_NAME ) subq3 ON inner_cte.DEPARTMENT_NAME = subq3.DEPARTMENT_NAME;\"}, {\"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per department per course level matched with Spring 2021 letter-graded summary\", \"desc\": \"For each department name and course level in the Mathematics department (Course 18) where the total number of enrolled students in offered subjects is greater than the average number of enrolled students for that department and the subjects are degree-granting, provide the number of unique courses and the minimum total units among those subjects, along with the term description, the minimum total units, the sum of lecture units, and the number of unique subjects for letter graded Mathematics subjects offered in the Spring Term 2021. List the columns in the following order: department name, course level, number of unique courses, minimum total units from the first set, term description, minimum total units from the second set, sum of lecture units, and number of unique subjects. Do not return any rounded answers.\", \"id\": \"dw_1692\", \"name\": \"Math Degree-Granting Course Levels Above Average Enrollment with Spring 2021 Letter-Graded Summary\", \"sql\": \"WITH inner_cte1 AS ( SELECT d.DEPARTMENT_NAME, c.COURSE_LEVEL, COUNT(DISTINCT c.COURSE) AS course_count, MIN(s.TOTAL_UNITS) AS min_total_units, s.NUM_ENROLLED_STUDENTS FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.DEPARTMENT_NAME = 'Mathematics' AND c.IS_DEGREE_GRANTING = 'Y' GROUP BY d.DEPARTMENT_NAME, c.COURSE_LEVEL, s.NUM_ENROLLED_STUDENTS ), dept_avg AS ( SELECT d.DEPARTMENT_NAME, AVG(s.NUM_ENROLLED_STUDENTS) AS avg_enrolled FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.DEPARTMENT_NAME = 'Mathematics' GROUP BY d.DEPARTMENT_NAME ), subq1 AS ( SELECT i.DEPARTMENT_NAME, i.COURSE_LEVEL, i.course_count, i.min_total_units FROM inner_cte1 i JOIN dept_avg a ON i.DEPARTMENT_NAME = a.DEPARTMENT_NAME WHERE i.NUM_ENROLLED_STUDENTS > a.avg_enrolled ), inner_cte2 AS ( SELECT MIN(c.TOTAL_UNITS) AS min_total_units, SUM(c.LECTURE_UNITS) AS sum_lecture_units FROM ACADEMIC_TERMS_ALL a JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON a.TERM_CODE = c.TERM_CODE WHERE a.TERM_CODE = '2021SP' AND c.GRADE_TYPE = 'L' AND c.DEPARTMENT_NAME = 'Mathematics' ), subq2 AS ( SELECT a.DEPARTMENT_NAME, b.TERM_DESCRIPTION, inner_cte2.min_total_units, inner_cte2.sum_lecture_units, COUNT(DISTINCT a.SUBJECT_ID) AS num_unique_subjects FROM COURSE_CATALOG_SUBJECT_OFFERED a JOIN ACADEMIC_TERMS_ALL b ON a.TERM_CODE = b.TERM_CODE CROSS JOIN inner_cte2 WHERE a.TERM_CODE = '2021SP' AND a.GRADE_TYPE = 'L' AND a.DEPARTMENT_NAME = 'Mathematics' GROUP BY a.DEPARTMENT_NAME, b.TERM_DESCRIPTION, inner_cte2.min_total_units, inner_cte2.sum_lecture_units ) SELECT q1.DEPARTMENT_NAME, q1.COURSE_LEVEL, q1.course_count, q1.min_total_units AS min_total_units_subq1, q2.TERM_DESCRIPTION, q2.min_total_units AS min_total_units_subq2, q2.sum_lecture_units, q2.num_unique_subjects FROM subq1 q1 JOIN subq2 q2 ON q1.DEPARTMENT_NAME = q2.DEPARTMENT_NAME ORDER BY q1.COURSE_LEVEL, q2.TERM_DESCRIPTION\"}], \"not_found\": []}"
    },
