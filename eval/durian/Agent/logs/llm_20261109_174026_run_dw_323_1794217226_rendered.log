    {
      "role": "tool",
      "tool_call_id": "call_d417ac8e3b3b43e2844173b4",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per 2016SP degree-granting department (with grand total rows) matched with a top-5 Engineering 12-unit-course department\", \"desc\": \"For each department that grants degrees and offered subjects in the term '2016SP', and is also among the top 5 offering departments in the 'Engineering' school with the most 12-unit courses, list the department code, department name, the number of subjects offered, the total units for those subjects, the offering department name, the number of qualifying 12-unit courses, and the course number and description of the most recently added 12-unit course in each department. For each department, also include a grand total row for the number of subjects and total units in the format (department code, null, total subjects, total units, ...). Do not return any rounded answers.\", \"id\": \"dw_4234\", \"name\": \"2016SP Degree-Granting Department Subject Rollups Matched with Top-5 Engineering 12-Unit Course Departments\", \"sql\": \"WITH inner_cte1 AS ( SELECT t2.SUBJECT_ID, dense_rank() OVER (ORDER BY t2.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) window_column FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t2.TERM_CODE = '2016SP' AND t1.IS_DEGREE_GRANTING = 'Y' ), DeptSubjectSummary AS ( SELECT t1.DEPARTMENT_CODE, t1.DEPARTMENT_NAME, COUNT(DISTINCT t2.SUBJECT_ID) AS num_subjects, SUM(t2.TOTAL_UNITS) AS total_units FROM SIS_DEPARTMENT t1 JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t1.IS_DEGREE_GRANTING = 'Y' AND t2.TERM_CODE = '2016SP' GROUP BY t1.DEPARTMENT_CODE, t1.DEPARTMENT_NAME ), DeptSummaryWithName AS ( SELECT dss.DEPARTMENT_CODE, dss.DEPARTMENT_NAME, dss.num_subjects, dss.total_units FROM DeptSubjectSummary dss UNION ALL SELECT dss.DEPARTMENT_CODE, NULL AS DEPARTMENT_NAME, SUM(dss.num_subjects) AS num_subjects, SUM(dss.total_units) AS total_units FROM DeptSubjectSummary dss GROUP BY dss.DEPARTMENT_CODE ), inner_cte2 AS ( SELECT t0.COURSE AS course_number, t0.COURSE_DESCRIPTION, t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t1.OFFER_DEPT_NAME, t1.OFFER_DEPT_CODE, t0.LAST_ACTIVITY_DATE FROM SIS_COURSE_DESCRIPTION t0 JOIN SUBJECT_OFFERED_SUMMARY t1 ON t0.COURSE = t1.COURSE_NUMBER WHERE t0.SCHOOL_NAME = 'Engineering' AND t1.TOTAL_UNITS = 12 ), TopDepts AS ( SELECT ic.OFFER_DEPT_NAME, ic.OFFER_DEPT_CODE, COUNT(*) AS num_courses, ic_recent.course_number AS most_recent_course_number, ic_recent.COURSE_DESCRIPTION AS most_recent_course_description FROM inner_cte2 ic JOIN ( SELECT OFFER_DEPT_NAME, OFFER_DEPT_CODE, course_number, COURSE_DESCRIPTION, LAST_ACTIVITY_DATE, ROW_NUMBER() OVER (PARTITION BY OFFER_DEPT_NAME ORDER BY LAST_ACTIVITY_DATE DESC) AS rn FROM inner_cte2 ) ic_recent ON ic.OFFER_DEPT_NAME = ic_recent.OFFER_DEPT_NAME AND ic.OFFER_DEPT_CODE = ic_recent.OFFER_DEPT_CODE AND ic_recent.rn = 1 GROUP BY ic.OFFER_DEPT_NAME, ic.OFFER_DEPT_CODE, ic_recent.course_number, ic_recent.COURSE_DESCRIPTION ORDER BY num_courses DESC LIMIT 5 ) SELECT dsw.DEPARTMENT_CODE, dsw.DEPARTMENT_NAME, dsw.num_subjects, dsw.total_units, td.OFFER_DEPT_NAME, td.num_courses, td.most_recent_course_number, td.most_recent_course_description FROM DeptSummaryWithName dsw JOIN TopDepts td ON dsw.DEPARTMENT_CODE = td.OFFER_DEPT_CODE ORDER BY dsw.DEPARTMENT_CODE, dsw.DEPARTMENT_NAME\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per degree-granting department that offered Engineering-school subjects in 2021\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of active graduate students with an office location assigned in that department. Do not return any rounded answers.\", \"id\": \"dw_3237\", \"name\": \"2021 Engineering Degree-Granting Department Subject Counts with Active Graduate Student Office Totals\", \"sql\": \"WITH DeptSubjects AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), DeptActiveGradStudents AS ( SELECT m.DEPARTMENT_NAME, m.DEPARTMENT, COUNT(*) AS total_active_grad_students FROM SE_PERSON s JOIN MIT_STUDENT_DIRECTORY m ON s.FULL_NAME = m.FULL_NAME WHERE s.IS_ACTIVE = 'Y' AND m.STUDENT_YEAR = 'G' AND m.OFFICE_LOCATION IS NOT NULL GROUP BY m.DEPARTMENT_NAME, m.DEPARTMENT HAVING COUNT(*) > 0 ) SELECT ds.DEPARTMENT_CODE, ds.DEPARTMENT_NAME, ds.DEPARTMENT_FULL_NAME, ds.subject_count, ds.total_enrollment, dag.total_active_grad_students FROM DeptSubjects ds LEFT JOIN SIS_DEPARTMENT d ON ds.DEPARTMENT_CODE = d.DEPARTMENT_CODE LEFT JOIN DeptActiveGradStudents dag ON d.DEPARTMENT_CODE = dag.DEPARTMENT ORDER BY ds.DEPARTMENT_NAME;\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per department per course number\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\", \"id\": \"dw_4683\", \"name\": \"Current Term Department Enrollments with Library Course Counts and Min Units\", \"sql\": \"WITH inner_cte AS ( SELECT de.DEPARTMENT_NAME, de.total_enrollments, lss.COURSE_NUMBER, lss.subject_count, lss.min_total_units FROM ( SELECT s.DEPARTMENT_NAME, SUM(s.SUBJECT_ENROLLMENT_NUMBER) AS total_enrollments FROM ACADEMIC_TERM_PARAMETER p JOIN ACADEMIC_TERMS t ON p.TERM_CODE = t.TERM_CODE JOIN SUBJECT_SUMMARY s ON t.TERM_CODE = s.TERM_CODE WHERE p.IS_CURRENT_TERM = 'Y' GROUP BY s.DEPARTMENT_NAME HAVING SUM(s.SUBJECT_ENROLLMENT_NUMBER) > 10 ) de JOIN ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, COUNT(DISTINCT l.LIBRARY_SUBJECT_OFFERED_KEY) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 GROUP BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ) lss ON de.DEPARTMENT_NAME = lss.OFFER_DEPT_NAME ) SELECT ic.DEPARTMENT_NAME, ic.total_enrollments, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sos.RESPONSIBLE_FACULTY_NAME FROM inner_cte ic JOIN LIBRARY_SUBJECT_OFFERED lso ON ic.DEPARTMENT_NAME = lso.OFFER_DEPT_NAME AND ic.COURSE_NUMBER = lso.COURSE_NUMBER JOIN SUBJECT_OFFERED_SUMMARY sos ON lso.SUBJECT_ID = sos.SUBJECT_ID WHERE sos.NUM_ENROLLED_STUDENTS > 2 GROUP BY ic.DEPARTMENT_NAME, ic.total_enrollments, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sos.RESPONSIBLE_FACULTY_NAME;\"}, {\"id\": \"dw_4812\", \"name\": \"Top 10 Degree-Granting Department Subject Code and Course Number Combinations by Unique Library Subject Count\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH DeptSubjectStats AS ( SELECT d.DEPARTMENT_NAME, s.SUBJECT_CODE, COUNT(s.SUBJECT_CODE) AS subject_code_count, MIN(d.DEPT_BUDGET_CODE) AS min_dept_budget_code FROM SIS_DEPARTMENT d JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' GROUP BY d.DEPARTMENT_NAME, s.SUBJECT_CODE ), DeptCourseStats AS ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, COUNT(DISTINCT l.LIBRARY_SUBJECT_OFFERED_KEY) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 GROUP BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ) SELECT dss.DEPARTMENT_NAME, dss.SUBJECT_CODE, dss.subject_code_count, dss.min_dept_budget_code, dcs.COURSE_NUMBER, dcs.subject_count, dcs.min_total_units FROM DeptSubjectStats dss JOIN SIS_SUBJECT_CODE ssc ON dss.SUBJECT_CODE = ssc.SUBJECT_CODE JOIN DeptCourseStats dcs ON dss.DEPARTMENT_NAME = dcs.OFFER_DEPT_NAME AND ssc.COURSE_NUMBER = dcs.COURSE_NUMBER ), SubjectMaxEnroll AS ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, ROW_NUMBER() OVER (PARTITION BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ORDER BY s.NUM_ENROLLED_STUDENTS DESC) AS rn FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 ) SELECT ic.DEPARTMENT_NAME, ic.SUBJECT_CODE, ic.subject_code_count, ic.min_dept_budget_code, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sme.SUBJECT_TITLE AS Top_Subject_Title, sme.NUM_ENROLLED_STUDENTS AS Top_Subject_Enrollment FROM inner_cte ic LEFT JOIN SubjectMaxEnroll sme ON ic.DEPARTMENT_NAME = sme.OFFER_DEPT_NAME AND ic.COURSE_NUMBER = sme.COURSE_NUMBER AND sme.rn = 1 ORDER BY ic.subject_count DESC LIMIT 10;\", \"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per top-10 department/subject-code/course-number combination with its highest-enrollment subject\"}], \"not_found\": []}"
