            "arguments": "{\"sql\": \"SELECT sd.DEPARTMENT_CODE,\\n       sd.DEPARTMENT_NAME,\\n       SUM(sos.NUM_ENROLLED_STUDENTS) AS total_enrolled_students,\\n       NULL AS unique_course_titles,\\n       'High Enrollment Mathematics' AS reason_for_inclusion\\nFROM SIS_DEPARTMENT sd\\nJOIN SUBJECT_OFFERED_SUMMARY sos ON sd.DEPARTMENT_CODE = sos.OFFER_DEPT_CODE\\nJOIN SIS_SUBJECT_CODE ssc ON ssc.DEPARTMENT_CODE = sd.DEPARTMENT_CODE\\nWHERE sd.DEPARTMENT_NAME = 'Mathematics'\\nGROUP BY sd.DEPARTMENT_CODE, sd.DEPARTMENT_NAME\\nHAVING SUM(sos.NUM_ENROLLED_STUDENTS) > (\\n    SELECT AVG(t.total_enrolled) + STDDEV(t.total_enrolled)\\n    FROM (\\n        SELECT SUM(sos2.NUM_ENROLLED_STUDENTS) AS total_enrolled\\n        FROM SIS_DEPARTMENT sd2\\n        JOIN SUBJECT_OFFERED_SUMMARY sos2 ON sd2.DEPARTMENT_CODE = sos2.OFFER_DEPT_CODE\\n        JOIN SIS_SUBJECT_CODE ssc2 ON ssc2.DEPARTMENT_CODE = sd2.DEPARTMENT_CODE\\n        GROUP BY sd2.DEPARTMENT_CODE\\n    ) t\\n)\\nUNION ALL\\nSELECT ic.DEPARTMENT_CODE,\\n       ic.DEPARTMENT_NAME,\\n       NULL AS total_enrolled_students,\\n       COUNT(DISTINCT ccc.SUBJECT_TITLE) AS unique_course_titles,\\n       'Degree-Granting with Many Courses' AS reason_for_inclusion\\nFROM (\\n    SELECT sd.DEPARTMENT_CODE, sd.DEPARTMENT_NAME, COUNT(*) AS num_courses\\n    FROM SIS_DEPARTMENT sd\\n    JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE\\n    WHERE sd.IS_DEGREE_GRANTING = 'Y'\\n      AND sd.DEPARTMENT_CODE <> '6'\\n    GROUP BY sd.DEPARTMENT_CODE, sd.DEPARTMENT_NAME\\n) ic\\nJOIN CIS_COURSE_CATALOG ccc ON ic.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE\\nWHERE ic.num_courses >= 5\\nGROUP BY ic.DEPARTMENT_CODE, ic.DEPARTMENT_NAME\"}"
          }
        }
