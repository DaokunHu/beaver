    {
      "role": "tool",
      "tool_call_id": "call_3b1603e0e41341d3afb95c3b",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}, {\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject offered summary record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject; joins to SIS_SUBJECT_CODE.COURSE_NUMBER and SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'; used for school-level filtering\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"SIS_SUBJECT_CODE\", \"name\": \"SIS_SUBJECT_CODE\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\", \"columns\": {\"COURSE_NUMBER\": {\"desc\": \"Course number; joins to SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject code, e.g. '18'; joins to SIS_COURSE_DESCRIPTION.COURSE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"SUBJECT_CODE_DESC\": {\"desc\": \"Description of the subject code, typically the department/program name for that code\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering; used for school-level filtering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject code / course number\"}, {\"id\": \"CIS_COURSE_CATALOG\", \"name\": \"CIS_COURSE_CATALOG\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\", \"columns\": {\"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether offered during IAP\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog record\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, SUBJECT_CODE.SUBJECT_NUMBER\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject code, e.g. '18'\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_SUBJECT_CODE.DEPARTMENT_CODE and SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which catalog attributes take effect\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject; joins to CIS_COURSE_CATALOG-based subject title matching\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description\"}, \"HGN_CODE\": {\"desc\": \"HGN level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text\"}, \"JOINT_SUBJECTS\": {\"desc\": \"Joint subjects list\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether offered this academic year\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"SECTION_ID\": {\"desc\": \"Section identifier\"}, \"TERM_CODE\": {\"desc\": \"Term code of the catalog record\"}}, \"default_granularity\": \"one row per subject per term in the CIS course catalog\"}, {\"id\": \"SIS_ADMIN_DEPARTMENT\", \"name\": \"SIS_ADMIN_DEPARTMENT\", \"desc\": \"SIS administrative department table with administrative department code/name, phone area code and phone number, and clearing cost collector. Joins to SIS_DEPARTMENT via SIS_ADMIN_DEPARTMENT_CODE = DEPARTMENT_CODE for department contact information.\", \"columns\": {\"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"SIS_ADMIN_DEPARTMENT_CODE\": {\"desc\": \"Administrative department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"SIS_ADMIN_DEPARTMENT_NAME\": {\"desc\": \"Administrative department name\"}, \"DEPARTMENT_PHONE_AREA_CODE\": {\"desc\": \"Area code of the department phone number\"}, \"DEPARTMENT_PHONE_NUMBER\": {\"desc\": \"Phone number of the administrative department\"}, \"CLEARING_COST_COLLECTOR\": {\"desc\": \"Clearing cost collector of the administrative department\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}}, \"default_granularity\": \"one row per administrative department\"}, {\"id\": \"concept_department_dimension\", \"name\": \"Department and School Dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\", \"tables\": [\"SIS_DEPARTMENT\", \"STUDENT_DEPARTMENT\", \"SIS_ADMIN_DEPARTMENT\"], \"comparisons\": [{\"dimension\": \"Attribute coverage\", \"SIS_DEPARTMENT\": \"Richest: DEPARTMENT_FULL_NAME, SCHOOL_CODE/SCHOOL_NAME, DEPT_BUDGET_CODE, IS_DEGREE_GRANTING, commencement-book names, DLC key\", \"STUDENT_DEPARTMENT\": \"Minimal: code, name, full name, school code/name only\", \"SIS_ADMIN_DEPARTMENT\": \"Administrative contact: department phone area code/number, clearing cost collector\"}, {\"dimension\": \"Degree-granting and school filtering\", \"SIS_DEPARTMENT\": \"Supports IS_DEGREE_GRANTING and SCHOOL_NAME filters directly\", \"STUDENT_DEPARTMENT\": \"Only school code/name attribution, no degree-granting flag\", \"SIS_ADMIN_DEPARTMENT\": \"No school or degree-granting attributes\"}, {\"dimension\": \"Typical join path\", \"SIS_DEPARTMENT\": \"DEPARTMENT_CODE = offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE; also joins SIS_COURSE_DESCRIPTION.DEPARTMENT and SIS_ADMIN_DEPARTMENT.SIS_ADMIN_DEPARTMENT_CODE\", \"STUDENT_DEPARTMENT\": \"DEPARTMENT_CODE = TIP_SUBJECT_OFFERED.OFFER_DEPT_CODE and other offering department codes\", \"SIS_ADMIN_DEPARTMENT\": \"SIS_ADMIN_DEPARTMENT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE\"}, {\"dimension\": \"Budget/finance attributes\", \"SIS_DEPARTMENT\": \"DEPT_BUDGET_CODE available for budget-based ranking\", \"STUDENT_DEPARTMENT\": \"None\", \"SIS_ADMIN_DEPARTMENT\": \"CLEARING_COST_COLLECTOR\"}], \"decision_guide\": {\"Questions filtering departments by school (e.g. 'School of Engineering') or degree-granting status\": \"Use SIS_DEPARTMENT; it carries SCHOOL_NAME and IS_DEGREE_GRANTING.\", \"Questions needing only department full name and school name for offering departments (e.g. TIP subject offerings)\": \"STUDENT_DEPARTMENT suffices and is the lighter lookup; SIS_DEPARTMENT also works.\", \"Questions needing department phone numbers or administrative contact details\": \"Join SIS_ADMIN_DEPARTMENT via SIS_DEPARTMENT.DEPARTMENT_CODE = SIS_ADMIN_DEPARTMENT_CODE.\", \"Questions ranking or grouping departments by budget code\": \"Use SIS_DEPARTMENT.DEPT_BUDGET_CODE.\"}}, {\"id\": \"concept_subject_offering_facts\", \"name\": \"Subject Offering Fact Tables\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\", \"tables\": [\"COURSE_CATALOG_SUBJECT_OFFERED\", \"SUBJECT_OFFERED\", \"SUBJECT_OFFERED_SUMMARY\", \"SUBJECT_SUMMARY\", \"TIP_SUBJECT_OFFERED\", \"LIBRARY_SUBJECT_OFFERED\"], \"comparisons\": [{\"dimension\": \"Granularity\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Subject offering per term/academic year (catalog record, includes section flags)\", \"SUBJECT_OFFERED\": \"Subject section per term (finest grain, SECTION_ID)\", \"SUBJECT_OFFERED_SUMMARY\": \"Subject per term (rollup of sections)\", \"SUBJECT_SUMMARY\": \"Subject or cluster per term\", \"TIP_SUBJECT_OFFERED\": \"Subject per term within textbook program scope\", \"LIBRARY_SUBJECT_OFFERED\": \"Subject per term within library reserve scope\"}, {\"dimension\": \"Enrollment measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"None (catalog attributes only)\", \"SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, SECTION_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_OFFERED_SUMMARY\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_SUMMARY\": \"SUBJECT_ENROLLMENT_NUMBER plus first-week/fifth-week and credit/listener enrollment splits\", \"TIP_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\", \"LIBRARY_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\"}, {\"dimension\": \"Unit measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS, DESIGN_UNITS, TOTAL_UNITS, IS_VARIABLE_UNITS\", \"SUBJECT_OFFERED\": \"None\", \"SUBJECT_OFFERED_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS\", \"SUBJECT_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREP_UNITS, DESIGN_UNITS\", \"TIP_SUBJECT_OFFERED\": \"None\", \"LIBRARY_SUBJECT_OFFERED\": \"None\"}, {\"dimension\": \"Distinctive attributes\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"HGN_DESC level, GRADE_TYPE/GRADE_RULE, HASS/GIR attributes, IS_OFFERED_* flags, MEET_PLACE (room key), ACADEMIC_YEAR, EFFECTIVE_TERM_CODE\", \"SUBJECT_OFFERED\": \"IS_REPEATABLE_SUBJECT, CLUSTER_TYPE, section flags, FORM_TYPE, EVALUATE_THIS_SUBJECT\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_SCHOOL_NAME, COURSE_NUMBER, cluster info at subject level\", \"SUBJECT_SUMMARY\": \"SCHOOL_CODE/SCHOOL_NAME, SUBJECT_GROUP_ID, SUBJECT_OR_CLUSTER, detailed weekly enrollment\", \"TIP_SUBJECT_OFFERED\": \"IS_NO_COURSE_MATERIAL flag; parent of TIP_DETAIL materials\", \"LIBRARY_SUBJECT_OFFERED\": \"COURSE_NUMBER/COURSE_NUMBER_DESC; parent of LIBRARY_RESERVE_MATRL_DETAIL\"}, {\"dimension\": \"Department column naming\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_SUMMARY\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"TIP_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\"}], \"decision_guide\": {\"Questions about credit units, grading type/rules, HGN level (undergraduate/graduate), HASS/GIR attributes, or term offering flags (fall/spring/IAP/summer)\": \"Use COURSE_CATALOG_SUBJECT_OFFERED; it is the only offering table carrying full catalog attributes.\", \"Questions about actual section-level offerings, repeatability, cluster type, or section flags\": \"Use SUBJECT_OFFERED (section grain); roll up via SUBJECT_OFFERED_SUMMARY when subject-level totals are needed.\", \"Questions about final enrollment statistics, weekly enrollment snapshots, credit vs listener counts, subject groups, or school-level unit statistics\": \"Use SUBJECT_SUMMARY.\", \"Questions about textbooks/course materials per subject (required/optional status, ISBN, record counts)\": \"Start from TIP_SUBJECT_OFFERED (subject scope, IS_NO_COURSE_MATERIAL) joined to TIP_DETAIL (material rows).\", \"Questions about library reserve materials, reserve counts per subject, or library course numbers\": \"Start from LIBRARY_SUBJECT_OFFERED joined to LIBRARY_RESERVE_MATRL_DETAIL.\", \"Questions about subject-level units with offering department/school (e.g. Engineering school enrollment totals by department)\": \"Use SUBJECT_OFFERED_SUMMARY, which carries both TOTAL_UNITS and OFFER_SCHOOL_NAME.\"}}, {\"id\": \"concept_course_catalog_sources\", \"name\": \"Course Catalog Sources\", \"desc\": \"Tables providing catalog-level subject attributes (titles, unit structure, grading rules, HGN level, requirement attributes, offering-term flags) from different source systems: the warehouse course catalog, the CIS course catalog feed, and the Drupal course catalog feed. They answer the same catalog-attribute questions but differ in source system, extra columns, and join paths to department/subject-code lookups.\", \"tables\": [\"COURSE_CATALOG_SUBJECT_OFFERED\", \"CIS_COURSE_CATALOG\", \"DRUPAL_COURSE_CATALOG\"], \"comparisons\": [{\"dimension\": \"Source system\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Warehouse course catalog fact table\", \"CIS_COURSE_CATALOG\": \"CIS (course information system) catalog feed\", \"DRUPAL_COURSE_CATALOG\": \"Drupal publishing-system catalog feed\"}, {\"dimension\": \"Distinctive columns\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"TERM_CODE plus EFFECTIVE_TERM_CODE, MEET_PLACE room key, RESPONSIBLE_FACULTY columns\", \"CIS_COURSE_CATALOG\": \"Same catalog attribute set keyed by ACADEMIC_YEAR/TERM_CODE; no MEET_PLACE/MEET_TIME\", \"DRUPAL_COURSE_CATALOG\": \"Adds SO_SUBJECT_ID, SO_TERM_CODE, SO_TERM_DESCRIPTION, SO_CLUSTER_TYPE linking to registrar subject offerings\"}, {\"dimension\": \"Typical join paths\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"TERM_CODE/EFFECTIVE_TERM_CODE to term tables; SUBJECT_CODE to SIS_SUBJECT_CODE/SIS_COURSE_DESCRIPTION; DEPARTMENT_CODE to SIS_DEPARTMENT; MEET_PLACE to FCLT_ROOMS\", \"CIS_COURSE_CATALOG\": \"DEPARTMENT_CODE to SIS_SUBJECT_CODE for subject-code/department resolution\", \"DRUPAL_COURSE_CATALOG\": \"SO_* columns to subject offering tables; catalog attributes used directly\"}, {\"dimension\": \"Usage in queries\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Default choice for unit statistics, HGN level, grade rules, offering flags\", \"CIS_COURSE_CATALOG\": \"Used when subject titles must be resolved through SIS_SUBJECT_CODE department groupings\", \"DRUPAL_COURSE_CATALOG\": \"Used when catalog data must be tied back to registrar offering records via SO_* keys\"}], \"decision_guide\": {\"Questions about units, grade type/rule, HGN level, HASS/GIR attributes, or IS_OFFERED_* flags of subjects\": \"Use COURSE_CATALOG_SUBJECT_OFFERED as the default catalog source; it also carries MEET_PLACE for location analysis.\", \"Questions that resolve subjects through SIS subject codes by department (e.g. counting subjects per department from the CIS feed)\": \"Use CIS_COURSE_CATALOG joined to SIS_SUBJECT_CODE on DEPARTMENT_CODE.\", \"Questions that need catalog attributes tied to registrar subject offering records (cluster type, offering term description)\": \"Use DRUPAL_COURSE_CATALOG via its SO_SUBJECT_ID / SO_TERM_CODE columns.\"}}, {\"columns\": [\"SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"SUBJECT_OFFERED_SUMMARY.NUM_ENROLLED_STUDENTS\", \"SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER\", \"TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"LIBRARY_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"SUBJECT_OFFERED.SUBJECT_ENROLLMENT_NUMBER\", \"SUBJECT_OFFERED_SUMMARY.SUBJECT_ENROLLMENT_NUMBER\"], \"comparisons\": [{\"dimension\": \"Measure meaning\", \"detail\": \"NUM_ENROLLED_STUDENTS is the headcount of students enrolled (present in SUBJECT_OFFERED at section grain, SUBJECT_OFFERED_SUMMARY at subject grain, and in TIP/LIBRARY program snapshots); SUBJECT_ENROLLMENT_NUMBER is the official subject enrollment number recorded by the registrar (SUBJECT_SUMMARY, SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY)\"}, {\"dimension\": \"Grain\", \"detail\": \"SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS is per section; SUBJECT_OFFERED_SUMMARY.NUM_ENROLLED_STUDENTS is per subject per term; SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER is the final subject-level enrollment with weekly/credit/listener breakdowns available in sibling columns\"}, {\"dimension\": \"Program scope\", \"detail\": \"TIP_SUBJECT_OFFERED and LIBRARY_SUBJECT_OFFERED enrollment values are snapshots within the textbook-program and library-reserve scopes respectively and may not cover all subjects\"}], \"decision_guide\": {\"Questions about official subject enrollment (e.g. 'subject enrollment number greater than 10')\": \"Use SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER.\", \"Questions about number of enrolled students per subject offering or per department totals\": \"Use NUM_ENROLLED_STUDENTS from SUBJECT_OFFERED_SUMMARY (subject grain) or SUBJECT_OFFERED (section grain, needs aggregation).\", \"Questions about enrollment of subjects within the textbook program or library reserve scope\": \"Use TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS or LIBRARY_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS respectively.\", \"Questions needing enrollment timing (first week, fifth week) or credit vs listener splits\": \"Use SUBJECT_SUMMARY's SUBJECT_ENROLLMENT_FIRST_WEEK / FIFTH_WEEK and *_CREDIT / *_LISTEN columns.\"}, \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\", \"id\": \"column_concept_enrollment_measures\", \"name\": \"Enrollment Measures\"}, {\"id\": \"column_concept_department_name\", \"name\": \"Department Name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME\", \"SUBJECT_SUMMARY.DEPARTMENT_NAME\", \"SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY.OFFER_DEPT_NAME\", \"TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SIS_DEPARTMENT.DEPARTMENT_NAME\", \"STUDENT_DEPARTMENT.DEPARTMENT_NAME\", \"SIS_COURSE_DESCRIPTION.DEPARTMENT_NAME\", \"SIS_SUBJECT_CODE.DEPARTMENT_NAME\", \"EMPLOYEE_DIRECTORY.DEPARTMENT_NAME\", \"LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT\", \"MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME\", \"SE_PERSON.ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DEPARTMENT_NAME is used by catalog/summary tables (COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY), department/course lookup tables, and the student directory (MIT_STUDENT_DIRECTORY); OFFER_DEPT_NAME is used by offering/program tables (SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY, TIP_SUBJECT_OFFERED, LIBRARY_SUBJECT_OFFERED) and denotes the department that actually offers the subject; LIBRARY_COURSE_INSTRUCTOR uses the plain column name DEPARTMENT for the course's academic department; SE_PERSON uses ORGANIZATION for the person's organizational unit\"}, {\"dimension\": \"Value format\", \"detail\": \"Catalog, summary, offering, student-directory, and lookup tables store plain department names (e.g. 'Mathematics', 'Chemistry', 'Electrical Eng & Computer Sci'); LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT stores a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics', '06 - Electrical Eng & Computer Sci'), with some unprefixed values (e.g. 'Architecture'), so it is not directly comparable to plain-name columns without stripping the prefix\"}, {\"dimension\": \"Academic vs HR/organization value domain\", \"detail\": \"Catalog, summary, offering, library, student-directory, and lookup tables share the academic department domain; EMPLOYEE_DIRECTORY.DEPARTMENT_NAME is the HR organizational unit name and has a different domain (e.g. 'Lincoln Laboratory', 'Department of Physics'), where some values coincide with academic names but many do not, and some carry a 'Department of ...' prefix; SE_PERSON.ORGANIZATION holds organizational unit names that may use different naming variants than the academic domain for the same unit (e.g. 'Electrical Engineering-Computer Science' vs the academic 'Electrical Eng & Computer Sci'), so equality filters across the two conventions must use each table's own variant\"}, {\"dimension\": \"Companion code column\", \"detail\": \"Catalog/summary tables carry DEPARTMENT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE; offering/program tables carry OFFER_DEPT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE or STUDENT_DEPARTMENT.DEPARTMENT_CODE; MIT_STUDENT_DIRECTORY carries DEPARTMENT (the academic department code) joining SIS_DEPARTMENT.DEPARTMENT_CODE, which is the reliable join key instead of the name; LIBRARY_COURSE_INSTRUCTOR has no department code column, only the prefixed name text; EMPLOYEE_DIRECTORY carries DEPARTMENT_NUMBER (HR department number) and SE_PERSON carries no department code, neither joining to SIS_DEPARTMENT.DEPARTMENT_CODE\"}], \"decision_guide\": {\"Filtering subjects by department in catalog or summary analysis\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME or SUBJECT_SUMMARY.DEPARTMENT_NAME.\", \"Filtering by department in section-level, textbook-program, or library analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Joining fact tables to department dimension attributes (school, full name, degree-granting)\": \"Prefer code joins: DEPARTMENT_CODE / OFFER_DEPT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE; name equality joins are used when codes are unavailable.\", \"Matching departments across a DEPARTMENT_NAME table and an OFFER_DEPT_NAME table\": \"The values are directly comparable (same academic name domain), e.g. joining SUBJECT_SUMMARY.DEPARTMENT_NAME to TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME.\", \"Filtering employees by their HR organizational unit (e.g. names containing 'Department', or HR units like 'Political Science')\": \"Use EMPLOYEE_DIRECTORY.DEPARTMENT_NAME; do not join it to SIS_DEPARTMENT.DEPARTMENT_CODE, and pair it with DEPARTMENT_NUMBER for HR grouping.\", \"Filtering by department in section-level, textbook-program, or library subject analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Filtering library reserve course instructors by academic department or library unit\": \"Use LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT with the prefixed value format (e.g. '18 - Mathematics'); do not compare it directly to plain department-name columns.\", \"Filtering students by their academic department\": \"Use MIT_STUDENT_DIRECTORY.DEPARTMENT (code) joined to SIS_DEPARTMENT.DEPARTMENT_CODE for reliable matching, or MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME for direct name filters; the name shares the academic domain with SIS_DEPARTMENT.DEPARTMENT_NAME.\", \"Filtering a person master (SE_PERSON) record by organizational unit such as an academic department\": \"Use SE_PERSON.ORGANIZATION with its own naming variant (e.g. 'Electrical Engineering-Computer Science'); do not equate it directly to MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME or SIS_DEPARTMENT.DEPARTMENT_NAME, which use the academic variant (e.g. 'Electrical Eng & Computer Sci').\"}}], \"not_found\": []}"
