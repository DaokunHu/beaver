            "arguments": "{\"entity_ids\": \n[\"SIS_DEPARTMENT\", \"SUBJECT_OFFERED_SUMMARY\", \"SIS_SUBJECT_CODE\", \"CIS_COURSE_CATALOG\", \"SIS_ADMIN_DEPARTMENT\", \"concept_department_dimension\", \"concept_subject_offering_facts\", \"concept_course_catalog_sources\", \"column_concept_enrollment_measures\", \"column_concept_department_name\"]\n\n}"
          }
        },
        {
          "id": "call_c18fc01a6d0343dbb4dd304f",
