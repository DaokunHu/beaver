    {
      "role": "tool",
      "tool_call_id": "call_6db623549e084c89bbff7e24",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"count\": 4, \"items\": [{\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"entity_type\": \"table\", \"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Master department hierarchy table: one row per department/lab/center (DLC) under the 'Standard Hierarchy' hierarchy type, recording the DLC key/code/name and its five-level hierarchy path from the institute root (level 1 'All Departments') through executive areas down to the DLC's placement, with each level's code and name (null for levels deeper than the DLC's position). Joins to HR_ORG_UNIT and FCLT_ORGANIZATION via DLC_KEY; used to report or filter the master-hierarchy placement (school/area path) of a DLC, and as a DLC scope filter when only DLCs present in the standard hierarchy should be included.\", \"entity_type\": \"table\", \"id\": \"MASTER_DEPT_HIERARCHY\", \"name\": \"MASTER_DEPT_HIERARCHY\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Facilities room inventory table: one row per physical room with building/floor keys, room identifiers, use classifications (major/minor use), organization assignment, area in square meters, access level, and geographic coordinates. Joins to FCLT_BUILDING via FCLT_BUILDING_KEY; referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE via FCLT_ROOM_KEY.\", \"entity_type\": \"table\", \"id\": \"FCLT_ROOMS\", \"name\": \"FCLT_ROOMS\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Department/Lab/Center key columns (values like 'D_AEROASTRO', 'D_IDSS', 'D_BIOLOGY') identifying a DLC across the facilities, HR, space, and academic-department domains. They are the universal cross-domain join key linking facilities organizations and space units to HR organization units, the master department hierarchy, and academic departments. Naming and completeness vary: DLC_KEY in most tables, D_CODE in MASTER_DEPT_DCODE_PARENT, DLC_CODE in the master hierarchy tables; some columns carry composite values ('D_DSL:HQ') or nulls.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_dlc_key\", \"name\": \"DLC Key (Department/Lab/Center)\"}]}"
    },
