            "arguments": "{\"sql\": \"SELECT COUNT(DISTINCT o.HR_DEPARTMENT_NAME) AS hr_names, COUNT(DISTINCT c.DEPARTMENT_NAME) AS cat_names, COUNT(DISTINCT CASE WHEN c.DEPARTMENT_NAME IS NOT NULL THEN o.HR_DEPARTMENT_NAME END) AS matched FROM FCLT_ORGANIZATION o LEFT JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON o.HR_DEPARTMENT_NAME = c.DEPARTMENT_NAME\"}"
