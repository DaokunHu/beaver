      "name": "semantic_get",
      "content": "{\"ok\": true, \"entity\": {\"category\": \"Course Catalog and Facility Space Comprehensive Analysis\", \"default_granularity\": \"one row per department-grade-type rollup row matched with organization room area statistics\", \"desc\": \"For each department and subject grade type where the subject is offered in the current academic year, is letter graded, and the department is Mathematics (Course 18), provide the number of subjects, the minimum total units, the school name, the department phone number, the organization name, the standard deviation (using STDDEV only and never STDDEV_POP) of the areas of its rooms, and the department's DLC name, including subtotals for each department (the corresponding department field is 'SUBTOTAL') and a grand total across all departments (the corresponding department field is 'TOTAL'). Do not repeat the department if it is the same as the previous row. Only include organizations that have more than 5 rooms, are associated with a non-null DLC key, and are not the 'ADMISSIONS' department or the 'Political Science' department. Sort the table by department, grade type, and descending standard deviation (using STDDEV only and never STDDEV_POP) of room areas. Do not return any rounded answers.\", \"id\": \"dw_1833\", \"name\": \"Math Letter-Graded Subject Rollup by Grade Type with Organization Room Area Stddev and DLC Name\", \"sql\": \"WITH inner_cte1 AS ( SELECT d.DEPARTMENT_NAME, c.GRADE_TYPE, COUNT(c.SUBJECT_ID) AS subject_count, MIN(c.TOTAL_UNITS) AS min_total_units FROM SIS_DEPARTMENT d JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON d.DEPARTMENT_CODE = c.DEPARTMENT_CODE WHERE c.IS_OFFERED_THIS_YEAR = 'Y' AND c.GRADE_TYPE = 'L' AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME, c.GRADE_TYPE ), cte1 AS ( SELECT CASE WHEN LAG(dept) OVER (ORDER BY dept_sort, grade_type) = dept THEN NULL ELSE dept END AS department, grade_type, subject_count, min_total_units, sd.SCHOOL_NAME AS school_name, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.DLC_KEY AS dlc_key FROM ( SELECT CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'zzz' ELSE DEPARTMENT_NAME END AS dept_sort, CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'TOTAL' ELSE DEPARTMENT_NAME END AS dept, GRADE_TYPE AS grade_type, COUNT(SUBJECT_COUNT) AS subject_count, MIN(min_total_units) AS min_total_units FROM inner_cte1 GROUP BY DEPARTMENT_NAME, GRADE_TYPE WITH ROLLUP ) tbltmp LEFT JOIN SIS_DEPARTMENT sd ON tbltmp.dept = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), inner_cte2 AS ( SELECT o.ORGANIZATION_NAME, STDDEV(r.AREA) AS area_stddev, o.DLC_KEY FROM FCLT_ORG_DLC_KEY d JOIN FCLT_ORGANIZATION o ON d.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY JOIN FCLT_ROOMS r ON o.FCLT_ORGANIZATION_KEY = r.FCLT_ORGANIZATION_KEY WHERE d.DLC_KEY IS NOT NULL AND o.ORGANIZATION_NAME NOT IN ('ADMISSIONS') AND o.ORGANIZATION_NAME <> 'Political Science' GROUP BY o.ORGANIZATION_NAME, o.DLC_KEY HAVING COUNT(*) > 5 ), cte2 AS ( SELECT inner_cte2.ORGANIZATION_NAME, inner_cte2.area_stddev, o2.DLC_NAME, inner_cte2.DLC_KEY FROM inner_cte2 JOIN FCLT_ORGANIZATION o2 ON inner_cte2.DLC_KEY = o2.DLC_KEY ) SELECT cte1.department, cte1.grade_type, cte1.subject_count, cte1.min_total_units, cte1.school_name, cte1.department_phone, cte2.ORGANIZATION_NAME, cte2.area_stddev, cte2.DLC_NAME FROM cte1 LEFT JOIN cte2 ON cte1.dlc_key = cte2.DLC_KEY ORDER BY cte1.department, cte1.grade_type, cte2.area_stddev DESC;\"}}"
