      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_1465\", \"name\": \"Provost Area School of Science Department Organizations with Max Average Organization Number and Room Area Stddev\", \"desc\": \"For each department in the Provost Area at the School of Science level, excluding the Biology department, and for each organization within those departments (excluding organizations with IDs '138' and '250'), show the department name, department code, organization name, organization ID, the maximum average organization number within each department code group, and the standard deviation (using STDDEV only and never STDDEV_POP) of the area of rooms assigned to the organization (considering only organizations with more than 5 rooms and excluding organizations named 'ADMISSIONS'), ordered by department name and organization name. Do not return any rounded answers.\", \"sql\": \"WITH dept_max_avg_org AS ( WITH inner_cte AS ( SELECT t0.DLC_NAME, t0.DLC_CODE, t1.ORGANIZATION_NAME, t1.ORGANIZATION_ID, AVG(t1.ORGANIZATION_NUMBER) OVER (PARTITION BY t0.DLC_CODE ORDER BY t1.ORGANIZATION_SORT) AS avg_org_number FROM MASTER_DEPT_HIERARCHY t0 JOIN FCLT_ORGANIZATION t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' AND t0.MASTER_DEPT_HIER_LEVEL_3_NAME = 'School of Science' AND LOWER(t0.DLC_NAME) <> LOWER('Biology') AND t1.ORGANIZATION_ID NOT IN ('138', '250') ) SELECT DLC_NAME, DLC_CODE, ORGANIZATION_NAME, ORGANIZATION_ID, MAX(avg_org_number) AS max_avg_org_number FROM inner_cte GROUP BY DLC_NAME, DLC_CODE, ORGANIZATION_NAME, ORGANIZATION_ID ), org_area_stddev AS ( WITH inner_cte AS ( SELECT fo.ORGANIZATION_NAME, STDDEV(fr.AREA) AS area_stddev, fo.FCLT_ORGANIZATION_KEY FROM FCLT_ROOMS fr JOIN FCLT_ORGANIZATION fo ON fr.FCLT_ORGANIZATION_KEY = fo.FCLT_ORGANIZATION_KEY WHERE fo.ORGANIZATION_NAME <> 'ADMISSIONS' GROUP BY fo.ORGANIZATION_NAME, fo.FCLT_ORGANIZATION_KEY HAVING COUNT(fr.FCLT_ROOM_KEY) > 5 ) SELECT i.ORGANIZATION_NAME, fo.ORGANIZATION_NUMBER AS dept_code, i.area_stddev, fo.FCLT_ORGANIZATION_KEY FROM inner_cte i JOIN FCLT_ORGANIZATION fo ON i.FCLT_ORGANIZATION_KEY = fo.FCLT_ORGANIZATION_KEY ) SELECT d.DLC_NAME, d.DLC_CODE, d.ORGANIZATION_NAME, d.ORGANIZATION_ID, d.max_avg_org_number, o.area_stddev FROM dept_max_avg_org d JOIN FCLT_ORGANIZATION fo ON d.ORGANIZATION_ID = fo.ORGANIZATION_ID JOIN org_area_stddev o ON fo.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY ORDER BY d.DLC_NAME, d.ORGANIZATION_NAME\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per School-of-Science department organization matched with its room area standard deviation\"}, {\"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per top reserved subject\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', display each subject title, the offering department name, the count of reserved materials, the academic year, the department name, the average of the total units, and the variance of the total units for subjects offered in regular terms, with the columns shown in that order. Do not return any rounded answers.\", \"id\": \"dw_3664\", \"name\": \"Top 10 Reserved-Material Subjects in 2009SP with Regular-Term Unit Average and Variance\", \"sql\": \"WITH avg_var_units AS ( SELECT c.ACADEMIC_YEAR, c.DEPARTMENT_NAME, AVG(c.TOTAL_UNITS) AS avg_total_units, VARIANCE(c.TOTAL_UNITS) AS var_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS t ON c.TERM_CODE = t.TERM_CODE WHERE t.IS_REGULAR_TERM = 'Y' GROUP BY c.ACADEMIC_YEAR, c.DEPARTMENT_NAME ORDER BY var_total_units DESC ), top_reserved_subjects AS ( SELECT s.SUBJECT_TITLE, s.OFFER_DEPT_NAME, COUNT(l.LIBRARY_RESERVE_CATALOG_KEY) AS reserved_materials FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE l.TERM_CODE = '2009SP' GROUP BY s.SUBJECT_TITLE, s.OFFER_DEPT_NAME ORDER BY reserved_materials DESC LIMIT 10 ) SELECT trs.SUBJECT_TITLE, trs.OFFER_DEPT_NAME, trs.reserved_materials, avu.ACADEMIC_YEAR, avu.DEPARTMENT_NAME, avu.avg_total_units, avu.var_total_units FROM top_reserved_subjects trs LEFT JOIN avg_var_units avu ON trs.OFFER_DEPT_NAME = avu.DEPARTMENT_NAME ORDER BY trs.reserved_materials DESC, avu.var_total_units DESC;\"}, {\"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering department above average enrollment\", \"desc\": \"For each department in the School of Engineering with total student enrollment in its courses greater than the average total enrollment across all Engineering departments (and with total enrollment greater than 50), display the department name, the total number of students enrolled in its courses, and the highest average total units for subjects it has ever offered in a regular academic term, listing the results in descending order of total enrollment. Do not return any rounded answers.\", \"id\": \"dw_4387\", \"name\": \"Engineering Departments Above-Average Enrollment with Highest Regular-Term Average Units\", \"sql\": \"WITH highest_avg_units AS ( WITH inner_cte AS ( SELECT c.DEPARTMENT_NAME, t.TERM_CODE, AVG(c.TOTAL_UNITS) AS avg_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS t ON c.TERM_CODE = t.TERM_CODE WHERE t.IS_REGULAR_TERM = 'Y' GROUP BY c.DEPARTMENT_NAME, t.TERM_CODE ) SELECT DEPARTMENT_NAME, MAX(avg_total_units) AS highest_avg_total_units FROM inner_cte GROUP BY DEPARTMENT_NAME ORDER BY highest_avg_total_units DESC ), eng_dept_enrollment AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) SELECT i.DEPARTMENT_NAME, i.total_enrollment FROM inner_cte i JOIN ( SELECT AVG(total_enrollment) AS avg_enrollment FROM ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) sub ) a ON i.total_enrollment > a.avg_enrollment ) SELECT e.DEPARTMENT_NAME, e.total_enrollment, h.highest_avg_total_units FROM eng_dept_enrollment e LEFT JOIN highest_avg_units h ON e.DEPARTMENT_NAME = h.DEPARTMENT_NAME ORDER BY e.total_enrollment DESC;\"}], \"not_found\": []}"
