      "tool_call_id": "call_0fac2f9b8aa84ec0a7418e1d",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics library subject in previous terms\", \"desc\": \"Show the Mathematics department courses with at least 5 enrolled students, including the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, the average calendar year within each calendar year group ordered by term start date, and for each course, also display the responsible faculty name and the offer school name, but only for academic terms where the term status is 'Previous'. Do not return any rounded answers.\", \"id\": \"dw_4658\", \"name\": \"Mathematics Library Subjects 5+ Enrolled in Previous Terms with Faculty and Calendar Attributes\", \"sql\": \"WITH inner_cte AS ( SELECT t0.COURSE_NUMBER, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t0.TERM_CODE, ROW_NUMBER() OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t0.COURSE_NUMBER) AS window_column FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t0.NUM_ENROLLED_STUDENTS >= 5 ), PreviousTerms AS ( SELECT t1.TERM_CODE, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t0.CALENDAR_DATE, t0.DAY_OF_WEEK, AVG(t0.CALENDAR_YEAR) OVER (PARTITION BY t0.CALENDAR_YEAR ORDER BY t1.TERM_START_DATE) AS window_column FROM TIME_DAY t0 JOIN ACADEMIC_TERMS t1 ON t0.CALENDAR_DATE = t1.TERM_START_DATE WHERE t1.TERM_STATUS = 'Previous' ) SELECT ic.COURSE_NUMBER, ic.SUBJECT_TITLE, ic.NUM_ENROLLED_STUDENTS, ic.TERM_DESCRIPTION, ic.ACADEMIC_YEAR, ic.window_column AS math_window_column, pt.TERM_START_DATE, pt.CALENDAR_DATE, pt.DAY_OF_WEEK, pt.window_column AS previous_terms_window_column, lso.RESPONSIBLE_FACULTY_NAME, lso.OFFER_SCHOOL_NAME FROM inner_cte ic JOIN PreviousTerms pt ON ic.TERM_CODE = pt.TERM_CODE JOIN LIBRARY_SUBJECT_OFFERED lso ON ic.COURSE_NUMBER = lso.COURSE_NUMBER AND ic.TERM_CODE = lso.TERM_CODE ORDER BY ic.COURSE_NUMBER, pt.TERM_START_DATE;\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics library subject above yearly average enrollment\", \"desc\": \"For Mathematics department courses with at least 5 enrolled students, show the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, and the average calendar year within each calendar year group ordered by term start date, but only for academic terms where the term status is 'Previous', and only include results where the number of enrolled students is greater than the average number of enrolled students for that academic year. Do not return any rounded answers.\", \"id\": \"dw_4584\", \"name\": \"Mathematics Library Subjects Above Yearly Average Enrollment in Previous Terms\", \"sql\": \"WITH inner_cte AS ( SELECT t0.COURSE_NUMBER, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t0.TERM_CODE, ROW_NUMBER() OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t0.COURSE_NUMBER) AS window_column, t1.TERM_START_DATE FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t0.NUM_ENROLLED_STUDENTS >= 5 ), PreviousTerms AS ( SELECT t1.TERM_CODE, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t0.CALENDAR_DATE, t0.DAY_OF_WEEK, AVG(t0.CALENDAR_YEAR) OVER (PARTITION BY t0.CALENDAR_YEAR ORDER BY t1.TERM_START_DATE) AS window_column FROM TIME_DAY t0 JOIN ACADEMIC_TERMS t1 ON t0.CALENDAR_DATE = t1.TERM_START_DATE WHERE t1.TERM_STATUS = 'Previous' ), AvgEnrolled AS ( SELECT ACADEMIC_YEAR, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t0.NUM_ENROLLED_STUDENTS >= 5 GROUP BY ACADEMIC_YEAR ) SELECT i.COURSE_NUMBER, i.SUBJECT_TITLE, i.NUM_ENROLLED_STUDENTS, i.TERM_DESCRIPTION, i.ACADEMIC_YEAR, i.window_column AS math_window_column, p.TERM_START_DATE, p.CALENDAR_DATE, p.DAY_OF_WEEK, p.window_column AS previous_terms_window_column FROM inner_cte i JOIN PreviousTerms p ON i.TERM_CODE = p.TERM_CODE JOIN AvgEnrolled a ON i.ACADEMIC_YEAR = a.ACADEMIC_YEAR WHERE i.NUM_ENROLLED_STUDENTS > a.avg_enrolled ORDER BY i.COURSE_NUMBER, p.TERM_START_DATE;\"}], \"not_found\": []}"
