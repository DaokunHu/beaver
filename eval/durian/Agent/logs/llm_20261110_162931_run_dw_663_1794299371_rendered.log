    {
      "role": "tool",
      "tool_call_id": "call_f27a3a7bd77d4b66923293c0",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2014FA Chemistry library subject per academic year per required-material count\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, and for each academic year, also show the academic year and academic year description and the coefficient of variation (using STDDEV only and never STDDEV_POP) of the total units for subjects in the Mathematics department (Course 18) that have more than 0 total units and are offered in terms with a term status indicator of 'P'. Additionally, for each Chemistry subject, include the number of required TIP materials (where TIP_MATERIAL_STATUS_KEY = 'RQ') for that subject in that term. Do not return any rounded answers.\", \"id\": \"dw_2180\", \"name\": \"2014FA Chemistry Library Subjects Windowed Enrollment with Math Unit Coefficient of Variation and Required Material Counts\", \"sql\": \"WITH inner_cte AS ( SELECT l.SUBJECT_TITLE, l.NUM_ENROLLED_STUDENTS, t.RESPONSIBLE_FACULTY_NAME, t.OFFER_DEPT_NAME, MIN(l.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t.RESPONSIBLE_FACULTY_MIT_ID ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column, l.TERM_CODE FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_SUBJECT_OFFERED t ON l.TERM_CODE = t.TERM_CODE WHERE l.TERM_CODE = '2014FA' AND t.OFFER_DEPT_NAME = 'Chemistry' ), math_units_variation AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, STDDEV_SAMP(ss.TOTAL_UNITS) / NULLIF(AVG(ss.TOTAL_UNITS), 0) AS coefficient_of_variation_total_units FROM SUBJECT_SUMMARY ss JOIN ACADEMIC_TERMS_ALL ata ON ss.TERM_CODE = ata.TERM_CODE WHERE ss.DEPARTMENT_NAME = 'Mathematics' AND ss.TOTAL_UNITS > 0 AND ata.TERM_STATUS_INDICATOR = 'P' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC ORDER BY ata.ACADEMIC_YEAR ), required_materials_count AS ( SELECT t.TERM_CODE, t.SUBJECT_ID, COUNT(*) AS num_required_materials FROM TIP_DETAIL t WHERE t.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY t.TERM_CODE, t.SUBJECT_ID ) SELECT c.SUBJECT_TITLE, c.NUM_ENROLLED_STUDENTS, c.RESPONSIBLE_FACULTY_NAME, c.OFFER_DEPT_NAME, c.window_column, m.ACADEMIC_YEAR, m.ACADEMIC_YEAR_DESC, m.coefficient_of_variation_total_units, COALESCE(r.num_required_materials, 0) AS num_required_materials FROM inner_cte c CROSS JOIN math_units_variation m LEFT JOIN TIP_SUBJECT_OFFERED t ON c.TERM_CODE = t.TERM_CODE AND c.SUBJECT_TITLE = t.SUBJECT_TITLE LEFT JOIN required_materials_count r ON t.TERM_CODE = r.TERM_CODE AND t.SUBJECT_ID = r.SUBJECT_ID\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department from either the Math 2008 stats branch or the high-average-units branch\", \"desc\": \"List, for each department, either (a) the department's full name, the range and variance of the total units for degree-granting Mathematics department courses offered in the 2008 academic year along with the long course description for each course (with the reason 'Math 2008 Stats'), or (b) the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units) where the average total units is greater than the overall average across all departments (with the reason 'High Avg Units'). Show the columns in the following order: department name, total units range, total units variance, average total units, standard deviation (using STDDEV only and never STDDEV_POP) of total units, long course description, and reason for inclusion. Do not return any rounded answers.\", \"id\": \"dw_1335\", \"name\": \"Union of Math 2008 Unit Range-Variance with Long Descriptions and High Average Unit Department Stddev\", \"sql\": \"WITH Subquery1 AS ( WITH inner_cte AS ( SELECT sd.DEPARTMENT_FULL_NAME, MAX(ccc.TOTAL_UNITS) - MIN(ccc.TOTAL_UNITS) AS total_units_range, VARIANCE(ccc.TOTAL_UNITS) AS total_units_variance FROM CIS_COURSE_CATALOG ccc JOIN SIS_DEPARTMENT sd ON ccc.DEPARTMENT_CODE = sd.DEPARTMENT_CODE WHERE ccc.ACADEMIC_YEAR = '2008' AND sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' AND ccc.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_FULL_NAME ) SELECT i.DEPARTMENT_FULL_NAME, i.total_units_range, i.total_units_variance, scd.COURSE_DESCRIPTION_LONG FROM inner_cte i JOIN SIS_COURSE_DESCRIPTION scd ON scd.DEPARTMENT = 18 AND scd.DEPARTMENT_NAME = 'Mathematics' ), Subquery2 AS ( WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, AVG(sos.TOTAL_UNITS) AS avg_total_units, STDDEV(sos.TOTAL_UNITS) AS stddev_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SUBJECT_OFFERED_SUMMARY sos ON scd.COURSE = sos.COURSE_NUMBER WHERE sos.TOTAL_UNITS > 0 GROUP BY scd.DEPARTMENT_NAME ) SELECT DEPARTMENT_NAME, avg_total_units, stddev_total_units FROM inner_cte WHERE avg_total_units > ( SELECT AVG(TOTAL_UNITS) FROM SUBJECT_OFFERED_SUMMARY WHERE TOTAL_UNITS > 0 ) ORDER BY stddev_total_units DESC ), CombinedResults AS ( SELECT s1.DEPARTMENT_FULL_NAME AS DEPARTMENT_NAME, s1.total_units_range, s1.total_units_variance, NULL AS avg_total_units, NULL AS stddev_total_units, s1.COURSE_DESCRIPTION_LONG, 'Math 2008 Stats' AS Reason FROM Subquery1 s1 UNION ALL SELECT s2.DEPARTMENT_NAME, NULL AS total_units_range, NULL AS total_units_variance, s2.avg_total_units, s2.stddev_total_units, NULL AS COURSE_DESCRIPTION_LONG, 'High Avg Units' AS Reason FROM Subquery2 s2 ) SELECT * FROM CombinedResults ORDER BY DEPARTMENT_NAME;\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics department combining subject unit statistics with graduate student counts\", \"desc\": \"For the Mathematics department (Course 18), provide the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units and at least 1 enrolled student), the number of graduate students in the department, and the most recent warehouse load date for those students, considering only departments that are degree granting and students whose year is 'G'. Do not return any rounded answers.\", \"id\": \"dw_1212\", \"name\": \"Math Department Subject Unit Average-Stddev with Graduate Student Count and Latest Load Date\", \"sql\": \"WITH DeptUnits AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_total_units, STDDEV(s.TOTAL_UNITS) AS stddev_total_units FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE s.TOTAL_UNITS > 0 AND s.NUM_ENROLLED_STUDENTS >= 1 AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME ORDER BY stddev_total_units DESC ), DeptStudents AS ( SELECT sd.DEPARTMENT_NAME, COUNT(msd.FULL_NAME) AS student_count, MAX(msd.WAREHOUSE_LOAD_DATE) AS latest_student_load FROM SIS_DEPARTMENT sd JOIN MIT_STUDENT_DIRECTORY msd ON sd.DEPARTMENT_CODE = msd.DEPARTMENT JOIN SIS_ADMIN_DEPARTMENT sad ON msd.DEPARTMENT = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND msd.STUDENT_YEAR = 'G' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_NAME ORDER BY student_count DESC LIMIT 10 ) SELECT du.DEPARTMENT_NAME, du.avg_total_units, du.stddev_total_units, ds.student_count, ds.latest_student_load FROM DeptUnits du JOIN DeptStudents ds ON du.DEPARTMENT_NAME = ds.DEPARTMENT_NAME;\"}], \"not_found\": []}"
    },
