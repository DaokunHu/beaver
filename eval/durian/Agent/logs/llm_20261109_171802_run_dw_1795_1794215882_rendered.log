    {
      "role": "tool",
      "tool_call_id": "call_fb5b0b4bc354449da37061b7",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"columns\": {\"TIP_SUBJECT_OFFERED_KEY\": {\"desc\": \"Surrogate key of the TIP subject offered record; joins to TIP_DETAIL.TIP_SUBJECT_OFFERED_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"IS_NO_COURSE_MATERIAL\": {\"desc\": \"'Y'/'N' flag whether the subject has no course material; 'N' means the subject has course materials\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '5.01'; joins to TIP_DETAIL.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE and STUDENT_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Chemistry', 'Mathematics'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject; used for enrollment-based rankings and window statistics\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term in the textbook program\"}, {\"id\": \"STUDENT_DEPARTMENT\", \"name\": \"STUDENT_DEPARTMENT\", \"desc\": \"Student-facing department lookup table with department code, name, full name, and school attribution (code and name). Similar in content to SIS_DEPARTMENT but oriented to student information systems reporting; joins to offering tables via DEPARTMENT_CODE.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' OFFER_DEPT_CODE and SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to\"}}, \"default_granularity\": \"one row per department\"}, {\"id\": \"dw_4812\", \"name\": \"Top 10 Degree-Granting Department Subject Code and Course Number Combinations by Unique Library Subject Count\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH DeptSubjectStats AS ( SELECT d.DEPARTMENT_NAME, s.SUBJECT_CODE, COUNT(s.SUBJECT_CODE) AS subject_code_count, MIN(d.DEPT_BUDGET_CODE) AS min_dept_budget_code FROM SIS_DEPARTMENT d JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' GROUP BY d.DEPARTMENT_NAME, s.SUBJECT_CODE ), DeptCourseStats AS ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, COUNT(DISTINCT l.LIBRARY_SUBJECT_OFFERED_KEY) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 GROUP BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ) SELECT dss.DEPARTMENT_NAME, dss.SUBJECT_CODE, dss.subject_code_count, dss.min_dept_budget_code, dcs.COURSE_NUMBER, dcs.subject_count, dcs.min_total_units FROM DeptSubjectStats dss JOIN SIS_SUBJECT_CODE ssc ON dss.SUBJECT_CODE = ssc.SUBJECT_CODE JOIN DeptCourseStats dcs ON dss.DEPARTMENT_NAME = dcs.OFFER_DEPT_NAME AND ssc.COURSE_NUMBER = dcs.COURSE_NUMBER ), SubjectMaxEnroll AS ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, ROW_NUMBER() OVER (PARTITION BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ORDER BY s.NUM_ENROLLED_STUDENTS DESC) AS rn FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 ) SELECT ic.DEPARTMENT_NAME, ic.SUBJECT_CODE, ic.subject_code_count, ic.min_dept_budget_code, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sme.SUBJECT_TITLE AS Top_Subject_Title, sme.NUM_ENROLLED_STUDENTS AS Top_Subject_Enrollment FROM inner_cte ic LEFT JOIN SubjectMaxEnroll sme ON ic.DEPARTMENT_NAME = sme.OFFER_DEPT_NAME AND ic.COURSE_NUMBER = sme.COURSE_NUMBER AND sme.rn = 1 ORDER BY ic.subject_count DESC LIMIT 10;\", \"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per top-10 department/subject-code/course-number combination with its highest-enrollment subject\"}, {\"columns\": [\"SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"SUBJECT_OFFERED_SUMMARY.NUM_ENROLLED_STUDENTS\", \"SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER\", \"TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"LIBRARY_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS\", \"SUBJECT_OFFERED.SUBJECT_ENROLLMENT_NUMBER\", \"SUBJECT_OFFERED_SUMMARY.SUBJECT_ENROLLMENT_NUMBER\"], \"comparisons\": [{\"dimension\": \"Measure meaning\", \"detail\": \"NUM_ENROLLED_STUDENTS is the headcount of students enrolled (present in SUBJECT_OFFERED at section grain, SUBJECT_OFFERED_SUMMARY at subject grain, and in TIP/LIBRARY program snapshots); SUBJECT_ENROLLMENT_NUMBER is the official subject enrollment number recorded by the registrar (SUBJECT_SUMMARY, SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY)\"}, {\"dimension\": \"Grain\", \"detail\": \"SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS is per section; SUBJECT_OFFERED_SUMMARY.NUM_ENROLLED_STUDENTS is per subject per term; SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER is the final subject-level enrollment with weekly/credit/listener breakdowns available in sibling columns\"}, {\"dimension\": \"Program scope\", \"detail\": \"TIP_SUBJECT_OFFERED and LIBRARY_SUBJECT_OFFERED enrollment values are snapshots within the textbook-program and library-reserve scopes respectively and may not cover all subjects\"}], \"decision_guide\": {\"Questions about official subject enrollment (e.g. 'subject enrollment number greater than 10')\": \"Use SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER.\", \"Questions about number of enrolled students per subject offering or per department totals\": \"Use NUM_ENROLLED_STUDENTS from SUBJECT_OFFERED_SUMMARY (subject grain) or SUBJECT_OFFERED (section grain, needs aggregation).\", \"Questions about enrollment of subjects within the textbook program or library reserve scope\": \"Use TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS or LIBRARY_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS respectively.\", \"Questions needing enrollment timing (first week, fifth week) or credit vs listener splits\": \"Use SUBJECT_SUMMARY's SUBJECT_ENROLLMENT_FIRST_WEEK / FIFTH_WEEK and *_CREDIT / *_LISTEN columns.\"}, \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\", \"id\": \"column_concept_enrollment_measures\", \"name\": \"Enrollment Measures\"}, {\"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS\", \"SUBJECT_SUMMARY.TOTAL_UNITS\", \"SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS\", \"CIS_COURSE_CATALOG.TOTAL_UNITS\", \"DRUPAL_COURSE_CATALOG.TOTAL_UNITS\"], \"comparisons\": [{\"dimension\": \"Source process\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS is the catalog-declared unit value per offering; SUBJECT_SUMMARY.TOTAL_UNITS and SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS are registrar subject-level values; CIS/DRUPAL catalog feeds carry their own copies\"}, {\"dimension\": \"Companion unit columns\", \"detail\": \"All these tables also expose LECTURE_UNITS, LAB_UNITS, and preparation units (PREPARATION_UNITS except SUBJECT_SUMMARY which uses PREP_UNITS); DESIGN_UNITS exists in COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY, CIS and DRUPAL catalogs but not in SUBJECT_OFFERED_SUMMARY\"}, {\"dimension\": \"Variability flag\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS marks subjects whose units vary; analyses of fixed-unit statistics typically filter IS_VARIABLE_UNITS='N'\"}], \"decision_guide\": {\"Unit statistics (avg/stddev/variance/geometric mean) over catalog offerings, optionally split by lecture/lab/design or filtered by variable-units flag\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS with its companion unit columns.\", \"Unit statistics tied to actual enrollment records or subject groups per term\": \"Use SUBJECT_SUMMARY.TOTAL_UNITS.\", \"Unit statistics at subject-offering rollup level with offering department/school\": \"Use SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS.\", \"Fixed-unit analyses excluding variable-unit subjects\": \"Filter COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS = 'N'.\"}, \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\", \"id\": \"column_concept_total_units\", \"name\": \"Total Credit Units\"}], \"not_found\": []}"
