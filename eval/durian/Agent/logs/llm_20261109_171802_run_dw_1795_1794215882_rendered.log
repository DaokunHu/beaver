      "content": "{\"ok\": true, \"entities\": [{\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}, {\"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"columns\": {\"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject summary record\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, COURSE_CATALOG_SUBJECT_OFFERED subject IDs\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SUBJECT_OR_CLUSTER\": {\"desc\": \"Indicator whether the row represents a subject or a cluster\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"ULT_MASTER_SUBJECT_ID\": {\"desc\": \"Ultimate master subject identifier in cluster hierarchies\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics'\"}, \"SCHOOL_CODE\": {\"desc\": \"School code, e.g. 'E' for Engineering\"}, \"SCHOOL_NAME\": {\"desc\": \"School name, e.g. 'Engineering'\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREP_UNITS\": {\"desc\": \"Preparation credit units (named PREP_UNITS here vs PREPARATION_UNITS in other tables)\"}, \"DESIGN_UNITS\": {\"desc\": \"Design credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the subject\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Final enrollment number of the cluster\"}, \"SUBJECT_GROUP_ID\": {\"desc\": \"Subject group identifier used for grouping related subjects\"}, \"SUBJECT_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Subject enrollment in the first week\"}, \"CLUSTER_ENROLLMENT_FIRST_WEEK\": {\"desc\": \"Cluster enrollment in the first week\"}, \"SUBJECT_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Subject enrollment in the fifth week\"}, \"CLUSTER_ENROLLMENT_FIFTH_WEEK\": {\"desc\": \"Cluster enrollment in the fifth week\"}, \"SUBJECT_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the subject for credit\"}, \"SUBJECT_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the subject\"}, \"CLUSTER_ENROLLMENT_CREDIT\": {\"desc\": \"Number of students enrolled in the cluster for credit\"}, \"CLUSTER_ENROLLMENT_LISTEN\": {\"desc\": \"Number of listeners enrolled in the cluster\"}, \"SUBJECT_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_1ST_CREDIT\": {\"desc\": \"First-year/first-level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_1ST_LISTEN\": {\"desc\": \"First-year/first-level listener enrollment of the cluster\"}, \"SUBJECT_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the subject\"}, \"SUBJECT_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the subject\"}, \"CLUSTER_ENROLLMENT_5TH_CREDIT\": {\"desc\": \"Fifth-year/level credit enrollment of the cluster\"}, \"CLUSTER_ENROLLMENT_5TH_LISTEN\": {\"desc\": \"Fifth-year/level listener enrollment of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject offered summary record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject; joins to SIS_SUBJECT_CODE.COURSE_NUMBER and SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'; used for school-level filtering\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"columns\": {\"SIS_COURSE_DESCRIPTION_KEY\": {\"desc\": \"Surrogate key of the course description record\"}, \"COURSE\": {\"desc\": \"Course/subject code, e.g. '18'; joins to SIS_SUBJECT_CODE.SUBJECT_CODE and COURSE_CATALOG_SUBJECT_OFFERED.SUBJECT_CODE\"}, \"COURSE_DESCRIPTION\": {\"desc\": \"Short course description text; its character length is used in description-length statistics\"}, \"COURSE_DESCRIPTION_LONG\": {\"desc\": \"Long-form course description text\"}, \"DEPARTMENT\": {\"desc\": \"Department code offering the course; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name offering the course\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME\": {\"desc\": \"School name offering the course, e.g. 'Engineering'\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"FROM_TERM\": {\"desc\": \"First term the course description is effective from\"}, \"FROM_TERM_DESCRIPTION\": {\"desc\": \"Description of the from-term\"}, \"THRU_TERM\": {\"desc\": \"Last term the course description is effective through\"}, \"THRU_TERM_DESCRIPTION\": {\"desc\": \"Description of the thru-term\"}, \"COURSE_OPTION\": {\"desc\": \"Course option designation\"}, \"COURSE_LEVEL\": {\"desc\": \"Course level code, e.g. 'U' = undergraduate, 'G' = graduate\"}, \"CIP_PROGRAM_CODE\": {\"desc\": \"Six-digit CIP (Classification of Instructional Programs) program code of the course; joins to CIP.PROGRAM_CODE (current classification, one row per code) and CIP_WITH_VERSION.PROGRAM_CODE (all revision versions)\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the course counts toward a degree\"}, \"DEFAULT_ULTIMATE_DEGREE\": {\"desc\": \"Default ultimate degree awarded for the course\"}, \"GRADAUTE_LEVEL\": {\"desc\": \"Legacy misspelled graduate level column (kept for compatibility)\"}, \"GRADUATE_LEVEL\": {\"desc\": \"Graduate level designation of the course\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per course description\"}, {\"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS_ALL.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2025FA' (FA=Fall, SP=Spring, JA=January/IAP, SU=Summer)\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description, e.g. 'Fall Term 2024-2025'\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date; can match TIME_DAY.CALENDAR_DATE for calendar-based joins\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to, e.g. 2025\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"IS_REGULAR_TERM\": {\"desc\": \"'Y'/'N' flag indicating a regular term (Fall/Spring) versus non-regular terms (Summer, January/IAP); only present in ACADEMIC_TERMS, not in ACADEMIC_TERMS_ALL\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"TERM_STATUS\": {\"desc\": \"Term status text: 'Previous', 'Current', 'Future', or 'Unspecified'\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to; used in degree-year statistics\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"ADD_DATE\": {\"desc\": \"Last day to add a subject in the term; only present in ACADEMIC_TERMS\"}, \"DROP_DATE\": {\"desc\": \"Last day to drop a subject in the term; only present in ACADEMIC_TERMS\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period for the term\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period for the term\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_36611c6a3f064f9fa53ef2c6",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per department/school enrollment statistic (plus per-school rollup rows), left joined with Mathematics students named Peter\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\", \"id\": \"dw_1350\", \"name\": \"Degree-Granting Department TIP Enrollment Statistics with School Rollups and Math Peter Student Budget Code Windows\", \"sql\": \"WITH inner_cte1 AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, tso.NUM_ENROLLED_STUDENTS FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 ), DepartmentStats AS ( SELECT DEPARTMENT_NAME, SCHOOL_NAME, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled_students, MAX(NUM_ENROLLED_STUDENTS) - MIN(NUM_ENROLLED_STUDENTS) AS range_enrolled_students, VARIANCE(NUM_ENROLLED_STUDENTS) AS var_enrolled_students, SUM(NUM_ENROLLED_STUDENTS) AS total_enrolled_students FROM inner_cte1 GROUP BY DEPARTMENT_NAME, SCHOOL_NAME ), SchoolRollup AS ( SELECT NULL AS DEPARTMENT_NAME, SCHOOL_NAME, NULL AS avg_enrolled_students, NULL AS range_enrolled_students, NULL AS var_enrolled_students, SUM(total_enrolled_students) AS total_enrolled_students FROM DepartmentStats GROUP BY SCHOOL_NAME ), inner_cte2 AS ( SELECT t1.LAST_NAME, t1.EMAIL_ADDRESS, t1.STUDENT_YEAR, t1.DEPARTMENT_NAME, t0.SCHOOL_NAME, MIN(t0.DEPT_BUDGET_CODE) OVER (ORDER BY t1.FULL_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_DEPARTMENT t0 JOIN MIT_STUDENT_DIRECTORY t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT WHERE t1.FIRST_NAME = 'Peter' AND t0.DEPARTMENT_NAME = 'Mathematics' ) SELECT ds.DEPARTMENT_NAME, ds.SCHOOL_NAME, ds.avg_enrolled_students, ds.range_enrolled_students, ds.var_enrolled_students, ds.total_enrolled_students, ic2.LAST_NAME, ic2.EMAIL_ADDRESS, ic2.STUDENT_YEAR, ic2.window_column, sd.DEPARTMENT_FULL_NAME, sd.DEPARTMENT_LAST_ACTIVITY_DATE FROM (SELECT * FROM DepartmentStats UNION ALL SELECT * FROM SchoolRollup) ds LEFT JOIN inner_cte2 ic2 ON ds.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME AND ds.SCHOOL_NAME = ic2.SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON ds.DEPARTMENT_NAME = sd.DEPARTMENT_NAME ORDER BY ds.SCHOOL_NAME, ds.DEPARTMENT_NAME, ic2.LAST_NAME ;\"}, {\"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per Engineering department above average enrollment\", \"desc\": \"For each department in the School of Engineering with total student enrollment in its courses greater than the average total enrollment across all Engineering departments (and with total enrollment greater than 50), display the department name, the total number of students enrolled in its courses, and the highest average total units for subjects it has ever offered in a regular academic term, listing the results in descending order of total enrollment. Do not return any rounded answers.\", \"id\": \"dw_4387\", \"name\": \"Engineering Departments Above-Average Enrollment with Highest Regular-Term Average Units\", \"sql\": \"WITH highest_avg_units AS ( WITH inner_cte AS ( SELECT c.DEPARTMENT_NAME, t.TERM_CODE, AVG(c.TOTAL_UNITS) AS avg_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS t ON c.TERM_CODE = t.TERM_CODE WHERE t.IS_REGULAR_TERM = 'Y' GROUP BY c.DEPARTMENT_NAME, t.TERM_CODE ) SELECT DEPARTMENT_NAME, MAX(avg_total_units) AS highest_avg_total_units FROM inner_cte GROUP BY DEPARTMENT_NAME ORDER BY highest_avg_total_units DESC ), eng_dept_enrollment AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) SELECT i.DEPARTMENT_NAME, i.total_enrollment FROM inner_cte i JOIN ( SELECT AVG(total_enrollment) AS avg_enrollment FROM ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) sub ) a ON i.total_enrollment > a.avg_enrollment ) SELECT e.DEPARTMENT_NAME, e.total_enrollment, h.highest_avg_total_units FROM eng_dept_enrollment e LEFT JOIN highest_avg_units h ON e.DEPARTMENT_NAME = h.DEPARTMENT_NAME ORDER BY e.total_enrollment DESC;\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per status-U reserve material of an above-average-enrollment Engineering department\", \"desc\": \"For each department in the School of Engineering where the total number of students enrolled in courses offered by that department is greater than the average total enrollment across all Engineering departments (and the total enrollment is greater than 50), show the department name and total enrollment, and for each such department, show the library reserve material details with material status key equal to 'U', including the library course instructor key, library reserve catalog key, term code, subject ID, the tip material key, tip material status key, tip ISBN, the subject title, the minimum tip material status key in a window of 3 preceding and 1 following row ordered by the number of enrolled students, as well as the responsible faculty name and the offer department name, for materials offered by that department. The columns should be: department name, total enrollment, library course instructor key, library reserve catalog key, term code, subject ID, tip material key, tip material status key, tip ISBN, subject title, windowed minimum tip material status key, responsible faculty name, and offer department name. Do not return any rounded answers.\", \"entity_type\": \"metric\", \"id\": \"dw_3868\", \"name\": \"Above-Average Engineering Department Enrollments with Status-U Reserve Material and Textbook Details\", \"sql\": \"WITH engineering_dept_enrollment AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) SELECT i.DEPARTMENT_NAME, i.total_enrollment FROM inner_cte i JOIN ( SELECT AVG(total_enrollment) AS avg_enrollment FROM ( SELECT s.DEPARTMENT_NAME, SUM(t.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT s JOIN TIP_SUBJECT_OFFERED t ON s.DEPARTMENT_CODE = t.OFFER_DEPT_CODE JOIN STUDENT_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE s.SCHOOL_NAME = 'Engineering' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.NUM_ENROLLED_STUDENTS) > 50 ) sub ) a ON i.total_enrollment > a.avg_enrollment ), library_reserve_materials AS ( WITH inner_cte AS ( SELECT l.LIBRARY_COURSE_INSTRUCTOR_KEY, l.LIBRARY_RESERVE_CATALOG_KEY, l.TERM_CODE, l.SUBJECT_ID, t.TIP_MATERIAL_KEY, t.TIP_MATERIAL_STATUS_KEY, t.ISBN, s.SUBJECT_TITLE, MIN(t.TIP_MATERIAL_STATUS_KEY) OVER ( ORDER BY s.NUM_ENROLLED_STUDENTS ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column, s.TIP_SUBJECT_OFFERED_KEY FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN TIP_SUBJECT_OFFERED s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE l.LIBRARY_MATERIAL_STATUS_KEY = 'U' ) SELECT inner_cte.LIBRARY_COURSE_INSTRUCTOR_KEY, inner_cte.LIBRARY_RESERVE_CATALOG_KEY, inner_cte.TERM_CODE, inner_cte.SUBJECT_ID, inner_cte.TIP_MATERIAL_KEY, inner_cte.TIP_MATERIAL_STATUS_KEY, inner_cte.ISBN, inner_cte.SUBJECT_TITLE, inner_cte.window_column, s.RESPONSIBLE_FACULTY_NAME, s.OFFER_DEPT_NAME, s.OFFER_DEPT_CODE FROM inner_cte JOIN TIP_SUBJECT_OFFERED s ON inner_cte.TIP_SUBJECT_OFFERED_KEY = s.TIP_SUBJECT_OFFERED_KEY ) SELECT ede.DEPARTMENT_NAME, ede.total_enrollment, lrm.LIBRARY_COURSE_INSTRUCTOR_KEY, lrm.LIBRARY_RESERVE_CATALOG_KEY, lrm.TERM_CODE, lrm.SUBJECT_ID, lrm.TIP_MATERIAL_KEY, lrm.TIP_MATERIAL_STATUS_KEY, lrm.ISBN, lrm.SUBJECT_TITLE, lrm.window_column, lrm.RESPONSIBLE_FACULTY_NAME, lrm.OFFER_DEPT_NAME FROM engineering_dept_enrollment ede JOIN library_reserve_materials lrm ON ede.DEPARTMENT_NAME = lrm.OFFER_DEPT_NAME\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per degree-granting department matched with Political Science HGN statistics\", \"desc\": \"For each department that grants degrees (excluding the Biology department), provide the department name, the average and variance of the total units for subjects offered by that department in the 2022 academic year, and, if the department is Political Science, also include for each HGN code the maximum number of lecture units among all subjects in the course catalog and the subject title from the subject offered table for subjects offered in the year 2012 with more than 2 lecture units, as well as the number of enrolled students for those subjects. List the results ordered by the variance of total units in descending order, and for Political Science, by the maximum lecture units in descending order. Do not return any rounded answers.\", \"id\": \"dw_2151\", \"name\": \"Degree-Granting Department 2022 Unit Average-Variance with Political Science HGN Lecture Unit Maximums\", \"sql\": \"WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, AVG(s.TOTAL_UNITS) AS avg_units, VARIANCE(s.TOTAL_UNITS) AS units_variance FROM SIS_DEPARTMENT d JOIN COURSE_CATALOG_SUBJECT_OFFERED s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE s.ACADEMIC_YEAR = 2022 AND d.IS_DEGREE_GRANTING = 'Y' AND d.DEPARTMENT_CODE <> '7' GROUP BY d.DEPARTMENT_NAME ORDER BY units_variance DESC ) , PoliSciHGNStats AS ( SELECT c.HGN_CODE, c.DEPARTMENT_NAME, MAX(c.LECTURE_UNITS) AS max_lecture_units, s.SUBJECT_TITLE, so.NUM_ENROLLED_STUDENTS FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN SUBJECT_OFFERED s ON c.HGN_CODE = s.HGN_CODE JOIN SUBJECT_OFFERED so ON s.SUBJECT_KEY = so.SUBJECT_KEY WHERE c.ACADEMIC_YEAR = 2012 AND c.LECTURE_UNITS > 2 AND c.DEPARTMENT_NAME = 'Political Science' GROUP BY c.HGN_CODE, c.DEPARTMENT_NAME, s.SUBJECT_TITLE, so.NUM_ENROLLED_STUDENTS HAVING MAX(c.LECTURE_UNITS) > 2 ) SELECT d.DEPARTMENT_NAME, d.avg_units, d.units_variance, p.HGN_CODE, p.max_lecture_units, p.SUBJECT_TITLE, p.NUM_ENROLLED_STUDENTS FROM inner_cte d LEFT JOIN PoliSciHGNStats p ON d.DEPARTMENT_NAME = p.DEPARTMENT_NAME ORDER BY d.units_variance DESC, p.max_lecture_units DESC\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department from either the Math 2008 stats branch or the high-average-units branch\", \"desc\": \"List, for each department, either (a) the department's full name, the range and variance of the total units for degree-granting Mathematics department courses offered in the 2008 academic year along with the long course description for each course (with the reason 'Math 2008 Stats'), or (b) the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units) where the average total units is greater than the overall average across all departments (with the reason 'High Avg Units'). Show the columns in the following order: department name, total units range, total units variance, average total units, standard deviation (using STDDEV only and never STDDEV_POP) of total units, long course description, and reason for inclusion. Do not return any rounded answers.\", \"id\": \"dw_1335\", \"name\": \"Union of Math 2008 Unit Range-Variance with Long Descriptions and High Average Unit Department Stddev\", \"sql\": \"WITH Subquery1 AS ( WITH inner_cte AS ( SELECT sd.DEPARTMENT_FULL_NAME, MAX(ccc.TOTAL_UNITS) - MIN(ccc.TOTAL_UNITS) AS total_units_range, VARIANCE(ccc.TOTAL_UNITS) AS total_units_variance FROM CIS_COURSE_CATALOG ccc JOIN SIS_DEPARTMENT sd ON ccc.DEPARTMENT_CODE = sd.DEPARTMENT_CODE WHERE ccc.ACADEMIC_YEAR = '2008' AND sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' AND ccc.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_FULL_NAME ) SELECT i.DEPARTMENT_FULL_NAME, i.total_units_range, i.total_units_variance, scd.COURSE_DESCRIPTION_LONG FROM inner_cte i JOIN SIS_COURSE_DESCRIPTION scd ON scd.DEPARTMENT = 18 AND scd.DEPARTMENT_NAME = 'Mathematics' ), Subquery2 AS ( WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, AVG(sos.TOTAL_UNITS) AS avg_total_units, STDDEV(sos.TOTAL_UNITS) AS stddev_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SUBJECT_OFFERED_SUMMARY sos ON scd.COURSE = sos.COURSE_NUMBER WHERE sos.TOTAL_UNITS > 0 GROUP BY scd.DEPARTMENT_NAME ) SELECT DEPARTMENT_NAME, avg_total_units, stddev_total_units FROM inner_cte WHERE avg_total_units > ( SELECT AVG(TOTAL_UNITS) FROM SUBJECT_OFFERED_SUMMARY WHERE TOTAL_UNITS > 0 ) ORDER BY stddev_total_units DESC ), CombinedResults AS ( SELECT s1.DEPARTMENT_FULL_NAME AS DEPARTMENT_NAME, s1.total_units_range, s1.total_units_variance, NULL AS avg_total_units, NULL AS stddev_total_units, s1.COURSE_DESCRIPTION_LONG, 'Math 2008 Stats' AS Reason FROM Subquery1 s1 UNION ALL SELECT s2.DEPARTMENT_NAME, NULL AS total_units_range, NULL AS total_units_variance, s2.avg_total_units, s2.stddev_total_units, NULL AS COURSE_DESCRIPTION_LONG, 'High Avg Units' AS Reason FROM Subquery2 s2 ) SELECT * FROM CombinedResults ORDER BY DEPARTMENT_NAME;\"}], \"not_found\": []}"
    },
