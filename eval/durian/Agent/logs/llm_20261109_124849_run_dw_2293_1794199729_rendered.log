      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Department Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per degree-granting Engineering department\", \"desc\": \"For each degree-granting department that offered at least one subject in the School of Engineering in 2021 and has more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the total number of tip materials, the average number of enrolled students per subject (rounded to two decimal places), and the ratio of total enrolled students to total tip materials (rounded to two decimal places), listing the results in descending order of the average number of enrolled students per subject.\", \"id\": \"dw_4650\", \"name\": \"Engineering Degree-Granting Departments 2021 Enrollment per Subject and per TIP Material Ratios\", \"sql\": \"WITH inner_cte AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ) SELECT icte.DEPARTMENT_CODE, icte.DEPARTMENT_NAME, icte.DEPARTMENT_FULL_NAME, icte.subject_count, icte.total_enrollment, dtm.total_tip_materials, ROUND(icte.total_enrollment / NULLIF(icte.subject_count, 0), 2) AS Avg_Enrollment_per_Subject, ROUND(icte.total_enrollment / NULLIF(dtm.total_tip_materials, 0), 2) AS Enrollment_per_TipMaterial FROM inner_cte icte JOIN ( SELECT s.DEPARTMENT_NAME, SUM(t.RECORD_COUNT) AS total_tip_materials FROM TIP_DETAIL t JOIN ACADEMIC_TERMS a ON t.TERM_CODE = a.TERM_CODE JOIN SUBJECT_SUMMARY s ON a.TERM_CODE = s.TERM_CODE AND t.SUBJECT_ID = s.SUBJECT_ID WHERE s.SCHOOL_NAME = 'Engineering' AND a.IS_REGULAR_TERM = 'Y' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.RECORD_COUNT) > 10 ) dtm ON icte.DEPARTMENT_NAME = dtm.DEPARTMENT_NAME ORDER BY Avg_Enrollment_per_Subject DESC;\"}, {\"category\": \"Department Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per department\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, or for each department that offered more than 10 tip materials for subjects in the School of Engineering during regular terms, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, and the total number of tip materials. List the department code, department name, department full name, number of subjects offered, total number of enrolled students, and total number of tip materials in that order. Do not return any rounded answers.\", \"id\": \"dw_3727\", \"name\": \"Engineering Degree-Granting Departments 2021 Subject Counts and TIP Material Totals Union\", \"sql\": \"WITH DeptSubjects AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), DeptTipMaterials AS ( SELECT s.DEPARTMENT_NAME, SUM(t.RECORD_COUNT) AS total_tip_materials FROM TIP_DETAIL t JOIN ACADEMIC_TERMS a ON t.TERM_CODE = a.TERM_CODE JOIN SUBJECT_SUMMARY s ON a.TERM_CODE = s.TERM_CODE AND t.SUBJECT_ID = s.SUBJECT_ID WHERE s.SCHOOL_NAME = 'Engineering' AND a.IS_REGULAR_TERM = 'Y' GROUP BY s.DEPARTMENT_NAME HAVING SUM(t.RECORD_COUNT) > 10 ), CombinedDept AS ( SELECT ds.DEPARTMENT_CODE, ds.DEPARTMENT_NAME, ds.DEPARTMENT_FULL_NAME, ds.subject_count, ds.total_enrollment, dtm.total_tip_materials FROM DeptSubjects ds LEFT JOIN DeptTipMaterials dtm ON ds.DEPARTMENT_NAME = dtm.DEPARTMENT_NAME UNION ALL SELECT NULL AS DEPARTMENT_CODE, dtm.DEPARTMENT_NAME, NULL AS DEPARTMENT_FULL_NAME, NULL AS subject_count, NULL AS total_enrollment, dtm.total_tip_materials FROM DeptTipMaterials dtm LEFT JOIN DeptSubjects ds ON dtm.DEPARTMENT_NAME = ds.DEPARTMENT_NAME WHERE ds.DEPARTMENT_NAME IS NULL ) SELECT * FROM CombinedDept ORDER BY DEPARTMENT_NAME;\"}, {\"id\": \"dw_1973\", \"name\": \"Math 2022 Letter-Graded Subjects with TIP Materials Ranked by Term with 3-Row Max Units\", \"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"desc\": \"For all subjects offered in the academic year 2022 by the Mathematics department that have at least one associated TIP material and are also offered this year as letter graded, show the subject ID, subject title, term code, term description, the rank of each subject within its term (ordered by subject ID), subject code, subject number, department name, academic year, the maximum total units for each subject considering the current row and the next 2 rows ordered by subject code, and the start and end dates of the term. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.TERM_CODE, s1.TERM_DESCRIPTION, s1.window_column, s2.SUBJECT_CODE, s2.SUBJECT_NUMBER, s2.DEPARTMENT_NAME, s2.ACADEMIC_YEAR, s2.max_total_units_3rows FROM ( SELECT c.SUBJECT_ID, c.SUBJECT_TITLE, c.TERM_CODE, a.TERM_DESCRIPTION, RANK() OVER (PARTITION BY c.TERM_CODE ORDER BY c.SUBJECT_ID) AS window_column FROM COURSE_CATALOG_SUBJECT_OFFERED c INNER JOIN ACADEMIC_TERMS_ALL a ON c.TERM_CODE = a.TERM_CODE INNER JOIN TIP_DETAIL t ON a.TERM_CODE = t.TERM_CODE AND c.SUBJECT_ID = t.SUBJECT_ID WHERE c.ACADEMIC_YEAR = 2022 AND c.DEPARTMENT_NAME = 'Mathematics' ) s1 JOIN ( SELECT c.SUBJECT_CODE, c.SUBJECT_NUMBER, c.SUBJECT_TITLE, c.DEPARTMENT_NAME, c.ACADEMIC_YEAR, c.TERM_CODE, a.TERM_DESCRIPTION, GREATEST( c.TOTAL_UNITS, COALESCE(LEAD(c.TOTAL_UNITS, 1) OVER (PARTITION BY c.SUBJECT_CODE, c.SUBJECT_NUMBER ORDER BY c.SUBJECT_CODE), 0), COALESCE(LEAD(c.TOTAL_UNITS, 2) OVER (PARTITION BY c.SUBJECT_CODE, c.SUBJECT_NUMBER ORDER BY c.SUBJECT_CODE), 0) ) AS max_total_units_3rows FROM COURSE_CATALOG_SUBJECT_OFFERED c JOIN ACADEMIC_TERMS a ON c.TERM_CODE = a.TERM_CODE WHERE c.DEPARTMENT_NAME = 'Mathematics' AND c.IS_OFFERED_THIS_YEAR = 'Y' AND c.GRADE_TYPE = 'L' ORDER BY c.SUBJECT_CODE, c.SUBJECT_NUMBER, c.TERM_CODE ) s2 ON s1.SUBJECT_ID = CONCAT(s2.SUBJECT_CODE, '.', s2.SUBJECT_NUMBER) AND s1.TERM_CODE = s2.TERM_CODE ) SELECT i.SUBJECT_ID, i.SUBJECT_TITLE, i.TERM_CODE, i.TERM_DESCRIPTION, i.window_column, i.SUBJECT_CODE, i.SUBJECT_NUMBER, i.DEPARTMENT_NAME, i.ACADEMIC_YEAR, i.max_total_units_3rows, t.TERM_START_DATE, t.TERM_END_DATE FROM inner_cte i JOIN ACADEMIC_TERMS t ON i.TERM_CODE = t.TERM_CODE ORDER BY i.TERM_CODE, i.SUBJECT_ID;\", \"default_granularity\": \"one row per subject per term\"}], \"not_found\": []}"
