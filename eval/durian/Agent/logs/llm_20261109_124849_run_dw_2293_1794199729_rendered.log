      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_4640\", \"name\": \"2017JA Subject Enrollment Windows with Department Enrollment Coefficient of Variation and School Code\", \"desc\": \"For each subject offered in the term '2017JA', what is the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code, the coefficient of variation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in the subjects offered by that department (considering only subjects with at least one enrolled student), and the department's school code? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH DeptVariation AS ( SELECT sd.DEPARTMENT_NAME, STDDEV(tso.NUM_ENROLLED_STUDENTS) / NULLIF(AVG(tso.NUM_ENROLLED_STUDENTS), 0) AS coefficient_of_variation FROM TIP_SUBJECT_OFFERED tso JOIN STUDENT_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE WHERE tso.NUM_ENROLLED_STUDENTS > 0 GROUP BY sd.DEPARTMENT_NAME HAVING AVG(tso.NUM_ENROLLED_STUDENTS) > 0 ORDER BY coefficient_of_variation DESC ), Subjects2017JA AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, t1.DEPARTMENT_NAME, t1.DEPARTMENT_CODE, MIN(t0.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t1.DEPARTMENT_CODE ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ) SELECT s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, s.RESPONSIBLE_FACULTY_NAME, s.OFFER_DEPT_NAME, s.DEPARTMENT_FULL_NAME, s.SCHOOL_NAME, s.window_column, dv.coefficient_of_variation, sd.SCHOOL_CODE FROM Subjects2017JA s LEFT JOIN DeptVariation dv ON s.DEPARTMENT_NAME = dv.DEPARTMENT_NAME JOIN STUDENT_DEPARTMENT sd ON s.DEPARTMENT_CODE = sd.DEPARTMENT_CODE ) SELECT * FROM inner_cte;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA TIP subject offering enriched with department-level enrollment coefficient of variation and school code\"}, {\"category\": \"Subject Offering and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA subject matched with 2022FA catalog subject in same department\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, and the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code. Additionally, for subjects offered in the term with code '2022FA' in the same department, provide the subject ID, department name, term description, the running sum of total units within each academic year ordered by subject ID, and the subject's short title and responsible faculty name from the course catalog. Do not return any rounded answers.\", \"id\": \"dw_5103\", \"name\": \"2017JA TIP Subjects Enrollment Windows Matched with 2022FA Catalog Running Unit Sums per Department\", \"sql\": \"WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, MIN(t0.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.DEPARTMENT_CODE ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t0.OFFER_DEPT_CODE FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ), Subq2 AS ( SELECT t1.SUBJECT_ID, t1.DEPARTMENT_NAME, t0.TERM_DESCRIPTION, SUM(t1.TOTAL_UNITS) OVER (PARTITION BY t1.ACADEMIC_YEAR ORDER BY t1.SUBJECT_ID) AS running_sum_total_units, t1.DEPARTMENT_CODE, t1.SUBJECT_SHORT_TITLE, t1.RESPONSIBLE_FACULTY_NAME AS CATALOG_RESPONSIBLE_FACULTY_NAME FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TERM_CODE = '2022FA' ) SELECT s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.RESPONSIBLE_FACULTY_NAME, s1.OFFER_DEPT_NAME, s1.DEPARTMENT_FULL_NAME, s1.SCHOOL_NAME, s1.window_column AS min_enrolled_window, s2.SUBJECT_ID, s2.DEPARTMENT_NAME, s2.TERM_DESCRIPTION, s2.running_sum_total_units, s2.SUBJECT_SHORT_TITLE, s2.CATALOG_RESPONSIBLE_FACULTY_NAME FROM inner_cte s1 JOIN Subq2 s2 ON s1.OFFER_DEPT_CODE = s2.DEPARTMENT_CODE ORDER BY s1.OFFER_DEPT_NAME, s2.SUBJECT_ID\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per library subject\", \"desc\": \"For subjects with at least 5 enrolled students that are offered by the library in the term with code '2014FA', show the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, row number within each material status group ordered by subject ID, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, ordered by offering department name, material status key, and subject ID. Do not return any rounded answers.\", \"id\": \"dw_3393\", \"name\": \"2014FA Library Subjects with 5+ Enrolled Students by Material Status and Department Min Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.TERM_CODE, t1.TIP_MATERIAL_STATUS_KEY, t1.ISBN, ROW_NUMBER() OVER (PARTITION BY t1.TIP_MATERIAL_STATUS_KEY ORDER BY t0.SUBJECT_ID) AS window_column FROM LIBRARY_SUBJECT_OFFERED t0 JOIN TIP_DETAIL t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.NUM_ENROLLED_STUDENTS >= 5 ), Subq2 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.TERM_START_DATE, t1.TERM_END_DATE, min(t0.NUM_ENROLLED_STUDENTS) OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.OFFER_DEPT_NAME) AS min_enrolled_per_dept FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2014FA' ) SELECT s1.SUBJECT_ID, s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.TERM_CODE, s1.TIP_MATERIAL_STATUS_KEY, s1.ISBN, s1.window_column, s2.OFFER_DEPT_NAME, s2.TERM_DESCRIPTION, s2.TERM_START_DATE, s2.TERM_END_DATE, s2.min_enrolled_per_dept FROM Subq1 s1 JOIN Subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID ORDER BY s2.OFFER_DEPT_NAME, s1.TIP_MATERIAL_STATUS_KEY, s1.SUBJECT_ID\"}], \"not_found\": []}"
