    {
      "role": "tool",
      "tool_call_id": "call_f591fdfbaee2461abe07ab5e",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"count\": 21, \"items\": [{\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"entity_type\": \"table\", \"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Textbook Information Program (TIP) detail table linking subjects offered in a term to their course textbook materials: material key, material status (e.g. 'RQ' Required, 'EO' Electronic options), ISBN, and record count. Used to determine whether subjects have required textbooks and to count course materials per status.\", \"entity_type\": \"table\", \"id\": \"TIP_DETAIL\", \"name\": \"TIP_DETAIL\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"entity_type\": \"table\", \"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Library reserve material detail bridge table linking reserve catalog items, library subject offerings, course instructors, and material status per term. Used to count reserved materials per subject and to filter by library material status (e.g. 'U').\", \"entity_type\": \"table\", \"id\": \"LIBRARY_RESERVE_MATRL_DETAIL\", \"name\": \"LIBRARY_RESERVE_MATRL_DETAIL\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Independent Activities Period (IAP) subject detail table: one row per IAP activity offered in a January term, with activity title/description, enrollment type, maximum enrollment, fee, prerequisites, preregistration deadline, cancellation and multiple-session flags, and foreign keys to category, sponsor, session, and person tables.\", \"entity_type\": \"table\", \"id\": \"IAP_SUBJECT_DETAIL\", \"name\": \"IAP_SUBJECT_DETAIL\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Textbook Information Program (TIP) subject offered table: one row per subject offered in a term within the textbook program scope, with subject identity, offering department/school, responsible faculty, enrollment count, and a flag indicating whether the subject has no course material. Parent of TIP_DETAIL via TIP_SUBJECT_OFFERED_KEY.\", \"entity_type\": \"table\", \"id\": \"TIP_SUBJECT_OFFERED\", \"name\": \"TIP_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\", \"entity_type\": \"table\", \"id\": \"ACADEMIC_TERMS_ALL\", \"name\": \"ACADEMIC_TERMS_ALL\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\", \"entity_type\": \"table\", \"id\": \"LIBRARY_SUBJECT_OFFERED\", \"name\": \"LIBRARY_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Library subject offered table: subjects offered per term that appear in library reserve processing, with subject identity, course number, offering department/school, responsible faculty, and enrollment count. Parent of LIBRARY_RESERVE_MATRL_DETAIL via LIBRARY_SUBJECT_OFFERED_KEY.\", \"entity_type\": \"table\", \"id\": \"LIBRARY_SUBJECT_OFFERED\", \"name\": \"LIBRARY_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\", \"entity_type\": \"table\", \"id\": \"SIS_SUBJECT_CODE\", \"name\": \"SIS_SUBJECT_CODE\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"entity_type\": \"table\", \"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\"}, {\"relation_type\": \"concept\", \"direction\": \"incoming\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\", \"entity_type\": \"concept\", \"id\": \"concept_subject_offering_facts\", \"name\": \"Subject Offering Fact Tables\"}, {\"relation_type\": \"concept\", \"direction\": \"incoming\", \"desc\": \"Tables covering course material provisioning: the Textbook Information Program (TIP) tracking textbook adoption status per subject offering, and library reserve processing tracking catalog items placed on reserve for subjects. They jointly answer questions about which subjects have course materials/textbooks, material status (TIP statuses such as 'RQ' Required, 'EO' Electronic options; library statuses such as 'U' Unknown, 'Y' Required Course Material), ISBNs, record counts, and reserve catalog item attributes. The two programs are linked by SUBJECT_ID + TERM_CODE.\", \"entity_type\": \"concept\", \"id\": \"concept_course_material_programs\", \"name\": \"Course Material and Library Reserve Domain\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Term code columns in YYYYTT format (e.g. '2025FA', '2019SP', '2021JA', '2012SU'; TT = FA Fall, SP Spring, JA January/IAP, SU Summer) appearing across term dimension and fact tables. They are the universal join key linking subject offerings, textbook materials, library reserves, and IAP activities to term attributes.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_term_code\", \"name\": \"Term Code\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Subject identifier columns shared across catalog, registrar, textbook-program, and library tables. SUBJECT_ID is the cross-domain subject join key in 'CODE.NUMBER' format (e.g. '18.01'); it appears in every subject-related fact table but at different grains and program scopes.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_subject_id\", \"name\": \"Subject Identifier\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_department_name\", \"name\": \"Department Name\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Enrollment measure columns across subject offering, summary, textbook-program, and library tables. Two families exist: NUM_ENROLLED_STUDENTS (student headcount snapshots) and SUBJECT_ENROLLMENT_NUMBER (official registrar enrollment), at section, subject, or program scope.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_enrollment_measures\", \"name\": \"Enrollment Measures\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Master subject identifier columns (MASTER_SUBJECT_ID and its sortable variant MASTER_SUBJECT_ID_SORT) replicated across the registrar offering tables, the subject summary, the textbook program, the library reserve program, and the CIS course catalog. For clustered subjects (e.g. joint or cross-listed offerings), the master subject identifier points to the leading subject of the cluster, so joining on it matches offerings that share the same master subject even when their own SUBJECT_ID differs. SUBJECT_ID/SUBJECT_ID_SORT identify the subject itself, while MASTER_SUBJECT_ID/MASTER_SUBJECT_ID_SORT identify the cluster's master; the _SORT columns are the sortable forms of the same values used for cross-table joins.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_master_subject_id\", \"name\": \"Master Subject Identifier\"}]}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_e727516a4cf543ba8d1a0c08",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"table_id\": \"LIBRARY_SUBJECT_OFFERED\", \"table_name\": \"LIBRARY_SUBJECT_OFFERED\", \"count\": 28, \"items\": [{\"metric_id\": \"dw_2628\", \"name\": \"Subject Group Max Enrollment and Average Total Units in Term 2019SP\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For each subject group in the term \\\"2019SP\\\", show the subject group ID and the highest number of enrolled students among all subjects in that group, along with the average total units for the group. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3248\", \"name\": \"2024 12-Unit Subjects Matched with Math Library Regular-Term Offerings and 3-Row Max Units\", \"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units that are also offered in the library by the Mathematics department during regular terms, show the subject code, subject number, subject title, department name, term description, the rank of each subject within its department ordered by subject code, the number of enrolled students, offering department name, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3357\", \"name\": \"Reserve Materials Status U Matched with Required Textbooks by Material Key and Year\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each library reserve material detail with material status key 'U', show the reserve catalog key, subject offered key, term code, academic year, term description, tip material key, tip material status key, and the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, along with the corresponding textbook material in the TIP_DETAIL table with material status key 'RQ' that matches on tip material key and academic year, showing the textbook subject offered key, textbook material key, subject ID, textbook academic year, textbook term description, and the row number within each textbook academic year group ordered by term code. Present the results in the order of reserve material academic year descending and textbook row number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3393\", \"name\": \"2014FA Library Subjects with 5+ Enrolled Students by Material Status and Department Min Enrollment\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For subjects with at least 5 enrolled students that are offered by the library in the term with code '2014FA', show the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, row number within each material status group ordered by subject ID, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, ordered by offering department name, material status key, and subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3736\", \"name\": \"Subjects with Required Textbooks and Advance Sign-Up IAP Activities Max Enrollment 12\", \"category\": \"Library Reserve and IAP Activity Comprehensive Analysis\", \"desc\": \"For each subject that both has a material status key of 'RQ' and also has an activity with enrollment type \\\"Advance sign-up required\\\" and a maximum enrollment of 12, show the subject title, the number of enrolled students from the RQ group, the term code from the library reserve material detail, the offer department name, the responsible faculty name, the tip material key, the row number within each tip material status key group ordered by subject title, the activity title, the term code from the IAP subject detail, the maximum enrollment, the term description, the term start date, the number of enrolled students from the IAP group, and the row number within each subject title group ordered by activity title. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3911\", \"name\": \"2014FA Library Subjects Enrollment Rollup by Department with Required Textbook Windowed Record Counts\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For each subject offered by the library in the term with code '2014FA', show the subject ID, subject title, total number of enrolled students, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, as well as the maximum windowed average record count from tip detail records with material status key 'RQ' (using a window of 2 preceding and 2 following rows grouped by financial aid year). Additionally, for each offering department, include a grand total row showing the total number of enrolled students across all its subjects (with nulls for subject ID and subject title), and the corresponding maximum windowed average record count if available. Order the results by offering department name and subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3959\", \"name\": \"2022FA Subjects Running Unit Sums Matched with Advance Sign-Up IAP Activities\", \"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"desc\": \"For subjects offered in the term with code '2022FA' that also have at least one activity with an enrollment type of \\\"Advance sign-up required\\\" and a maximum enrollment of 12 (where the number of enrolled students is at least 10), show the subject ID, department name, subject term description, the running sum of total units within each academic year, subject title, whether the subject is offered in the fall term, the activity title, activity term code, activity maximum enrollment, activity term description, activity term start date, number of enrolled students in the activity, the offer department name for the activity, the responsible faculty name for the activity, and the row number of the activity within each subject title group, ordered by subject ID and activity title. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4069\", \"name\": \"Advance Sign-Up IAP Activities Max Enrollment 12 Matched with Library Subjects 5+ Enrolled\", \"category\": \"IAP Activity and Library Reserve Comprehensive Analysis\", \"desc\": \"For subjects with an enrollment type of \\\"Advance sign-up required\\\" and a maximum enrollment of 12, and with at least 5 enrolled students, show the subject's activity title, term code, maximum enrollment, term description, term start date, subject title, number of enrolled students, the responsible faculty name, the row number within each subject title group ordered by activity title, the TIP material status key, the ISBN, and the row number within each material status group ordered by subject ID. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4566\", \"name\": \"Fall 2024-2025 Subjects with Status-U Library Reserve Materials Ranked per Department\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For each subject offered in the term with the description \\\"Fall Term 2024-2025\\\" that also has more than 0 enrolled students and a material status key of 'U', show the subject offered key, subject title, offering department name, the term description, the rank of each subject within its offering department, the course number, course number description, number of enrolled students, the reserve catalog key, the dense rank over the material status key, and the academic year description, ordered by subject offered key and course number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4583\", \"name\": \"Status-U Reserve Materials Record Count Windows with Catalog Record Counter Statistics\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each library reserve material detail with material status key 'U', show the reserve catalog key, subject offered key, term code, the academic year, the term description, the tip material key, the tip material status key, and the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, along with the average and variance of the record counter for reserve catalog items associated with that material status key where the catalog year is greater than 2000. Additionally, for each result, include the catalog title and catalog author name from the reserve catalog. Present the results ordered by academic year descending and record counter variance descending. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4584\", \"name\": \"Mathematics Library Subjects Above Yearly Average Enrollment in Previous Terms\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For Mathematics department courses with at least 5 enrolled students, show the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, and the average calendar year within each calendar year group ordered by term start date, but only for academic terms where the term status is 'Previous', and only include results where the number of enrolled students is greater than the average number of enrolled students for that academic year. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4658\", \"name\": \"Mathematics Library Subjects 5+ Enrolled in Previous Terms with Faculty and Calendar Attributes\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"Show the Mathematics department courses with at least 5 enrolled students, including the course number, subject title, number of enrolled students, term description, academic year, the row number within each academic year group ordered by course number, the term start date, calendar date, day of week, the average calendar year within each calendar year group ordered by term start date, and for each course, also display the responsible faculty name and the offer school name, but only for academic terms where the term status is 'Previous'. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4683\", \"name\": \"Current Term Department Enrollments with Library Course Counts and Min Units\", \"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4701\", \"name\": \"Yearly Geometric Mean Reserve Materials per Subject with Fall Term Unit Statistics\", \"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"desc\": \"For each academic year, what is the academic year, academic year description, the geometric mean of the number of library reserve material details per subject offered (considering only records where the material status is 'U' and the academic term is a regular term), the average total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the average number of design units for subjects that are offered in the fall term and have a material status of 'U' in the library reserve? List the results ordered by the geometric mean of materials per subject in descending order, then by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4724\", \"name\": \"Mathematics Library Regular-Term Subjects 3-Row Max Units with Required Material Department Statistics\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each subject offered in the library in the Mathematics department during regular terms, show the subject title, number of enrolled students, offering department name, term description, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Additionally, for the corresponding offering department and school, provide the number of unique subjects with course material status 'RQ' and the minimum total units for those subjects. Also, include the department phone number and the school name for the offering department, and display the responsible faculty name for each subject. The columns should be shown in the following order: subject title, number of enrolled students, offering department name, term description, academic year, subject short title, maximum total units for each row and the next two rows, number of unique subjects with course material status 'RQ', minimum total units for those subjects, department phone number, school name, and responsible faculty name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4826\", \"name\": \"Status-U Reserve Materials Windowed Year and Record Count Statistics with Normalized Ratio\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each library reserve material with material status key 'U', list the subject ID, library course instructor key, term description, academic year, term start date, the minimum academic year in a window of 3 preceding and 1 following row ordered by library reserve catalog key, the library subject offered key, the tip material key, the tip material status key, the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, and for each, include the academic year description and the last day of final exam from the ACADEMIC_TERMS_ALL table, and calculate the normalized year to average record count ratio (academic year divided by average record count in the window), ordered by the normalized year to average record count ratio descending.\"}, {\"metric_id\": \"dw_4978\", \"name\": \"Status-U Reserve Materials Matched with Required Textbooks Including Term Start and End Dates\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each library reserve material detail with material status key 'U', show the reserve catalog key, subject offered key, term code, academic year, term description, tip material key, tip material status key, and the average record count in a window of 2 preceding and 2 following rows grouped by the tip material status key and ordered by the academic year, along with the corresponding textbook material in the TIP_DETAIL table with material status key 'RQ' that matches on tip material key and academic year, showing the textbook subject offered key, textbook material key, subject ID, textbook academic year, textbook term description, and the row number within each textbook academic year group ordered by term code. Additionally, for each matching textbook material, include the term start date and term end date from the ACADEMIC_TERMS_ALL table. Present the results in the order of reserve material academic year descending and textbook row number. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1288\", \"name\": \"Math IAP Max Enrollment Variance Rollup with Library and TIP Department Enrollment Totals\", \"category\": \"Library Reserve and IAP Activity Comprehensive Analysis\", \"desc\": \"For each academic year, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the maximum enrollment for IAP activities offered in that year by the Mathematics department, considering only activities that require advance sign-up and are not cancelled, and also provide the academic year description? For each department, include a grand total for all activities in the format of (department name, null, total variance and stddev). Additionally, for each such department, provide the department code, the department name, and the total number of enrolled students in both the library and tip subject offerings, but only for those departments where the total number of enrolled students is more than one standard deviation (using STDDEV only and never STDDEV_POP) above the mean total enrolled students across all departments, and restrict your answer to departments whose name is 'Mathematics' (Course 18). Also, for each such department, list the names of the responsible faculty members from both the library and tip subject offerings. The columns to display, in order, are: department name, academic year description, total variance, total standard deviation (using STDDEV only and never STDDEV_POP), department code, department name, total enrolled, library faculty, and tip faculty. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1301\", \"name\": \"Math Yearly Max Total Units with Fall-Term Library Enrollment Stddev and Equivalent Subjects\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"desc\": \"For each academic year, where the maximum number of total units for any Mathematics (Course 18) subject offered in that year is greater than 9 and there are more than 5 Mathematics subjects offered in the fall term, what are the academic year, the maximum total units, the corresponding term description, the subject title, the academic year description, the standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in library subjects offered during terms in that year, and the average number of equivalent subjects for those library subjects? List the results in order of academic year. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2180\", \"name\": \"2014FA Chemistry Library Subjects Windowed Enrollment with Math Unit Coefficient of Variation and Required Material Counts\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, and for each academic year, also show the academic year and academic year description and the coefficient of variation (using STDDEV only and never STDDEV_POP) of the total units for subjects in the Mathematics department (Course 18) that have more than 0 total units and are offered in terms with a term status indicator of 'P'. Additionally, for each Chemistry subject, include the number of required TIP materials (where TIP_MATERIAL_STATUS_KEY = 'RQ') for that subject in that term. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3436\", \"name\": \"Union of Library Subjects 5+ Enrolled and IAP Activities Max Enrollment 12\", \"category\": \"Library Reserve and IAP Activity Comprehensive Analysis\", \"desc\": \"List all subjects with at least 5 enrolled students, showing the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, and the row number within each material status group ordered by subject ID, as well as all IAP subject activities with a maximum enrollment of 12, showing the subject ID, activity title, enrollment type, term description, and the rank of each record within each term description group ordered by activity title. Indicate the source of each record as either 'LibrarySubject' or 'IAPActivity'. The columns should be: subject ID, subject title, number of enrolled students, term code, material status key, ISBN, window column, activity title, enrollment type, term description, and source. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1766\", \"name\": \"Math Degree-Granting Course Level Counts with Min Units, Course Options, and Highest Term Average Library Enrollment\", \"category\": \"Course Catalog and Department Analysis\", \"desc\": \"For each department name and course level where the course is degree granting, the total units are greater than 6, and the department is Mathematics (Course 18), provide the department name, course level, number of unique courses, minimum total units offered, school name, number of distinct course options available, and the highest average number of enrolled students in any term for courses offered by that department, considering only courses with more than 0 enrolled students and departments whose name is not null. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_3311\", \"name\": \"Status-U Library Subjects with Enrollment Matched with Department Offered-This-Year Unit Dispersion\", \"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1221\", \"name\": \"2014FA Chemistry Library Subjects Windowed Enrollment with Department Reserve Enrollment Average and Normalized Ratio\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, and the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, as well as the average and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in courses with at least one reserved library material and a material status of 'U' offered by either the Chemistry or Biology department, and calculate the normalized enrollment ratio (the number of enrolled students in the library subject divided by the average enrollment for the department, rounded to two decimal places). List the results in descending order of normalized enrollment ratio.\"}, {\"metric_id\": \"dw_4458\", \"name\": \"2009SP Status-U Reserve Materials Windowed Faculty Row Numbers with EECS Course Student Directory Details\", \"category\": \"Library Reserve and Student Directory Comprehensive Analysis\", \"desc\": \"For each library reserve material detail with material status key 'U' and term code '2009SP', show the course instructor key, reserve catalog key, subject offered key, the responsible faculty name, and the row number within a window of 2 preceding and 1 following rows ordered by the responsible faculty name from the associated subject offered, and for each matching course in the \\\"Electrical Eng & Computer Sci\\\" department, show the course description, course level, the full name and email address of students enrolled, and the row number within each course level group ordered by the student's last name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_1165\", \"name\": \"Library-TIP Matched Subjects by Faculty or Enrollment with Degree-Granting Graduate Department Enrollment Dispersion\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For each subject where the responsible faculty MIT ID in the library subject offered table is 928034000 or the number of enrolled students in the tip subject offered table is greater than 5, and where the offer department name in the tip subject offered table is either 'Chemistry' or 'Biology', show the subject title from the library subject offered table, the offer department name from the tip subject offered table, the term code from both tables, the number of enrolled students from both tables, and the minimum number of enrolled students in the tip subject offered table over each master subject ID group. Additionally, for the department offering the subject, show the department name, the range of enrolled students, and the variance of enrolled students in the subjects offered by that department, considering only departments that grant degrees, courses that are at the graduate level, and excluding the Biology department. Present the results ordered by subject title and department name. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_2591\", \"name\": \"2014FA Enrolled Library Subjects with TIP Material Status and 3-Row Min Total Units\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"desc\": \"For all subjects in the 2014FA term with at least one enrolled student, show the subject title, offering department name, responsible faculty name, the TIP material status key, the total number of units, and the minimum total number of units in a window of 3 preceding and 1 following row ordered by the course number, along with the cluster type description and the HGN code description for each subject. Do not return any rounded answers.\"}, {\"metric_id\": \"dw_4812\", \"name\": \"Top 10 Degree-Granting Department Subject Code and Course Number Combinations by Unique Library Subject Count\", \"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"desc\": \"From the top 10 combinations of department name, subject code, and course number (where the department is degree granting and the number of enrolled students in the subject summary is greater than 2) with the highest number of unique library subjects offered, display the department name, subject code, number of subject codes, minimum department budget code, course number, number of unique library subjects offered, minimum total units, the subject title with the most enrolled students for that course, and the corresponding number of enrolled students. Do not return any rounded answers.\"}]}"
