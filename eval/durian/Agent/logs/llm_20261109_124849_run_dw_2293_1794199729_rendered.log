    {
      "role": "tool",
      "tool_call_id": "call_766ed3b08cf441be83c1e004",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Textbook Material and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject matched between TIP material and master section scopes\", \"desc\": \"For each subject offered in the same term as a TIP detail record with material status 'RQ', show the subject key, subject title, offer department name, TIP material key, and the rank of each record within each offer department name group ordered by subject key, along with the subject title, subject ID, offer department name, offer school name, term description, academic year, and the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject key, where the subject, term, and offer department name match in both cases. List the columns in the following order: subject key, subject title, offer department name, TIP material key, rank, subject title (from the second subquery), subject ID, offer department name (from the second subquery), offer school name, term description, academic year, and the maximum number of enrolled students. Do not return any rounded answers.\", \"id\": \"dw_3398\", \"name\": \"Required-Textbook Subjects Ranked per Department Matched with Master Section 3-Row Max Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_KEY, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TIP_MATERIAL_KEY, RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.SUBJECT_KEY) AS window_column, t0.TERM_CODE, t0.SUBJECT_ID FROM SUBJECT_OFFERED t0 JOIN TIP_DETAIL t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.TIP_MATERIAL_STATUS_KEY = 'RQ' ), Subq2 AS ( SELECT t1.SUBJECT_TITLE, t1.SUBJECT_ID, t1.OFFER_DEPT_NAME, t1.OFFER_SCHOOL_NAME, t0.TERM_DESCRIPTION, t0.ACADEMIC_YEAR, MAX(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.SUBJECT_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_enrolled_students, t1.TERM_CODE FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.IS_MASTER_SECTION = 'Y' AND t0.TERM_STATUS_INDICATOR = 'P' ) SELECT s1.SUBJECT_KEY, s1.SUBJECT_TITLE, s1.OFFER_DEPT_NAME, s1.TIP_MATERIAL_KEY, s1.window_column, s2.SUBJECT_TITLE AS s2_SUBJECT_TITLE, s2.SUBJECT_ID, s2.OFFER_DEPT_NAME AS s2_OFFER_DEPT_NAME, s2.OFFER_SCHOOL_NAME, s2.TERM_DESCRIPTION, s2.ACADEMIC_YEAR, s2.max_enrolled_students FROM Subq1 s1 JOIN Subq2 s2 ON s1.SUBJECT_ID = s2.SUBJECT_ID AND s1.TERM_CODE = s2.TERM_CODE AND s1.OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME ORDER BY s1.OFFER_DEPT_NAME, s1.SUBJECT_KEY;\"}, {\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per top-10 Engineering subject by windowed max enrollment\", \"desc\": \"From the top 10 subjects offered by departments in the School of Engineering with the highest maximum enrolled students (considering the current and next 2 rows ordered by subject key), display each subject's title, total units, department full name, row number within a window of 2 preceding and 1 following rows ordered by subject title, subject ID, offer department name, offer school name, term description, academic year, and the department that offered the subject. Do not return any rounded answers.\", \"id\": \"dw_4911\", \"name\": \"Top 10 Engineering Subjects by 3-Row Max Enrollment with Catalog Unit Row Numbers\", \"sql\": \"WITH inner_cte AS ( WITH EngSubjects AS ( SELECT t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t0.DEPARTMENT_FULL_NAME, ROW_NUMBER() OVER (ORDER BY t1.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t0.SCHOOL_NAME = 'Engineering' ), SubjectEnrollmentStats AS ( SELECT t1.SUBJECT_TITLE, t1.SUBJECT_ID, t1.OFFER_DEPT_NAME, t1.OFFER_SCHOOL_NAME, t0.TERM_DESCRIPTION, t0.ACADEMIC_YEAR, MAX(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.SUBJECT_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_enrolled_students FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.IS_MASTER_SECTION = 'Y' AND t0.TERM_STATUS_INDICATOR = 'P' ) SELECT es.SUBJECT_TITLE, es.TOTAL_UNITS, es.DEPARTMENT_FULL_NAME, es.window_column, ses.SUBJECT_ID, ses.OFFER_DEPT_NAME, ses.OFFER_SCHOOL_NAME, ses.TERM_DESCRIPTION, ses.ACADEMIC_YEAR, ses.max_enrolled_students FROM EngSubjects es JOIN SubjectEnrollmentStats ses ON es.SUBJECT_TITLE = ses.SUBJECT_TITLE ) SELECT icte.SUBJECT_TITLE, icte.TOTAL_UNITS, icte.DEPARTMENT_FULL_NAME, icte.window_column, icte.SUBJECT_ID, icte.OFFER_DEPT_NAME, icte.OFFER_SCHOOL_NAME, icte.TERM_DESCRIPTION, icte.ACADEMIC_YEAR, icte.max_enrolled_students, sd.DEPARTMENT_FULL_NAME AS OFFERING_DEPARTMENT_FULL_NAME FROM inner_cte icte LEFT JOIN SIS_DEPARTMENT sd ON icte.OFFER_DEPT_NAME = sd.DEPARTMENT_NAME ORDER BY icte.max_enrolled_students DESC LIMIT 10;\"}, {\"id\": \"dw_1221\", \"name\": \"2014FA Chemistry Library Subjects Windowed Enrollment with Department Reserve Enrollment Average and Normalized Ratio\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, and the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, as well as the average and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in courses with at least one reserved library material and a material status of 'U' offered by either the Chemistry or Biology department, and calculate the normalized enrollment ratio (the number of enrolled students in the library subject divided by the average enrollment for the department, rounded to two decimal places). List the results in descending order of normalized enrollment ratio.\", \"sql\": \"WITH Subquery1 AS ( SELECT l.SUBJECT_TITLE, l.NUM_ENROLLED_STUDENTS, t.RESPONSIBLE_FACULTY_NAME, t.OFFER_DEPT_NAME, MIN(l.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t.RESPONSIBLE_FACULTY_MIT_ID ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t.RESPONSIBLE_FACULTY_MIT_ID FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_SUBJECT_OFFERED t ON l.TERM_CODE = t.TERM_CODE WHERE l.TERM_CODE = '2014FA' AND t.OFFER_DEPT_NAME = 'Chemistry' ), Subquery2 AS ( SELECT t.OFFER_DEPT_NAME, AVG(t.NUM_ENROLLED_STUDENTS) AS avg_enrollment, STDDEV(t.NUM_ENROLLED_STUDENTS) AS enrollment_stddev FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_SUBJECT_OFFERED t ON l.TERM_CODE = t.TERM_CODE WHERE l.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND t.OFFER_DEPT_NAME IN ('Chemistry', 'Biology') GROUP BY t.OFFER_DEPT_NAME ORDER BY enrollment_stddev DESC ) SELECT s1.SUBJECT_TITLE, s1.NUM_ENROLLED_STUDENTS, s1.RESPONSIBLE_FACULTY_NAME, s1.OFFER_DEPT_NAME, s1.window_column, s2.avg_enrollment, s2.enrollment_stddev, ROUND(s1.NUM_ENROLLED_STUDENTS / NULLIF(s2.avg_enrollment, 0), 2) AS normalized_enrollment_ratio FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME ORDER BY normalized_enrollment_ratio DESC;\", \"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2014FA Chemistry library subject offering matched with department-level reserve enrollment statistics\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per top reserved subject title matched with degree-granting department enrollment dispersion\", \"desc\": \"For the top 10 subject titles by the number of reserved library materials for subjects offered in the term '2009SP', what are the subject title, the offering department name, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only departments that grant degrees and subjects with a non-null subject code description), and the count of reserved materials? Please provide the subject title, the offering department name, the variance, the standard deviation (using STDDEV only and never STDDEV_POP), and the count of reserved materials, in that order. Do not return any rounded answers.\", \"entity_type\": \"metric\", \"id\": \"dw_3356\", \"name\": \"Top 10 Reserved-Material Subjects in 2009SP with Degree-Granting Department Enrollment Variance and Stddev\", \"sql\": \"WITH DepartmentEnrollmentStats AS ( SELECT d.DEPARTMENT_NAME, d.DEPARTMENT_CODE, VARIANCE(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_variance, STDDEV(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_stddev FROM TIP_SUBJECT_OFFERED t JOIN SIS_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.SUBJECT_CODE_DESC IS NOT NULL GROUP BY d.DEPARTMENT_NAME, d.DEPARTMENT_CODE ORDER BY enrolled_students_variance DESC ), TopReservedSubjects AS ( SELECT s.SUBJECT_TITLE, s.OFFER_DEPT_NAME, s.OFFER_DEPT_CODE, COUNT(l.LIBRARY_RESERVE_CATALOG_KEY) AS reserved_materials FROM LIBRARY_RESERVE_MATRL_DETAIL l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE l.TERM_CODE = '2009SP' GROUP BY s.SUBJECT_TITLE, s.OFFER_DEPT_NAME, s.OFFER_DEPT_CODE ORDER BY reserved_materials DESC LIMIT 10 ) SELECT trs.SUBJECT_TITLE, trs.OFFER_DEPT_NAME, des.enrolled_students_variance, des.enrolled_students_stddev, trs.reserved_materials FROM TopReservedSubjects trs JOIN DepartmentEnrollmentStats des ON trs.OFFER_DEPT_CODE = des.DEPARTMENT_CODE ORDER BY trs.reserved_materials DESC;\"}], \"not_found\": []}"
    },
