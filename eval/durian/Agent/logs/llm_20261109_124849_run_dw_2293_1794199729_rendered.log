          "function": {
            "name": "mysql_query",
            "arguments": "{\"sql\": \"WITH subj_reserved AS (\\n    SELECT\\n        l.LIBRARY_SUBJECT_OFFERED_KEY,\\n        l.OFFER_DEPT_CODE,\\n        l.SUBJECT_TITLE,\\n        l.TERM_CODE,\\n        l.OFFER_DEPT_NAME,\\n        l.RESPONSIBLE_FACULTY_NAME,\\n        l.NUM_ENROLLED_STUDENTS,\\n        COUNT(r.LIBRARY_RESERVE_CATALOG_KEY) AS subject_reserved_materials\\n    FROM LIBRARY_SUBJECT_OFFERED l\\n    JOIN LIBRARY_RESERVE_MATRL_DETAIL r\\n      ON l.LIBRARY_SUBJECT_OFFERED_KEY = r.LIBRARY_SUBJECT_OFFERED_KEY\\n    GROUP BY l.LIBRARY_SUBJECT_OFFERED_KEY, l.OFFER_DEPT_CODE, l.SUBJECT_TITLE, l.TERM_CODE,\\n             l.OFFER_DEPT_NAME, l.RESPONSIBLE_FACULTY_NAME, l.NUM_ENROLLED_STUDENTS\\n),\\nenriched AS (\\n    SELECT\\n        d.DEPARTMENT_NAME,\\n        SUM(s.subject_reserved_materials) OVER (PARTITION BY s.OFFER_DEPT_CODE) AS total_reserved_materials,\\n        s.SUBJECT_TITLE,\\n        s.TERM_CODE,\\n        s.OFFER_DEPT_NAME,\\n        s.RESPONSIBLE_FACULTY_NAME,\\n        d.DEPARTMENT_FULL_NAME,\\n        d.SCHOOL_NAME,\\n        MAX(s.NUM_ENROLLED_STUDENTS) OVER (ORDER BY s.LIBRARY_SUBJECT_OFFERED_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_enrolled_students\\n    FROM subj_reserved s\\n    JOIN SIS_DEPARTMENT d ON s.OFFER_DEPT_CODE = d.DEPARTMENT_CODE\\n    WHERE d.SCHOOL_NAME IN ('Engineering', 'Science')\\n)\\nSELECT\\n    DEPARTMENT_NAME,\\n    total_reserved_materials,\\n    SUBJECT_TITLE,\\n    TERM_CODE,\\n    OFFER_DEPT_NAME,\\n    RESPONSIBLE_FACULTY_NAME,\\n    DEPARTMENT_FULL_NAME,\\n    SCHOOL_NAME,\\n    max_enrolled_students,\\n    ROUND(total_reserved_materials / NULLIF(max_enrolled_students, 0), 2) AS reserved_materials_per_max_enrolled_students\\nFROM enriched\\nWHERE total_reserved_materials > 20\\nORDER BY reserved_materials_per_max_enrolled_students DESC\"}"
          }
        }
