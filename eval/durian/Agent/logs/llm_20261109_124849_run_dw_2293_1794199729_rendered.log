      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per Fall 2024-2025 subject with status-U reserve materials\", \"desc\": \"For each subject offered in the term with the description \\\"Fall Term 2024-2025\\\" that also has more than 0 enrolled students and a material status key of 'U', show the subject offered key, subject title, offering department name, the term description, the rank of each subject within its offering department, the course number, course number description, number of enrolled students, the reserve catalog key, the dense rank over the material status key, and the academic year description, ordered by subject offered key and course number. Do not return any rounded answers.\", \"id\": \"dw_4566\", \"name\": \"Fall 2024-2025 Subjects with Status-U Library Reserve Materials Ranked per Department\", \"sql\": \"WITH inner_cte AS ( WITH SubjectOfferings AS ( SELECT t0.TIP_SUBJECT_OFFERED_KEY, t0.SUBJECT_TITLE, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.OFFER_DEPT_NAME ORDER BY t0.TIP_SUBJECT_OFFERED_KEY) AS window_column, t0.SUBJECT_ID, t1.ACADEMIC_YEAR_DESC FROM TIP_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN ACADEMIC_TERM_PARAMETER t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_DESCRIPTION = 'Fall Term 2024-2025' ), LibrarySubjectStats AS ( SELECT t1.COURSE_NUMBER, t1.COURSE_NUMBER_DESC, t1.NUM_ENROLLED_STUDENTS, t2.LIBRARY_RESERVE_CATALOG_KEY, DENSE_RANK() OVER (PARTITION BY t2.LIBRARY_MATERIAL_STATUS_KEY ORDER BY t2.LIBRARY_MATERIAL_STATUS_KEY) AS window_column, t1.SUBJECT_ID FROM LIBRARY_SUBJECT_OFFERED t1 JOIN LIBRARY_RESERVE_MATRL_DETAIL t2 ON t1.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.NUM_ENROLLED_STUDENTS > 0 AND t2.LIBRARY_MATERIAL_STATUS_KEY = 'U' ) SELECT so.TIP_SUBJECT_OFFERED_KEY, so.SUBJECT_TITLE, so.OFFER_DEPT_NAME, so.TERM_DESCRIPTION, so.window_column AS subject_rank_in_dept, lss.COURSE_NUMBER, lss.COURSE_NUMBER_DESC, lss.NUM_ENROLLED_STUDENTS, lss.LIBRARY_RESERVE_CATALOG_KEY, lss.window_column AS dense_rank_material_status, so.ACADEMIC_YEAR_DESC FROM SubjectOfferings so JOIN LibrarySubjectStats lss ON so.SUBJECT_ID = lss.SUBJECT_ID ) SELECT * FROM inner_cte ORDER BY TIP_SUBJECT_OFFERED_KEY, COURSE_NUMBER;\"}, {\"category\": \"Library Reserve and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per department per course number\", \"desc\": \"For each department where the total number of subject enrollments for subjects offered in the current term is greater than 10, and for each course number in that department where the number of enrolled students in the subject summary is greater than 2, provide the department name, the total number of subject enrollments, the course number, the number of unique library subjects offered, the minimum total units for those subjects, and the name of the responsible faculty member for each course. Do not return any rounded answers.\", \"id\": \"dw_4683\", \"name\": \"Current Term Department Enrollments with Library Course Counts and Min Units\", \"sql\": \"WITH inner_cte AS ( SELECT de.DEPARTMENT_NAME, de.total_enrollments, lss.COURSE_NUMBER, lss.subject_count, lss.min_total_units FROM ( SELECT s.DEPARTMENT_NAME, SUM(s.SUBJECT_ENROLLMENT_NUMBER) AS total_enrollments FROM ACADEMIC_TERM_PARAMETER p JOIN ACADEMIC_TERMS t ON p.TERM_CODE = t.TERM_CODE JOIN SUBJECT_SUMMARY s ON t.TERM_CODE = s.TERM_CODE WHERE p.IS_CURRENT_TERM = 'Y' GROUP BY s.DEPARTMENT_NAME HAVING SUM(s.SUBJECT_ENROLLMENT_NUMBER) > 10 ) de JOIN ( SELECT l.OFFER_DEPT_NAME, l.COURSE_NUMBER, COUNT(DISTINCT l.LIBRARY_SUBJECT_OFFERED_KEY) AS subject_count, MIN(s.TOTAL_UNITS) AS min_total_units FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_DETAIL t ON l.SUBJECT_ID = t.SUBJECT_ID JOIN SUBJECT_OFFERED_SUMMARY s ON t.SUBJECT_ID = s.SUBJECT_ID WHERE s.NUM_ENROLLED_STUDENTS > 2 GROUP BY l.OFFER_DEPT_NAME, l.COURSE_NUMBER ) lss ON de.DEPARTMENT_NAME = lss.OFFER_DEPT_NAME ) SELECT ic.DEPARTMENT_NAME, ic.total_enrollments, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sos.RESPONSIBLE_FACULTY_NAME FROM inner_cte ic JOIN LIBRARY_SUBJECT_OFFERED lso ON ic.DEPARTMENT_NAME = lso.OFFER_DEPT_NAME AND ic.COURSE_NUMBER = lso.COURSE_NUMBER JOIN SUBJECT_OFFERED_SUMMARY sos ON lso.SUBJECT_ID = sos.SUBJECT_ID WHERE sos.NUM_ENROLLED_STUDENTS > 2 GROUP BY ic.DEPARTMENT_NAME, ic.total_enrollments, ic.COURSE_NUMBER, ic.subject_count, ic.min_total_units, sos.RESPONSIBLE_FACULTY_NAME;\"}, {\"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"default_granularity\": \"one row per subject per source subquery\", \"desc\": \"List all subject titles that are either (a) offered in the term '2022FA' with a total of 12 units, showing the subject title, department name from the course description, and the dense rank of each subject considering the current and 2 preceding rows ordered by the subject code from the course catalog, or (b) for each subject offered, show the subject title, subject ID, offer department name, offer school name, term description, academic year, and the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject key. The results should include all these columns in the following order: subject title, department name, window column, offer department name, offer school name, term description, academic year, and maximum number of enrolled students, with NULLs for columns not relevant to each case. Do not return any rounded answers.\", \"id\": \"dw_3277\", \"name\": \"Union of 2022FA 12-Unit Subjects Dense Rank and Master Section 3-Row Max Enrollment\", \"sql\": \"WITH Subq1 AS ( SELECT t0.SUBJECT_TITLE, t1.DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t2.SUBJECT_CODE ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column, t2.SUBJECT_ID FROM SUBJECT_OFFERED_SUMMARY t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.COURSE_NUMBER = t1.COURSE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.COURSE = t2.SUBJECT_CODE WHERE t2.TERM_CODE = '2022FA' AND t0.TOTAL_UNITS = 12 ), Subq2 AS ( SELECT t1.SUBJECT_TITLE, t1.SUBJECT_ID, t1.OFFER_DEPT_NAME, t1.OFFER_SCHOOL_NAME, t0.TERM_DESCRIPTION, t0.ACADEMIC_YEAR, MAX(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t1.SUBJECT_KEY ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_enrolled_students FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t1.IS_MASTER_SECTION = 'Y' AND t0.TERM_STATUS_INDICATOR = 'P' ), CombinedSubjects AS ( SELECT s1.SUBJECT_TITLE, s1.DEPARTMENT_NAME, s1.window_column, NULL AS OFFER_DEPT_NAME, NULL AS OFFER_SCHOOL_NAME, NULL AS TERM_DESCRIPTION, NULL AS ACADEMIC_YEAR, NULL AS max_enrolled_students FROM Subq1 s1 UNION ALL SELECT s2.SUBJECT_TITLE, NULL AS DEPARTMENT_NAME, NULL AS window_column, s2.OFFER_DEPT_NAME, s2.OFFER_SCHOOL_NAME, s2.TERM_DESCRIPTION, s2.ACADEMIC_YEAR, s2.max_enrolled_students FROM Subq2 s2 ) SELECT SUBJECT_TITLE, DEPARTMENT_NAME, window_column, OFFER_DEPT_NAME, OFFER_SCHOOL_NAME, TERM_DESCRIPTION, ACADEMIC_YEAR, max_enrolled_students FROM CombinedSubjects ORDER BY SUBJECT_TITLE;\"}], \"not_found\": []}"
