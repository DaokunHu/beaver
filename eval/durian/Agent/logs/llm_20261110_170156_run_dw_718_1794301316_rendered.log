    {
      "role": "tool",
      "tool_call_id": "call_32ba204916884c3fbb648e76",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2014FA Chemistry library subject per academic year per required-material count\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, and for each academic year, also show the academic year and academic year description and the coefficient of variation (using STDDEV only and never STDDEV_POP) of the total units for subjects in the Mathematics department (Course 18) that have more than 0 total units and are offered in terms with a term status indicator of 'P'. Additionally, for each Chemistry subject, include the number of required TIP materials (where TIP_MATERIAL_STATUS_KEY = 'RQ') for that subject in that term. Do not return any rounded answers.\", \"id\": \"dw_2180\", \"name\": \"2014FA Chemistry Library Subjects Windowed Enrollment with Math Unit Coefficient of Variation and Required Material Counts\", \"sql\": \"WITH inner_cte AS ( SELECT l.SUBJECT_TITLE, l.NUM_ENROLLED_STUDENTS, t.RESPONSIBLE_FACULTY_NAME, t.OFFER_DEPT_NAME, MIN(l.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t.RESPONSIBLE_FACULTY_MIT_ID ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column, l.TERM_CODE FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_SUBJECT_OFFERED t ON l.TERM_CODE = t.TERM_CODE WHERE l.TERM_CODE = '2014FA' AND t.OFFER_DEPT_NAME = 'Chemistry' ), math_units_variation AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, STDDEV_SAMP(ss.TOTAL_UNITS) / NULLIF(AVG(ss.TOTAL_UNITS), 0) AS coefficient_of_variation_total_units FROM SUBJECT_SUMMARY ss JOIN ACADEMIC_TERMS_ALL ata ON ss.TERM_CODE = ata.TERM_CODE WHERE ss.DEPARTMENT_NAME = 'Mathematics' AND ss.TOTAL_UNITS > 0 AND ata.TERM_STATUS_INDICATOR = 'P' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC ORDER BY ata.ACADEMIC_YEAR ), required_materials_count AS ( SELECT t.TERM_CODE, t.SUBJECT_ID, COUNT(*) AS num_required_materials FROM TIP_DETAIL t WHERE t.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY t.TERM_CODE, t.SUBJECT_ID ) SELECT c.SUBJECT_TITLE, c.NUM_ENROLLED_STUDENTS, c.RESPONSIBLE_FACULTY_NAME, c.OFFER_DEPT_NAME, c.window_column, m.ACADEMIC_YEAR, m.ACADEMIC_YEAR_DESC, m.coefficient_of_variation_total_units, COALESCE(r.num_required_materials, 0) AS num_required_materials FROM inner_cte c CROSS JOIN math_units_variation m LEFT JOIN TIP_SUBJECT_OFFERED t ON c.TERM_CODE = t.TERM_CODE AND c.SUBJECT_TITLE = t.SUBJECT_TITLE LEFT JOIN required_materials_count r ON t.TERM_CODE = r.TERM_CODE AND t.SUBJECT_ID = r.SUBJECT_ID\"}, {\"id\": \"dw_1023\", \"name\": \"Math Fall Non-Variable Unit Statistics by Academic Year with Enrollment Filter\", \"category\": \"Subject Offering and Enrollment Comprehensive Analysis\", \"desc\": \"For each academic year where the Mathematics department has at least one unique subject with subject enrollment number greater than 10, what are the academic year, academic year description, department name, number of unique subjects, minimum total units offered, variance of total units, and standard deviation (using STDDEV only and never STDDEV_POP) of total units for subjects offered in the fall term that are not variable units and are offered by the Mathematics department? Do not return any rounded answers.\", \"sql\": \"WITH AcademicYearStats AS ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, VARIANCE(ccso.TOTAL_UNITS) AS variance_total_units, STDDEV(ccso.TOTAL_UNITS) AS stddev_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED ccso JOIN ACADEMIC_TERMS at ON ccso.TERM_CODE = at.TERM_CODE WHERE ccso.IS_OFFERED_FALL_TERM = 'Y' AND ccso.IS_VARIABLE_UNITS = 'N' AND ccso.DEPARTMENT_NAME = 'Mathematics' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ORDER BY at.ACADEMIC_YEAR ), DepartmentYearStats AS ( SELECT cso.DEPARTMENT_NAME, at.ACADEMIC_YEAR, COUNT(DISTINCT ss.SUBJECT_ID) AS num_unique_subjects, MIN(ss.TOTAL_UNITS) AS min_total_units FROM COURSE_CATALOG_SUBJECT_OFFERED cso JOIN ACADEMIC_TERMS at ON cso.EFFECTIVE_TERM_CODE = at.TERM_CODE JOIN SUBJECT_SUMMARY ss ON at.TERM_CODE = ss.TERM_CODE AND cso.DEPARTMENT_NAME = ss.DEPARTMENT_NAME WHERE cso.DEPARTMENT_NAME = 'Mathematics' AND ss.SUBJECT_ENROLLMENT_NUMBER > 10 GROUP BY cso.DEPARTMENT_NAME, at.ACADEMIC_YEAR ) SELECT ays.ACADEMIC_YEAR, ays.ACADEMIC_YEAR_DESC, dys.DEPARTMENT_NAME, dys.num_unique_subjects, dys.min_total_units, ays.variance_total_units, ays.stddev_total_units FROM AcademicYearStats ays JOIN DepartmentYearStats dys ON ays.ACADEMIC_YEAR = dys.ACADEMIC_YEAR WHERE dys.num_unique_subjects > 0 ORDER BY ays.ACADEMIC_YEAR;\", \"default_granularity\": \"one row per academic year\"}, {\"id\": \"dw_4640\", \"name\": \"2017JA Subject Enrollment Windows with Department Enrollment Coefficient of Variation and School Code\", \"desc\": \"For each subject offered in the term '2017JA', what is the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code, the coefficient of variation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in the subjects offered by that department (considering only subjects with at least one enrolled student), and the department's school code? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH DeptVariation AS ( SELECT sd.DEPARTMENT_NAME, STDDEV(tso.NUM_ENROLLED_STUDENTS) / NULLIF(AVG(tso.NUM_ENROLLED_STUDENTS), 0) AS coefficient_of_variation FROM TIP_SUBJECT_OFFERED tso JOIN STUDENT_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE WHERE tso.NUM_ENROLLED_STUDENTS > 0 GROUP BY sd.DEPARTMENT_NAME HAVING AVG(tso.NUM_ENROLLED_STUDENTS) > 0 ORDER BY coefficient_of_variation DESC ), Subjects2017JA AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, t1.DEPARTMENT_NAME, t1.DEPARTMENT_CODE, MIN(t0.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t1.DEPARTMENT_CODE ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ) SELECT s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, s.RESPONSIBLE_FACULTY_NAME, s.OFFER_DEPT_NAME, s.DEPARTMENT_FULL_NAME, s.SCHOOL_NAME, s.window_column, dv.coefficient_of_variation, sd.SCHOOL_CODE FROM Subjects2017JA s LEFT JOIN DeptVariation dv ON s.DEPARTMENT_NAME = dv.DEPARTMENT_NAME JOIN STUDENT_DEPARTMENT sd ON s.DEPARTMENT_CODE = sd.DEPARTMENT_CODE ) SELECT * FROM inner_cte;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA TIP subject offering enriched with department-level enrollment coefficient of variation and school code\"}, {\"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per library subject with status-U reserve materials matched with department unit statistics\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\", \"id\": \"dw_3311\", \"name\": \"Status-U Library Subjects with Enrollment Matched with Department Offered-This-Year Unit Dispersion\", \"sql\": \"WITH DeptStats AS ( SELECT scd.DEPARTMENT_NAME, MAX(ccc.total_units) - MIN(ccc.total_units) AS total_units_range, VARIANCE(ccc.total_units) AS total_units_variance, STDDEV(ccc.total_units) AS total_units_stddev FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_SUBJECT_CODE ssc ON scd.COURSE = ssc.SUBJECT_CODE JOIN CIS_COURSE_CATALOG ccc ON ssc.SUBJECT_CODE = ccc.SUBJECT_CODE WHERE ccc.IS_OFFERED_THIS_YEAR = 'Y' AND ccc.total_units IS NOT NULL GROUP BY scd.DEPARTMENT_NAME ORDER BY total_units_range DESC ), SubjectEnroll AS ( SELECT t1.COURSE_NUMBER, t1.COURSE_NUMBER_DESC, t1.NUM_ENROLLED_STUDENTS, t2.LIBRARY_RESERVE_CATALOG_KEY, DENSE_RANK() OVER (PARTITION BY t2.LIBRARY_MATERIAL_STATUS_KEY ORDER BY t2.LIBRARY_MATERIAL_STATUS_KEY) AS window_column, t1.OFFER_DEPT_NAME FROM LIBRARY_SUBJECT_OFFERED t1 JOIN LIBRARY_RESERVE_MATRL_DETAIL t2 ON t1.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.NUM_ENROLLED_STUDENTS > 0 AND t2.LIBRARY_MATERIAL_STATUS_KEY = 'U' ), CombinedResults AS ( SELECT s.COURSE_NUMBER, s.COURSE_NUMBER_DESC, s.NUM_ENROLLED_STUDENTS, s.LIBRARY_RESERVE_CATALOG_KEY, s.window_column, d.DEPARTMENT_NAME, d.total_units_range, d.total_units_variance, d.total_units_stddev FROM SubjectEnroll s JOIN DeptStats d ON s.OFFER_DEPT_NAME = d.DEPARTMENT_NAME ) SELECT * FROM CombinedResults ORDER BY COURSE_NUMBER, COURSE_NUMBER_DESC;\"}], \"not_found\": []}"
    },
