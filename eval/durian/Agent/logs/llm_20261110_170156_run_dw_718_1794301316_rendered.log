            "arguments": "{\"sql\": \"SELECT COUNT(*) AS cnt FROM COURSE_CATALOG_SUBJECT_OFFERED WHERE DEPARTMENT_NAME='Mathematics' AND IS_OFFERED_FALL_TERM='Y' AND TOTAL_UNITS>0\"}"
          }
