    {
      "role": "tool",
      "tool_call_id": "call_83570f81229b41fbad600d79",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per degree-granting subject code description status per school (with rollup totals) matched with 2016SP Engineering-school subject offerings\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name, school name, the number of subject codes per school name, and whether the subject code description is present ('Has Description') or missing ('No Description'). For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes). Additionally, for subjects offered in the term '2016SP' with a school code of 'E', show the subject title, course description, the offering department name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title. Present all columns in the following order: subject code, subject code description, department name, school name, description status, total subject codes, subject title, course description, offering department name, and window column. Do not return any rounded answers.\", \"id\": \"dw_4490\", \"name\": \"Degree-Granting Subject Code Description Status Rollup by School with 2016SP Engineering Subject Row Numbers\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' ), SubjectCodeVisibility AS ( SELECT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, CASE WHEN SUBJECT_CODE_DESC IS NOT NULL AND SUBJECT_CODE_DESC <> 'nan' THEN 'Has Description' ELSE 'No Description' END AS description_status FROM inner_cte1 ), RollupResults AS ( SELECT SCHOOL_NAME, description_status, COUNT(*) AS total_subject_codes FROM SubjectCodeVisibility GROUP BY SCHOOL_NAME, description_status WITH ROLLUP HAVING COUNT(*) > 0 ), SubjectCodeSummary AS ( SELECT scv.SUBJECT_CODE, scv.SUBJECT_CODE_DESC, scv.DEPARTMENT_NAME, rr.SCHOOL_NAME, rr.description_status, rr.total_subject_codes FROM RollupResults rr LEFT JOIN ( SELECT DISTINCT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, description_status FROM SubjectCodeVisibility ) scv ON rr.SCHOOL_NAME = scv.SCHOOL_NAME AND rr.description_status = scv.description_status ), inner_cte2 AS ( SELECT t2.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t1.COURSE_DESCRIPTION, ROW_NUMBER() OVER (ORDER BY t2.SUBJECT_TITLE ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t2.OFFER_DEPT_NAME FROM SIS_SUBJECT_CODE t0 JOIN SIS_COURSE_DESCRIPTION t1 ON t0.COURSE_NUMBER = t1.COURSE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.COURSE = t2.COURSE_NUMBER WHERE t2.TERM_CODE = '2016SP' AND t0.SCHOOL_CODE = 'E' ), SubjectOfferSummary AS ( SELECT inner_cte2.SUBJECT_TITLE, inner_cte2.DEPARTMENT_NAME, inner_cte2.COURSE_DESCRIPTION, inner_cte2.OFFER_DEPT_NAME, inner_cte2.window_column FROM inner_cte2 JOIN SUBJECT_OFFERED_SUMMARY t2 ON inner_cte2.SUBJECT_TITLE = t2.SUBJECT_TITLE WHERE t2.TERM_CODE = '2016SP' ) SELECT scs.SUBJECT_CODE, scs.SUBJECT_CODE_DESC, scs.DEPARTMENT_NAME, scs.SCHOOL_NAME, scs.description_status, scs.total_subject_codes, sos.SUBJECT_TITLE, sos.COURSE_DESCRIPTION, sos.OFFER_DEPT_NAME, sos.window_column FROM SubjectCodeSummary scs LEFT JOIN SIS_DEPARTMENT sd ON scs.DEPARTMENT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SUBJECT_OFFERED_SUMMARY so ON sd.DEPARTMENT_CODE = so.OFFER_DEPT_CODE LEFT JOIN SubjectOfferSummary sos ON so.SUBJECT_TITLE = sos.SUBJECT_TITLE ORDER BY scs.SCHOOL_NAME, scs.description_status, sos.SUBJECT_TITLE;\"}, {\"id\": \"dw_2850\", \"name\": \"Status-U Reserve Catalog Key Variance by Term and Department with Rollup Totals\", \"desc\": \"For each term and department, what is the term, department, and the variance of the reserve catalog keys for courses in that department and term where the material status is 'U'? Include subtotals for each term (the corresponding term field is 'SUBTOTAL') and a grand total across all terms (the corresponding term field is 'TOTAL'). Do not repeat the term if it is the same as the previous row. Sort the table by term and department. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT lci.DEPARTMENT, lrmd.TERM_CODE, VARIANCE(lrmd.LIBRARY_RESERVE_CATALOG_KEY) AS catalog_key_variance FROM LIBRARY_COURSE_INSTRUCTOR lci JOIN LIBRARY_RESERVE_MATRL_DETAIL lrmd ON lci.LIBRARY_COURSE_INSTRUCTOR_KEY = lrmd.LIBRARY_COURSE_INSTRUCTOR_KEY WHERE lrmd.LIBRARY_MATERIAL_STATUS_KEY = 'U' GROUP BY lci.DEPARTMENT, lrmd.TERM_CODE ) SELECT CASE WHEN LAG(term) OVER (ORDER BY term_sort, term, dept_sort) = term THEN NULL ELSE term END AS term, dept, catalog_key_variance FROM ( SELECT CASE WHEN GROUPING(TERM_CODE) = 1 AND GROUPING(DEPARTMENT) = 1 THEN 'zzz' ELSE TERM_CODE END AS term_sort, CASE WHEN GROUPING(TERM_CODE) = 0 AND GROUPING(DEPARTMENT) = 1 THEN 'SUBTOTAL' WHEN GROUPING(TERM_CODE) = 1 AND GROUPING(DEPARTMENT) = 1 THEN 'TOTAL' ELSE TERM_CODE END AS term, CASE WHEN GROUPING(TERM_CODE) = 0 AND GROUPING(DEPARTMENT) = 1 THEN 'zzz' ELSE DEPARTMENT END AS dept_sort, DEPARTMENT AS dept, VARIANCE(LIBRARY_RESERVE_CATALOG_KEY) AS catalog_key_variance FROM ( SELECT lci.DEPARTMENT, lrmd.TERM_CODE, lrmd.LIBRARY_RESERVE_CATALOG_KEY FROM LIBRARY_COURSE_INSTRUCTOR lci JOIN LIBRARY_RESERVE_MATRL_DETAIL lrmd ON lci.LIBRARY_COURSE_INSTRUCTOR_KEY = lrmd.LIBRARY_COURSE_INSTRUCTOR_KEY WHERE lrmd.LIBRARY_MATERIAL_STATUS_KEY = 'U' ) base GROUP BY TERM_CODE, DEPARTMENT WITH ROLLUP ) tbltmp ORDER BY term_sort, dept_sort;\", \"category\": \"Library Reserve and Course Instructor Comprehensive Analysis\", \"default_granularity\": \"one row per term and department, plus per-term subtotal rows and a grand total row\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_804e98b2645540c9ac23768b",
      "name": "semantic_graph",
      "content": "{\"ok\": true, \"count\": 12, \"items\": [{\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\", \"entity_type\": \"table\", \"id\": \"SIS_SUBJECT_CODE\", \"name\": \"SIS_SUBJECT_CODE\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"entity_type\": \"table\", \"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"entity_type\": \"table\", \"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"SIS subject code lookup table mapping subject codes and course numbers to their descriptions, departments, and schools. Used to resolve subject code descriptions and to link courses to departments via DEPARTMENT_CODE.\", \"entity_type\": \"table\", \"id\": \"SIS_SUBJECT_CODE\", \"name\": \"SIS_SUBJECT_CODE\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Classification of Instructional Programs (CIP) lookup table: one row per six-digit CIP program code, classifying instructional programs into a two-digit category and a four-digit series, with program/category/four-digit titles, a change note, the CIP revision version year (1990/2000/2010/2020), and the warehouse load date. Joins to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE to attribute courses to CIP programs, categories, and schools/departments; CIP_WITH_VERSION is the multi-version variant keeping every revision of each program code.\", \"entity_type\": \"table\", \"id\": \"CIP\", \"name\": \"CIP\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Versioned Classification of Instructional Programs (CIP) lookup table: one row per CIP program code per revision version year (1990/2000/2010/2020), preserving the historical classification of each program across CIP revisions. Carries the same program/category/four-digit code and title attributes as CIP plus a surrogate key, but no NOTE column and fewer distinct program codes than CIP. Joins to SIS_COURSE_DESCRIPTION via PROGRAM_CODE = CIP_PROGRAM_CODE (matching more course rows than CIP because a program code can appear under several versions); use CIP when one row per program code is required.\", \"entity_type\": \"table\", \"id\": \"CIP_WITH_VERSION\", \"name\": \"CIP_WITH_VERSION\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"Subject-level summary fact table per term: one row per subject (or cluster) per term with department/school attribution, unit structure (total/lecture/lab/prep/design units), and detailed enrollment statistics including final enrollment, first-week and fifth-week enrollment, and credit/listener splits at both subject and cluster level. Used for enrollment and unit statistics by department, school, term, and subject group.\", \"entity_type\": \"table\", \"id\": \"SUBJECT_SUMMARY\", \"name\": \"SUBJECT_SUMMARY\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"CIS course catalog table: an alternative course catalog source with the same subject attribute structure as COURSE_CATALOG_SUBJECT_OFFERED (units, grading, requirement attributes, offering flags), keyed by academic year, term code, and subject identity. Joins to SIS_SUBJECT_CODE via DEPARTMENT_CODE for subject code resolution.\", \"entity_type\": \"table\", \"id\": \"CIS_COURSE_CATALOG\", \"name\": \"CIS_COURSE_CATALOG\"}, {\"relation_type\": \"joins\", \"direction\": \"outgoing\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"entity_type\": \"table\", \"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\"}, {\"relation_type\": \"joins\", \"direction\": \"incoming\", \"desc\": \"SIS course description table: catalog descriptions of courses with department and school attribution, course level (undergraduate/graduate), degree-granting flag, graduate level, CIP program code, and effective from/thru terms. Joins to SIS_SUBJECT_CODE via COURSE = SUBJECT_CODE/COURSE_NUMBER and to SIS_DEPARTMENT via DEPARTMENT = DEPARTMENT_CODE.\", \"entity_type\": \"table\", \"id\": \"SIS_COURSE_DESCRIPTION\", \"name\": \"SIS_COURSE_DESCRIPTION\"}, {\"relation_type\": \"column_concept\", \"direction\": \"incoming\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"entity_type\": \"column_concept\", \"id\": \"column_concept_department_name\", \"name\": \"Department Name\"}]}"
