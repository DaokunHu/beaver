    {
      "role": "tool",
      "tool_call_id": "call_dcebf458c96b4761bed3f4ad",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and CIP Program Classification Comprehensive Analysis\", \"default_granularity\": \"one row per 2012SU subject offering detail plus rollup rows per department and per school\", \"desc\": \"For each offer department code in the 2012SU term with total units greater than 0, list the subject title, course number, department name, the dense rank over the offer department code, the course, course description, school name, program code, program title, category code, category title, four digit code, four digit title, and the minimum warehouse load date from the CIP table over each category code group for courses in department 6, and include a grand total of subjects per offer department code and a grand total for all courses in each school in the format (nulls for subject-specific fields, department name, total subjects, course-specific fields, school name, and total courses). Do not return any rounded answers.\", \"id\": \"dw_3901\", \"name\": \"2012SU Subject Offerings Dense Rank Matched with Department-6 CIP Course Classification and School Rollups\", \"sql\": \"WITH inner_cte1 AS ( SELECT t2.SUBJECT_TITLE, t0.COURSE_NUMBER, t2.DEPARTMENT_NAME, DENSE_RANK() OVER (PARTITION BY t1.OFFER_DEPT_CODE ORDER BY t1.OFFER_DEPT_CODE) AS window_column FROM SUBJECT_OFFERED_SUMMARY t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.TERM_CODE = '2012SU' AND t2.TOTAL_UNITS > 0 ), dept_counts1 AS ( SELECT DEPARTMENT_NAME, COUNT(*) AS total_subjects FROM SUBJECT_SUMMARY WHERE TERM_CODE = '2012SU' AND TOTAL_UNITS > 0 GROUP BY DEPARTMENT_NAME ), inner_cte2 AS ( SELECT s.COURSE, s.COURSE_DESCRIPTION, s.DEPARTMENT_NAME, s.SCHOOL_NAME, c.PROGRAM_CODE, c.PROGRAM_TITLE, c.CATEGORY_CODE, c.CATEGORY_TITLE, c.FOUR_DIGIT_CODE, c.FOUR_DIGIT_TITLE, MIN(c.WAREHOUSE_LOAD_DATE) OVER (PARTITION BY c.CATEGORY_CODE ORDER BY c.CATEGORY_CODE) AS min_warehouse_load_date FROM SIS_COURSE_DESCRIPTION s JOIN CIP c ON c.PROGRAM_CODE = s.CIP_PROGRAM_CODE WHERE s.DEPARTMENT = 6 ), SchoolTotals2 AS ( SELECT NULL AS COURSE, NULL AS COURSE_DESCRIPTION, NULL AS DEPARTMENT_NAME, SCHOOL_NAME, NULL AS PROGRAM_CODE, NULL AS PROGRAM_TITLE, NULL AS CATEGORY_CODE, NULL AS CATEGORY_TITLE, NULL AS FOUR_DIGIT_CODE, NULL AS FOUR_DIGIT_TITLE, NULL AS min_warehouse_load_date, COUNT(*) AS total_courses FROM inner_cte2 GROUP BY SCHOOL_NAME ) SELECT ic1.SUBJECT_TITLE, ic1.COURSE_NUMBER, ic1.DEPARTMENT_NAME, ic1.window_column, NULL AS total_subjects, ic2.COURSE, ic2.COURSE_DESCRIPTION, ic2.SCHOOL_NAME, ic2.PROGRAM_CODE, ic2.PROGRAM_TITLE, ic2.CATEGORY_CODE, ic2.CATEGORY_TITLE, ic2.FOUR_DIGIT_CODE, ic2.FOUR_DIGIT_TITLE, ic2.min_warehouse_load_date, NULL AS total_courses FROM inner_cte1 ic1 LEFT JOIN SIS_COURSE_DESCRIPTION scd ON ic1.COURSE_NUMBER = scd.COURSE LEFT JOIN inner_cte2 ic2 ON scd.COURSE = ic2.COURSE UNION ALL SELECT NULL, NULL, dc1.DEPARTMENT_NAME, NULL, dc1.total_subjects, s2.COURSE, s2.COURSE_DESCRIPTION, s2.SCHOOL_NAME, s2.PROGRAM_CODE, s2.PROGRAM_TITLE, s2.CATEGORY_CODE, s2.CATEGORY_TITLE, s2.FOUR_DIGIT_CODE, s2.FOUR_DIGIT_TITLE, s2.min_warehouse_load_date, s2.total_courses FROM dept_counts1 dc1 LEFT JOIN SIS_COURSE_DESCRIPTION scd2 ON dc1.DEPARTMENT_NAME = scd2.DEPARTMENT_NAME LEFT JOIN SchoolTotals2 s2 ON scd2.SCHOOL_NAME = s2.SCHOOL_NAME ORDER BY DEPARTMENT_NAME, SCHOOL_NAME, CATEGORY_CODE, SUBJECT_TITLE, COURSE\"}, {\"id\": \"dw_1302\", \"name\": \"Engineering Degree-Granting Department 2007 Course Rollup with Department Unit Totals and Latest-Year Course Counts\", \"desc\": \"For each course offered by a degree-granting department in the School of Engineering, except for the Electrical Engineering and Computer Science department, in the 2007 academic year, what is the course key, course name, department name, the number of catalog subjects, the total units for those subjects, and for each department, include a grand total for all courses in the format of (null, null, department name, total subjects, total units)? Additionally, for each such department, what is the total number of units for courses in the \\\"Engineering\\\" or \\\"Non-MIT\\\" schools (where the total units for the department is greater than 1000 and the department is not \\\"Political Science\\\"), and how many distinct courses did the department offer in the most recent academic year available? Present the results as: course key, course name, department name, number of catalog subjects, total units for those subjects, department total units, and number of distinct courses in the latest year, in that order. Do not return any rounded answers.\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT scd.SIS_COURSE_DESCRIPTION_KEY, scd.COURSE, sd.DEPARTMENT_NAME, COUNT(ccc.SUBJECT_ID) AS subject_count, SUM(ccc.TOTAL_UNITS) AS total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN CIS_COURSE_CATALOG ccc ON sd.DEPARTMENT_CODE = ccc.DEPARTMENT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND sd.SCHOOL_NAME = 'Engineering' AND ccc.ACADEMIC_YEAR = '2007' AND sd.DEPARTMENT_NAME != 'Electrical Eng & Computer Sci' GROUP BY scd.SIS_COURSE_DESCRIPTION_KEY, scd.COURSE, sd.DEPARTMENT_NAME ) SELECT CASE WHEN GROUPING(SIS_COURSE_DESCRIPTION_KEY) = 1 THEN NULL ELSE SIS_COURSE_DESCRIPTION_KEY END AS SIS_COURSE_DESCRIPTION_KEY, CASE WHEN GROUPING(COURSE) = 1 THEN NULL ELSE COURSE END AS COURSE, DEPARTMENT_NAME, SUM(subject_count) AS subject_count, SUM(total_units) AS total_units FROM inner_cte GROUP BY DEPARTMENT_NAME, SIS_COURSE_DESCRIPTION_KEY, COURSE WITH ROLLUP HAVING SUM(subject_count) > 0 ORDER BY DEPARTMENT_NAME, SIS_COURSE_DESCRIPTION_KEY ), subq2 AS ( WITH inner_cte AS ( SELECT s.DEPARTMENT_NAME, SUM(c.TOTAL_UNITS) AS total_units FROM SIS_SUBJECT_CODE s JOIN CIS_COURSE_CATALOG c ON s.SUBJECT_CODE = c.SUBJECT_CODE WHERE s.SCHOOL_NAME IN ('Engineering', 'Non-MIT') AND s.DEPARTMENT_NAME <> 'Political Science' GROUP BY s.DEPARTMENT_NAME HAVING SUM(c.TOTAL_UNITS) > 1000 ) SELECT ic.DEPARTMENT_NAME, ic.total_units, COUNT(DISTINCT c.SUBJECT_NUMBER) AS num_courses_latest_year FROM inner_cte ic JOIN SIS_SUBJECT_CODE s ON ic.DEPARTMENT_NAME = s.DEPARTMENT_NAME JOIN CIS_COURSE_CATALOG c ON s.SUBJECT_CODE = c.SUBJECT_CODE WHERE c.ACADEMIC_YEAR = ( SELECT MAX(ACADEMIC_YEAR) FROM CIS_COURSE_CATALOG ) GROUP BY ic.DEPARTMENT_NAME, ic.total_units ) SELECT s1.SIS_COURSE_DESCRIPTION_KEY, s1.COURSE, s1.DEPARTMENT_NAME, s1.subject_count, s1.total_units, s2.total_units AS department_total_units, s2.num_courses_latest_year FROM subq1 s1 JOIN subq2 s2 ON s1.DEPARTMENT_NAME = s2.DEPARTMENT_NAME ORDER BY s1.DEPARTMENT_NAME, s1.SIS_COURSE_DESCRIPTION_KEY ;\", \"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per course per Engineering degree-granting department plus rollup totals\"}, {\"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS\", \"SUBJECT_SUMMARY.TOTAL_UNITS\", \"SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS\", \"CIS_COURSE_CATALOG.TOTAL_UNITS\", \"DRUPAL_COURSE_CATALOG.TOTAL_UNITS\"], \"comparisons\": [{\"dimension\": \"Source process\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS is the catalog-declared unit value per offering; SUBJECT_SUMMARY.TOTAL_UNITS and SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS are registrar subject-level values; CIS/DRUPAL catalog feeds carry their own copies\"}, {\"dimension\": \"Companion unit columns\", \"detail\": \"All these tables also expose LECTURE_UNITS, LAB_UNITS, and preparation units (PREPARATION_UNITS except SUBJECT_SUMMARY which uses PREP_UNITS); DESIGN_UNITS exists in COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY, CIS and DRUPAL catalogs but not in SUBJECT_OFFERED_SUMMARY\"}, {\"dimension\": \"Variability flag\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS marks subjects whose units vary; analyses of fixed-unit statistics typically filter IS_VARIABLE_UNITS='N'\"}], \"decision_guide\": {\"Unit statistics (avg/stddev/variance/geometric mean) over catalog offerings, optionally split by lecture/lab/design or filtered by variable-units flag\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS with its companion unit columns.\", \"Unit statistics tied to actual enrollment records or subject groups per term\": \"Use SUBJECT_SUMMARY.TOTAL_UNITS.\", \"Unit statistics at subject-offering rollup level with offering department/school\": \"Use SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS.\", \"Fixed-unit analyses excluding variable-unit subjects\": \"Filter COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS = 'N'.\"}, \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\", \"id\": \"column_concept_total_units\", \"name\": \"Total Credit Units\"}], \"not_found\": []}"
    },
