    {
      "role": "tool",
      "tool_call_id": "call_444f6bb6f303438e9d38361b",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_2737\", \"name\": \"IAP Max Enrollment Statistics per Person Role with Capacity Classification\", \"desc\": \"For each person role, provide the person role name, the average, range, and variance of the maximum enrollment values for the activities they lead (considering only activities that are not cancelled and have a specified maximum enrollment), and indicate whether the average maximum enrollment for that role is 'HIGH_CAPACITY' (at least 20% greater than the overall average), 'LOW_CAPACITY' (at least 20% less than the overall average), or 'AVERAGE'. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT p.PERSON_ROLE, AVG(d.MAX_ENROLLMENT) AS avg_max_enrollment, MAX(d.MAX_ENROLLMENT) - MIN(d.MAX_ENROLLMENT) AS max_enrollment_range, VARIANCE(d.MAX_ENROLLMENT) AS max_enrollment_variance FROM IAP_SUBJECT_PERSON p JOIN IAP_SUBJECT_DETAIL d ON p.IAP_SUBJECT_PERSON_KEY = d.IAP_SUBJECT_PERSON_KEY WHERE d.IS_CANCELLED = 'N' AND d.MAX_ENROLLMENT IS NOT NULL GROUP BY p.PERSON_ROLE ) SELECT cte.PERSON_ROLE, cte.avg_max_enrollment, cte.max_enrollment_range, cte.max_enrollment_variance, CASE WHEN cte.avg_max_enrollment > overall.avg_enrollment * 1.2 THEN 'HIGH_CAPACITY' WHEN cte.avg_max_enrollment < overall.avg_enrollment * 0.8 THEN 'LOW_CAPACITY' ELSE 'AVERAGE' END AS capacity_category FROM inner_cte cte CROSS JOIN ( SELECT AVG(d.MAX_ENROLLMENT) AS avg_enrollment FROM IAP_SUBJECT_DETAIL d WHERE d.IS_CANCELLED = 'N' AND d.MAX_ENROLLMENT IS NOT NULL ) overall ORDER BY cte.max_enrollment_range DESC;\", \"category\": \"IAP Activity Analysis\", \"default_granularity\": \"one row per IAP person role\"}, {\"id\": \"dw_2901\", \"name\": \"Moira List Members Updated on a Date Classified Against Owner-Type Average MIT ID\", \"desc\": \"For each Moira list member whose last update date is '18-DEC-24', show the Moira list key, the member's full name, the owner's type, the member's MIT ID, the list owner, the last update date, and whether the member's MIT ID is above or below the average MIT ID for their owner type. If it's above, label as 'ABOVE_AVERAGE', if below, label as 'BELOW_AVERAGE', otherwise 'AVERAGE'. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT d.MOIRA_LIST_KEY, d.MOIRA_LIST_MEMBER_FULL_NAME, o.OWNER_TYPE, d.MOIRA_LIST_MEMBER_MIT_ID, o.OWNER, d.LAST_UPDATE_DATE FROM MOIRA_LIST_DETAIL d JOIN MOIRA_LIST_OWNER o ON d.MOIRA_LIST_OWNER_KEY = o.MOIRA_LIST_OWNER_KEY WHERE d.LAST_UPDATE_DATE = '18-DEC-24' ), avg_mit_id AS ( SELECT OWNER_TYPE, AVG(MOIRA_LIST_MEMBER_MIT_ID) AS avg_mit_id FROM inner_cte GROUP BY OWNER_TYPE ) SELECT i.MOIRA_LIST_KEY, i.MOIRA_LIST_MEMBER_FULL_NAME, i.OWNER_TYPE, i.MOIRA_LIST_MEMBER_MIT_ID, i.OWNER, i.LAST_UPDATE_DATE, CASE WHEN i.MOIRA_LIST_MEMBER_MIT_ID > a.avg_mit_id THEN 'ABOVE_AVERAGE' WHEN i.MOIRA_LIST_MEMBER_MIT_ID < a.avg_mit_id THEN 'BELOW_AVERAGE' ELSE 'AVERAGE' END AS mit_id_category FROM inner_cte i JOIN avg_mit_id a ON i.OWNER_TYPE = a.OWNER_TYPE;\", \"category\": \"Mailing List Membership Analysis\", \"default_granularity\": \"one row per Moira list membership record updated on the given date, labeled against its owner-type average member MIT ID\"}], \"not_found\": []}"
    },
