    {
      "role": "tool",
      "tool_call_id": "call_4bea5cb3e16249799a7f6f0e",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per department/school enrollment statistic (plus per-school rollup rows), left joined with Mathematics students named Peter\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\", \"id\": \"dw_1350\", \"name\": \"Degree-Granting Department TIP Enrollment Statistics with School Rollups and Math Peter Student Budget Code Windows\", \"sql\": \"WITH inner_cte1 AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, tso.NUM_ENROLLED_STUDENTS FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 ), DepartmentStats AS ( SELECT DEPARTMENT_NAME, SCHOOL_NAME, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled_students, MAX(NUM_ENROLLED_STUDENTS) - MIN(NUM_ENROLLED_STUDENTS) AS range_enrolled_students, VARIANCE(NUM_ENROLLED_STUDENTS) AS var_enrolled_students, SUM(NUM_ENROLLED_STUDENTS) AS total_enrolled_students FROM inner_cte1 GROUP BY DEPARTMENT_NAME, SCHOOL_NAME ), SchoolRollup AS ( SELECT NULL AS DEPARTMENT_NAME, SCHOOL_NAME, NULL AS avg_enrolled_students, NULL AS range_enrolled_students, NULL AS var_enrolled_students, SUM(total_enrolled_students) AS total_enrolled_students FROM DepartmentStats GROUP BY SCHOOL_NAME ), inner_cte2 AS ( SELECT t1.LAST_NAME, t1.EMAIL_ADDRESS, t1.STUDENT_YEAR, t1.DEPARTMENT_NAME, t0.SCHOOL_NAME, MIN(t0.DEPT_BUDGET_CODE) OVER (ORDER BY t1.FULL_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_DEPARTMENT t0 JOIN MIT_STUDENT_DIRECTORY t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT WHERE t1.FIRST_NAME = 'Peter' AND t0.DEPARTMENT_NAME = 'Mathematics' ) SELECT ds.DEPARTMENT_NAME, ds.SCHOOL_NAME, ds.avg_enrolled_students, ds.range_enrolled_students, ds.var_enrolled_students, ds.total_enrolled_students, ic2.LAST_NAME, ic2.EMAIL_ADDRESS, ic2.STUDENT_YEAR, ic2.window_column, sd.DEPARTMENT_FULL_NAME, sd.DEPARTMENT_LAST_ACTIVITY_DATE FROM (SELECT * FROM DepartmentStats UNION ALL SELECT * FROM SchoolRollup) ds LEFT JOIN inner_cte2 ic2 ON ds.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME AND ds.SCHOOL_NAME = ic2.SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON ds.DEPARTMENT_NAME = sd.DEPARTMENT_NAME ORDER BY ds.SCHOOL_NAME, ds.DEPARTMENT_NAME, ic2.LAST_NAME ;\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per school per description status plus rollup totals matched with 2022SU subjects\", \"desc\": \"For each subject code where the department is degree granting, show the subject code, subject code description, department name (from subject code), school name, the number of subject codes per school name and whether the subject code description is present ('Has Description') or missing ('No Description'), and for each matching department in subjects offered in the term with code '2022SU', show the subject's ID, total units, department name (from subject offered), and their dense rank considering the current and 2 preceding rows ordered by the total number of units. For each school name, include a grand total for all subject codes in the format of (null, null, null, school name, null, total subject codes, null, null, null, null). Do not return any rounded answers.\", \"id\": \"dw_3904\", \"name\": \"Degree-Granting Subject Code Description Status Rollup by School with 2022SU Unit Dense Ranks\", \"sql\": \"WITH inner_cte1 AS ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' ), SubjectCodeVisibility AS ( SELECT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, CASE WHEN SUBJECT_CODE_DESC IS NOT NULL AND SUBJECT_CODE_DESC <> 'nan' THEN 'Has Description' ELSE 'No Description' END AS description_status FROM inner_cte1 ), RollupResults AS ( SELECT SCHOOL_NAME, description_status, COUNT(*) AS total_subject_codes FROM SubjectCodeVisibility GROUP BY SCHOOL_NAME, description_status WITH ROLLUP HAVING COUNT(*) > 0 ), inner_cte2 AS ( SELECT t1.SUBJECT_ID, t1.TOTAL_UNITS, t1.DEPARTMENT_NAME, dense_rank() OVER (ORDER BY t1.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS window_column FROM ACADEMIC_TERMS_ALL t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2022SU' ) SELECT scv.SUBJECT_CODE, scv.SUBJECT_CODE_DESC, scv.DEPARTMENT_NAME AS SCV_DEPARTMENT_NAME, rr.SCHOOL_NAME, rr.description_status, rr.total_subject_codes, ic2.SUBJECT_ID, ic2.TOTAL_UNITS, ic2.DEPARTMENT_NAME AS IC2_DEPARTMENT_NAME, ic2.window_column FROM RollupResults rr LEFT JOIN ( SELECT DISTINCT SUBJECT_CODE, SUBJECT_CODE_DESC, DEPARTMENT_NAME, SCHOOL_NAME, description_status FROM SubjectCodeVisibility ) scv ON rr.SCHOOL_NAME = scv.SCHOOL_NAME AND rr.description_status = scv.description_status LEFT JOIN inner_cte2 ic2 ON scv.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME ORDER BY rr.SCHOOL_NAME, rr.description_status, ic2.TOTAL_UNITS DESC\"}, {\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per graduate course plus rollup totals plus Spring 2021 letter-graded summary row\", \"desc\": \"For each course in the Mathematics department that is degree granting and has a course level of 'G', show the course description, department name, school name, the administrative department name, and the dense rank over the administrative department name ordered by the administrative department name. Additionally, for each administrative department name, include a grand total of the number of such courses in the format of (null, null, null, administrative department name, null, total courses). Also, show the minimum total units, the sum of lecture units, and the number of unique subjects for letter graded Mathematics department subjects offered in the Spring Term 2021, along with the department name and term description (with all other columns as null). Do not return any rounded answers.\", \"id\": \"dw_1427\", \"name\": \"Math Graduate Degree-Granting Courses Ranked by Admin Department with Spring 2021 Letter-Graded Unit Summary\", \"sql\": \"WITH inner_cte_1 AS ( SELECT scd.COURSE_DESCRIPTION, sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, sad.SIS_ADMIN_DEPARTMENT_NAME, DENSE_RANK() OVER (ORDER BY sad.SIS_ADMIN_DEPARTMENT_NAME) AS admin_dept_dense_rank FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_DEPARTMENT sd ON scd.DEPARTMENT = sd.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT sad ON sd.DEPARTMENT_CODE = sad.SIS_ADMIN_DEPARTMENT_CODE WHERE scd.IS_DEGREE_GRANTING = 'Y' AND scd.COURSE_LEVEL = 'G' AND sd.DEPARTMENT_NAME = 'Mathematics' AND sd.DEPARTMENT_CODE = '18' ), CourseTotals AS ( SELECT SIS_ADMIN_DEPARTMENT_NAME, COUNT(*) AS total_courses FROM inner_cte_1 GROUP BY SIS_ADMIN_DEPARTMENT_NAME ), inner_cte_2 AS ( SELECT MIN(c.TOTAL_UNITS) AS min_total_units, SUM(c.LECTURE_UNITS) AS sum_lecture_units FROM ACADEMIC_TERMS_ALL a JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON a.TERM_CODE = c.TERM_CODE WHERE a.TERM_CODE = '2021SP' AND c.GRADE_TYPE = 'L' AND c.DEPARTMENT_NAME = 'Mathematics' ) SELECT ic.COURSE_DESCRIPTION, ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, ic.admin_dept_dense_rank, NULL AS total_courses, NULL AS min_total_units, NULL AS sum_lecture_units, NULL AS num_unique_subjects, NULL AS term_description FROM inner_cte_1 ic UNION ALL SELECT NULL, NULL, NULL, ct.SIS_ADMIN_DEPARTMENT_NAME, NULL, ct.total_courses, NULL, NULL, NULL, NULL FROM CourseTotals ct UNION ALL SELECT NULL, a.DEPARTMENT_NAME, NULL, NULL, NULL, NULL, inner_cte_2.min_total_units, inner_cte_2.sum_lecture_units, COUNT(DISTINCT a.SUBJECT_ID) AS num_unique_subjects, b.TERM_DESCRIPTION FROM COURSE_CATALOG_SUBJECT_OFFERED a JOIN ACADEMIC_TERMS_ALL b ON a.TERM_CODE = b.TERM_CODE CROSS JOIN inner_cte_2 WHERE a.TERM_CODE = '2021SP' AND a.GRADE_TYPE = 'L' AND a.DEPARTMENT_NAME = 'Mathematics' GROUP BY a.DEPARTMENT_NAME, b.TERM_DESCRIPTION, inner_cte_2.min_total_units, inner_cte_2.sum_lecture_units ORDER BY SIS_ADMIN_DEPARTMENT_NAME, COURSE_DESCRIPTION\"}, {\"category\": \"Academic Term Analysis\", \"default_granularity\": \"one row per academic year\", \"desc\": \"For each academic year, provide the academic year description, the geometric mean of the degree year from all academic terms where the degree year is greater than 1900, and classify the academic year as 'RECENT' if the geometric mean is at least 2010, 'OLD' if it is less than 1980, or 'AVERAGE' otherwise. Do not return any rounded answers.\", \"id\": \"dw_2957\", \"name\": \"Geometric Mean Degree Year by Academic Year with Recency Classification\", \"sql\": \"WITH inner_cte AS ( SELECT ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, ACADEMIC_TERMS_ALL.ACADEMIC_YEAR_DESC, EXP(AVG(LN(ACADEMIC_TERMS.DEGREE_YEAR))) AS geometric_mean_degree_year FROM ACADEMIC_TERMS_ALL JOIN ACADEMIC_TERMS ON ACADEMIC_TERMS_ALL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE ACADEMIC_TERMS.DEGREE_YEAR > 1900 GROUP BY ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, ACADEMIC_TERMS_ALL.ACADEMIC_YEAR_DESC ) SELECT inner_cte.ACADEMIC_YEAR, inner_cte.ACADEMIC_YEAR_DESC, inner_cte.geometric_mean_degree_year, CASE WHEN inner_cte.geometric_mean_degree_year >= 2010 THEN 'RECENT' WHEN inner_cte.geometric_mean_degree_year < 1980 THEN 'OLD' ELSE 'AVERAGE' END AS year_category FROM inner_cte ORDER BY inner_cte.geometric_mean_degree_year DESC;\"}], \"not_found\": []}"
    },
