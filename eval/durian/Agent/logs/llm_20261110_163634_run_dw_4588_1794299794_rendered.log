    {
      "role": "tool",
      "tool_call_id": "call_60c0e3e34ba6415db8e7a3f1",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"FCLT_ROOMS\", \"name\": \"FCLT_ROOMS\", \"desc\": \"Facilities room inventory table: one row per physical room with building/floor keys, room identifiers, use classifications (major/minor use), organization assignment, area in square meters, access level, and geographic coordinates. Joins to FCLT_BUILDING via FCLT_BUILDING_KEY; referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE via FCLT_ROOM_KEY.\", \"columns\": {\"FCLT_ROOM_KEY\": {\"desc\": \"Surrogate key of the room; joins to COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE for class-meeting location analysis\"}, \"BUILDING_ROOM\": {\"desc\": \"Combined building-room identifier\"}, \"FCLT_BUILDING_KEY\": {\"desc\": \"Building identifier key of the room, storing the building number/code itself (e.g. 'E38', '14N'); can be filtered directly for a building or joined to FCLT_BUILDING.FCLT_BUILDING_KEY for building attributes\"}, \"FLOOR\": {\"desc\": \"Floor the room is on\"}, \"FCLT_FLOOR_KEY\": {\"desc\": \"Foreign key to FCLT_FLOOR\"}, \"ROOM\": {\"desc\": \"Room number/name\"}, \"SPACE_ID\": {\"desc\": \"Space identifier\"}, \"FCLT_MAJOR_USE_KEY\": {\"desc\": \"Major use key of the room; joins to FCLT_MAJOR_USE.FCLT_MAJOR_USE_KEY to decode the major use code/description and assignable flag\"}, \"MAJOR_USE_DESC\": {\"desc\": \"Major use description, e.g. classroom\"}, \"FCLT_USE_KEY\": {\"desc\": \"\"}, \"USE_DESC\": {\"desc\": \"Use description of the room\"}, \"FCLT_MINOR_USE_KEY\": {\"desc\": \"Minor use key of the room\"}, \"MINOR_USE_DESC\": {\"desc\": \"Minor use description\"}, \"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Organization key of the room\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Organization name occupying the room\"}, \"FCLT_MINOR_ORGANIZATION_KEY\": {\"desc\": \"Minor organization key of the room\"}, \"MINOR_ORGANIZATION\": {\"desc\": \"Minor organization name\"}, \"AREA\": {\"desc\": \"Room area in square meters; used in area statistics (average, range, variance)\"}, \"ROOM_FULL_NAME\": {\"desc\": \"Full room name\"}, \"DEPT_CODE\": {\"desc\": \"Department code assigned to the room\"}, \"ACCESS_LEVEL\": {\"desc\": \"Numeric access level code of the room (observed values 0-3); used to filter rooms by access restriction level, e.g. ACCESS_LEVEL = 1\"}, \"LATITUDE_WGS\": {\"desc\": \"Latitude (WGS)\"}, \"LONGITUDE_WGS\": {\"desc\": \"Longitude (WGS)\"}, \"NORTHING_SPCS\": {\"desc\": \"Northing coordinate (SPCS)\"}, \"EASTING_SPCS\": {\"desc\": \"Easting coordinate (SPCS)\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per room\"}, {\"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Surrogate key of the facilities organization; joins to SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY\"}, \"ORGANIZATION_ID\": {\"desc\": \"Organization identifier (same value as the organization key in current data)\"}, \"ORGANIZATION\": {\"desc\": \"Short organization abbreviation, e.g. 'AERO', 'ADMISS'\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Display name of the organization, e.g. 'AERO & ASTRO'; used for organization-name reporting\"}, \"FCLT_ORG_PARENT_KEY\": {\"desc\": \"Key of the parent organization in the hierarchy tree; null for the top-level organization\"}, \"ORG_PARENT\": {\"desc\": \"Abbreviation of the parent organization, e.g. 'S ENG' (School of Engineering)\"}, \"FCLT_MAJOR_ORG_KEY\": {\"desc\": \"Key of the major (top-level grouping) organization this organization rolls up to\"}, \"MAJOR_ORG\": {\"desc\": \"Abbreviation of the major organization, e.g. 'PROVST', 'CHNCLR'\"}, \"ORGANIZATION_LEVEL\": {\"desc\": \"Level of the organization in the hierarchy tree (1 = institute-wide root, 2-4 = intermediate divisions/schools, 5 = department/DLC level, 6 = sub-organization); stored as string, filter with values like '5'\"}, \"ORGANIZATION_NUMBER\": {\"desc\": \"Official organization number used in administrative systems\"}, \"ORGANIZATION_SORT\": {\"desc\": \"Sortable hierarchical organization code reflecting the tree path\"}, \"ASSIGNABLE\": {\"desc\": \"Flag ('1'/'0') indicating whether the organization is an assignable-space organizational unit\"}, \"COURSE\": {\"desc\": \"Academic course (department) number for degree-granting academic departments, e.g. '16' for Aeronautics and Astronautics; null for non-academic organizations\"}, \"DESCRIPTION\": {\"desc\": \"Long description of the organization, e.g. 'Department of Aeronautics and Astronautics'; null for many non-academic organizations\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_AEROASTRO'; joins to FCLT_ORG_DLC_KEY.DLC_KEY, HR_ORG_UNIT.DLC_KEY (for HR org unit title/level and HR department attributes; may fan out when a DLC maps to multiple HR org units), and MASTER_DEPT_HIERARCHY.DLC_KEY (for the standard department hierarchy path)\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Aeronautics and Astronautics'\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code cross-reference\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"HR organization unit identifier cross-reference; links to HR_ORG_UNIT\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"Department name as recorded in HR systems\"}}, \"default_granularity\": \"one row per facilities organization\"}, {\"id\": \"SPACE_UNIT\", \"name\": \"SPACE_UNIT\", \"desc\": \"Space unit dimension table: one row per space unit (an organizational space-assignment unit such as a department, program, or office that receives space allocation), with space unit key/code, space unit name, the facilities organization it belongs to, and DLC key. Bridges FCLT_ORGANIZATION (organization attribution) and SPACE_DETAIL (rooms assigned to the space unit); used to group room counts and space statistics by space unit.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Foreign key to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY; the organization that owns/occupies this space unit\"}, \"SPACE_UNIT_KEY\": {\"desc\": \"Surrogate key of the space unit; joins to SPACE_DETAIL.SPACE_UNIT_KEY and SPACE_UNIT2.SPACE_UNIT_KEY; used for partitioning/ordering in space analyses\"}, \"SPACE_UNIT_CODE\": {\"desc\": \"Business code of the space unit (same numeric value as the key in current data)\"}, \"SPACE_UNIT\": {\"desc\": \"Name of the space unit, e.g. 'Physics', 'Technology & Policy Program'\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_PHYSICS'; may contain composite values like 'D_DSL:HQ'\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per space unit\"}, {\"id\": \"SPACE_SUPERVISOR_USAGE\", \"name\": \"SPACE_SUPERVISOR_USAGE\", \"desc\": \"Space supervisor usage fact table: one row per supervisor (MIT_ID) recording how much space they supervise and for how many departments: department count, department DLC key list (comma-separated when multiple), number of supervisees, supervised square footage, research volume, and derived ratio measures (sqft per supervisee, sqft per research volume, research volume per sqft). Joins to SPACE_UNIT and other DLC-carrying tables via DEPT_NAMES = DLC_KEY (only single-department rows match); used for supervisor space-usage and research-volume statistics per department/DLC.\", \"columns\": {\"MIT_ID\": {\"desc\": \"MIT ID of the supervisor; one row per supervisor\"}, \"DEPT_COUNT\": {\"desc\": \"Number of departments (DLCs) the supervisor's space spans; observed values 1-4\"}, \"DEPT_NAMES\": {\"desc\": \"DLC key(s) of the supervised departments, e.g. 'D_CEE'; comma-separated list when DEPT_COUNT > 1 (e.g. 'D_IDSS,D_LIDS'). Single-value rows join to DLC key columns such as SPACE_UNIT.DLC_KEY\"}, \"NUM_OF_SUPERVISEES\": {\"desc\": \"Number of supervisees under the supervisor; observed range 1-121\"}, \"SQFT\": {\"desc\": \"Total square footage of space supervised\"}, \"RESEARCH_VOLUME\": {\"desc\": \"Research volume attributed to the supervisor's space; can be negative\"}, \"SQFT_PER_SUPERVISEE\": {\"desc\": \"Derived ratio: supervised square footage per supervisee\"}, \"SQFT_PER_RES_VOL\": {\"desc\": \"Derived ratio: supervised square footage per unit of research volume\"}, \"RES_VOL_PER_SQFT\": {\"desc\": \"Derived ratio: research volume per square foot of supervised space\"}, \"default_granularity\": \"one row per supervisor\"}, \"default_granularity\": \"one row per supervisor\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_559d45e23b4c432e8af3dd30",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"column_concept_dlc_key\", \"name\": \"DLC Key (Department/Lab/Center)\", \"desc\": \"Department/Lab/Center key columns (values like 'D_AEROASTRO', 'D_IDSS', 'D_BIOLOGY') identifying a DLC across the facilities, HR, space, and academic-department domains. They are the universal cross-domain join key linking facilities organizations and space units to HR organization units, the master department hierarchy, and academic departments. Naming and completeness vary: DLC_KEY in most tables, D_CODE in MASTER_DEPT_DCODE_PARENT, DLC_CODE in the master hierarchy tables; some columns carry composite values ('D_DSL:HQ') or nulls.\", \"columns\": [\"FCLT_ORGANIZATION.DLC_KEY\", \"FCLT_ORG_DLC_KEY.DLC_KEY\", \"HR_ORG_UNIT.DLC_KEY\", \"HR_ORG_UNIT_NEW.DLC_KEY\", \"MASTER_DEPT_HIERARCHY.DLC_KEY\", \"MASTER_DEPT_HIERARCHY_LINKS.DLC_KEY\", \"MASTER_DEPT_DCODE_PARENT.D_CODE\", \"SPACE_UNIT.DLC_KEY\", \"SPACE_UNIT2.DLC_KEY\", \"SIS_DEPARTMENT.DLC_KEY\", \"SPACE_SUPERVISOR_USAGE.DEPT_NAMES\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DLC_KEY is used by FCLT_ORGANIZATION, FCLT_ORG_DLC_KEY, HR_ORG_UNIT, HR_ORG_UNIT_NEW, MASTER_DEPT_HIERARCHY, MASTER_DEPT_HIERARCHY_LINKS, SPACE_UNIT, SPACE_UNIT2, and SIS_DEPARTMENT; MASTER_DEPT_DCODE_PARENT names the same value domain D_CODE (with PARENT_D_CODE for the parent); MASTER_DEPT_HIERARCHY/LINKS additionally carry DLC_CODE holding the same value as DLC_KEY; SPACE_SUPERVISOR_USAGE names it DEPT_NAMES despite holding DLC key values, not department names.\"}, {\"dimension\": \"Uniqueness and fan-out behavior\", \"detail\": \"In MASTER_DEPT_HIERARCHY the DLC_KEY is unique per DLC (one row per DLC); in HR_ORG_UNIT one DLC_KEY may appear on multiple HR org unit rows (join fans out); in FCLT_ORGANIZATION multiple organizations can share a DLC_KEY; in FCLT_ORG_DLC_KEY it is an assignment bridge where non-null values mark organizations with a DLC assignment; in SPACE_SUPERVISOR_USAGE multiple supervisors can share the same DEPT_NAMES value, so joining DEPT_NAMES = DLC_KEY fans out on both sides.\"}, {\"dimension\": \"Nullability and value format\", \"detail\": \"HR_ORG_UNIT.DLC_KEY is null for units without a DLC assignment (133 of 641 rows); HR_ORG_UNIT_NEW.DLC_KEY and SPACE_UNIT.DLC_KEY may contain composite values like 'D_DSL:HQ' that do not match plain DLC keys; SPACE_SUPERVISOR_USAGE.DEPT_NAMES holds a comma-separated list of DLC keys when DEPT_COUNT > 1 (e.g. 'D_IDSS,D_LIDS'), so only single-department rows match a plain DLC key join; SIS_DEPARTMENT.DLC_KEY is populated for all 122 department rows.\"}, {\"dimension\": \"Companion name column\", \"detail\": \"FCLT_ORGANIZATION, HR_ORG_UNIT, and MASTER_DEPT_HIERARCHY carry a DLC_NAME alongside the key; SPACE_UNIT/SPACE_UNIT2, FCLT_ORG_DLC_KEY, HR_ORG_UNIT_NEW, SIS_DEPARTMENT, and SPACE_SUPERVISOR_USAGE carry only the key, so DLC name reporting requires joining one of the name-carrying tables.\"}], \"decision_guide\": {\"Attaching HR department attributes (unit title, department name/code, level) to a facilities organization\": \"Join FCLT_ORGANIZATION.DLC_KEY = HR_ORG_UNIT.DLC_KEY; expect possible row fan-out when a DLC maps to multiple HR org units.\", \"Reporting the DLC name of an organization or space unit\": \"Use FCLT_ORGANIZATION.DLC_KEY (carries DLC_NAME) or join HR_ORG_UNIT/MASTER_DEPT_HIERARCHY for DLC_NAME; SPACE_UNIT/SPACE_UNIT2 keys alone have no name column.\", \"Restricting analysis to DLCs placed in the standard department hierarchy or reporting their hierarchy path\": \"Join on MASTER_DEPT_HIERARCHY.DLC_KEY; use MASTER_DEPT_DCODE_PARENT.D_CODE for the same value domain when only the direct parent is needed.\", \"Filtering organizations that have a DLC assignment before DLC-level room statistics\": \"Use FCLT_ORG_DLC_KEY.DLC_KEY IS NOT NULL as the assignment filter, then join FCLT_ORGANIZATION.\", \"Linking an academic department to its facilities organization or HR unit\": \"Use SIS_DEPARTMENT.DLC_KEY = FCLT_ORGANIZATION.DLC_KEY (or HR_ORG_UNIT.DLC_KEY); all SIS_DEPARTMENT rows carry a DLC key.\", \"Attributing supervisor space-usage statistics (supervisees, square footage, research volume) to a DLC or space unit\": \"Join SPACE_SUPERVISOR_USAGE.DEPT_NAMES = SPACE_UNIT.DLC_KEY (or another DLC_KEY column); despite its name, DEPT_NAMES holds DLC key values, and only single-department rows (DEPT_COUNT = 1) match a plain DLC key.\"}}, {\"columns\": [\"FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY\", \"SPACE_UNIT.FCLT_ORGANIZATION_KEY\", \"FCLT_ROOMS.FCLT_ORGANIZATION_KEY\", \"FCLT_ROOMS.FCLT_MINOR_ORGANIZATION_KEY\", \"FAC_ORGANIZATION.ORGANIZATION_KEY\", \"FAC_ROOMS.ORGANIZATION_KEY\"], \"comparisons\": [{\"dimension\": \"Key family\", \"differences\": \"FCLT_ORGANIZATION_KEY (FCLT_* family) and ORGANIZATION_KEY (FAC_* family) share the same value domain but must be joined within their own family: SPACE_UNIT/FCLT_ROOMS use FCLT_ORGANIZATION_KEY, FAC_ROOMS uses ORGANIZATION_KEY.\"}, {\"dimension\": \"Primary vs secondary occupancy\", \"differences\": \"FCLT_ROOMS.FCLT_ORGANIZATION_KEY is the primary occupying organization; FCLT_ROOMS.FCLT_MINOR_ORGANIZATION_KEY is the secondary organization, both referencing FCLT_ORGANIZATION.\"}, {\"dimension\": \"Dimension vs foreign key\", \"differences\": \"FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY and FAC_ORGANIZATION.ORGANIZATION_KEY are dimension identities; the others are foreign keys attributing space units or rooms to organizations.\"}], \"decision_guide\": {\"Attributing space units to organizations (e.g. filtering by organization level)\": \"Join SPACE_UNIT.FCLT_ORGANIZATION_KEY to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY.\", \"Attributing rooms to their occupying organization in the FCLT_* family\": \"Use FCLT_ROOMS.FCLT_ORGANIZATION_KEY (primary) or FCLT_MINOR_ORGANIZATION_KEY (secondary) against FCLT_ORGANIZATION.\", \"Room organization attribution inside the FAC_* family\": \"Use FAC_ROOMS.ORGANIZATION_KEY against FAC_ORGANIZATION.ORGANIZATION_KEY.\"}, \"desc\": \"Facility organization key columns attributing space units and rooms to organizations in the hierarchical organization tree. Two naming conventions exist across table families (FCLT_ORGANIZATION_KEY in FCLT_*/SPACE_* tables vs ORGANIZATION_KEY in FAC_* tables) with the same value domain.\", \"id\": \"column_concept_facility_organization_key\", \"name\": \"Facility Organization Key\"}, {\"id\": \"column_concept_access_level\", \"name\": \"Access Level Columns\", \"desc\": \"Access level columns recorded at three granularity levels of the facilities domain plus the space-planning room feed: building-level ACCESS_LEVEL_CODE/ACCESS_LEVEL_NAME (current and per-fiscal-period history), floor-level ACCESS_LEVEL, and room-level ACCESS_LEVEL (FCLT_ROOMS, FAC_ROOMS, ZPM_ROOMS_LOAD). They share a numeric value domain (observed 0-3) but describe the access restriction of different physical objects or come from different feeds, so filters and joins must target the granularity and table family the question refers to.\", \"columns\": [\"FCLT_BUILDING.ACCESS_LEVEL_CODE\", \"FCLT_BUILDING.ACCESS_LEVEL_NAME\", \"FCLT_BUILDING_HIST.ACCESS_LEVEL_CODE\", \"FCLT_BUILDING_HIST.ACCESS_LEVEL_NAME\", \"FCLT_FLOOR.ACCESS_LEVEL\", \"FCLT_ROOMS.ACCESS_LEVEL\", \"FAC_BUILDING.ACCESS_LEVEL_CODE\", \"FAC_FLOOR.ACCESS_LEVEL\", \"FAC_ROOMS.ACCESS_LEVEL\", \"ZPM_ROOMS_LOAD.ACCESS_LEVEL\"], \"comparisons\": [{\"dimension\": \"Granularity\", \"differences\": \"Building columns classify the whole building (one code per building); floor columns classify each floor; room columns classify each individual room. A building with access level 2 can contain rooms with access level 1.\"}, {\"dimension\": \"Code vs name\", \"differences\": \"At building level the code (ACCESS_LEVEL_CODE, integer) and name (ACCESS_LEVEL_NAME, string) carry the same numeric value in current data; joins and filters typically use the code.\"}, {\"dimension\": \"Time semantics\", \"differences\": \"FCLT_BUILDING_HIST.ACCESS_LEVEL_CODE is the per-fiscal-period building access level and can be joined to FCLT_BUILDING.ACCESS_LEVEL_CODE to associate buildings sharing an access level with history attributes; the other columns are current values.\"}, {\"dimension\": \"Room-level feed differences\", \"differences\": \"FCLT_ROOMS.ACCESS_LEVEL and FAC_ROOMS.ACCESS_LEVEL belong to the facilities room inventories (with area and use keys); ZPM_ROOMS_LOAD.ACCESS_LEVEL belongs to the space-planning feed (with space usage text and SPACE_UNIT_CODE/HR_ORG_UNIT_ID links but no area), so room access-level statistics differ depending on the chosen feed.\"}], \"decision_guide\": {\"Rooms restricted by access level (e.g. 'rooms with access level 1 or 2')\": \"Use FCLT_ROOMS.ACCESS_LEVEL (numeric); FAC_ROOMS.ACCESS_LEVEL for the FAC_* family.\", \"Building-level access classification or grouping buildings by access level\": \"Use FCLT_BUILDING.ACCESS_LEVEL_CODE (with ACCESS_LEVEL_NAME for display).\", \"Access level of a specific floor\": \"Use FCLT_FLOOR.ACCESS_LEVEL.\", \"History-based access level analysis (per fiscal period)\": \"Use FCLT_BUILDING_HIST.ACCESS_LEVEL_CODE.\", \"Room access level analysis combined with floor, space usage text, or space unit / HR org unit linkage\": \"Use ZPM_ROOMS_LOAD.ACCESS_LEVEL.\"}}, {\"id\": \"concept_room_space_inventory\", \"name\": \"Room and Space Inventory\", \"desc\": \"Tables recording the physical room inventory and its space assignment: SPACE_DETAIL (rooms assigned to space units with usage classification and square footage), FCLT_ROOMS (facilities room inventory with use classifications, organization assignment, and area in square meters), FAC_ROOMS (the FAC_* family room snapshot with the same structure as FCLT_ROOMS but FAC_* keys), and ZPM_ROOMS_LOAD (space-planning room load feed with floor, space usage text, access level, and space unit code / HR org unit id links). They jointly answer questions about how many rooms exist, room sizes, room usage, and which organization/space unit occupies rooms, but differ in assignment perspective, key family, and area units.\", \"tables\": [\"SPACE_DETAIL\", \"FCLT_ROOMS\", \"FAC_ROOMS\", \"ZPM_ROOMS_LOAD\"], \"comparisons\": [{\"dimension\": \"Business perspective\", \"differences\": \"SPACE_DETAIL records rooms from the space-assignment perspective (which space unit each room is allocated to, with SPACE_USAGE_KEY usage code); FCLT_ROOMS and FAC_ROOMS record rooms from the facilities inventory perspective (major/minor use descriptions, primary and minor organization occupancy); ZPM_ROOMS_LOAD records rooms from the space-planning load perspective (space usage text, floor, access level, occupying HR org unit).\"}, {\"dimension\": \"Key family and join paths\", \"differences\": \"SPACE_DETAIL joins SPACE_UNIT/SPACE_FLOOR/SPACE_USAGE and FCLT_BUILDING via BUILDING_KEY; FCLT_ROOMS joins FCLT_BUILDING via FCLT_BUILDING_KEY and FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, and is referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE; FAC_ROOMS joins the FAC_* family (FAC_BUILDING, FAC_FLOOR, FAC_ORGANIZATION); ZPM_ROOMS_LOAD joins SPACE_UNIT via SPACE_UNIT_CODE and FCLT_ORGANIZATION/HR_ORG_UNIT via HR_ORG_UNIT_ID (no building/floor keys).\"}, {\"dimension\": \"Area measure and units\", \"differences\": \"SPACE_DETAIL.ROOM_SQUARE_FOOTAGE is in square feet; FCLT_ROOMS.AREA and FAC_ROOMS.AREA are in square meters; ZPM_ROOMS_LOAD carries no area measure at all. Unit choice matters for size thresholds and averages.\"}, {\"dimension\": \"Room counting semantics\", \"differences\": \"SPACE_DETAIL supports counting rooms per space unit or per building via BUILDING_ROOM rows (and ROOM_COUNTER=1 per row); FCLT_BUILDING also carries a precomputed NUM_OF_ROOMS attribute per building, while FCLT_ROOMS/FAC_ROOMS/ZPM_ROOMS_LOAD require COUNT over room rows.\"}, {\"dimension\": \"Usage classification detail\", \"differences\": \"SPACE_DETAIL uses a coded SPACE_USAGE_KEY decoded by SPACE_USAGE; FCLT_ROOMS/FAC_ROOMS carry denormalized MAJOR_USE_DESC/USE_DESC/MINOR_USE_DESC text classifications plus ACCESS_LEVEL and coordinates; ZPM_ROOMS_LOAD carries a free-text SPACE_USAGE (e.g. 'DSGN STUDIO', 'CONF RM') plus ACCESS_LEVEL and a text FLOOR that can hold labels such as 'G9'.\"}], \"decision_guide\": {\"Counting rooms per space unit or finding the building with the most rooms in a space unit\": \"Use SPACE_DETAIL: it is the only table keyed by SPACE_UNIT_KEY, so room counts can be grouped by space unit and by BUILDING_KEY directly.\", \"Room area statistics in square meters, use-classification filters (e.g. classrooms), or linking class meeting places to rooms\": \"Use FCLT_ROOMS: it carries AREA in square meters, denormalized use descriptions, and FCLT_ROOM_KEY referenced by COURSE_CATALOG_SUBJECT_OFFERED.MEET_PLACE.\", \"Room analysis that must stay inside the FAC_* key family (FAC_BUILDING/FAC_FLOOR/FAC_ORGANIZATION)\": \"Use FAC_ROOMS: it mirrors FCLT_ROOMS structure but joins FAC_* family tables via FAC_ROOM_KEY/BUILDING_KEY/ORGANIZATION_KEY.\", \"Room occupancy by organization hierarchy (level, parent organization)\": \"Use FCLT_ROOMS joined to FCLT_ORGANIZATION via FCLT_ORGANIZATION_KEY, SPACE_DETAIL joined via SPACE_UNIT to SPACE_UNIT.FCLT_ORGANIZATION_KEY when the space-assignment view is required, or ZPM_ROOMS_LOAD joined to FCLT_ORGANIZATION via HR_ORG_UNIT_ID for the space-planning view.\", \"Room analysis by floor, space usage text, or access level linked to space units or HR org units (no area needed)\": \"Use ZPM_ROOMS_LOAD: it links rooms to SPACE_UNIT via SPACE_UNIT_CODE and to organizations/HR units via HR_ORG_UNIT_ID.\"}}, {\"id\": \"concept_space_unit_dimension\", \"name\": \"Space Unit Dimension\", \"desc\": \"Space unit lookup tables identifying the organizational units that receive space allocation: SPACE_UNIT (with FCLT_ORGANIZATION_KEY organization attribution) and SPACE_UNIT2 (identity/name only). They answer the same space-unit identity questions but differ in organization linkage and coverage.\", \"tables\": [\"SPACE_UNIT\", \"SPACE_UNIT2\"], \"comparisons\": [{\"dimension\": \"Organization attribution\", \"differences\": \"SPACE_UNIT carries FCLT_ORGANIZATION_KEY linking each space unit to its owning organization in FCLT_ORGANIZATION; SPACE_UNIT2 has no organization key, only space unit identity and DLC_KEY.\"}, {\"dimension\": \"Coverage\", \"differences\": \"SPACE_UNIT holds more space units (150 rows) than SPACE_UNIT2 (139 rows); every SPACE_UNIT2 key also exists in SPACE_UNIT, so SPACE_UNIT2 is a subset.\"}, {\"dimension\": \"Join role\", \"differences\": \"Both join SPACE_DETAIL via SPACE_UNIT_KEY; only SPACE_UNIT can bridge SPACE_DETAIL rooms to organization attributes (level, parent, description).\"}], \"decision_guide\": {\"Space unit analysis that needs organization attributes (organization level, name, description)\": \"Use SPACE_UNIT: it is the only space unit table carrying FCLT_ORGANIZATION_KEY for the organization join.\", \"Space unit name/code lookup only, or queries restricted to the SPACE_UNIT2 subset\": \"Use SPACE_UNIT2: it provides SPACE_UNIT_KEY/CODE/NAME and DLC_KEY without organization linkage.\", \"Counting rooms per space unit or ranking space units by room count\": \"Join SPACE_DETAIL to SPACE_UNIT on SPACE_UNIT_KEY (preferred for full coverage and organization attribution).\"}}], \"not_found\": []}"
    },
