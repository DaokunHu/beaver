            "arguments": "{\"sql\": \"WITH inner_cte AS (\\n  SELECT t1.SUBJECT_CODE, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t0.SCHOOL_NAME\\n  FROM SIS_DEPARTMENT t0\\n  JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE\\n  WHERE t1.ACADEMIC_YEAR = 2024\\n    AND t1.TOTAL_UNITS = 12\\n    AND t1.DEPARTMENT_NAME = 'Mathematics'\\n),\\nschool_counts AS (\\n  SELECT SCHOOL_NAME, COUNT(SUBJECT_CODE) AS subject_count\\n  FROM inner_cte\\n  GROUP BY SCHOOL_NAME\\n  HAVING COUNT(SUBJECT_CODE) >= 2\\n),\\ndept_unit_stats AS (\\n  SELECT d.DEPARTMENT_NAME,\\n         d.SCHOOL_NAME,\\n         VARIANCE(c.TOTAL_UNITS) AS total_units_variance,\\n         STDDEV(c.TOTAL_UNITS) AS total_units_stddev\\n  FROM SIS_COURSE_DESCRIPTION scd\\n  JOIN SIS_DEPARTMENT d ON scd.DEPARTMENT = d.DEPARTMENT_CODE\\n  JOIN CIS_COURSE_CATALOG c ON c.DEPARTMENT_CODE = d.DEPARTMENT_CODE\\n  WHERE c.TOTAL_UNITS IS NOT NULL\\n    AND d.IS_DEGREE_GRANTING = 'Y'\\n  GROUP BY d.DEPARTMENT_NAME, d.SCHOOL_NAME\\n)\\nSELECT ic.SUBJECT_CODE,\\n       ic.SUBJECT_TITLE,\\n       ic.DEPARTMENT_NAME,\\n       ic.SCHOOL_NAME,\\n       sc.subject_count,\\n       dus.total_units_variance,\\n       dus.total_units_stddev\\nFROM inner_cte ic\\nJOIN school_counts sc ON ic.SCHOOL_NAME = sc.SCHOOL_NAME\\nJOIN dept_unit_stats dus ON ic.DEPARTMENT_NAME = dus.DEPARTMENT_NAME\\n                        AND ic.SCHOOL_NAME = dus.SCHOOL_NAME\\nORDER BY ic.SCHOOL_NAME, ic.SUBJECT_CODE\"}"
