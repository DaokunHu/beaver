    },
    {
      "role": "tool",
      "tool_call_id": "call_9c232f5f9296459194895c74",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_1471\", \"name\": \"Math 2024 12-Unit Subjects Ranked by School with Department Unit Dispersion and Communication Intensive Counts\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units in the Mathematics department (Course 18), show the subject code, subject title, department name, school name, and the rank within each school name group ordered by subject code, but only include those subjects whose total units exceed the average total units for their respective school. Additionally, for the Mathematics department, also show the average, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects that are offered this year, are letter graded, and are in the Mathematics department), as well as the number of subjects that are Communication Intensive (i.e., have a non-null COMM_REQ_ATTRIBUTE), with these statistics included for each subject in the result. Present the columns in the following order: subject code, subject title, department name, school name, rank within school, average total units, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), and number of Communication Intensive subjects. Do not return any rounded answers.\", \"category\": \"Course Catalog and Department Analysis\", \"sql\": \"WITH Subquery1 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_TITLE, t1.DEPARTMENT_NAME, t0.SCHOOL_NAME, t1.TOTAL_UNITS, RANK() OVER (PARTITION BY t0.SCHOOL_NAME ORDER BY t1.SUBJECT_CODE) AS window_column FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t1.ACADEMIC_YEAR = 2024 AND t1.TOTAL_UNITS = 12 AND t1.DEPARTMENT_NAME = 'Mathematics' ), school_avg AS ( SELECT SCHOOL_NAME, AVG(TOTAL_UNITS) AS avg_units FROM ( SELECT t0.SCHOOL_NAME, t1.TOTAL_UNITS FROM SIS_DEPARTMENT t0 JOIN COURSE_CATALOG_SUBJECT_OFFERED t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT_CODE WHERE t1.ACADEMIC_YEAR = 2024 AND t1.DEPARTMENT_NAME = 'Mathematics' ) sub GROUP BY SCHOOL_NAME ) SELECT i.SUBJECT_CODE, i.SUBJECT_TITLE, i.DEPARTMENT_NAME, i.SCHOOL_NAME, i.window_column FROM inner_cte i JOIN school_avg s ON i.SCHOOL_NAME = s.SCHOOL_NAME WHERE i.TOTAL_UNITS > s.avg_units ), Subquery2 AS ( WITH inner_cte AS ( SELECT ssc.DEPARTMENT_NAME, ccso.SUBJECT_CODE, ccso.TOTAL_UNITS FROM SIS_SUBJECT_CODE ssc JOIN SIS_COURSE_DESCRIPTION scd ON ssc.SUBJECT_CODE = scd.COURSE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON scd.COURSE = ccso.SUBJECT_CODE WHERE ccso.IS_OFFERED_THIS_YEAR = 'Y' AND ccso.GRADE_TYPE = 'L' AND ssc.DEPARTMENT_NAME = 'Mathematics' AND ssc.DEPARTMENT_NAME = 'Mathematics' ) SELECT ic.DEPARTMENT_NAME, AVG(ic.TOTAL_UNITS) AS avg_total_units, VARIANCE(ic.TOTAL_UNITS) AS total_units_variance, STDDEV(ic.TOTAL_UNITS) AS total_units_stddev, COUNT(DISTINCT CASE WHEN ccso.COMM_REQ_ATTRIBUTE IS NOT NULL THEN ic.SUBJECT_CODE END) AS comm_intensive_subject_count FROM inner_cte ic JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON ic.SUBJECT_CODE = ccso.SUBJECT_CODE GROUP BY ic.DEPARTMENT_NAME ORDER BY comm_intensive_subject_count DESC ) SELECT s1.SUBJECT_CODE, s1.SUBJECT_TITLE, s1.DEPARTMENT_NAME, s1.SCHOOL_NAME, s1.window_column, s2.avg_total_units, s2.total_units_variance, s2.total_units_stddev, s2.comm_intensive_subject_count FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.DEPARTMENT_NAME = s2.DEPARTMENT_NAME ORDER BY s1.SCHOOL_NAME, s1.window_column;\", \"default_granularity\": \"one row per 2024 Mathematics 12-unit subject above its school's average total units\"}, {\"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per library subject with status-U reserve materials matched with department unit statistics\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\", \"id\": \"dw_3311\", \"name\": \"Status-U Library Subjects with Enrollment Matched with Department Offered-This-Year Unit Dispersion\", \"sql\": \"WITH DeptStats AS ( SELECT scd.DEPARTMENT_NAME, MAX(ccc.total_units) - MIN(ccc.total_units) AS total_units_range, VARIANCE(ccc.total_units) AS total_units_variance, STDDEV(ccc.total_units) AS total_units_stddev FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_SUBJECT_CODE ssc ON scd.COURSE = ssc.SUBJECT_CODE JOIN CIS_COURSE_CATALOG ccc ON ssc.SUBJECT_CODE = ccc.SUBJECT_CODE WHERE ccc.IS_OFFERED_THIS_YEAR = 'Y' AND ccc.total_units IS NOT NULL GROUP BY scd.DEPARTMENT_NAME ORDER BY total_units_range DESC ), SubjectEnroll AS ( SELECT t1.COURSE_NUMBER, t1.COURSE_NUMBER_DESC, t1.NUM_ENROLLED_STUDENTS, t2.LIBRARY_RESERVE_CATALOG_KEY, DENSE_RANK() OVER (PARTITION BY t2.LIBRARY_MATERIAL_STATUS_KEY ORDER BY t2.LIBRARY_MATERIAL_STATUS_KEY) AS window_column, t1.OFFER_DEPT_NAME FROM LIBRARY_SUBJECT_OFFERED t1 JOIN LIBRARY_RESERVE_MATRL_DETAIL t2 ON t1.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.NUM_ENROLLED_STUDENTS > 0 AND t2.LIBRARY_MATERIAL_STATUS_KEY = 'U' ), CombinedResults AS ( SELECT s.COURSE_NUMBER, s.COURSE_NUMBER_DESC, s.NUM_ENROLLED_STUDENTS, s.LIBRARY_RESERVE_CATALOG_KEY, s.window_column, d.DEPARTMENT_NAME, d.total_units_range, d.total_units_variance, d.total_units_stddev FROM SubjectEnroll s JOIN DeptStats d ON s.OFFER_DEPT_NAME = d.DEPARTMENT_NAME ) SELECT * FROM CombinedResults ORDER BY COURSE_NUMBER, COURSE_NUMBER_DESC;\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per subject code matched with 2024 Mathematics catalog subject\", \"desc\": \"For each subject code in degree-granting departments where the department is Mathematics, and for subjects offered in the academic year 2024 that are also present in the CIS course catalog and are in the Mathematics department, show the subject code, subject code description, department name, school name, rank of the subject code within each school name group ordered by subject code, subject ID, subject number, subject short title, subject title, lecture units, lab units, total units, grade type, grade rule, the minimum total units value over each department code group, and the subject description from the CIS course catalog, ordered by school name, rank, and subject number. Do not return any rounded answers.\", \"id\": \"dw_2210\", \"name\": \"Math Subject Code School Ranks Matched with 2024 Catalog Offerings and Department Min Units\", \"sql\": \"WITH inner_cte AS ( WITH SubjectCodeRanks AS ( SELECT t1.SUBJECT_CODE, t1.SUBJECT_CODE_DESC, t0.DEPARTMENT_NAME, t1.SCHOOL_NAME, RANK() OVER (PARTITION BY t1.SCHOOL_NAME ORDER BY t1.SUBJECT_CODE) AS window_column FROM SIS_DEPARTMENT t0 JOIN SIS_SUBJECT_CODE t1 ON t0.SCHOOL_CODE = t1.SCHOOL_CODE WHERE t0.IS_DEGREE_GRANTING = 'Y' AND t0.DEPARTMENT_NAME = 'Mathematics' ), MathSubjects2024 AS ( SELECT t0.SUBJECT_ID, t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.DEPARTMENT_NAME, t0.SUBJECT_SHORT_TITLE, t0.SUBJECT_TITLE, t0.LECTURE_UNITS, t0.LAB_UNITS, t0.TOTAL_UNITS, t0.GRADE_TYPE, t0.GRADE_RULE, min(t0.TOTAL_UNITS) OVER (PARTITION BY t0.DEPARTMENT_CODE ORDER BY t0.DEPARTMENT_CODE) AS min_total_units_by_dept FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN CIS_COURSE_CATALOG t1 ON t0.SUBJECT_ID = t1.SUBJECT_ID WHERE t0.ACADEMIC_YEAR = 2024 AND t0.DEPARTMENT_NAME = 'Mathematics' ORDER BY t0.DEPARTMENT_CODE ) SELECT scr.SUBJECT_CODE, scr.SUBJECT_CODE_DESC, scr.DEPARTMENT_NAME, scr.SCHOOL_NAME, scr.window_column, ms.SUBJECT_ID, ms.SUBJECT_NUMBER, ms.SUBJECT_SHORT_TITLE, ms.SUBJECT_TITLE, ms.LECTURE_UNITS, ms.LAB_UNITS, ms.TOTAL_UNITS, ms.GRADE_TYPE, ms.GRADE_RULE, ms.min_total_units_by_dept FROM SubjectCodeRanks scr JOIN MathSubjects2024 ms ON scr.SUBJECT_CODE = ms.SUBJECT_CODE ) SELECT ic.SUBJECT_CODE, ic.SUBJECT_CODE_DESC, ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.window_column, ic.SUBJECT_ID, ic.SUBJECT_NUMBER, ic.SUBJECT_SHORT_TITLE, ic.SUBJECT_TITLE, ic.LECTURE_UNITS, ic.LAB_UNITS, ic.TOTAL_UNITS, ic.GRADE_TYPE, ic.GRADE_RULE, ic.min_total_units_by_dept, ccc.SUBJECT_DESCRIPTION FROM inner_cte ic JOIN CIS_COURSE_CATALOG ccc ON ic.SUBJECT_ID = ccc.SUBJECT_ID ORDER BY ic.SCHOOL_NAME, ic.window_column, ic.SUBJECT_NUMBER;\"}, {\"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per subject\", \"desc\": \"For subjects offered in the academic year 2024 with a total of 12 units that are also offered in the library by the Mathematics department during regular terms, show the subject code, subject number, subject title, department name, term description, the rank of each subject within its department ordered by subject code, the number of enrolled students, offering department name, academic year, subject short title, and the maximum total units for each row and the next two rows in order of subject ID. Do not return any rounded answers.\", \"id\": \"dw_3248\", \"name\": \"2024 12-Unit Subjects Matched with Math Library Regular-Term Offerings and 3-Row Max Units\", \"sql\": \"WITH Subjects2024_12Units AS ( SELECT t0.SUBJECT_CODE, t0.SUBJECT_NUMBER, t0.SUBJECT_TITLE, t0.DEPARTMENT_NAME, t1.TERM_DESCRIPTION, RANK() OVER (PARTITION BY t0.DEPARTMENT_NAME ORDER BY t0.SUBJECT_CODE) AS window_column, t0.SUBJECT_ID FROM COURSE_CATALOG_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.EFFECTIVE_TERM_CODE = t1.TERM_CODE JOIN SUBJECT_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2024 AND t0.TOTAL_UNITS = 12 ), MathLibrarySubjects AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.OFFER_DEPT_NAME, t1.TERM_DESCRIPTION, t1.ACADEMIC_YEAR, t2.SUBJECT_SHORT_TITLE, MAX(t2.TOTAL_UNITS) OVER (ORDER BY t0.SUBJECT_ID ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) AS max_total_units, t0.SUBJECT_ID FROM LIBRARY_SUBJECT_OFFERED t0 JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.TERM_CODE AND t0.SUBJECT_ID = t2.SUBJECT_ID WHERE t0.OFFER_DEPT_NAME = 'Mathematics' AND t1.IS_REGULAR_TERM = 'Y' ) SELECT s.SUBJECT_CODE, s.SUBJECT_NUMBER, s.SUBJECT_TITLE, s.DEPARTMENT_NAME, s.TERM_DESCRIPTION, s.window_column, m.NUM_ENROLLED_STUDENTS, m.OFFER_DEPT_NAME, m.ACADEMIC_YEAR, m.SUBJECT_SHORT_TITLE, m.max_total_units FROM Subjects2024_12Units s JOIN MathLibrarySubjects m ON s.SUBJECT_ID = m.SUBJECT_ID ORDER BY s.DEPARTMENT_NAME, s.SUBJECT_CODE, m.NUM_ENROLLED_STUDENTS DESC\"}], \"not_found\": []}"
