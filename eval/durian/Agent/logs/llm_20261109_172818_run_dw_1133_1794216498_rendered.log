          "function": {
            "name": "semantic_get",
            "arguments": "{\"entity_ids\": \n[\"dw_1833\", \"COURSE_CATALOG_SUBJECT_OFFERED\", \"SUBJECT_OFFERED_SUMMARY\", \"SIS_DEPARTMENT\", \"ACADEMIC_TERMS\", \"dw_1474\", \"dw_4234\"]\n\n}"
          }
        },
        {
          "id": "call_87e451bd194b462881abfeaf",
          "type": "function",
          "function": {
            "name": "semantic_get",
            "arguments": "{\"entity_ids\": \n[\"concept_subject_offering_facts\", \"concept_department_dimension\", \"column_concept_total_units\", \"column_concept_department_name\", \"column_concept_year_columns\"]\n\n}"
          }
        }
      ]
    },
    {
      "role": "tool",
      "tool_call_id": "call_0c19703fde1e4663957ed02f",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Facility Space Comprehensive Analysis\", \"default_granularity\": \"one row per department-grade-type rollup row matched with organization room area statistics\", \"desc\": \"For each department and subject grade type where the subject is offered in the current academic year, is letter graded, and the department is Mathematics (Course 18), provide the number of subjects, the minimum total units, the school name, the department phone number, the organization name, the standard deviation (using STDDEV only and never STDDEV_POP) of the areas of its rooms, and the department's DLC name, including subtotals for each department (the corresponding department field is 'SUBTOTAL') and a grand total across all departments (the corresponding department field is 'TOTAL'). Do not repeat the department if it is the same as the previous row. Only include organizations that have more than 5 rooms, are associated with a non-null DLC key, and are not the 'ADMISSIONS' department or the 'Political Science' department. Sort the table by department, grade type, and descending standard deviation (using STDDEV only and never STDDEV_POP) of room areas. Do not return any rounded answers.\", \"id\": \"dw_1833\", \"name\": \"Math Letter-Graded Subject Rollup by Grade Type with Organization Room Area Stddev and DLC Name\", \"sql\": \"WITH inner_cte1 AS ( SELECT d.DEPARTMENT_NAME, c.GRADE_TYPE, COUNT(c.SUBJECT_ID) AS subject_count, MIN(c.TOTAL_UNITS) AS min_total_units FROM SIS_DEPARTMENT d JOIN COURSE_CATALOG_SUBJECT_OFFERED c ON d.DEPARTMENT_CODE = c.DEPARTMENT_CODE WHERE c.IS_OFFERED_THIS_YEAR = 'Y' AND c.GRADE_TYPE = 'L' AND d.DEPARTMENT_NAME = 'Mathematics' AND d.DEPARTMENT_CODE = '18' GROUP BY d.DEPARTMENT_NAME, c.GRADE_TYPE ), cte1 AS ( SELECT CASE WHEN LAG(dept) OVER (ORDER BY dept_sort, grade_type) = dept THEN NULL ELSE dept END AS department, grade_type, subject_count, min_total_units, sd.SCHOOL_NAME AS school_name, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.DLC_KEY AS dlc_key FROM ( SELECT CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'zzz' ELSE DEPARTMENT_NAME END AS dept_sort, CASE WHEN GROUPING(DEPARTMENT_NAME) = 1 THEN 'TOTAL' ELSE DEPARTMENT_NAME END AS dept, GRADE_TYPE AS grade_type, COUNT(SUBJECT_COUNT) AS subject_count, MIN(min_total_units) AS min_total_units FROM inner_cte1 GROUP BY DEPARTMENT_NAME, GRADE_TYPE WITH ROLLUP ) tbltmp LEFT JOIN SIS_DEPARTMENT sd ON tbltmp.dept = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE ), inner_cte2 AS ( SELECT o.ORGANIZATION_NAME, STDDEV(r.AREA) AS area_stddev, o.DLC_KEY FROM FCLT_ORG_DLC_KEY d JOIN FCLT_ORGANIZATION o ON d.FCLT_ORGANIZATION_KEY = o.FCLT_ORGANIZATION_KEY JOIN FCLT_ROOMS r ON o.FCLT_ORGANIZATION_KEY = r.FCLT_ORGANIZATION_KEY WHERE d.DLC_KEY IS NOT NULL AND o.ORGANIZATION_NAME NOT IN ('ADMISSIONS') AND o.ORGANIZATION_NAME <> 'Political Science' GROUP BY o.ORGANIZATION_NAME, o.DLC_KEY HAVING COUNT(*) > 5 ), cte2 AS ( SELECT inner_cte2.ORGANIZATION_NAME, inner_cte2.area_stddev, o2.DLC_NAME, inner_cte2.DLC_KEY FROM inner_cte2 JOIN FCLT_ORGANIZATION o2 ON inner_cte2.DLC_KEY = o2.DLC_KEY ) SELECT cte1.department, cte1.grade_type, cte1.subject_count, cte1.min_total_units, cte1.school_name, cte1.department_phone, cte2.ORGANIZATION_NAME, cte2.area_stddev, cte2.DLC_NAME FROM cte1 LEFT JOIN cte2 ON cte1.dlc_key = cte2.DLC_KEY ORDER BY cte1.department, cte1.grade_type, cte2.area_stddev DESC;\"}, {\"id\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"name\": \"COURSE_CATALOG_SUBJECT_OFFERED\", \"desc\": \"Course catalog subject offering table recording catalog-level attributes of each subject offered per academic year and term: subject identity (SUBJECT_ID = SUBJECT_CODE.SUBJECT_NUMBER), department, unit structure (lecture/lab/preparation/design/total units), grading type and rules, HGN level (Undergraduate/Graduate/High Graduate), requirement attributes (GIR, HASS, communication, writing), term offering flags (this year, fall, IAP, spring, summer), instructors, section flags, responsible faculty, and meeting time/place. Links to terms via both TERM_CODE (the offering term) and EFFECTIVE_TERM_CODE (the term from which catalog attributes take effect).\", \"columns\": {\"ACADEMIC_YEAR\": {\"desc\": \"Academic year of the catalog offering, e.g. 2022\"}, \"TERM_CODE\": {\"desc\": \"Term code of the offering record in YYYYTT format; joins to term tables\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier formed as SUBJECT_CODE + '.' + SUBJECT_NUMBER, e.g. '18.01'; joins to TIP_DETAIL, LIBRARY_SUBJECT_OFFERED, SUBJECT_SUMMARY subject IDs\"}, \"SUBJECT_CODE\": {\"desc\": \"Subject/course code prefix, e.g. '18' for Mathematics; joins to SIS_COURSE_DESCRIPTION.COURSE and SIS_SUBJECT_CODE.SUBJECT_CODE\"}, \"SUBJECT_NUMBER\": {\"desc\": \"Subject number within the subject code, e.g. '01'\"}, \"SOURCE_SUBJECT_ID\": {\"desc\": \"Source system subject identifier\"}, \"PRINT_SUBJECT_ID\": {\"desc\": \"Subject identifier as printed in the bulletin\"}, \"IS_PRINTED_IN_BULLETIN\": {\"desc\": \"'Y'/'N' flag whether the subject is printed in the bulletin\"}, \"DEPARTMENT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Offering department name, e.g. 'Mathematics', 'Chemistry'\"}, \"EFFECTIVE_TERM_CODE\": {\"desc\": \"Term code from which the catalog attributes of this subject take effect; frequently joined to ACADEMIC_TERMS.TERM_CODE for term-status filtering\"}, \"SUBJECT_SHORT_TITLE\": {\"desc\": \"Short title of the subject\"}, \"SUBJECT_TITLE\": {\"desc\": \"Full title of the subject\"}, \"IS_VARIABLE_UNITS\": {\"desc\": \"'Y'/'N' flag whether the subject has variable units\"}, \"LECTURE_UNITS\": {\"desc\": \"Number of lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Number of lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Number of preparation (outside-class) credit units\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject (lecture+lab+preparation unless variable)\"}, \"DESIGN_UNITS\": {\"desc\": \"Number of design credit units\"}, \"GRADE_TYPE\": {\"desc\": \"Grade type code, e.g. 'L' = letter graded\"}, \"GRADE_TYPE_DESC\": {\"desc\": \"Grade type description\"}, \"GRADE_RULE\": {\"desc\": \"Grade rule code\"}, \"GRADE_RULE_DESC\": {\"desc\": \"Grade rule description, e.g. 'Not repeatable for credit'\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_DESC\": {\"desc\": \"HGN level description: 'Undergraduate', 'Graduate', or 'High Graduate'\"}, \"HGN_EXCEPT\": {\"desc\": \"HGN exception indicator\"}, \"GIR_ATTRIBUTE\": {\"desc\": \"General Institute Requirement attribute code\"}, \"GIR_ATTRIBUTE_DESC\": {\"desc\": \"General Institute Requirement attribute description\"}, \"COMM_REQ_ATTRIBUTE\": {\"desc\": \"Communication requirement attribute code\"}, \"COMM_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Communication requirement attribute description\"}, \"TUITION_ATTRIBUTE\": {\"desc\": \"Tuition attribute code\"}, \"TUITION_ATTRIBUTE_DESC\": {\"desc\": \"Tuition attribute description\"}, \"WRITE_REQ_ATTRIBUTE\": {\"desc\": \"Writing requirement attribute code\"}, \"WRITE_REQ_ATTRIBUTE_DESC\": {\"desc\": \"Writing requirement attribute description\"}, \"SUPERVISOR_ATTRIBUTE\": {\"desc\": \"Supervisor attribute code\"}, \"SUPERVISOR_ATTRIBUTE_DESC\": {\"desc\": \"Supervisor attribute description\"}, \"PREREQUISITES\": {\"desc\": \"Prerequisite text for the subject\"}, \"SUBJECT_DESCRIPTION\": {\"desc\": \"Full catalog description text of the subject\"}, \"JOINT_SUBJECTS\": {\"desc\": \"List of joint subjects\"}, \"SCHOOL_WIDE_ELECTIVES\": {\"desc\": \"School-wide elective attribute\"}, \"MEETS_WITH_SUBJECTS\": {\"desc\": \"Subjects this one meets with\"}, \"EQUIVALENT_SUBJECTS\": {\"desc\": \"Equivalent subjects\"}, \"IS_OFFERED_THIS_YEAR\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the current academic year\"}, \"IS_OFFERED_FALL_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the fall term\"}, \"IS_OFFERED_IAP\": {\"desc\": \"'Y'/'N' flag whether the subject is offered during IAP (January)\"}, \"IS_OFFERED_SPRING_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the spring term\"}, \"IS_OFFERED_SUMMER_TERM\": {\"desc\": \"'Y'/'N' flag whether the subject is offered in the summer term\"}, \"FALL_INSTRUCTORS\": {\"desc\": \"Fall term instructor names\"}, \"SPRING_INSTRUCTORS\": {\"desc\": \"Spring term instructor names\"}, \"STATUS_CHANGE\": {\"desc\": \"Catalog status change indicator\"}, \"LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier when the subject is part of a cluster\"}, \"HASS_ATTRIBUTE\": {\"desc\": \"HASS (Humanities, Arts, and Social Sciences) attribute code\"}, \"HASS_ATTRIBUTE_DESC\": {\"desc\": \"HASS attribute description\"}, \"TERM_DURATION\": {\"desc\": \"Duration of the subject within the term\"}, \"GLOBAL_REGIONS\": {\"desc\": \"Global regions associated with the subject\"}, \"GLOBAL_COUNTRIES\": {\"desc\": \"Global countries associated with the subject\"}, \"ON_LINE_PAGE_NUMBER\": {\"desc\": \"Online catalog page number\"}, \"SECTION_ID\": {\"desc\": \"Section identifier of the subject offering\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time text of the subject\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place; stores the FCLT room key and joins to FCLT_ROOMS.FCLT_ROOM_KEY for facility/space analysis\"}}, \"default_granularity\": \"one row per subject offering per term/academic year\"}, {\"id\": \"SUBJECT_OFFERED_SUMMARY\", \"name\": \"SUBJECT_OFFERED_SUMMARY\", \"desc\": \"Subject-level rollup of section offerings per term: one row per subject offered in a term with unit structure (total/lecture/lab/preparation units), offering department and school, responsible faculty, cluster information, and enrollment numbers. Parent of SUBJECT_OFFERED (section level) via COMPOSITE_SUBJECT_KEY / SUBJECT_OFFERED_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Surrogate key of the subject offered summary record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the subject; joins to SIS_SUBJECT_CODE.COURSE_NUMBER and SIS_COURSE_DESCRIPTION.COURSE\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'; joins to TIP_DETAIL.SUBJECT_ID and LIBRARY_SUBJECT_OFFERED.SUBJECT_ID\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'; used for school-level filtering\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"TOTAL_UNITS\": {\"desc\": \"Total credit units of the subject\"}, \"LECTURE_UNITS\": {\"desc\": \"Lecture credit units\"}, \"LAB_UNITS\": {\"desc\": \"Lab credit units\"}, \"PREPARATION_UNITS\": {\"desc\": \"Preparation credit units\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the subject\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}}, \"default_granularity\": \"one row per subject per term\"}, {\"id\": \"SIS_DEPARTMENT\", \"name\": \"SIS_DEPARTMENT\", \"desc\": \"SIS department dimension table: academic departments with code, name, full name, school attribution (code and name), budget code, degree-granting flag, and commencement-book names. Joins to subject offering tables via department codes.\", \"columns\": {\"DEPARTMENT_CODE\": {\"desc\": \"Department code; joins to offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE and SIS_SUBJECT_CODE.DEPARTMENT_CODE\"}, \"DEPARTMENT_NAME\": {\"desc\": \"Department name, e.g. 'Mathematics', 'Chemistry'\"}, \"DEPARTMENT_FULL_NAME\": {\"desc\": \"Full official name of the department\"}, \"SCHOOL_CODE\": {\"desc\": \"School code the department belongs to, e.g. 'E'\"}, \"SCHOOL_NAME\": {\"desc\": \"School name the department belongs to, e.g. 'Engineering'; used for school-level filtering\"}, \"DEPT_BUDGET_CODE\": {\"desc\": \"Budget code of the department; used for budget-based ordering/ranking\"}, \"IS_DEGREE_GRANTING\": {\"desc\": \"'Y'/'N' flag whether the department is degree granting\"}, \"DEPT_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"Department name as printed in the commencement book\"}, \"SCHOOL_NAME_IN_COMMENCEMENT_BK\": {\"desc\": \"School name as printed in the commencement book\"}, \"DEPARTMENT_NAME_HISTORY\": {\"desc\": \"Historical names of the department\"}, \"DEPARTMENT_LAST_ACTIVITY_DATE\": {\"desc\": \"Date of last activity on the department record\"}, \"DLC_KEY\": {\"desc\": \"Degree-granting list/committee key\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per academic department\"}, {\"id\": \"ACADEMIC_TERMS\", \"name\": \"ACADEMIC_TERMS\", \"desc\": \"Academic term dimension table describing each academic term's calendar and status attributes: term code/description, start/end dates, academic year, financial aid year, degree year, key registration and class dates, and term status classification (Previous/Current/Future, regular vs non-regular term). Used to filter and enrich subject offerings by term characteristics.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS_ALL.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2025FA' (FA=Fall, SP=Spring, JA=January/IAP, SU=Summer)\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description, e.g. 'Fall Term 2024-2025'\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date; can match TIME_DAY.CALENDAR_DATE for calendar-based joins\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to, e.g. 2025\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"IS_REGULAR_TERM\": {\"desc\": \"'Y'/'N' flag indicating a regular term (Fall/Spring) versus non-regular terms (Summer, January/IAP); only present in ACADEMIC_TERMS, not in ACADEMIC_TERMS_ALL\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"TERM_STATUS\": {\"desc\": \"Term status text: 'Previous', 'Current', 'Future', or 'Unspecified'\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to; used in degree-year statistics\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"ADD_DATE\": {\"desc\": \"Last day to add a subject in the term; only present in ACADEMIC_TERMS\"}, \"DROP_DATE\": {\"desc\": \"Last day to drop a subject in the term; only present in ACADEMIC_TERMS\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period for the term\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period for the term\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per top-10 department subject-code group matched with a Kevin-named Course-6 student course\", \"desc\": \"For the top 10 degree-granting departments (excluding 'Political Science' and Course 17) that have offered at least one subject in the 'Engineering' school, list the department name, school name, subject code description, the total number of subjects they offered, and the average number of enrolled students per subject, and for each such department, show the full names, email addresses, student years, department full names, course descriptions, course levels, the minimum course level in a window of 3 preceding and 1 following row ordered by the student's last name, and the corresponding subject code and subject code description for each course taken by students named 'Kevin' in 'Electrical Eng & Computer Sci' (Course 6). Do not return any rounded answers.\", \"id\": \"dw_1474\", \"name\": \"Top 10 Engineering Degree-Granting Department Subject Counts with Kevin EECS Student Course Windows\", \"sql\": \"WITH TopDepartments AS ( WITH inner_cte AS ( SELECT d.DEPARTMENT_NAME, d.SCHOOL_NAME, s.SUBJECT_CODE_DESC, COUNT(sos.SUBJECT_OFFERED_SUMMARY_KEY) AS num_subjects FROM SIS_SUBJECT_CODE s JOIN SIS_DEPARTMENT d ON s.DEPARTMENT_CODE = d.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY sos ON d.DEPARTMENT_CODE = sos.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND sos.OFFER_SCHOOL_NAME = 'Engineering' AND d.DEPARTMENT_NAME <> 'Political Science' AND d.DEPARTMENT_CODE <> '17' GROUP BY d.DEPARTMENT_NAME, d.SCHOOL_NAME, s.SUBJECT_CODE_DESC ) SELECT ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SUBJECT_CODE_DESC, ic.num_subjects, AVG(sos.NUM_ENROLLED_STUDENTS) AS avg_enrollment, d.DEPARTMENT_CODE FROM inner_cte ic JOIN SIS_DEPARTMENT d ON ic.DEPARTMENT_NAME = d.DEPARTMENT_NAME AND ic.SCHOOL_NAME = d.SCHOOL_NAME JOIN SUBJECT_OFFERED_SUMMARY sos ON d.DEPARTMENT_CODE = sos.OFFER_DEPT_CODE GROUP BY ic.DEPARTMENT_NAME, ic.SCHOOL_NAME, ic.SUBJECT_CODE_DESC, ic.num_subjects, d.DEPARTMENT_CODE ORDER BY ic.num_subjects DESC LIMIT 10 ), KevinStudents AS ( WITH inner_cte AS ( SELECT t2.FULL_NAME, t2.EMAIL_ADDRESS, t2.STUDENT_YEAR, t1.DEPARTMENT_FULL_NAME, t0.COURSE_DESCRIPTION, t0.COURSE_LEVEL, MIN(t0.COURSE_LEVEL) OVER (ORDER BY t2.LAST_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column, t0.COURSE, t1.DEPARTMENT_CODE FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN MIT_STUDENT_DIRECTORY t2 ON t1.DEPARTMENT_CODE = t2.DEPARTMENT WHERE t2.DEPARTMENT_NAME = 'Electrical Eng & Computer Sci' AND t2.FIRST_NAME = 'Kevin' AND t2.DEPARTMENT = '6' ) SELECT inner_cte.FULL_NAME, inner_cte.EMAIL_ADDRESS, inner_cte.STUDENT_YEAR, inner_cte.DEPARTMENT_FULL_NAME, inner_cte.COURSE_DESCRIPTION, inner_cte.COURSE_LEVEL, inner_cte.window_column, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, inner_cte.DEPARTMENT_CODE FROM inner_cte JOIN SIS_SUBJECT_CODE sc ON inner_cte.COURSE = sc.COURSE_NUMBER ) SELECT td.DEPARTMENT_NAME, td.SCHOOL_NAME, td.SUBJECT_CODE_DESC, td.num_subjects, td.avg_enrollment, ks.FULL_NAME, ks.EMAIL_ADDRESS, ks.STUDENT_YEAR, ks.DEPARTMENT_FULL_NAME, ks.COURSE_DESCRIPTION, ks.COURSE_LEVEL, ks.window_column, ks.SUBJECT_CODE, ks.SUBJECT_CODE_DESC FROM TopDepartments td JOIN KevinStudents ks ON td.DEPARTMENT_CODE = ks.DEPARTMENT_CODE ORDER BY td.DEPARTMENT_NAME, ks.FULL_NAME;\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per 2016SP degree-granting department (with grand total rows) matched with a top-5 Engineering 12-unit-course department\", \"desc\": \"For each department that grants degrees and offered subjects in the term '2016SP', and is also among the top 5 offering departments in the 'Engineering' school with the most 12-unit courses, list the department code, department name, the number of subjects offered, the total units for those subjects, the offering department name, the number of qualifying 12-unit courses, and the course number and description of the most recently added 12-unit course in each department. For each department, also include a grand total row for the number of subjects and total units in the format (department code, null, total subjects, total units, ...). Do not return any rounded answers.\", \"id\": \"dw_4234\", \"name\": \"2016SP Degree-Granting Department Subject Rollups Matched with Top-5 Engineering 12-Unit Course Departments\", \"sql\": \"WITH inner_cte1 AS ( SELECT t2.SUBJECT_ID, dense_rank() OVER (ORDER BY t2.TOTAL_UNITS ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) window_column FROM SIS_COURSE_DESCRIPTION t0 JOIN SIS_DEPARTMENT t1 ON t0.DEPARTMENT = t1.DEPARTMENT_CODE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t2.TERM_CODE = '2016SP' AND t1.IS_DEGREE_GRANTING = 'Y' ), DeptSubjectSummary AS ( SELECT t1.DEPARTMENT_CODE, t1.DEPARTMENT_NAME, COUNT(DISTINCT t2.SUBJECT_ID) AS num_subjects, SUM(t2.TOTAL_UNITS) AS total_units FROM SIS_DEPARTMENT t1 JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.DEPARTMENT_CODE = t2.OFFER_DEPT_CODE WHERE t1.IS_DEGREE_GRANTING = 'Y' AND t2.TERM_CODE = '2016SP' GROUP BY t1.DEPARTMENT_CODE, t1.DEPARTMENT_NAME ), DeptSummaryWithName AS ( SELECT dss.DEPARTMENT_CODE, dss.DEPARTMENT_NAME, dss.num_subjects, dss.total_units FROM DeptSubjectSummary dss UNION ALL SELECT dss.DEPARTMENT_CODE, NULL AS DEPARTMENT_NAME, SUM(dss.num_subjects) AS num_subjects, SUM(dss.total_units) AS total_units FROM DeptSubjectSummary dss GROUP BY dss.DEPARTMENT_CODE ), inner_cte2 AS ( SELECT t0.COURSE AS course_number, t0.COURSE_DESCRIPTION, t1.SUBJECT_TITLE, t1.TOTAL_UNITS, t1.OFFER_DEPT_NAME, t1.OFFER_DEPT_CODE, t0.LAST_ACTIVITY_DATE FROM SIS_COURSE_DESCRIPTION t0 JOIN SUBJECT_OFFERED_SUMMARY t1 ON t0.COURSE = t1.COURSE_NUMBER WHERE t0.SCHOOL_NAME = 'Engineering' AND t1.TOTAL_UNITS = 12 ), TopDepts AS ( SELECT ic.OFFER_DEPT_NAME, ic.OFFER_DEPT_CODE, COUNT(*) AS num_courses, ic_recent.course_number AS most_recent_course_number, ic_recent.COURSE_DESCRIPTION AS most_recent_course_description FROM inner_cte2 ic JOIN ( SELECT OFFER_DEPT_NAME, OFFER_DEPT_CODE, course_number, COURSE_DESCRIPTION, LAST_ACTIVITY_DATE, ROW_NUMBER() OVER (PARTITION BY OFFER_DEPT_NAME ORDER BY LAST_ACTIVITY_DATE DESC) AS rn FROM inner_cte2 ) ic_recent ON ic.OFFER_DEPT_NAME = ic_recent.OFFER_DEPT_NAME AND ic.OFFER_DEPT_CODE = ic_recent.OFFER_DEPT_CODE AND ic_recent.rn = 1 GROUP BY ic.OFFER_DEPT_NAME, ic.OFFER_DEPT_CODE, ic_recent.course_number, ic_recent.COURSE_DESCRIPTION ORDER BY num_courses DESC LIMIT 5 ) SELECT dsw.DEPARTMENT_CODE, dsw.DEPARTMENT_NAME, dsw.num_subjects, dsw.total_units, td.OFFER_DEPT_NAME, td.num_courses, td.most_recent_course_number, td.most_recent_course_description FROM DeptSummaryWithName dsw JOIN TopDepts td ON dsw.DEPARTMENT_CODE = td.OFFER_DEPT_CODE ORDER BY dsw.DEPARTMENT_CODE, dsw.DEPARTMENT_NAME\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_87e451bd194b462881abfeaf",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"concept_subject_offering_facts\", \"name\": \"Subject Offering Fact Tables\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\", \"tables\": [\"COURSE_CATALOG_SUBJECT_OFFERED\", \"SUBJECT_OFFERED\", \"SUBJECT_OFFERED_SUMMARY\", \"SUBJECT_SUMMARY\", \"TIP_SUBJECT_OFFERED\", \"LIBRARY_SUBJECT_OFFERED\"], \"comparisons\": [{\"dimension\": \"Granularity\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Subject offering per term/academic year (catalog record, includes section flags)\", \"SUBJECT_OFFERED\": \"Subject section per term (finest grain, SECTION_ID)\", \"SUBJECT_OFFERED_SUMMARY\": \"Subject per term (rollup of sections)\", \"SUBJECT_SUMMARY\": \"Subject or cluster per term\", \"TIP_SUBJECT_OFFERED\": \"Subject per term within textbook program scope\", \"LIBRARY_SUBJECT_OFFERED\": \"Subject per term within library reserve scope\"}, {\"dimension\": \"Enrollment measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"None (catalog attributes only)\", \"SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, SECTION_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_OFFERED_SUMMARY\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_SUMMARY\": \"SUBJECT_ENROLLMENT_NUMBER plus first-week/fifth-week and credit/listener enrollment splits\", \"TIP_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\", \"LIBRARY_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\"}, {\"dimension\": \"Unit measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS, DESIGN_UNITS, TOTAL_UNITS, IS_VARIABLE_UNITS\", \"SUBJECT_OFFERED\": \"None\", \"SUBJECT_OFFERED_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS\", \"SUBJECT_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREP_UNITS, DESIGN_UNITS\", \"TIP_SUBJECT_OFFERED\": \"None\", \"LIBRARY_SUBJECT_OFFERED\": \"None\"}, {\"dimension\": \"Distinctive attributes\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"HGN_DESC level, GRADE_TYPE/GRADE_RULE, HASS/GIR attributes, IS_OFFERED_* flags, MEET_PLACE (room key), ACADEMIC_YEAR, EFFECTIVE_TERM_CODE\", \"SUBJECT_OFFERED\": \"IS_REPEATABLE_SUBJECT, CLUSTER_TYPE, section flags, FORM_TYPE, EVALUATE_THIS_SUBJECT\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_SCHOOL_NAME, COURSE_NUMBER, cluster info at subject level\", \"SUBJECT_SUMMARY\": \"SCHOOL_CODE/SCHOOL_NAME, SUBJECT_GROUP_ID, SUBJECT_OR_CLUSTER, detailed weekly enrollment\", \"TIP_SUBJECT_OFFERED\": \"IS_NO_COURSE_MATERIAL flag; parent of TIP_DETAIL materials\", \"LIBRARY_SUBJECT_OFFERED\": \"COURSE_NUMBER/COURSE_NUMBER_DESC; parent of LIBRARY_RESERVE_MATRL_DETAIL\"}, {\"dimension\": \"Department column naming\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_SUMMARY\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"TIP_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\"}], \"decision_guide\": {\"Questions about credit units, grading type/rules, HGN level (undergraduate/graduate), HASS/GIR attributes, or term offering flags (fall/spring/IAP/summer)\": \"Use COURSE_CATALOG_SUBJECT_OFFERED; it is the only offering table carrying full catalog attributes.\", \"Questions about actual section-level offerings, repeatability, cluster type, or section flags\": \"Use SUBJECT_OFFERED (section grain); roll up via SUBJECT_OFFERED_SUMMARY when subject-level totals are needed.\", \"Questions about final enrollment statistics, weekly enrollment snapshots, credit vs listener counts, subject groups, or school-level unit statistics\": \"Use SUBJECT_SUMMARY.\", \"Questions about textbooks/course materials per subject (required/optional status, ISBN, record counts)\": \"Start from TIP_SUBJECT_OFFERED (subject scope, IS_NO_COURSE_MATERIAL) joined to TIP_DETAIL (material rows).\", \"Questions about library reserve materials, reserve counts per subject, or library course numbers\": \"Start from LIBRARY_SUBJECT_OFFERED joined to LIBRARY_RESERVE_MATRL_DETAIL.\", \"Questions about subject-level units with offering department/school (e.g. Engineering school enrollment totals by department)\": \"Use SUBJECT_OFFERED_SUMMARY, which carries both TOTAL_UNITS and OFFER_SCHOOL_NAME.\"}}, {\"id\": \"concept_department_dimension\", \"name\": \"Department and School Dimension\", \"desc\": \"Lookup tables describing academic departments and their school attribution: the SIS department dimension, the student-facing department lookup, and the SIS administrative department (contact information). They answer questions about department names, full names, school code/name, degree-granting status, budget codes, and department phone numbers, but differ in attribute coverage.\", \"tables\": [\"SIS_DEPARTMENT\", \"STUDENT_DEPARTMENT\", \"SIS_ADMIN_DEPARTMENT\"], \"comparisons\": [{\"dimension\": \"Attribute coverage\", \"SIS_DEPARTMENT\": \"Richest: DEPARTMENT_FULL_NAME, SCHOOL_CODE/SCHOOL_NAME, DEPT_BUDGET_CODE, IS_DEGREE_GRANTING, commencement-book names, DLC key\", \"STUDENT_DEPARTMENT\": \"Minimal: code, name, full name, school code/name only\", \"SIS_ADMIN_DEPARTMENT\": \"Administrative contact: department phone area code/number, clearing cost collector\"}, {\"dimension\": \"Degree-granting and school filtering\", \"SIS_DEPARTMENT\": \"Supports IS_DEGREE_GRANTING and SCHOOL_NAME filters directly\", \"STUDENT_DEPARTMENT\": \"Only school code/name attribution, no degree-granting flag\", \"SIS_ADMIN_DEPARTMENT\": \"No school or degree-granting attributes\"}, {\"dimension\": \"Typical join path\", \"SIS_DEPARTMENT\": \"DEPARTMENT_CODE = offering tables' DEPARTMENT_CODE/OFFER_DEPT_CODE; also joins SIS_COURSE_DESCRIPTION.DEPARTMENT and SIS_ADMIN_DEPARTMENT.SIS_ADMIN_DEPARTMENT_CODE\", \"STUDENT_DEPARTMENT\": \"DEPARTMENT_CODE = TIP_SUBJECT_OFFERED.OFFER_DEPT_CODE and other offering department codes\", \"SIS_ADMIN_DEPARTMENT\": \"SIS_ADMIN_DEPARTMENT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE\"}, {\"dimension\": \"Budget/finance attributes\", \"SIS_DEPARTMENT\": \"DEPT_BUDGET_CODE available for budget-based ranking\", \"STUDENT_DEPARTMENT\": \"None\", \"SIS_ADMIN_DEPARTMENT\": \"CLEARING_COST_COLLECTOR\"}], \"decision_guide\": {\"Questions filtering departments by school (e.g. 'School of Engineering') or degree-granting status\": \"Use SIS_DEPARTMENT; it carries SCHOOL_NAME and IS_DEGREE_GRANTING.\", \"Questions needing only department full name and school name for offering departments (e.g. TIP subject offerings)\": \"STUDENT_DEPARTMENT suffices and is the lighter lookup; SIS_DEPARTMENT also works.\", \"Questions needing department phone numbers or administrative contact details\": \"Join SIS_ADMIN_DEPARTMENT via SIS_DEPARTMENT.DEPARTMENT_CODE = SIS_ADMIN_DEPARTMENT_CODE.\", \"Questions ranking or grouping departments by budget code\": \"Use SIS_DEPARTMENT.DEPT_BUDGET_CODE.\"}}, {\"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS\", \"SUBJECT_SUMMARY.TOTAL_UNITS\", \"SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS\", \"CIS_COURSE_CATALOG.TOTAL_UNITS\", \"DRUPAL_COURSE_CATALOG.TOTAL_UNITS\"], \"comparisons\": [{\"dimension\": \"Source process\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS is the catalog-declared unit value per offering; SUBJECT_SUMMARY.TOTAL_UNITS and SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS are registrar subject-level values; CIS/DRUPAL catalog feeds carry their own copies\"}, {\"dimension\": \"Companion unit columns\", \"detail\": \"All these tables also expose LECTURE_UNITS, LAB_UNITS, and preparation units (PREPARATION_UNITS except SUBJECT_SUMMARY which uses PREP_UNITS); DESIGN_UNITS exists in COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY, CIS and DRUPAL catalogs but not in SUBJECT_OFFERED_SUMMARY\"}, {\"dimension\": \"Variability flag\", \"detail\": \"COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS marks subjects whose units vary; analyses of fixed-unit statistics typically filter IS_VARIABLE_UNITS='N'\"}], \"decision_guide\": {\"Unit statistics (avg/stddev/variance/geometric mean) over catalog offerings, optionally split by lecture/lab/design or filtered by variable-units flag\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.TOTAL_UNITS with its companion unit columns.\", \"Unit statistics tied to actual enrollment records or subject groups per term\": \"Use SUBJECT_SUMMARY.TOTAL_UNITS.\", \"Unit statistics at subject-offering rollup level with offering department/school\": \"Use SUBJECT_OFFERED_SUMMARY.TOTAL_UNITS.\", \"Fixed-unit analyses excluding variable-unit subjects\": \"Filter COURSE_CATALOG_SUBJECT_OFFERED.IS_VARIABLE_UNITS = 'N'.\"}, \"desc\": \"Total credit unit columns replicated across catalog and registrar subject tables. They represent the same business quantity (total credit units of a subject) but come from different processes and pair with different companion unit columns.\", \"id\": \"column_concept_total_units\", \"name\": \"Total Credit Units\"}, {\"id\": \"column_concept_department_name\", \"name\": \"Department Name\", \"desc\": \"Department name columns across subject offering, catalog, lookup, employee, and library reserve instructor tables. Two academic naming conventions exist (DEPARTMENT_NAME vs OFFER_DEPT_NAME) with the same academic value domain; LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT also holds academic departments but in a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics'); EMPLOYEE_DIRECTORY.DEPARTMENT_NAME shares the column name but holds the HR organizational unit name (different value domain). Choosing the right one depends on the table family, the value format, whether the department is the catalog owner or the actual offering department, and whether an academic or HR department is meant.\", \"columns\": [\"COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME\", \"SUBJECT_SUMMARY.DEPARTMENT_NAME\", \"SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY.OFFER_DEPT_NAME\", \"TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED.OFFER_DEPT_NAME\", \"SIS_DEPARTMENT.DEPARTMENT_NAME\", \"STUDENT_DEPARTMENT.DEPARTMENT_NAME\", \"SIS_COURSE_DESCRIPTION.DEPARTMENT_NAME\", \"SIS_SUBJECT_CODE.DEPARTMENT_NAME\", \"EMPLOYEE_DIRECTORY.DEPARTMENT_NAME\", \"LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT\", \"MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME\", \"SE_PERSON.ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DEPARTMENT_NAME is used by catalog/summary tables (COURSE_CATALOG_SUBJECT_OFFERED, SUBJECT_SUMMARY), department/course lookup tables, and the student directory (MIT_STUDENT_DIRECTORY); OFFER_DEPT_NAME is used by offering/program tables (SUBJECT_OFFERED, SUBJECT_OFFERED_SUMMARY, TIP_SUBJECT_OFFERED, LIBRARY_SUBJECT_OFFERED) and denotes the department that actually offers the subject; LIBRARY_COURSE_INSTRUCTOR uses the plain column name DEPARTMENT for the course's academic department; SE_PERSON uses ORGANIZATION for the person's organizational unit\"}, {\"dimension\": \"Value format\", \"detail\": \"Catalog, summary, offering, student-directory, and lookup tables store plain department names (e.g. 'Mathematics', 'Chemistry', 'Electrical Eng & Computer Sci'); LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT stores a 'COURSE_NUMBER - Department Name' prefixed format (e.g. '18 - Mathematics', '06 - Electrical Eng & Computer Sci'), with some unprefixed values (e.g. 'Architecture'), so it is not directly comparable to plain-name columns without stripping the prefix\"}, {\"dimension\": \"Academic vs HR/organization value domain\", \"detail\": \"Catalog, summary, offering, library, student-directory, and lookup tables share the academic department domain; EMPLOYEE_DIRECTORY.DEPARTMENT_NAME is the HR organizational unit name and has a different domain (e.g. 'Lincoln Laboratory', 'Department of Physics'), where some values coincide with academic names but many do not, and some carry a 'Department of ...' prefix; SE_PERSON.ORGANIZATION holds organizational unit names that may use different naming variants than the academic domain for the same unit (e.g. 'Electrical Engineering-Computer Science' vs the academic 'Electrical Eng & Computer Sci'), so equality filters across the two conventions must use each table's own variant\"}, {\"dimension\": \"Companion code column\", \"detail\": \"Catalog/summary tables carry DEPARTMENT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE; offering/program tables carry OFFER_DEPT_CODE joining SIS_DEPARTMENT.DEPARTMENT_CODE or STUDENT_DEPARTMENT.DEPARTMENT_CODE; MIT_STUDENT_DIRECTORY carries DEPARTMENT (the academic department code) joining SIS_DEPARTMENT.DEPARTMENT_CODE, which is the reliable join key instead of the name; LIBRARY_COURSE_INSTRUCTOR has no department code column, only the prefixed name text; EMPLOYEE_DIRECTORY carries DEPARTMENT_NUMBER (HR department number) and SE_PERSON carries no department code, neither joining to SIS_DEPARTMENT.DEPARTMENT_CODE\"}], \"decision_guide\": {\"Filtering subjects by department in catalog or summary analysis\": \"Use COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME or SUBJECT_SUMMARY.DEPARTMENT_NAME.\", \"Filtering by department in section-level, textbook-program, or library analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Joining fact tables to department dimension attributes (school, full name, degree-granting)\": \"Prefer code joins: DEPARTMENT_CODE / OFFER_DEPT_CODE = SIS_DEPARTMENT.DEPARTMENT_CODE; name equality joins are used when codes are unavailable.\", \"Matching departments across a DEPARTMENT_NAME table and an OFFER_DEPT_NAME table\": \"The values are directly comparable (same academic name domain), e.g. joining SUBJECT_SUMMARY.DEPARTMENT_NAME to TIP_SUBJECT_OFFERED.OFFER_DEPT_NAME.\", \"Filtering employees by their HR organizational unit (e.g. names containing 'Department', or HR units like 'Political Science')\": \"Use EMPLOYEE_DIRECTORY.DEPARTMENT_NAME; do not join it to SIS_DEPARTMENT.DEPARTMENT_CODE, and pair it with DEPARTMENT_NUMBER for HR grouping.\", \"Filtering by department in section-level, textbook-program, or library subject analysis\": \"Use the OFFER_DEPT_NAME column of SUBJECT_OFFERED / SUBJECT_OFFERED_SUMMARY / TIP_SUBJECT_OFFERED / LIBRARY_SUBJECT_OFFERED.\", \"Filtering library reserve course instructors by academic department or library unit\": \"Use LIBRARY_COURSE_INSTRUCTOR.DEPARTMENT with the prefixed value format (e.g. '18 - Mathematics'); do not compare it directly to plain department-name columns.\", \"Filtering students by their academic department\": \"Use MIT_STUDENT_DIRECTORY.DEPARTMENT (code) joined to SIS_DEPARTMENT.DEPARTMENT_CODE for reliable matching, or MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME for direct name filters; the name shares the academic domain with SIS_DEPARTMENT.DEPARTMENT_NAME.\", \"Filtering a person master (SE_PERSON) record by organizational unit such as an academic department\": \"Use SE_PERSON.ORGANIZATION with its own naming variant (e.g. 'Electrical Engineering-Computer Science'); do not equate it directly to MIT_STUDENT_DIRECTORY.DEPARTMENT_NAME or SIS_DEPARTMENT.DEPARTMENT_NAME, which use the academic variant (e.g. 'Electrical Eng & Computer Sci').\"}}, {\"columns\": [\"ACADEMIC_TERMS.ACADEMIC_YEAR\", \"ACADEMIC_TERMS_ALL.ACADEMIC_YEAR\", \"COURSE_CATALOG_SUBJECT_OFFERED.ACADEMIC_YEAR\", \"TIME_DAY.ACADEMIC_YEAR\", \"TIME_DAY.FISCAL_YEAR\", \"TIME_DAY.CALENDAR_YEAR\", \"TIME_MONTH.ACADEMIC_YEAR\", \"TIME_MONTH.FISCAL_YEAR\", \"TIME_MONTH.CALENDAR_YEAR\", \"TIME_MONTH.FINANCIAL_AID_YEAR\", \"TIME_QUARTER.FISCAL_YEAR\", \"TIME_QUARTER.CALENDAR_YEAR\", \"ACADEMIC_TERMS.FINANCIAL_AID_YEAR\", \"ACADEMIC_TERMS_ALL.FINANCIAL_AID_YEAR\", \"ACADEMIC_TERMS.DEGREE_YEAR\"], \"comparisons\": [{\"dimension\": \"Year system\", \"detail\": \"ACADEMIC_YEAR is the academic year a term/offering/date belongs to; FISCAL_YEAR is the institute fiscal year (MIT fiscal year starts in July, so a fiscal year spans two calendar years); CALENDAR_YEAR is the natural calendar year; FINANCIAL_AID_YEAR is the aid year a term/month maps to; DEGREE_YEAR is the degree-conferral year a term maps to. These year systems do not always coincide for the same term or date.\"}, {\"dimension\": \"Location\", \"detail\": \"Term tables (ACADEMIC_TERMS/ACADEMIC_TERMS_ALL) carry academic/financial-aid/degree years per term; COURSE_CATALOG_SUBJECT_OFFERED carries its own ACADEMIC_YEAR per catalog record; the time dimension tables carry year systems at their own granularity: TIME_DAY (fiscal/calendar/academic year per day), TIME_MONTH (fiscal/calendar/academic/aid year per month), TIME_QUARTER (fiscal/calendar year per quarter, no academic year).\"}, {\"dimension\": \"Grouping behavior\", \"detail\": \"Grouping offerings by catalog ACADEMIC_YEAR vs joining to term tables' ACADEMIC_YEAR can yield different groupings when a catalog record's TERM_CODE and ACADEMIC_YEAR disagree; grouping time-dimension rows by FISCAL_YEAR vs CALENDAR_YEAR yields different period assignments for dates between January and June.\"}], \"decision_guide\": {\"Yearly statistics over subject offerings\": \"Group by COURSE_CATALOG_SUBJECT_OFFERED.ACADEMIC_YEAR when the question says 'academic year YYYY' for offerings; join term tables for term-status filters.\", \"Yearly statistics over terms themselves (e.g. degree year geometric means, financial aid year partitions)\": \"Use ACADEMIC_TERMS / ACADEMIC_TERMS_ALL year columns (DEGREE_YEAR, FINANCIAL_AID_YEAR).\", \"Matching IAP activity dates to academic years via calendar\": \"Use TIME_DAY.FISCAL_YEAR or TIME_DAY.ACADEMIC_YEAR through TERM_CODE = ACADEMIC_TERM_CODE.\", \"Windowed running sums partitioned by aid year\": \"Use ACADEMIC_TERMS_ALL.FINANCIAL_AID_YEAR as the partition key.\", \"Fiscal-year or calendar-month statistics over months/days\": \"Use TIME_MONTH.FISCAL_YEAR / TIME_MONTH.CALENDAR_YEAR (month grain) or TIME_DAY.CALENDAR_YEAR (day grain), joined on FISCAL_PERIOD when both grains are needed.\"}, \"desc\": \"Year columns across term, catalog, and time dimension tables representing different year systems: academic year, fiscal year, financial aid year, and degree year. Selecting the correct year system is essential for yearly grouping and partitioning.\", \"id\": \"column_concept_year_columns\", \"name\": \"Academic and Fiscal Year Columns\"}], \"not_found\": []}"
    },
