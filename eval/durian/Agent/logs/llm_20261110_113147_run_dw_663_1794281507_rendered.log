ENT_DEPARTMENT sd ON s.DEPARTMENT_CODE = sd.DEPARTMENT_CODE ) SELECT * FROM inner_cte;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA TIP subject offering enriched with department-level enrollment coefficient of variation and school code\"}, {\"category\": \"Person Master and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per employee type and department name combination of graduate students\", \"desc\": \"For each employee type and department name where the student year is 'G', show the number of people, the minimum MIT ID, and the list of unique office locations for those employees. Do not return any rounded answers.\", \"id\": \"dw_2759\", \"name\": \"Graduate Student Employee Type Department Counts with Min MIT ID and Unique Office Locations\", \"sql\": \"WITH inner_cte AS ( SELECT sp.EMPLOYEE_TYPE, msd.DEPARTMENT_NAME, COUNT(sp.MIT_ID) AS person_count, MIN(sp.MIT_ID) AS min_mit_id FROM SE_PERSON sp JOIN MIT_STUDENT_DIRECTORY msd ON sp.FULL_NAME = msd.FULL_NAME WHERE msd.STUDENT_YEAR = 'G' GROUP BY sp.EMPLOYEE_TYPE, msd.DEPARTMENT_NAME ) SELECT inner_cte.EMPLOYEE_TYPE, inner_cte.DEPARTMENT_NAME, inner_cte.person_count, inner_cte.min_mit_id, GROUP_CONCAT(DISTINCT sp.OFFICE_LOCATION) AS unique_office_locations FROM inner_cte JOIN SE_PERSON sp ON sp.EMPLOYEE_TYPE = inner_cte.EMPLOYEE_TYPE JOIN MIT_STUDENT_DIRECTORY msd ON sp.FULL_NAME = msd.FULL_NAME AND msd.DEPARTMENT_NAME = inner_cte.DEPARTMENT_NAME AND msd.STUDENT_YEAR = 'G' GROUP BY inner_cte.EMPLOYEE_TYPE, inner_cte.DEPARTMENT_NAME, inner_cte.person_count, inner_cte.min_mit_id;\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per Course-6 student matched with a Course-6 Engineering subject offering\", \"desc\": \"For students whose department is '6' and whose department name is 'Electrical Eng & Computer Sci', show their first name, 