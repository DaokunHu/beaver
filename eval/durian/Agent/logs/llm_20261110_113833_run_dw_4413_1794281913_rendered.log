            "name": "submit_SQL",
            "arguments": "{\"sql\": \"WITH inner_cte AS (\\n  SELECT t0.ACTIVITY_TITLE, t0.TERM_CODE, t0.MAX_ENROLLMENT, t1.TERM_DESCRIPTION, t1.TERM_START_DATE,\\n         t2.SUBJECT_TITLE, t2.NUM_ENROLLED_STUDENTS,\\n         ROW_NUMBER() OVER (PARTITION BY t2.SUBJECT_TITLE ORDER BY t0.ACTIVITY_TITLE) AS window_column\\n  FROM IAP_SUBJECT_DETAIL t0\\n  JOIN ACADEMIC_TERMS t1 ON t0.TERM_CODE = t1.TERM_CODE\\n  JOIN LIBRARY_SUBJECT_OFFERED t2 ON t1.TERM_CODE = t2.TERM_CODE\\n  WHERE t0.ENROLLMENT_TYPE = 'Advance sign-up required' AND t0.MAX_ENROLLMENT = 12\\n),\\nsubq1 AS (\\n  SELECT inner_cte.ACTIVITY_TITLE, inner_cte.TERM_CODE, inner_cte.MAX_ENROLLMENT,\\n         inner_cte.TERM_DESCRIPTION, inner_cte.TERM_START_DATE,\\n         inner_cte.SUBJECT_TITLE, inner_cte.NUM_ENROLLED_STUDENTS,\\n         t2.OFFER_DEPT_NAME, t2.RESPONSIBLE_FACULTY_NAME, inner_cte.window_column\\n  FROM inner_cte\\n  JOIN LIBRARY_SUBJECT_OFFERED t2\\n    ON inner_cte.TERM_CODE = t2.TERM_CODE AND inner_cte.SUBJECT_TITLE = t2.SUBJECT_TITLE\\n  WHERE inner_cte.NUM_ENROLLED_STUDENTS >= 10\\n),\\nmaterial_cte AS (\\n  SELECT IAP_SUBJECT_DETAIL.ACTIVITY_TITLE, ACADEMIC_TERMS.TERM_DESCRIPTION,\\n         COUNT(TIP_DETAIL.TIP_MATERIAL_KEY) AS material_count\\n  FROM IAP_SUBJECT_DETAIL\\n  JOIN ACADEMIC_TERMS ON IAP_SUBJECT_DETAIL.TERM_CODE = ACADEMIC_TERMS.TERM_CODE\\n  JOIN TIP_DETAIL ON ACADEMIC_TERMS.TERM_CODE = TIP_DETAIL.TERM_CODE\\n  WHERE IAP_SUBJECT_DETAIL.IS_CANCELLED = 'N'\\n  GROUP BY IAP_SUBJECT_DETAIL.ACTIVITY_TITLE, ACADEMIC_TERMS.TERM_DESCRIPTION\\n),\\nsubq2 AS (\\n  SELECT ACTIVITY_TITLE, MAX(material_count) AS highest_material_count\\n  FROM material_cte\\n  GROUP BY ACTIVITY_TITLE\\n)\\nSELECT subq1.ACTIVITY_TITLE, subq1.TERM_CODE, subq1.MAX_ENROLLMENT,\\n       subq1.TERM_DESCRIPTION, subq1.TERM_START_DATE,\\n       subq1.SUBJECT_TITLE, subq1.NUM_ENROLLED_STUDENTS,\\n       subq1.OFFER_DEPT_NAME, subq1.RESPONSIBLE_FACULTY_NAME,\\n       subq1.window_column, subq2.highest_material_count\\nFROM subq1\\nJOIN subq2 ON subq1.ACTIVITY_TITLE = subq2.ACTIVITY_TITLE\\nORDER BY subq1.SUBJECT_TITLE, subq1.ACTIVITY_TITLE\"}"
