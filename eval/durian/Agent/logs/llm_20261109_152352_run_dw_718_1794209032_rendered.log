    {
      "role": "tool",
      "tool_call_id": "call_901c7365673640eca4c29811",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department from either the Math 2008 stats branch or the high-average-units branch\", \"desc\": \"List, for each department, either (a) the department's full name, the range and variance of the total units for degree-granting Mathematics department courses offered in the 2008 academic year along with the long course description for each course (with the reason 'Math 2008 Stats'), or (b) the department name, the average and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered by that department (considering only subjects with more than 0 total units) where the average total units is greater than the overall average across all departments (with the reason 'High Avg Units'). Show the columns in the following order: department name, total units range, total units variance, average total units, standard deviation (using STDDEV only and never STDDEV_POP) of total units, long course description, and reason for inclusion. Do not return any rounded answers.\", \"id\": \"dw_1335\", \"name\": \"Union of Math 2008 Unit Range-Variance with Long Descriptions and High Average Unit Department Stddev\", \"sql\": \"WITH Subquery1 AS ( WITH inner_cte AS ( SELECT sd.DEPARTMENT_FULL_NAME, MAX(ccc.TOTAL_UNITS) - MIN(ccc.TOTAL_UNITS) AS total_units_range, VARIANCE(ccc.TOTAL_UNITS) AS total_units_variance FROM CIS_COURSE_CATALOG ccc JOIN SIS_DEPARTMENT sd ON ccc.DEPARTMENT_CODE = sd.DEPARTMENT_CODE WHERE ccc.ACADEMIC_YEAR = '2008' AND sd.IS_DEGREE_GRANTING = 'Y' AND sd.DEPARTMENT_NAME = 'Mathematics' AND ccc.DEPARTMENT_CODE = '18' GROUP BY sd.DEPARTMENT_FULL_NAME ) SELECT i.DEPARTMENT_FULL_NAME, i.total_units_range, i.total_units_variance, scd.COURSE_DESCRIPTION_LONG FROM inner_cte i JOIN SIS_COURSE_DESCRIPTION scd ON scd.DEPARTMENT = 18 AND scd.DEPARTMENT_NAME = 'Mathematics' ), Subquery2 AS ( WITH inner_cte AS ( SELECT scd.DEPARTMENT_NAME, AVG(sos.TOTAL_UNITS) AS avg_total_units, STDDEV(sos.TOTAL_UNITS) AS stddev_total_units FROM SIS_COURSE_DESCRIPTION scd JOIN SUBJECT_OFFERED_SUMMARY sos ON scd.COURSE = sos.COURSE_NUMBER WHERE sos.TOTAL_UNITS > 0 GROUP BY scd.DEPARTMENT_NAME ) SELECT DEPARTMENT_NAME, avg_total_units, stddev_total_units FROM inner_cte WHERE avg_total_units > ( SELECT AVG(TOTAL_UNITS) FROM SUBJECT_OFFERED_SUMMARY WHERE TOTAL_UNITS > 0 ) ORDER BY stddev_total_units DESC ), CombinedResults AS ( SELECT s1.DEPARTMENT_FULL_NAME AS DEPARTMENT_NAME, s1.total_units_range, s1.total_units_variance, NULL AS avg_total_units, NULL AS stddev_total_units, s1.COURSE_DESCRIPTION_LONG, 'Math 2008 Stats' AS Reason FROM Subquery1 s1 UNION ALL SELECT s2.DEPARTMENT_NAME, NULL AS total_units_range, NULL AS total_units_variance, s2.avg_total_units, s2.stddev_total_units, NULL AS COURSE_DESCRIPTION_LONG, 'High Avg Units' AS Reason FROM Subquery2 s2 ) SELECT * FROM CombinedResults ORDER BY DEPARTMENT_NAME;\"}, {\"category\": \"Library Reserve and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per library subject with status-U reserve materials matched with department unit statistics\", \"desc\": \"For each course that has more than 0 enrolled students and a material status key of 'U', list the course number, course number description, number of enrolled students, reserve catalog key, and the dense rank over the material status key ordered by material status key, along with the department name, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the total units of courses offered by that department (considering only courses offered this year with non-null total units). Present the results ordered by course number and course number description. Do not return any rounded answers.\", \"id\": \"dw_3311\", \"name\": \"Status-U Library Subjects with Enrollment Matched with Department Offered-This-Year Unit Dispersion\", \"sql\": \"WITH DeptStats AS ( SELECT scd.DEPARTMENT_NAME, MAX(ccc.total_units) - MIN(ccc.total_units) AS total_units_range, VARIANCE(ccc.total_units) AS total_units_variance, STDDEV(ccc.total_units) AS total_units_stddev FROM SIS_COURSE_DESCRIPTION scd JOIN SIS_SUBJECT_CODE ssc ON scd.COURSE = ssc.SUBJECT_CODE JOIN CIS_COURSE_CATALOG ccc ON ssc.SUBJECT_CODE = ccc.SUBJECT_CODE WHERE ccc.IS_OFFERED_THIS_YEAR = 'Y' AND ccc.total_units IS NOT NULL GROUP BY scd.DEPARTMENT_NAME ORDER BY total_units_range DESC ), SubjectEnroll AS ( SELECT t1.COURSE_NUMBER, t1.COURSE_NUMBER_DESC, t1.NUM_ENROLLED_STUDENTS, t2.LIBRARY_RESERVE_CATALOG_KEY, DENSE_RANK() OVER (PARTITION BY t2.LIBRARY_MATERIAL_STATUS_KEY ORDER BY t2.LIBRARY_MATERIAL_STATUS_KEY) AS window_column, t1.OFFER_DEPT_NAME FROM LIBRARY_SUBJECT_OFFERED t1 JOIN LIBRARY_RESERVE_MATRL_DETAIL t2 ON t1.SUBJECT_ID = t2.SUBJECT_ID WHERE t1.NUM_ENROLLED_STUDENTS > 0 AND t2.LIBRARY_MATERIAL_STATUS_KEY = 'U' ), CombinedResults AS ( SELECT s.COURSE_NUMBER, s.COURSE_NUMBER_DESC, s.NUM_ENROLLED_STUDENTS, s.LIBRARY_RESERVE_CATALOG_KEY, s.window_column, d.DEPARTMENT_NAME, d.total_units_range, d.total_units_variance, d.total_units_stddev FROM SubjectEnroll s JOIN DeptStats d ON s.OFFER_DEPT_NAME = d.DEPARTMENT_NAME ) SELECT * FROM CombinedResults ORDER BY COURSE_NUMBER, COURSE_NUMBER_DESC;\"}, {\"id\": \"dw_4527\", \"name\": \"2021 Engineering Degree-Granting Department Enrollment Dispersion with Above-Average Subject Details\", \"desc\": \"For each department that is degree-granting and offered at least one subject in the School of Engineering in 2021, provide the department code, department name, department full name, the number of subjects offered, the total number of enrolled students in those subjects, the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in subjects offered by that department (considering only subjects with a non-null subject code description), and, for each subject in 2021 offered by these departments in the School of Engineering, list the subject id, subject title, and the number of enrolled students, but only include subjects where the number of enrolled students exceeds the average enrollment for that department in 2021. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH eng_dept_2021_summary AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME, COUNT(s.SUBJECT_OFFERED_SUMMARY_KEY) AS subject_count, SUM(s.NUM_ENROLLED_STUDENTS) AS total_enrollment FROM SIS_DEPARTMENT d JOIN SUBJECT_OFFERED_SUMMARY s ON d.DEPARTMENT_CODE = s.OFFER_DEPT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, d.DEPARTMENT_FULL_NAME ), dept_enrollment_stats AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, VARIANCE(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_variance, STDDEV(t.NUM_ENROLLED_STUDENTS) AS enrolled_students_stddev FROM TIP_SUBJECT_OFFERED t JOIN SIS_DEPARTMENT d ON t.OFFER_DEPT_CODE = d.DEPARTMENT_CODE JOIN SIS_SUBJECT_CODE s ON d.DEPARTMENT_CODE = s.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.SUBJECT_CODE_DESC IS NOT NULL GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME ) SELECT e.DEPARTMENT_CODE, e.DEPARTMENT_NAME, e.DEPARTMENT_FULL_NAME, e.subject_count, e.total_enrollment, d.enrolled_students_variance, d.enrolled_students_stddev FROM eng_dept_2021_summary e JOIN dept_enrollment_stats d ON e.DEPARTMENT_CODE = d.DEPARTMENT_CODE ), dept_avg_enrollment AS ( SELECT s.OFFER_DEPT_CODE, AVG(s.NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM SUBJECT_OFFERED_SUMMARY s JOIN SIS_DEPARTMENT d ON s.OFFER_DEPT_CODE = d.DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' GROUP BY s.OFFER_DEPT_CODE ) SELECT i.DEPARTMENT_CODE, i.DEPARTMENT_NAME, i.DEPARTMENT_FULL_NAME, i.subject_count, i.total_enrollment, i.enrolled_students_variance, i.enrolled_students_stddev, s.SUBJECT_ID, s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS FROM inner_cte i JOIN SUBJECT_OFFERED_SUMMARY s ON i.DEPARTMENT_CODE = s.OFFER_DEPT_CODE JOIN dept_avg_enrollment a ON s.OFFER_DEPT_CODE = a.OFFER_DEPT_CODE WHERE s.OFFER_SCHOOL_NAME = 'Engineering' AND s.TERM_CODE LIKE '2021%' AND s.NUM_ENROLLED_STUDENTS > a.avg_enrollment ORDER BY i.DEPARTMENT_CODE, s.NUM_ENROLLED_STUDENTS DESC;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2021 Engineering subject with above-department-average enrollment within its degree-granting department summary\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_96654fdf9fd44d6a88044811",
      "name": "semantic_search",
      "content": "{\"ok\": true, \"count\": 15, \"items_by_type\": {\"metric\": [{\"id\": \"dw_2398\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and the average number of enrolled students for each subject in the department, considering only subjects that are offered in the fall term and are not offered in the summer term. Do not return any rounded answers.\"}, {\"id\": \"dw_3393\", \"desc\": \"For subjects with at least 5 enrolled students that are offered by the library in the term with code '2014FA', show the subject ID, subject title, number of enrolled students, term code, material status key, ISBN, row number within each material status group ordered by subject ID, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, ordered by offering department name, material status key, and subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_3911\", \"desc\": \"For each subject offered by the library in the term with code '2014FA', show the subject ID, subject title, total number of enrolled students, offering department name, term description, term start date, term end date, and the minimum number of enrolled students for each offering department, as well as the maximum windowed average record count from tip detail records with material status key 'RQ' (using a window of 2 preceding and 2 following rows grouped by financial aid year). Additionally, for each offering department, include a grand total row showing the total number of enrolled students across all its subjects (with nulls for subject ID and subject title), and the corresponding maximum windowed average record count if available. Order the results by offering department name and subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_3959\", \"desc\": \"For subjects offered in the term with code '2022FA' that also have at least one activity with an enrollment type of \\\"Advance sign-up required\\\" and a maximum enrollment of 12 (where the number of enrolled students is at least 10), show the subject ID, department name, subject term description, the running sum of total units within each academic year, subject title, whether the subject is offered in the fall term, the activity title, activity term code, activity maximum enrollment, activity term description, activity term start date, number of enrolled students in the activity, the offer department name for the activity, the responsible faculty name for the activity, and the row number of the activity within each subject title group, ordered by subject ID and activity title. Do not return any rounded answers.\"}, {\"id\": \"dw_3277\", \"desc\": \"List all subject titles that are either (a) offered in the term '2022FA' with a total of 12 units, showing the subject title, department name from the course description, and the dense rank of each subject considering the current and 2 preceding rows ordered by the subject code from the course catalog, or (b) for each subject offered, show the subject title, subject ID, offer department name, offer school name, term description, academic year, and the maximum number of enrolled students for each subject considering the current row and the next 2 rows ordered by subject key. The results should include all these columns in the following order: subject title, department name, window column, offer department name, offer school name, term description, academic year, and maximum number of enrolled students, with NULLs for columns not relevant to each case. Do not return any rounded answers.\"}, {\"id\": \"dw_3684\", \"desc\": \"For subjects offered in the term with code '2025FA' by departments in the School of Engineering, show the subject ID, subject title, offering department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, total units, department full name, and assign row numbers within a window of 2 preceding and 1 following rows ordered by subject title, ordered by offering department name and subject title. Do not return any rounded answers.\"}, {\"id\": \"dw_5103\", \"desc\": \"For subjects offered in the term '2017JA', show the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, and the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code. Additionally, for subjects offered in the term with code '2022FA' in the same department, provide the subject ID, department name, term description, the running sum of total units within each academic year ordered by subject ID, and the subject's short title and responsible faculty name from the course catalog. Do not return any rounded answers.\"}, {\"id\": \"dw_3867\", \"desc\": \"For each subject in a department where the school code and subject title are not null, and for each subject offered in the 2022FA term with total units greater than the average for that term, display the subject code, subject code description, department name, subject title, the number of subjects in the same department, the subject ID, the term description, and the running sum of total units for that academic year, ordered by subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_3985\", \"desc\": \"For each subject offered in the academic term with term code '2006FA' in departments that offer more than 5 subjects in that term, show the subject ID, subject title, department name, the sum of lecture units within each grade type group, and the total number of subjects per department for that term. Additionally, for each subject offered by the same department in the term '2017JA', show the number of enrolled students, offering department name, department full name, subject code, subject code description, and whether the number of enrolled students is 'HIGH_ENROLLMENT' (at least 10% greater than the average for that subject code), 'LOW_ENROLLMENT' (at least 10% less than the average for that subject code), or 'AVERAGE'. Present the results ordered by subject ID and subject code. Do not return any rounded answers.\"}, {\"id\": \"dw_3224\", \"desc\": \"List all subjects from the term \\\"2010FA\\\" and all subjects offered in the term with code \\\"2025FA\\\", showing for each row: subject ID, term description, material status key, academic year, rank of the subject within each academic year group ordered by subject ID, subject title, offering department name, number of enrolled students, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, and the source term (\\\"2010FA\\\" or \\\"2025FA\\\"). The columns should appear in the following order: subject ID, term description, material status key, academic year, rank, subject title, offering department name, number of enrolled students, term start date, term end date, term parameter, minimum enrolled students per department, and source term. Order the results by subject ID and source term. Do not return any rounded answers.\"}, {\"id\": \"dw_3268\", \"desc\": \"List all subjects that are either offered in the term with code '2025FA' or are offered by departments in the School of Engineering with a total of at least 6 units. For each subject, show the subject ID, subject title, department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, the running sum of total units within each school, and the reason for inclusion ('2025FA Subjects' for subjects offered in the term '2025FA' and 'Engineering 6+ Units' for subjects offered by Engineering departments with at least 6 units), ordered by subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_4305\", \"desc\": \"For the top 10 subjects offered in the term with the description \\\"Fall Term 2024-2025\\\" that have the highest number of enrolled students, display each subject's offered key, subject title, offering department name, the term description, the number of enrolled students, and the rank of each subject within its offering department (ordered by subject offered key), but only include subjects where the offering department is among those that, in the term with code '2022SU', had an average total units for their subjects greater than the average total units for all subjects offered in that term. List the subject offered key, subject title, offering department name, term description, number of enrolled students, and the rank within the department, in that order, and order the results by department name and number of enrolled students descending. Do not return any rounded answers.\"}, {\"id\": \"dw_3498\", \"desc\": \"List all subject IDs that are either offered in the term with code '2025FA' or are offered in the term '2016SP' by departments that grant degrees, along with the subject title, offering department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, the minimum number of enrolled students over each offering department, and the dense rank considering the current and 2 preceding rows ordered by the total number of units. For subjects from the term '2025FA', show the subject title, offering department name, number of enrolled students, term description, academic year, term start date, term end date, term parameter, and the minimum number of enrolled students over each offering department; for subjects from the term '2016SP' by degree-granting departments, show the dense rank as window_column. The results are ordered by subject ID. Do not return any rounded answers.\"}, {\"id\": \"dw_4229\", \"desc\": \"For IAP subjects in the \\\"Mathematics\\\" category, show the activity title, enrollment type, maximum enrollment, category name, activity description, and the row number within each enrollment type group ordered by activity title, along with the academic year, department name, average enrollment, enrollment variance, department phone number, and school name for each academic year and department where the IAP subject's term matches a department's fall term subject offering with more than 0 enrolled students. Do not return any rounded answers.\"}, {\"id\": \"dw_2580\", \"desc\": \"For each department and academic year, provide the department name, academic year, the number of subjects offered that are not repeatable for credit and are offered in the fall term, and classify the department as 'HIGH_ACTIVITY' if it offers at least 10% more such subjects than the average across all departments for that year, 'LOW_ACTIVITY' if it offers at least 10% fewer, or 'AVERAGE' otherwise. Do not return any rounded answers.\"}]}}"
