    {
      "role": "tool",
      "tool_call_id": "call_3fde23de9ba44ee883a6c95b",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SUBJECT_OFFERED\", \"name\": \"SUBJECT_OFFERED\", \"desc\": \"Section-level subject offering fact table: one row per subject section offered in a term, with section flags (master/lecture/lab/recitation/design), cluster information, offering department and school, responsible faculty, meeting time/place, and enrollment numbers at section, subject, and cluster level. Linked to SUBJECT_OFFERED_SUMMARY (subject level) via SUBJECT_OFFERED_SUMMARY_KEY/COMPOSITE_SUBJECT_KEY and to SUBJECT_SUMMARY via SUBJECT_SUMMARY_KEY.\", \"columns\": {\"SUBJECT_KEY\": {\"desc\": \"Surrogate key of the subject offered record\"}, \"SUBJECT_OFFERED_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_OFFERED_SUMMARY.SUBJECT_OFFERED_SUMMARY_KEY\"}, \"MASTER_SUBJECT_KEY\": {\"desc\": \"Surrogate key of the master subject record\"}, \"COMPOSITE_SUBJECT_KEY\": {\"desc\": \"Composite subject key; joins to SUBJECT_OFFERED_SUMMARY.COMPOSITE_SUBJECT_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format; joins to ACADEMIC_TERMS/ACADEMIC_TERMS_ALL\"}, \"MASTER_COURSE_NUMBER\": {\"desc\": \"Course number of the master subject\"}, \"MASTER_COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the master course number\"}, \"MASTER_COURSE_NUMBER_DESC\": {\"desc\": \"Description of the master course number\"}, \"MASTER_SUBJECT_ID\": {\"desc\": \"Master subject identifier for clustered subjects\"}, \"MASTER_SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the master subject identifier\"}, \"COURSE_NUMBER\": {\"desc\": \"Course number of the section\"}, \"COURSE_NUMBER_SORT\": {\"desc\": \"Sortable form of the course number\"}, \"COURSE_NUMBER_DESC\": {\"desc\": \"Course number description\"}, \"SUBJECT_ID\": {\"desc\": \"Subject identifier, e.g. '18.01'\"}, \"SUBJECT_ID_SORT\": {\"desc\": \"Sortable form of the subject identifier\"}, \"SUBJECT_TITLE\": {\"desc\": \"Subject title\"}, \"SECTION_ID\": {\"desc\": \"Section identifier, e.g. 0 for the primary section\"}, \"IS_MASTER_SECTION\": {\"desc\": \"'Y'/'N' flag for master section\"}, \"IS_LECTURE_SECTION\": {\"desc\": \"'Y'/'N' flag for lecture section\"}, \"IS_LAB_SECTION\": {\"desc\": \"'Y'/'N' flag for lab section\"}, \"IS_RECITATION_SECTION\": {\"desc\": \"'Y'/'N' flag for recitation section\"}, \"IS_DESIGN_SECTION\": {\"desc\": \"'Y'/'N' flag for design section\"}, \"OFFER_DEPT_CODE\": {\"desc\": \"Offering department code; joins to SIS_DEPARTMENT.DEPARTMENT_CODE\"}, \"OFFER_DEPT_NAME\": {\"desc\": \"Offering department name, e.g. 'Harvard Cross-Enrollment Prog'\"}, \"OFFER_SCHOOL_NAME\": {\"desc\": \"Offering school name, e.g. 'Engineering'\"}, \"RESPONSIBLE_FACULTY_NAME\": {\"desc\": \"Name of the faculty member responsible for the subject\"}, \"RESPONSIBLE_FACULTY_MIT_ID\": {\"desc\": \"MIT ID of the responsible faculty member\"}, \"MEET_TIME\": {\"desc\": \"Meeting time of the section\"}, \"MEET_PLACE\": {\"desc\": \"Meeting place of the section\"}, \"CLUSTER_TYPE\": {\"desc\": \"Cluster type code, e.g. 'S'\"}, \"CLUSTER_TYPE_DESC\": {\"desc\": \"Cluster type description\"}, \"CLUSTER_LIST\": {\"desc\": \"List of subjects in the cluster\"}, \"HGN_CODE\": {\"desc\": \"HGN (Higgins) level code\"}, \"HGN_CODE_DESC\": {\"desc\": \"HGN level description (Undergraduate/Graduate/High Graduate)\"}, \"FORM_TYPE\": {\"desc\": \"Subject form type code\"}, \"FORM_TYPE_DESC\": {\"desc\": \"Subject form type description\"}, \"SUBJECT_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number at the subject level\"}, \"SECTION_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the section\"}, \"CLUSTER_ENROLLMENT_NUMBER\": {\"desc\": \"Enrollment number of the cluster the subject belongs to\"}, \"EVALUATE_THIS_SUBJECT\": {\"desc\": \"Flag whether the subject is included in evaluation\"}, \"IS_OSE_SUBJECT\": {\"desc\": \"'Y'/'N' flag for Office of Subject Evaluation subject\"}, \"IS_CREATED_BY_DATA_WAREHOUSE\": {\"desc\": \"'Y'/'N' flag whether the record was synthesized by the data warehouse\"}, \"SUBJECT_GROUPING_KEY\": {\"desc\": \"Key to the subject grouping record\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"NUM_ENROLLED_STUDENTS\": {\"desc\": \"Number of students enrolled in the section\"}, \"SUBJECT_SUMMARY_KEY\": {\"desc\": \"Foreign key to SUBJECT_SUMMARY.SUBJECT_SUMMARY_KEY\"}, \"IS_REPEATABLE_SUBJECT\": {\"desc\": \"'Y'/'N' flag whether the subject may be repeated for credit\"}}, \"default_granularity\": \"one row per subject section per term\"}, {\"id\": \"ACADEMIC_TERMS_ALL\", \"name\": \"ACADEMIC_TERMS_ALL\", \"desc\": \"Extended academic term dimension table covering all terms known to the warehouse (a superset of ACADEMIC_TERMS, including terms without full status tracking). Shares term calendar attributes (term code, dates, academic year, financial aid year, degree year, registration and class dates) but does not carry IS_REGULAR_TERM, TERM_STATUS, ADD_DATE or DROP_DATE columns.\", \"columns\": {\"ACADEMIC_TERMS_KEY\": {\"desc\": \"Surrogate key of the academic term record; joins to ACADEMIC_TERMS.ACADEMIC_TERMS_KEY\"}, \"TERM_CODE\": {\"desc\": \"Term code in YYYYTT format, e.g. '2019FA'\"}, \"TERM_DESCRIPTION\": {\"desc\": \"Human-readable term description\"}, \"TERM_SELECTOR\": {\"desc\": \"Term selector label used for picklists\"}, \"TERM_START_DATE\": {\"desc\": \"Term start date\"}, \"TERM_END_DATE\": {\"desc\": \"Term end date\"}, \"ACADEMIC_YEAR\": {\"desc\": \"Academic year the term belongs to\"}, \"ACADEMIC_YEAR_DESC\": {\"desc\": \"Academic year description text\"}, \"IS_CURRENT_TERM\": {\"desc\": \"'Y'/'N' flag indicating whether the term is the current term\"}, \"TERM_STATUS_INDICATOR\": {\"desc\": \"Single-character term status indicator: 'P'=Previous, 'C'=Current, 'F'=Future, 'None'=Unspecified\"}, \"FINANCIAL_AID_YEAR\": {\"desc\": \"Financial aid year the term maps to; used to partition running sums by financial aid year\"}, \"DEGREE_YEAR\": {\"desc\": \"Degree year the term maps to\"}, \"LAST_DAY_OF_FINAL_EXAM\": {\"desc\": \"Last day of final exams for the term\"}, \"PRE_REGISTRATION_START_DAY\": {\"desc\": \"First day of pre-registration for the term\"}, \"REGISTRATION_DAY\": {\"desc\": \"Registration day for the term\"}, \"FIRST_DAY_OF_CLASSES\": {\"desc\": \"First day of classes in the term\"}, \"LAST_DAY_OF_CLASSES\": {\"desc\": \"Last day of classes in the term\"}, \"GRADUATE_AWARD_START_DATE\": {\"desc\": \"Start date of the graduate award period\"}, \"GRADUATE_AWARD_END_DATE\": {\"desc\": \"End date of the graduate award period\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date of the record\"}}, \"default_granularity\": \"one row per academic term (all terms)\"}, {\"id\": \"concept_subject_offering_facts\", \"name\": \"Subject Offering Fact Tables\", \"desc\": \"Fact tables recording subjects offered per term from different business processes: the course catalog (planned catalog attributes), the registrar's section/subject offering records (actual sections and enrollment), subject-level summaries (final enrollment statistics), the textbook information program (subjects tracked for course materials), and library reserve processing (subjects with library reserve activity). They share subject identity (SUBJECT_ID, TERM_CODE) and department attribution but differ in granularity, enrollment semantics, and available measures.\", \"tables\": [\"COURSE_CATALOG_SUBJECT_OFFERED\", \"SUBJECT_OFFERED\", \"SUBJECT_OFFERED_SUMMARY\", \"SUBJECT_SUMMARY\", \"TIP_SUBJECT_OFFERED\", \"LIBRARY_SUBJECT_OFFERED\"], \"comparisons\": [{\"dimension\": \"Granularity\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"Subject offering per term/academic year (catalog record, includes section flags)\", \"SUBJECT_OFFERED\": \"Subject section per term (finest grain, SECTION_ID)\", \"SUBJECT_OFFERED_SUMMARY\": \"Subject per term (rollup of sections)\", \"SUBJECT_SUMMARY\": \"Subject or cluster per term\", \"TIP_SUBJECT_OFFERED\": \"Subject per term within textbook program scope\", \"LIBRARY_SUBJECT_OFFERED\": \"Subject per term within library reserve scope\"}, {\"dimension\": \"Enrollment measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"None (catalog attributes only)\", \"SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, SECTION_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_OFFERED_SUMMARY\": \"NUM_ENROLLED_STUDENTS, SUBJECT_ENROLLMENT_NUMBER, CLUSTER_ENROLLMENT_NUMBER\", \"SUBJECT_SUMMARY\": \"SUBJECT_ENROLLMENT_NUMBER plus first-week/fifth-week and credit/listener enrollment splits\", \"TIP_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\", \"LIBRARY_SUBJECT_OFFERED\": \"NUM_ENROLLED_STUDENTS\"}, {\"dimension\": \"Unit measures\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS, DESIGN_UNITS, TOTAL_UNITS, IS_VARIABLE_UNITS\", \"SUBJECT_OFFERED\": \"None\", \"SUBJECT_OFFERED_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREPARATION_UNITS\", \"SUBJECT_SUMMARY\": \"TOTAL_UNITS, LECTURE_UNITS, LAB_UNITS, PREP_UNITS, DESIGN_UNITS\", \"TIP_SUBJECT_OFFERED\": \"None\", \"LIBRARY_SUBJECT_OFFERED\": \"None\"}, {\"dimension\": \"Distinctive attributes\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"HGN_DESC level, GRADE_TYPE/GRADE_RULE, HASS/GIR attributes, IS_OFFERED_* flags, MEET_PLACE (room key), ACADEMIC_YEAR, EFFECTIVE_TERM_CODE\", \"SUBJECT_OFFERED\": \"IS_REPEATABLE_SUBJECT, CLUSTER_TYPE, section flags, FORM_TYPE, EVALUATE_THIS_SUBJECT\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_SCHOOL_NAME, COURSE_NUMBER, cluster info at subject level\", \"SUBJECT_SUMMARY\": \"SCHOOL_CODE/SCHOOL_NAME, SUBJECT_GROUP_ID, SUBJECT_OR_CLUSTER, detailed weekly enrollment\", \"TIP_SUBJECT_OFFERED\": \"IS_NO_COURSE_MATERIAL flag; parent of TIP_DETAIL materials\", \"LIBRARY_SUBJECT_OFFERED\": \"COURSE_NUMBER/COURSE_NUMBER_DESC; parent of LIBRARY_RESERVE_MATRL_DETAIL\"}, {\"dimension\": \"Department column naming\", \"COURSE_CATALOG_SUBJECT_OFFERED\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_OFFERED_SUMMARY\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"SUBJECT_SUMMARY\": \"DEPARTMENT_CODE / DEPARTMENT_NAME\", \"TIP_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\", \"LIBRARY_SUBJECT_OFFERED\": \"OFFER_DEPT_CODE / OFFER_DEPT_NAME\"}], \"decision_guide\": {\"Questions about credit units, grading type/rules, HGN level (undergraduate/graduate), HASS/GIR attributes, or term offering flags (fall/spring/IAP/summer)\": \"Use COURSE_CATALOG_SUBJECT_OFFERED; it is the only offering table carrying full catalog attributes.\", \"Questions about actual section-level offerings, repeatability, cluster type, or section flags\": \"Use SUBJECT_OFFERED (section grain); roll up via SUBJECT_OFFERED_SUMMARY when subject-level totals are needed.\", \"Questions about final enrollment statistics, weekly enrollment snapshots, credit vs listener counts, subject groups, or school-level unit statistics\": \"Use SUBJECT_SUMMARY.\", \"Questions about textbooks/course materials per subject (required/optional status, ISBN, record counts)\": \"Start from TIP_SUBJECT_OFFERED (subject scope, IS_NO_COURSE_MATERIAL) joined to TIP_DETAIL (material rows).\", \"Questions about library reserve materials, reserve counts per subject, or library course numbers\": \"Start from LIBRARY_SUBJECT_OFFERED joined to LIBRARY_RESERVE_MATRL_DETAIL.\", \"Questions about subject-level units with offering department/school (e.g. Engineering school enrollment totals by department)\": \"Use SUBJECT_OFFERED_SUMMARY, which carries both TOTAL_UNITS and OFFER_SCHOOL_NAME.\"}}, {\"id\": \"concept_academic_term_dimension\", \"name\": \"Academic Term Dimension\", \"desc\": \"Tables describing academic terms and their calendar/status attributes. They jointly answer questions about when terms run, which academic/financial-aid/degree year a term belongs to, and whether a term is current, previous, future, or regular. Coverage differs: the full historical term list, the status-tracked term subset, and the three-row relative term parameter reference.\", \"tables\": [\"ACADEMIC_TERMS\", \"ACADEMIC_TERMS_ALL\", \"ACADEMIC_TERM_PARAMETER\"], \"comparisons\": [{\"dimension\": \"Row coverage\", \"ACADEMIC_TERMS\": \"Terms with full status tracking (subset of all terms)\", \"ACADEMIC_TERMS_ALL\": \"All terms known to the warehouse (superset of ACADEMIC_TERMS)\", \"ACADEMIC_TERM_PARAMETER\": \"Exactly 3 rows: current, previous, and upcoming term\"}, {\"dimension\": \"Unique columns\", \"ACADEMIC_TERMS\": \"IS_REGULAR_TERM, TERM_STATUS ('Previous'/'Current'/'Future'/'Unspecified'), ADD_DATE, DROP_DATE\", \"ACADEMIC_TERMS_ALL\": \"No IS_REGULAR_TERM/TERM_STATUS/ADD_DATE/DROP_DATE; shares TERM_STATUS_INDICATOR, FINANCIAL_AID_YEAR, DEGREE_YEAR\", \"ACADEMIC_TERM_PARAMETER\": \"TERM_PARAMETER name (SIS_CURRENT_TERM/SIS_PREVIOUS_TERM/SIS_UPCOMING_TERM), TERM_INDICATOR ('C'/'P'/'F'), TERM_LAST_DAY_BEFORE_NEXT_TERM\"}, {\"dimension\": \"Typical role in queries\", \"ACADEMIC_TERMS\": \"Filtering by regular-term flag or term status; term start/end dates and registration milestones\", \"ACADEMIC_TERMS_ALL\": \"Source of academic year, academic year description, financial aid year, degree year for windowed/running-sum statistics\", \"ACADEMIC_TERM_PARAMETER\": \"Resolving relative term references ('current term', 'previous term', term indicator 'C'/'P') to concrete term codes\"}, {\"dimension\": \"Join keys\", \"ACADEMIC_TERMS\": \"TERM_CODE, ACADEMIC_TERMS_KEY\", \"ACADEMIC_TERMS_ALL\": \"TERM_CODE, ACADEMIC_TERMS_KEY\", \"ACADEMIC_TERM_PARAMETER\": \"TERM_CODE\"}], \"decision_guide\": {\"Questions needing IS_REGULAR_TERM or TERM_STATUS ('Previous'/'Current'/'Future') filtering\": \"Use ACADEMIC_TERMS; these columns exist only there.\", \"Questions needing academic year, financial aid year, or degree year attributes over the widest term coverage, or joining fact tables whose terms may not be status-tracked\": \"Use ACADEMIC_TERMS_ALL, optionally joined to ACADEMIC_TERMS on TERM_CODE when regular-term/status flags are also needed.\", \"Questions referring to 'the current term', 'the previous term', 'the upcoming term', or term indicator 'C'/'P'/'F'\": \"Use ACADEMIC_TERM_PARAMETER to resolve the relative reference to a TERM_CODE, then join ACADEMIC_TERMS for full attributes.\", \"Questions needing registration milestones (add date, drop date, first day of classes, last day of final exam)\": \"Use ACADEMIC_TERMS (ADD_DATE/DROP_DATE only exist there; other milestone dates exist in both ACADEMIC_TERMS and ACADEMIC_TERMS_ALL).\"}}], \"not_found\": []}"
