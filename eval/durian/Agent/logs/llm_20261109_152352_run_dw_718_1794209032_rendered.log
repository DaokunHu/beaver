    {
      "role": "tool",
      "tool_call_id": "call_8d91bf389fbc4c188bbbb941",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per department per 2012 subject matched with 2012SU enrollment statistics\", \"desc\": \"For each department, show the offer department name, the number of distinct subjects offered by the department in the academic year 2012, and for each subject that was offered in the term \\\"2012SU\\\", display the subject key, subject title, academic year, term description, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, and the deviation of each subject's enrollment number from the average enrollment number for its subject key group, ordered by offer department name and subject key. Do not return any rounded answers.\", \"id\": \"dw_4184\", \"name\": \"2012 Department Subject Counts with 2012SU Enrollment Averages and Deviations per Subject Key\", \"sql\": \"WITH subq1 AS ( WITH inner_cte AS ( SELECT t1.SUBJECT_KEY, t1.SUBJECT_TITLE, t1.OFFER_DEPT_NAME, t0.ACADEMIC_YEAR, t0.TERM_DESCRIPTION FROM ACADEMIC_TERMS_ALL t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.ACADEMIC_YEAR = 2012 ) SELECT ic.OFFER_DEPT_NAME, dept_counts.num_subjects, ic.SUBJECT_KEY, ic.SUBJECT_TITLE, ic.ACADEMIC_YEAR, ic.TERM_DESCRIPTION FROM inner_cte ic JOIN ( SELECT OFFER_DEPT_NAME, COUNT(DISTINCT SUBJECT_KEY) AS num_subjects FROM inner_cte GROUP BY OFFER_DEPT_NAME ) dept_counts ON ic.OFFER_DEPT_NAME = dept_counts.OFFER_DEPT_NAME ), subq2 AS ( WITH inner_cte AS ( SELECT t0.SUBJECT_TITLE, t0.SUBJECT_KEY, t0.OFFER_DEPT_NAME, t0.SUBJECT_ENROLLMENT_NUMBER, t0.SUBJECT_OFFERED_SUMMARY_KEY, AVG(t0.SUBJECT_ENROLLMENT_NUMBER) OVER (PARTITION BY t0.SUBJECT_KEY ORDER BY t0.OFFER_DEPT_NAME) AS window_column FROM SUBJECT_OFFERED t0 JOIN SUBJECT_OFFERED_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2012SU' ) SELECT inner_cte.SUBJECT_TITLE, inner_cte.SUBJECT_KEY, inner_cte.OFFER_DEPT_NAME, inner_cte.SUBJECT_ENROLLMENT_NUMBER, inner_cte.SUBJECT_OFFERED_SUMMARY_KEY, inner_cte.window_column AS avg_enrollment_number, (inner_cte.SUBJECT_ENROLLMENT_NUMBER - inner_cte.window_column) AS deviation_from_avg FROM inner_cte ) SELECT s1.OFFER_DEPT_NAME, s1.num_subjects, s1.SUBJECT_KEY, s1.SUBJECT_TITLE, s1.ACADEMIC_YEAR, s1.TERM_DESCRIPTION, s2.SUBJECT_ENROLLMENT_NUMBER, s2.SUBJECT_OFFERED_SUMMARY_KEY, s2.avg_enrollment_number, s2.deviation_from_avg FROM subq1 s1 JOIN subq2 s2 ON s1.SUBJECT_KEY = s2.SUBJECT_KEY AND s1.OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME AND s1.SUBJECT_TITLE = s2.SUBJECT_TITLE ORDER BY s1.OFFER_DEPT_NAME, s1.SUBJECT_KEY\"}, {\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per subject in term 2012SU\", \"desc\": \"For subjects offered in the term \\\"2012SU\\\", show the subject title, subject key, offer department name, subject enrollment number, subject offered summary key, the average subject enrollment number within each subject key group, subject ID, academic year, term description, and the minimum number of enrolled students in a window of 3 preceding and 1 following row, ordered by offer department name and academic year. Do not return any rounded answers.\", \"id\": \"dw_3632\", \"name\": \"2012SU Subject Enrollment Averages per Subject Key with Windowed Min Enrolled Students\", \"sql\": \"WITH Subquery1 AS ( SELECT t0.SUBJECT_TITLE, t0.SUBJECT_KEY, t0.OFFER_DEPT_NAME, t0.SUBJECT_ENROLLMENT_NUMBER, t0.SUBJECT_OFFERED_SUMMARY_KEY, AVG(t0.SUBJECT_ENROLLMENT_NUMBER) OVER (PARTITION BY t0.SUBJECT_KEY ORDER BY t0.OFFER_DEPT_NAME) AS window_column FROM SUBJECT_OFFERED t0 JOIN SUBJECT_OFFERED_SUMMARY t1 ON t0.TERM_CODE = t1.TERM_CODE WHERE t0.TERM_CODE = '2012SU' ), Subquery2 AS ( SELECT t1.SUBJECT_TITLE, t1.SUBJECT_ID, t1.OFFER_DEPT_NAME, t0.ACADEMIC_YEAR, t0.TERM_DESCRIPTION, MIN(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t0.ACADEMIC_YEAR ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM ACADEMIC_TERMS t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_CODE = '2012SU' ) SELECT s1.SUBJECT_TITLE, s1.SUBJECT_KEY, s1.OFFER_DEPT_NAME, s1.SUBJECT_ENROLLMENT_NUMBER, s1.SUBJECT_OFFERED_SUMMARY_KEY, s1.window_column AS avg_subject_enrollment_number, s2.SUBJECT_ID, s2.ACADEMIC_YEAR, s2.TERM_DESCRIPTION, s2.window_column AS min_num_enrolled_students_window FROM Subquery1 s1 JOIN Subquery2 s2 ON s1.SUBJECT_TITLE = s2.SUBJECT_TITLE AND s1.OFFER_DEPT_NAME = s2.OFFER_DEPT_NAME ORDER BY s1.OFFER_DEPT_NAME, s2.ACADEMIC_YEAR\"}, {\"category\": \"Enrollment Analysis\", \"default_granularity\": \"one row per subject in term 2012SU\", \"desc\": \"For each subject offered in the term with code '2012SU', show the subject title, subject ID, offer department name, academic year, term description, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the academic year, and the standard deviation (using STDDEV only and never STDDEV_POP) of the total units for that subject (considering only subjects offered by the \\\"Harvard Cross-Enrollment Prog\\\" department and with more than 5 offerings). Do not return any rounded answers.\", \"id\": \"dw_3530\", \"name\": \"2012SU Subjects Windowed Min Enrollment with Cross-Enrollment Total Units Stddev\", \"sql\": \"WITH SubjectUnitsStddev AS ( SELECT sos.SUBJECT_TITLE, STDDEV(sos.TOTAL_UNITS) AS total_units_stddev FROM SUBJECT_OFFERED so JOIN SUBJECT_OFFERED_SUMMARY sos ON so.COMPOSITE_SUBJECT_KEY = sos.COMPOSITE_SUBJECT_KEY WHERE so.OFFER_DEPT_NAME = 'Harvard Cross-Enrollment Prog' GROUP BY sos.SUBJECT_TITLE HAVING COUNT(*) > 5 ORDER BY total_units_stddev DESC ), Subjects2012SU AS ( SELECT t1.SUBJECT_TITLE, t1.SUBJECT_ID, t1.OFFER_DEPT_NAME, t0.ACADEMIC_YEAR, t0.TERM_DESCRIPTION, MIN(t1.NUM_ENROLLED_STUDENTS) OVER (ORDER BY t0.ACADEMIC_YEAR ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM ACADEMIC_TERMS t0 JOIN SUBJECT_OFFERED t1 ON t0.TERM_CODE = t1.TERM_CODE JOIN SUBJECT_OFFERED_SUMMARY t2 ON t1.TERM_CODE = t2.TERM_CODE WHERE t1.TERM_CODE = '2012SU' ) SELECT s2.SUBJECT_TITLE, s2.SUBJECT_ID, s2.OFFER_DEPT_NAME, s2.ACADEMIC_YEAR, s2.TERM_DESCRIPTION, s2.window_column, s1.total_units_stddev FROM Subjects2012SU s2 JOIN SubjectUnitsStddev s1 ON s2.SUBJECT_TITLE = s1.SUBJECT_TITLE ORDER BY s2.SUBJECT_TITLE, s2.SUBJECT_ID;\"}], \"not_found\": []}"
