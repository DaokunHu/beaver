      "tool_call_id": "call_06ae587eadd84bc19f45c047",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Course Catalog and Department Analysis\", \"default_granularity\": \"one row per department per subject code with fall-only offering enrollment average\", \"desc\": \"Show the department names, the corresponding SIS subject code, subject code descriptions, graduate level, the total number of courses per department, and the average number of enrolled students for each subject in the department, considering only subjects that are offered in the fall term and are not offered in the summer term. Do not return any rounded answers.\", \"id\": \"dw_2398\", \"name\": \"Department Course Counts with Fall-Only Non-Summer Subject Average TIP Enrollment\", \"sql\": \"WITH inner_cte AS ( SELECT sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL, COUNT(DISTINCT scd.COURSE) AS Total_Courses FROM SIS_DEPARTMENT sd JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT JOIN SIS_SUBJECT_CODE sc ON scd.COURSE = sc.COURSE_NUMBER GROUP BY sd.DEPARTMENT_NAME, sc.SUBJECT_CODE, sc.SUBJECT_CODE_DESC, scd.GRADUATE_LEVEL ) SELECT icte.DEPARTMENT_NAME, icte.SUBJECT_CODE, icte.SUBJECT_CODE_DESC, icte.GRADUATE_LEVEL, icte.Total_Courses, AVG(tso.NUM_ENROLLED_STUDENTS) AS avg_enrollment FROM inner_cte icte JOIN TIP_SUBJECT_OFFERED tso ON icte.SUBJECT_CODE = tso.COURSE_NUMBER JOIN SIS_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE AND sd.DEPARTMENT_NAME = icte.DEPARTMENT_NAME JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON tso.SUBJECT_ID = ccso.SUBJECT_ID WHERE ccso.IS_OFFERED_FALL_TERM = 'Y' AND ccso.IS_OFFERED_SUMMER_TERM = 'N' GROUP BY icte.DEPARTMENT_NAME, icte.SUBJECT_CODE, icte.SUBJECT_CODE_DESC, icte.GRADUATE_LEVEL, icte.Total_Courses ORDER BY icte.DEPARTMENT_NAME, icte.SUBJECT_CODE;\"}, {\"category\": \"IAP Activity and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per Mathematics IAP activity per academic year per department\", \"desc\": \"For IAP subjects in the \\\"Mathematics\\\" category, show the activity title, enrollment type, maximum enrollment, category name, activity description, and the row number within each enrollment type group ordered by activity title, along with the academic year, department name, average enrollment, enrollment variance, department phone number, and school name for each academic year and department where the IAP subject's term matches a department's fall term subject offering with more than 0 enrolled students. Do not return any rounded answers.\", \"id\": \"dw_4229\", \"name\": \"Mathematics IAP Category Activities Matched with Fall-Term Department Enrollment Statistics\", \"sql\": \"WITH inner_cte1 AS ( SELECT d.ACTIVITY_TITLE, d.ENROLLMENT_TYPE, d.MAX_ENROLLMENT, c.IAP_CATEGORY_NAME, ROW_NUMBER() OVER (PARTITION BY d.ENROLLMENT_TYPE ORDER BY d.ACTIVITY_TITLE) AS window_column, d.TERM_CODE FROM IAP_SUBJECT_DETAIL d JOIN IAP_SUBJECT_CATEGORY c ON d.IAP_SUBJECT_CATEGORY_KEY = c.IAP_SUBJECT_CATEGORY_KEY WHERE c.IAP_CATEGORY_NAME = 'Mathematics' ), subq1 AS ( SELECT inner_cte1.ACTIVITY_TITLE, inner_cte1.ENROLLMENT_TYPE, inner_cte1.MAX_ENROLLMENT, inner_cte1.IAP_CATEGORY_NAME, d.ACTIVITY_DESCRIPTION, inner_cte1.window_column, inner_cte1.TERM_CODE FROM inner_cte1 JOIN IAP_SUBJECT_DETAIL d ON inner_cte1.ACTIVITY_TITLE = d.ACTIVITY_TITLE AND inner_cte1.ENROLLMENT_TYPE = d.ENROLLMENT_TYPE ), inner_cte2 AS ( SELECT ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS, COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE FROM COURSE_CATALOG_SUBJECT_OFFERED JOIN ACADEMIC_TERMS_ALL ON COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE = ACADEMIC_TERMS_ALL.TERM_CODE JOIN TIP_SUBJECT_OFFERED ON ACADEMIC_TERMS_ALL.TERM_CODE = TIP_SUBJECT_OFFERED.TERM_CODE WHERE COURSE_CATALOG_SUBJECT_OFFERED.IS_OFFERED_FALL_TERM = 'Y' AND TIP_SUBJECT_OFFERED.NUM_ENROLLED_STUDENTS > 0 ), subq2 AS ( SELECT inner_cte2.ACADEMIC_YEAR, inner_cte2.DEPARTMENT_NAME, AVG(inner_cte2.NUM_ENROLLED_STUDENTS) AS avg_enrollment, VARIANCE(inner_cte2.NUM_ENROLLED_STUDENTS) AS enrollment_variance, ad.DEPARTMENT_PHONE_NUMBER AS department_phone, sd.SCHOOL_NAME AS school_name, inner_cte2.TERM_CODE FROM inner_cte2 LEFT JOIN SIS_DEPARTMENT sd ON inner_cte2.DEPARTMENT_NAME = sd.DEPARTMENT_NAME LEFT JOIN SIS_ADMIN_DEPARTMENT ad ON sd.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE GROUP BY inner_cte2.ACADEMIC_YEAR, inner_cte2.DEPARTMENT_NAME, ad.DEPARTMENT_PHONE_NUMBER, sd.SCHOOL_NAME, inner_cte2.TERM_CODE ) SELECT s1.ACTIVITY_TITLE, s1.ENROLLMENT_TYPE, s1.MAX_ENROLLMENT, s1.IAP_CATEGORY_NAME, s1.ACTIVITY_DESCRIPTION, s1.window_column, s2.ACADEMIC_YEAR, s2.DEPARTMENT_NAME, s2.avg_enrollment, s2.enrollment_variance, s2.department_phone, s2.school_name FROM subq1 s1 JOIN subq2 s2 ON s1.TERM_CODE = s2.TERM_CODE ORDER BY s1.ACTIVITY_TITLE, s2.ACADEMIC_YEAR, s2.DEPARTMENT_NAME\"}, {\"category\": \"Subject Offering and Course Catalog Comprehensive Analysis\", \"default_granularity\": \"one row per academic year per department per graduate level\", \"desc\": \"For each academic year and department in Mathematics, what is the variance and standard deviation (using STDDEV only and never STDDEV_POP) of the total units for subjects offered in that year and department (considering only subjects offered in the current term, with more than 0 total units, and with subject enrollment number greater than the average for that department and year), and for those departments, what are the department code, corresponding administrative department name, the graduate level of courses, and the total number of distinct courses per department, for all degree-granting departments except the Management department? Present the results as academic year, department name, total units variance, total units standard deviation (using STDDEV only and never STDDEV_POP), department code, administrative department name, graduate level, and number of distinct courses, in that order. Do not return any rounded answers.\", \"entity_type_note\": \"\", \"id\": \"dw_1393\", \"name\": \"Math Current-Term Unit Dispersion with Degree-Granting Department Course Counts\", \"sql\": \"WITH inner_cte1 AS ( SELECT ACADEMIC_TERMS_ALL.ACADEMIC_YEAR, COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME, SUBJECT_SUMMARY.TOTAL_UNITS, SUBJECT_SUMMARY.SUBJECT_ENROLLMENT_NUMBER FROM COURSE_CATALOG_SUBJECT_OFFERED JOIN ACADEMIC_TERMS_ALL ON COURSE_CATALOG_SUBJECT_OFFERED.TERM_CODE = ACADEMIC_TERMS_ALL.TERM_CODE JOIN SUBJECT_SUMMARY ON ACADEMIC_TERMS_ALL.TERM_CODE = SUBJECT_SUMMARY.TERM_CODE WHERE ACADEMIC_TERMS_ALL.IS_CURRENT_TERM = 'Y' AND SUBJECT_SUMMARY.TOTAL_UNITS > 0 AND COURSE_CATALOG_SUBJECT_OFFERED.DEPARTMENT_NAME = 'Mathematics' ), avg_enrollment AS ( SELECT ACADEMIC_YEAR, DEPARTMENT_NAME, AVG(SUBJECT_ENROLLMENT_NUMBER) AS avg_enrollment FROM inner_cte1 GROUP BY ACADEMIC_YEAR, DEPARTMENT_NAME ), math_units_stats AS ( SELECT i.ACADEMIC_YEAR, i.DEPARTMENT_NAME, VARIANCE(i.TOTAL_UNITS) AS total_units_variance, STDDEV(i.TOTAL_UNITS) AS total_units_stddev FROM inner_cte1 i JOIN avg_enrollment a ON i.ACADEMIC_YEAR = a.ACADEMIC_YEAR AND i.DEPARTMENT_NAME = a.DEPARTMENT_NAME WHERE i.SUBJECT_ENROLLMENT_NUMBER > a.avg_enrollment GROUP BY i.ACADEMIC_YEAR, i.DEPARTMENT_NAME ), inner_cte2 AS ( SELECT d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, ad.SIS_ADMIN_DEPARTMENT_NAME, COUNT(DISTINCT c.COURSE) AS num_distinct_courses FROM SIS_COURSE_DESCRIPTION c JOIN SIS_DEPARTMENT d ON c.DEPARTMENT = d.DEPARTMENT_CODE JOIN SIS_ADMIN_DEPARTMENT ad ON d.DEPARTMENT_CODE = ad.SIS_ADMIN_DEPARTMENT_CODE WHERE d.IS_DEGREE_GRANTING = 'Y' AND UPPER(ad.SIS_ADMIN_DEPARTMENT_NAME) <> 'MANAGEMENT' GROUP BY d.DEPARTMENT_CODE, d.DEPARTMENT_NAME, ad.SIS_ADMIN_DEPARTMENT_NAME ), dept_courses AS ( SELECT ic.DEPARTMENT_CODE, ic.DEPARTMENT_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, scd.GRADUATE_LEVEL, ic.num_distinct_courses FROM inner_cte2 ic JOIN SIS_COURSE_DESCRIPTION scd ON ic.DEPARTMENT_CODE = scd.DEPARTMENT GROUP BY ic.DEPARTMENT_CODE, ic.DEPARTMENT_NAME, ic.SIS_ADMIN_DEPARTMENT_NAME, scd.GRADUATE_LEVEL, ic.num_distinct_courses ) SELECT mus.ACADEMIC_YEAR, mus.DEPARTMENT_NAME, mus.total_units_variance, mus.total_units_stddev, dc.DEPARTMENT_CODE, dc.SIS_ADMIN_DEPARTMENT_NAME, dc.GRADUATE_LEVEL, dc.num_distinct_courses FROM math_units_stats mus JOIN SIS_DEPARTMENT sd ON mus.DEPARTMENT_NAME = sd.DEPARTMENT_NAME JOIN dept_courses dc ON sd.DEPARTMENT_CODE = dc.DEPARTMENT_CODE ORDER BY mus.total_units_variance DESC, dc.DEPARTMENT_CODE, dc.GRADUATE_LEVEL;\"}], \"not_found\": []}"
    },
