    {
      "role": "tool",
      "tool_call_id": "call_2ea72b5300724504a0aef181",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"category\": \"Library Reserve and Textbook Material Comprehensive Analysis\", \"default_granularity\": \"one row per 2014FA Chemistry library subject per academic year per required-material count\", \"desc\": \"For subjects offered in the term '2014FA' by the Chemistry department, show the subject title from the library, the number of enrolled students in the library subject, the responsible faculty name from the TIP subject, the offer department name from the TIP subject, the minimum number of enrolled students in the library subject within a window of 3 preceding and 1 following row ordered by the TIP subject's responsible faculty MIT ID, and for each academic year, also show the academic year and academic year description and the coefficient of variation (using STDDEV only and never STDDEV_POP) of the total units for subjects in the Mathematics department (Course 18) that have more than 0 total units and are offered in terms with a term status indicator of 'P'. Additionally, for each Chemistry subject, include the number of required TIP materials (where TIP_MATERIAL_STATUS_KEY = 'RQ') for that subject in that term. Do not return any rounded answers.\", \"id\": \"dw_2180\", \"name\": \"2014FA Chemistry Library Subjects Windowed Enrollment with Math Unit Coefficient of Variation and Required Material Counts\", \"sql\": \"WITH inner_cte AS ( SELECT l.SUBJECT_TITLE, l.NUM_ENROLLED_STUDENTS, t.RESPONSIBLE_FACULTY_NAME, t.OFFER_DEPT_NAME, MIN(l.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t.RESPONSIBLE_FACULTY_MIT_ID ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column, l.TERM_CODE FROM LIBRARY_SUBJECT_OFFERED l JOIN TIP_SUBJECT_OFFERED t ON l.TERM_CODE = t.TERM_CODE WHERE l.TERM_CODE = '2014FA' AND t.OFFER_DEPT_NAME = 'Chemistry' ), math_units_variation AS ( SELECT ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC, STDDEV_SAMP(ss.TOTAL_UNITS) / NULLIF(AVG(ss.TOTAL_UNITS), 0) AS coefficient_of_variation_total_units FROM SUBJECT_SUMMARY ss JOIN ACADEMIC_TERMS_ALL ata ON ss.TERM_CODE = ata.TERM_CODE WHERE ss.DEPARTMENT_NAME = 'Mathematics' AND ss.TOTAL_UNITS > 0 AND ata.TERM_STATUS_INDICATOR = 'P' GROUP BY ata.ACADEMIC_YEAR, ata.ACADEMIC_YEAR_DESC ORDER BY ata.ACADEMIC_YEAR ), required_materials_count AS ( SELECT t.TERM_CODE, t.SUBJECT_ID, COUNT(*) AS num_required_materials FROM TIP_DETAIL t WHERE t.TIP_MATERIAL_STATUS_KEY = 'RQ' GROUP BY t.TERM_CODE, t.SUBJECT_ID ) SELECT c.SUBJECT_TITLE, c.NUM_ENROLLED_STUDENTS, c.RESPONSIBLE_FACULTY_NAME, c.OFFER_DEPT_NAME, c.window_column, m.ACADEMIC_YEAR, m.ACADEMIC_YEAR_DESC, m.coefficient_of_variation_total_units, COALESCE(r.num_required_materials, 0) AS num_required_materials FROM inner_cte c CROSS JOIN math_units_variation m LEFT JOIN TIP_SUBJECT_OFFERED t ON c.TERM_CODE = t.TERM_CODE AND c.SUBJECT_TITLE = t.SUBJECT_TITLE LEFT JOIN required_materials_count r ON t.TERM_CODE = r.TERM_CODE AND t.SUBJECT_ID = r.SUBJECT_ID\"}, {\"id\": \"dw_4640\", \"name\": \"2017JA Subject Enrollment Windows with Department Enrollment Coefficient of Variation and School Code\", \"desc\": \"For each subject offered in the term '2017JA', what is the subject title, the number of enrolled students, the responsible faculty name, the offering department name, the department full name, the school name, the minimum number of enrolled students in a window of 3 preceding and 1 following row ordered by the department code, the coefficient of variation (using STDDEV only and never STDDEV_POP) of the number of enrolled students in the subjects offered by that department (considering only subjects with at least one enrolled student), and the department's school code? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( WITH DeptVariation AS ( SELECT sd.DEPARTMENT_NAME, STDDEV(tso.NUM_ENROLLED_STUDENTS) / NULLIF(AVG(tso.NUM_ENROLLED_STUDENTS), 0) AS coefficient_of_variation FROM TIP_SUBJECT_OFFERED tso JOIN STUDENT_DEPARTMENT sd ON tso.OFFER_DEPT_CODE = sd.DEPARTMENT_CODE WHERE tso.NUM_ENROLLED_STUDENTS > 0 GROUP BY sd.DEPARTMENT_NAME HAVING AVG(tso.NUM_ENROLLED_STUDENTS) > 0 ORDER BY coefficient_of_variation DESC ), Subjects2017JA AS ( SELECT t0.SUBJECT_TITLE, t0.NUM_ENROLLED_STUDENTS, t0.RESPONSIBLE_FACULTY_NAME, t0.OFFER_DEPT_NAME, t1.DEPARTMENT_FULL_NAME, t1.SCHOOL_NAME, t1.DEPARTMENT_NAME, t1.DEPARTMENT_CODE, MIN(t0.NUM_ENROLLED_STUDENTS) OVER ( ORDER BY t1.DEPARTMENT_CODE ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING ) AS window_column FROM TIP_SUBJECT_OFFERED t0 JOIN STUDENT_DEPARTMENT t1 ON t0.OFFER_DEPT_CODE = t1.DEPARTMENT_CODE WHERE t0.TERM_CODE = '2017JA' ) SELECT s.SUBJECT_TITLE, s.NUM_ENROLLED_STUDENTS, s.RESPONSIBLE_FACULTY_NAME, s.OFFER_DEPT_NAME, s.DEPARTMENT_FULL_NAME, s.SCHOOL_NAME, s.window_column, dv.coefficient_of_variation, sd.SCHOOL_CODE FROM Subjects2017JA s LEFT JOIN DeptVariation dv ON s.DEPARTMENT_NAME = dv.DEPARTMENT_NAME JOIN STUDENT_DEPARTMENT sd ON s.DEPARTMENT_CODE = sd.DEPARTMENT_CODE ) SELECT * FROM inner_cte;\", \"category\": \"Enrollment and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per 2017JA TIP subject offering enriched with department-level enrollment coefficient of variation and school code\"}, {\"category\": \"Subject Offering and Student Directory Comprehensive Analysis\", \"default_granularity\": \"one row per department/school enrollment statistic (plus per-school rollup rows), left joined with Mathematics students named Peter\", \"desc\": \"For each department and school, provide the department name, school name, the average, range, and variance of the number of enrolled students in subjects offered by that department, and the total enrolled students, considering only departments that grant degrees and subjects with at least one enrolled student. Additionally, for each school, include a grand total for all departments in that school in the format of (null department name, school name, nulls for statistics, and total enrolled students). For students whose first name is 'Peter' and who are in the Mathematics department, also show their last name, email address, student year, and the minimum department budget code in a window of 3 preceding and 1 following row ordered by the student's full name, as well as the department full name and department last activity date. The results include all these columns in the following order: department name, school name, average enrolled students, range of enrolled students, variance of enrolled students, total enrolled students, last name, email address, student year, windowed minimum department budget code, department full name, and department last activity date. Do not return any rounded answers.\", \"id\": \"dw_1350\", \"name\": \"Degree-Granting Department TIP Enrollment Statistics with School Rollups and Math Peter Student Budget Code Windows\", \"sql\": \"WITH inner_cte1 AS ( SELECT sd.DEPARTMENT_NAME, sd.SCHOOL_NAME, tso.NUM_ENROLLED_STUDENTS FROM SIS_DEPARTMENT sd JOIN TIP_SUBJECT_OFFERED tso ON sd.DEPARTMENT_CODE = tso.OFFER_DEPT_CODE WHERE sd.IS_DEGREE_GRANTING = 'Y' AND tso.NUM_ENROLLED_STUDENTS >= 1 ), DepartmentStats AS ( SELECT DEPARTMENT_NAME, SCHOOL_NAME, AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled_students, MAX(NUM_ENROLLED_STUDENTS) - MIN(NUM_ENROLLED_STUDENTS) AS range_enrolled_students, VARIANCE(NUM_ENROLLED_STUDENTS) AS var_enrolled_students, SUM(NUM_ENROLLED_STUDENTS) AS total_enrolled_students FROM inner_cte1 GROUP BY DEPARTMENT_NAME, SCHOOL_NAME ), SchoolRollup AS ( SELECT NULL AS DEPARTMENT_NAME, SCHOOL_NAME, NULL AS avg_enrolled_students, NULL AS range_enrolled_students, NULL AS var_enrolled_students, SUM(total_enrolled_students) AS total_enrolled_students FROM DepartmentStats GROUP BY SCHOOL_NAME ), inner_cte2 AS ( SELECT t1.LAST_NAME, t1.EMAIL_ADDRESS, t1.STUDENT_YEAR, t1.DEPARTMENT_NAME, t0.SCHOOL_NAME, MIN(t0.DEPT_BUDGET_CODE) OVER (ORDER BY t1.FULL_NAME ROWS BETWEEN 3 PRECEDING AND 1 FOLLOWING) AS window_column FROM SIS_DEPARTMENT t0 JOIN MIT_STUDENT_DIRECTORY t1 ON t0.DEPARTMENT_CODE = t1.DEPARTMENT WHERE t1.FIRST_NAME = 'Peter' AND t0.DEPARTMENT_NAME = 'Mathematics' ) SELECT ds.DEPARTMENT_NAME, ds.SCHOOL_NAME, ds.avg_enrolled_students, ds.range_enrolled_students, ds.var_enrolled_students, ds.total_enrolled_students, ic2.LAST_NAME, ic2.EMAIL_ADDRESS, ic2.STUDENT_YEAR, ic2.window_column, sd.DEPARTMENT_FULL_NAME, sd.DEPARTMENT_LAST_ACTIVITY_DATE FROM (SELECT * FROM DepartmentStats UNION ALL SELECT * FROM SchoolRollup) ds LEFT JOIN inner_cte2 ic2 ON ds.DEPARTMENT_NAME = ic2.DEPARTMENT_NAME AND ds.SCHOOL_NAME = ic2.SCHOOL_NAME LEFT JOIN SIS_DEPARTMENT sd ON ds.DEPARTMENT_NAME = sd.DEPARTMENT_NAME ORDER BY ds.SCHOOL_NAME, ds.DEPARTMENT_NAME, ic2.LAST_NAME ;\"}, {\"category\": \"Library Reserve and Subject Offering Comprehensive Analysis\", \"default_granularity\": \"one row per academic year\", \"desc\": \"For each academic year, what is the academic year, academic year description, the geometric mean of the number of library reserve material details per subject offered (considering only records where the material status is 'U' and the academic term is a regular term), the average total units, the standard deviation (using STDDEV only and never STDDEV_POP) of total units, and the average number of design units for subjects that are offered in the fall term and have a material status of 'U' in the library reserve? List the results ordered by the geometric mean of materials per subject in descending order, then by the standard deviation (using STDDEV only and never STDDEV_POP) of total units in descending order. Do not return any rounded answers.\", \"id\": \"dw_4701\", \"name\": \"Yearly Geometric Mean Reserve Materials per Subject with Fall Term Unit Statistics\", \"sql\": \"WITH inner_cte AS ( WITH GeometricMeanMaterialsPerSubject AS ( SELECT ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC, EXP(AVG(LN(material_count))) AS geometric_mean_materials_per_subject FROM ( SELECT LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY, COUNT(*) AS material_count, LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE FROM LIBRARY_RESERVE_MATRL_DETAIL WHERE LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_MATERIAL_STATUS_KEY = 'U' GROUP BY LIBRARY_RESERVE_MATRL_DETAIL.LIBRARY_SUBJECT_OFFERED_KEY, LIBRARY_RESERVE_MATRL_DETAIL.TERM_CODE ) sub JOIN ACADEMIC_TERMS ON sub.TERM_CODE = ACADEMIC_TERMS.TERM_CODE WHERE ACADEMIC_TERMS.IS_REGULAR_TERM = 'Y' GROUP BY ACADEMIC_TERMS.ACADEMIC_YEAR, ACADEMIC_TERMS.ACADEMIC_YEAR_DESC ), AvgStddevTotalUnitsFallU AS ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, AVG(ccso.TOTAL_UNITS) AS avg_total_units, STDDEV(ccso.TOTAL_UNITS) AS stddev_total_units FROM LIBRARY_RESERVE_MATRL_DETAIL lrm JOIN ACADEMIC_TERMS at ON lrm.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE lrm.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ) SELECT gmmps.ACADEMIC_YEAR, gmmps.ACADEMIC_YEAR_DESC, gmmps.geometric_mean_materials_per_subject, astu.avg_total_units, astu.stddev_total_units FROM GeometricMeanMaterialsPerSubject gmmps JOIN AvgStddevTotalUnitsFallU astu ON gmmps.ACADEMIC_YEAR = astu.ACADEMIC_YEAR AND gmmps.ACADEMIC_YEAR_DESC = astu.ACADEMIC_YEAR_DESC ORDER BY gmmps.geometric_mean_materials_per_subject DESC, astu.stddev_total_units DESC ) SELECT icte.ACADEMIC_YEAR, icte.ACADEMIC_YEAR_DESC, icte.geometric_mean_materials_per_subject, icte.avg_total_units, icte.stddev_total_units, avg_design.avg_design_units FROM inner_cte icte JOIN ( SELECT at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC, AVG(ccso.DESIGN_UNITS) AS avg_design_units FROM LIBRARY_RESERVE_MATRL_DETAIL lrm JOIN ACADEMIC_TERMS at ON lrm.TERM_CODE = at.TERM_CODE JOIN COURSE_CATALOG_SUBJECT_OFFERED ccso ON at.TERM_CODE = ccso.EFFECTIVE_TERM_CODE WHERE lrm.LIBRARY_MATERIAL_STATUS_KEY = 'U' AND ccso.IS_OFFERED_FALL_TERM = 'Y' GROUP BY at.ACADEMIC_YEAR, at.ACADEMIC_YEAR_DESC ) avg_design ON icte.ACADEMIC_YEAR = avg_design.ACADEMIC_YEAR AND icte.ACADEMIC_YEAR_DESC = avg_design.ACADEMIC_YEAR_DESC ORDER BY icte.geometric_mean_materials_per_subject DESC, icte.stddev_total_units DESC;\"}], \"not_found\": []}"
