    {
      "role": "tool",
      "tool_call_id": "call_29dd0d9d77564284b7336cf6",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"default_granularity\": \"one row per S H&SS organization space unit rollup row (including SUBTOTAL and TOTAL rows) with supervisor usage statistics\", \"desc\": \"For each organization whose parent is 'S H&SS' and that is associated with a space unit with space unit code 97500, list the organization name, description, HR org unit title, row number within a window of 2 preceding and 1 following rows ordered by the organization name, the space unit name, space unit code, department count, number of supervisees, the average department count within each department count group ordered by number of supervisees, and the total square footage for each organization. Include subtotals for each organization (the corresponding organization name field is 'SUBTOTAL') and a grand total across all organizations (the corresponding organization name field is 'TOTAL'). Do not repeat the organization name if it is the same as the previous row. Sort the table by organization name and space unit name. Do not return any rounded answers.\", \"id\": \"dw_4612\", \"name\": \"S H&SS Organization Rollup with Space Unit 97500 Supervisor Usage Statistics and Total Square Footage\", \"sql\": \"WITH inner_cte AS ( WITH OrgWindowed AS ( SELECT t0.ORGANIZATION_NAME, t0.DESCRIPTION, t1.HR_ORG_UNIT_TITLE, ROW_NUMBER() OVER (ORDER BY t0.ORGANIZATION_NAME ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t0.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN HR_ORG_UNIT t1 ON t0.HR_ORG_UNIT_ID = t1.HR_ORG_UNIT_ID WHERE t0.ORG_PARENT = 'S H&SS' ), SpaceUnitStats AS ( SELECT t1.SPACE_UNIT AS space_unit_name, t1.SPACE_UNIT_CODE, t0.ORGANIZATION_NAME, t2.DEPT_COUNT, t2.NUM_OF_SUPERVISEES, AVG(t2.DEPT_COUNT) OVER (PARTITION BY t2.DEPT_COUNT ORDER BY t2.NUM_OF_SUPERVISEES) AS avg_dept_count_within_group, t2.SQFT, t1.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN SPACE_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY JOIN SPACE_SUPERVISOR_USAGE t2 ON t1.DLC_KEY = t2.DEPT_NAMES WHERE t1.SPACE_UNIT_CODE = 97500 ) SELECT ow.ORGANIZATION_NAME, ow.DESCRIPTION, ow.HR_ORG_UNIT_TITLE, ow.window_column, sus.space_unit_name, sus.SPACE_UNIT_CODE, sus.DEPT_COUNT, sus.NUM_OF_SUPERVISEES, sus.avg_dept_count_within_group, sus.SQFT FROM OrgWindowed ow JOIN SpaceUnitStats sus ON ow.DLC_KEY = sus.DLC_KEY ) SELECT CASE WHEN LAG(ORGANIZATION_NAME) OVER (ORDER BY org_sort, space_unit_name) = ORGANIZATION_NAME THEN NULL ELSE ORGANIZATION_NAME END AS organization_name, DESCRIPTION, HR_ORG_UNIT_TITLE, window_column, space_unit_name, SPACE_UNIT_CODE, DEPT_COUNT, NUM_OF_SUPERVISEES, avg_dept_count_within_group, SQFT, SUM(SQFT) OVER (PARTITION BY ORGANIZATION_NAME) AS total_sqft_per_org FROM ( SELECT CASE WHEN GROUPING(ORGANIZATION_NAME) = 1 AND GROUPING(space_unit_name) = 1 THEN 'zzz' ELSE ORGANIZATION_NAME END AS org_sort, CASE WHEN GROUPING(ORGANIZATION_NAME) = 0 AND GROUPING(space_unit_name) = 1 THEN 'SUBTOTAL' WHEN GROUPING(ORGANIZATION_NAME) = 1 AND GROUPING(space_unit_name) = 1 THEN 'TOTAL' ELSE ORGANIZATION_NAME END AS ORGANIZATION_NAME, DESCRIPTION, HR_ORG_UNIT_TITLE, window_column, CASE WHEN GROUPING(ORGANIZATION_NAME) = 0 AND GROUPING(space_unit_name) = 1 THEN 'zzz' ELSE space_unit_name END AS space_unit_sort, space_unit_name, SPACE_UNIT_CODE, DEPT_COUNT, NUM_OF_SUPERVISEES, avg_dept_count_within_group, SQFT FROM inner_cte GROUP BY ORGANIZATION_NAME, DESCRIPTION, HR_ORG_UNIT_TITLE, window_column, space_unit_name, SPACE_UNIT_CODE, DEPT_COUNT, NUM_OF_SUPERVISEES, avg_dept_count_within_group, SQFT WITH ROLLUP ) tbl ORDER BY org_sort, space_unit_sort;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\"}, {\"id\": \"dw_2956\", \"name\": \"Active Moira Mailing List Member Rollup with Per-List Min MIT ID and Deduplicated List Keys\", \"desc\": \"For all active Moira lists that are also Moira mailing lists, show the list key, list name, whether the list is public, the member's full name, the member's MIT ID, the last update date, and the minimum MIT ID value over each list key group. Include subtotals for each list key (the corresponding list key field is 'SUBTOTAL') and a grand total across all lists (the corresponding list key field is 'TOTAL'). Do not repeat the list key if it is the same as the previous row. Sort the table by list key and list name. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT t0.MOIRA_LIST_KEY, t0.MOIRA_LIST_NAME, t0.IS_PUBLIC, t1.MOIRA_LIST_MEMBER_FULL_NAME, t1.MOIRA_LIST_MEMBER_MIT_ID, t1.LAST_UPDATE_DATE, min(t1.MOIRA_LIST_MEMBER_MIT_ID) OVER (PARTITION BY t0.MOIRA_LIST_KEY ORDER BY t0.MOIRA_LIST_KEY) AS min_mit_id FROM MOIRA_LIST t0 JOIN MOIRA_LIST_DETAIL t1 ON t0.MOIRA_LIST_KEY = t1.MOIRA_LIST_KEY WHERE t0.IS_ACTIVE = 'Y' AND t0.IS_MOIRA_MAILING_LIST = 'Y' ) SELECT CASE WHEN LAG(list_key) OVER (ORDER BY list_key_sort, list_name_sort) = list_key THEN NULL ELSE list_key END AS list_key, list_name, is_public, member_full_name, member_mit_id, last_update_date, min_mit_id FROM ( SELECT CASE WHEN GROUPING(MOIRA_LIST_KEY) = 1 AND GROUPING(MOIRA_LIST_NAME) = 1 THEN 'zzz' ELSE MOIRA_LIST_KEY END AS list_key_sort, CASE WHEN GROUPING(MOIRA_LIST_KEY) = 0 AND GROUPING(MOIRA_LIST_NAME) = 1 THEN 'SUBTOTAL' WHEN GROUPING(MOIRA_LIST_KEY) = 1 AND GROUPING(MOIRA_LIST_NAME) = 1 THEN 'TOTAL' ELSE MOIRA_LIST_KEY END AS list_key, CASE WHEN GROUPING(MOIRA_LIST_KEY) = 0 AND GROUPING(MOIRA_LIST_NAME) = 1 THEN 'zzz' ELSE MOIRA_LIST_NAME END AS list_name_sort, MOIRA_LIST_NAME AS list_name, MAX(IS_PUBLIC) AS is_public, MAX(MOIRA_LIST_MEMBER_FULL_NAME) AS member_full_name, MAX(MOIRA_LIST_MEMBER_MIT_ID) AS member_mit_id, MAX(LAST_UPDATE_DATE) AS last_update_date, MIN(min_mit_id) AS min_mit_id FROM inner_cte GROUP BY MOIRA_LIST_KEY, MOIRA_LIST_NAME WITH ROLLUP ) tbl ORDER BY list_key_sort, list_name_sort;\", \"category\": \"Mailing List Membership Analysis\", \"default_granularity\": \"one row per list key/list name rollup level (detail, SUBTOTAL per list key, TOTAL grand total)\"}, {\"id\": \"dw_1357\", \"name\": \"Access Level Campus Sector Room Count Variance Rollup with Fairchild Floor Room Area Statistics\", \"desc\": \"For each access level code and campus sector, what is the access level code, access level name, campus sector, the variance of the number of rooms in the building history for buildings with a nonzero number of rooms, assignable area greater than 0, and that are residential buildings at MIT, as well as, for each floor in the Fairchild Building with access level 1 or 2 and in academic buildings, the floor number, the building's long name, the range and variance of the area of rooms on that floor? Only include buildings that are at MIT. Also, include subtotals for each access level code (the corresponding campus sector field is 'SUBTOTAL') and a grand total across all access level codes (the corresponding campus sector field is 'TOTAL'). Do not repeat the access level code if it is the same as the previous row. Sort the table by access level code, campus sector, and floor. Do not return any rounded answers.\", \"sql\": \"WITH inner_cte1 AS ( SELECT fb.ACCESS_LEVEL_CODE, fb.ACCESS_LEVEL_NAME, fbh.CAMPUS_SECTOR, fbh.NUM_OF_ROOMS FROM FCLT_BUILDING fb JOIN FCLT_BUILDING_HIST fbh ON fb.ACCESS_LEVEL_CODE = fbh.ACCESS_LEVEL_CODE WHERE fbh.NUM_OF_ROOMS > 0 AND fbh.ASSIGNABLE_AREA > 0 AND fbh.BUILDING_TYPE = 'RESIDENT' AND fbh.SITE = 'MIT' ), access_level_variance AS ( SELECT CASE WHEN LAG(ACCESS_LEVEL_CODE) OVER (ORDER BY access_level_code_sort, campus_sector_sort) = ACCESS_LEVEL_CODE THEN NULL ELSE ACCESS_LEVEL_CODE END AS access_level_code, ACCESS_LEVEL_NAME, campus_sector, num_of_rooms_variance, ACCESS_LEVEL_CODE AS join_access_level_code FROM ( SELECT CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 1 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'zzz' ELSE ACCESS_LEVEL_CODE END AS access_level_code_sort, CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 0 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'SUBTOTAL' WHEN GROUPING(ACCESS_LEVEL_CODE) = 1 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'TOTAL' ELSE CAMPUS_SECTOR END AS campus_sector, CASE WHEN GROUPING(ACCESS_LEVEL_CODE) = 0 AND GROUPING(CAMPUS_SECTOR) = 1 THEN 'zzz' ELSE CAMPUS_SECTOR END AS campus_sector_sort, ACCESS_LEVEL_CODE, MAX(ACCESS_LEVEL_NAME) AS ACCESS_LEVEL_NAME, VARIANCE(NUM_OF_ROOMS) AS num_of_rooms_variance FROM inner_cte1 GROUP BY ACCESS_LEVEL_CODE, CAMPUS_SECTOR WITH ROLLUP ) tbl ORDER BY access_level_code_sort, campus_sector_sort ), inner_cte2 AS ( SELECT fb.BUILDING_NAME_LONG, fr.FCLT_FLOOR_KEY, fr.AREA FROM FCLT_ROOMS fr JOIN FCLT_BUILDING fb ON fr.FCLT_BUILDING_KEY = fb.FCLT_BUILDING_KEY WHERE fr.ACCESS_LEVEL IN (1, 2) AND fb.BUILDING_TYPE = 'ACADEMIC' AND fb.FCLT_BUILDING_KEY = '36' ), floor_area_stats AS ( SELECT f.FLOOR, i.BUILDING_NAME_LONG, MAX(i.AREA) - MIN(i.AREA) AS area_range, VARIANCE(i.AREA) AS area_variance, fb.ACCESS_LEVEL_CODE AS join_access_level_code FROM inner_cte2 i JOIN FCLT_FLOOR f ON i.FCLT_FLOOR_KEY = f.FCLT_FLOOR_KEY JOIN FCLT_BUILDING fb ON fb.BUILDING_NAME_LONG = i.BUILDING_NAME_LONG GROUP BY f.FLOOR, i.BUILDING_NAME_LONG, fb.ACCESS_LEVEL_CODE ) SELECT alv.access_level_code, alv.ACCESS_LEVEL_NAME, alv.campus_sector, alv.num_of_rooms_variance, fas.FLOOR, fas.BUILDING_NAME_LONG, fas.area_range, fas.area_variance FROM access_level_variance alv JOIN floor_area_stats fas ON alv.join_access_level_code = fas.join_access_level_code ORDER BY alv.access_level_code, alv.campus_sector, fas.FLOOR\", \"category\": \"Facility Space Analysis\", \"default_granularity\": \"one row per access-level/campus-sector rollup row matched with a floor of the selected academic building\"}], \"not_found\": []}"
    },
