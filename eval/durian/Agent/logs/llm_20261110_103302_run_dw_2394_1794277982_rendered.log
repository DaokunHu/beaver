          "id": "call_ab3e359478344d9fb037f78a",
          "type": "function",
          "function": {
            "name": "submit_SQL",
            "arguments": "{\"sql\": \"WITH Sub2 AS (\\n  SELECT sd.DEPARTMENT_NAME,\\n         MAX(scd.CIP_PROGRAM_CODE) AS MAX_CIP_PROGRAM_CODE,\\n         sd.DEPARTMENT_FULL_NAME\\n  FROM SIS_DEPARTMENT sd\\n  JOIN SIS_COURSE_DESCRIPTION scd ON sd.DEPARTMENT_CODE = scd.DEPARTMENT\\n  WHERE sd.IS_DEGREE_GRANTING = 'Y'\\n    AND sd.DEPARTMENT_NAME <> 'Mathematics'\\n    AND scd.CIP_PROGRAM_CODE > 120000\\n  GROUP BY sd.DEPARTMENT_NAME, sd.DEPARTMENT_FULL_NAME\\n),\\ninner_cte AS (\\n  SELECT tso.TERM_CODE,\\n         tso.OFFER_DEPT_NAME,\\n         tso.NUM_ENROLLED_STUDENTS,\\n         s2.MAX_CIP_PROGRAM_CODE,\\n         s2.DEPARTMENT_FULL_NAME\\n  FROM TIP_SUBJECT_OFFERED tso\\n  JOIN TIP_DETAIL td ON tso.SUBJECT_ID = td.SUBJECT_ID\\n  JOIN Sub2 s2 ON tso.OFFER_DEPT_NAME = s2.DEPARTMENT_NAME\\n  WHERE tso.OFFER_DEPT_NAME = 'Chemistry'\\n    AND td.TIP_MATERIAL_STATUS_KEY IS NOT NULL\\n)\\nSELECT CASE WHEN LAG(term) OVER (ORDER BY term_sort, term, dept_sort) = term THEN NULL ELSE term END AS term,\\n       dept,\\n       avg_enrolled_students,\\n       stddev_enrolled_students,\\n       MAX_CIP_PROGRAM_CODE,\\n       DEPARTMENT_FULL_NAME\\nFROM (\\n  SELECT CASE WHEN GROUPING(TERM_CODE) = 1 AND GROUPING(OFFER_DEPT_NAME) = 1 THEN 'zzz' ELSE TERM_CODE END AS term_sort,\\n         CASE WHEN GROUPING(TERM_CODE) = 0 AND GROUPING(OFFER_DEPT_NAME) = 1 THEN 'SUBTOTAL'\\n              WHEN GROUPING(TERM_CODE) = 1 AND GROUPING(OFFER_DEPT_NAME) = 1 THEN 'TOTAL'\\n              ELSE TERM_CODE END AS term,\\n         CASE WHEN GROUPING(TERM_CODE) = 0 AND GROUPING(OFFER_DEPT_NAME) = 1 THEN 'zzz' ELSE OFFER_DEPT_NAME END AS dept_sort,\\n         OFFER_DEPT_NAME AS dept,\\n         AVG(NUM_ENROLLED_STUDENTS) AS avg_enrolled_students,\\n         STDDEV(NUM_ENROLLED_STUDENTS) AS stddev_enrolled_students,\\n         MAX(MAX_CIP_PROGRAM_CODE) AS MAX_CIP_PROGRAM_CODE,\\n         MAX(DEPARTMENT_FULL_NAME) AS DEPARTMENT_FULL_NAME\\n  FROM inner_cte\\n  GROUP BY TERM_CODE, OFFER_DEPT_NAME WITH ROLLUP\\n) tbltmp\\nORDER BY term_sort, dept_sort\"}"
