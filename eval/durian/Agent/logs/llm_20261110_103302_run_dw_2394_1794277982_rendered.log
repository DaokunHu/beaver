            "arguments": "{\"sql\": \"SELECT COUNT(*) AS n, COUNT(DISTINCT TERM_CODE) AS terms, MIN(TERM_CODE) AS mn, MAX(TERM_CODE) AS mx FROM TIP_SUBJECT_OFFERED WHERE OFFER_DEPT_NAME='Chemistry'\"}"
