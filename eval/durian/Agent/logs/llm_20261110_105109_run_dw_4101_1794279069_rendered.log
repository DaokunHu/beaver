      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"FCLT_ORG_DLC_KEY\", \"name\": \"FCLT_ORG_DLC_KEY\", \"desc\": \"Bridge table mapping facilities organizations to their department/lab/center (DLC) keys: one row per organization-DLC key assignment. Used to filter organizations that have a non-null DLC key assignment before joining FCLT_ORGANIZATION (via FCLT_ORGANIZATION_KEY or DLC_KEY) for DLC-level facility and room statistics.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Foreign key to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY identifying the organization in the DLC assignment\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_AEROASTRO'; joins to FCLT_ORGANIZATION.DLC_KEY; non-null values identify organizations with a DLC assignment\"}}}, {\"id\": \"FCLT_ORGANIZATION\", \"name\": \"FCLT_ORGANIZATION\", \"desc\": \"Facilities organization dimension table: one row per organization in the institute's hierarchical organization tree (levels 1-6, from institute-wide down to sub-units), with organization identifiers and names, parent and major-organization attribution, hierarchy level, assignable-space flag, course number for academic departments, description, DLC (department/lab/center) key and name, and cross-references to HR organization units. Parent of SPACE_UNIT (space assigned to organizations) and referenced by FCLT_ROOMS via FCLT_ORGANIZATION_KEY for room occupancy attribution.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Surrogate key of the facilities organization; joins to SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY\"}, \"ORGANIZATION_ID\": {\"desc\": \"Organization identifier (same value as the organization key in current data)\"}, \"ORGANIZATION\": {\"desc\": \"Short organization abbreviation, e.g. 'AERO', 'ADMISS'\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Display name of the organization, e.g. 'AERO & ASTRO'; used for organization-name reporting\"}, \"FCLT_ORG_PARENT_KEY\": {\"desc\": \"Key of the parent organization in the hierarchy tree; null for the top-level organization\"}, \"ORG_PARENT\": {\"desc\": \"Abbreviation of the parent organization, e.g. 'S ENG' (School of Engineering)\"}, \"FCLT_MAJOR_ORG_KEY\": {\"desc\": \"Key of the major (top-level grouping) organization this organization rolls up to\"}, \"MAJOR_ORG\": {\"desc\": \"Abbreviation of the major organization, e.g. 'PROVST', 'CHNCLR'\"}, \"ORGANIZATION_LEVEL\": {\"desc\": \"Level of the organization in the hierarchy tree (1 = institute-wide root, 2-4 = intermediate divisions/schools, 5 = department/DLC level, 6 = sub-organization); stored as string, filter with values like '5'\"}, \"ORGANIZATION_NUMBER\": {\"desc\": \"Official organization number used in administrative systems\"}, \"ORGANIZATION_SORT\": {\"desc\": \"Sortable hierarchical organization code reflecting the tree path\"}, \"ASSIGNABLE\": {\"desc\": \"Flag ('1'/'0') indicating whether the organization is an assignable-space organizational unit\"}, \"COURSE\": {\"desc\": \"Academic course (department) number for degree-granting academic departments, e.g. '16' for Aeronautics and Astronautics; null for non-academic organizations\"}, \"DESCRIPTION\": {\"desc\": \"Long description of the organization, e.g. 'Department of Aeronautics and Astronautics'; null for many non-academic organizations\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_AEROASTRO'; joins to FCLT_ORG_DLC_KEY.DLC_KEY, HR_ORG_UNIT.DLC_KEY (for HR org unit title/level and HR department attributes; may fan out when a DLC maps to multiple HR org units), and MASTER_DEPT_HIERARCHY.DLC_KEY (for the standard department hierarchy path)\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Aeronautics and Astronautics'\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code cross-reference\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"HR organization unit identifier cross-reference; links to HR_ORG_UNIT\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"Department name as recorded in HR systems\"}}, \"default_granularity\": \"one row per facilities organization\"}, {\"id\": \"SPACE_UNIT\", \"name\": \"SPACE_UNIT\", \"desc\": \"Space unit dimension table: one row per space unit (an organizational space-assignment unit such as a department, program, or office that receives space allocation), with space unit key/code, space unit name, the facilities organization it belongs to, and DLC key. Bridges FCLT_ORGANIZATION (organization attribution) and SPACE_DETAIL (rooms assigned to the space unit); used to group room counts and space statistics by space unit.\", \"columns\": {\"FCLT_ORGANIZATION_KEY\": {\"desc\": \"Foreign key to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY; the organization that owns/occupies this space unit\"}, \"SPACE_UNIT_KEY\": {\"desc\": \"Surrogate key of the space unit; joins to SPACE_DETAIL.SPACE_UNIT_KEY and SPACE_UNIT2.SPACE_UNIT_KEY; used for partitioning/ordering in space analyses\"}, \"SPACE_UNIT_CODE\": {\"desc\": \"Business code of the space unit (same numeric value as the key in current data)\"}, \"SPACE_UNIT\": {\"desc\": \"Name of the space unit, e.g. 'Physics', 'Technology & Policy Program'\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_PHYSICS'; may contain composite values like 'D_DSL:HQ'\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per space unit\"}, {\"id\": \"MASTER_DEPT_HIERARCHY\", \"name\": \"MASTER_DEPT_HIERARCHY\", \"desc\": \"Master department hierarchy table: one row per department/lab/center (DLC) under the 'Standard Hierarchy' hierarchy type, recording the DLC key/code/name and its five-level hierarchy path from the institute root (level 1 'All Departments') through executive areas down to the DLC's placement, with each level's code and name (null for levels deeper than the DLC's position). Joins to HR_ORG_UNIT and FCLT_ORGANIZATION via DLC_KEY; used to report or filter the master-hierarchy placement (school/area path) of a DLC, and as a DLC scope filter when only DLCs present in the standard hierarchy should be included.\", \"columns\": {\"HIERARCHY_TYPE\": {\"desc\": \"Hierarchy classification of the row; only 'Standard Hierarchy' exists in current data\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key, e.g. 'D_CAMPLAN'; joins to HR_ORG_UNIT.DLC_KEY and FCLT_ORGANIZATION.DLC_KEY\"}, \"DLC_CODE\": {\"desc\": \"Department/Lab/Center code (same value as DLC_KEY in current data); matches MASTER_DEPT_DCODE_PARENT.D_CODE\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name, e.g. 'Campus Planning'\"}, \"MASTER_DEPT_HIER_LEVEL_1_CODE\": {\"desc\": \"Code of the level-1 hierarchy node, 'D_ALL' for all rows\"}, \"MASTER_DEPT_HIER_LEVEL_1_NAME\": {\"desc\": \"Name of the level-1 hierarchy node, 'All Departments'\"}, \"MASTER_DEPT_HIER_LEVEL_2_CODE\": {\"desc\": \"Code of the level-2 hierarchy node, e.g. 'D_EXECVP_AREA'\"}, \"MASTER_DEPT_HIER_LEVEL_2_NAME\": {\"desc\": \"Name of the level-2 hierarchy node, e.g. \\\"Executive Vice President's Area\\\"\"}, \"MASTER_DEPT_HIER_LEVEL_3_CODE\": {\"desc\": \"Code of the level-3 hierarchy node; null when the DLC's path is shallower than 3 levels\"}, \"MASTER_DEPT_HIER_LEVEL_3_NAME\": {\"desc\": \"Name of the level-3 hierarchy node, e.g. 'VP Finance Area'; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_4_CODE\": {\"desc\": \"Code of the level-4 hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_4_NAME\": {\"desc\": \"Name of the level-4 hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_5_CODE\": {\"desc\": \"Code of the level-5 (deepest) hierarchy node; null for shallow paths\"}, \"MASTER_DEPT_HIER_LEVEL_5_NAME\": {\"desc\": \"Name of the level-5 (deepest) hierarchy node; null for shallow paths\"}}, \"default_granularity\": \"one row per DLC under the standard hierarchy type\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_4fe0c1d2eb234d92940159c5",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"dw_3235\", \"name\": \"Provost Area Department Facility Organization Counts with HR Org Unit Count Dispersion\", \"desc\": \"For each department name and its corresponding facility organization key where the department is in the Provost Area, provide the number of organizations, the minimum department hierarchy level 3 code, the range, variance, and standard deviation (using STDDEV only and never STDDEV_POP) of the number of HR organization units per facility organization (considering only those with a non-null DLC key and where the hierarchy type is 'Standard Hierarchy'), listing the results in order by department name and facility organization key. Do not return any rounded answers.\", \"sql\": \"WITH ProvostAreaDepts AS ( SELECT m.DLC_NAME, f.FCLT_ORGANIZATION_KEY, COUNT(f.FCLT_ORGANIZATION_KEY) AS org_count, MIN(m.MASTER_DEPT_HIER_LEVEL_3_CODE) AS min_level3_code FROM MASTER_DEPT_HIERARCHY m JOIN FCLT_ORG_DLC_KEY f ON m.DLC_KEY = f.DLC_KEY WHERE m.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' GROUP BY m.DLC_NAME, f.FCLT_ORGANIZATION_KEY ), FacilityOrgStats AS ( SELECT f.FCLT_ORGANIZATION_KEY, MAX(hr_unit_count) - MIN(hr_unit_count) AS org_unit_count_range, VARIANCE(hr_unit_count) AS org_unit_count_variance, STDDEV(hr_unit_count) AS org_unit_count_stddev FROM FCLT_ORG_DLC_KEY f JOIN MASTER_DEPT_HIERARCHY m ON f.DLC_KEY = m.DLC_KEY JOIN ( SELECT h.DLC_KEY, COUNT(*) AS hr_unit_count FROM HR_ORG_UNIT h WHERE h.DLC_KEY IS NOT NULL GROUP BY h.DLC_KEY ) AS hr_stats ON m.DLC_KEY = hr_stats.DLC_KEY WHERE f.DLC_KEY IS NOT NULL AND m.HIERARCHY_TYPE = 'Standard Hierarchy' GROUP BY f.FCLT_ORGANIZATION_KEY ORDER BY org_unit_count_range DESC ), CombinedProvostFacility AS ( SELECT p.DLC_NAME, p.FCLT_ORGANIZATION_KEY, p.org_count, p.min_level3_code, f.org_unit_count_range, f.org_unit_count_variance, f.org_unit_count_stddev FROM ProvostAreaDepts p JOIN FacilityOrgStats f ON p.FCLT_ORGANIZATION_KEY = f.FCLT_ORGANIZATION_KEY ) SELECT * FROM CombinedProvostFacility ORDER BY DLC_NAME, FCLT_ORGANIZATION_KEY;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per Provost Area department name and facility organization key with HR org unit count dispersion statistics\"}, {\"id\": \"dw_1864\", \"name\": \"Level-5 Assignable Organization Space Units with Provost Area HR Department Statistics\", \"desc\": \"For each organization whose organization level is 5 and is not 'ADMISSIONS', and for each organization and its corresponding HR department where the organization is assignable, the HR organization unit level is 'DEPARTMENTS', the organization is not 'Cambridge-MIT Institute', and the organization is in the 'Provost Area' top-level HR hierarchy, but excluding organizations with organization IDs '138' and '250', show the organization name, description, the corresponding space unit name, the total number of space units associated with each organization, the HR department name, the number of organizations, and the minimum organization number. Do not return any rounded answers.\", \"sql\": \"WITH org_space_units AS ( SELECT ORGANIZATION_NAME, DESCRIPTION, SPACE_UNIT, COUNT(SPACE_UNIT) OVER (PARTITION BY ORGANIZATION_NAME) AS total_space_units, DLC_KEY FROM ( SELECT t0.ORGANIZATION_NAME, t0.DESCRIPTION, t1.SPACE_UNIT, ROW_NUMBER() OVER (ORDER BY t1.SPACE_UNIT ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t0.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN SPACE_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.ORGANIZATION_LEVEL = 5 AND t0.ORGANIZATION_NAME <> 'ADMISSIONS' AND t0.ORGANIZATION_ID NOT IN ('138', '250') ) inner_cte ), org_hr_dept AS ( SELECT ic.ORGANIZATION, ic.HR_DEPARTMENT_NAME, ic.organization_count, ic.min_organization_number, f.DLC_KEY FROM ( SELECT f.ORGANIZATION, h.HR_DEPARTMENT_NAME, COUNT(f.FCLT_ORGANIZATION_KEY) AS organization_count, MIN(f.ORGANIZATION_NUMBER) AS min_organization_number FROM FCLT_ORGANIZATION f JOIN HR_ORG_UNIT h ON f.HR_DEPARTMENT_CODE_OLD = h.HR_DEPARTMENT_CODE_OLD WHERE f.ASSIGNABLE = 1 AND h.HR_ORG_UNIT_LEVEL = 'DEPARTMENTS' AND f.ORGANIZATION_NAME NOT IN ('CAMBRIDGE-MIT INST') AND f.ORGANIZATION_ID NOT IN ('138', '250') GROUP BY f.ORGANIZATION, h.HR_DEPARTMENT_NAME ) ic JOIN HR_ORG_UNIT h2 ON ic.HR_DEPARTMENT_NAME = h2.HR_DEPARTMENT_NAME JOIN FCLT_ORGANIZATION f ON ic.ORGANIZATION = f.ORGANIZATION WHERE h2.ORG_HIER_TOP_LEVEL_NAME = 'Provost Area' ) SELECT osu.ORGANIZATION_NAME, osu.DESCRIPTION, osu.SPACE_UNIT, osu.total_space_units, ohd.HR_DEPARTMENT_NAME, ohd.organization_count, ohd.min_organization_number FROM org_space_units osu JOIN org_hr_dept ohd ON osu.DLC_KEY = ohd.DLC_KEY;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per level-5 organization space unit matched with its Provost Area HR department statistics\"}, {\"default_granularity\": \"one row per assignable level-5 organization matched with a Provost Area department hierarchy row sharing DLC key and HR department name\", \"desc\": \"For each organization and department in the Provost Area with a non-null department code, where the organization level is 5 and assignable is 1, show the organization name, organization key, department name, department code, the average organization key within each organization key group ordered by department code, the department's long name, the corresponding hierarchy level 3 name from the master department hierarchy, and the row number within a window of 2 preceding and 1 following rows ordered by the department name. The columns should be shown in the following order: organization name, organization key, department name, department code, the average organization key window value, department's long name, hierarchy level 3 name, and the department hierarchy row number. Do not return any rounded answers.\", \"id\": \"dw_3692\", \"name\": \"Assignable Level-5 Organization Key Windows with Provost Area Department Hierarchy Row Numbers\", \"sql\": \"WITH org_avg_keys AS ( SELECT t0.ORGANIZATION_NAME, t0.FCLT_ORGANIZATION_KEY, t1.HR_DEPARTMENT_NAME, t1.HR_DEPARTMENT_CODE, AVG(t0.FCLT_ORGANIZATION_KEY) OVER (PARTITION BY t0.FCLT_ORGANIZATION_KEY ORDER BY t1.HR_DEPARTMENT_CODE) AS window_column, t0.DLC_KEY FROM FCLT_ORGANIZATION t0 JOIN HR_ORG_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t0.ORGANIZATION_LEVEL = 5 AND t0.ASSIGNABLE = 1 ), dept_hierarchy_rows AS ( SELECT t1.HR_DEPARTMENT_NAME, t1.HR_DEPARTMENT_NAME_LONG, t0.MASTER_DEPT_HIER_LEVEL_3_NAME, ROW_NUMBER() OVER (ORDER BY t1.HR_DEPARTMENT_NAME ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS window_column, t1.DLC_KEY FROM MASTER_DEPT_HIERARCHY t0 JOIN HR_ORG_UNIT t1 ON t0.DLC_KEY = t1.DLC_KEY WHERE t1.ORG_HIER_TOP_LEVEL_NAME = 'Provost Area' AND t1.HR_DEPARTMENT_CODE IS NOT NULL ) SELECT oak.ORGANIZATION_NAME, oak.FCLT_ORGANIZATION_KEY, oak.HR_DEPARTMENT_NAME, oak.HR_DEPARTMENT_CODE, oak.window_column AS org_avg_key_window, dhr.HR_DEPARTMENT_NAME_LONG, dhr.MASTER_DEPT_HIER_LEVEL_3_NAME, dhr.window_column AS dept_hierarchy_rownum FROM org_avg_keys oak JOIN dept_hierarchy_rows dhr ON oak.DLC_KEY = dhr.DLC_KEY AND oak.HR_DEPARTMENT_NAME = dhr.HR_DEPARTMENT_NAME;\", \"category\": \"Organization Hierarchy Analysis\"}, {\"id\": \"dw_2559\", \"name\": \"Office-Named DLCs with Assignable Organization Counts, Provost Area Department Max Organization Number, Space Unit, and Earliest Load Date\", \"desc\": \"For each DLC whose DLC name contains the word 'Office', is not the biology department, and has at least one assignable organization, what are the DLC key, DLC name, the number of unique organizations, the total number of assignable organizations, the department name, the maximum organization number, the name of the space unit associated with that department, and the earliest warehouse load date among its organizations, considering only departments in the \\\"Provost Area\\\" with a maximum organization number greater than 50000 and excluding the \\\"Political Science\\\" department (Course 17)? Do not return any rounded answers.\", \"sql\": \"WITH inner_cte AS ( SELECT d.DLC_KEY, o.DLC_NAME, COUNT(DISTINCT o.FCLT_ORGANIZATION_KEY) AS organization_count, SUM(CASE WHEN o.ASSIGNABLE = 1 THEN 1 ELSE 0 END) AS assignable_organization_count FROM FCLT_ORG_DLC_KEY d JOIN FCLT_ORGANIZATION o ON d.DLC_KEY = o.DLC_KEY WHERE o.ASSIGNABLE = 1 AND o.DLC_NAME LIKE '%Office%' AND LOWER(o.DLC_NAME) != LOWER('Biology') GROUP BY d.DLC_KEY, o.DLC_NAME ), Dept_Max_Org_Space AS ( SELECT mdh.DLC_KEY, mdh.DLC_NAME AS department, MAX(fo.ORGANIZATION_NUMBER) AS max_organization_number, su.SPACE_UNIT AS space_unit_name FROM MASTER_DEPT_HIERARCHY mdh JOIN FCLT_ORGANIZATION fo ON mdh.DLC_KEY = fo.DLC_KEY LEFT JOIN SPACE_UNIT su ON fo.DLC_KEY = su.DLC_KEY WHERE mdh.MASTER_DEPT_HIER_LEVEL_2_NAME = 'Provost Area' AND fo.ORGANIZATION_NUMBER > 50000 AND mdh.DLC_NAME <> 'Political Science' GROUP BY mdh.DLC_KEY, mdh.DLC_NAME, su.SPACE_UNIT ), Org_Earliest_Load AS ( SELECT o.DLC_KEY, MIN(o.WAREHOUSE_LOAD_DATE) AS earliest_warehouse_load_date FROM FCLT_ORGANIZATION o GROUP BY o.DLC_KEY ) SELECT ic.DLC_KEY, ic.DLC_NAME, ic.organization_count, ic.assignable_organization_count, dmos.department, dmos.max_organization_number, dmos.space_unit_name, oel.earliest_warehouse_load_date FROM inner_cte ic JOIN Dept_Max_Org_Space dmos ON ic.DLC_KEY = dmos.DLC_KEY LEFT JOIN Org_Earliest_Load oel ON ic.DLC_KEY = oel.DLC_KEY;\", \"category\": \"Facility Space and Organization Hierarchy Comprehensive Analysis\", \"default_granularity\": \"one row per Office-named DLC matched with Provost Area department space unit and load date statistics\"}], \"not_found\": []}"
    },
