    {
      "role": "tool",
      "tool_call_id": "call_fa48d6610b3b4923bbd3b51b",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"SPACE_UNIT2\", \"name\": \"SPACE_UNIT2\", \"desc\": \"Alternative space unit lookup table containing space unit key, code, name, and DLC key, but without the FCLT_ORGANIZATION_KEY organization attribution present in SPACE_UNIT. Holds fewer space units than SPACE_UNIT; used when only space unit identity/name is needed without organization linkage.\", \"columns\": {\"SPACE_UNIT_KEY\": {\"desc\": \"Surrogate key of the space unit; same value domain as SPACE_UNIT.SPACE_UNIT_KEY and referenced by SPACE_DETAIL.SPACE_UNIT_KEY\"}, \"SPACE_UNIT_CODE\": {\"desc\": \"Business code of the space unit\"}, \"SPACE_UNIT\": {\"desc\": \"Name of the space unit\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key of the space unit\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per space unit\"}, {\"id\": \"HR_ORG_UNIT\", \"name\": \"HR_ORG_UNIT\", \"desc\": \"HR organization unit dimension table: one row per HR organization unit with unit key/ID/title, unit level classification (ALL MIT, TOP LEVEL, DEPARTMENTS, SUB DEPARTMENT, ORGANIZATION LEVEL, NON HIERARCHY ORG UNITS), HR department identifiers and name variants (short, long, alphabetical), organization hierarchy area names (school area, top level, root), the full HR hierarchy path levels 1-7 (each with ID, sort order, and name), and DLC_KEY/DLC_NAME cross-references to departments/labs/centers. Joined from FCLT_ORGANIZATION and MASTER_DEPT_HIERARCHY via DLC_KEY to attach HR department attributes (title, level, department name, long name, hierarchy path) to facilities organizations and DLCs; a single DLC_KEY can map to multiple HR org unit rows, so joins via DLC_KEY may fan out.\", \"columns\": {\"HR_ORG_UNIT_KEY\": {\"desc\": \"Surrogate key of the HR organization unit, formatted 'O' + numeric ID (e.g. 'O10000333'); joins to HR_ORG_UNIT_NEW.HR_ORG_UNIT_KEY\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"Numeric HR organization unit identifier (e.g. '10000333'); cross-referenced by FCLT_ORGANIZATION.HR_ORG_UNIT_ID\"}, \"HR_ORG_UNIT_TITLE\": {\"desc\": \"Title of the HR organization unit, e.g. 'Institute for Data, Systems, and Society'; reported as the HR org unit title of a facilities organization joined via DLC_KEY\"}, \"HR_ORG_UNIT_LEVEL\": {\"desc\": \"Level classification of the HR organization unit; observed values: 'ALL MIT', 'TOP LEVEL', 'DEPARTMENTS', 'SUB DEPARTMENT', 'ORGANIZATION LEVEL', 'NON HIERARCHY ORG UNITS', and null; distinct from the numeric ORGANIZATION_LEVEL of FCLT_ORGANIZATION\"}, \"HR_DEPARTMENT_ID\": {\"desc\": \"Numeric HR department identifier (same value as HR_ORG_UNIT_ID in current data); absent from HR_ORG_UNIT_NEW\"}, \"HR_DEPARTMENT_CODE\": {\"desc\": \"HR department code in 'HR-NNNNNN' format, e.g. 'HR-068100'\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code (numeric part of HR_DEPARTMENT_CODE), e.g. '68100'\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"HR department name, e.g. 'Institute for Data, Systems, and Society'; the HR-side counterpart of academic department names, used for grouping/partitioning organizations by HR department\"}, \"HR_DEPARTMENT_NAME_LONG\": {\"desc\": \"Long form of the HR department name (often identical to HR_DEPARTMENT_NAME)\"}, \"HR_DEPARTMENT_NAME_ALPHA\": {\"desc\": \"Alphabetical-sort variant of the HR department name\"}, \"ORG_HIER_SCHOOL_AREA_NAME\": {\"desc\": \"Name of the school/area the unit belongs to in the organization hierarchy, e.g. 'Schwarzman College of Computing Area', 'VP for Finance Area'\"}, \"ORG_HIER_TOP_LEVEL_NAME\": {\"desc\": \"Name of the top-level area of the unit in the organization hierarchy, e.g. 'Provost Area', 'Executive Vice President Area'\"}, \"ORG_HIER_ROOT_NAME\": {\"desc\": \"Root name of the organization hierarchy, 'MIT-All' for all rows\"}, \"HR_ORG_LEVEL1_ID\": {\"desc\": \"ID of the level-1 node (institute root, '10000000') in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL1_SORT\": {\"desc\": \"Sort order of the level-1 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL1_NAME\": {\"desc\": \"Name of the level-1 node, 'MIT-All'\"}, \"HR_ORG_LEVEL2_ID\": {\"desc\": \"ID of the level-2 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL2_SORT\": {\"desc\": \"Sort order of the level-2 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL2_NAME\": {\"desc\": \"Name of the level-2 node, e.g. 'Provost Area', 'Executive Vice President Area'\"}, \"HR_ORG_LEVEL3_ID\": {\"desc\": \"ID of the level-3 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL3_SORT\": {\"desc\": \"Sort order of the level-3 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL3_NAME\": {\"desc\": \"Name of the level-3 node, e.g. a school/VP area name\"}, \"HR_ORG_LEVEL4_ID\": {\"desc\": \"ID of the level-4 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL4_SORT\": {\"desc\": \"Sort order of the level-4 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL4_NAME\": {\"desc\": \"Name of the level-4 node, e.g. an area/office name\"}, \"HR_ORG_LEVEL5_ID\": {\"desc\": \"ID of the level-5 node in the HR organization hierarchy path\"}, \"HR_ORG_LEVEL5_SORT\": {\"desc\": \"Sort order of the level-5 node in the HR hierarchy path\"}, \"HR_ORG_LEVEL5_NAME\": {\"desc\": \"Name of the level-5 node, e.g. a department/unit name\"}, \"HR_ORG_LEVEL6_ID\": {\"desc\": \"ID of the level-6 node in the HR organization hierarchy path; null when the path is shallower; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL6_SORT\": {\"desc\": \"Sort order of the level-6 node; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL6_NAME\": {\"desc\": \"Name of the level-6 node; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL7_ID\": {\"desc\": \"ID of the level-7 (deepest) node in the HR organization hierarchy path; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL7_SORT\": {\"desc\": \"Sort order of the level-7 node; absent from HR_ORG_UNIT_NEW\"}, \"HR_ORG_LEVEL7_NAME\": {\"desc\": \"Name of the level-7 node; absent from HR_ORG_UNIT_NEW\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key cross-reference, e.g. 'D_IDSS', 'D_OTP'; joins to FCLT_ORGANIZATION.DLC_KEY and MASTER_DEPT_HIERARCHY.DLC_KEY; null for units without a DLC assignment, and one DLC_KEY may appear on multiple HR org unit rows\"}, \"DLC_NAME\": {\"desc\": \"Department/Lab/Center full name cross-reference, e.g. 'Office of Treasury and Planning'; may differ from the HR unit title; carried only by HR_ORG_UNIT (not HR_ORG_UNIT_NEW); can be used for name-based self-matching of units sharing a DLC\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per HR organization unit\"}, {\"id\": \"FAC_ORGANIZATION\", \"name\": \"FAC_ORGANIZATION\", \"desc\": \"Facilities organization snapshot table with the same hierarchical organization structure as FCLT_ORGANIZATION (organization identifiers, parent/major organization, level, assignable flag, course number, description, HR cross-references) but keyed by ORGANIZATION_KEY and carrying D_CODE instead of DLC_KEY/DLC_NAME. Contains fewer organizations than FCLT_ORGANIZATION; used as an alternative organization dimension in FAC_* family queries.\", \"columns\": {\"ORGANIZATION_KEY\": {\"desc\": \"Surrogate key of the organization; same value domain as FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY\"}, \"ORGANIZATION_ID\": {\"desc\": \"Organization identifier\"}, \"ORGANIZATION\": {\"desc\": \"Short organization abbreviation\"}, \"ORGANIZATION_NAME\": {\"desc\": \"Display name of the organization\"}, \"ORG_PARENT_KEY\": {\"desc\": \"Key of the parent organization in the hierarchy\"}, \"ORG_PARENT\": {\"desc\": \"Abbreviation of the parent organization\"}, \"MAJOR_ORG_KEY\": {\"desc\": \"Key of the major (top-level) organization\"}, \"MAJOR_ORG\": {\"desc\": \"Abbreviation of the major organization\"}, \"ORGANIZATION_LEVEL\": {\"desc\": \"Level of the organization in the hierarchy tree (1 = root, 5 = department/DLC level, 6 = sub-organization)\"}, \"ORGANIZATION_NUMBER\": {\"desc\": \"Official organization number\"}, \"ORGANIZATION_SORT\": {\"desc\": \"Sortable hierarchical organization code\"}, \"ASSIGNABLE\": {\"desc\": \"Flag indicating whether the organization is an assignable-space unit\"}, \"COURSE\": {\"desc\": \"Academic course (department) number for academic departments\"}, \"DESCRIPTION\": {\"desc\": \"Long description of the organization\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}, \"D_CODE\": {\"desc\": \"Department/Lab/Center code (equivalent role to DLC_KEY in FCLT_ORGANIZATION)\"}, \"HR_DEPARTMENT_CODE_OLD\": {\"desc\": \"Legacy HR department code cross-reference\"}, \"HR_ORG_UNIT_ID\": {\"desc\": \"HR organization unit identifier cross-reference\"}, \"HR_DEPARTMENT_NAME\": {\"desc\": \"Department name as recorded in HR systems\"}}, \"default_granularity\": \"one row per facilities organization\"}, {\"id\": \"MASTER_DEPT_HIERARCHY_LINKS\", \"name\": \"MASTER_DEPT_HIERARCHY_LINKS\", \"desc\": \"Master department hierarchy link table: one row per association between a department/lab/center (DLC) and a linked administrative object, classified by link type (Standard Funds Center, PCMIT-0 Profit Center, New/Old Org. Unit, Facilities Org., Student Systems Unit, NIMBUS B.A.G.). A DLC may hold many links of several types. Joins to MASTER_DEPT_HIERARCHY via DLC_KEY; used to map DLCs to their fund centers, profit centers, facilities organizations, and other linked object codes.\", \"columns\": {\"HIERARCHY_TYPE\": {\"desc\": \"Hierarchy classification of the row; only 'Standard Hierarchy' exists in current data\"}, \"LINK_TYPE_CODE\": {\"desc\": \"Short code of the link type: 'FC' Standard Funds Center, 'PMIT' PCMIT-0 Profit Center, 'ORG2' New Org. Unit, 'ORGU' Old Org. Unit, 'FORG' Facilities Org., 'SIS' Student Systems Unit, 'BAG' NIMBUS B.A.G.\"}, \"LINK_TYPE\": {\"desc\": \"Full name of the link type corresponding to LINK_TYPE_CODE\"}, \"DLC_KEY\": {\"desc\": \"Department/Lab/Center key of the linking DLC, e.g. 'D_MPC'; joins to MASTER_DEPT_HIERARCHY.DLC_KEY\"}, \"DLC_CODE\": {\"desc\": \"Department/Lab/Center code (same value as DLC_KEY in current data)\"}, \"LINKED_OBJECT_KEY\": {\"desc\": \"Key of the linked administrative object, e.g. a fund center key 'FC100071' or profit center key\"}, \"LINKED_OBJECT_CODE\": {\"desc\": \"Code of the linked administrative object (same value as LINKED_OBJECT_KEY in current data)\"}}, \"default_granularity\": \"one row per DLC-to-linked-object association\"}, {\"id\": \"MASTER_DEPT_DCODE_PARENT\", \"name\": \"MASTER_DEPT_DCODE_PARENT\", \"desc\": \"Department parent lookup table: one row per department code (D_CODE) with its department name and the identity of its direct parent department (parent ID, parent D code, parent name). A flattened single-level parent view of the department tree; use MASTER_DEPT_HIERARCHY when the full multi-level hierarchy path of a DLC is required. D_CODE matches MASTER_DEPT_HIERARCHY.DLC_KEY/DLC_CODE and other DLC key columns.\", \"columns\": {\"DEPT_ID\": {\"desc\": \"Numeric identifier of the department\"}, \"D_CODE\": {\"desc\": \"Department code in DLC key format, e.g. 'D_BIOLOGY'; matches MASTER_DEPT_HIERARCHY.DLC_KEY/DLC_CODE\"}, \"D_NAME\": {\"desc\": \"Department name, e.g. 'Biology'\"}, \"PARENT_ID\": {\"desc\": \"Numeric identifier of the direct parent department\"}, \"PARENT_D_CODE\": {\"desc\": \"Code of the direct parent department, e.g. 'D_SCHOOL_SCI'; itself a D_CODE value, enabling recursive parent traversal\"}, \"PARENT_D_NAME\": {\"desc\": \"Name of the direct parent department, e.g. 'School of Science'\"}, \"WAREHOUSE_LOAD_DATE\": {\"desc\": \"ETL warehouse load date\"}}, \"default_granularity\": \"one row per department code with its direct parent\"}], \"not_found\": []}"
    },
    {
      "role": "tool",
      "tool_call_id": "call_61d23e4c733c4dc8baf6e1fb",
      "name": "semantic_get",
      "content": "{\"ok\": true, \"entities\": [{\"id\": \"concept_facility_organization_dimension\", \"name\": \"Facility Organization Dimension\", \"desc\": \"Organization dimension tables describing the institute's hierarchical organization tree used for facilities/space attribution: FCLT_ORGANIZATION (keyed by FCLT_ORGANIZATION_KEY, with DLC_KEY/DLC_NAME) and FAC_ORGANIZATION (keyed by ORGANIZATION_KEY, with D_CODE). They answer the same questions about organization names, hierarchy levels, parent/major organizations, assignable flags, and HR cross-references, but belong to different table families and coverage.\", \"tables\": [\"FCLT_ORGANIZATION\", \"FAC_ORGANIZATION\"], \"comparisons\": [{\"dimension\": \"Key family\", \"differences\": \"FCLT_ORGANIZATION uses FCLT_ORGANIZATION_KEY/FCLT_ORG_PARENT_KEY/FCLT_MAJOR_ORG_KEY and is referenced by SPACE_UNIT and FCLT_ROOMS; FAC_ORGANIZATION uses ORGANIZATION_KEY/ORG_PARENT_KEY/MAJOR_ORG_KEY and is referenced by FAC_ROOMS.\"}, {\"dimension\": \"Coverage\", \"differences\": \"FCLT_ORGANIZATION holds more organizations (180 rows) than FAC_ORGANIZATION (169 rows); key values overlap almost entirely, so FCLT_ORGANIZATION is the broader dimension.\"}, {\"dimension\": \"DLC attribution columns\", \"differences\": \"FCLT_ORGANIZATION carries both DLC_KEY and DLC_NAME plus an HR_DEPARTMENT_NAME; FAC_ORGANIZATION carries only D_CODE (no DLC name column).\"}, {\"dimension\": \"Shared structure\", \"differences\": \"Both share ORGANIZATION_ID/ORGANIZATION/ORGANIZATION_NAME, ORGANIZATION_LEVEL (1-6, level 5 = department/DLC), ORGANIZATION_NUMBER, ORGANIZATION_SORT, ASSIGNABLE, COURSE, DESCRIPTION, and HR cross-reference columns.\"}], \"decision_guide\": {\"Organization level, name, description, or hierarchy questions linked to space units or FCLT rooms\": \"Use FCLT_ORGANIZATION: it joins SPACE_UNIT.FCLT_ORGANIZATION_KEY and FCLT_ROOMS.FCLT_ORGANIZATION_KEY and has the widest organization coverage.\", \"Organization questions inside the FAC_* family (FAC_ROOMS occupancy, FAC_BUILDING analysis)\": \"Use FAC_ORGANIZATION: FAC_ROOMS.ORGANIZATION_KEY references it directly.\", \"DLC name reporting for an organization\": \"Use FCLT_ORGANIZATION: it is the only one carrying DLC_NAME alongside DLC_KEY.\"}}, {\"id\": \"concept_space_unit_dimension\", \"name\": \"Space Unit Dimension\", \"desc\": \"Space unit lookup tables identifying the organizational units that receive space allocation: SPACE_UNIT (with FCLT_ORGANIZATION_KEY organization attribution) and SPACE_UNIT2 (identity/name only). They answer the same space-unit identity questions but differ in organization linkage and coverage.\", \"tables\": [\"SPACE_UNIT\", \"SPACE_UNIT2\"], \"comparisons\": [{\"dimension\": \"Organization attribution\", \"differences\": \"SPACE_UNIT carries FCLT_ORGANIZATION_KEY linking each space unit to its owning organization in FCLT_ORGANIZATION; SPACE_UNIT2 has no organization key, only space unit identity and DLC_KEY.\"}, {\"dimension\": \"Coverage\", \"differences\": \"SPACE_UNIT holds more space units (150 rows) than SPACE_UNIT2 (139 rows); every SPACE_UNIT2 key also exists in SPACE_UNIT, so SPACE_UNIT2 is a subset.\"}, {\"dimension\": \"Join role\", \"differences\": \"Both join SPACE_DETAIL via SPACE_UNIT_KEY; only SPACE_UNIT can bridge SPACE_DETAIL rooms to organization attributes (level, parent, description).\"}], \"decision_guide\": {\"Space unit analysis that needs organization attributes (organization level, name, description)\": \"Use SPACE_UNIT: it is the only space unit table carrying FCLT_ORGANIZATION_KEY for the organization join.\", \"Space unit name/code lookup only, or queries restricted to the SPACE_UNIT2 subset\": \"Use SPACE_UNIT2: it provides SPACE_UNIT_KEY/CODE/NAME and DLC_KEY without organization linkage.\", \"Counting rooms per space unit or ranking space units by room count\": \"Join SPACE_DETAIL to SPACE_UNIT on SPACE_UNIT_KEY (preferred for full coverage and organization attribution).\"}}, {\"id\": \"concept_dept_hr_org_hierarchy\", \"name\": \"Department and HR Organization Hierarchy\", \"desc\": \"Tables describing the institute's department/lab/center (DLC) and HR organization hierarchies: the HR organization unit dimension in two feed variants (HR_ORG_UNIT, HR_ORG_UNIT_NEW), the master department standard hierarchy path (MASTER_DEPT_HIERARCHY), its DLC-to-administrative-object link table (MASTER_DEPT_HIERARCHY_LINKS), and the direct-parent department lookup (MASTER_DEPT_DCODE_PARENT). They jointly answer questions about which HR department/area a DLC or organization belongs to, the hierarchy path or parent of a department, and HR department names/codes/levels, and are joined to FCLT_ORGANIZATION via DLC_KEY for facilities/space attribution. They differ in hierarchy representation (full path vs direct parent vs HR unit attributes), unit coverage, and companion columns.\", \"tables\": [\"HR_ORG_UNIT\", \"HR_ORG_UNIT_NEW\", \"MASTER_DEPT_HIERARCHY\", \"MASTER_DEPT_HIERARCHY_LINKS\", \"MASTER_DEPT_DCODE_PARENT\"], \"comparisons\": [{\"dimension\": \"Granularity and business object\", \"detail\": \"HR_ORG_UNIT and HR_ORG_UNIT_NEW hold one row per HR organization unit (641 and 691 rows respectively); MASTER_DEPT_HIERARCHY holds one row per DLC (310 rows) with its 5-level standard hierarchy path; MASTER_DEPT_HIERARCHY_LINKS holds one row per DLC-to-linked-object association (fund centers, profit centers, facilities orgs, org units); MASTER_DEPT_DCODE_PARENT holds one row per department code with only its direct parent.\"}, {\"dimension\": \"Hierarchy representation\", \"detail\": \"HR_ORG_UNIT carries the HR hierarchy path levels 1-7 plus school-area/top-level/root names and a unit level classification (ALL MIT, TOP LEVEL, DEPARTMENTS, SUB DEPARTMENT, ORGANIZATION LEVEL, NON HIERARCHY ORG UNITS); HR_ORG_UNIT_NEW carries only levels 1-5; MASTER_DEPT_HIERARCHY carries the master standard-hierarchy path levels 1-5 by code and name; MASTER_DEPT_DCODE_PARENT carries no path, only the immediate parent code/name.\"}, {\"dimension\": \"Coverage and feed differences\", \"detail\": \"HR_ORG_UNIT_NEW is the newer feed with more units (691 vs 641, including 50 units absent from HR_ORG_UNIT) but lacks HR_DEPARTMENT_ID, DLC_NAME, and hierarchy levels 6-7, and adds HR_DEPARTMENT_ABBR; HR_ORG_UNIT is required when DLC_NAME or the deeper path is needed. MASTER_DEPT_HIERARCHY covers only DLCs placed in the 'Standard Hierarchy'; MASTER_DEPT_DCODE_PARENT covers 340 department codes including some outside that hierarchy.\"}, {\"dimension\": \"DLC cross-reference columns\", \"detail\": \"HR_ORG_UNIT carries DLC_KEY and DLC_NAME (DLC_KEY null for 133 units, and one DLC_KEY may map to multiple HR unit rows); HR_ORG_UNIT_NEW carries only DLC_KEY (possibly composite like 'D_DSL:HQ'); MASTER_DEPT_HIERARCHY and MASTER_DEPT_HIERARCHY_LINKS carry DLC_KEY/DLC_CODE as their primary DLC identity; MASTER_DEPT_DCODE_PARENT uses D_CODE/D_NAME naming for the same value domain.\"}, {\"dimension\": \"Companion attributes\", \"detail\": \"Only the HR_ORG_UNIT tables carry HR department identifiers/codes (HR_ORG_UNIT_ID, HR_DEPARTMENT_CODE 'HR-NNNNNN', HR_DEPARTMENT_CODE_OLD) and department name variants (short/long/alpha) used for HR department reporting; only MASTER_DEPT_HIERARCHY_LINKS carries linked administrative object keys/codes and link type classification.\"}], \"decision_guide\": {\"HR org unit title, HR org unit level, HR department name/code/long name for a facilities organization or DLC\": \"Use HR_ORG_UNIT joined via DLC_KEY; it is the only table carrying DLC_NAME alongside the HR department attributes and the full levels 1-7 path.\", \"HR department attributes for units missing from the older feed, or when the newer unit coverage is required\": \"Use HR_ORG_UNIT_NEW; it holds 50 units absent from HR_ORG_UNIT but lacks DLC_NAME and hierarchy levels 6-7.\", \"School/area placement or full standard-hierarchy path of a DLC, or restricting analysis to DLCs in the standard hierarchy\": \"Use MASTER_DEPT_HIERARCHY (levels 1-5 codes and names per DLC).\", \"Fund center, profit center, facilities organization, or other administrative object linked to a DLC\": \"Use MASTER_DEPT_HIERARCHY_LINKS filtered by LINK_TYPE_CODE (FC, PMIT, FORG, ORG2, ORGU, SIS, BAG).\", \"Direct parent department of a department code (single-level parent lookup)\": \"Use MASTER_DEPT_DCODE_PARENT (PARENT_D_CODE/PARENT_D_NAME); use MASTER_DEPT_HIERARCHY instead when the multi-level path is needed.\"}}, {\"id\": \"column_concept_dlc_key\", \"name\": \"DLC Key (Department/Lab/Center)\", \"desc\": \"Department/Lab/Center key columns (values like 'D_AEROASTRO', 'D_IDSS', 'D_BIOLOGY') identifying a DLC across the facilities, HR, space, and academic-department domains. They are the universal cross-domain join key linking facilities organizations and space units to HR organization units, the master department hierarchy, and academic departments. Naming and completeness vary: DLC_KEY in most tables, D_CODE in MASTER_DEPT_DCODE_PARENT, DLC_CODE in the master hierarchy tables; some columns carry composite values ('D_DSL:HQ') or nulls.\", \"columns\": [\"FCLT_ORGANIZATION.DLC_KEY\", \"FCLT_ORG_DLC_KEY.DLC_KEY\", \"HR_ORG_UNIT.DLC_KEY\", \"HR_ORG_UNIT_NEW.DLC_KEY\", \"MASTER_DEPT_HIERARCHY.DLC_KEY\", \"MASTER_DEPT_HIERARCHY_LINKS.DLC_KEY\", \"MASTER_DEPT_DCODE_PARENT.D_CODE\", \"SPACE_UNIT.DLC_KEY\", \"SPACE_UNIT2.DLC_KEY\", \"SIS_DEPARTMENT.DLC_KEY\", \"SPACE_SUPERVISOR_USAGE.DEPT_NAMES\"], \"comparisons\": [{\"dimension\": \"Naming convention\", \"detail\": \"DLC_KEY is used by FCLT_ORGANIZATION, FCLT_ORG_DLC_KEY, HR_ORG_UNIT, HR_ORG_UNIT_NEW, MASTER_DEPT_HIERARCHY, MASTER_DEPT_HIERARCHY_LINKS, SPACE_UNIT, SPACE_UNIT2, and SIS_DEPARTMENT; MASTER_DEPT_DCODE_PARENT names the same value domain D_CODE (with PARENT_D_CODE for the parent); MASTER_DEPT_HIERARCHY/LINKS additionally carry DLC_CODE holding the same value as DLC_KEY; SPACE_SUPERVISOR_USAGE names it DEPT_NAMES despite holding DLC key values, not department names.\"}, {\"dimension\": \"Uniqueness and fan-out behavior\", \"detail\": \"In MASTER_DEPT_HIERARCHY the DLC_KEY is unique per DLC (one row per DLC); in HR_ORG_UNIT one DLC_KEY may appear on multiple HR org unit rows (join fans out); in FCLT_ORGANIZATION multiple organizations can share a DLC_KEY; in FCLT_ORG_DLC_KEY it is an assignment bridge where non-null values mark organizations with a DLC assignment; in SPACE_SUPERVISOR_USAGE multiple supervisors can share the same DEPT_NAMES value, so joining DEPT_NAMES = DLC_KEY fans out on both sides.\"}, {\"dimension\": \"Nullability and value format\", \"detail\": \"HR_ORG_UNIT.DLC_KEY is null for units without a DLC assignment (133 of 641 rows); HR_ORG_UNIT_NEW.DLC_KEY and SPACE_UNIT.DLC_KEY may contain composite values like 'D_DSL:HQ' that do not match plain DLC keys; SPACE_SUPERVISOR_USAGE.DEPT_NAMES holds a comma-separated list of DLC keys when DEPT_COUNT > 1 (e.g. 'D_IDSS,D_LIDS'), so only single-department rows match a plain DLC key join; SIS_DEPARTMENT.DLC_KEY is populated for all 122 department rows.\"}, {\"dimension\": \"Companion name column\", \"detail\": \"FCLT_ORGANIZATION, HR_ORG_UNIT, and MASTER_DEPT_HIERARCHY carry a DLC_NAME alongside the key; SPACE_UNIT/SPACE_UNIT2, FCLT_ORG_DLC_KEY, HR_ORG_UNIT_NEW, SIS_DEPARTMENT, and SPACE_SUPERVISOR_USAGE carry only the key, so DLC name reporting requires joining one of the name-carrying tables.\"}], \"decision_guide\": {\"Attaching HR department attributes (unit title, department name/code, level) to a facilities organization\": \"Join FCLT_ORGANIZATION.DLC_KEY = HR_ORG_UNIT.DLC_KEY; expect possible row fan-out when a DLC maps to multiple HR org units.\", \"Reporting the DLC name of an organization or space unit\": \"Use FCLT_ORGANIZATION.DLC_KEY (carries DLC_NAME) or join HR_ORG_UNIT/MASTER_DEPT_HIERARCHY for DLC_NAME; SPACE_UNIT/SPACE_UNIT2 keys alone have no name column.\", \"Restricting analysis to DLCs placed in the standard department hierarchy or reporting their hierarchy path\": \"Join on MASTER_DEPT_HIERARCHY.DLC_KEY; use MASTER_DEPT_DCODE_PARENT.D_CODE for the same value domain when only the direct parent is needed.\", \"Filtering organizations that have a DLC assignment before DLC-level room statistics\": \"Use FCLT_ORG_DLC_KEY.DLC_KEY IS NOT NULL as the assignment filter, then join FCLT_ORGANIZATION.\", \"Linking an academic department to its facilities organization or HR unit\": \"Use SIS_DEPARTMENT.DLC_KEY = FCLT_ORGANIZATION.DLC_KEY (or HR_ORG_UNIT.DLC_KEY); all SIS_DEPARTMENT rows carry a DLC key.\", \"Attributing supervisor space-usage statistics (supervisees, square footage, research volume) to a DLC or space unit\": \"Join SPACE_SUPERVISOR_USAGE.DEPT_NAMES = SPACE_UNIT.DLC_KEY (or another DLC_KEY column); despite its name, DEPT_NAMES holds DLC key values, and only single-department rows (DEPT_COUNT = 1) match a plain DLC key.\"}}, {\"columns\": [\"SPACE_UNIT.SPACE_UNIT_KEY\", \"SPACE_UNIT2.SPACE_UNIT_KEY\", \"SPACE_DETAIL.SPACE_UNIT_KEY\"], \"comparisons\": [{\"dimension\": \"Role\", \"differences\": \"In SPACE_UNIT and SPACE_UNIT2 it is the primary identity of the space unit dimension; in SPACE_DETAIL it is a foreign key assigning each room to a space unit.\"}, {\"dimension\": \"Organization linkage\", \"differences\": \"Only SPACE_UNIT.SPACE_UNIT_KEY rows carry FCLT_ORGANIZATION_KEY, so joining SPACE_DETAIL through SPACE_UNIT (not SPACE_UNIT2) reaches organization attributes.\"}, {\"dimension\": \"Coverage\", \"differences\": \"SPACE_DETAIL references 66 distinct space unit keys; SPACE_UNIT covers all of them plus unused units, SPACE_UNIT2 is a subset of SPACE_UNIT.\"}], \"decision_guide\": {\"Grouping room counts by space unit with organization attributes\": \"Join SPACE_DETAIL.SPACE_UNIT_KEY to SPACE_UNIT.SPACE_UNIT_KEY, then to FCLT_ORGANIZATION via SPACE_UNIT.FCLT_ORGANIZATION_KEY.\", \"Space unit name lookup without organization context\": \"Either SPACE_UNIT or SPACE_UNIT2 resolves SPACE_DETAIL.SPACE_UNIT_KEY to a name; prefer SPACE_UNIT for full coverage.\"}, \"desc\": \"Space unit key columns identifying the organizational space-assignment unit across the space dimension and fact tables. SPACE_UNIT_KEY is the join key linking SPACE_DETAIL room rows to space unit identity (name/code) and, through SPACE_UNIT, to the owning facilities organization.\", \"id\": \"column_concept_space_unit_key\", \"name\": \"Space Unit Key\"}, {\"columns\": [\"FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY\", \"SPACE_UNIT.FCLT_ORGANIZATION_KEY\", \"FCLT_ROOMS.FCLT_ORGANIZATION_KEY\", \"FCLT_ROOMS.FCLT_MINOR_ORGANIZATION_KEY\", \"FAC_ORGANIZATION.ORGANIZATION_KEY\", \"FAC_ROOMS.ORGANIZATION_KEY\"], \"comparisons\": [{\"dimension\": \"Key family\", \"differences\": \"FCLT_ORGANIZATION_KEY (FCLT_* family) and ORGANIZATION_KEY (FAC_* family) share the same value domain but must be joined within their own family: SPACE_UNIT/FCLT_ROOMS use FCLT_ORGANIZATION_KEY, FAC_ROOMS uses ORGANIZATION_KEY.\"}, {\"dimension\": \"Primary vs secondary occupancy\", \"differences\": \"FCLT_ROOMS.FCLT_ORGANIZATION_KEY is the primary occupying organization; FCLT_ROOMS.FCLT_MINOR_ORGANIZATION_KEY is the secondary organization, both referencing FCLT_ORGANIZATION.\"}, {\"dimension\": \"Dimension vs foreign key\", \"differences\": \"FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY and FAC_ORGANIZATION.ORGANIZATION_KEY are dimension identities; the others are foreign keys attributing space units or rooms to organizations.\"}], \"decision_guide\": {\"Attributing space units to organizations (e.g. filtering by organization level)\": \"Join SPACE_UNIT.FCLT_ORGANIZATION_KEY to FCLT_ORGANIZATION.FCLT_ORGANIZATION_KEY.\", \"Attributing rooms to their occupying organization in the FCLT_* family\": \"Use FCLT_ROOMS.FCLT_ORGANIZATION_KEY (primary) or FCLT_MINOR_ORGANIZATION_KEY (secondary) against FCLT_ORGANIZATION.\", \"Room organization attribution inside the FAC_* family\": \"Use FAC_ROOMS.ORGANIZATION_KEY against FAC_ORGANIZATION.ORGANIZATION_KEY.\"}, \"desc\": \"Facility organization key columns attributing space units and rooms to organizations in the hierarchical organization tree. Two naming conventions exist across table families (FCLT_ORGANIZATION_KEY in FCLT_*/SPACE_* tables vs ORGANIZATION_KEY in FAC_* tables) with the same value domain.\", \"id\": \"column_concept_facility_organization_key\", \"name\": \"Facility Organization Key\"}], \"not_found\": []}"
    },
