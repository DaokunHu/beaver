# ─────────────────────────────────────────────────────────────────────────────
# BEAVER credentials template
#
# Copy this file to `.env` at the repo root and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is git-ignored — never commit real keys, endpoints or passwords.
# Placeholders below use the `<...>` form; replace the whole value.
#
# Which keys you need depends on what you run:
#   * MySQL keys            -> required by everything (execution accuracy, Durian)
#   * OPENAI / OPENROUTER   -> the four baseline methods under `eval/`
#   * LLM_* / EMBEDDING_*   -> Durian (`eval/durian/`)
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM API keys (baseline methods: ReFoRCE / DAIL-SQL / DIN-SQL / Few-shot) ──
OPENAI_API_KEY=<your-openai-api-key>
OPENROUTER_API_KEY=<your-openrouter-api-key>

# ── MySQL (shared across all databases and all methods) ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<your-mysql-password>

# ── Durian LLM (any OpenAI-compatible chat endpoint) ──
# Used by both the Semantic Agent (network build) and the DataAgent (SQL generation).
LLM_API_KEY=<your-llm-api-key>
LLM_MODEL=<your-llm-model>
LLM_BASE_URL=<your-llm-base-url>            # e.g. https://<host>/v1

# ── Durian embedding (vector store build + `semantic_search` retrieval) ──
# The embedding dimension must match `semantic_network.embedding_dim` in
# eval/durian/Agent/react_config.json (default 1024).
EMBEDDING_API_KEY=<your-embedding-api-key>
EMBEDDING_MODEL=<your-embedding-model>
EMBEDDING_BASE_URL=<your-embedding-base-url> # e.g. https://<host>/v1

# ── Optional: only needed by specific baseline backends ──
# GEMINI_API_KEY=<your-gemini-api-key>
# DS_API_KEY=<your-deepseek-api-key>
# AZURE_ENDPOINT=<your-azure-openai-endpoint>
# AZURE_OPENAI_KEY=<your-azure-openai-key>
# MYSQL_CREDENTIAL_PATH=<path/to/credentials.json>   # ReFoRCE, alternative to MYSQL_*
